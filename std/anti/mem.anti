//! Allocators, which a library or a class takes to make its memory.
//!
//! `Allocator` is the standard interface. `alloc(size, align)` gives
//! `size` bytes at an address that is a multiple of `align`, and
//! `free(p)` gives them back to the allocator that gave them. The
//! language's own `alloc` and `free` stay bound to the C library. A class
//! whose user chooses where its memory comes from takes a `*Allocator`
//! and asks it.
//!
//! `LibcAllocator` is the default, over the C library. `ArenaAllocator`
//! hands out memory from blocks that it takes from another allocator,
//! and gives every block back at once.

extern fn anti_rt_mem_alloc(size: int, align: int) -> ?*byte;
extern fn anti_rt_mem_free(p: ?*byte);

/// The largest `int`, which the bytes of a block never pass.
const LARGEST: int = 0x7FFFFFFFFFFFFFFF;

/// The alignment of a block of `ArenaAllocator`, which serves every
/// request up to it from a block that other requests share.
const BLOCK_ALIGN: int = 16;

/// Memory on request, given back to the allocator that gave it.
pub abstract class Allocator
{
	/// `size` bytes at an address that is a multiple of `align`, or
	/// `none`.
	///
	/// `align` is a power of two. A `size` below zero, an `align` that is
	/// no power of two and memory that has run out give `none`. A `size`
	/// of zero gives an address that `free` takes.
	abstract fn alloc(self, size: int, align: int) -> ?*byte;

	/// Give back `p`, which `alloc` of this allocator gave.
	///
	/// `none` does nothing.
	abstract fn free(self, p: ?*byte);
}

/// The allocator over the C library, which is the default of
/// `Allocator`.
///
/// Its memory goes back through its own `free` and never through the
/// language's, since Windows gives aligned memory back with a function of
/// its own.
pub singleton class LibcAllocator inherits Allocator
{
	concrete fn alloc(self, size: int, align: int) -> ?*byte
	{
		return anti_rt_mem_alloc(size, align);
	}

	concrete fn free(self, p: ?*byte)
	{
		anti_rt_mem_free(p);
	}
}

/// The head of a block of `ArenaAllocator`, at the start of its memory.
struct Block
{
	next: ?*byte,
}

/// An allocator that hands out memory from blocks and gives them all
/// back at once.
///
/// The blocks come from another allocator. Each holds `block` bytes, or
/// a larger request alone. A request at an alignment above 16, the one
/// of the blocks, takes a block of its own at its alignment. `free` of
/// one allocation gives nothing back. `free_all` gives back every block
/// and leaves the allocator empty and ready for more, and `destruct`
/// gives back what is left. A copy would give the blocks back twice, so
/// a program passes the address of the one it made.
pub class ArenaAllocator inherits Allocator
{
	from: *Allocator,
	block: int = 0,
	head: ?*byte = none,
	used: int = 0,
	limit: int = 0,
	head_align: int = 0,

	/// An allocator without blocks, whose blocks come from `from` and
	/// hold `block` bytes.
	pub fn new(from: *Allocator, block: int) -> ArenaAllocator
	{
		return ArenaAllocator { from: from, block: block };
	}

	concrete fn alloc(self, size: int, align: int) -> ?*byte
	{
		if !valid(size, align) {
			return none;
		}
		let head = self.head;
		if head != none && align <= self.head_align {
			let pad = padding(self.used, align);
			let left = self.limit - self.used;
			if pad <= left && size <= left - pad {
				let start = self.used + pad;
				self.used = start + size;
				return &head[start];
			}
		}
		return self.grow(size, align);
	}

	/// Nothing, since the blocks go back all at once.
	concrete fn free(self, p: ?*byte)
	{
	}

	/// Give back every block, after which the allocator holds none and
	/// hands out memory again.
	pub fn free_all(self)
	{
		let at = self.head;
		while true do {
			let raw = at else { break; };
			let b = raw as *Block;
			at = b.next;
			self.from.free(raw);
		}
		self.head = none;
		self.used = 0;
		self.limit = 0;
		self.head_align = 0;
	}

	fn destruct(self)
	{
		self.free_all();
	}

	/// A new head block that serves the request, or `none`.
	fn grow(self, size: int, align: int) -> ?*byte
	{
		let block_align = align;
		if block_align < BLOCK_ALIGN {
			block_align = BLOCK_ALIGN;
		}
		let start = size_of(Block) + padding(size_of(Block), align);
		if size > LARGEST - start {
			return none;
		}
		let bytes = start + size;
		if bytes < self.block {
			bytes = self.block;
		}
		let raw = self.from.alloc(bytes, block_align) else { return none; };
		let b = raw as *Block;
		b.next = self.head;
		self.head = raw;
		self.used = start + size;
		self.limit = bytes;
		self.head_align = block_align;
		return &raw[start];
	}
}

/// Whether a request of `size` bytes at `align` can be served.
fn valid(size: int, align: int) -> bool
{
	return size >= 0 && align > 0 && (align & (align - 1)) == 0;
}

/// The bytes that take `n` up to the next multiple of `align`.
fn padding(n: int, align: int) -> int
{
	let over = n % align;
	if over == 0 {
		return 0;
	}
	return align - over;
}
