//! Operations on `str` values.
//!
//! A `str` holds UTF-8 bytes and their count. `from_c` makes one from a C
//! string, and `equal` compares two by their bytes. `Builder` collects
//! bytes and gives the `str` of what it collected. It writes numbers,
//! truth values, characters and texts into fields of a width, which is
//! what an `f"..."` calls. `parse_int` reads the integer a text spells
//! and may fail, and every other function of the module cannot.

import anti.lang;
import anti.mem;

extern fn memcmp(a: ?*byte, b: ?*byte, count: c_size_t) -> c_int;
extern fn memcpy(to: ?*byte, from: ?*byte, count: c_size_t) -> ?*byte;
extern fn anti_rt_text_from_c(bytes: ?*byte) -> str;
extern fn anti_rt_text_slice(bytes: ?*byte, len: int) -> str;
extern fn anti_rt_builder_append(b: ?*Builder, bytes: ?*byte, len: int);
extern fn anti_rt_builder_text(b: ?*Builder) -> str;
extern fn anti_rt_builder_clear(b: ?*Builder);
extern fn anti_rt_builder_fill(b: ?*Builder, at: int, value: int, count: int);
extern fn anti_rt_builder_take(b: ?*Builder) -> str;
extern fn anti_rt_builder_float(b: ?*Builder, value: f64, precision: int,
	exponent: int, single: int);

/// Whether `a` and `b` hold the same bytes.
pub fn equal(a: str, b: str) -> bool
{
	if a.len != b.len {
		return false;
	}
	return a.len == 0 || memcmp(a.ptr, b.ptr, a.len as c_size_t) == 0;
}

/// The `str` of the NUL-terminated C string at `bytes`, without the NUL.
///
/// The `str` points into the C string, which must outlive it.
pub fn from_c(bytes: ?*byte) -> str
{
	return anti_rt_text_from_c(bytes);
}

/// The number of bytes of `s`.
pub fn byte_count(s: str) -> int
{
	return s.len;
}

/// The number of characters of `s`, counted as the bytes that start a
/// UTF-8 sequence.
pub fn char_count(s: str) -> int
{
	let count = 0;
	let i = 0;
	while i < s.len do {
		if (s[i] & 0xC0) != 0x80 {
			count += 1;
		}
		i += 1;
	}
	return count;
}

/// Where a value stands in a field wider than its text.
pub enum Align: u8 { Left, Right, Center }

/// A growing buffer of bytes that gives a `str`.
///
/// `append` copies the bytes of a `str` into the buffer, and `text`
/// gives the whole of it. The buffer always keeps one byte past its
/// length for the NUL that every `str` has.
///
/// The runtime holds the buffer, because the default `serialize` of the
/// root class writes an object into one. The three fields below are the
/// `struct anti_builder` of `rt/std.h`, in that order.
pub class Builder
{
	own room: ?*byte,
	length: int = 0,
	capacity: int = 0,

	/// An empty builder.
	pub fn new() -> Builder
	{
		return Builder { room: none, length: 0, capacity: 0 };
	}

	/// Copy the bytes of `s` to the end of the buffer.
	pub fn append(self, s: str)
	{
		anti_rt_builder_append(self, s.ptr, s.len);
	}

	/// Copy one byte to the end of the buffer.
	pub fn append_byte(self, b: byte)
	{
		let one = b;
		anti_rt_builder_append(self, &one, 1);
	}

	/// The bytes collected so far, which the builder still owns.
	pub fn text(self) -> str
	{
		return anti_rt_builder_text(self);
	}

	/// The number of bytes collected.
	pub fn len(self) -> int
	{
		return self.length;
	}

	/// Forget the bytes collected so far and keep the room for more.
	pub fn clear(self)
	{
		anti_rt_builder_clear(self);
	}

	/// The bytes collected so far, which now belong to the caller.
	///
	/// The `str` holds memory of its own from the C library, which
	/// `free(s.ptr)` returns. The builder is empty afterwards and may
	/// collect again.
	pub fn take(self) -> str
	{
		return anti_rt_builder_take(self);
	}

	/// The bytes collected so far, in memory of `from`, which now belong
	/// to the caller.
	///
	/// `from.free(s.ptr)` gives the memory back, and so does anything
	/// that gives back every block of `from` at once. The text keeps its
	/// NUL. When `from` gives no memory, the text is the empty literal,
	/// as `take` gives it when the C library has none. The builder is
	/// empty afterwards and may collect again. `f"..."(from)` ends with
	/// this call.
	pub fn take_in(self, from: *mem.Allocator) -> str
	{
		let collected = anti_rt_builder_text(self);
		let made = "";
		let room = from.alloc(collected.len + 1, 1);
		if room != none {
			memcpy(room, collected.ptr, (collected.len + 1) as c_size_t);
			made = anti_rt_text_slice(room, collected.len);
		}
		free(self.room);
		self.room = none;
		self.length = 0;
		self.capacity = 0;
		return made;
	}

	/// Write `value` in base `radix` into a field `width` characters
	/// wide.
	///
	/// A negative value starts with `-`. A radix outside 2 to 36 counts
	/// as 10, and `upper` writes the digits above 9 as capitals. `zero`
	/// fills the field with `0` after the sign, and `align` then does
	/// not apply.
	pub fn append_int(self, value: int, radix: int = 10, upper: bool = false,
		width: int = 0, align: Align = Align.Right, zero: bool = false)
	{
		let start = self.length;
		if value < 0 {
			self.append_byte(0x2D);
			/* The magnitude of the lowest int lies one past the highest,
			   so it is taken one step nearer zero and the step is added
			   back as a u64. */
			self.put_digits(((-(value + 1)) as u64) + 1, radix, upper);
		} else {
			self.put_digits(value as u64, radix, upper);
		}
		self.pad(start, width, align, zero);
	}

	/// Write `value` in base `radix` into a field `width` characters
	/// wide, as `append_int` does for an `int`.
	pub fn append_uint(self, value: u64, radix: int = 10,
		upper: bool = false, width: int = 0, align: Align = Align.Right,
		zero: bool = false)
	{
		let start = self.length;
		self.put_digits(value, radix, upper);
		self.pad(start, width, align, zero);
	}

	/// Write `value` with `precision` digits after the point into a field
	/// `width` characters wide.
	///
	/// A negative `precision` writes the fewest digits that read back as
	/// the same value. They stand in positional form when the first
	/// digit is worth 10 to the power -4 up to 15, and in the form
	/// `d.ddde+XX` otherwise. `exponent` writes that form always. `nan`,
	/// `inf` and `-inf` stand for the values without digits. `zero`
	/// fills the field with `0` after the sign, and `align` then does
	/// not apply.
	pub fn append_float(self, value: f64, precision: int = -1,
		exponent: bool = false, width: int = 0, align: Align = Align.Right,
		zero: bool = false)
	{
		let start = self.length;
		anti_rt_builder_float(self, value, precision, exponent as int, 0);
		self.pad(start, width, align, zero);
	}

	/// Write `value` as `append_float` does, where the fewest digits are
	/// the ones that read back as the same `f32`.
	pub fn append_f32(self, value: f32, precision: int = -1,
		exponent: bool = false, width: int = 0, align: Align = Align.Right,
		zero: bool = false)
	{
		let start = self.length;
		anti_rt_builder_float(self, value as f64, precision, exponent as int,
			1);
		self.pad(start, width, align, zero);
	}

	/// Write `true` or `false` into a field `width` characters wide.
	pub fn append_bool(self, value: bool, width: int = 0,
		align: Align = Align.Left)
	{
		if value {
			self.append_text("true", width, align);
		} else {
			self.append_text("false", width, align);
		}
	}

	/// Write the UTF-8 bytes of `value` into a field `width` characters
	/// wide.
	pub fn append_char(self, value: char, width: int = 0,
		align: Align = Align.Left)
	{
		let start = self.length;
		let code = value as u32;
		if code < 0x80 {
			self.append_byte(code as byte);
		} else if code < 0x800 {
			self.append_byte((0xC0 | (code >> 6)) as byte);
			self.append_byte((0x80 | (code & 0x3F)) as byte);
		} else if code < 0x10000 {
			self.append_byte((0xE0 | (code >> 12)) as byte);
			self.append_byte((0x80 | ((code >> 6) & 0x3F)) as byte);
			self.append_byte((0x80 | (code & 0x3F)) as byte);
		} else {
			self.append_byte((0xF0 | (code >> 18)) as byte);
			self.append_byte((0x80 | ((code >> 12) & 0x3F)) as byte);
			self.append_byte((0x80 | ((code >> 6) & 0x3F)) as byte);
			self.append_byte((0x80 | (code & 0x3F)) as byte);
		}
		self.pad(start, width, align, false);
	}

	/// Copy the bytes of `value` into a field `width` characters wide.
	pub fn append_text(self, value: str, width: int = 0,
		align: Align = Align.Left)
	{
		let start = self.length;
		self.append(value);
		self.pad(start, width, align, false);
	}

	/// The digits of `value` in base `radix`, highest first.
	fn put_digits(self, value: u64, radix: int, upper: bool)
	{
		let base: u64 = 10;
		if radix >= 2 && radix <= 36 {
			base = radix as u64;
		}
		let letters: byte = 0x61;
		if upper {
			letters = 0x41;
		}
		/* The digits come out lowest first, so they are gathered from the
		   end of the array towards its start. */
		let digits: [64]byte = [0; 64];
		let at = 64;
		let n = value;
		do {
			let digit = (n % base) as byte;
			at -= 1;
			if digit < 10 {
				digits[at] = 0x30 + digit;
			} else {
				digits[at] = letters + digit - 10;
			}
			n = n / base;
		} while n != 0
		while at < 64 do {
			self.append_byte(digits[at]);
			at += 1;
		}
	}

	/// Widen the text written since `start` to `width` characters, with
	/// spaces on the sides `align` names, or with `0` after a leading
	/// `-` when `zero` is set.
	fn pad(self, start: int, width: int, align: Align, zero: bool)
	{
		let whole = anti_rt_builder_text(self);
		let missing = width - char_count(slice(whole, start, whole.len));
		if missing <= 0 {
			return;
		}
		if zero {
			let at = start;
			if whole.len > start && whole[start] == 0x2D {
				at += 1;
			}
			anti_rt_builder_fill(self, at, 0x30, missing);
		} else if align == Align.Left {
			anti_rt_builder_fill(self, self.length, 0x20, missing);
		} else if align == Align.Right {
			anti_rt_builder_fill(self, start, 0x20, missing);
		} else {
			anti_rt_builder_fill(self, start, 0x20, missing / 2);
			anti_rt_builder_fill(self, self.length, 0x20,
				missing - missing / 2);
		}
	}
}

/// The bytes of `s` from `from` up to `to`, which share its memory.
///
/// A range outside the text gives an empty `str`, and `to` past the end
/// stops at the end.
pub fn slice(s: str, from: int, to: int) -> str
{
	let high = to;
	if high > s.len {
		high = s.len;
	}
	if from < 0 || from >= high {
		return "";
	}
	let bytes = s.ptr else { return ""; };
	return anti_rt_text_slice(&bytes[from], high - from);
}

/// The index of the first `b` in `s`, or -1.
pub fn find_byte(s: str, b: byte) -> int
{
	let i = 0;
	while i < s.len do {
		if s[i] == b {
			return i;
		}
		i += 1;
	}
	return -1;
}

/// The integer `s` spells, which may fail.
///
/// A leading `+` or `-` is read. The call fails for a text without a
/// digit, for any other byte outside the digits and for a value outside
/// the range of `int`.
pub fn parse_int(s: str) -> int may fail
{
	let i = 0;
	let negative = false;
	/* A character literal is a Unicode scalar, so the bytes of `-`, `+`
	   and the digits stand here as their values. */
	if s.len > 0 && s[0] == 0x2D {
		negative = true;
		i = 1;
	} else if s.len > 0 && s[0] == 0x2B {
		i = 1;
	}
	if i >= s.len {
		fail "the text is not an integer";
	}
	/* The value is gathered below zero, where the range of `int` reaches
	   one further than above it, so the lowest `int` is read as it is.
	   The test before each step keeps the arithmetic inside the range. */
	let lowest = -9223372036854775807 - 1;
	let value = 0;
	while i < s.len do {
		if s[i] < 0x30 || s[i] > 0x39 {
			fail "the text is not an integer";
		}
		let digit = (s[i] - 0x30) as int;
		if value < lowest / 10 || value * 10 < lowest + digit {
			fail "the integer is outside the range of int";
		}
		value = value * 10 - digit;
		i += 1;
	}
	if negative {
		return value;
	}
	if value == lowest {
		fail "the integer is outside the range of int";
	}
	return -value;
}
