//! The JSON that `serialize` writes and `deserialize` reads.
//!
//! Every object writes itself as a JSON object. The default body of
//! `serialize` writes the class name under `type`, then one member per
//! field of the chain, the root's first. A field the field list cannot
//! read is written as `null`, and a class that wants more replaces
//! `serialize` and writes its members with the functions here.
//!
//! `Object.deserialize(input, from)` builds an object back from the JSON
//! of the default `serialize`, in memory of the `anti.mem.Allocator`
//! `from`. The functions here read the text of one member,
//! for a class that writes its own members. `member` gives `false` for a
//! member the object does not hold, and `unquote` may fail.

import anti.lang;
import anti.text;

/// Write `value` as a JSON object.
///
/// A pointer that is `none` writes `null`.
pub fn write(value: ?*Object, out: *text.Builder)
{
	if value == none {
		out.append("null");
		return;
	}
	value.serialize(out);
}

/// Write `s` as a JSON string, with the quotes and the escapes.
pub fn write_text(s: str, out: *text.Builder)
{
	out.append_byte(0x22);
	let i = 0;
	while i < s.len do {
		let b = s[i];
		if b == 0x22 || b == 0x5C {
			out.append_byte(0x5C);
			out.append_byte(b);
		} else if b == 0x0A {
			out.append("\\n");
		} else if b == 0x0D {
			out.append("\\r");
		} else if b == 0x09 {
			out.append("\\t");
		} else if b < 0x20 {
			out.append("\\u00");
			out.append_byte(digit(b / 16));
			out.append_byte(digit(b % 16));
		} else {
			out.append_byte(b);
		}
		i += 1;
	}
	out.append_byte(0x22);
}

/// Write `value` as a JSON number.
pub fn write_int(value: int, out: *text.Builder)
{
	if value == 0 {
		out.append("0");
		return;
	}
	let digits: [20]byte = [0; 20];
	let n = value;
	if n < 0 {
		out.append_byte(0x2D);
	}
	let count = 0;
	while n != 0 do {
		let last = n % 10;
		if last < 0 {
			last = -last;
		}
		digits[count] = digit(last as byte);
		count += 1;
		n = n / 10;
	}
	while count > 0 do {
		count -= 1;
		out.append_byte(digits[count]);
	}
}

/// Write `value` as `true` or `false`.
pub fn write_bool(value: bool, out: *text.Builder)
{
	if value {
		out.append("true");
	} else {
		out.append("false");
	}
}

/// The text of the member `name` of the JSON object `source`.
///
/// The text is the member as it stands, quotes included for a string.
/// The result is false when the object holds no such member.
pub fn member(source: str, name: str, out: *str) -> bool
{
	let i = skip_space(source, 0);
	if i >= source.len || source[i] != 0x7B {
		return false;
	}
	i += 1;
	while true do {
		i = skip_space(source, i);
		if i >= source.len || source[i] == 0x7D {
			return false;
		}
		if source[i] != 0x22 {
			return false;
		}
		let key_end = end_of_text(source, i);
		if key_end < 0 {
			return false;
		}
		let key = text.slice(source, i + 1, key_end);
		i = skip_space(source, key_end + 1);
		if i >= source.len || source[i] != 0x3A {
			return false;
		}
		i = skip_space(source, i + 1);
		let value_end = end_of_value(source, i);
		if value_end < 0 {
			return false;
		}
		if text.equal(key, name) {
			*out = text.slice(source, i, value_end);
			return true;
		}
		i = skip_space(source, value_end);
		if i < source.len && source[i] == 0x2C {
			i += 1;
		}
	}
	return false;
}

/// Write the bytes of the JSON string `source` into `out`, which may
/// fail.
///
/// A `source` that is no JSON string fails with code 0, and `out` keeps
/// the bytes written before the fault. The escapes `\"`, `\\`, `\/`,
/// `\n`, `\r`, `\t`, `\b` and `\f` are read, and a `\u` escape is left as
/// it stands.
pub fn unquote(source: str, out: *text.Builder) may fail
{
	if source.len < 2 || source[0] != 0x22 {
		fail "the text is no JSON string";
	}
	let i = 1;
	while i < source.len do {
		let b = source[i];
		if b == 0x22 {
			return;
		}
		if b != 0x5C {
			out.append_byte(b);
			i += 1;
			continue;
		}
		i += 1;
		if i >= source.len {
			fail "the text is no JSON string";
		}
		let e = source[i];
		if e == 0x6E {
			out.append_byte(0x0A);
		} else if e == 0x72 {
			out.append_byte(0x0D);
		} else if e == 0x74 {
			out.append_byte(0x09);
		} else if e == 0x62 {
			out.append_byte(0x08);
		} else if e == 0x66 {
			out.append_byte(0x0C);
		} else {
			out.append_byte(e);
		}
		i += 1;
	}
	fail "the text is no JSON string";
}

/// The byte of the hexadecimal digit `value`.
fn digit(value: byte) -> byte
{
	if value < 10 {
		return 0x30 + value;
	}
	return 0x61 + value - 10;
}

/// The index of the first byte at `from` or after it that is no space.
fn skip_space(source: str, from: int) -> int
{
	let i = from;
	while i < source.len do {
		if source[i] != 0x20 && source[i] != 0x09 && source[i] != 0x0A &&
			source[i] != 0x0D {
			return i;
		}
		i += 1;
	}
	return i;
}

/// The index of the quote that ends the string at `from`, or -1.
fn end_of_text(source: str, from: int) -> int
{
	let i = from + 1;
	while i < source.len do {
		if source[i] == 0x5C {
			i += 2;
			continue;
		}
		if source[i] == 0x22 {
			return i;
		}
		i += 1;
	}
	return -1;
}

/// The index one past the value that starts at `from`, or -1.
fn end_of_value(source: str, from: int) -> int
{
	if from >= source.len {
		return -1;
	}
	if source[from] == 0x22 {
		let end = end_of_text(source, from);
		if end < 0 {
			return -1;
		}
		return end + 1;
	}
	let depth = 0;
	let i = from;
	while i < source.len do {
		let b = source[i];
		if b == 0x22 {
			let end = end_of_text(source, i);
			if end < 0 {
				return -1;
			}
			i = end + 1;
			continue;
		}
		if b == 0x7B || b == 0x5B {
			depth += 1;
		} else if b == 0x7D || b == 0x5D {
			if depth == 0 {
				return i;
			}
			depth -= 1;
		} else if depth == 0 && b == 0x2C {
			return i;
		}
		i += 1;
	}
	return -1;
}
