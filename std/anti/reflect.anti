//! What a program can read of its own classes at run time.
//!
//! Every class carries a descriptor in read-only data, and `anti.reflect` reads
//! it. `describe` gives the descriptor of an object, `field_count` and
//! `function_count` count what it lists, and `field` gives the name, the offset
//! and the type of one field. `get` and `set` read and write one field by its
//! index as a `Value`. `--no-reflect` drops the two lists, and the counts are
//! then zero.
//!
//! `new` builds an object of a class that it names. It reads the registry of
//! every class of the program, which the link step writes. `--no-reflect`
//! leaves the registry empty.
//!
//! `call` calls a public function by its index through the table of the
//! object's class. Its arguments and its result are `Value`s, and the compiler
//! writes one trampoline per signature of the program that unpacks them. `set`
//! and `call` may fail, and the code of an error names the reason.
//! `--no-reflect` drops the function lists, and every `call` then fails with
//! `BAD_INDEX`.

import anti.lang;
import anti.text;

extern fn anti_rt_descriptor(object: ?*byte) -> ?*byte;
extern fn anti_rt_reflect_parent(d: ?*byte) -> ?*byte;
extern fn anti_rt_reflect_field_count(d: ?*byte) -> int;
extern fn anti_rt_reflect_field_name(d: ?*byte, index: int) -> str;
extern fn anti_rt_reflect_field_offset(d: ?*byte, index: int) -> int;
extern fn anti_rt_reflect_field_type(d: ?*byte, index: int) -> int;
extern fn anti_rt_reflect_field_owned(d: ?*byte, index: int) -> int;
extern fn anti_rt_reflect_function_count(d: ?*byte) -> int;
extern fn anti_rt_reflect_function_name(d: ?*byte, index: int) -> str;
extern fn anti_rt_reflect_function_slot(d: ?*byte, index: int) -> int;
extern fn anti_rt_reflect_function_params(d: ?*byte, index: int) -> int;
extern fn anti_rt_reflect_get(object: ?*byte, d: ?*byte, index: int,
	out: ?*Value);
extern fn anti_rt_reflect_set(object: ?*byte, d: ?*byte, index: int,
	value: ?*Value) -> int;
extern fn anti_rt_reflect_new(name: ?*byte, length: int) -> ?*Object;
extern fn anti_rt_reflect_call(object: ?*Object, index: int, args: ?*Value,
	count: int, result: ?*Value) -> int;

/// The type of a field, as its record names it.
///
/// A pointer, a slice, an array and an enum are built on another type, which
/// `Field.element` names. An enum there is the integer it is built on. `None`
/// is a bitfield, which no walk reads.
pub enum TypeId: u8
{
	None, Bool, Char, I8, I16, I32, I64, CLong, U8, U16, U32, U64, CULong,
	CWchar, F32, F64, Str, Ptr, Fn, Slice, Array, Struct, Union, Enum, Class,
	F16
}

/// The code of the error of an index that names no field or function.
pub const BAD_INDEX: int = 1;
/// The code of the error of a type that no `Value` carries.
pub const NOT_CARRIED: int = 2;
/// The code of the error of a `Value` of another kind than its place.
pub const WRONG_KIND: int = 3;
/// The code of the error of a call with another count of arguments.
pub const WRONG_COUNT: int = 4;

/// One field of a class, as its descriptor lists it.
pub class Field
{
	pub name: str = "",
	pub offset: int = 0,
	pub type_id: TypeId = TypeId.None,
	pub element: TypeId = TypeId.None,
	pub owned: bool = false,
}

/// One public function of a class, with the entry of its table.
pub class Function
{
	pub name: str = "",
	pub slot: int = 0,
	pub param_count: int = 0,
}

/// The descriptor of the class of `object`.
pub fn describe(object: *byte) -> ?*byte
{
	return anti_rt_descriptor(object);
}

/// The descriptor of the base of the class `d` describes, or `none`.
pub fn parent(d: *byte) -> ?*byte
{
	return anti_rt_reflect_parent(d);
}

/// The number of fields the class declares itself.
pub fn field_count(d: *byte) -> int
{
	return anti_rt_reflect_field_count(d);
}

/// The field at `index`, which is one of `field_count` of them.
pub fn field(d: *byte, index: int) -> Field
{
	let t = anti_rt_reflect_field_type(d, index);
	return Field {
		name: anti_rt_reflect_field_name(d, index),
		offset: anti_rt_reflect_field_offset(d, index),
		type_id: (t & 255) as u8 as TypeId,
		element: (t >> 8 & 255) as u8 as TypeId,
		owned: anti_rt_reflect_field_owned(d, index) != 0,
	};
}

/// The number of public functions of the whole chain.
pub fn function_count(d: *byte) -> int
{
	return anti_rt_reflect_function_count(d);
}

/// The function at `index`, which is one of `function_count` of them.
pub fn function(d: *byte, index: int) -> Function
{
	return Function {
		name: anti_rt_reflect_function_name(d, index),
		slot: anti_rt_reflect_function_slot(d, index),
		param_count: anti_rt_reflect_function_params(d, index),
	};
}

/// The field at `index` as a `Value` of the kind its type gives.
///
/// An integer comes at 64 bits and a float as an `f64`. A field of a type that
/// no `Value` carries, such as a slice or an inline struct, and an index out of
/// range give a value of kind `None`.
pub fn get(object: *byte, d: *byte, index: int) -> Value
{
	let v = nothing();
	anti_rt_reflect_get(object, d, index, &v);
	return v;
}

/// Write `value` into the field at `index`, which may fail.
///
/// The value is of the kind that `get` gives for the field, and an integer or a
/// float narrows to the field's type. A float narrows to an `f16` field through
/// `f32`, as `as f16` takes one. An index out of range, a field that no `Value`
/// carries and a value of another kind each fail with the code that names the
/// reason, and write nothing.
pub fn set(object: *byte, d: *byte, index: int, value: Value) may fail
{
	let v = value;
	let reason = anti_rt_reflect_set(object, d, index, &v);
	if reason == BAD_INDEX {
		fail lang.Error.new(BAD_INDEX, "the class has no field at this index");
	}
	if reason == NOT_CARRIED {
		fail lang.Error.new(NOT_CARRIED,
			"no Value carries the type of this field");
	}
	if reason == WRONG_KIND {
		fail lang.Error.new(WRONG_KIND,
			"the value is of another kind than the field takes");
	}
}

/// The name of the class `d` describes.
pub fn name(d: *byte) -> str
{
	return anti_rt_reflect_class_name(d);
}

extern fn anti_rt_reflect_class_name(d: ?*byte) -> str;

/// A new object on the heap of the class `name` names, or `none`.
///
/// `name` is the class's own name, or its module path and its name as
/// `geometry.Circle`. The object has the defaults of every field, and
/// `construct` has run. A name two modules declare needs the module path. An
/// abstract class, a singleton and a class whose `construct` takes arguments
/// give `none`, as does a name no class of the program has.
pub fn new(name: str) -> ?*Object
{
	return anti_rt_reflect_new(name.ptr, name.len);
}

/// The kind of value that a `Value` holds.
///
/// A signed integer of any width is an `Int`, an unsigned one a `Uint`, and
/// `f16`, `f32` and `f64` are a `Float`. A function without a result gives
/// `None`.
pub enum ValueKind: u8 { None, Int, Uint, Float, Bool, Char, Str, Ptr }

/// The bytes of a `Value`, read through the field its kind names.
pub union Payload
{
	i: int,
	u: uint,
	f: f64,
	b: bool,
	c: char,
	s: str,
	p: *byte,
}

/// A value of a primitive type, a `str` or a pointer, with its kind.
pub struct Value
{
	kind: ValueKind,
	data: Payload,
}

/// A value that holds nothing.
pub fn nothing() -> Value
{
	return Value { kind: ValueKind.None, data: Payload { i: 0 } };
}

/// A signed integer.
pub fn of_int(v: int) -> Value
{
	return Value { kind: ValueKind.Int, data: Payload { i: v } };
}

/// An unsigned integer.
pub fn of_uint(v: uint) -> Value
{
	return Value { kind: ValueKind.Uint, data: Payload { u: v } };
}

/// A float.
pub fn of_float(v: f64) -> Value
{
	return Value { kind: ValueKind.Float, data: Payload { f: v } };
}

/// A `bool`.
pub fn of_bool(v: bool) -> Value
{
	return Value { kind: ValueKind.Bool, data: Payload { b: v } };
}

/// A `char`.
pub fn of_char(v: char) -> Value
{
	return Value { kind: ValueKind.Char, data: Payload { c: v } };
}

/// A `str`, which keeps pointing at the bytes of `v`.
pub fn of_str(v: str) -> Value
{
	return Value { kind: ValueKind.Str, data: Payload { s: v } };
}

/// A pointer of any type, as its address.
pub fn of_ptr(v: *byte) -> Value
{
	return Value { kind: ValueKind.Ptr, data: Payload { p: v } };
}

/// Call the public function at `index` of the class of `object`, which may
/// fail.
///
/// The index counts the list that `function` reads, so the seven functions of
/// the root come first. `args` holds one value per parameter after `self`, of
/// the kind that parameter takes, and the call goes through the table of the
/// object as any call does. The result is the value the function returns, which
/// is of kind `None` for a function without a result. An index out of range
/// fails with the code `BAD_INDEX`, and a signature with a type that no `Value`
/// carries with `NOT_CARRIED`. Arguments of another count fail with
/// `WRONG_COUNT`, and of another kind with `WRONG_KIND`.
pub fn call(object: *Object, index: int, args: []Value) -> Value may fail
{
	let result = nothing();
	let reason = anti_rt_reflect_call(object, index, args.ptr, args.len,
		&result);
	if reason == BAD_INDEX {
		fail lang.Error.new(BAD_INDEX,
			"the class has no public function at this index");
	}
	if reason == NOT_CARRIED {
		fail lang.Error.new(NOT_CARRIED,
			"no Value carries a type of this function");
	}
	if reason == WRONG_COUNT {
		fail lang.Error.new(WRONG_COUNT,
			"the function takes another number of arguments");
	}
	if reason == WRONG_KIND {
		fail lang.Error.new(WRONG_KIND,
			"an argument is of another kind than its parameter takes");
	}
	return result;
}
