//! The root of the standard library, which imports nothing.
//!
//! It holds the types the compiler knows by name, so every other module
//! can name them without an import cycle. `Object` and `Job` belong to
//! it as well, and the compiler declares both itself.
//!
//! `Error` is the error convention of the language. A function that can
//! fail is declared `-> R may fail`, or `may fail` when it has no result.
//! It returns its result with `return`, and it leaves on the error channel
//! with `fail e;` or with `fail "text";`, which builds an `Error` of code
//! 0. Two answers come back as a tuple. The compiler gives it the ABI
//! `?*Error f(args, R *out)`: `none` on success, with the result written
//! through `out`. A binding writes that form by hand, and a call handles
//! it the same way.
//!
//! A function that cannot fail returns its value. A function whose only
//! failure is "not present" returns `?*T` or `bool`. The error a handler
//! binds is deleted when the handler exits, unless the handler returns it.

extern fn anti_rt_write(stream: c_int, bytes: ?*byte, count: c_size_t);
extern fn anti_rt_exit(status: c_int);
extern fn anti_rt_text_from_c(bytes: ?*byte) -> str;
extern fn anti_rt_trace_walk(into: ?*u64, room: int, skip: int) -> int;
extern fn anti_rt_trace_frame(address: u64, out: ?*RawFrame);
extern fn anti_rt_trace_text(frames: ?*RawFrame, count: int) -> ?*byte;
extern fn anti_rt_trace_symbolize(frame: ?*RawFrame, out: ?*Frame);

/// The most frames a trace keeps, the innermost ones.
const TRACE_DEPTH: int = 64;

/// A position in the source, which `here` gives.
///
/// `file` is the path under the search root that holds the source, the
/// one a failed check names. `function` is the full name of the function
/// the position stands in, `module.Class.f`. A location that no `here`
/// wrote has line 0.
pub struct SourceLocation
{
	file: str,
	line: int,
	column: int,
	function: str,
	module: str,
}

/// One return address of a trace, as the capture took it.
///
/// `module` is the path of the executable or the library the address
/// lies in, `build_id` the build id of that module and `base` the
/// address it was loaded at. Outside every module both texts are empty
/// and the base is 0.
pub struct RawFrame
{
	address: u64,
	module: str,
	build_id: str,
	base: u64,
}

/// One frame of a trace with its names.
///
/// `function` comes from the symbol table, which every build carries.
/// `file` and `line` come from the line table of a `-g` build, and are
/// empty and 0 without one.
pub struct Frame
{
	address: u64,
	function: str,
	file: str,
	line: int,
}

/// The return addresses of the calls that lead to a point of a program,
/// the innermost first.
///
/// The capture walks the frames and names nothing. `symbolize` reads the
/// names when a program asks for them, so a trace that nobody reads costs
/// the walk alone.
pub class StackTrace
{
	/// The frames as the capture took them, the innermost first.
	pub own frames: []RawFrame,
	/// The frames with their names, once `symbolize` ran.
	own named: []Frame,
	/// Whether `symbolize` has run.
	symbolized: bool = false,
	/// The bytes `text` gave, ended by a NUL.
	transient text_cache: ?*byte = none,

	/// The trace of the caller and the calls above it, without the `skip`
	/// innermost frames.
	pub fn capture(skip: int = 0) -> *StackTrace
	{
		let addresses: [64]u64 = [0; 64];
		let count = anti_rt_trace_walk(&addresses[0], TRACE_DEPTH, skip + 1);
		let t = alloc StackTrace {
			frames: []RawFrame { ptr: none, len: 0 },
			named: []Frame { ptr: none, len: 0 },
		};
		if count <= 0 {
			return t;
		}
		let list = alloc(RawFrame, count) else {
			return t;
		};
		let i = 0;
		while i < count do {
			anti_rt_trace_frame(addresses[i], &list[i]);
			i += 1;
		}
		t.frames = []RawFrame { ptr: list, len: count };
		return t;
	}

	/// The raw form: one line per module, `module <n> <build id> <base>
	/// <path>`, then one per frame, its address and `<n>+<offset>`.
	///
	/// A resolver matches the frames to the symbols of each module by the
	/// build id. The text is formed at the first call, and the trace keeps
	/// its bytes until it is deleted.
	pub fn text(self) -> str
	{
		let made = self.text_cache;
		if made != none {
			return anti_rt_text_from_c(made);
		}
		let room = anti_rt_trace_text(self.frames.ptr, self.frames.len) else {
			return "";
		};
		self.text_cache = room;
		return anti_rt_text_from_c(room);
	}

	/// The frames with their functions, and with their files and lines in
	/// a `-g` build.
	///
	/// The names are read at the first call, and the trace keeps them
	/// until it is deleted.
	pub fn symbolize(self) -> []Frame
	{
		if self.symbolized || self.frames.len == 0 {
			return self.named;
		}
		let list = alloc(Frame, self.frames.len) else {
			return self.named;
		};
		let i = 0;
		while i < self.frames.len do {
			anti_rt_trace_symbolize(&self.frames[i], &list[i]);
			i += 1;
		}
		self.named = []Frame { ptr: list, len: self.frames.len };
		self.symbolized = true;
		return self.named;
	}

	concrete fn destruct(self)
	{
		free(self.text_cache);
	}
}

/// A failure, with a code, a message and the error that caused it.
///
/// The first `fail` of an error writes where it stands into `at`, and
/// captures the frames there when backtraces are on. They are on in dev
/// mode, and `--anti.backtrace` turns them on in a release build.
pub class Error
{
	/// The code of the failure, which the caller may switch on.
	pub code: int = 0,
	/// One line, without a trailing newline.
	pub message: str = "",
	/// The error below this one, or `none`.
	protected own cause: ?*Error = none,
	/// The position of the first `fail` of this error, line 0 before it.
	pub at: SourceLocation = SourceLocation {
		file: "",
		line: 0,
		column: 0,
		function: "",
		module: "",
	},
	/// The frames at the first `fail` when backtraces are on, or `none`.
	own frames: ?*StackTrace = none,
	/// The bytes `text` gave, ended by a NUL. `dup` leaves the copy
	/// without them, and it formats its own.
	transient text_cache: ?*byte = none,

	/// An error with a code and a message and no cause.
	pub fn new(code: int, message: str) -> *Error
	{
		return alloc Error { code: code, message: message, cause: none };
	}

	/// An error that wraps the one below it and takes it over. The error
	/// a handler binds moves here, and the handler deletes it no longer.
	pub fn wrap(code: int, message: str, own cause: ?*Error) -> *Error
	{
		return alloc Error { code: code, message: message, cause: cause };
	}

	/// This error and every cause below it, in one text, and its trace.
	///
	/// Each error is `error N: message`, or the message alone when its
	/// code is 0, after `file:line:column: ` when a `fail` gave it a
	/// position. Every cause follows on a line of its own after
	/// `  caused by: `, and the trace of this error follows the causes
	/// when it has one. The text is formed at the first call, and the
	/// error keeps its bytes until it is deleted. When the memory for them
	/// runs out, the text is the message alone.
	pub fn text(self) -> str
	{
		let made = self.text_cache;
		if made != none {
			return anti_rt_text_from_c(made);
		}
		let caused_by = "\n  caused by: ";
		let length = line_length(self.at, self.code, self.message);
		let below = self.cause;
		while below != none do {
			length += caused_by.len +
				line_length(below.at, below.code, below.message);
			below = below.cause;
		}
		let trace = "";
		let frames = self.frames;
		if frames != none {
			trace = frames.text();
		}
		if trace.len > 0 {
			length += 1 + trace.len;
		}
		let room = alloc(byte, length + 1) else {
			return self.message;
		};
		let at = put_line(room, 0, self.at, self.code, self.message);
		below = self.cause;
		while below != none do {
			at = put_text(room, at, caused_by);
			at = put_line(room, at, below.at, below.code, below.message);
			below = below.cause;
		}
		if trace.len > 0 {
			at = put_text(room, at, "\n");
			at = put_text(room, at, trace);
		}
		room[at] = 0;
		self.text_cache = room;
		return anti_rt_text_from_c(room);
	}

	/// Write the text of this error and a newline to standard error.
	pub fn print(self)
	{
		let said = self.text();
		anti_rt_write(2, said.ptr, said.len as c_size_t);
		anti_rt_write(2, "\n".ptr, 1);
	}

	/// Print this error and end the program with its code, or with 1.
	///
	/// The function that `error.on_fatal` registered runs first.
	pub fn fatal(self)
	{
		let last = Fatal.get().hook.load();
		if last != none {
			last();
		}
		self.print();
		if self.code != 0 {
			anti_rt_exit(self.code as c_int);
		}
		anti_rt_exit(1);
	}

	concrete fn destruct(self)
	{
		free(self.text_cache);
	}
}

/// The error of a `?*T` that held `none` where a pointer was needed.
///
/// `p catch fatal` and `p catch e { }` on a `?*T` give one of these. It
/// is an `Error` like any other, so a handler that takes an `*Error`
/// takes it too.
pub class NoneDereference inherits Error
{
	/// The error a `catch` on a `none` pointer gives.
	pub fn new() -> *NoneDereference
	{
		let e = alloc NoneDereference { };
		e.code = 1;
		e.message = "the pointer is none";
		return e;
	}
}

/// The one function that runs before `fatal` ends the program.
///
/// `error.on_fatal` stores it. The hook is an atomic field, so a program
/// replaces it without a data race.
internal singleton class Fatal
{
	pub atomic hook: ?fn() = none,
}

/// The number of bytes `put_line` writes for one error of a chain.
fn line_length(origin: SourceLocation, code: int, message: str) -> int
{
	let length = message.len;
	if origin.line != 0 {
		length += origin.file.len + 1 + digits_of(origin.line) + 1 +
			digits_of(origin.column) + 2;
	}
	if code != 0 {
		length += 6 + digits_of(code) + 2;
	}
	return length;
}

/// Write one error of a chain at `at`, after its position when it has
/// one, and give the index after it.
fn put_line(room: *byte, at: int, origin: SourceLocation, code: int,
	message: str) -> int
{
	let next = at;
	if origin.line != 0 {
		next = put_text(room, next, origin.file);
		next = put_text(room, next, ":");
		next = put_int(room, next, origin.line);
		next = put_text(room, next, ":");
		next = put_int(room, next, origin.column);
		next = put_text(room, next, ": ");
	}
	if code != 0 {
		next = put_text(room, next, "error ");
		next = put_int(room, next, code);
		next = put_text(room, next, ": ");
	}
	return put_text(room, next, message);
}

/// Copy the bytes of `s` to `room` at `at`, and give the index after them.
fn put_text(room: *byte, at: int, s: str) -> int
{
	let i = 0;
	while i < s.len do {
		room[at + i] = s[i];
		i += 1;
	}
	return at + s.len;
}

/// The number of bytes of `n` in decimal, with its sign.
fn digits_of(n: int) -> int
{
	let count = 1;
	let rest = n / 10;
	while rest != 0 do {
		count += 1;
		rest = rest / 10;
	}
	if n < 0 {
		count += 1;
	}
	return count;
}

/// Write `n` in decimal at `at`, and give the index after it.
///
/// The digits come from the remainders of `n` itself and never from its
/// negation, so the lowest `int` is written as it is.
fn put_int(room: *byte, at: int, n: int) -> int
{
	let end = at + digits_of(n);
	let first = at;
	if n < 0 {
		/* A character literal is a Unicode scalar, so `-` and the digits
		   stand here as their values. */
		room[at] = 0x2D;
		first = at + 1;
	}
	let i = end;
	let rest = n;
	while i > first do {
		i -= 1;
		let digit = rest % 10;
		if digit < 0 {
			digit = -digit;
		}
		room[i] = (0x30 + digit) as byte;
		rest = rest / 10;
	}
	return end;
}
