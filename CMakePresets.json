{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Host build",
            "description": "Warnings are errors, the host target, the full test suite",
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "asan",
            "displayName": "AddressSanitizer",
            "description": "Debug build of antic and its runtime under AddressSanitizer",
            "binaryDir": "${sourceDir}/build-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS": "-fsanitize=address -g"
            }
        },
        {
            "name": "ubsan",
            "displayName": "Address and UndefinedBehaviorSanitizer",
            "description": "Debug build under both sanitizers, with no recovery",
            "binaryDir": "${sourceDir}/build-ubsan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all"
            }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "ubsan", "configurePreset": "ubsan" }
    ],
    "testPresets": [
        { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } },
        { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
        { "name": "ubsan", "configurePreset": "ubsan", "output": { "outputOnFailure": true } }
    ]
}
