//! The conveniences of the error convention.
//!
//! `Error` and the convention itself live in `anti.lang`, the root of the
//! standard library. `anti.error` adds `SystemError`, the error of a failing
//! system call, `on_fatal`, which registers the function that runs before
//! `fatal` ends the program, and `check`.

import anti.lang;

extern fn anti_rt_errno() -> c_int;
extern fn anti_rt_errno_text(code: c_int) -> ?*byte;
extern fn anti_rt_last_error() -> c_int;
extern fn anti_rt_last_error_text(code: c_int) -> ?*byte;
extern fn anti_rt_text_from_c(bytes: ?*byte) -> str;

/// The error of a failing system call, with the number the system gave.
pub class SystemError inherits lang.Error
{
	/// The number of the failure: `errno`, or the Win32 error code. The code of
	/// the error holds it as well.
	pub errno: int = 0,

	/// The error of the last failing C call, from `errno`.
	pub fn from_errno() -> *SystemError
	{
		let number = anti_rt_errno() as int;
		let e = alloc SystemError { errno: number };
		e.code = number;
		e.message = anti_rt_text_from_c(anti_rt_errno_text(number as c_int));
		return e;
	}

	/// The error of the last failing Win32 call.
	///
	/// Every other system gives an error with code 0 and an empty message,
	/// because it has no Win32 to ask.
	pub fn from_win32() -> *SystemError
	{
		let number = anti_rt_last_error() as int;
		let e = alloc SystemError { errno: number };
		e.code = number;
		e.message =
			anti_rt_text_from_c(anti_rt_last_error_text(number as c_int));
		return e;
	}
}

/// Register the function that runs before `fatal` ends the program.
///
/// One function is registered at a time, and a later call replaces the one
/// before it.
pub fn on_fatal(keep f: fn())
{
	/* The singleton is bound to a local first. The checker refuses the
	   chained `lang.Fatal.get().hook.store(f)` across modules, a defect
	   that docs/reports/2026-09-21-anti-lang-error.md reports. */
	let fatal = lang.Fatal.get();
	fatal.hook.store(f);
}

/// Call `fatal` on an error, and return on `none`.
///
/// It takes the result of a function written by hand as `-> ?*Error`, such as a
/// binding. A call of a `may fail` function writes `catch fatal` instead.
pub fn check(e: ?*lang.Error)
{
	if e != none {
		e.fatal();
	}
}
