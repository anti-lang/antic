//! The JSON that `serialize` writes and `deserialize` reads.
//!
//! Every object writes itself as a JSON object. The default body of `serialize`
//! writes the class name under `type`, then one member per field of the chain,
//! the root's first. A field the field list cannot read is written as `null`,
//! and a class that wants more replaces `serialize` and writes its members with
//! the functions here.
//!
//! `Object.deserialize(input, from)` builds an object back from the JSON of the
//! default `serialize`, in memory of the `anti.mem.Allocator` `from`. The
//! functions here read the text of one member, for a class that writes its own
//! members. `member` gives `false` for a member the object does not hold, and
//! `unquote` may fail.

import anti.lang;
import anti.text;

extern fn anti_rt_json_write_text(out: ?*text.Builder, bytes: ?*byte,
	len: int);
extern fn anti_rt_json_unquote(out: ?*text.Builder, bytes: ?*byte,
	len: int) -> c_int;
extern fn anti_rt_json_member(source: ?*byte, len: int, name: ?*byte,
	name_len: int, start: ?*int, value_len: ?*int) -> bool;

/// Write `value` as a JSON object.
///
/// A pointer that is `none` writes `null`.
pub fn write(value: ?*Object, out: *text.Builder)
{
	if value == none {
		out.append("null");
		return;
	}
	value.serialize(out);
}

/// Write `s` as a JSON string, with the quotes and the escapes.
///
/// It is the writer of the default `serialize`, so `unquote` gives back every
/// byte of `s`.
pub fn write_text(s: str, out: *text.Builder)
{
	anti_rt_json_write_text(out, s.ptr, s.len);
}

/// Write `value` as a JSON number, the decimal digits that
/// `text.Builder.append_int` writes.
pub fn write_int(value: int, out: *text.Builder)
{
	out.append_int(value);
}

/// Write `value` as `true` or `false`.
pub fn write_bool(value: bool, out: *text.Builder)
{
	if value {
		out.append("true");
	} else {
		out.append("false");
	}
}

/// The text of the member `name` of the JSON object `source`.
///
/// The text is the value as it stands, quotes included for a string, without
/// the space around it. A key matches with its escapes read, and the first of
/// two equal keys is the one found. The result is false when the object holds
/// no such member, and when `source` is no single JSON object.
pub fn member(source: str, name: str, out: *str) -> bool
{
	let start = 0;
	let len = 0;
	if !anti_rt_json_member(source.ptr, source.len, name.ptr, name.len, &start,
		&len) {
		return false;
	}
	*out = text.slice(source, start, start + len);
	return true;
}

/// Write the bytes of the JSON string `source` into `out`, which may fail.
///
/// The string is read as `Object.deserialize` reads one, and may have space
/// around it. A `\u` escape gives the bytes of its code point in UTF-8. A
/// `source` that is no JSON string fails with code 0: an unknown escape, a
/// control byte, a `\u` escape of a surrogate half and any text after the
/// closing quote are refused, and `out` keeps the bytes read before the fault.
pub fn unquote(source: str, out: *text.Builder) may fail
{
	let read = anti_rt_json_unquote(out, source.ptr, source.len);
	if read < 0 {
		fail lang.Error.new(1, "out of memory");
	}
	if read == 0 {
		fail "the text is no JSON string";
	}
}
