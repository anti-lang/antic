//! The interfaces of walking and the parts every collection shares.
//!
//! `Iterable<T>` and `Iterator<T>` are the constraints of a function that takes
//! any collection or iterator of a given element type. `Collection<T>` is the
//! base of every generic collection. It holds the allocator, the count and the
//! changes, and it gives the functions every collection has: the `find`,
//! `update` and `remove` forms, `clear`, `to_text` and `serialize`. A
//! collection fills five functions that reach its elements by place, and each
//! collection module gives its class `==` through `equal`. `Indexed<T>` is the
//! base of the collections that reach their elements by a position from 0.

import anti.lang;
import anti.mem;
import anti.text;

extern fn memcpy(to: ?*byte, from: ?*byte, count: c_size_t) -> ?*byte;
extern fn memmove(to: ?*byte, from: ?*byte, count: c_size_t) -> ?*byte;
extern fn memset(to: ?*byte, value: c_int, count: c_size_t) -> ?*byte;
extern fn anti_rt_type_arg(object: ?*byte, depth: int, index: int) -> ?*byte;
extern fn anti_rt_element_serialize(out: ?*text.Builder, bytes: ?*byte,
	arg: ?*byte);
extern fn anti_rt_element_text(out: ?*text.Builder, bytes: ?*byte,
	arg: ?*byte);
extern fn anti_rt_arg_is_str(arg: ?*byte) -> c_int;

/// The capacity a growing collection starts with when it is made without one.
const FIRST_CAPACITY: int = 8;

/// A type that `for` walks, giving elements of type `T`.
///
/// It is a constraint: `fn total<C: Iterable<int>>(c: *C) -> int` takes any
/// collection of `int`. A type meets it when its `iter` hook gives an iterator
/// that meets `Iterator<T>`, so a class with the hook meets it without a line
/// of its own.
pub abstract class Iterable<T>
	allow(unfilled-abstract, "a type meets it through its hooks")
{
}

/// An iterator that gives elements of type `T`.
///
/// A type meets it as a constraint when its `next` hook moves on and its
/// `value` hook gives a `T`, or a `lent *T` of an element in place.
pub abstract class Iterator<T>
	allow(unfilled-abstract, "a type meets it through its hooks")
{
}

/// The failure of a `_one` form, which found no element or more than one.
///
/// `count` holds the number of elements that matched, and the message names the
/// form: `` `find_one` found 3 elements where it needs exactly one ``.
pub class NotOne inherits lang.Error
{
	/// The number of elements that matched, 0 or more than 1.
	pub count: int = 0,
	/// The bytes of the message, which the error frees. A copy made with `dup`
	/// shares them with the error it copies.
	transient made: ?*byte = none,

	/// The failure of the form named `form`, which found `count` elements.
	pub fn found(form: str, count: int) -> *NotOne
	{
		let e = alloc NotOne { count: count };
		let message = "";
		if count == 0 {
			message = f"`{form}` found no element where it needs exactly one";
		} else {
			message = f"`{form}` found {count} elements where it needs exactly one";
		}
		e.message = message;
		e.made = message.ptr;
		return e;
	}

	concrete fn destruct(self)
	{
		free(self.made);
	}
}

/// The allocator a collection made with `from` takes: `from` itself, or the C
/// library when it is `none`.
pub fn allocator(from: ?*mem.Allocator) -> *mem.Allocator
{
	if let chosen = from {
		return chosen;
	}
	return mem.LibcAllocator.get();
}

/// The base of every generic collection, with the parts they all share.
///
/// A collection is a class used as a value. It holds its elements by value in
/// memory of its own, which comes from the allocator it was made with and goes
/// back to it. `count` is the number of elements, and the changes of the size
/// are what the iterator of a collection watches, so a dev build stops a `for`
/// over a collection that changed.
///
/// Criteria come in three forms. `_all` acts on every match and gives the
/// count, `_first` on the first match in the order of the collection, and
/// `_one` on the one match. `_one` fails with `NotOne` when nothing matches and
/// when more than one element does.
///
/// A collection fills five functions that reach an element by its place, an
/// `int` of its own choosing that the order of the collection walks from
/// `first_place` through `next_place` to `-1`. They serve the functions of this
/// class, which a collection may replace with faster ones.
pub abstract class Collection<T>
{
	/// The number of elements.
	pub count: int = 0,
	/// The allocator of every block the collection holds.
	protected from: *mem.Allocator,
	/// The changes of the size, which an iterator of the collection watches.
	protected changes: lang.Changes = lang.Changes {
		count: 0,
		at: lang.SourceLocation {
			file: "",
			line: 0,
			column: 0,
			function: "",
			module: "",
		},
	},

	/// The place of the first element, or -1 when there is none.
	abstract fn first_place(self) -> int;

	/// The place of the element after the one at `at`, or -1 after the last.
	abstract fn next_place(self, at: int) -> int;

	/// Lend the element at the place `at` to `f`, which may change it.
	abstract fn lend_place(self, at: int, f: fn(lent *T));

	/// A copy of the element at the place `at`, which owns what it holds.
	abstract fn copy_place(self, at: int) -> T;

	/// Move the element at the place `at` out of the collection and give it
	/// with the place of the element after it, or -1.
	///
	/// `count` still counts the element, and the caller takes it off.
	abstract fn take_place(self, at: int) -> (T, int);

	/// Whether the collection holds no element.
	pub fn is_empty(self) -> bool
	{
		return self.count == 0;
	}

	/// Copies of every element that `test` accepts, in the order of the
	/// collection, from the allocator of the collection.
	pub fn find_all(self, test: fn(T) -> bool) -> Copies<T>
	{
		let found = Copies<T>.new(0, self.from);
		let at = self.first_place();
		while at >= 0 do {
			if self.accepts(at, test) {
				found.add(self.copy_place(at));
			}
			at = self.next_place(at);
		}
		return found;
	}

	/// A copy of the first element that `test` accepts, or `none`.
	pub fn find_first(self, test: fn(T) -> bool) -> ?T
	{
		let at = self.first_match(test);
		if at < 0 {
			return none;
		}
		return self.copy_place(at);
	}

	/// A copy of the one element that `test` accepts.
	///
	/// It fails with `NotOne` when no element or more than one matches.
	pub fn find_one(self, test: fn(T) -> bool) -> T may fail
	{
		let at = try self.one_match("find_one", test);
		return self.copy_place(at);
	}

	/// Run `change` on every element that `test` accepts, in place, and give
	/// their number.
	pub fn update_all(self, test: fn(T) -> bool, change: fn(lent *T)) -> int
	{
		let n = 0;
		let at = self.first_place();
		while at >= 0 do {
			if self.accepts(at, test) {
				self.lend_place(at, change);
				n += 1;
			}
			at = self.next_place(at);
		}
		return n;
	}

	/// Run `change` on the first element that `test` accepts, in place. Gives
	/// `false` when no element matches.
	pub fn update_first(self, test: fn(T) -> bool, change: fn(lent *T)) -> bool
	{
		let at = self.first_match(test);
		if at < 0 {
			return false;
		}
		self.lend_place(at, change);
		return true;
	}

	/// Run `change` on the one element that `test` accepts, in place.
	///
	/// It fails with `NotOne` and changes nothing when no element or more than
	/// one matches.
	pub fn update_one(self, test: fn(T) -> bool, change: fn(lent *T)) may fail
	{
		let at = try self.one_match("update_one", test);
		self.lend_place(at, change);
	}

	/// Remove every element that `test` accepts and give their number.
	///
	/// It is the way to remove while walking, since a `for` over a collection
	/// that changes stops a dev build.
	pub fn remove_all(self, test: fn(T) -> bool,
		at: lang.SourceLocation = here) -> int
	{
		let n = 0;
		let place = self.first_place();
		while place >= 0 do {
			if self.accepts(place, test) {
				let (gone, after) = self.take_place(place);
				self.resized(-1, at);
				place = after;
				n += 1;
			} else {
				place = self.next_place(place);
			}
		}
		return n;
	}

	/// Remove the first element that `test` accepts and give it, or `none`.
	pub fn remove_first(self, test: fn(T) -> bool,
		at: lang.SourceLocation = here) -> ?T
	{
		let place = self.first_match(test);
		if place < 0 {
			return none;
		}
		let (taken, after) = self.take_place(place);
		self.resized(-1, at);
		return taken;
	}

	/// Remove the one element that `test` accepts and give it.
	///
	/// It fails with `NotOne` and removes nothing when no element or more than
	/// one matches.
	pub fn remove_one(self, test: fn(T) -> bool,
		at: lang.SourceLocation = here) -> T may fail
	{
		let place = try self.one_match("remove_one", test);
		let (taken, after) = self.take_place(place);
		self.resized(-1, at);
		return taken;
	}

	/// Remove every element.
	pub fn clear(self, at: lang.SourceLocation = here)
	{
		let place = self.first_place();
		while place >= 0 do {
			let (gone, after) = self.take_place(place);
			self.count -= 1;
			place = after;
		}
		self.resized(0, at);
	}

	/// The elements as text, `[1, 2, 3]`.
	///
	/// A number stands as it is, a `str` and a `char` as a quoted string, and a
	/// class as its own `to_text`. The text is memory of its own from the C
	/// library, which `free(s.ptr)` returns.
	concrete fn to_text(self) -> str
	{
		let out = text.Builder.new();
		let arg = self.element_type();
		let place = self.first_place();
		let first = true;
		out.append("[");
		while place >= 0 do {
			let copy = self.copy_place(place);
			if !first {
				out.append(", ");
			}
			anti_rt_element_text(&out, &copy as ?*byte, arg);
			first = false;
			place = self.next_place(place);
		}
		out.append("]");
		return out.take();
	}

	/// Write the elements to `out` as a JSON array, each as `serialize` writes
	/// a field of its type.
	concrete fn serialize(self, out: *text.Builder)
	{
		let arg = self.element_type();
		let place = self.first_place();
		let first = true;
		out.append("[");
		while place >= 0 do {
			let copy = self.copy_place(place);
			if !first {
				out.append(",");
			}
			first = false;
			anti_rt_element_serialize(out, &copy as ?*byte, arg);
			place = self.next_place(place);
		}
		out.append("]");
	}

	/// Whether `other` holds as many elements as this one and `same` accepts
	/// each pair of them in order. A collection module gives its class `==`
	/// with `equal`, which passes `==` of the elements.
	pub fn equal_by(self, other: *Collection<T>,
		same: fn(lent *T, lent *T) -> bool) -> bool
	{
		if self.count != other.count {
			return false;
		}
		let mine = self.first_place();
		let theirs = other.first_place();
		while mine >= 0 && theirs >= 0 do {
			let a = self.copy_place(mine);
			let b = other.copy_place(theirs);
			if !same(&a, &b) {
				return false;
			}
			mine = self.next_place(mine);
			theirs = other.next_place(theirs);
		}
		return mine < 0 && theirs < 0;
	}

	/// Count a change of the size by `by` elements, made at `at`, which a `for`
	/// over the collection sees.
	protected fn resized(self, by: int, at: lang.SourceLocation)
	{
		self.count += by;
		self.changes.count += 1;
		self.changes.at = at;
	}

	/// The watch of the changes that an iterator of the collection holds.
	protected fn watch(self) -> lang.Watch
	{
		return lang.Watch { changes: &self.changes, count: self.changes.count };
	}

	/// Room for `n` elements from the allocator, or `none` when it has run out.
	/// A request for none gives `none`.
	///
	/// DESIGN: every slot that holds no element holds zero bytes. `=` into a
	/// slot then finds a zero table and tears nothing down, as it does in the
	/// room `alloc(T, n)` gives. A collection moves its elements as bytes and
	/// zeroes the slots they leave, with `close_gap`.
	protected fn room(self, n: int) -> ?*T
	{
		if n <= 0 {
			return none;
		}
		return room_from<T>(self.from, n);
	}

	/// Give back room that `room` gave.
	protected fn give_back(self, p: ?*T)
	{
		self.from.free(p as ?*byte);
	}

	/// Move the first `used` elements at `p` into new room for `n` and give
	/// back the old room. Gives `none` and keeps `p` when the allocator has run
	/// out.
	protected fn moved(self, p: ?*T, used: int, n: int) -> ?*T
	{
		let made = self.room(n) else {
			return none;
		};
		if used > 0 {
			memcpy(made as ?*byte, p as ?*byte,
				(used * size_of(T)) as c_size_t);
		}
		self.give_back(p);
		return made;
	}

	/// Move the elements after the slot `at` of the `used` at `p` one slot down
	/// as bytes, over the element that left `at`, and zero the last slot.
	protected fn close_gap(self, p: *T, at: int, used: int)
	{
		if at + 1 < used {
			memmove(&p[at] as ?*byte, &p[at + 1] as ?*byte,
				((used - at - 1) * size_of(T)) as c_size_t);
		}
		memset(&p[used - 1] as ?*byte, 0, size_of(T) as c_size_t);
	}

	/// The capacity that holds `need` elements when `have` does not: the first
	/// capacity, doubled as often as it takes.
	protected fn grown(self, have: int, need: int) -> int
	{
		let size = have;
		if size < FIRST_CAPACITY {
			size = FIRST_CAPACITY;
		}
		while size < need do {
			size *= 2;
		}
		return size;
	}

	/// A copy of the element at `p`, which owns what it holds: a class value
	/// takes the copy of its class, an owning struct or tuple a copy of each
	/// part that owns something, and every other type its bytes.
	protected fn copy_element(self, p: *T) -> T
	{
		return dup(*p);
	}

	/// Tear down the element at `p`, which the collection then forgets.
	protected fn destroy_element(self, p: *T)
	{
		destroy(p);
	}

	/// The record of `T` in the descriptor of this copy of the class, which
	/// sits one level below the root in every chain.
	fn element_type(self) -> ?*byte
	{
		return anti_rt_type_arg(self as ?*byte, 1, 0);
	}

	/// Whether `test` accepts the element at the place `at`.
	protected fn accepts(self, at: int, test: fn(T) -> bool) -> bool
	{
		let yes = false;
		self.lend_place(at, fn(p) {
			yes = test(*p);
		});
		return yes;
	}

	/// The place of the first element `test` accepts, or -1.
	protected fn first_match(self, test: fn(T) -> bool) -> int
	{
		let at = self.first_place();
		while at >= 0 do {
			if self.accepts(at, test) {
				return at;
			}
			at = self.next_place(at);
		}
		return -1;
	}

	/// The place of the one element `test` accepts. It fails with `NotOne`,
	/// named after `form`, when no element or more than one matches.
	protected fn one_match(self, form: str, test: fn(T) -> bool) -> int may fail
	{
		let found = -1;
		let n = 0;
		let at = self.first_place();
		while at >= 0 do {
			if self.accepts(at, test) {
				if n == 0 {
					found = at;
				}
				n += 1;
			}
			at = self.next_place(at);
		}
		if n != 1 {
			fail NotOne.found(form, n);
		}
		return found;
	}
}

/// Whether `a` and `b` hold equal elements in the same order.
///
/// A collection module gives its class `==` through it, as `operator fn eq<T:
/// eq>(a: List<T>, b: List<T>) -> bool`, so a collection has `==` exactly when
/// its elements do.
pub fn equal<T: eq>(a: *Collection<T>, b: *Collection<T>) -> bool
{
	return a.equal_by(b, fn(x, y) {
		return *x == *y;
	});
}

/// The hash of the elements of `c` in the order of its places, so two
/// collections that hold equal elements in the same order hash alike.
///
/// A sequence gives its class a hash through it, as `operator fn hash<T:
/// hash>(a: List<T>) -> u64` beside its `==`.
pub fn hash_in_order<T: hash>(c: *Collection<T>) -> u64
{
	return hash_in_order_by<T>(c, fn(p) {
		return (*p).hash();
	});
}

/// The hash of the elements of `c` in the order of its places, with
/// `element_hash` giving the hash of each, as `hash_in_order` combines them. A
/// collection that keeps more than its elements in each slot hashes the
/// element alone through it, so it hashes as a sequence of its elements.
pub fn hash_in_order_by<T>(c: *Collection<T>,
	element_hash: fn(lent *T) -> u64) -> u64
{
	let h = c.count.hash();
	let at = c.first_place();
	while at >= 0 do {
		c.lend_place(at, fn(p) {
			h = (h, element_hash(p)).hash();
		});
		at = c.next_place(at);
	}
	return h;
}

/// The hash of the elements of `c` whatever their order, the sum of the hash of
/// each with their count, so two maps or two sets that hold equal entries hash
/// alike.
pub fn hash_in_any_order<T: hash>(c: *Collection<T>) -> u64
{
	return hash_of_sum(c.count, hash_sum<T>(c));
}

/// The sum of the hash of each element of `c`, which does not depend on their
/// order. A collection kept in parts adds the sum of each part and gives the
/// total to `hash_of_sum`, so it hashes as one collection of the same elements.
pub fn hash_sum<T: hash>(c: *Collection<T>) -> u64
{
	let sum: u64 = 0;
	let at = c.first_place();
	while at >= 0 do {
		c.lend_place(at, fn(p) {
			sum +%= (*p).hash();
		});
		at = c.next_place(at);
	}
	return sum;
}

/// The hash of `count` elements whose hashes add up to `sum`, as
/// `hash_in_any_order` gives it.
pub fn hash_of_sum(count: int, sum: u64) -> u64
{
	return (count, sum).hash();
}

/// Whether the record `arg` of a type argument names `str`. A map whose key is
/// `str` writes a JSON object, `{"Ann":41}`, and any other map an array of
/// pairs, `[[1,10],[2,20]]`.
///
/// DESIGN: the runtime reads the record, so no module of the library copies the
/// layout of `struct anti_field` or the numbers of the types, and none imports
/// `anti.reflect` for them.
pub fn text_keys(arg: ?*byte) -> bool
{
	return anti_rt_arg_is_str(arg) != 0;
}

/// Open the entries of a map, written as a JSON object when `named` and as an
/// array of pairs otherwise.
pub fn open_entries(out: *text.Builder, named: bool)
{
	if named {
		out.append("{");
	} else {
		out.append("[");
	}
}

/// Close what `open_entries` opened.
pub fn close_entries(out: *text.Builder, named: bool)
{
	if named {
		out.append("}");
	} else {
		out.append("]");
	}
}

/// Write one entry of a map as JSON, the key at `k` of the record `key` and the
/// value at `v` of the record `value`, each as `serialize` writes a field of
/// its type: a member of an object when `named` and a pair in an array
/// otherwise. `first` is the first entry, which no comma precedes.
pub fn write_entry(out: *text.Builder, named: bool, first: bool, k: ?*byte,
	key: ?*byte, v: ?*byte, value: ?*byte)
{
	start_entry(out, named, first);
	anti_rt_element_serialize(out, k, key);
	between_entry(out, named);
	anti_rt_element_serialize(out, v, value);
	end_entry(out, named);
}

/// Write one entry of a map as JSON from the texts `k` and `v`, which
/// `serialize` wrote before, as `write_entry` writes it.
pub fn write_entry_texts(out: *text.Builder, named: bool, first: bool, k: str,
	v: str)
{
	start_entry(out, named, first);
	out.append(k);
	between_entry(out, named);
	out.append(v);
	end_entry(out, named);
}

/// Write one entry of a map as `to_text` of a map writes it, `"Ann": 41`, the
/// key at `k` of the record `key` and the value at `v` of the record `value`,
/// each as `to_text` of a collection writes an element. `first` is the first
/// entry, which no comma precedes.
pub fn write_entry_text(out: *text.Builder, first: bool, k: ?*byte,
	key: ?*byte, v: ?*byte, value: ?*byte)
{
	if !first {
		out.append(", ");
	}
	anti_rt_element_text(out, k, key);
	out.append(": ");
	anti_rt_element_text(out, v, value);
}

/// The comma before an entry that is not the first, and the bracket of a pair.
fn start_entry(out: *text.Builder, named: bool, first: bool)
{
	if !first {
		out.append(",");
	}
	if !named {
		out.append("[");
	}
}

/// What stands between the key and the value of an entry.
fn between_entry(out: *text.Builder, named: bool)
{
	if named {
		out.append(":");
	} else {
		out.append(",");
	}
}

/// The bracket that closes a pair.
fn end_entry(out: *text.Builder, named: bool)
{
	if !named {
		out.append("]");
	}
}

/// The alignment of the room of an element: the largest power of two that
/// divides its size, which every alignment the layout gives it divides.
fn element_align<T>() -> int
{
	let size = size_of(T);
	if size <= 0 {
		return 1;
	}
	return size & -size;
}

/// The alignment of a block that holds elements of `T` beside words of `int`:
/// that of the element, and at least that of an `int`.
internal fn block_align<T>() -> int
{
	let align = element_align<T>();
	if align < size_of(int) {
		return size_of(int);
	}
	return align;
}

/// Room for `n` elements of `T` from `from`, every byte zero, or `none` when
/// the allocator has run out. A request for none gives `none`.
///
/// `room` of `Collection<T>` takes its room here, and so does a class of a
/// collection module outside that base.
internal fn room_from<T>(from: *mem.Allocator, n: int) -> ?*T
{
	if n <= 0 {
		return none;
	}
	let made = from.alloc(n * size_of(T), element_align<T>());
	if made != none {
		memset(made, 0, (n * size_of(T)) as c_size_t);
	}
	return made as ?*T;
}

/// The base of the collections that keep their elements in one block of room
/// and reach each by its position from 0: `List`, `Deque`, `Ring`, `Grid`,
/// `PriorityQueue` and `Copies`.
///
/// The element at position `i` stands in the slot `slot(i)`. The slots count
/// from `head` and wrap at `capacity`, so a collection whose `head` stays 0
/// keeps its elements side by side from the start of the room, and a ring that
/// moves `head` keeps them in a ring. The place of an element is its position,
/// so the class fills the five functions of `Collection<T>`, and it holds the
/// growth, the walk, the copy and the teardown once for all of them.
pub abstract class Indexed<T> inherits Collection<T>
{
	/// The room, `capacity` slots and `spare` more, or `none` before any.
	protected items: ?*T = none,
	/// The number of slots that hold elements or room for them.
	protected capacity: int = 0,
	/// The slot of the element at position 0.
	protected head: int = 0,
	/// The slots past `capacity` that the room holds for the class itself.
	protected spare: int = 0,
	/// Whether the elements stand in a ring, so that the first leaves by moving
	/// `head` on. Otherwise `head` stays 0 and the elements stand side by side.
	protected ring: bool = false,

	concrete fn first_place(self) -> int
	{
		if self.count == 0 {
			return -1;
		}
		return 0;
	}

	concrete fn next_place(self, at: int) -> int
	{
		if at + 1 >= self.count {
			return -1;
		}
		return at + 1;
	}

	concrete fn lend_place(self, at: int, f: fn(lent *T))
	{
		let items = self.items catch fatal;
		f(&items[self.slot(at)]);
	}

	concrete fn copy_place(self, at: int) -> T
	{
		let items = self.items catch fatal;
		return self.copy_element(&items[self.slot(at)]);
	}

	/// The element at `at` leaves, and the elements after it move one slot back
	/// as bytes to close the gap. In a ring the first element leaves by moving
	/// `head` on instead.
	concrete fn take_place(self, at: int) -> (T, int)
	{
		let items = self.items catch fatal;
		let after = -1;
		if at + 1 < self.count {
			after = at;
		}
		let taken = (items[self.slot(at)], after);
		if !self.ring {
			self.close_gap(items, at, self.count);
			return taken;
		}
		if at == 0 {
			memset(&items[self.head] as ?*byte, 0, size_of(T) as c_size_t);
			self.head = self.slot(1);
			return taken;
		}
		let i = at;
		while i + 1 < self.count do {
			memcpy(&items[self.slot(i)] as ?*byte,
				&items[self.slot(i + 1)] as ?*byte, size_of(T) as c_size_t);
			i += 1;
		}
		memset(&items[self.slot(self.count - 1)] as ?*byte, 0,
			size_of(T) as c_size_t);
		return taken;
	}

	/// The slot that holds the element at position `i`, which lies between 0
	/// and `capacity`.
	protected fn slot(self, i: int) -> int
	{
		let s = self.head + i;
		if s >= self.capacity {
			s -= self.capacity;
		}
		return s;
	}

	/// A walk of the elements from position 0, which lends each in turn.
	protected fn walk(self) -> IndexedWalk<T>
	{
		return IndexedWalk<T>.over(self.items, self.capacity, self.head,
			self.count, self.watch());
	}

	/// Make room for `n` more elements, doubling the capacity as often as it
	/// takes.
	protected fn make_room(self, n: int)
	{
		if self.count + n > self.capacity {
			self.resize(self.grown(self.capacity, self.count + n));
		}
	}

	/// Move the elements in order into room for `n` and the spare slots, the
	/// first at the start, and give back the old room. `n` is at least `count`,
	/// and room for no slot at all gives back the room. Stops the program when
	/// the allocator has run out.
	protected fn resize(self, n: int)
	{
		if n + self.spare == 0 {
			self.give_back(self.items);
			self.items = none;
			self.capacity = 0;
			self.head = 0;
			return;
		}
		let made = self.room(n + self.spare) catch fatal;
		if let items = self.items {
			let first = self.capacity - self.head;
			if first > self.count {
				first = self.count;
			}
			if first > 0 {
				memcpy(made as ?*byte, &items[self.head] as ?*byte,
					(first * size_of(T)) as c_size_t);
			}
			if self.count > first {
				memcpy(&made[first] as ?*byte, items as ?*byte,
					((self.count - first) * size_of(T)) as c_size_t);
			}
			self.give_back(items);
		}
		self.items = made;
		self.capacity = n;
		self.head = 0;
	}

	/// Give `made`, whose bytes are a copy of this collection's, room of its
	/// own for `n` elements and the spare slots from the same allocator, and a
	/// copy of each element in order from the start. `n` is at least `count`.
	/// The copy of a class calls it after it copied its bytes, as `dup` makes
	/// one.
	///
	/// DESIGN: `dup` gives a replaced `copy` memory that nothing has written,
	/// and a collection gives it the bytes of the element. The class copies its
	/// own bytes into `to` first in both cases, its table among them, since
	/// only it knows its size, and the copy then takes room of its own here.
	protected fn copy_into(self, made: *Indexed<T>, n: int)
	{
		made.items = none;
		made.capacity = 0;
		made.head = 0;
		if n + self.spare == 0 {
			return;
		}
		let room = self.room(n + self.spare) catch fatal;
		if let items = self.items {
			let i = 0;
			while i < self.count do {
				room[i] = self.copy_element(&items[self.slot(i)]);
				i += 1;
			}
		}
		made.items = room;
		made.capacity = n;
	}

	fn destruct(self)
	{
		let items = self.items else {
			return;
		};
		let i = self.count - 1;
		while i >= 0 do {
			self.destroy_element(&items[self.slot(i)]);
			i -= 1;
		}
		self.give_back(items);
	}
}

/// The iterator of the collections over `Indexed<T>` that lend their elements,
/// which lends each element in turn from position 0.
pub class IndexedWalk<T>
{
	watch: lang.Watch,
	items: ?*T,
	capacity: int,
	head: int,
	count: int,
	at: int = -1,

	/// A walk of the `count` elements that stand from the slot `head` of the
	/// `capacity` slots at `items`, which `watch` guards.
	pub fn over(items: ?*T, capacity: int, head: int, count: int,
		watch: lang.Watch) -> IndexedWalk<T>
	{
		return IndexedWalk<T> {
			watch: watch,
			items: items,
			capacity: capacity,
			head: head,
			count: count,
		};
	}

	operator fn next(self) -> bool
	{
		self.at += 1;
		return self.at < self.count;
	}

	operator fn value(self) -> lent *T
	{
		let items = self.items catch fatal;
		let s = self.head + self.at;
		if s >= self.capacity {
			s -= self.capacity;
		}
		return &items[s];
	}
}

/// Copies of elements of another collection, which `find_all` gives.
///
/// It is a collection of its own and owns its copies, which it tears down at
/// the end of its block. Its room comes from the allocator of the collection
/// that made it.
pub class Copies<T> inherits Indexed<T>
{
	/// An empty collection with room for `capacity` copies from `from`, or from
	/// the C library when it is `none`. The room comes in one allocation, and
	/// the program stops when the allocator has run out.
	pub fn new(capacity: int = 0, from: ?*mem.Allocator = none) -> Copies<T>
	{
		let made = Copies<T> { from: allocator(from) };
		if capacity > 0 {
			made.resize(capacity);
		}
		return made;
	}

	operator fn iter(self) -> IndexedWalk<T>
	{
		return self.walk();
	}

	/// Copies in `to` with room of their own for `count` elements from the same
	/// allocator, and a copy of each element in it, as `dup` makes one.
	concrete fn copy(self, to: *Object)
	{
		memcpy(to as ?*byte, self as ?*byte, size_of(Copies<T>) as c_size_t);
		self.copy_into(to as *Copies<T>, self.count);
	}

	/// Add `x` at the end, which the collection now owns.
	pub fn add(self, own x: T, at: lang.SourceLocation = here)
	{
		self.make_room(1);
		let items = self.items catch fatal;
		items[self.count] = x;
		self.resized(1, at);
	}
}

/// The length of the runs that `sort_stable` sorts by insertion before it
/// merges.
const RUN: int = 20;

/// Sort `s` in place by `less`, keeping the order of equal elements, without
/// room of its own: runs of `RUN` elements by insertion, then merges of runs
/// that double in length, each merged in place by rotations.
///
/// `sort_with` of a list and the order of the keys a hashed collection writes
/// sort through it.
///
/// PERF DECISION: a merge in place costs a factor of log n over a merge into a
/// second buffer. It allocates nothing, so a sort never fails and never takes
/// room from the allocator of the list.
internal fn sort_stable<T>(s: []T, less: fn(lent *T, lent *T) -> bool)
{
	let n = s.len;
	let a = 0;
	while a + RUN <= n do {
		insertion(s, a, a + RUN, less);
		a += RUN;
	}
	insertion(s, a, n, less);
	let run = RUN;
	while run < n do {
		a = 0;
		while a + 2 * run <= n do {
			merge(s, a, a + run, a + 2 * run, less);
			a += 2 * run;
		}
		if a + run < n {
			merge(s, a, a + run, n, less);
		}
		run *= 2;
	}
}

/// Sort the elements from `a` up to `b` of `s` by insertion.
fn insertion<T>(s: []T, a: int, b: int,
	less: fn(lent *T, lent *T) -> bool)
{
	let i = a + 1;
	while i < b do {
		let j = i;
		while j > a && less(&s[j], &s[j - 1]) do {
			swap(s, j, j - 1);
			j -= 1;
		}
		i += 1;
	}
}

/// Merge the sorted runs from `a` up to `m` and from `m` up to `b` of `s` in
/// place, the SymMerge of Kim and Kutzner, 2004.
fn merge<T>(s: []T, a: int, m: int, b: int,
	less: fn(lent *T, lent *T) -> bool)
{
	if m - a == 1 {
		let i = m;
		let j = b;
		while i < j do {
			let h = (i + j) / 2;
			if less(&s[h], &s[a]) {
				i = h + 1;
			} else {
				j = h;
			}
		}
		let k = a;
		while k < i - 1 do {
			swap(s, k, k + 1);
			k += 1;
		}
		return;
	}
	if b - m == 1 {
		let i = a;
		let j = m;
		while i < j do {
			let h = (i + j) / 2;
			if !less(&s[m], &s[h]) {
				i = h + 1;
			} else {
				j = h;
			}
		}
		let k = m;
		while k > i do {
			swap(s, k, k - 1);
			k -= 1;
		}
		return;
	}
	let mid = (a + b) / 2;
	let n = mid + m;
	let start = a;
	let r = m;
	if m > mid {
		start = n - b;
		r = mid;
	}
	let p = n - 1;
	while start < r do {
		let c = (start + r) / 2;
		if !less(&s[p - c], &s[c]) {
			start = c + 1;
		} else {
			r = c;
		}
	}
	let end = n - start;
	if start < m && m < end {
		rotate(s, start, m, end);
	}
	if a < start && start < mid {
		merge(s, a, start, mid, less);
	}
	if mid < end && end < b {
		merge(s, mid, end, b, less);
	}
}

/// Turn the elements from `a` up to `b` of `s` so that the one at `m` comes
/// first, by swaps of blocks.
fn rotate<T>(s: []T, a: int, m: int, b: int)
{
	let i = m - a;
	let j = b - m;
	while i != j do {
		if i > j {
			swap_run(s, m - i, m, j);
			i -= j;
		} else {
			swap_run(s, m - i, m + j - i, i);
			j -= i;
		}
	}
	swap_run(s, m - i, m, i);
}

/// Swap the `n` elements from `a` of `s` with the `n` elements from `b`.
fn swap_run<T>(s: []T, a: int, b: int, n: int)
{
	let i = 0;
	while i < n do {
		swap(s, a + i, b + i);
		i += 1;
	}
}

/// Swap the elements `i` and `j` of `s` as bytes, so neither is copied or torn
/// down.
internal fn swap<T>(s: []T, i: int, j: int)
{
	let x = &s[i] as *byte;
	let y = &s[j] as *byte;
	let k = 0;
	while k < size_of(T) do {
		let t = x[k];
		x[k] = y[k];
		y[k] = t;
		k += 1;
	}
}
