//! `Ring<T, N>`, a ring buffer of fixed capacity for real-time code.
//!
//! A ring takes room for `N` elements from its allocator when it is made and
//! never allocates again, so an audio callback may push and pop without a call
//! into an allocator. `push` gives `false` when the ring is full, and `pop` and
//! `peek` take and read the oldest element. It has every operation of
//! `anti.collection.Collection<T>`.

import anti.collection;
import anti.lang;
import anti.mem;

extern fn memcpy(to: ?*byte, from: ?*byte, count: c_size_t) -> ?*byte;
extern fn memset(to: ?*byte, value: c_int, count: c_size_t) -> ?*byte;

/// A queue of at most `N` elements of type `T` in room that the ring takes once.
///
/// Nothing the ring does after `new` allocates. `find_all` and `to_text` make
/// a new collection and a new text, which take room of their own.
pub class Ring<T, N: int> inherits collection.Collection<T>
{
	items: ?*T = none,
	head: int = 0,

	/// An empty ring with room for `N` elements from `from`, or from the C
	/// library when it is `none`. The room comes in one allocation, and the
	/// program stops when the allocator has run out.
	pub fn new(from: ?*mem.Allocator = none) -> Ring<T, N>
	{
		let made = Ring<T, N> { from: collection.allocator(from) };
		let room = made.room(N) catch fatal;
		made.items = room;
		return made;
	}

	/// Add `x` after the newest element and give `true`, or give `false` when
	/// the ring is full. The ring owns `x` once it holds it. A full ring tears
	/// `x` down.
	pub fn push(self, own x: T, at: lang.SourceLocation = here) -> bool
	{
		if self.count == N {
			return false;
		}
		let items = self.items catch fatal;
		items[self.slot(self.count)] = x;
		self.resized(1, at);
		return true;
	}

	/// Take the oldest element off, or `none` when the ring is empty.
	pub fn pop(self, at: lang.SourceLocation = here) -> ?T
	{
		if self.count == 0 {
			return none;
		}
		let (taken, after) = self.take_place(0);
		self.resized(-1, at);
		return taken;
	}

	/// A copy of the oldest element, or `none` when the ring is empty.
	pub fn peek(self) -> ?T
	{
		if self.count == 0 {
			return none;
		}
		return self.copy_place(0);
	}

	/// Whether the ring holds `N` elements, so that `push` gives `false`.
	pub fn is_full(self) -> bool
	{
		return self.count == N;
	}

	operator fn iter(self) -> RingWalk<T>
	{
		return RingWalk<T>.over(self.items, N, self.head, self.count,
			self.watch());
	}

	/// A ring in `to` with room of its own for `N` elements from the same
	/// allocator, and a copy of each element in it in order, as `dup` makes
	/// one.
	concrete fn copy(self, to: *Object)
	{
		/* DESIGN: `dup` gives a replaced `copy` memory that nothing has
		   written, and a collection gives it the bytes of the element. The
		   bytes of this ring go into `to` first in both cases, its table
		   among them, and the copy then takes room of its own. */
		memcpy(to as ?*byte, self as ?*byte, size_of(Ring<T, N>) as c_size_t);
		let made = to as *Ring<T, N>;
		let items = self.items catch fatal;
		let room = self.room(N) catch fatal;
		let i = 0;
		while i < self.count do {
			room[i] = self.copy_element(&items[self.slot(i)]);
			i += 1;
		}
		made.items = room;
		made.head = 0;
	}

	/// A place is the position of an element from the oldest, 0 for the
	/// oldest.
	concrete fn first_place(self) -> int
	{
		if self.count == 0 {
			return -1;
		}
		return 0;
	}

	concrete fn next_place(self, at: int) -> int
	{
		if at + 1 >= self.count {
			return -1;
		}
		return at + 1;
	}

	concrete fn lend_place(self, at: int, f: fn(lent *T))
	{
		let items = self.items catch fatal;
		f(&items[self.slot(at)]);
	}

	concrete fn copy_place(self, at: int) -> T
	{
		let items = self.items catch fatal;
		return self.copy_element(&items[self.slot(at)]);
	}

	/// The oldest element leaves by moving `head` on and the newest by leaving
	/// its slot. Any other element leaves a gap that the elements after it
	/// close, each moved one slot back as bytes.
	concrete fn take_place(self, at: int) -> (T, int)
	{
		let items = self.items catch fatal;
		let after = -1;
		if at + 1 < self.count {
			after = at;
		}
		let taken = (items[self.slot(at)], after);
		if at == 0 {
			memset(&items[self.head] as ?*byte, 0, size_of(T) as c_size_t);
			self.head = (self.head + 1) % N;
			return taken;
		}
		let i = at;
		while i + 1 < self.count do {
			memcpy(&items[self.slot(i)] as ?*byte,
				&items[self.slot(i + 1)] as ?*byte, size_of(T) as c_size_t);
			i += 1;
		}
		memset(&items[self.slot(self.count - 1)] as ?*byte, 0,
			size_of(T) as c_size_t);
		return taken;
	}

	/// The slot of the room that holds the element at position `i` from the
	/// oldest.
	fn slot(self, i: int) -> int
	{
		return (self.head + i) % N;
	}

	fn destruct(self)
	{
		let items = self.items else {
			return;
		};
		let i = self.count - 1;
		while i >= 0 do {
			self.destroy_element(&items[self.slot(i)]);
			i -= 1;
		}
		self.give_back(items);
	}
}

/// The iterator of `Ring<T, N>`, which lends each element in turn, from the
/// oldest.
pub class RingWalk<T>
{
	watch: lang.Watch,
	items: ?*T,
	capacity: int,
	head: int,
	count: int,
	at: int = -1,

	/// A walk of the `count` elements that stand from the slot `head` of the
	/// `capacity` slots at `items`, which `watch` guards.
	pub fn over(items: ?*T, capacity: int, head: int, count: int,
		watch: lang.Watch) -> RingWalk<T>
	{
		return RingWalk<T> {
			watch: watch,
			items: items,
			capacity: capacity,
			head: head,
			count: count,
		};
	}

	operator fn next(self) -> bool
	{
		self.at += 1;
		return self.at < self.count;
	}

	operator fn value(self) -> lent *T
	{
		let items = self.items catch fatal;
		return &items[(self.head + self.at) % self.capacity];
	}
}

/// Whether `a` and `b` hold equal elements in the same order from the oldest.
pub operator fn eq<T: eq, N: int>(a: Ring<T, N>, b: Ring<T, N>) -> bool
{
	return collection.equal<T>(&a, &b);
}
