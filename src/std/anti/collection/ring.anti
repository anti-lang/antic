//! `Ring<T, N>`, a ring buffer of fixed capacity for real-time code.
//!
//! A ring takes room for `N` elements from its allocator when it is made and
//! never allocates again, so an audio callback may push and pop without a call
//! into an allocator. `push` gives `false` when the ring is full, and `pop` and
//! `peek` take and read the oldest element. It has every operation of
//! `anti.collection.Collection<T>`, and `anti.collection.Indexed<T>` holds its
//! ring.

import anti.collection;
import anti.lang;
import anti.mem;

extern fn memcpy(to: ?*byte, from: ?*byte, count: c_size_t) -> ?*byte;

/// A queue of at most `N` elements of type `T` in room that the ring takes
/// once.
///
/// Nothing the ring does after `new` allocates. `find_all` and `to_text` make a
/// new collection and a new text, which take room of their own.
pub class Ring<T, N: int> inherits collection.Indexed<T>
{
	/// An empty ring with room for `N` elements from `from`, or from the C
	/// library when it is `none`. The room comes in one allocation, and the
	/// program stops when the allocator has run out.
	pub fn new(from: ?*mem.Allocator = none) -> Ring<T, N>
	{
		let made = Ring<T, N> { from: collection.allocator(from), ring: true };
		made.resize(N);
		return made;
	}

	/// Add `x` after the newest element and give `true`, or give `false` when
	/// the ring is full. The ring owns `x` once it holds it. A full ring tears
	/// `x` down.
	pub fn push(self, own x: T, at: lang.SourceLocation = here) -> bool
	{
		if self.count == N {
			return false;
		}
		let items = self.items catch fatal;
		items[self.slot(self.count)] = x;
		self.resized(1, at);
		return true;
	}

	/// Take the oldest element off, or `none` when the ring is empty.
	pub fn pop(self, at: lang.SourceLocation = here) -> ?T
	{
		if self.count == 0 {
			return none;
		}
		let (taken, after) = self.take_place(0);
		self.resized(-1, at);
		return taken;
	}

	/// A copy of the oldest element, or `none` when the ring is empty.
	pub fn peek(self) -> ?T
	{
		if self.count == 0 {
			return none;
		}
		return self.copy_place(0);
	}

	/// Whether the ring holds `N` elements, so that `push` gives `false`.
	pub fn is_full(self) -> bool
	{
		return self.count == N;
	}

	operator fn iter(self) -> collection.IndexedWalk<T>
	{
		return self.walk();
	}

	/// A ring in `to` with room of its own for `N` elements from the same
	/// allocator, and a copy of each element in it in order, as `dup` makes
	/// one.
	concrete fn copy(self, to: *Object)
	{
		memcpy(to as ?*byte, self as ?*byte, size_of(Ring<T, N>) as c_size_t);
		self.copy_into(to as *Ring<T, N>, N);
	}
}

/// Whether `a` and `b` hold equal elements in the same order from the oldest.
pub operator fn eq<T: eq, N: int>(a: Ring<T, N>, b: Ring<T, N>) -> bool
{
	return collection.equal<T>(&a, &b);
}

/// The hash of the elements from the oldest, which equal rings share.
pub operator fn hash<T: hash, N: int>(a: Ring<T, N>) -> u64
{
	return collection.hash_in_order<T>(&a);
}
