//! `Grid<T>`, a two-dimensional array.
//!
//! A grid holds `width` times `height` elements by value in one block of room
//! from the allocator it was made with, row by row. `g[x, y]` reads and writes
//! the element in column `x` of row `y`, and a dev build traps outside the grid
//! as it does for an array. It has every operation of
//! `anti.collection.Collection<T>` over `anti.collection.Indexed<T>`. A grid
//! never changes its size, so a remove form and `clear` put a copy of the value
//! the grid was filled with into each cell they empty.

import anti.collection;
import anti.lang;
import anti.mem;

extern fn memcpy(to: ?*byte, from: ?*byte, count: c_size_t) -> ?*byte;
extern fn memset(to: ?*byte, value: c_int, count: c_size_t) -> ?*byte;

/// A rectangle of `width` columns and `height` rows of elements of type `T`,
/// stored row by row.
///
/// `g[x, y]` gives a copy of an element and `g[x, y] = v` replaces it. `get`
/// gives `none` outside the grid instead.
pub class Grid<T> inherits collection.Indexed<T>
{
	/// The number of columns.
	pub width: int = 0,
	/// The number of rows.
	pub height: int = 0,

	/// A grid of `width` columns and `height` rows, each cell a copy of `fill`,
	/// with room from `from`, or from the C library when it is `none`. A width
	/// or a height below 0 counts as 0. The room comes in one allocation, and
	/// the program stops when the allocator has run out.
	pub fn new(width: int, height: int, fill: T,
		from: ?*mem.Allocator = none) -> Grid<T>
	{
		/* DESIGN: the room holds one spare slot past the cells, which keeps
		   the copy of `fill` that a cell takes when it is emptied. */
		let made = Grid<T> { from: collection.allocator(from), spare: 1 };
		if width > 0 {
			made.width = width;
		}
		if height > 0 {
			made.height = height;
		}
		let cells = made.width * made.height;
		made.resize(cells);
		let room = made.items catch fatal;
		let i = 0;
		while i <= cells do {
			room[i] = made.copy_element(&fill);
			i += 1;
		}
		made.count = cells;
		return made;
	}

	/// A copy of the element in column `x` of row `y`.
	operator fn index(self, x: int, y: int) -> T
	{
		return self.copy_element(self.cell(x, y));
	}

	/// Replace the element in column `x` of row `y` with `v`, which the grid
	/// now owns. The element it replaces is torn down.
	operator fn set_index(self, x: int, y: int, own v: T)
	{
		let p = self.cell(x, y);
		self.destroy_element(p);
		memset(p as ?*byte, 0, size_of(T) as c_size_t);
		let items = self.items catch fatal;
		items[y * self.width + x] = v;
	}

	/// A copy of the element in column `x` of row `y`, or `none` outside the
	/// grid.
	pub fn get(self, x: int, y: int) -> ?T
	{
		if x < 0 || x >= self.width || y < 0 || y >= self.height {
			return none;
		}
		return self.copy_place(y * self.width + x);
	}

	/// Lend the whole buffer to `f` as one slice of `width` times `height`
	/// elements, row by row, for C and simd. The slice is valid only for the
	/// call.
	pub fn lend_slice(self, f: fn(lent []T))
	{
		f([]T { ptr: self.items, len: self.count });
	}

	operator fn iter(self) -> collection.IndexedWalk<T>
	{
		return self.walk();
	}

	/// Put a copy of the fill value into every cell that `test` accepts and
	/// give their number. The elements it takes out are torn down.
	concrete fn remove_all(self, test: fn(T) -> bool,
		at: lang.SourceLocation = here) -> int
	{
		let n = 0;
		let place = 0;
		while place < self.count do {
			if self.accepts(place, test) {
				let (gone, after) = self.take_place(place);
				n += 1;
			}
			place += 1;
		}
		return n;
	}

	/// Take the first element that `test` accepts out of its cell, which takes
	/// a copy of the fill value, and give it, or `none`.
	concrete fn remove_first(self, test: fn(T) -> bool,
		at: lang.SourceLocation = here) -> ?T
	{
		let place = self.first_match(test);
		if place < 0 {
			return none;
		}
		let (taken, after) = self.take_place(place);
		return taken;
	}

	/// Take the one element that `test` accepts out of its cell, which takes a
	/// copy of the fill value, and give it.
	///
	/// It fails with `NotOne` and takes nothing when no element or more than
	/// one matches.
	concrete fn remove_one(self, test: fn(T) -> bool,
		at: lang.SourceLocation = here) -> T may fail
	{
		let place = try self.one_match("remove_one", test);
		let (taken, after) = self.take_place(place);
		return taken;
	}

	/// Put a copy of the fill value into every cell.
	concrete fn clear(self, at: lang.SourceLocation = here)
	{
		let place = 0;
		while place < self.count do {
			let (gone, after) = self.take_place(place);
			place += 1;
		}
	}

	/// A grid in `to` with room of its own from the same allocator, and a copy
	/// of each element and of the fill value in it, as `dup` makes one.
	concrete fn copy(self, to: *Object)
	{
		memcpy(to as ?*byte, self as ?*byte, size_of(Grid<T>) as c_size_t);
		let made = to as *Grid<T>;
		self.copy_into(made, self.count);
		let items = self.items catch fatal;
		let room = made.items catch fatal;
		room[self.count] = self.copy_element(&items[self.count]);
	}

	/// A place is the index of a cell in the buffer, row by row. The element
	/// leaves its cell, which takes a copy of the fill value.
	concrete fn take_place(self, at: int) -> (T, int)
	{
		let items = self.items catch fatal;
		let taken = (items[at], self.next_place(at));
		memset(&items[at] as ?*byte, 0, size_of(T) as c_size_t);
		items[at] = self.copy_element(&items[self.count]);
		return taken;
	}

	/// The element in column `x` of row `y`, which must be inside the grid. A
	/// dev build traps outside it, as it does for an array: at `x` against the
	/// width, then at `y` against the height.
	fn cell(self, x: int, y: int) -> *T
	{
		/* DESIGN: `row` and `rows` are indexed for the check of each
		   dimension alone, which follows the build that compiles the program,
		   and a release build checks nothing. */
		let row = []T { ptr: self.items, len: self.width };
		let rows = []T { ptr: self.items, len: self.height };
		let cells = []T { ptr: self.items, len: self.count };
		let across = &row[x];
		let down = &rows[y];
		return &cells[y * self.width + x];
	}

	/// Tear down the copy of the fill value. The destruct of
	/// `collection.Indexed<T>` runs after it and tears down the cells.
	fn destruct(self)
	{
		let items = self.items else {
			return;
		};
		self.destroy_element(&items[self.count]);
	}
}

/// Whether `a` and `b` have the same width and height and hold equal elements
/// in the same order.
pub operator fn eq<T: eq>(a: Grid<T>, b: Grid<T>) -> bool
{
	if a.width != b.width || a.height != b.height {
		return false;
	}
	return collection.equal<T>(&a, &b);
}

/// The hash of the width, the height and the cells row by row, which equal
/// grids share.
pub operator fn hash<T: hash>(a: Grid<T>) -> u64
{
	return (a.width, a.height, collection.hash_in_order<T>(&a)).hash();
}
