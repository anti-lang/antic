//! `Deque<T>`, a ring buffer that grows.
//!
//! A deque holds its elements by value in one block of room from the allocator
//! it was made with. They stand in a ring that starts at `head` and wraps at
//! the end of the room, so both ends take and give an element without moving
//! the others. It grows by doubling, or by `reserve` in one allocation, and
//! `shrink` gives back the room past the last element. It has every operation
//! of `anti.collection.Collection<T>`, and `anti.collection.Indexed<T>` holds
//! its ring.

import anti.collection;
import anti.lang;
import anti.mem;

extern fn memcpy(to: ?*byte, from: ?*byte, count: c_size_t) -> ?*byte;

/// A sequence of elements of type `T` that grows and shrinks at both ends.
///
/// `push_front` and `push_back` add an element, `pop_front` and `pop_back` take
/// one off, and `front` and `back` give a copy. The last four give `none` when
/// the deque is empty.
pub class Deque<T> inherits collection.Indexed<T>
{
	/// An empty deque with room for `capacity` elements from `from`, or from
	/// the C library when it is `none`. The room comes in one allocation.
	pub fn new(capacity: int = 0, from: ?*mem.Allocator = none) -> Deque<T>
	{
		let made = Deque<T> { from: collection.allocator(from), ring: true };
		if capacity > 0 {
			made.resize(capacity);
		}
		return made;
	}

	/// Add `x` before the first element, which the deque now owns.
	pub fn push_front(self, own x: T, at: lang.SourceLocation = here)
	{
		self.make_room(1);
		let items = self.items catch fatal;
		self.head = (self.head + self.capacity - 1) % self.capacity;
		items[self.head] = x;
		self.resized(1, at);
	}

	/// Add `x` after the last element, which the deque now owns.
	pub fn push_back(self, own x: T, at: lang.SourceLocation = here)
	{
		self.make_room(1);
		let items = self.items catch fatal;
		items[self.slot(self.count)] = x;
		self.resized(1, at);
	}

	/// Take the first element off, or `none` when the deque is empty.
	pub fn pop_front(self, at: lang.SourceLocation = here) -> ?T
	{
		if self.count == 0 {
			return none;
		}
		let (taken, after) = self.take_place(0);
		self.resized(-1, at);
		return taken;
	}

	/// Take the last element off, or `none` when the deque is empty.
	pub fn pop_back(self, at: lang.SourceLocation = here) -> ?T
	{
		if self.count == 0 {
			return none;
		}
		let (taken, after) = self.take_place(self.count - 1);
		self.resized(-1, at);
		return taken;
	}

	/// A copy of the first element, or `none` when the deque is empty.
	pub fn front(self) -> ?T
	{
		if self.count == 0 {
			return none;
		}
		return self.copy_place(0);
	}

	/// A copy of the last element, or `none` when the deque is empty.
	pub fn back(self) -> ?T
	{
		if self.count == 0 {
			return none;
		}
		return self.copy_place(self.count - 1);
	}

	/// Room for `n` more elements, in one allocation.
	pub fn reserve(self, n: int)
	{
		if self.count + n > self.capacity {
			self.resize(self.count + n);
		}
	}

	/// Give back the room past the last element.
	pub fn shrink(self)
	{
		if self.capacity > self.count {
			self.resize(self.count);
		}
	}

	operator fn iter(self) -> collection.IndexedWalk<T>
	{
		return self.walk();
	}

	/// A deque in `to` with room of its own for `count` elements from the same
	/// allocator, and a copy of each element in it in order, as `dup` makes
	/// one.
	concrete fn copy(self, to: *Object)
	{
		memcpy(to as ?*byte, self as ?*byte, size_of(Deque<T>) as c_size_t);
		self.copy_into(to as *Deque<T>, self.count);
	}
}

/// Whether `a` and `b` hold equal elements in the same order from the front.
pub operator fn eq<T: eq>(a: Deque<T>, b: Deque<T>) -> bool
{
	return collection.equal<T>(&a, &b);
}

/// The hash of the elements from the front, which equal deques share.
pub operator fn hash<T: hash>(a: Deque<T>) -> u64
{
	return collection.hash_in_order<T>(&a);
}
