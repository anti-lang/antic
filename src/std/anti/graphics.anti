//! Drawing in a window over raylib, in units of a square that every window
//! shows whole.
//!
//! `graphics.open(title)` opens the window, and `for f in w.frames()` draws one
//! frame per turn on the canvas `f`. Every position and size is in units of the
//! largest square that fits the window, from 0.0 to 1.0 on both axes, with y
//! pointing down from its top left corner. A rotation is in degrees and turns
//! clockwise. A program names no pixel size, colour depth or pixel format. The
//! one size it may name is that of its window when it opens, in screen points,
//! and the window gives the sizes of the monitor and of itself in points.
//!
//! Each part stands on raylib under the name of its function without the
//! prefix: the window on `InitWindow`, the loop on `BeginDrawing` and
//! `EndDrawing`, the square on `Camera2D`, the transforms of a canvas on the
//! matrix of rlgl, and the colours, shapes, text and input on the functions of
//! the same name. No raylib type stands in a public signature.
//!
//! `Display` is the abstract class behind the window and the canvas, and
//! `RaylibDisplay` its default provider. `Recorder` opens no window and records
//! every call, so a test runs drawing code without a display, with
//! `"anti.graphics.Display" = "anti.graphics.Recorder.shared"` in
//! `[inject.test]`.
//!
//! A frame allocates nothing after the window opens: `frames`, `Canvas`, `say`
//! and every shape. `open` is called from the main thread, which macOS
//! requires, and fails on any other.

import anti.lang;
import anti.math;
import anti.raylib as rl;
import anti.text;

extern fn anti_rt_main_thread() -> c_int;
extern fn anti_rt_out_of_memory(size: int) -> never;

/// A point or a size in units of the square.
pub struct Vec2
{
	x: f32,
	y: f32,
}

/// The point `x`, `y`.
pub fn xy(x: f32, y: f32) -> Vec2
{
	return Vec2 { x: x, y: y };
}

/// A rectangle in units of the square, from its top left corner.
pub struct Rect
{
	x: f32,
	y: f32,
	width: f32,
	height: f32,
}

/// A colour of raylib: red, green, blue and alpha in sRGB, one byte each.
pub struct Color
{
	r: u8,
	g: u8,
	b: u8,
	a: u8,
}

// The named colours of raylib, whose values the test std_graphics_colors
// compares with those of anti.raylib.
/// `LIGHTGRAY` of raylib.
pub const LIGHTGRAY: Color = Color { r: 200, g: 200, b: 200, a: 255 };
/// `GRAY` of raylib.
pub const GRAY: Color = Color { r: 130, g: 130, b: 130, a: 255 };
/// `DARKGRAY` of raylib.
pub const DARKGRAY: Color = Color { r: 80, g: 80, b: 80, a: 255 };
/// `YELLOW` of raylib.
pub const YELLOW: Color = Color { r: 253, g: 249, b: 0, a: 255 };
/// `GOLD` of raylib.
pub const GOLD: Color = Color { r: 255, g: 203, b: 0, a: 255 };
/// `ORANGE` of raylib.
pub const ORANGE: Color = Color { r: 255, g: 161, b: 0, a: 255 };
/// `PINK` of raylib.
pub const PINK: Color = Color { r: 255, g: 109, b: 194, a: 255 };
/// `RED` of raylib.
pub const RED: Color = Color { r: 230, g: 41, b: 55, a: 255 };
/// `MAROON` of raylib.
pub const MAROON: Color = Color { r: 190, g: 33, b: 55, a: 255 };
/// `GREEN` of raylib.
pub const GREEN: Color = Color { r: 0, g: 228, b: 48, a: 255 };
/// `LIME` of raylib.
pub const LIME: Color = Color { r: 0, g: 158, b: 47, a: 255 };
/// `DARKGREEN` of raylib.
pub const DARKGREEN: Color = Color { r: 0, g: 117, b: 44, a: 255 };
/// `SKYBLUE` of raylib.
pub const SKYBLUE: Color = Color { r: 102, g: 191, b: 255, a: 255 };
/// `BLUE` of raylib.
pub const BLUE: Color = Color { r: 0, g: 121, b: 241, a: 255 };
/// `DARKBLUE` of raylib.
pub const DARKBLUE: Color = Color { r: 0, g: 82, b: 172, a: 255 };
/// `PURPLE` of raylib.
pub const PURPLE: Color = Color { r: 200, g: 122, b: 255, a: 255 };
/// `VIOLET` of raylib.
pub const VIOLET: Color = Color { r: 135, g: 60, b: 190, a: 255 };
/// `DARKPURPLE` of raylib.
pub const DARKPURPLE: Color = Color { r: 112, g: 31, b: 126, a: 255 };
/// `BEIGE` of raylib.
pub const BEIGE: Color = Color { r: 211, g: 176, b: 131, a: 255 };
/// `BROWN` of raylib.
pub const BROWN: Color = Color { r: 127, g: 106, b: 79, a: 255 };
/// `DARKBROWN` of raylib.
pub const DARKBROWN: Color = Color { r: 76, g: 63, b: 47, a: 255 };
/// `WHITE` of raylib.
pub const WHITE: Color = Color { r: 255, g: 255, b: 255, a: 255 };
/// `BLACK` of raylib.
pub const BLACK: Color = Color { r: 0, g: 0, b: 0, a: 255 };
/// `BLANK` of raylib.
pub const BLANK: Color = Color { r: 0, g: 0, b: 0, a: 0 };
/// `MAGENTA` of raylib.
pub const MAGENTA: Color = Color { r: 255, g: 0, b: 255, a: 255 };
/// `RAYWHITE` of raylib.
pub const RAYWHITE: Color = Color { r: 245, g: 245, b: 245, a: 255 };

/// The colour of `value`, written 0xRRGGBBAA, as `GetColor`.
pub fn hex(value: u32) -> Color
{
	return cooked(rl.GetColor(value as c_uint));
}

/// The colour of hue `h` in degrees, saturation `s` and value `v`, both from
/// 0.0 to 1.0, as `ColorFromHSV`.
pub fn hsv(h: f32, s: f32, v: f32) -> Color
{
	return cooked(rl.ColorFromHSV(h, s, v));
}

/// `c` with the alpha `alpha`, from 0.0 to 1.0, as `Fade`.
pub fn fade(c: Color, alpha: f32) -> Color
{
	return cooked(rl.Fade(raw(c), alpha));
}

/// The colour `t` of the way from `c` to `to`, as `ColorLerp`.
pub fn lerp(c: Color, to: Color, t: f32) -> Color
{
	return cooked(rl.ColorLerp(raw(c), raw(to), t));
}

/// `c` lighter for a `k` above 0.0 and darker below it, from -1.0 to 1.0, as
/// `ColorBrightness`.
pub fn brightness(c: Color, k: f32) -> Color
{
	return cooked(rl.ColorBrightness(raw(c), k));
}

fn raw(c: Color) -> rl.Color
{
	return rl.Color {
		r: c.r as c_uchar, g: c.g as c_uchar, b: c.b as c_uchar,
		a: c.a as c_uchar
	};
}

fn cooked(c: rl.Color) -> Color
{
	return Color { r: c.r as u8, g: c.g as u8, b: c.b as u8, a: c.a as u8 };
}

fn vector(p: Vec2) -> rl.Vector2
{
	return rl.Vector2 { x: p.x, y: p.y };
}

fn rectangle(r: Rect) -> rl.Rectangle
{
	return rl.Rectangle { x: r.x, y: r.y, width: r.width, height: r.height };
}

