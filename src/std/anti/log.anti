//! Logging through a level, a sink and a format.
//!
//! A program writes with `log.info("...")` and the like, which reach the logger
//! of the `Log` singleton. `log.set` replaces that logger. Each line is one
//! `write` call of the sink, so two threads never interleave one line with
//! another.
//!
//! `Logger` is the standard interface, and `SinkLogger` is its default, the
//! logger that writes through a `Sink`. A class that takes a `*Logger` runs
//! under a fake logger in a test.
//!
//! The `logger` key of the runtime configuration names a file of the TOML
//! subset that the first call reads. `--anti.logger=<path>` and the `[runtime]`
//! table of the configuration file set that key. The file holds `level`,
//! `name`, `format` and `[[sink]]` entries with `kind`, `path` and `level`. A
//! line below `level` is dropped, and every other line goes to the sink of each
//! entry whose own `level` takes it. An entry without a `level` takes every
//! line. An entry whose kind nothing registered, or whose file will not open,
//! writes one line to standard error and is left out, and a file without an
//! entry that made a sink writes to standard error. A file that is missing or
//! outside the subset writes one line to standard error, and the program goes
//! on with the default, which is standard error at level `info` in text. A
//! `log.set` in the program takes precedence over the file.

import anti.fs;
import anti.lang;
import anti.io;
import anti.json;
import anti.mem;
import anti.runtime;
import anti.text;
import anti.time;
import anti.toml;

extern fn anti_rt_out_of_memory(size: int) -> never;

/// How much a logger writes, from everything to nothing but a failure.
pub enum Level: u8 { Trace, Debug, Info, Warn, Error, Fatal, Off }

/// The shape of a line.
pub enum Format: u8 { Text, Json }

/// Where the lines of a logger go.
///
/// A sink writes one whole line per call, with the newline at its end.
pub abstract class Sink
{
	abstract fn write(self, line: str);
}

/// A sink that writes to standard error.
pub class StderrSink inherits Sink
{
	/// A sink on standard error.
	pub fn new() -> *StderrSink
	{
		return alloc StderrSink { };
	}

	concrete fn write(self, line: str)
	{
		io.eprint(line);
	}
}

/// A sink that appends to a file.
pub class FileSink inherits Sink
{
	/* DESIGN: the sink shares its file with every copy `dup` makes of it,
	   and the last of them closes it. By S318 of the third audit: a copy
	   held the address of a file its original closed, and wrote to it and
	   closed it again. */
	file: mem.Shared<OpenFile>,

	/// A sink that appends to the file at `path`, which may fail.
	///
	/// A file that will not open fails with the `SystemError` of the number the
	/// system gave.
	pub fn new(path: str) -> *FileSink may fail
	{
		/* Binary, as every mode of anti.fs is, so a line ends with LF on
		   Windows as well. */
		let file = try fs.open(path, fs.Mode.Append);
		return alloc FileSink {
			file: mem.Shared<OpenFile>.new(OpenFile { file: file }),
		};
	}

	concrete fn write(self, line: str)
	{
		self.file.read(fn(open) {
			/* A sink has no way to report, so a line the system will not
			   store is lost, as one written to a closed standard error is. */
			fs.write(open.file, []byte { ptr: line.ptr, len: line.len }) catch ignored {
				return;
			};
			fs.flush(open.file) catch ignored { };
		});
	}
}

/// The file of a `FileSink` and of its copies, which the last of them closes.
class OpenFile
{
	pub file: *fs.File,

	fn destruct(self)
	{
		fs.close(self.file) catch ignored { };
	}
}

/// A sink that hands each line to a function.
pub class CallbackSink inherits Sink
{
	to: fn(str),

	/// A sink that calls `to` with every line.
	pub fn new(keep to: fn(str)) -> *CallbackSink
	{
		return alloc CallbackSink { to: to };
	}

	concrete fn write(self, line: str)
	{
		self.to(line);
	}
}

/// Where a program writes its lines, which a class takes so that a test can
/// collect them.
///
/// A name, a level and a format stand here, because every logger carries them
/// and `log.logger().level` reads and writes one. Every thread that writes a
/// line reads the three with no lock, so a program writes them before it starts
/// the threads that log. A change while those threads run is a new logger given
/// to `log.set`, and the old one is deleted once they stopped. `SinkLogger` is
/// the default, which writes through a `Sink`.
pub abstract class Logger
{
	/// The name that every line of this logger carries.
	pub name: str = "",
	/// Lines below this level are dropped.
	pub level: Level = Level.Info,
	/// The shape of a line.
	pub format: Format = Format.Text,

	/// Write `message` at `level`, unless the logger drops that level.
	abstract fn log(self, level: Level, message: str);

	/// The provider the link takes where the build names none, which is the
	/// logger of the program.
	///
	/// A `log.set` after the field was filled does not reach it, since the
	/// provider runs once, before `construct`.
	pub fn default() -> *Logger
	{
		return logger();
	}

	/// Write `message` at the lowest level.
	pub fn trace(self, message: str)
	{
		self.log(Level.Trace, message);
	}

	/// Write `message` at the level of a detail for a developer.
	pub fn debug(self, message: str)
	{
		self.log(Level.Debug, message);
	}

	/// Write `message` at the level of ordinary progress.
	pub fn info(self, message: str)
	{
		self.log(Level.Info, message);
	}

	/// Write `message` at the level of something to look at.
	pub fn warn(self, message: str)
	{
		self.log(Level.Warn, message);
	}

	/// Write `message` at the level of a failure the program survived.
	pub fn error(self, message: str)
	{
		self.log(Level.Error, message);
	}

	/// Write `message` at the level of a failure that ends the program.
	pub fn fatal(self, message: str)
	{
		self.log(Level.Fatal, message);
	}
}

/// A logger that writes each line to a sink it owns, which is the default of
/// `Logger`.
pub class SinkLogger inherits Logger
{
	own sink: *Sink,
	/// The copy of the name that `new` was given, which `name` holds.
	own held: ?*byte = none,

	/// A logger with a name, a level and a sink it owns.
	///
	/// The logger keeps a copy of `name`, so the text may end before it does.
	pub fn new(name: str, level: Level, sink: *Sink) -> *SinkLogger
	{
		let made = alloc SinkLogger { sink: sink };
		let kept = copy_of(name);
		made.held = kept.ptr;
		made.name = kept;
		made.level = level;
		return made;
	}

	concrete fn log(self, level: Level, message: str)
	{
		if (level as int) < (self.level as int) || self.sink == none {
			return;
		}
		let line = text.Builder.new();
		line_of(self, level, message, &line);
		self.sink.write(line.text());
	}
}

/// A copy of `name` in memory of its own, which the caller frees.
fn copy_of(name: str) -> str
{
	let copy = text.Builder.new();
	copy.append(name);
	return copy.take();
}

/// Write the line of `message` at `level` into `line`, in the format of
/// `logger` and with its name.
fn line_of(logger: *Logger, level: Level, message: str, line: *text.Builder)
{
	if logger.format == Format.Json {
		line.append("{\"time\":");
		json.write_int(time.wall(), line);
		line.append(",\"level\":");
		json.write_text(level_name(level), line);
		line.append(",\"name\":");
		json.write_text(logger.name, line);
		line.append(",\"message\":");
		json.write_text(message, line);
		line.append("}\n");
		return;
	}
	line.append_int(time.wall());
	line.append(" ");
	line.append(level_name(level));
	line.append(" ");
	if logger.name.len != 0 {
		line.append(logger.name);
		line.append(" ");
	}
	line.append(message);
	line.append("\n");
}

/// The sink of one `[[sink]]` entry of the logger file, and the least level it
/// takes.
struct Leg
{
	sink: *Sink,
	level: Level,
}

/// The logger that a logger file asks for, which writes each line to the sink
/// of every entry whose level takes it.
///
/// DESIGN: by S332 of the third audit. The logger of the file wrote to the sink
/// of the first entry alone, read no `level` of an entry and stopped at the
/// eighth, where the header of the module promised every entry with a level
/// each, as the entry on `anti.log` in `docs/decisions.md` does.
class FileLogger inherits Logger
{
	/// The entries in the order of the file, each with a sink it owns.
	pub own legs: []Leg,
	pub count: int = 0,
	/// The copy of the name of the file, which `name` holds.
	pub own held: ?*byte = none,

	fn destruct(self)
	{
		for i in 0..self.count {
			delete(self.legs[i].sink);
		}
	}

	concrete fn log(self, level: Level, message: str)
	{
		if (level as int) < (self.level as int) {
			return;
		}
		let line = text.Builder.new();
		line_of(self, level, message, &line);
		for i in 0..self.count {
			if (level as int) >= (self.legs[i].level as int) {
				self.legs[i].sink.write(line.text());
			}
		}
	}
}

/// The logger of the program.
///
/// The first call to `get` builds it, from the file the `logger` key names and
/// from the default otherwise.
pub singleton class Log
{
	atomic logger: ?*Logger = none,

	fn construct(self)
	{
		self.logger.store(from_configuration());
	}

	/// The logger every function of the module writes through.
	pub fn current(self) -> *Logger
	{
		/* `construct` stores one before any caller reaches this, so the
		   `else` stands for a logger that `set` replaced with `none`. */
		let held = self.logger.load() else {
			let made = SinkLogger.new("", Level.Info, StderrSink.new());
			self.logger.store(made);
			return made;
		};
		return held;
	}
}

/// The logger the module writes through.
pub fn logger() -> *Logger
{
	return Log.get().current();
}

/// Replace the logger of the program, and give back the one before it.
///
/// The caller owns the logger it gets back and deletes it when nothing else
/// holds it.
pub fn set(next: *Logger) -> ?*Logger
{
	return Log.get().logger.swap(next);
}

/// Write `message` at the lowest level.
pub fn trace(message: str)
{
	logger().log(Level.Trace, message);
}

/// Write `message` at the level of a detail for a developer.
pub fn debug(message: str)
{
	logger().log(Level.Debug, message);
}

/// Write `message` at the level of ordinary progress.
pub fn info(message: str)
{
	logger().log(Level.Info, message);
}

/// Write `message` at the level of something to look at.
pub fn warn(message: str)
{
	logger().log(Level.Warn, message);
}

/// Write `message` at the level of a failure the program survived.
pub fn error(message: str)
{
	logger().log(Level.Error, message);
}

/// Write `message` at the level of a failure that ends the program.
pub fn fatal(message: str)
{
	logger().log(Level.Fatal, message);
}

/// The name of `level` as the file and the lines spell it.
pub fn level_name(level: Level) -> str
{
	if level == Level.Trace {
		return "trace";
	}
	if level == Level.Debug {
		return "debug";
	}
	if level == Level.Info {
		return "info";
	}
	if level == Level.Warn {
		return "warn";
	}
	if level == Level.Error {
		return "error";
	}
	if level == Level.Fatal {
		return "fatal";
	}
	return "off";
}

/// The level `name` spells, or `fallback` for any other text.
pub fn level_of(name: str, fallback: Level) -> Level
{
	if text.equal(name, "trace") {
		return Level.Trace;
	}
	if text.equal(name, "debug") {
		return Level.Debug;
	}
	if text.equal(name, "info") {
		return Level.Info;
	}
	if text.equal(name, "warn") {
		return Level.Warn;
	}
	if text.equal(name, "error") {
		return Level.Error;
	}
	if text.equal(name, "fatal") {
		return Level.Fatal;
	}
	if text.equal(name, "off") {
		return Level.Off;
	}
	return fallback;
}

/// One kind of sink a configuration file may name.
class Kind
{
	pub name: str = "",
	pub make: fn(str) -> *Sink,
	pub next: ?*Kind,
}

/// The kinds of sink that `register` added, newest first.
///
/// DESIGN: the kinds stand outside `Log`, whose `construct` reads the file that
/// names them. By S313 of the third audit: `construct` of `Log` looked a kind
/// up through `Log.get()`, which found no instance yet, built a second `Log`
/// and read the file again, until the stack ran out. `register` built the `Log`
/// as well, so the file never saw the kind it added.
singleton class Kinds
{
	atomic first: ?*Kind = none,
}

/// Add a kind of sink that a configuration file may name.
///
/// `make` takes the `path` of the entry and gives the sink. A file that names a
/// kind nothing registered writes one line to standard error and the entry is
/// left out. The kinds `stderr` and `file` are always there. The first line the
/// program writes reads the file, so a kind added after it reaches no file.
pub fn register(name: str, keep make: fn(str) -> *Sink)
{
	let one = alloc Kind { name: name, make: make, next: none };
	while true do {
		one.next = Kinds.get().first.load();
		if Kinds.get().first.compare_swap(one.next, one) {
			return;
		}
	}
}

/// The sink of the kind `name`, or `none` after one line to standard error.
fn made(name: str, path: str) -> ?*Sink
{
	if text.equal(name, "stderr") {
		return StderrSink.new();
	}
	if text.equal(name, "file") {
		let sink = FileSink.new(path) catch e {
			io.eprint("anti.log: ");
			io.eprint(e.message);
			io.eprint("\n");
			return none;
		};
		return sink;
	}
	let one = Kinds.get().first.load();
	while one != none do {
		if text.equal(one.name, name) {
			return one.make(path);
		}
		one = one.next;
	}
	io.eprint("anti.log: no sink of kind ");
	io.eprint(name);
	io.eprint("\n");
	return none;
}

/// The logger the `logger` key of the runtime configuration asks for, or the
/// default one.
fn from_configuration() -> *Logger
{
	let path = runtime.get("logger") else {
		return SinkLogger.new("", Level.Info, StderrSink.new());
	};
	let source = fs.read_file(path) catch e {
		io.eprint("anti.log: ");
		io.eprint(e.message);
		io.eprint("\n");
		return SinkLogger.new("", Level.Info, StderrSink.new());
	};
	if source.len == 0 {
		return SinkLogger.new("", Level.Info, StderrSink.new());
	}
	/* The document copies what it reads, so the bytes are freed once it
	   is read. */
	let doc = toml.Document.read(text.from_bytes(source)) catch e {
		free(source.ptr);
		io.eprint("anti.log: ");
		io.eprint(e.message);
		io.eprint("\n");
		return SinkLogger.new("", Level.Info, StderrSink.new());
	};
	free(source.ptr);
	let logger = sinks_of(&doc);
	let kept = copy_of(doc.text_of("name", ""));
	logger.held = kept.ptr;
	logger.name = kept;
	logger.level = level_of(doc.text_of("level", "info"), Level.Info);
	if text.equal(doc.text_of("format", "text"), "json") {
		logger.format = Format.Json;
	}
	return logger;
}

/// The prefix `sink.N.` of `key` when it is the `kind` of an entry
/// `sink.N.kind`, or the empty text.
fn entry_of(key: str) -> str
{
	/* 5 is the length of `sink.` and of `.kind`. */
	if key.len <= 10 || !text.equal(text.slice(key, 0, 5), "sink.")
		|| !text.equal(text.slice(key, key.len - 5, key.len), ".kind") {
		return "";
	}
	if text.find_byte(text.slice(key, 5, key.len - 5), 0x2E) >= 0 {
		return "";
	}
	return text.slice(key, 0, key.len - 4);
}

/// The value of the key `field` of the entry whose keys start with `entry`.
fn field_of(doc: *toml.Document, entry: str, field: str) -> str
{
	let key = text.Builder.new();
	key.append(entry);
	key.append(field);
	return doc.text_of(key.text(), "");
}

/// A logger with the sink of every `[[sink]]` entry of `doc` that makes one, in
/// the order of the file, or with standard error when none does.
fn sinks_of(doc: *toml.Document) -> *FileLogger
{
	/* The keys of an entry stand in the order of the file, so its `kind`
	   orders it. A key outside the subset of `[[sink]]` names no entry. */
	let room = 1;
	for k in 0..doc.len() {
		if entry_of(doc.key(k)).len != 0 {
			room += 1;
		}
	}
	let legs = alloc(Leg, room) else {
		anti_rt_out_of_memory(room *| size_of(Leg));
	};
	let logger = alloc FileLogger { legs: []Leg { ptr: legs, len: room } };
	for k in 0..doc.len() {
		let entry = entry_of(doc.key(k));
		if entry.len == 0 {
			continue;
		}
		let sink = made(doc.value(k), field_of(doc, entry, "path")) else {
			continue;
		};
		logger.legs[logger.count] = Leg {
			sink: sink,
			level: level_of(field_of(doc, entry, "level"), Level.Trace),
		};
		logger.count += 1;
	}
	if logger.count == 0 {
		logger.legs[0] = Leg { sink: StderrSink.new(), level: Level.Trace };
		logger.count = 1;
	}
	return logger;
}
