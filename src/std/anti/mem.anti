//! Allocators, which a library or a class takes to make its memory.
//!
//! `Allocator` is the standard interface. `alloc(size, align)` gives `size`
//! bytes at an address that is a multiple of `align`, and `free(p)` gives them
//! back to the allocator that gave them. The language's own `alloc` and `free`
//! stay bound to the C library. A class whose user chooses where its memory
//! comes from takes a `*Allocator` and asks it.
//!
//! `LibcAllocator` is the default, over the C library. `ArenaAllocator` hands
//! out memory from blocks that it takes from another allocator, and gives every
//! block back at once.
//!
//! `Shared<T>` gives an object more than one owner, by a count of its handles.

import anti.lang;

extern fn anti_rt_mem_alloc(size: int, align: int) -> ?*byte;
extern fn anti_rt_mem_free(p: ?*byte);
extern fn memcpy(to: ?*byte, from: ?*byte, count: c_size_t) -> ?*byte;

/// The largest `int`, which the bytes of a block never pass.
const LARGEST: int = 0x7FFFFFFFFFFFFFFF;

/// The alignment of a block of `ArenaAllocator`, which serves every request up
/// to it from a block that other requests share.
const BLOCK_ALIGN: int = 16;

/// Memory on request, given back to the allocator that gave it.
pub abstract class Allocator
{
	/* DESIGN: `Object.deserialize`, `delete(p, from)` and
	   `destroy(p, from)` call `alloc` and `free` from the runtime as the
	   two table entries after the seven of the root and the nine hooks,
	   which src/rt/object.h names. They stay the first two functions, in this
	   order. */

	/// `size` bytes at an address that is a multiple of `align`, or `none`.
	///
	/// `align` is a power of two. A `size` below zero, an `align` that is no
	/// power of two and memory that has run out give `none`. A `size` of zero
	/// gives an address that `free` takes.
	abstract fn alloc(self, size: int, align: int) -> ?*byte;

	/// Give back `p`, which `alloc` of this allocator gave.
	///
	/// `none` does nothing.
	abstract fn free(self, p: ?*byte);

	/// The provider the link takes where the build names none, which is the
	/// allocator over the C library.
	pub fn default() -> *Allocator
	{
		return LibcAllocator.get();
	}
}

/// The allocator over the C library, which is the default of `Allocator`.
///
/// Its memory goes back through its own `free` and never through the
/// language's, since Windows gives aligned memory back with a function of its
/// own.
pub singleton class LibcAllocator inherits Allocator
{
	concrete fn alloc(self, size: int, align: int) -> ?*byte
	{
		return anti_rt_mem_alloc(size, align);
	}

	concrete fn free(self, p: ?*byte)
	{
		anti_rt_mem_free(p);
	}
}

/// The head of a block of `ArenaAllocator`, at the start of its memory.
struct Block
{
	next: ?*byte,
}

/// An allocator that hands out memory from blocks and gives them all back at
/// once.
///
/// The blocks come from another allocator. Each holds `block` bytes, or a
/// larger request alone. A request at an alignment above 16, the one of the
/// blocks, takes a block of its own at its alignment. `free` of one allocation
/// gives nothing back. `free_all` gives back every block and leaves the
/// allocator empty and ready for more, and `destruct` gives back what is left.
/// A copy would give the blocks back twice, so a program passes the address of
/// the one it made.
pub class ArenaAllocator inherits Allocator
{
	from: *Allocator,
	block: int = 0,
	head: ?*byte = none,
	used: int = 0,
	limit: int = 0,
	head_align: int = 0,

	/// An allocator without blocks, whose blocks come from `from` and hold
	/// `block` bytes.
	pub fn new(from: *Allocator, block: int) -> ArenaAllocator
	{
		return ArenaAllocator { from: from, block: block };
	}

	concrete fn alloc(self, size: int, align: int) -> ?*byte
	{
		if !valid(size, align) {
			return none;
		}
		let head = self.head;
		if head != none && align <= self.head_align {
			let pad = padding(self.used, align);
			let left = self.limit - self.used;
			if pad <= left && size <= left - pad {
				let start = self.used + pad;
				self.used = start + size;
				return &head[start];
			}
		}
		return self.grow(size, align);
	}

	/// Nothing, since the blocks go back all at once.
	concrete fn free(self, p: ?*byte)
	{
	}

	/// Give back every block, after which the allocator holds none and hands
	/// out memory again.
	pub fn free_all(self)
	{
		let at = self.head;
		while true do {
			let raw = at else { break; };
			let b = raw as *Block;
			at = b.next;
			self.from.free(raw);
		}
		self.head = none;
		self.used = 0;
		self.limit = 0;
		self.head_align = 0;
	}

	fn destruct(self)
	{
		self.free_all();
	}

	/// A new head block that serves the request, or `none`.
	fn grow(self, size: int, align: int) -> ?*byte
	{
		let block_align = align;
		if block_align < BLOCK_ALIGN {
			block_align = BLOCK_ALIGN;
		}
		let start = size_of(Block) + padding(size_of(Block), align);
		if size > LARGEST - start {
			return none;
		}
		let bytes = start + size;
		if bytes < self.block {
			bytes = self.block;
		}
		let raw = self.from.alloc(bytes, block_align) else { return none; };
		let b = raw as *Block;
		b.next = self.head;
		self.head = raw;
		self.used = start + size;
		self.limit = bytes;
		self.head_align = block_align;
		return &raw[start];
	}
}

/// Whether a request of `size` bytes at `align` can be served.
fn valid(size: int, align: int) -> bool
{
	return size >= 0 && align > 0 && (align & (align - 1)) == 0;
}

/// The bytes that take `n` up to the next multiple of `align`.
fn padding(n: int, align: int) -> int
{
	let over = n % align;
	if over == 0 {
		return 0;
	}
	return align - over;
}

/// The object of a `Shared<T>` and the number of its handles.
class Cell<T>
{
	pub atomic count: int,
	pub value: T,
}

/// An object with more than one owner, each holding a handle.
///
/// `Shared<Circle>.new(Circle { r: 2.0 })` takes the object and gives the first
/// handle. `share()` gives another and counts it, and `=` between two handles
/// is refused, so the count never changes where the source does not say so.
/// `dup` of a handle is `share()`, and so is the copy a collection makes of an
/// element. The object is torn down, through its `destruct`, when the last
/// handle is freed.
///
/// The count is atomic, so the handles of one object may be used and freed on
/// more than one thread at once. `T` must be thread-safe for more than one thread to
/// change the object.
///
/// `read(f)` and `modify(f)` lend the object to `f` for the call. No other
/// pointer to it leaves the handle.
///
/// Two shared objects that hold a handle of each other are never freed, since
/// each keeps the count of the other above zero. A plain pointer for one of the
/// two links is the fix.
pub final class Shared<T>
{
	/* DESIGN: the handle owns its cell with `own`, which is what makes `=`
	   refuse to copy a handle. `destruct` frees the cell itself when it
	   holds the last count, and leaves `none` in the field in every case,
	   so the teardown of `own` fields that follows it frees nothing. The
	   field has no default, so a literal outside the module makes no
	   handle, and a handle holds `none` only after its teardown. */
	own cell: ?*Cell<T>,

	/// The first handle of `value`, which the handle takes.
	pub fn new(own value: T) -> Shared<T>
	{
		return Shared<T> {
			cell: alloc Cell<T> { count: 1, value: moved(value) },
		};
	}

	/// Another handle of the same object, which counts one more.
	pub fn share(self) -> Shared<T>
	{
		let cell = self.cell catch fatal;
		cell.count.add(1);
		return Shared<T> { cell: cell };
	}

	/// The number of handles of the object at this moment.
	pub fn count(self) -> int
	{
		let cell = self.cell catch fatal;
		return cell.count.load();
	}

	/// Lend the object to `f` for the call, to read it.
	pub fn read(self, f: fn(lent *T))
	{
		let cell = self.cell catch fatal;
		f(&cell.value);
	}

	/// Lend the object to `f` for the call, to change it.
	pub fn modify(self, f: fn(lent *T))
	{
		let cell = self.cell catch fatal;
		f(&cell.value);
	}

	/// Another handle in `to`, as `share()` gives one.
	///
	/// DESIGN: `dup` gives a replaced `copy` memory that nothing has written,
	/// and a collection gives it the bytes of the element. The bytes of this
	/// handle go into `to` first in both cases, its table among them.
	concrete fn copy(self, to: *Object)
	{
		memcpy(to as ?*byte, self as ?*byte, size_of(Shared<T>) as c_size_t);
		let cell = self.cell catch fatal;
		cell.count.add(1);
	}

	fn destruct(self)
	{
		let cell = self.cell else {
			return;
		};
		self.cell = none;
		if cell.count.sub(1) == 1 {
			delete(cell);
		}
	}
}

/// `value` itself, which the call moves out of the parameter.
///
/// DESIGN: a field of a literal copies an `own` parameter and leaves it to the
/// teardown of the function, while `return` moves it. `Shared.new` passes its
/// value through here, so the cell takes it by a move.
fn moved<T>(own value: T) -> T
{
	return value;
}
