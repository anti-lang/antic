//! The warnings of the checker, each allowed, and the doc warnings, which fail
//! nothing.
//!
//! # A heading, which the doc markup has not

import anti.lang;

/// Nothing of this module fails, which the header allows.
pub fn close_it(n: int) may fail
	allow(never-fails, "an implementation of the contract may fail")
{
	if n < 0 { return; }
}

pub fn undocumented() -> int
{
	return 1;
}

/// `nowhere` names nothing of this module.
pub fn handler() -> int
{
	let e = 1;
	allow(shadowed-catch, "the handler returns at once")
	close_it(2) catch e {
		return 1;
	};
	return e;
}

fn main() -> int
{
	return handler() + undocumented();
}
