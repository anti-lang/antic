//! `f"..."(from)` takes one argument, the `anti.mem.Allocator` of its
//! text. A literal with no argument, one with two, and one with a value
//! that is no allocator are refused.
import anti.mem;
import anti.text;

fn main() -> int
{
	let n = 1;
	let a = f"{n}"();
	let b = rf"{n}"(mem.LibcAllocator.get(), 2);
	let c = f"{n}"(&n);
	return 0;
}
