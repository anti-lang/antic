//! The refusals of the default `==` and of order. A struct or a class gets a
//! default `==` and no default `<`, so a type used where `lt` or `Ordered` is
//! needed declares `operator fn lt`, and the refusal says so. A struct with a
//! field that has no `==` gets no default and the refusal names the field. A
//! union gets none. A class that holds one gets none unless it replaces
//! `equals`, and the refusal names the field. A tuple, a variant, a `?T` or an
//! array with a part that has no `==` gets none either.

struct Point
{
	x: int,
}

struct Buffer
{
	data: Word,
}

union Word
{
	whole: u32,
	half: u16,
}

variant Held
{
	Some { data: [2]f16 },
	Nothing,
}

class Circle
{
	pub r: int = 0,
}

class Holder
{
	pub word: Word,
}

class Replaced
{
	pub word: Word,

	concrete fn equals(self, other: *Object) -> bool
	{
		return other is *Replaced;
	}
}

fn larger<T: Ordered>(a: T, b: T) -> T
{
	if a < b {
		return b;
	}
	return a;
}

fn points(a: Point, b: Point) -> bool
{
	return a < b;
}

fn circles(a: Circle, b: Circle) -> bool
{
	return a >= b;
}

fn buffers(a: Buffer, b: Buffer) -> bool
{
	return a == b;
}

fn words(a: Word, b: Word) -> bool
{
	return a != b;
}

fn holders(a: Holder, b: Holder) -> bool
{
	return a == b;
}

fn replaced(a: Replaced, b: Replaced) -> bool
{
	return a == b;
}

fn tuples(a: ([2]f16, int), b: ([2]f16, int)) -> bool
{
	return a == b;
}

fn halves(a: [2]f16, b: [2]f16) -> bool
{
	return a == b;
}

fn helds(a: Held, b: Held) -> bool
{
	return a == b;
}

fn views(a: ?[]int, b: ?[]int) -> bool
{
	return a == b;
}

fn main() -> int
{
	let p = Point { x: 1 };
	let q = larger(p, p);
	let c = Circle { r: 1 };
	let d = larger(c, c);
	return q.x + d.r;
}
