import anti.lang;

fn risky() -> int may fail
{
	fail "no";
}

fn dropped() -> int
{
	risky();
	return 0;
}

fn outside() -> int
{
	let n = try risky();
	return n;
}

fn failing_outside() -> int
{
	fail "not here";
}

fn bad_value() -> int may fail
{
	fail 7;
}

/// A function that returns an error as a value is no failing function, whatever
/// its result type, so it can neither forward nor fail.
fn by_hand() -> ?*lang.Error
{
	let n = try risky();
	return none;
}

fn fail_by_hand() -> ?*lang.Error
{
	fail "not here";
}

class Store
{
	pub n: int = 0,

	pub fn get(self) -> int may fail
	{
		fail "empty";
	}

	pub fn open(n: int) -> *Store may fail
	{
		fail "closed";
	}
}

fn dropped_members(s: *Store) -> int
{
	s.get();
	Store.open(1);
	return 0;
}

fn main() -> int
{
	return dropped() + outside() + failing_outside() + bad_value();
}
