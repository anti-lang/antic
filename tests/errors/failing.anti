import anti.error;

fn risky() -> int may fail
{
	fail "no";
}

fn dropped() -> int
{
	risky();
	return 0;
}

fn outside() -> int
{
	let n = try risky();
	return n;
}

fn failing_outside() -> int
{
	fail "not here";
}

fn bad_value() -> int may fail
{
	fail 7;
}

class Box
{
	pub n: int = 0,

	fn construct(self, n: int) may fail
	{
		self.n = n;
	}
}

fn main() -> int
{
	return dropped() + outside() + failing_outside() + bad_value();
}
