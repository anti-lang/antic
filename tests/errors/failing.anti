import anti.lang;

fn risky() -> int may fail
{
	fail "no";
}

fn dropped() -> int
{
	risky();
	return 0;
}

fn outside() -> int
{
	let n = try risky();
	return n;
}

fn failing_outside() -> int
{
	fail "not here";
}

fn bad_value() -> int may fail
{
	fail 7;
}

fn main() -> int
{
	return dropped() + outside() + failing_outside() + bad_value();
}
