//! E2 and an `own` field of `self` passed to an `own` parameter of a function
//! of a library: the field moves into it, and naming it after is refused.

import com.example.moves;

class Holder
{
	pub own a: *moves.Node,

	pub fn drop(self) -> int
	{
		let k = moves.take(self.a);
		return k + self.a.n;
	}
}

fn main() -> int
{
	return 0;
}
