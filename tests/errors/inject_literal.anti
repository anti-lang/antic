//! The provider of an interface fills an `inject` field, so a literal that
//! names it is refused and one that leaves it out is complete.
abstract class Logger
{
	abstract fn say(self);
}

singleton class Console
{
	implements lg: Logger,

	concrete fn say(self) { }
}

class Service
{
	pub inject log: *Logger,
	pub name: str = "service",
}

fn main() -> int
{
	let s = Service { log: Console.get(), name: "other" };
	s.log.say();
	return 0;
}
