// A build past the front end compiles a copy of every generic it uses. A
// function of a class with type parameters of its own is not compiled yet,
// and its first call is refused.

class Box<T>
{
	pub value: T,

	pub fn pair<U>(self, other: U) -> U
	{
		return other;
	}
}

fn main() -> int
{
	let b = Box<int> { value: 7 };
	return b.pair(0);
}
