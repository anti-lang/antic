//! C4 in a `tests` block: `forward` takes `a` and then `b`, and a test takes
//! `b` and then `a`.

struct Pair
{
	a: Mutex,
	b: Mutex,
	n: int,
}

fn forward(p: *Pair)
{
	sync p.a {
		sync p.b {
			p.n += 1;
		}
	}
}

tests
{
	fn takes_the_other_order()
	{
		let p = Pair { n: 0 };
		forward(&p);
		sync p.b {
			sync p.a {
				p.n -= 1;
			}
		}
		assert(p.n == 0);
	}
}

fn main() -> int
{
	return 0;
}
