//! A `link framework` line names one framework of Apple's SDK, once. A path, an
//! empty text and a name twice are refused, and a line without a string is a
//! syntax error. `link` and `framework` stay names elsewhere.

link framework "CoreAudio";
link framework "CoreAudio";
link framework "";
link framework "/System/Library/Frameworks/Cocoa";

fn main() -> int
{
	let link = 1;
	let framework = 2;
	return link + framework;
}
