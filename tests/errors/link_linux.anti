//! A `link linux` line names one library of the glibc sysroot, once. A path, a
//! name with a backslash or a space, an empty text and a name twice are
//! refused. `linux` stays a name elsewhere.

link linux "X11";
link linux "X11";
link linux "";
link linux "/usr/lib/libGL.so";
link linux "lib\\GL";
link linux "lib GL";

fn main() -> int
{
	let linux = 2;
	return linux;
}
