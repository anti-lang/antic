//! A library file calls a final function of a class of `counter`, and the later
//! file of `counter` lacks it. By "Answers of 2026-11-12" the read refuses the
//! library file.

import com.example.counter;
import com.example.final_user;

fn main() -> int
{
	let c = counter.Counter { };
	return final_user.used(&c);
}
