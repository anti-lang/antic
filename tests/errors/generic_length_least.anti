//! The length of a copy of a generic divides the least `i8` by -1, which the
//! copy leaves as it stands and the back end refuses.

const LEAST: int = -128;
const MINUS: int = -1;

struct S<N: int, Z: int>
{
	a: [((N as i8) / (Z as i8)) as int]int,
}

fn main() -> int
{
	return size_of(S<LEAST, MINUS>) as int;
}
