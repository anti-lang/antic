//! An `own` parameter stored through the pointer a call gives, and named after
//! the move. The place has no name, so the message names the line of the move,
//! by R082 of "Rules of 2026-10-13".

class Box
{
	pub own data: ?*int = none,
	pub n: int = 0,
}

fn slot(b: *Box) -> *Box
{
	return b;
}

fn store(own b: Box, to: *Box) -> int
{
	*slot(to) = b;
	return b.n;
}

fn main() -> int
{
	return 0;
}
