//! `destroy(&c)` of a local ends `c`, so naming `c` again is refused, on the
//! path after the `destroy` and after an `if` that destroys it on one path.
//! `destroy` of a part of a local is refused: it takes the whole value, or the
//! part a class with its own teardown holds.

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Key = none,
}

struct Pair
{
	k: Key,
	n: int,
}

class Box
{
	pub k: Key,
}

fn main() -> int
{
	let q = Pair { k: Key { }, n: 2 };
	destroy(&q.k);
	let box = Box { k: Key { } };
	destroy(&box.k);
	let keys: [2]Key = [Key { }, Key { }];
	destroy(&keys[0]);
	return 0;
}

fn destroyed() -> int
{
	let k = Key { };
	destroy(&k);
	let a = k.n;
	let p = Pair { k: Key { }, n: 1 };
	if a > 0 {
		destroy(&p);
	}
	let b = p.n;
	return a + b;
}
