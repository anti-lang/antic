}

class Derived inherits Counted
{
	pub m: int = 0,
}

class Holder
{
	pub counted: Counted = Counted { },
}

struct Pair
{
	c: Counted,
	n: int,
}

/// A class two levels above the `destruct`.
class Outer
{
	pub holder: Holder = Holder { },
}

/// A class that holds the `destruct` through a struct.
class Wrap
{
	pub pair: Pair = Pair { c: Counted { }, n: 0 },
}

class Plain
{
	pub n: int = 0,
}

