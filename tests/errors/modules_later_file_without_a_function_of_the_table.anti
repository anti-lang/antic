//! A library file calls a function of a class through its table of `counter`,
//! and the later file of `counter` lacks it. By "Answers of 2026-11-12" the
//! read refuses the library file.

import com.example.counter;
import com.example.table_user;

fn main() -> int
{
	let c = counter.Counter { };
	return table_user.used(&c);
}
