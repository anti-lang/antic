//! The program lists the struct of the library in a direct import and names it
//! without its module, so the message names its locks so as well.

import com.example.locks.{Pair, forward};

fn backward(p: *Pair)
{
	sync p.b {
		sync p.a {
			p.n += 1;
		}
	}
}

fn main() -> int
{
	let p = locks.pair();
	forward(&p);
	backward(&p);
	return 0;
}
