//! The comments of a variant case and of its fields take the doc checks, the
//! `//#` note of a case as well.

variant Shape {
	/// A circle.
	//# # A heading in the note of a case
	Circle {
		/// | a table in the doc of a field of a case |
		r: f32,
		//# ![an image](in the note of a field of a case)
		d: f32,
	},
	Empty,
}

fn main() -> int
{
	let s = Shape.Empty;
	return s.tag as int;
}
