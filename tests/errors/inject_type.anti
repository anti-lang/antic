//! `inject` needs a pointer to an abstract class. A nullable pointer, a pointer
//! to a complete class, a default beside it and `own` are each refused. A type
//! that names nothing has the one message of the type.
abstract class Logger
{
	abstract fn say(self);
}

class Console
{
	implements lg: Logger,

	concrete fn say(self) { }
}

class Bad
{
	inject a: int,
	inject b: ?*Logger,
	inject c: *Console,
	inject own d: *Logger,
	inject e: *Logger = none,
	inject f: Missing,
}

fn main() -> int
{
	let x = Console { };
	x.say();
	return 0;
}
