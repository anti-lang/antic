import anti.lang;

fn risky(out: *int) -> ?*lang.Error
{
	*out = 1;
	return none;
}

fn quiet() -> int
{
	risky();
	return 0;
}

fn keeper() -> int
{
	let kept = risky() catch e {
		yield 1;
	};
	let escaped = risky() catch e {
		let mine = e;
		yield 2;
	};
	return kept + escaped;
}

fn no_place() -> int
{
	yield 3;
}

fn main() -> int
{
	return quiet() + keeper() + no_place();
}
