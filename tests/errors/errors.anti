import anti.lang;

fn risky(n: int) -> int may fail
{
	if n < 0 {
		fail "n is negative";
	}
	return n;
}

fn quiet() -> int
{
	risky(1);
	return 0;
}

fn keeper() -> int
{
	let kept = risky(1) catch e {
		yield 1;
	};
	let escaped = risky(1) catch e {
		let mine = e;
		yield 2;
	};
	return kept + escaped;
}

fn no_place() -> int
{
	yield 3;
}

fn main() -> int
{
	return quiet() + keeper() + no_place();
}
