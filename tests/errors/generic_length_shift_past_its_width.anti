//! The length of a copy of a generic shifts by a constant parameter of 64, the
//! width of `int`. The copy leaves the shift as it stands, and the back end
//! refuses it, as it refuses a shift by a count below zero.

struct Row<N: int>
{
	cells: [(1 << N) + 1]int,
}

fn main() -> int
{
	return size_of(Row<64>) as int;
}
