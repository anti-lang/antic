//! An interface with no provider is refused at link, and the message names the
//! class and the field that need one.
abstract class Logger
{
	abstract fn say(self) -> int;
}

singleton class Console
{
	implements lg: Logger,

	concrete fn say(self) -> int { return 0; }
}

class Service
{
	inject log: *Logger,

	pub fn run(self) -> int
	{
		return self.log.say();
	}
}

fn main() -> int
{
	let s = Service { };
	return s.run();
}
