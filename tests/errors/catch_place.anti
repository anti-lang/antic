import anti.lang;

fn risky(n: int) -> int may fail
{
	if n < 0 {
		fail "n is negative";
	}
	return n;
}

/// `catch` after a call fills the place, in every form the `let` takes.
fn filled(p: *int) -> int
{
	let n = 0;
	n = risky(1) catch fatal;
	*p = risky(1) catch { yield 2; };
	return n + *p;
}

/// A `catch` that guards a pointer binds the one it proved, and an assignment
/// has no name for it.
fn guarded(q: ?*int) -> int
{
	let n = 0;
	let r = &n;
	r = q catch fatal;
	return *r;
}
