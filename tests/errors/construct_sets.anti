import anti.lang;

class Needs
{
	pub v: int,
}

class Box
{
	pub w: int,
	pub part: Needs,
	pub label: str = "",

	fn construct(self, w: int) may fail
	{
		if w < 0 {
			fail lang.Error.new(1, "negative");
		}
		self.w = w;
		return;
	}
}

class Branches
{
	pub a: int,

	fn construct(self, x: int) may fail
	{
		if x < 0 {
			fail "negative";
		}
		if x > 0 {
			self.a = x;
		}
	}
}

class Loop
{
	pub a: int,

	fn construct(self, x: int) may fail
	{
		if x < 0 {
			fail "negative";
		}
		for i in 0..x {
			self.a = i;
		}
	}
}

class Base
{
	pub b: int,

	fn construct(self, b: int) may fail
	{
		if b < 0 {
			fail "negative";
		}
		self.b = b;
	}
}

class Orphan inherits Base
{
	pub d: int,

	fn construct(self, x: int) may fail
	{
		if x < 0 {
			fail "negative";
		}
		self.d = x;
	}
}

class Quiet
{
	pub q: int,

	fn construct(self, x: int)
	{
		if x > 0 {
			self.q = x;
		}
	}
}

class Good
{
	pub a: int,
	pub part: Needs,

	fn construct(self, x: int) may fail
	{
		if x < 0 {
			fail lang.Error.new(1, "negative");
		}
		if x > 0 {
			self.a = x;
		} else {
			self.a = 0;
		}
		self.part = Needs { v: x };
	}
}

class Derived inherits Base
{
	pub d: int,

	fn construct(self, x: int) may fail
	{
		try self.super.construct(x);
		switch x {
			0 => self.d = 1,
			else => self.d = x,
		}
	}
}

class Plain
{
	pub a: int,

	fn construct(self)
	{
	}
}
