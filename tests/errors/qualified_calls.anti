//! A call on the class of a name that only bodies qualified by two or
//! more interfaces fill is ambiguous, and the message names the
//! interfaces. A call through a sub-object or an interface pointer names
//! its table. A name that bodies qualified by one interface fill is not
//! ambiguous, so `p.read()` is accepted.

extern fn printf(fmt: ?*byte, ...) -> c_int;

abstract class Drawable
{
	abstract fn draw(self);
}

abstract class Card
{
	abstract fn draw(self, n: int) -> int;
}

abstract class Deck
{
	abstract fn draw(self, n: int) -> int;
}

abstract class Readable
{
	abstract fn read(self) -> int;
}

class Hand
{
	implements dr: Drawable,
	implements cd: Card,
	implements dk: Deck,
	implements rd: Readable,

	concrete fn Drawable::draw(self)
	{
	}

	concrete fn Card::draw(self, n: int) -> int
	{
		return n;
	}

	concrete fn Deck::draw(self, n: int) -> int
	{
		return n + 1;
	}

	concrete fn Readable::read(self) -> int
	{
		return 1;
	}

	pub fn inside(self)
	{
		self.draw();
	}
}

/* Two interfaces at two levels of the chain are two as well. */
class Palm
{
	implements dr: Drawable,

	concrete fn Drawable::draw(self)
	{
	}
}

class Fist inherits Palm
{
	implements cd: Card,

	concrete fn Card::draw(self, n: int) -> int
	{
		return n;
	}
}

fn main() -> int
{
	let f = Fist { };
	f.draw(1);
	let h = Hand { };
	let p = &h;
	h.draw();
	p.draw(1);
	let bound = p.draw;
	Hand.draw(&h);
	p.read();
	h.dr.draw();
	let c: *Card = p;
	printf("%d\n".ptr, (c.draw(1) + h.dk.draw(2) + h.rd.read()) as c_int);
	return 0;
}
