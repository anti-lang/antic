//! A program that prints the raw trace of the calls that lead to `inner`, which
//! `anti symbols resolve` turns into names and lines. One call goes through a
//! copy of a generic, whose symbol escapes its name.

import anti.io;
import anti.lang;

/// Print the raw trace of the calls that lead here.
fn inner(depth: int) -> int
{
	let t = lang.StackTrace.capture();
	defer delete(t);
	io.println(t.text());
	return depth;
}

/// One call more on the trace, through a copy of a generic whose name holds a
/// blank, `through<float, str>`.
fn through<A, B>(depth: int, weight: A, tag: B) -> int
{
	return inner(depth);
}

/// One call more on the trace.
fn outer(depth: int) -> int
{
	return through(depth + 1, 2.5, "tag") + 1;
}

fn main() -> int
{
	return outer(1) - 3;
}
