//! What the header of a library writes for C: two field names that share their
//! first 136 bytes, a float constant with a whole value, and a class whose
//! table holds more than 64 public functions. Every C name stands for one type
//! or function, the table of a class has the slots of antic's table, a class
//! field has its type declared first, and every constant is a C literal.

import anti.lang;

/// Two fields whose names differ past byte 136.
export struct Pair
{
	sharedqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqa: c_int,
	sharedqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqb: c_int,
}

/// A whole f32, which C reads as a float.
export const TWO_F32: f32 = 2.0;

/// A whole f64, which C reads as a double.
export const TWO_F64: f64 = 2.0;

