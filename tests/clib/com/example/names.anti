//! What the header of a library writes for C: two field names that share their
//! first 136 bytes, a float constant with a whole value, and a class whose
//! table holds more than 64 public functions.

import anti.lang;

/// Two fields whose names differ past byte 136.
export struct Pair
{
	sharedqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqa: c_int,
