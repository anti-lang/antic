//! A library for C whose functions may fail.

import anti.error;

/// A count that must stay positive.
export struct Counter
{
	n: c_int,
}

/// Halve n, or fail when it is odd.
export fn failing_half(n: c_int) -> c_int may fail
{
	if n % 2 != 0 { fail "n is odd"; }
	return n / 2;
}

/// Add one to the counter, or fail when it would pass the limit.
export fn failing_step(c: *Counter, limit: c_int) may fail
{
	if c.n >= limit { fail error.Error.new(1, "the counter is at its limit"); }
	c.n += 1;
}

/// Twice n, which never fails.
export fn failing_twice(n: c_int) -> c_int
{
	return n * 2;
}
