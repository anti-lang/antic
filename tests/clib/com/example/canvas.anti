//! Shapes a C program can build, measure and end. The class carries its
//! table pointer first, so C reads the layout as nested structs and calls
//! the entry through the table.

import anti.lang;

/// What a shape can be drawn with.
export abstract class Ink
{
	/// The colour the shape draws with.
	abstract fn colour(self) -> c_int;
}

/// A shape on the canvas.
export class Shape
{
	x: c_int = 0,
	y: c_int = 0,

	/// The area of the shape, which each class below decides.
	export fn area(self) -> c_int
	{
		return 0;
	}

	/// Move the shape by dx and dy.
	export fn move(self, dx: c_int, dy: c_int)
	{
		self.x = self.x + dx;
		self.y = self.y + dy;
	}
}

/// A square of one side.
export class Square inherits Shape
{
	implements ink: Ink,
	side: c_int = 1,

	concrete fn area(self) -> c_int
	{
		return self.side * self.side;
	}

	concrete fn colour(self) -> c_int
	{
		return 7;
	}
}

/// A circle of a positive radius.
export class Circle inherits Shape
{
	radius: c_int = 1,

	/// Take the radius, or fail when it is not positive.
	fn construct(self, radius: c_int) may fail
	{
		if radius <= 0 { fail "the radius must be positive"; }
		self.radius = radius;
	}

	concrete fn area(self) -> c_int
	{
		return 3 * self.radius * self.radius;
	}
}

/// A second ink, which takes a shade.
export abstract class Tint
{
	/// The colour at the shade k.
	abstract fn colour(self, k: c_int) -> c_int;
}

/// A stamp, which fills `colour` once for each ink.
export class Stamp
{
	implements ink: Ink,
	implements tint: Tint,
	shade: c_int = 2,

	concrete fn Ink::colour(self) -> c_int
	{
		return 5;
	}

	concrete fn Tint::colour(self, k: c_int) -> c_int
	{
		return self.shade * k;
	}
}

/// A tile, whose body of `area` names the base.
export class Tile inherits Shape
{
	side: c_int = 3,

	concrete fn Shape::area(self) -> c_int
	{
		return self.side * self.side;
	}
}
