//! A declared command line reads a flag, a value in three forms and the
//! arguments that are no option, and writes its own help text. An unknown
//! option and an option without its value each fail with their code, and `try`
//! forwards the error of `parse`.
import anti.args;
import anti.io;
import anti.lang;
import anti.text;

/// Read `argv` with `p`, forwarding the error of `parse`.
fn parse_all(p: *args.Parser, argv: []str) may fail
{
	try p.parse(argv);
}

/// The code of the error that `argv` gives, or -1 when it gives none.
fn refused(p: *args.Parser, argv: []str) -> int
{
	parse_all(p, argv) catch e {
		io.println(e.message);
		return e.code;
	};
	return -1;
}

fn main(argv: []str, env: []str) -> int
{
	let p = args.Parser.new("pin", "pin a version of a package");
	p.flag("verbose", 0x76, "write more about what happens");
	p.value("output", 0x6F, "the file to write", "a.out");
	p.value("jobs", 0x6A, "how many jobs run at once", "1");
	p.parse(argv) catch e {
		io.println(e.message);
		return 1;
	};

	if !p.given("verbose") {
		return 2;
	}
	if p.given("help") {
		return 3;
	}
	io.println(p.text_of("output"));
	if p.int_of("jobs", 0) != 8 || p.int_of("output", 3) != 3 {
		return 4;
	}
	for i in 0..p.len() {
		io.println(p.at(i));
	}

	let out = text.Builder.new();
	p.help(&out);
	io.print(out.text());

	let q = args.Parser.new("pin", "");
	let wrong: [2]str = ["pin", "--missing"];
	if refused(&q, wrong[0..2]) != 1 {
		return 5;
	}
	let r = args.Parser.new("pin", "");
	r.value("output", 0x6F, "the file to write", "a.out");
	let bare: [2]str = ["pin", "-o"];
	if refused(&r, bare[0..2]) != 2 {
		return 6;
	}
	return 0;
}
