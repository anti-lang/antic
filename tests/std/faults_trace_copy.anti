//! The name and the line of a frame of a copy of a generic when memory runs
//! out. The name a person reads, `inside<int>`, takes memory of its own, and a
//! build with `-g` reads the line from the object. Memory that runs out for
//! either stops the program, by decision 4 of "Decisions of 2026-10-11", and a
//! frame whose object cannot be read has the line 0. A case of
//! `faults_trace_copy.faults` refuses one allocation or one open, through the
//! variable `ANTI_FAULT` of `src/rt/fault.h`.
import anti.debug;
import anti.io;
import anti.lang;
import anti.text;

/// The trace from inside a copy of a generic, which is its first frame in dev
/// mode. Release mode inlines it into `main`.
fn inside<T>(x: T) -> *lang.StackTrace
{
	return debug.backtrace();
}

fn main() -> int
{
	let t = inside<int>(1);
	defer delete(t);
	let named = t.symbolize();
	io.println(f"{named[0].function} {named[0].line}");
	return 0;
}
