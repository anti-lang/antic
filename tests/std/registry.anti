//! The link step writes a registry of every class of the program.
//! `reflect.new` builds an object of a class it names, and
//! `Object.deserialize` builds one from the JSON that `serialize` writes.
import anti.error;
import anti.io;
import anti.reflect;
import anti.text;

extern fn printf(fmt: ?*byte, ...) -> c_int;

class Point
{
	pub x: int = 1,
	pub y: int = 2,

	fn construct(self)
	{
		self.y = self.y + 10;
	}
}

class Marked
{
	inherits Point,

	pub tag: int = 9,
	pub own next: *Point,
	pub ratio: f64 = 0.5,
	pub small: i8 = -3,
}

class Sized
{
	pub n: int = 0,

	fn construct(self, n: int) -> ?*error.Error
	{
		self.n = n;
		return none;
	}
}

class Holds
{
	pub sized: Sized,
}

abstract class Shape
{
	abstract fn area(self) -> int;
}

class Square
{
	inherits Shape,

	concrete fn area(self) -> int
	{
		return 4;
	}
}

singleton class Settings
{
	level: int = 3,
}

fn main() -> int
{
	let o = reflect.new("Point");
	if o == none || !(o is *Point) {
		return 1;
	}
	let p = o as *Point;
	printf("%d %d\n".ptr, p.x as c_int, p.y as c_int);
	delete(p);

	let q = reflect.new("registry.Marked");
	if q == none || !(q is *Marked) {
		return 2;
	}
	let m = q as *Marked;
	printf("%d %d %d\n".ptr, m.y as c_int, m.tag as c_int, m.small as c_int);
	delete(m);

	/* No complete value, one instance, arguments to construct, or no
	   such class. */
	if reflect.new("Shape") != none || reflect.new("Settings") != none ||
		reflect.new("Sized") != none || reflect.new("Nothing") != none {
		return 3;
	}
	/* A field whose class cannot be written as `T { }` has no value
	   until a literal names it. */
	if reflect.new("Holds") != none ||
		Object.deserialize("{\"type\":\"Holds\"}") != none {
		return 4;
	}

	let first = alloc Point { x: 8, y: 9 };
	let made = alloc Marked { x: 5, y: 6, tag: 7, next: first, ratio: 2.25 };
	let b = text.Builder.new();
	made.serialize(&b);
	io.println(b.text());
	let back = Object.deserialize(b.text());
	if back == none || !(back is *Marked) {
		return 4;
	}
	let r = back as *Marked;
	printf("%d %d %d %d %d %g %d\n".ptr, r.x as c_int, r.y as c_int,
		r.tag as c_int, r.next.x as c_int, r.next.y as c_int, r.ratio,
		r.small as c_int);
	b.clear();
	r.serialize(&b);
	io.println(b.text());
	delete(r);
	delete(made);

	/* A class whose construct takes arguments comes back with its
	   fields, since they come from the text. */
	let sized = Object.deserialize("{ \"type\" : \"Sized\", \"n\" : 4 }");
	if sized == none || !(sized is *Sized) {
		return 5;
	}
	printf("%d\n".ptr, (sized as *Sized).n as c_int);
	delete(sized);

	if Object.deserialize("{\"type\":\"Nothing\"}") != none ||
		Object.deserialize("{\"type\":\"Shape\"}") != none ||
		Object.deserialize("{\"x\":1}") != none ||
		Object.deserialize("{\"type\":\"Point\",\"x\":}") != none ||
		Object.deserialize("not json") != none {
		return 6;
	}
	return 0;
}
