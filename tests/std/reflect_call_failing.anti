//! `reflect.call` of a public function that may fail. The table entry of such a
//! function returns the error and takes an out pointer for its result, which no
//! `Value` carries, so the call fails with `NOT_CARRIED` and runs nothing.
import anti.lang;
import anti.reflect;

extern fn printf(fmt: ?*byte, ...) -> c_int;

class Box
{
	pub v: int = 3,

	pub fn half(self, x: int) -> int may fail
	{
		if x < 0 {
			fail "below zero";
		}
		self.v = x;
		return x / 2;
	}

	pub fn touch(self, x: int) may fail
	{
		if x < 0 {
			fail "below zero";
		}
		self.v = x;
	}
}

/// Call the function at `index` of `o` with `x`, and print the code of the
/// error or the kind of the result.
fn show(o: *Object, index: int, x: int)
{
	let args = [reflect.of_int(x)];
	let v = reflect.call(o, index, args[0..1]) catch e {
		printf("refused %d %.*s\n".ptr, e.code as c_int, e.message.len as c_int,
			e.message.ptr);
		return;
	};
	printf("kind %d\n".ptr, v.kind as c_int);
}

fn main() -> int
{
	let b = alloc Box { };
	let o: *Object = b;

	/* The seven functions of the root and its nine hooks come first,
	   then those of the class. */
	show(o, 16, 10);
	show(o, 17, 10);
	show(o, 17, -1);
	printf("%d\n".ptr, b.v as c_int);
	delete(b);
	return 0;
}
