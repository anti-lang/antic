//! `fatal` runs the function that `error.on_fatal` registered, prints the error
//! to standard error and ends the program with its code. The hook lives in
//! `anti.lang`, and `anti.error` stores into it.
import anti.error;
import anti.io;
import anti.lang;

fn shutting_down()
{
	io.println("about to end");
}

fn main() -> int
{
	error.on_fatal(shutting_down);
	let e = lang.Error.new(3, "the end");
	e.fatal();
	return 0;
}
