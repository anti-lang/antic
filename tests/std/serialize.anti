//! The default `serialize` writes each field by the type its record
//! names, and `Object.deserialize` reads the text back. `Every` holds a
//! field of every kind. An `own` slice is written as its elements, and a
//! pointer or a slice that the object does not own as its address.
import anti.io;
import anti.mem;
import anti.text;

extern fn printf(fmt: ?*byte, ...) -> c_int;

enum Mode: u8 { Off, Slow, Fast }

struct Size
{
	w: i32,
	h: f64,
}

class Tag
{
	pub label: str = "t",
	pub weight: u16 = 7,
}

class Every
{
	pub a: i8 = -8,
	pub b: i16 = -16,
	pub c: i32 = -32,
	pub d: i64 = -64,
	pub e: u8 = 200,
	pub f: u16 = 60000,
	pub g: u32 = 4000000000,
	pub h: u64 = 18446744073709551615,
	pub x: f32 = 1.5,
	pub y: f64 = -0.25,
	pub half: f16 = 0.1 as f16,
	pub on: bool = true,
	pub letter: char = 'é',
	pub name: str = "a \"quoted\"\tline\n",
	pub own counts: []i32,
	pub view: []byte,
	pub other: ?*Tag = none,
	pub size: Size = Size { w: 3, h: 4.5 },
	pub tag: Tag = Tag { },
	pub mode: Mode = Mode.Fast,
	pub own spot: ?*Size = none,
	pub own words: []str,
	pub own sizes: []Size,
}

fn write(o: *Object, b: *text.Builder) -> str
{
	b.clear();
	o.serialize(b);
	return b.text();
}

fn main() -> int
{
	let made = alloc Every {
		counts: []i32 { ptr: alloc(i32, 3), len: 3 },
		view: []byte { ptr: none, len: 0 },
		spot: alloc Size { w: 1, h: 2.0 },
		words: []str { ptr: alloc(str, 2), len: 2 },
		sizes: []Size { ptr: alloc(Size, 1), len: 1 },
	};
	made.counts[0] = 1;
	made.counts[1] = -2;
	made.counts[2] = 3;
	made.words[0] = "one";
	made.words[1] = "tw\"o";
	made.sizes[0] = Size { w: 5, h: 0.5 };
	let one = text.Builder.new();
	let two = text.Builder.new();
	let first = write(made, &one);
	io.println(first);

	let arena = mem.ArenaAllocator.new(mem.LibcAllocator.get(), 1024);
	let back = Object.deserialize(first, &arena);
	if back == none || !(back is *Every) {
		return 1;
	}
	let again = write(back, &two);
	io.println(again);
	if !text.equal(first, again) {
		return 2;
	}
	let e = back as *Every;
	let e_spot = e.spot else { return 3; };
	if e.letter != 'é' || e.counts.len != 3 || e.counts[1] != -2 ||
		e.size.h != 4.5 || e.tag.weight != 7 || e.mode != Mode.Fast ||
		e_spot.w != 1 || !text.equal(e.words[1], "tw\"o") ||
		e.sizes[0].h != 0.5 || *(&e.half as *u16) != 0x2E66 {
		return 3;
	}

	/* A pointer and a slice that the object does not own come back as
	   the same address. */
	let tag = alloc Tag { label: "far" };
	let bytes = "abc";
	made.other = tag;
	made.view = []byte { ptr: bytes.ptr, len: 3 };
	let far = Object.deserialize(write(made, &one), &arena);
	if far == none {
		return 4;
	}
	let f = far as *Every;
	printf("%d %d %d\n".ptr, (f.other == tag) as c_int,
		(f.view.ptr == bytes.ptr) as c_int, f.view.len as c_int);

	/* A value that its field cannot hold fails the whole text. */
	let wide = Object.deserialize("{\"type\":\"Every\",\"a\":128}", &arena);
	let negative = Object.deserialize("{\"type\":\"Every\",\"e\":-1}", &arena);
	let letters = Object.deserialize("{\"type\":\"Every\",\"letter\":\"ab\"}",
		&arena);
	let number = Object.deserialize("{\"type\":\"Every\",\"on\":1}", &arena);
	let kind = Object.deserialize("{\"type\":\"Every\",\"name\":5}", &arena);
	printf("%d %d %d %d %d\n".ptr, (wide == none) as c_int,
		(negative == none) as c_int, (letters == none) as c_int,
		(number == none) as c_int, (kind == none) as c_int);
	arena.free_all();
	delete(made);
	delete(tag);
	return 0;
}
