//! A logger reads its level, its format, its name and its sink from the file
//! that `--anti.logger` names. It drops what its level drops and writes a text
//! line and a JSON line. A file sink fails where no file opens, and `try`
//! forwards its error. A file sink opens the path it is given when that is a
//! slice of a longer text, and a path outside ASCII.
import anti.fs;
import anti.io;
import anti.json;
import anti.lang;
import anti.log;
import anti.text;

extern fn fopen(path: ?*byte, mode: ?*byte) -> ?*byte;
extern fn fclose(file: ?*byte) -> c_int;
extern fn fwrite(bytes: ?*byte, size: c_size_t, count: c_size_t,
	file: ?*byte) -> c_size_t;
extern fn fgets(into: ?*byte, size: c_int, file: ?*byte) -> ?*byte;

const CONFIG: str = "level = \"warn\"\nformat = \"text\"\nname = \"app\"\n\n[[sink]]\nkind = \"file\"\npath = \"log-test.out\"\n";

/// Print the line without the wall clock that opens it.
fn seen(line: str)
{
	if line.len != 0 && line[0] == 0x7B {
		let level = "";
		let name = "";
		let message = "";
		json.member(line, "level", &level);
		json.member(line, "name", &name);
		json.member(line, "message", &message);
		let plain = text.Builder.new();
		json.unquote(level, &plain) catch fatal;
		plain.append(" ");
		json.unquote(name, &plain) catch fatal;
		plain.append(" ");
		json.unquote(message, &plain) catch fatal;
		io.println(plain.text());
		return;
	}
	let space = text.find_byte(line, 0x20);
	io.print(text.slice(line, space + 1, line.len));
}

/// A sink that appends to `path`, forwarding the error of `FileSink.new`.
fn open_sink(path: str) -> *log.FileSink may fail
{
	let sink = try log.FileSink.new(path);
	return sink;
}

/// Whether a file sink opens at `path`.
fn opens(path: str) -> bool
{
	let sink = open_sink(path) catch e {
		return false;
	};
	delete(sink);
	return true;
}

fn write_file(path: str, what: str)
{
	let file = fopen(path.ptr, "wb".ptr);
	if file == none {
		return;
	}
	fwrite(what.ptr, 1 as c_size_t, what.len as c_size_t, file);
	fclose(file);
}

fn show_file(path: str)
{
	let file = fopen(path.ptr, "rb".ptr);
	if file == none {
		io.println("no file");
		return;
	}
	let room = alloc(byte, 512) else { return; };
	while fgets(room, 512 as c_int, file) != none do {
		seen(text.from_c(room));
	}
	fclose(file);
	free(room);
}

/// Print the bytes of the file at `path`, or the failure.
fn show_bytes(path: str)
{
	let bytes = fs.read_file(path) catch e {
		io.print(path);
		io.println(": no file");
		return;
	};
	io.print(path);
	io.print(": ");
	io.print(text.from_bytes(bytes));
	free(bytes.ptr);
}

/// Write one line through a file sink at `path`.
fn sink_line(path: str, line: str)
{
	let sink = open_sink(path) catch e {
		io.print(path);
		io.println(": the sink did not open");
		return;
	};
	sink.write(line);
	delete(sink);
}

fn main() -> int
{
	/* A slice ends where its bytes end, and no NUL follows it. */
	let both = "log-slice.out-not-this";
	let sliced = text.slice(both, 0, 13);
	fs.remove(sliced) catch ignored { };
	fs.remove(both) catch ignored { };
	sink_line(sliced, "sliced\n");
	show_bytes(sliced);
	show_bytes(both);

	let wide = "log-\u{e9}t\u{e9}.out";
	fs.remove(wide) catch ignored { };
	sink_line(wide, "wide one\n");
	sink_line(wide, "wide two\n");
	show_bytes(wide);

	write_file("log-test.toml", CONFIG);
	write_file("log-test.out", "");

	/* The first call builds the logger the file asks for. */
	log.info("dropped by the level of the file");
	log.warn("to the file");
	log.error("also to the file");
	show_file("log-test.out");

	let sink = log.CallbackSink.new(seen);
	let before = log.set(log.SinkLogger.new("test", log.Level.Info, sink))
		else { return 1; };
	delete(before);

	log.trace("dropped");
	log.debug("dropped");
	log.info("one");
	log.warn("two");

	log.logger().level = log.Level.Error;
	log.info("dropped");
	log.error("three");

	log.logger().level = log.Level.Info;
	log.logger().format = log.Format.Json;
	log.info("four");

	if log.level_of("warn", log.Level.Info) != log.Level.Warn {
		return 1;
	}
	if !text.equal(log.level_name(log.Level.Fatal), "fatal") {
		return 2;
	}
	if log.level_of("nonsense", log.Level.Debug) != log.Level.Debug {
		return 3;
	}

	/* No file opens in a directory that is not there. */
	if !opens("log-test.out") {
		return 4;
	}
	if opens("log-test-missing/log-test.out") {
		return 5;
	}
	return 0;
}
