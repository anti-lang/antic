//! A sleep and the route of signals when the system refuses a call. A sleep
//! that a signal cuts short sleeps the rest. A registration whose pipe or
//! thread the system refuses catches nothing, and the next one starts the route
//! afresh, so the signal raised after the second arrives. Memory that runs out
//! for the thread stops the program. A case of `faults_os.faults` refuses one
//! call, through the variable `ANTI_FAULT` of `src/rt/fault.h`.
import anti.io;
import anti.os;
import anti.time;

extern fn raise(sig: c_int) -> c_int;

singleton class Seen
{
	atomic count: int = 0,
}

fn caught(sig: int)
{
	Seen.get().count.add(sig);
}

fn main() -> int
{
	time.sleep(time.milliseconds(1));
	io.println("slept");
	os.on_signal(os.INTERRUPT, caught);
	os.on_signal(os.INTERRUPT, caught);
	raise(os.INTERRUPT as c_int);
	/* The runtime reads the pipe on a thread, so the program waits for
	   the count to change. */
	let spins = 0;
	while Seen.get().count.load() == 0 && spins < 100000000 do {
		spins += 1;
	}
	if Seen.get().count.load() != os.INTERRUPT {
		return 1;
	}
	io.println("caught");
	return 0;
}
