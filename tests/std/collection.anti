//! A list and two maps hold pointers to objects, which the program owns and
//! deletes. The generic collections hold a `*Item` as any other value and never
//! the object it points to, so nothing is cast back.
import anti.collection.list.{List};
import anti.collection.map.{HashMap, Map};
import anti.io;

extern fn printf(fmt: ?*byte, ...) -> c_int;

class Item
{
	pub n: int = 0,
}

fn main() -> int
{
	let list = List<*Item>.new();
	let i = 0;
	while i < 100 do {
		list.push(alloc Item { n: i });
		i += 1;
	}
	if list.count != 100 {
		return 1;
	}
	let third = list.get(3) else { return 2; };
	if third.n != 3 {
		return 2;
	}
	if list.get(100) != none {
		return 3;
	}
	let last = list.pop() else { return 4; };
	if last.n != 99 || list.count != 99 {
		return 4;
	}

	let map = Map<str, *Item>.new();
	map.set("one", list[1]);
	map.set("two", list[2]);
	map.set("one", list[5]);
	if map.count != 2 {
		return 5;
	}
	let under = map.get("one") else { return 6; };
	if under.n != 5 {
		return 6;
	}
	if map.contains("three") {
		return 7;
	}

	let numbers = HashMap<int, *Item>.new();
	i = 0;
	while i < 50 do {
		numbers.set(i * 7, list[i]);
		i += 1;
	}
	if numbers.count != 50 {
		return 8;
	}
	let found = numbers.get(21) else { return 9; };
	if found.n != 3 {
		return 9;
	}
	if numbers.get(22) != none {
		return 10;
	}

	printf("%d %d %d\n".ptr, list.count as c_int, map.count as c_int,
		numbers.count as c_int);
	for item in list {
		delete(item);
	}
	delete(last);
	io.println("done");
	return 0;
}
