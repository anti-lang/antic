//! Patterns when memory runs out. A compiled pattern keeps its text, a search
//! takes the match data of PCRE2, and `replace` grows the text it gives, as the
//! walks of `find_all` and `split` take match data of their own. The compile of
//! a byte pattern writes the pattern PCRE2 reads and a map of its bytes, and
//! the first failure of a code of PCRE2 keeps the text of its message. Memory
//! that runs out for any of them stops the program, by decision 4 of "Decisions
//! of 2026-10-11". A case of `faults_regex.faults` refuses one allocation,
//! through the variable `ANTI_FAULT` of `src/rt/fault.h`.
import anti.io;
import anti.lang;
import anti.regex;

fn main() -> int
{
	let r = regex.compile("[0-9]+") catch e {
		io.println(e.message);
		return 1;
	};
	let found = regex.matched("a1b22c333", r) catch e {
		io.println(e.message);
		return 1;
	};
	if found {
		io.println("matched");
	}
	let replaced = regex.replace("a1b22c333", r, "#") catch e {
		io.println(e.message);
		return 1;
	};
	io.println(replaced);
	free(replaced.ptr);
	let all = regex.find_all("a1b22c333", r) catch e {
		io.println(e.message);
		return 1;
	};
	for m in all {
		io.println(regex.group(m, 0));
	}
	let parts = regex.split("a1b22c333", r) catch e {
		io.println(e.message);
		return 1;
	};
	for p in parts {
		io.println(p);
	}
	let b = regex.compile_bytes("[0-9]+") catch e {
		io.println(e.message);
		return 1;
	};
	io.println("compiled bytes");
	let bad = regex.compile("(") catch e {
		io.println(e.message);
		return 0;
	};
	return 1;
}
