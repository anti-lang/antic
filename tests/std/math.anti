{
	let b = text.Builder.new();
	b.append(name);
	b.append(" f64");
	b.append(" ");
	b.append_float(x);
	b.append(" ");
	b.append_float(y);
	b.append(" = ");
	b.append_float(r);
	io.println(b.text());
}

