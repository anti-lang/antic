	let x_max_2: f64 = 0.0;
	let y_max_2: f64 = -0.0;
	two_f64_line("max", x_max_2, y_max_2, math.max(x_max_2, y_max_2));
	let x_max_3: f64 = nan_f64();
	let y_max_3: f64 = 1.0;
	two_f64_line("max", x_max_3, y_max_3, math.max(x_max_3, y_max_3));
	let x_max_4: f64 = 1.0;
	let y_max_4: f64 = nan_f64();
	two_f64_line("max", x_max_4, y_max_4, math.max(x_max_4, y_max_4));
	let x_max_5: f64 = nan_f64();
	let y_max_5: f64 = nan_f64();
	two_f64_line("max", x_max_5, y_max_5, math.max(x_max_5, y_max_5));
	let x_copysign_0: f64 = 3.0;
	let y_copysign_0: f64 = -1.0;
	two_f64_line("copysign", x_copysign_0, y_copysign_0, math.copysign(x_copysign_0, y_copysign_0));
	let x_copysign_1: f64 = -3.0;
	let y_copysign_1: f64 = 0.0;
	two_f64_line("copysign", x_copysign_1, y_copysign_1, math.copysign(x_copysign_1, y_copysign_1));
	let x_copysign_2: f64 = 2.0;
	let y_copysign_2: f64 = -0.0;
	two_f64_line("copysign", x_copysign_2, y_copysign_2, math.copysign(x_copysign_2, y_copysign_2));
	let x_copysign_3: f64 = inf_f64();
	let y_copysign_3: f64 = -1.0;
	two_f64_line("copysign", x_copysign_3, y_copysign_3, math.copysign(x_copysign_3, y_copysign_3));
}

fn three_f64()
{
	let p_clamp_0: f64 = 5.0;
	let q_clamp_0: f64 = 0.0;
	let r_clamp_0: f64 = 1.0;
	three_f64_line("clamp", p_clamp_0, q_clamp_0, r_clamp_0, math.clamp(p_clamp_0, q_clamp_0, r_clamp_0));
	let p_clamp_1: f64 = -5.0;
	let q_clamp_1: f64 = 0.0;
	let r_clamp_1: f64 = 1.0;
	three_f64_line("clamp", p_clamp_1, q_clamp_1, r_clamp_1, math.clamp(p_clamp_1, q_clamp_1, r_clamp_1));
	let p_clamp_2: f64 = 0.25;
	let q_clamp_2: f64 = 0.0;
	let r_clamp_2: f64 = 1.0;
	three_f64_line("clamp", p_clamp_2, q_clamp_2, r_clamp_2, math.clamp(p_clamp_2, q_clamp_2, r_clamp_2));
	let p_lerp_0: f64 = 0.0;
	let q_lerp_0: f64 = 10.0;
	let r_lerp_0: f64 = 0.25;
	three_f64_line("lerp", p_lerp_0, q_lerp_0, r_lerp_0, math.lerp(p_lerp_0, q_lerp_0, r_lerp_0));
	let p_lerp_1: f64 = -1.0;
	let q_lerp_1: f64 = 1.0;
	let r_lerp_1: f64 = 0.5;
	three_f64_line("lerp", p_lerp_1, q_lerp_1, r_lerp_1, math.lerp(p_lerp_1, q_lerp_1, r_lerp_1));
	let p_lerp_2: f64 = 2.0;
	let q_lerp_2: f64 = 4.0;
	let r_lerp_2: f64 = 1.5;
	three_f64_line("lerp", p_lerp_2, q_lerp_2, r_lerp_2, math.lerp(p_lerp_2, q_lerp_2, r_lerp_2));
	let p_normalize_0: f64 = 5.0;
	let q_normalize_0: f64 = 0.0;
	let r_normalize_0: f64 = 10.0;
	three_f64_line("normalize", p_normalize_0, q_normalize_0, r_normalize_0, math.normalize(p_normalize_0, q_normalize_0, r_normalize_0));
	let p_normalize_1: f64 = 15.0;
	let q_normalize_1: f64 = 10.0;
	let r_normalize_1: f64 = 20.0;
	three_f64_line("normalize", p_normalize_1, q_normalize_1, r_normalize_1, math.normalize(p_normalize_1, q_normalize_1, r_normalize_1));
	let p_normalize_2: f64 = 0.0;
	let q_normalize_2: f64 = 1.0;
	let r_normalize_2: f64 = 3.0;
	three_f64_line("normalize", p_normalize_2, q_normalize_2, r_normalize_2, math.normalize(p_normalize_2, q_normalize_2, r_normalize_2));
	let p_wrap_0: f64 = 7.5;
	let q_wrap_0: f64 = 0.0;
	let r_wrap_0: f64 = 5.0;
	three_f64_line("wrap", p_wrap_0, q_wrap_0, r_wrap_0, math.wrap(p_wrap_0, q_wrap_0, r_wrap_0));
	let p_wrap_1: f64 = -1.0;
	let q_wrap_1: f64 = 0.0;
	let r_wrap_1: f64 = 5.0;
	three_f64_line("wrap", p_wrap_1, q_wrap_1, r_wrap_1, math.wrap(p_wrap_1, q_wrap_1, r_wrap_1));
	let p_wrap_2: f64 = 370.0;
	let q_wrap_2: f64 = 0.0;
	let r_wrap_2: f64 = 360.0;
	three_f64_line("wrap", p_wrap_2, q_wrap_2, r_wrap_2, math.wrap(p_wrap_2, q_wrap_2, r_wrap_2));
	let m_0: f64 = 5.0;
	let m_1: f64 = 0.0;
	let m_2: f64 = 10.0;
	let m_3: f64 = -1.0;
	let m_4: f64 = 1.0;
	three_f64_line("remap of 0 to 10 onto", m_3, m_4, m_0, math.remap(m_0, m_1, m_2, m_3, m_4));
	let b_is_nan_0: f64 = nan_f64();
	bool_f64_line("is_nan", b_is_nan_0, math.is_nan(b_is_nan_0));
	let b_is_nan_1: f64 = inf_f64();
	bool_f64_line("is_nan", b_is_nan_1, math.is_nan(b_is_nan_1));
	let b_is_nan_2: f64 = 1.0;
	bool_f64_line("is_nan", b_is_nan_2, math.is_nan(b_is_nan_2));
	let b_is_nan_3: f64 = -0.0;
	bool_f64_line("is_nan", b_is_nan_3, math.is_nan(b_is_nan_3));
	let b_is_inf_0: f64 = nan_f64();
	bool_f64_line("is_inf", b_is_inf_0, math.is_inf(b_is_inf_0));
	let b_is_inf_1: f64 = inf_f64();
	bool_f64_line("is_inf", b_is_inf_1, math.is_inf(b_is_inf_1));
	let b_is_inf_2: f64 = -inf_f64();
	bool_f64_line("is_inf", b_is_inf_2, math.is_inf(b_is_inf_2));
	let b_is_inf_3: f64 = 1.0;
	bool_f64_line("is_inf", b_is_inf_3, math.is_inf(b_is_inf_3));
}

fn main() -> int
{
	one_f32();
	two_f32();
	three_f32();
	one_f64();
	two_f64();
	three_f64();
	one_f32_line("PI and TAU", math.PI, math.TAU);
	one_f32_line("E", math.E, math.E);
	one_f32_line("DEG2RAD and RAD2DEG", math.DEG2RAD, math.RAD2DEG);
	one_f64_line("PI_F64 and TAU_F64", math.PI_F64, math.TAU_F64);
	one_f64_line("E_F64", math.E_F64, math.E_F64);
	one_f64_line("DEG2RAD_F64 and RAD2DEG_F64", math.DEG2RAD_F64,
		math.RAD2DEG_F64);
	let widened = math.PI as f64;
	let wider = math.PI_F64 != widened;
	let line = f"PI_F64 holds more digits than PI {wider}";
	io.println(line);
	free(line.ptr);
	return 0;
}
