//! Every function of anti.math on f32 and on f64, with the reference values of
//! the libm of musl that the runtime carries. Each line names the function, its
//! arguments and its result, in the fewest digits that read back as the same
//! value. The run on macos-x86_64 at v1 under Rosetta compares with the same
//! file, so both processors give the same bits. A NaN prints as `nan`, whose
//! sign follows the processor.
import anti.io;
import anti.math;
import anti.text;

fn zero_f32(n: int) -> f32
{
	return (n - n) as f32;
}

fn zero_f64(n: int) -> f64
{
	return (n - n) as f64;
}

fn inf_f32() -> f32
{
	return 1.0 / zero_f32(3);
}

fn nan_f32() -> f32
{
	return zero_f32(3) / zero_f32(3);
}

fn one_f32_line(name: str, x: f32, r: f32)
{
	let b = text.Builder.new();
	b.append(name);
	b.append(" f32");
	b.append(" ");
	b.append_f32(x);
	b.append(" = ");
	b.append_f32(r);
	io.println(b.text());
}

fn two_f32_line(name: str, x: f32, y: f32, r: f32)
{
	let b = text.Builder.new();
	b.append(name);
	b.append(" f32");
	b.append(" ");
	b.append_f32(x);
	b.append(" ");
	b.append_f32(y);
	b.append(" = ");
	b.append_f32(r);
	io.println(b.text());
}

fn three_f32_line(name: str, x: f32, y: f32, z: f32, r: f32)
{
	let b = text.Builder.new();
	b.append(name);
	b.append(" f32");
	b.append(" ");
	b.append_f32(x);
	b.append(" ");
	b.append_f32(y);
	b.append(" ");
	b.append_f32(z);
	b.append(" = ");
	b.append_f32(r);
	io.println(b.text());
}

fn bool_f32_line(name: str, x: f32, r: bool)
{
	let b = text.Builder.new();
	b.append(name);
	b.append(" f32 ");
	b.append_f32(x);
	b.append(" = ");
	b.append_bool(r);
	io.println(b.text());
}

fn inf_f64() -> f64
{
	return 1.0 / zero_f64(3);
}

fn nan_f64() -> f64
{
	return zero_f64(3) / zero_f64(3);
}

fn one_f64_line(name: str, x: f64, r: f64)
{
	let b = text.Builder.new();
	b.append(name);
	b.append(" f64");
	b.append(" ");
	b.append_float(x);
	b.append(" = ");
	b.append_float(r);
	io.println(b.text());
}

