	let x_min_2: f64 = 0.0;
	let y_min_2: f64 = -0.0;
	two_f64_line("min", x_min_2, y_min_2, math.min(x_min_2, y_min_2));
	let x_min_3: f64 = nan_f64();
	let y_min_3: f64 = 1.0;
	two_f64_line("min", x_min_3, y_min_3, math.min(x_min_3, y_min_3));
	let x_min_4: f64 = 1.0;
	let y_min_4: f64 = nan_f64();
	two_f64_line("min", x_min_4, y_min_4, math.min(x_min_4, y_min_4));
	let x_min_5: f64 = nan_f64();
