fn two_f32()
{
	let x_atan2_0: f32 = 1.0;
	let y_atan2_0: f32 = 1.0;
	two_f32_line("atan2", x_atan2_0, y_atan2_0, math.atan2(x_atan2_0, y_atan2_0));
	let x_atan2_1: f32 = 1.0;
	let y_atan2_1: f32 = -1.0;
	two_f32_line("atan2", x_atan2_1, y_atan2_1, math.atan2(x_atan2_1, y_atan2_1));
	let x_atan2_2: f32 = -0.0;
	let y_atan2_2: f32 = -1.0;
	two_f32_line("atan2", x_atan2_2, y_atan2_2, math.atan2(x_atan2_2, y_atan2_2));
	let x_atan2_3: f32 = 0.0;
	let y_atan2_3: f32 = 0.0;
	two_f32_line("atan2", x_atan2_3, y_atan2_3, math.atan2(x_atan2_3, y_atan2_3));
	let x_atan2_4: f32 = -1.0;
	let y_atan2_4: f32 = 0.0;
	two_f32_line("atan2", x_atan2_4, y_atan2_4, math.atan2(x_atan2_4, y_atan2_4));
	let x_pow_0: f32 = 2.0;
	let y_pow_0: f32 = 10.0;
	two_f32_line("pow", x_pow_0, y_pow_0, math.pow(x_pow_0, y_pow_0));
	let x_pow_1: f32 = 2.0;
	let y_pow_1: f32 = 0.5;
	two_f32_line("pow", x_pow_1, y_pow_1, math.pow(x_pow_1, y_pow_1));
	let x_pow_2: f32 = -8.0;
	let y_pow_2: f32 = 0.3333333333333333;
	two_f32_line("pow", x_pow_2, y_pow_2, math.pow(x_pow_2, y_pow_2));
	let x_pow_3: f32 = 0.0;
	let y_pow_3: f32 = -1.0;
	two_f32_line("pow", x_pow_3, y_pow_3, math.pow(x_pow_3, y_pow_3));
	let x_pow_4: f32 = 1.0;
	let y_pow_4: f32 = nan_f32();
	two_f32_line("pow", x_pow_4, y_pow_4, math.pow(x_pow_4, y_pow_4));
	let x_pow_5: f32 = 10.0;
	let y_pow_5: f32 = 400.0;
	two_f32_line("pow", x_pow_5, y_pow_5, math.pow(x_pow_5, y_pow_5));
	let x_hypot_0: f32 = 3.0;
	let y_hypot_0: f32 = 4.0;
	two_f32_line("hypot", x_hypot_0, y_hypot_0, math.hypot(x_hypot_0, y_hypot_0));
	let x_hypot_1: f32 = 1.0e30;
	let y_hypot_1: f32 = 1.0e30;
	two_f32_line("hypot", x_hypot_1, y_hypot_1, math.hypot(x_hypot_1, y_hypot_1));
	let x_hypot_2: f32 = inf_f32();
	let y_hypot_2: f32 = nan_f32();
	two_f32_line("hypot", x_hypot_2, y_hypot_2, math.hypot(x_hypot_2, y_hypot_2));
	let x_hypot_3: f32 = -5.0;
