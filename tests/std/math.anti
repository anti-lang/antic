	let x_pow_0: f64 = 2.0;
	let y_pow_0: f64 = 10.0;
	two_f64_line("pow", x_pow_0, y_pow_0, math.pow(x_pow_0, y_pow_0));
	let x_pow_1: f64 = 2.0;
	let y_pow_1: f64 = 0.5;
	two_f64_line("pow", x_pow_1, y_pow_1, math.pow(x_pow_1, y_pow_1));
	let x_pow_2: f64 = -8.0;
	let y_pow_2: f64 = 0.3333333333333333;
	two_f64_line("pow", x_pow_2, y_pow_2, math.pow(x_pow_2, y_pow_2));
	let x_pow_3: f64 = 0.0;
	let y_pow_3: f64 = -1.0;
	two_f64_line("pow", x_pow_3, y_pow_3, math.pow(x_pow_3, y_pow_3));
	let x_pow_4: f64 = 1.0;
	let y_pow_4: f64 = nan_f64();
	two_f64_line("pow", x_pow_4, y_pow_4, math.pow(x_pow_4, y_pow_4));
	let x_pow_5: f64 = 10.0;
	let y_pow_5: f64 = 400.0;
	two_f64_line("pow", x_pow_5, y_pow_5, math.pow(x_pow_5, y_pow_5));
	let x_hypot_0: f64 = 3.0;
	let y_hypot_0: f64 = 4.0;
	two_f64_line("hypot", x_hypot_0, y_hypot_0, math.hypot(x_hypot_0, y_hypot_0));
	let x_hypot_1: f64 = 1.0e30;
	let y_hypot_1: f64 = 1.0e30;
	two_f64_line("hypot", x_hypot_1, y_hypot_1, math.hypot(x_hypot_1, y_hypot_1));
	let x_hypot_2: f64 = inf_f64();
	let y_hypot_2: f64 = nan_f64();
	two_f64_line("hypot", x_hypot_2, y_hypot_2, math.hypot(x_hypot_2, y_hypot_2));
	let x_hypot_3: f64 = -5.0;
	let y_hypot_3: f64 = 12.0;
	two_f64_line("hypot", x_hypot_3, y_hypot_3, math.hypot(x_hypot_3, y_hypot_3));
	let x_fmod_0: f64 = 7.0;
	let y_fmod_0: f64 = 3.0;
	two_f64_line("fmod", x_fmod_0, y_fmod_0, math.fmod(x_fmod_0, y_fmod_0));
	let x_fmod_1: f64 = -7.0;
	let y_fmod_1: f64 = 3.0;
	two_f64_line("fmod", x_fmod_1, y_fmod_1, math.fmod(x_fmod_1, y_fmod_1));
	let x_fmod_2: f64 = 7.0;
	let y_fmod_2: f64 = -3.0;
	two_f64_line("fmod", x_fmod_2, y_fmod_2, math.fmod(x_fmod_2, y_fmod_2));
	let x_fmod_3: f64 = 5.5;
	let y_fmod_3: f64 = 2.0;
	two_f64_line("fmod", x_fmod_3, y_fmod_3, math.fmod(x_fmod_3, y_fmod_3));
	let x_fmod_4: f64 = 1.0;
	let y_fmod_4: f64 = 0.0;
	two_f64_line("fmod", x_fmod_4, y_fmod_4, math.fmod(x_fmod_4, y_fmod_4));
	let x_min_0: f64 = 1.0;
	let y_min_0: f64 = 2.0;
