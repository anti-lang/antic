//! `reflect.call` calls a public function through the table of the
//! object's class. The arguments and the result are `Value`s, and the
//! compiler writes one trampoline per signature of the program. A call
//! that cannot be made gives an error whose code names the reason, and
//! kind `None` means only that the function has no result. `try`
//! forwards the error of a call.
import anti.lang;
import anti.reflect;

extern fn printf(fmt: ?*byte, ...) -> c_int;

abstract class Shape
{
	abstract fn area(self) -> int;

	pub fn label(self, by: i32, text: str) -> str
	{
		if by > 0 {
			return text;
		}
		return "none";
	}
}

class Square inherits Shape
{
	pub side: int = 3,

	concrete fn area(self) -> int
	{
		return self.side * self.side;
	}

	pub fn grow(self, by: u8, factor: f32) -> f64
	{
		self.side = self.side + by as int;
		return self.side as f64 * factor as f64;
	}

	pub fn flip(self, on: bool) -> bool
	{
		return !on;
	}

	pub fn same(self, c: char) -> char
	{
		return c;
	}

	pub fn me(self) -> *Square
	{
		return self;
	}

	pub fn small(self, n: i8) -> u16
	{
		return (n as int + 300) as u16;
	}

	pub fn reset(self)
	{
		self.side = 1;
	}

	pub fn total(self, parts: []int) -> int
	{
		return parts.len;
	}
}

/// The result of the function at `index` of `o`, forwarding the error of
/// `reflect.call`.
fn called(o: *Object, index: int, args: []reflect.Value)
	-> reflect.Value may fail
{
	return try reflect.call(o, index, args);
}

fn main() -> int
{
	let s = alloc Square { };
	let o: *Object = s;
	let no_args = []reflect.Value { ptr: none, len: 0 };

	/* The seven functions of the root and its nine hooks come first,
	   then the chain's. */
	let area = reflect.call(o, 16, no_args) catch fatal;
	printf("%d %d\n".ptr, area.kind as c_int, area.data.i as c_int);

	let label_args = [reflect.of_int(1), reflect.of_str("tag")];
	let label = reflect.call(o, 17, label_args[0..2]) catch fatal;
	printf("%d %.*s\n".ptr, label.kind as c_int, label.data.s.len as c_int,
		label.data.s.ptr);

	let grow_args = [reflect.of_uint(2), reflect.of_float(1.5)];
	let grown = reflect.call(o, 18, grow_args[0..2]) catch fatal;
	printf("%d %.2f %d\n".ptr, grown.kind as c_int, grown.data.f,
		s.side as c_int);

	let flip_args = [reflect.of_bool(true)];
	let flipped = reflect.call(o, 19, flip_args[0..1]) catch fatal;
	printf("%d %d\n".ptr, flipped.kind as c_int, flipped.data.b as c_int);

	let char_args = [reflect.of_char('z')];
	let same = reflect.call(o, 20, char_args[0..1]) catch fatal;
	printf("%d %d\n".ptr, same.kind as c_int, same.data.c as u32 as c_int);

	let me = reflect.call(o, 21, no_args) catch fatal;
	printf("%d %d\n".ptr, me.kind as c_int, (me.data.p == s as *byte) as c_int);

	let small_args = [reflect.of_int(-1)];
	let small = reflect.call(o, 22, small_args[0..1]) catch fatal;
	printf("%d %d\n".ptr, small.kind as c_int, small.data.u as c_int);

	let reset = reflect.call(o, 23, no_args) catch fatal;
	printf("%d %d\n".ptr, reset.kind as c_int, s.side as c_int);

	/* A root function goes through the table like any other. */
	let name = reflect.call(o, 0, no_args) catch fatal;
	printf("%.*s\n".ptr, name.data.s.len as c_int, name.data.s.ptr);

	/* A count, a kind or an index that does not fit, and a signature
	   that no Value carries, give an error that names the reason. */
	let wrong_kind = [reflect.of_int(2), reflect.of_float(1.5)];
	let count = reflect.call(o, 16, flip_args[0..1]) catch e {
		printf("%d %.*s\n".ptr, (e.code == reflect.WRONG_COUNT) as c_int,
			e.message.len as c_int, e.message.ptr);
		yield reflect.nothing();
	};
	let kind = reflect.call(o, 18, wrong_kind[0..2]) catch e {
		printf("%d %.*s\n".ptr, (e.code == reflect.WRONG_KIND) as c_int,
			e.message.len as c_int, e.message.ptr);
		yield reflect.nothing();
	};
	let high = reflect.call(o, 99, no_args) catch e {
		printf("%d %.*s\n".ptr, (e.code == reflect.BAD_INDEX) as c_int,
			e.message.len as c_int, e.message.ptr);
		yield reflect.nothing();
	};
	let low = reflect.call(o, -1, no_args) catch e {
		printf("%d\n".ptr, (e.code == reflect.BAD_INDEX) as c_int);
		yield reflect.nothing();
	};
	let slices = reflect.call(o, 24, no_args) catch e {
		printf("%d %.*s\n".ptr, (e.code == reflect.NOT_CARRIED) as c_int,
			e.message.len as c_int, e.message.ptr);
		yield reflect.nothing();
	};
	if count.kind != reflect.ValueKind.None ||
		kind.kind != reflect.ValueKind.None ||
		high.kind != reflect.ValueKind.None ||
		low.kind != reflect.ValueKind.None ||
		slices.kind != reflect.ValueKind.None {
		return 1;
	}

	let through = called(o, 16, no_args) catch fatal;
	printf("%d %d\n".ptr, through.kind as c_int, through.data.i as c_int);
	let lost = called(o, 99, no_args) catch e {
		printf("%d\n".ptr, (e.code == reflect.BAD_INDEX) as c_int);
		yield reflect.nothing();
	};
	if lost.kind != reflect.ValueKind.None {
		return 2;
	}
	delete(s);
	return 0;
}
