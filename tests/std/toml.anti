//! A document of the TOML subset gives its keys in order and finds a value
//! under a dotted path. It numbers the entries of a repeated table, and a
//! value that is no integer gives the fallback of `int_of`. `try`
//! forwards the error of `read`.
import anti.io;
import anti.lang;
import anti.toml;

const SOURCE: str = "# a comment\nname = \"antic\"\nthreads = 4\nquiet = false\n\n[limits]\ndepth = 32\n\n[[sink]]\nkind = \"stderr\"\n\n[[sink]]\nkind = \"file\"\npath = \"/tmp/anti.log\"\n";

/// The depth of the limits `source` names, forwarding the error of
/// `read`.
fn depth_of(source: str) -> int may fail
{
	let doc = try toml.Document.read(source);
	return doc.int_of("limits.depth", 0);
}

fn main() -> int
{
	let doc = toml.Document.read(SOURCE) catch fatal;

	let i = 0;
	while i < doc.len() do {
		io.print(doc.key(i));
		io.print(" = ");
		io.println(doc.value(i));
		i += 1;
	}

	io.println(doc.text_of("sink.1.path", "none"));
	io.println(doc.text_of("sink.2.path", "none"));
	if doc.int_of("limits.depth", 0) != 32 {
		return 2;
	}
	if doc.int_of("missing", 7) != 7 || doc.int_of("name", 5) != 5 {
		return 3;
	}
	if doc.bool_of("quiet", true) {
		return 4;
	}
	if !doc.has("name") {
		return 5;
	}
	if doc.line(1) != 3 {
		return 6;
	}
	let depth = depth_of(SOURCE) catch fatal;
	if depth != 32 {
		return 8;
	}
	let lost = depth_of("[limits\n") catch e {
		io.println(e.message);
		yield -1;
	};
	if lost != -1 {
		return 9;
	}

	let bad = toml.Document.read("name\n") catch e {
		io.println(e.message);
		return 0;
	};
	return 7;
}
