//! `plugin.load` refuses a path of 4096 bytes, one more than the longest it
//! takes, and names the bound in its message.

import anti.io;
import anti.plugin;
import anti.text;

fn main() -> int
{
	let bytes: [4096]byte = [97; 4096];
	let lib = plugin.load(text.from_bytes(bytes[0..4096])) catch e {
		io.print(e.message);
		io.print("\n");
		return 0;
	};
	delete(lib);
	return 1;
}
