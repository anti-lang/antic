//! Texts the TOML reader refuses at the edges of its subset: a table name past
//! its room, a key without a name, an inline table and an array that the text
//! ends inside, an array of arrays, two strings without a comma between them and
//! a table name and a key whose path does not fit. Each line prints the number
//! of pairs of the document, or the message of the refusal.
import anti.io;
import anti.json;
import anti.text;
import anti.toml;

/// Read source and print what came of it.
fn read(source: str)
{
	let doc = toml.Document.read(source) catch e {
		io.println(e.message);
		return;
	};
	let b = text.Builder.new();
	b.append("pairs ");
	json.write_int(doc.len(), &b);
	io.println(b.text());
}

/// `n` copies of the byte `c`.
fn run(c: str, n: int) -> str
{
	let b = text.Builder.new();
	let i = 0;
	while i < n do {
		b.append(c);
		i += 1;
	}
	return b.take();
}

fn main() -> int
{
	let name = run("t", 231);
	let longer = run("t", 232);
	let b = text.Builder.new();
	b.append("[");
	b.append(name);
	b.append("]\nk = 1\n");
	read(b.text());
	b.clear();
	b.append("[");
	b.append(longer);
	b.append("]\nk = 1\n");
	read(b.text());
	read("= 1\n");
	read("a = { b = 1,");
	read("a = [");
	read("a = [[1]]\n");
	read("a = [\"x\" \"y\"]\n");
	let key = run("k", 140);
	b.clear();
	b.append("[");
	b.append(text.slice(name, 0, 180));
	b.append("]\n");
	b.append(key);
	b.append(" = 1\n");
	read(b.text());
	free(name.ptr);
	free(longer.ptr);
	free(key.ptr);
	return 0;
}
