//! Inline tables at the edges of the TOML subset: one inside another, which the
//! reader takes, the same with a pair without a value, an array whose element
//! is an inline table with a pair without a value, and a pair of an inline
//! table whose path fits and one whose path does not. Each line prints the
//! number of pairs of the document, or the message of the refusal.
import anti.io;
import anti.json;
import anti.text;
import anti.toml;

/// Read source and print what came of it.
fn read(source: str)
{
	let doc = toml.Document.read(source) catch e {
		io.println(e.message);
		return;
	};
	let b = text.Builder.new();
	b.append("pairs ");
	json.write_int(doc.len(), &b);
	io.println(b.text());
}

/// `n` copies of the byte `c`.
fn run(c: str, n: int) -> str
{
	let b = text.Builder.new();
	let i = 0;
	while i < n do {
		b.append(c);
		i += 1;
	}
	return b.take();
}

fn main() -> int
{
	read("a = { b = { c = 1 } }\n");
	read("a = { b = { c = } }\n");
	read("a = [{ c = }]\n");
	let name = run("t", 180);
	let key = run("k", 136);
	let b = text.Builder.new();
	b.append("[");
	b.append(name);
	b.append("]\n");
	b.append(key);
	b.append(" = { b = 1 }\n");
	read(b.text());
	b.clear();
	b.append("[");
	b.append(name);
	b.append("]\n");
	b.append(key);
	b.append(" = { bbbb = 1 }\n");
	read(b.text());
	free(name.ptr);
	free(key.ptr);
	return 0;
}
