//! The error convention: a failing function returns `*Error`, and every
//! call of one handles the error. `catch` handles it at the call, `try`
//! hands it to the caller, and a `try` block gives one handler to a
//! whole block.
import anti.error;
import anti.io;
import anti.text;

extern fn fopen(path: *byte, mode: *byte) -> *byte;

fn open_missing(path: str) -> *error.Error
{
	if fopen(path.ptr, "r".ptr) == null {
		return error.Error.from_errno();
	}
	return null;
}

fn read_config() -> *error.Error
{
	try open_missing("/nonexistent/anti/config.toml");
	return null;
}

fn size_of_file(path: str, out: *int) -> *error.Error
{
	if fopen(path.ptr, "r".ptr) == null {
		*out = 0;
		return error.Error.new(7, "no such file");
	}
	*out = 1;
	return null;
}

fn main() -> int
{
	error.check(null);

	let size = size_of_file("/nonexistent/anti/size") catch e {
		if e.code != 7 {
			return 2;
		}
		yield 42;
	};
	if size != 42 {
		return 3;
	}

	read_config() catch e {
		e.print();
	};

	try {
		open_missing("/nonexistent/anti/one");
		io.println("not reached");
	} catch e {
		io.println("block caught");
	}

	/* Windows gives the Win32 error of the fopen that failed last, a
	   path that does not exist, and every other system gives none. The
	   two expected files hold the two lines. */
	if fopen("/nonexistent/anti/win32".ptr, "r".ptr) != null {
		return 5;
	}
	let w = error.Error.from_win32();
	if w.code == 0 && text.byte_count(w.message) == 0 {
		io.println("no win32 error");
	} else if w.code == 3 && text.byte_count(w.message) > 0 {
		io.println("win32 error 3");
	} else {
		return 4;
	}
	delete(w);
	io.println("done");
	return 0;
}
