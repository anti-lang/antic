//! The error convention: a function that can fail is declared `may fail`, and
//! every call of one handles the error. `catch` handles it at the call, `try`
//! hands it to the caller, and a `try` block gives one handler to a whole
//! block. `fail "text";` builds an `Error` with code 0.
//!
//! `Error` lives in `anti.lang`. `anti.error` adds `SystemError`, the error of
//! a failing system call, and `check` for a hand-written result.
import anti.error;
import anti.io;
import anti.lang;
import anti.text;

extern fn fopen(path: ?*byte, mode: ?*byte) -> ?*byte;

fn open_missing(path: str) may fail
{
	if fopen(path.ptr, "r".ptr) == none {
		fail error.SystemError.from_errno();
	}
}

fn read_config() may fail
{
	try open_missing("/nonexistent/anti/config.toml");
}

fn size_of_file(path: str) -> int may fail
{
	if fopen(path.ptr, "r".ptr) == none {
		fail lang.Error.new(7, "no such file");
	}
	return 1;
}

/// A failing function whose result is itself a `?*T`.
///
/// Its `catch` handles the error of the call, not the pointer, and the handler
/// yields a pointer of the same type.
fn first_line(path: str) -> ?*byte may fail
{
	let file = fopen(path.ptr, "r".ptr);
	if file == none {
		fail lang.Error.new(8, "no such file");
	}
	return file;
}

/// A failing function with two answers, which it returns as a tuple.
fn divide(a: int, b: int) -> (int, int) may fail
{
	if b == 0 {
		fail "division by zero";
	}
	return (a / b, a % b);
}

fn main() -> int
{
	error.check(none);

	let handle = first_line("/nonexistent/anti/line") catch e {
		if e.code != 8 {
			return 4;
		}
		yield none;
	};
	if handle != none {
		return 5;
	}

	let size = size_of_file("/nonexistent/anti/size") catch e {
		if e.code != 7 {
			return 2;
		}
		yield 42;
	};
	if size != 42 {
		return 3;
	}

	let (q, r) = divide(7, 2) catch fatal;
	if q != 3 || r != 1 {
		return 6;
	}
	let (z, w) = divide(7, 0) catch e {
		if e.code != 0 {
			return 7;
		}
		io.println(e.message);
		yield (-1, -1);
	};
	if z != -1 || w != -1 {
		return 8;
	}

	read_config() catch e {
		if !(e is *error.SystemError) {
			return 9;
		}
		e.print();
	};

	/* A copy of an error from another module leaves the text of the
	   original alone, so both are deleted once each. */
	if fopen("/nonexistent/anti/copy".ptr, "r".ptr) != none {
		return 10;
	}
	let s = error.SystemError.from_errno();
	let said = s.text();
	let copy = dup(s);
	if copy.errno != s.errno || copy.code != s.errno ||
		!text.equal(copy.text(), said) || copy.text().ptr == said.ptr {
		return 11;
	}
	delete(copy);
	delete(s);

	try {
		open_missing("/nonexistent/anti/one");
		io.println("not reached");
	} catch e {
		io.println("block caught");
	}

	/* Windows gives the Win32 error of the fopen that failed last, a
	   path that does not exist, and every other system gives none. The
	   two expected files hold the two lines. */
	if fopen("/nonexistent/anti/win32".ptr, "r".ptr) != none {
		return 5;
	}
	let v = error.SystemError.from_win32();
	if v.errno != v.code {
		return 12;
	}
	if v.code == 0 && text.byte_count(v.message) == 0 {
		io.println("no win32 error");
	} else if v.code == 3 && text.byte_count(v.message) > 0 {
		io.println("win32 error 3");
	} else {
		return 4;
	}
	delete(v);
	io.println("done");
	return 0;
}
