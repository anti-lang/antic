//! `if try s.matches(r)` fails with `TooExpensive` when the search reaches the
//! limit of depth that `(*LIMIT_DEPTH=n)` sets, for a text, and the limit of
//! the heap that `(*LIMIT_HEAP=n)` sets, for bytes.

import anti.lang;
import anti.regex;
import anti.text;

extern fn printf(fmt: ?*byte, ...) -> c_int;

fn tested(text: str, r: Regex) -> int may fail
{
	if try text.matches(r) {
		return 1;
	}
	return 0;
}

fn tested_bytes(data: []byte, r: ByteRegex) -> int may fail
{
	if try data.matches(r) {
		return 1;
	}
	return 0;
}

fn report(label: str, e: *lang.Error)
{
	printf("%.*s expensive %d\n".ptr, label.len as c_int, label.ptr,
		(e is *regex.TooExpensive) as c_int);
}

fn main() -> int
{
	let deep = Regex.compile(r"(*LIMIT_DEPTH=10)^(\w+\s?)*$") catch fatal;
	let text = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!";
	let found = tested(text, deep) catch e {
		report("depth", e);
		yield -1;
	};
	let large = ByteRegex.compile(r"(*LIMIT_HEAP=1)^(\w+\s?)*$") catch fatal;
	let data = text.to_bytes();
	let found_bytes = tested_bytes(data, large) catch e {
		report("heap", e);
		yield -1;
	};
	printf("results %lld %lld\n".ptr, found, found_bytes);
	free(data.ptr);
	return 0;
}
