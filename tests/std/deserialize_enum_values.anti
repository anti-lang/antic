//! `Object.deserialize` of a number that the enum of its field does not
//! declare. A value that becomes an enum must be one the enum declares, and a
//! number outside the range of its field fails the whole text, so the reader
//! refuses such a number in a field, an element of an array, the value of a
//! `?T` and a field of a struct. A declared value reads back in each place, a
//! value between two declared ones is refused, and so is 0 where the enum
//! declares no 0.
import anti.lang;
import anti.mem;

extern fn printf(fmt: ?*byte, ...) -> c_int;

enum Mode: u8 { Off, Slow, Fast }

enum Gap: i16 { Low = -1, High = 5 }

struct Pair
{
	mode: Mode,
	other: int,
}

class Holder
{
	pub mode: Mode = Mode.Off,
	pub modes: [2]Mode = [Mode.Off, Mode.Off],
	pub maybe: ?Mode = none,
	pub pair: Pair = Pair { mode: Mode.Off, other: 0 },
	pub gap: Gap = Gap.Low,
}

/// Read text into a `Holder` and print the fields it gave, or `refused`.
fn read(label: str, text: str)
{
	let arena = mem.ArenaAllocator.new(mem.LibcAllocator.get(), 1024);
	let back = Object.deserialize(text, &arena);
	if back == none || !(back is *Holder) {
		printf("%s: refused\n".ptr, label.ptr);
		arena.free_all();
		return;
	}
	let h = back as *Holder;
	let maybe = -1;
	if let m = h.maybe {
		maybe = m as int;
	}
	printf("%s: %d %d %d %d %d %d\n".ptr, label.ptr, h.mode as c_int,
		h.modes[0] as c_int, h.modes[1] as c_int, maybe as c_int,
		h.pair.mode as c_int, h.gap as c_int);
	arena.free_all();
}

fn main() -> int
{
	read("declared", "{\"type\":\"Holder\",\"mode\":2,\"modes\":[1,2],\"maybe\":1,\"pair\":{\"mode\":2,\"other\":7},\"gap\":5}");
	read("field", "{\"type\":\"Holder\",\"mode\":200}");
	read("element", "{\"type\":\"Holder\",\"modes\":[1,3]}");
	read("optional", "{\"type\":\"Holder\",\"maybe\":3}");
	read("struct field", "{\"type\":\"Holder\",\"pair\":{\"mode\":9,\"other\":7}}");
	read("between", "{\"type\":\"Holder\",\"gap\":2}");
	read("zero", "{\"type\":\"Holder\",\"gap\":0}");
	read("negative", "{\"type\":\"Holder\",\"gap\":-1}");
	return 0;
}
