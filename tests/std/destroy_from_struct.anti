//! `destroy(p, from)` of a struct tears it down part by part and gives what its
//! parts own back to `from`. The struct holds a class value with an `own`
//! field, whose object comes from `Counting`, so its count shows it came back.
import anti.mem;

extern fn printf(fmt: ?*byte, ...) -> c_int;

/// An allocator over the C library that counts the blocks it lends.
class Counting inherits mem.Allocator
{
	pub live: int = 0,

	concrete fn alloc(self, size: int, align: int) -> ?*byte
	{
		let p = mem.LibcAllocator.get().alloc(size, align) else {
			return none;
		};
		self.live += 1;
		return p;
	}

	concrete fn free(self, p: ?*byte)
	{
		if p != none {
			self.live -= 1;
		}
		mem.LibcAllocator.get().free(p);
	}
}

class Leaf
{
	pub n: int = 0,

	fn destruct(self)
	{
		printf("destruct Leaf %d\n".ptr, self.n as c_int);
	}
}

class Part
{
	pub own leaf: ?*Leaf = none,
}

struct Holder
{
	part: Part,
	n: int,
}

fn main() -> int
{
	let counting = Counting { };
	let raw = counting.alloc(size_of(Leaf), 16) else { return 1; };
	let made = raw as *Leaf;
	*made = Leaf { n: 7 };
	let h = Holder { part: Part { }, n: 1 };
	h.part.leaf = made;
	printf("made: %d live\n".ptr, counting.live as c_int);
	destroy(&h, &counting);
	printf("after destroy: %d live\n".ptr, counting.live as c_int);
	return 0;
}
