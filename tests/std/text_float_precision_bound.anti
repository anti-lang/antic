//! `append_float` writes every digit of a large precision, 200000000 after the
//! point, by item 9 of "Answers of 2026-11-19", which dropped the bound of
//! 100000000.
import anti.io;
import anti.json;
import anti.text;

fn main() -> int
{
	let b = text.Builder.new();
	b.append_float(0.5, 200000000);
	let n = text.Builder.new();
	json.write_int(b.text().len, &n);
	io.println(n.text());
	io.println(text.slice(b.text(), 0, 5));
	return 0;
}
