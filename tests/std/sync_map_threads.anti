//! Many threads on one `SyncMap` at once.
//!
//! The chunks of a `parallel` each own a range of keys: they add them, change
//! them in place, read them back and remove every third, while the other chunks
//! do the same to theirs. Every chunk then counts calls on a few keys that all
//! of them share, with `update` and with a loop of `get_versioned` and
//! `set_if_version`, so no count goes missing when two threads change one
//! entry. A dispatched job walks and searches the map meanwhile. A versioned
//! set fails once another thread changed the entry, and a copy made with `dup`
//! takes a lock of its own. The totals come out the same on every run.

import anti.collection.pool;
import anti.collection.synchronized.{SyncMap};

extern fn printf(format: ?*byte, ...) -> c_int;

/// The number of keys, split into the chunks of the `parallel`.
const KEYS: int = 100000;

/// The keys every chunk counts on, apart from the keys of the chunks.
const SHARED: int = 4;

/// The rounds of counting on the shared keys per key of a chunk.
const ROUNDS: int = 2;

/// Add the keys of `chunk`, change each in place, check it and remove every
/// third. Gives the number of keys that read back wrong.
worker fn own_keys(chunk: []int, m: *SyncMap<int, int>) -> int
{
	let wrong = 0;
	for k in chunk {
		let v = k;
		if !m.add(k, v) {
			wrong += 1;
		}
	}
	for k in chunk {
		m.modify(k, fn(v) {
			*v *= 2;
		});
	}
	for k in chunk {
		let v = m.get(k) ?? -1;
		if v != 2 * k {
			wrong += 1;
		}
		if k % 3 == 0 {
			let gone = m.remove(k) ?? -1;
			if gone != 2 * k {
				wrong += 1;
			}
		}
	}
	return wrong;
}

/// Count on the shared keys, `ROUNDS` times per key of `chunk`, once with
/// `update` and once with a compare and set that tries again when another
/// thread changed the entry first. Gives the number of compare and sets that
/// found the entry changed.
worker fn shared_keys(chunk: []int, m: *SyncMap<int, int>) -> int
{
	let retries = 0;
	for k in chunk {
		for round in 0..ROUNDS {
			let key = -1 - (k + round) % SHARED;
			m.update(key, fn(v) {
				*v += 1;
			});
			let key2 = -100 - (k + round) % SHARED;
			let done = false;
			while !done do {
				let (v, version) = m.get_versioned(key2) ?? (0, -1);
				m.set_if_version(key2, v + 1, version) catch e {
					retries += 1;
					continue;
				};
				done = true;
			}
		}
	}
	return retries;
}

/// Add one to the value under `key` of `m`, from another thread.
worker fn bump(m: *SyncMap<int, int>, key: int) -> int
{
	let hit = m.update(key, fn(v) {
		*v += 1;
	});
	return m.get(key) ?? -1;
}

/// Add `n` keys from `from` to `m`, from another thread.
worker fn more(m: *SyncMap<int, int>, from: int, n: int) -> int
{
	for k in from..from + n {
		let v = k;
		m.set(k, v);
	}
	return m.count();
}

/// Run `f` on every element of `items` from the chunks of a `parallel`.
fn each(items: []int, concurrent f: fn(int))
{
	let parts = parallel items by 8 -> run(f);
	free(parts.ptr);
}

worker fn run(chunk: []int, concurrent f: fn(int)) -> int
{
	for n in chunk {
		f(n);
	}
	return chunk.len;
}

/// Walk and search the map while the chunks change it. Gives the number of
/// entries it saw in every walk together, which only has to be sane.
worker fn watch(m: *SyncMap<int, int>, walks: int) -> int
{
	let seen = 0;
	for i in 0..walks {
		for (k, v) in *m {
			if k >= 0 && v != k && v != 2 * k {
				return -1;
			}
			seen += 1;
		}
		let odd = m.find_all(fn(e) {
			return e.0 >= 0 && e.1 % 2 == 1;
		});
		seen += odd.count;
	}
	return seen;
}

fn main() -> int
{
	let m = SyncMap<int, int>.new();
	for s in 0..SHARED {
		m.set(-1 - s, 0);
		m.set(-100 - s, 0);
	}
	let keys = alloc([KEYS]int, 1) else {
		return 1;
	};
	for i in 0..KEYS {
		(*keys)[i] = i;
	}
	let watcher = dispatch &m -> watch(20);
	let wrongs = parallel (*keys)[0..KEYS] by 16 -> own_keys(&m);
	let wrong = 0;
	for w in wrongs {
		wrong += w;
	}
	free(wrongs.ptr);
	let seen = join(watcher);
	let retried = parallel (*keys)[0..KEYS] by 16 -> shared_keys(&m);
	free(retried.ptr);
	let updates = 0;
	let swaps = 0;
	for s in 0..SHARED {
		updates += m.get(-1 - s) ?? 0;
		swaps += m.get(-100 - s) ?? 0;
	}
	let sum = 0;
	for (k, v) in m {
		if k >= 0 {
			sum += v;
		}
	}
	let expected = 0;
	for k in 0..KEYS {
		if k % 3 != 0 {
			expected += 2 * k;
		}
	}
	let left = m.count() - 2 * SHARED;
	printf("keys: %d wrong, %d left, sum right %d, watcher sane %d\n".ptr,
		wrong as c_int, left as c_int, (sum == expected) as c_int,
		(seen >= 0) as c_int);
	printf("shared: %d updates, %d compare and sets\n".ptr, updates as c_int,
		swaps as c_int);
	let (value, version) = m.get_versioned(-1) ?? (0, -1);
	let job = dispatch &m -> bump(-1);
	let bumped = join(job);
	m.set_if_version(-1, 0, version) catch e {
		let c = e as *pool.Changed;
		printf("stale after another thread: %d then %d, a newer version %d\n".ptr,
			value as c_int, bumped as c_int, (c.found > version) as c_int);
	};
	let copy = dup(&m);
	let grown = dispatch copy -> more(-1000, 10);
	let size = join(grown);
	printf("copy: %d in the copy, %d in the map\n".ptr, (size - m.count()) as c_int,
		m.count() as c_int);
	delete(copy);
	let removed = m.remove_all(fn(e) {
		return e.0 >= 0;
	});
	printf("removed %d, %d left\n".ptr, removed as c_int, m.count() as c_int);
	each((*keys)[0..KEYS], fn(k) {
		let v = k % 7;
		m.set(k, v);
	});
	let sevens = 0;
	for v in m.values() {
		sevens += v;
	}
	printf("closure: %d entries, sum %d\n".ptr, m.count() as c_int,
		sevens as c_int);
	free(keys);
	return 0;
}
