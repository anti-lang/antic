//! `rt.configure(path)` as the first statement of `main` names the
//! configuration file of the program. The file this test passes holds
//! `backtrace = true`, so the `fail` after the call carries the frames of its
//! trace in a release build, which is off without a file. `rt.get` then gives
//! the value of the key, and `none` for a key no layer gives a value.

import anti.lang;
import anti.runtime as rt;

extern fn printf(format: ?*byte, ...) -> c_int;

fn deep() -> int may fail
{
	fail "no such luck";
}

fn main(args: []str) -> int
{
	rt.configure(args[1]);
	let backtrace = rt.get("backtrace") ?? "none";
	let logger = rt.get("logger") ?? "none";
	printf("backtrace %.*s, logger %.*s\n".ptr, backtrace.len as c_int,
		backtrace.ptr, logger.len as c_int, logger.ptr);
	let v = deep() catch e {
		let t = e.text();
		printf("%.*s\n".ptr, t.len as c_int, t.ptr);
		yield 0;
	};
	return v;
}
