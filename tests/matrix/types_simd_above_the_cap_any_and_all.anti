//! `simd.any` and `simd.all` of the mask of a simd struct above the vector cap
//! of 256 bytes. The mask has a byte per lane, 512 of them, so each fold is a
//! loop over the bytes. A mask with one lane set gives `any` alone, and a mask
//! with every lane set gives both.

import anti.simd;

extern fn printf(format: ?*byte, ...) -> c_int;

simd struct U8x512
	allow(above-vector-cap, "the loops over the lanes are the subject")
{
