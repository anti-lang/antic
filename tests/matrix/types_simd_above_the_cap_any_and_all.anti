	l496: u8, l497: u8, l498: u8, l499: u8, l500: u8, l501: u8, l502: u8, l503: u8,
	l504: u8, l505: u8, l506: u8, l507: u8, l508: u8, l509: u8, l510: u8, l511: u8,
}

fn opaque(v: u8) -> u8
{
	return v;
}

fn main() -> int
{
	let a = U8x512.splat(opaque(3));
	let b = U8x512.splat(opaque(3));
	b.l200 = 4;
	let one = a < b;
	let every = a <= b;
	let none_set = a > b;
	printf("one %d %d\n".ptr, simd.any(one) as c_int, simd.all(one) as c_int);
	printf("every %d %d\n".ptr, simd.any(every) as c_int,
		simd.all(every) as c_int);
	printf("none %d %d\n".ptr, simd.any(none_set) as c_int,
		simd.all(none_set) as c_int);
	return 0;
}
