//! `delete` in a closure that a `dispatch` passes to its worker. The closure
//! deletes the object it made itself, and the checker follows the calls a
//! worker makes by name, which a call through a function value is not.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Node
{
	pub n: int = 0,
}

class Task
{
	pub n: int = 0,
}

worker fn work(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn main() -> int
{
	let t = alloc Task { n: 1 };
	let job = dispatch t -> work(fn(v) {
		let p = alloc Node { n: v };
		let n = p.n;
		delete(p);
		return n;
	});
	let n = join(job);
	delete(t);
	printf("delete in a dispatched closure: %d\n".ptr, n as c_int);
	return 0;
}
