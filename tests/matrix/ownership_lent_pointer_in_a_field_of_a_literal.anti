//! The literal of an object names a lent pointer as a field. The object could
//! outlive the call.

class Node
{
	pub n: int = 0,
}

class Holder
{
	pub p: ?*Node = none,
	pub s: []int,
}

fn run(lent p: *Node) -> int
{
	let numbers = [1, 2];
	let h = Holder { p: p, s: numbers[0..2] };
	return 0;
}

fn main() -> int
{
	let node = Node { n: 7 };
	return run(&node);
}
