//! The compound assignments on a simd struct above the vector cap of 256 bytes,
//! by R037 of "Answers of 2026-10-18". Each is a loop over the lanes: `+=`,
//! `*=`, `/=` and `<<=` on lanes of `i32`, the last two with the checks of a
//! dev build.

extern fn printf(format: ?*byte, ...) -> c_int;

simd struct I32x128
	allow(above-vector-cap, "the loops over the lanes are the subject")
{
	l0: i32, l1: i32, l2: i32, l3: i32, l4: i32, l5: i32, l6: i32, l7: i32,
	l8: i32, l9: i32, l10: i32, l11: i32, l12: i32, l13: i32, l14: i32, l15: i32,
	l16: i32, l17: i32, l18: i32, l19: i32, l20: i32, l21: i32, l22: i32, l23: i32,
	l24: i32, l25: i32, l26: i32, l27: i32, l28: i32, l29: i32, l30: i32, l31: i32,
	l32: i32, l33: i32, l34: i32, l35: i32, l36: i32, l37: i32, l38: i32, l39: i32,
	l40: i32, l41: i32, l42: i32, l43: i32, l44: i32, l45: i32, l46: i32, l47: i32,
	l48: i32, l49: i32, l50: i32, l51: i32, l52: i32, l53: i32, l54: i32, l55: i32,
	l56: i32, l57: i32, l58: i32, l59: i32, l60: i32, l61: i32, l62: i32, l63: i32,
	l64: i32, l65: i32, l66: i32, l67: i32, l68: i32, l69: i32, l70: i32, l71: i32,
	l72: i32, l73: i32, l74: i32, l75: i32, l76: i32, l77: i32, l78: i32, l79: i32,
	l80: i32, l81: i32, l82: i32, l83: i32, l84: i32, l85: i32, l86: i32, l87: i32,
	l88: i32, l89: i32, l90: i32, l91: i32, l92: i32, l93: i32, l94: i32, l95: i32,
	l96: i32, l97: i32, l98: i32, l99: i32, l100: i32, l101: i32, l102: i32, l103: i32,
	l104: i32, l105: i32, l106: i32, l107: i32, l108: i32, l109: i32, l110: i32, l111: i32,
	l112: i32, l113: i32, l114: i32, l115: i32, l116: i32, l117: i32, l118: i32, l119: i32,
	l120: i32, l121: i32, l122: i32, l123: i32, l124: i32, l125: i32, l126: i32, l127: i32,
}

// A value the optimizer cannot fold.
fn opaque(x: i32) -> i32
{
	return x;
}

fn main() -> int
{
	let v = I32x128.splat(opaque(3));
	v += I32x128.splat(opaque(4));
	printf("add %d %d\n".ptr, v.l0 as c_int, v.l127 as c_int);
	v *= I32x128.splat(opaque(6));
	printf("mul %d %d\n".ptr, v.l1 as c_int, v.l100 as c_int);
	v /= I32x128.splat(opaque(7));
	printf("div %d %d\n".ptr, v.l2 as c_int, v.l99 as c_int);
	v <<= I32x128.splat(opaque(2));
	printf("shl %d %d\n".ptr, v.l3 as c_int, v.l64 as c_int);
	return 0;
}
