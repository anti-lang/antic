//! `lent` before a result belongs to `operator fn value`, and the checker
//! refuses `-> lent int` of another function as it refuses `-> lent ?int`
//! there, by R063 of "Rules of 2026-10-13".

class Cell
{
	pub n: int = 0,

	pub fn value(self) -> lent int
	{
		return self.n;
	}
}

fn main() -> int
{
	let c = Cell { n: 1 };
	return c.value();
}
