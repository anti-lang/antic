//! Decision 27: a class with an `abstract fn` says `abstract` itself. One that
//! does not is refused, and the message names its open functions.

class Shape
{
	abstract fn area(self) -> int;
	abstract fn draw(self);
}

class Circle inherits Shape
{
	concrete fn area(self) -> int
	{
		return 1;
	}

	concrete fn draw(self)
	{
	}
}

fn main() -> int
{
	let c = Circle { };
	return c.area();
}
