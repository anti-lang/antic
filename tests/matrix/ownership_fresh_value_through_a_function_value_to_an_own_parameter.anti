//! A function whose parameter is `own` and needs a teardown is no function
//! value, by "Answers of 2026-11-13", so `let` refuses it. A call through a
//! function value leaves its argument with the caller.

class Key
{
	pub n: int = 0,

	fn destruct(self)
	{
	}
}

fn take(own k: Key) -> int
{
	return k.n;
}

fn main() -> int
{
	let call = take;
	return 0;
}
