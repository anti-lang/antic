//! `size_of` of every built-in type and of each form of type whose size is the
//! same on all six targets, with the padding of a struct, of a tuple and of an
//! optional value, and of a type parameter in two copies.

extern fn printf(format: ?*byte, ...) -> c_int;

struct Mixed
{
	a: u8,
	b: int,
	c: u8,
}

packed struct Tight
{
	a: u8,
	b: i32,
}

union Bits
{
	i: i32,
	f: f64,
}

enum Color
{
	Red,
	Green,
}

enum Mode: u8
{
	Read = 1,
	Write = 2,
}

variant Shape
{
	Circle { r: int },
	Empty,
}

simd struct I32x4
{
	a: i32,
	b: i32,
	c: i32,
	d: i32,
}

fn size<T>() -> int
{
	return size_of(T);
}

fn main() -> int
{
	printf("signed %lld %lld %lld %lld %lld\n".ptr, size_of(i8), size_of(i16),
		size_of(i32), size_of(i64), size_of(int));
	printf("unsigned %lld %lld %lld %lld %lld %lld\n".ptr, size_of(u8),
		size_of(u16), size_of(u32), size_of(u64), size_of(uint),
		size_of(byte));
	printf("floats %lld %lld %lld %lld\n".ptr, size_of(f16), size_of(f32),
		size_of(f64), size_of(float));
	printf("bool char str %lld %lld %lld\n".ptr, size_of(bool), size_of(char),
		size_of(str));
	printf("pointers %lld %lld %lld %lld\n".ptr, size_of(*int),
		size_of(?*int), size_of(fn(int) -> int), size_of(chan int));
	printf("slice array %lld %lld %lld\n".ptr, size_of([]u8),
		size_of([5]u16), size_of([2][3]i32));
	printf("optional %lld %lld %lld\n".ptr, size_of(?u8), size_of(?int),
		size_of(?str));
	printf("tuple %lld %lld\n".ptr, size_of((u8, u8)), size_of((u8, int)));
	printf("struct %lld %lld %lld\n".ptr, size_of(Mixed), size_of(Tight),
		size_of(Bits));
	printf("enum variant simd %lld %lld %lld %lld\n".ptr, size_of(Color),
		size_of(Mode), size_of(Shape), size_of(I32x4));
	printf("parameter %lld %lld\n".ptr, size<u16>(), size<Mixed>());
	return 0;
}
