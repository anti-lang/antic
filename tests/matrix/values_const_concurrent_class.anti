//! A `const` of the kind concurrent class is refused: its value is no constant
//! expression.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

concurrent class Hits
{
	pub atomic n: int = 0,
}

fn on_concurrent_class()
{
	const FIRST: Hits = Hits { n: 5 };
	printf("concurrent_class %lld %lld\n".ptr, FIRST.n.load(), FIRST.n.load());
}

fn main() -> int
{
	on_concurrent_class();
	return 0;
}
