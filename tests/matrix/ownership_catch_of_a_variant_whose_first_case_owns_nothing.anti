//! A `catch` that binds a variant with an owning case, whose first case holds
//! no fields or fields that own nothing. The slot the call writes takes the tag
//! of the first case before the call, and the value the call or the handler
//! gives stands in it.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

variant EmptyFirst
{
	Nothing,
	Keyed { k: Key },
}

variant PlainFirst
{
	Count { n: int },
	Keyed { k: Key },
}

fn empty_first(n: int) -> EmptyFirst may fail
{
	if n > 0 {
		fail "refused";
	}
	return EmptyFirst.Keyed { k: Key { n: 4, leaf: alloc Leaf { n: 4 } } };
}

fn plain_first(n: int) -> PlainFirst may fail
{
	if n > 0 {
		fail "refused";
	}
	return PlainFirst.Keyed { k: Key { n: 5, leaf: alloc Leaf { n: 5 } } };
}

fn main() -> int
{
	let a = empty_first(0) catch e {
		yield EmptyFirst.Nothing;
	};
	let b = plain_first(1) catch e {
		yield PlainFirst.Count { n: 9 };
	};
	printf("%d %d\n".ptr, a.tag as c_int, b.tag as c_int);
	return 0;
}
