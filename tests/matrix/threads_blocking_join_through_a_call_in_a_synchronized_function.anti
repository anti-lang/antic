//! A public function of a synchronized class calls a function that holds a
//! `join`, which may wait while the hidden lock of the object is held. The call
//! gets the warning `blocking-under-lock`, which a release build refuses.

class Task
{
	pub n: int = 4,
}

worker fn read(t: *Task) -> int
{
	return t.n;
}

fn finish(t: *Task) -> int
{
	let job = dispatch t -> read;
	return join(job);
}

synchronized class Inbox
{
	count: int = 0,

	pub fn work(self, t: *Task) -> int
	{
		self.count += finish(t);
		return self.count;
	}
}

fn main() -> int
{
	let box = alloc Inbox { };
	let t = alloc Task { };
	let n = box.work(t);
	delete(t);
	delete(box);
	return n - 4;
}
