//! A body qualified by its own class is the unqualified body, so both for one
//! name are a name declared twice.

abstract class Shape
{
	abstract fn area(self) -> int;
}

class Square inherits Shape
{
	concrete fn area(self) -> int
	{
		return 1;
	}

	concrete fn Square::area(self) -> int
	{
		return 2;
	}
}

fn main() -> int
{
	return 0;
}
