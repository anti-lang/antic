//! Decision 20: the handler that guards a `?*T` reaches its end, and its
//! binding is a `*T` that would hold `none`. It is refused.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

fn find(n: int, at: *int) -> ?*int
{
	if n > 0 {
		return none;
	}
	return at;
}

fn main() -> int
{
	let seven = 7;
	let p = find(1, &seven) catch e {
		printf("%s\n".ptr, e.message.ptr);
	};
	return *p;
}
