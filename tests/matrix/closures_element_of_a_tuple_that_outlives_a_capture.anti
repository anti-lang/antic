//! The element of a tuple holds the closure the tuple holds, so a local
//! declared outside the block of what the closure captures does not take it.

fn main() -> int
{
	let n = 0;
	let g = fn() { n += 1; };
	{
		let inner = 5;
		let t = (fn() { n += inner; }, 2);
		g = t.0;
	}
	g();
	return n;
}
