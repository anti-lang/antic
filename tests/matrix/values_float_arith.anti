	let a43: f64 = 1.5 * one;
	let b43: f64 = 0.25 * one;
	let r43: f64 = a43 / b43;
	let x43: f64 = a43;
	x43 /= b43;
	printf("div f64 1.5 0.25 = %.17g %.17g %.17g\n".ptr, F43 as f64, r43 as f64, x43 as f64);
	const A44: f64 = 1.0;
	const B44: f64 = 3.0;
	const F44: f64 = A44 / B44;
	let a44: f64 = 1.0 * one;
	let b44: f64 = 3.0 * one;
	let r44: f64 = a44 / b44;
	let x44: f64 = a44;
	x44 /= b44;
	printf("div f64 1 3 = %.17g %.17g %.17g\n".ptr, F44 as f64, r44 as f64, x44 as f64);
	const A45: f64 = 16777216.0;
	const B45: f64 = 1.0;
	const F45: f64 = A45 / B45;
	let a45: f64 = 16777216.0 * one;
	let b45: f64 = 1.0 * one;
	let r45: f64 = a45 / b45;
	let x45: f64 = a45;
	x45 /= b45;
	printf("div f64 16777216 1 = %.17g %.17g %.17g\n".ptr, F45 as f64, r45 as f64, x45 as f64);
	const A46: f64 = -0.0;
	const B46: f64 = 0.0;
	const F46: f64 = A46 / B46;
	let a46: f64 = -0.0 * one;
	let b46: f64 = 0.0 * one;
	let r46: f64 = a46 / b46;
	let x46: f64 = a46;
	x46 /= b46;
	printf("div f64 -0 0 = nan %d %d %d\n".ptr, (F46 != F46) as c_int, (r46 != r46) as c_int, (x46 != x46) as c_int);
	const A47: f64 = 1.0;
	const B47: f64 = 0.0;
	const F47: f64 = A47 / B47;
	let a47: f64 = 1.0 * one;
	let b47: f64 = 0.0 * one;
	let r47: f64 = a47 / b47;
	let x47: f64 = a47;
	x47 /= b47;
	printf("div f64 1 0 = %.17g %.17g %.17g\n".ptr, F47 as f64, r47 as f64, x47 as f64);
	const A48: f64 = -1.0;
	const B48: f64 = 0.0;
	const F48: f64 = A48 / B48;
	let a48: f64 = -1.0 * one;
	let b48: f64 = 0.0 * one;
	let r48: f64 = a48 / b48;
	let x48: f64 = a48;
	x48 /= b48;
	printf("div f64 -1 0 = %.17g %.17g %.17g\n".ptr, F48 as f64, r48 as f64, x48 as f64);
	const A49: f64 = 0.0;
	const B49: f64 = 0.0;
	const F49: f64 = A49 / B49;
	let a49: f64 = 0.0 * one;
	let b49: f64 = 0.0 * one;
	let r49: f64 = a49 / b49;
	let x49: f64 = a49;
	x49 /= b49;
	printf("div f64 0 0 = nan %d %d %d\n".ptr, (F49 != F49) as c_int, (r49 != r49) as c_int, (x49 != x49) as c_int);
	const A50: f64 = 1.0;
	const B50: f64 = -0.0;
	const F50: f64 = A50 / B50;
	let a50: f64 = 1.0 * one;
	let b50: f64 = -0.0 * one;
	let r50: f64 = a50 / b50;
	let x50: f64 = a50;
	x50 /= b50;
	printf("div f64 1 -0 = %.17g %.17g %.17g\n".ptr, F50 as f64, r50 as f64, x50 as f64);
	const A51: f64 = 1.0 / 0.0;
	const B51: f64 = 1.0 / 0.0;
	const F51: f64 = A51 / B51;
	let a51: f64 = one / (one - one);
	let b51: f64 = one / (one - one);
	let r51: f64 = a51 / b51;
	let x51: f64 = a51;
	x51 /= b51;
	printf("div f64 inf inf = nan %d %d %d\n".ptr, (F51 != F51) as c_int, (r51 != r51) as c_int, (x51 != x51) as c_int);
	const A52: f64 = 1.0 / 0.0;
	const B52: f64 = 0.0;
	const F52: f64 = A52 / B52;
	let a52: f64 = one / (one - one);
	let b52: f64 = 0.0 * one;
	let r52: f64 = a52 / b52;
	let x52: f64 = a52;
	x52 /= b52;
	printf("div f64 inf 0 = %.17g %.17g %.17g\n".ptr, F52 as f64, r52 as f64, x52 as f64);
	const A53: f64 = 1.0e308;
	const B53: f64 = 10.0;
	const F53: f64 = A53 / B53;
	let a53: f64 = 1.0e308 * one;
	let b53: f64 = 10.0 * one;
	let r53: f64 = a53 / b53;
	let x53: f64 = a53;
	x53 /= b53;
	printf("div f64 1e+308 10 = %.17g %.17g %.17g\n".ptr, F53 as f64, r53 as f64, x53 as f64);
	const A54: f64 = 9007199254740992.0;
	const B54: f64 = 1.0;
	const F54: f64 = A54 / B54;
	let a54: f64 = 9007199254740992.0 * one;
	let b54: f64 = 1.0 * one;
	let r54: f64 = a54 / b54;
	let x54: f64 = a54;
	x54 /= b54;
	printf("div f64 9007199254740992 1 = %.17g %.17g %.17g\n".ptr, F54 as f64, r54 as f64, x54 as f64);
	const A55: f64 = 5.0e-324;
	const B55: f64 = 2.0;
	const F55: f64 = A55 / B55;
	let a55: f64 = 5.0e-324 * one;
	let b55: f64 = 2.0 * one;
	let r55: f64 = a55 / b55;
	let x55: f64 = a55;
	x55 /= b55;
	printf("div f64 4.9406564584124654e-324 2 = %.17g %.17g %.17g\n".ptr, F55 as f64, r55 as f64, x55 as f64);
	const A56: f64 = 0.0;
	const F56: f64 = -A56;
	let a56: f64 = 0.0 * one;
	let r56: f64 = -a56;
	printf("neg f64 0 = %.17g %.17g\n".ptr, F56 as f64, r56 as f64);
	const A57: f64 = 1.5;
	const F57: f64 = -A57;
	let a57: f64 = 1.5 * one;
	let r57: f64 = -a57;
	printf("neg f64 1.5 = %.17g %.17g\n".ptr, F57 as f64, r57 as f64);
	const A58: f64 = 1.0 / 0.0;
	const F58: f64 = -A58;
	let a58: f64 = one / (one - one);
	let r58: f64 = -a58;
	printf("neg f64 inf = %.17g %.17g\n".ptr, F58 as f64, r58 as f64);
	const A59: f64 = 0.0 / 0.0;
	const F59: f64 = -A59;
	let a59: f64 = (one - one) / (one - one);
	let r59: f64 = -a59;
	printf("neg f64 nan = nan %d %d\n".ptr, (F59 != F59) as c_int, (r59 != r59) as c_int);
	const A60: f64 = -0.0;
	const F60: f64 = -A60;
	let a60: f64 = -0.0 * one;
	let r60: f64 = -a60;
	printf("neg f64 -0 = %.17g %.17g\n".ptr, F60 as f64, r60 as f64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	on_f32((zero + 1) as f32);
	on_f64((zero + 1) as f64);
	return 0;
}
