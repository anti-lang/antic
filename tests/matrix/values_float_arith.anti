//! `+ - * /` and unary `-` on `f32` and `f64`: ordinary values, a rounding at
//! the last bit, both zeros, a division by zero, the infinities and a NaN. Each
//! line holds three values that must agree: the one the checker folds in a
//! constant, the one the program computes from operands it cannot know before
//! it runs, and the one the compound assignment leaves. A NaN prints as `nan`
//! and one digit per value, 1 where the value differs from itself.

extern fn printf(format: ?*byte, ...) -> c_int;

