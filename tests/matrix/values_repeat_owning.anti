//! `[v; n]` of a value that owns something is refused: the repeat form copies
//! one value into every element, and what it owns would have one owner per
//! element.

class Handle
{
	pub id: int = 0,

	pub fn destruct(self)
	{
	}
}

fn main() -> int
{
	let row = [Handle { id: 1 }; 3];
	return row.len;
}
