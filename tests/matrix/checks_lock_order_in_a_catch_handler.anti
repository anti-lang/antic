//! C4 in a catch handler: `forward` takes `a` and then `b`, and a handler takes
//! `b` and then `a`.

import anti.lang;

struct Pair
{
	a: Mutex,
	b: Mutex,
	n: int,
}

fn forward(p: *Pair)
{
	sync p.a {
		sync p.b {
			p.n += 1;
		}
	}
}

fn failing(k: int) -> int may fail
{
	fail "refused";
}

fn backward(p: *Pair)
{
	failing(1) catch e {
		sync p.b {
			sync p.a {
				p.n -= 1;
			}
		}
	};
}

fn main() -> int
{
	let p = Pair { n: 0 };
	forward(&p);
	backward(&p);
	return p.n;
}
