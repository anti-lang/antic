//! The bindings and the calls of the values area, each in every place its row
//! of docs/notes/test-matrix.md left open: let, let_typed, let_tuple, const,
//! call, size_of, fn, simd. Each construct in each place is a function of its
//! own, named after both, and the program prints one line per construct, place
//! and input.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

fn twice(n: int) -> int
{
	return n * 2;
}

struct Pt
{
	x: int,
	y: int,
}

fn call_with(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

simd struct I32x4
{
	a: i32,
	b: i32,
	c: i32,
	d: i32,
}

class Task
{
	pub n: int = 0,
}

fn held_let(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_let(n: int) -> int
{
	let acc = 0;
	if let v = held_let(n) {
		acc += v - n * 3;
		let x = n * 2;
		let y = x;
		acc += y;
	} else {
		acc = -1;
	}
	return acc;
}

worker fn work_let(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_let(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_let(fn(n) {
		let acc = 0;
		let x = n * 2;
		let y = x;
		acc += y;
		return acc;
	});
	return join(job);
}

fn in_arm_let_typed(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let x: i32 = 5;
			let y: u8 = 200;
			let z: f32 = 0.5;
			acc += x as int + y as int + (z * 4.0) as int + n;
		},
	}
	return acc;
}

fn held_let_typed(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_let_typed(n: int) -> int
{
	let acc = 0;
	if let v = held_let_typed(n) {
		acc += v - n * 3;
		let x: i32 = 5;
		let y: u8 = 200;
		let z: f32 = 0.5;
		acc += x as int + y as int + (z * 4.0) as int + n;
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_let_typed(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let x: i32 = 5;
		let y: u8 = 200;
		let z: f32 = 0.5;
		acc += x as int + y as int + (z * 4.0) as int + n;
	}
	acc = 5;
}

fn in_undo_let_typed(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let x: i32 = 5;
		let y: u8 = 200;
		let z: f32 = 0.5;
		acc += x as int + y as int + (z * 4.0) as int + n;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_let_typed(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_let_typed(n: int) -> int
{
	let acc = 0;
	let got = risky_let_typed(n) catch {
		let x: i32 = 5;
		let y: u8 = 200;
		let z: f32 = 0.5;
		acc += x as int + y as int + (z * 4.0) as int + n;
		yield acc;
	};
	return got;
}

fn apply_let_typed(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_let_typed(start: int) -> int
{
	let acc = 0;
	let got = apply_let_typed(start, fn(n) {
		let x: i32 = 5;
		let y: u8 = 200;
		let z: f32 = 0.5;
		acc += x as int + y as int + (z * 4.0) as int + n;
		return acc;
	});
	return got + acc;
}

worker fn in_worker_let_typed(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let x: i32 = 5;
	let y: u8 = 200;
	let z: f32 = 0.5;
	acc += x as int + y as int + (z * 4.0) as int + n;
	return acc;
}

worker fn work_let_typed(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_let_typed(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_let_typed(fn(n) {
		let acc = 0;
		let x: i32 = 5;
		let y: u8 = 200;
		let z: f32 = 0.5;
		acc += x as int + y as int + (z * 4.0) as int + n;
		return acc;
	});
	return join(job);
}

struct Guarded_let_typed
{
	lock: Mutex,
	entered: int,
}

fn in_sync_let_typed(g: *Guarded_let_typed, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let x: i32 = 5;
		let y: u8 = 200;
		let z: f32 = 0.5;
		acc += x as int + y as int + (z * 4.0) as int + n;
	}
	return acc;
}

fn in_select_let_typed(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let x: i32 = 5;
			let y: u8 = 200;
			let z: f32 = 0.5;
			acc += x as int + y as int + (z * 4.0) as int + n;
		},
	}
	return acc;
}

class Outer_let_typed
{
	class Inner_let_typed
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let x: i32 = 5;
			let y: u8 = 200;
			let z: f32 = 0.5;
			acc += x as int + y as int + (z * 4.0) as int + n;
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_let_typed { base: 1000 };
		return inner.run(n);
	}
}

class Box_let_tuple
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		let (q, r) = (n / 2, n % 2);
		acc += q * 10 + r;
		return acc;
	}
}

fn in_arm_let_tuple(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let (q, r) = (n / 2, n % 2);
			acc += q * 10 + r;
		},
	}
	return acc;
}

fn held_let_tuple(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_let_tuple(n: int) -> int
{
	let acc = 0;
	if let v = held_let_tuple(n) {
		acc += v - n * 3;
		let (q, r) = (n / 2, n % 2);
		acc += q * 10 + r;
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_let_tuple(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let (q, r) = (n / 2, n % 2);
		acc += q * 10 + r;
	}
	acc = 5;
}

fn in_undo_let_tuple(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let (q, r) = (n / 2, n % 2);
		acc += q * 10 + r;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_let_tuple(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_let_tuple(n: int) -> int
{
	let acc = 0;
	let got = risky_let_tuple(n) catch {
		let (q, r) = (n / 2, n % 2);
		acc += q * 10 + r;
		yield acc;
	};
	return got;
}

fn apply_let_tuple(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_let_tuple(start: int) -> int
{
	let acc = 0;
	let got = apply_let_tuple(start, fn(n) {
		let (q, r) = (n / 2, n % 2);
		acc += q * 10 + r;
		return acc;
	});
	return got + acc;
}

worker fn work_let_tuple(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_let_tuple(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_let_tuple(fn(n) {
		let acc = 0;
		let (q, r) = (n / 2, n % 2);
		acc += q * 10 + r;
		return acc;
	});
	return join(job);
}

struct Guarded_let_tuple
{
	lock: Mutex,
	entered: int,
}

fn in_sync_let_tuple(g: *Guarded_let_tuple, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let (q, r) = (n / 2, n % 2);
		acc += q * 10 + r;
	}
