struct Guarded_size_of
{
	lock: Mutex,
	entered: int,
}

fn in_sync_size_of(g: *Guarded_size_of, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		acc += size_of(i32) * n + size_of(Pt) + size_of([3]u16);
	}
	return acc;
}

fn in_select_size_of(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			acc += size_of(i32) * n + size_of(Pt) + size_of([3]u16);
		},
	}
	return acc;
}

fn in_arm_fn(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let k = n + 1;
			acc += call_with(n, fn(v) {
				return v * k;
			});
		},
	}
	return acc;
}

fn held_fn(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_fn(n: int) -> int
{
	let acc = 0;
	if let v = held_fn(n) {
		acc += v - n * 3;
		let k = n + 1;
		acc += call_with(n, fn(v) {
			return v * k;
		});
	} else {
		acc = -1;
	}
	return acc;
}

fn in_undo_fn(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let k = n + 1;
		acc += call_with(n, fn(v) {
			return v * k;
		});
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_fn(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_fn(n: int) -> int
{
	let acc = 0;
	let got = risky_fn(n) catch {
		let k = n + 1;
		acc += call_with(n, fn(v) {
			return v * k;
		});
		yield acc;
	};
	return got;
}

struct Guarded_fn
{
	lock: Mutex,
	entered: int,
}

fn in_sync_fn(g: *Guarded_fn, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let k = n + 1;
		acc += call_with(n, fn(v) {
			return v * k;
		});
	}
	return acc;
}

fn in_select_fn(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let k = n + 1;
			acc += call_with(n, fn(v) {
				return v * k;
			});
		},
	}
	return acc;
}

class Outer_fn
{
	class Inner_fn
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let k = n + 1;
			acc += call_with(n, fn(v) {
				return v * k;
			});
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_fn { base: 1000 };
		return inner.run(n);
	}
}

class Box_simd
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		let lanes = I32x4.splat(n as i32);
		let twice = lanes + lanes;
		acc += twice.sum() as int + twice.max() as int;
		return acc;
	}
}

fn in_arm_simd(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let lanes = I32x4.splat(n as i32);
			let twice = lanes + lanes;
			acc += twice.sum() as int + twice.max() as int;
		},
	}
	return acc;
}

fn held_simd(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_simd(n: int) -> int
{
	let acc = 0;
	if let v = held_simd(n) {
		acc += v - n * 3;
		let lanes = I32x4.splat(n as i32);
		let twice = lanes + lanes;
		acc += twice.sum() as int + twice.max() as int;
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_simd(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let lanes = I32x4.splat(n as i32);
		let twice = lanes + lanes;
		acc += twice.sum() as int + twice.max() as int;
	}
	acc = 5;
}

fn in_undo_simd(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let lanes = I32x4.splat(n as i32);
		let twice = lanes + lanes;
		acc += twice.sum() as int + twice.max() as int;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_simd(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_simd(n: int) -> int
{
	let acc = 0;
	let got = risky_simd(n) catch {
		let lanes = I32x4.splat(n as i32);
		let twice = lanes + lanes;
		acc += twice.sum() as int + twice.max() as int;
		yield acc;
	};
	return got;
}

fn apply_simd(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_simd(start: int) -> int
{
	let acc = 0;
	let got = apply_simd(start, fn(n) {
		let lanes = I32x4.splat(n as i32);
		let twice = lanes + lanes;
		acc += twice.sum() as int + twice.max() as int;
		return acc;
	});
	return got + acc;
}

worker fn in_worker_simd(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let lanes = I32x4.splat(n as i32);
	let twice = lanes + lanes;
	acc += twice.sum() as int + twice.max() as int;
	return acc;
}

worker fn work_simd(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_simd(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_simd(fn(n) {
		let acc = 0;
		let lanes = I32x4.splat(n as i32);
		let twice = lanes + lanes;
		acc += twice.sum() as int + twice.max() as int;
		return acc;
	});
	return join(job);
}

struct Guarded_simd
{
	lock: Mutex,
	entered: int,
}

fn in_sync_simd(g: *Guarded_simd, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let lanes = I32x4.splat(n as i32);
		let twice = lanes + lanes;
		acc += twice.sum() as int + twice.max() as int;
	}
	return acc;
}

fn in_select_simd(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let lanes = I32x4.splat(n as i32);
			let twice = lanes + lanes;
			acc += twice.sum() as int + twice.max() as int;
		},
	}
	return acc;
}

fn in_generic_simd<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	let lanes = I32x4.splat(n as i32);
	let twice = lanes + lanes;
	acc += twice.sum() as int + twice.max() as int;
	return acc;
}

class Outer_simd
{
	class Inner_simd
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let lanes = I32x4.splat(n as i32);
			let twice = lanes + lanes;
			acc += twice.sum() as int + twice.max() as int;
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_simd { base: 1000 };
		return inner.run(n);
	}
}

