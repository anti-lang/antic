}

fn in_function_const(n: int) -> int
{
	let acc = 0;
	const STEP: int = 3;
	const TWICE: int = STEP * 2;
	acc += TWICE * n;
	return acc;
}

class Box_const
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		const STEP: int = 3;
		const TWICE: int = STEP * 2;
		acc += TWICE * n;
		return acc;
	}
}

fn in_loop_const(n: int) -> int
{
	let acc = 0;
	for turn in 0..2 {
		acc += turn;
		const STEP: int = 3;
		const TWICE: int = STEP * 2;
		acc += TWICE * n;
	}
	return acc;
}

fn in_arm_const(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			const STEP: int = 3;
			const TWICE: int = STEP * 2;
			acc += TWICE * n;
		},
	}
	return acc;
}

