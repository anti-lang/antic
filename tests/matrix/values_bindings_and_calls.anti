{
	let n = t.n;
	let acc = 0;
	acc += size_of(i32) * n + size_of(Pt) + size_of([3]u16);
	return acc;
}

worker fn work_size_of(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_size_of(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_size_of(fn(n) {
		let acc = 0;
		acc += size_of(i32) * n + size_of(Pt) + size_of([3]u16);
		return acc;
	});
	return join(job);
