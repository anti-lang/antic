fn in_select_let_tuple(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let (q, r) = (n / 2, n % 2);
			acc += q * 10 + r;
		},
	}
	return acc;
}

fn in_generic_let_tuple<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	let (q, r) = (n / 2, n % 2);
	acc += q * 10 + r;
	return acc;
}

class Outer_let_tuple
{
	class Inner_let_tuple
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let (q, r) = (n / 2, n % 2);
			acc += q * 10 + r;
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
