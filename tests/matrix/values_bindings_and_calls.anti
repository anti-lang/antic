fn in_select_call(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			acc += twice(n) + twice(twice(1));
		},
	}
	return acc;
}

class Outer_call
{
	class Inner_call
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			acc += twice(n) + twice(twice(1));
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_call { base: 1000 };
		return inner.run(n);
	}
}

fn in_loop_size_of(n: int) -> int
{
	let acc = 0;
	for turn in 0..2 {
		acc += turn;
		acc += size_of(i32) * n + size_of(Pt) + size_of([3]u16);
	}
	return acc;
}

fn in_arm_size_of(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			acc += size_of(i32) * n + size_of(Pt) + size_of([3]u16);
		},
	}
	return acc;
}

fn held_size_of(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_size_of(n: int) -> int
{
	let acc = 0;
	if let v = held_size_of(n) {
		acc += v - n * 3;
		acc += size_of(i32) * n + size_of(Pt) + size_of([3]u16);
	} else {
		acc = -1;
	}
	return acc;
}

