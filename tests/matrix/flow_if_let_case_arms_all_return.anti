//! An `if let` on a case of a variant whose arm and whose `else` both return
//! ends the path of its function.

extern fn printf(format: ?*byte, ...) -> c_int;

variant Shape
{
	Circle { r: int },
	Empty,
}

fn run(s: Shape) -> int
{
	if let Circle c = s {
		return c.r;
	} else {
		return -1;
	}
}

fn main() -> int
{
	printf("%d %d\n".ptr, run(Shape.Circle { r: 7 }) as c_int,
		run(Shape.Empty) as c_int);
	return 0;
}
