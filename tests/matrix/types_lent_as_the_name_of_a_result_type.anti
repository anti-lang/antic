//! `lent` is a word of its place alone: a type may carry the name, and a result
//! of that type stands before a block, before `may fail` and before a clause.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

struct lent
{
	n: int,
}

fn plain() -> lent
{
	return lent { n: 1 };
}

fn failing(n: int) -> lent may fail
{
	if n < 0 {
		fail "negative";
	}
	return lent { n: n };
}

fn main() -> int
{
	let a = plain();
	let b = failing(2) catch e {
		return 1;
	};
	printf("%lld %lld\n".ptr, a.n, b.n);
	return 0;
}
