//! One NaN on every target through a union, by Q1 of "Answers of 2026-11-06,
//! fourth set". Each context is a function of its own that writes a NaN into
//! the float field of a union and reads the integer field. Each line holds the
//! bits of three NaNs: 0/0 of a zero read at run time, whose sign follows the
//! processor, its negation and a negative NaN with a payload. Every target
//! gives the canonical NaN for all three.

extern fn printf(format: ?*byte, ...) -> c_int;

union Bits32
{
	f: f32,
	u: u32,
}

union Bits64
{
	f: f64,
	u: u64,
}

/// NaN number `kind` of the three, from the zero `z`.
fn make(z: f32, kind: int) -> f32
{
	if kind == 0 {
		return z / z;
	}
	if kind == 1 {
		return -(z / z);
	}
	let b = Bits32 { u: 0xffd00000 };
	return b.f + z;
}

fn make64(z: f64, kind: int) -> f64
{
	if kind == 0 {
		return z / z;
	}
	if kind == 1 {
		return -(z / z);
	}
	let b = Bits64 { u: 0xfffa000000000000 };
	return b.f + z;
}

fn union_in_function(z: f32, kind: int) -> u32
{
	let b = Bits32 { f: make(z, kind) };
	return b.u;
}

fn union64_in_function(z: f64, kind: int) -> u64
{
	let b = Bits64 { f: make64(z, kind) };
	return b.u;
}

class Holder
{
	pub cell: Bits32,

	pub fn run(self, z: f32, kind: int) -> u32
	{
		self.cell.f = make(z, kind);
		return self.cell.u;
	}
}

fn union_in_loop(z: f32, kind: int) -> u32
{
	let cells = [Bits32 { u: 0 }, Bits32 { u: 0 }];
	let bits: u32 = 0;
	for i in 0..2 {
		cells[i].f = make(z, kind);
		bits = cells[i].u;
	}
	return bits;
}

fn union_in_arm(z: f32, kind: int) -> u32
{
	let bits: u32 = 0;
	switch kind {
		9 => bits = 1,
		else => {
			let b = Bits32 { f: make(z, kind) };
			bits = b.u;
		},
	}
	return bits;
}

fn held(kind: int) -> ?int
{
	if kind == 9 {
		return none;
	}
	return kind;
}

fn union_in_if_let(z: f32, kind: int) -> u32
{
	let bits: u32 = 0;
	if let k = held(kind) {
		let b = Bits32 { f: make(z, k) };
		bits = b.u;
	} else {
		bits = 1;
	}
	return bits;
}

fn union_in_defer(z: f32, kind: int, out: *u32)
{
	defer {
		let b = Bits32 { f: make(z, kind) };
		*out = b.u;
	}
	*out = 1;
}

fn apply(z: f32, f: fn(f32) -> u32) -> u32
{
	return f(z);
}

fn union_in_closure(z: f32, kind: int) -> u32
{
	return apply(z, fn(v) {
		let b = Bits32 { f: make(v, kind) };
		return b.u;
	});
}

fn union_in_generic<T>(z: f32, kind: int) -> u32
{
	let b = Bits32 { f: make(z, kind) };
	return b.u + (size_of(T) - size_of(T)) as u32;
}

fn line(context: str, a: u32, b: u32, c: u32)
{
	printf("union %.*s %08x %08x %08x\n".ptr, context.len as c_int,
		context.ptr, a, b, c);
}

fn main(args: []str) -> int
{
	let z: f32 = args.len as f32 - 1.0;
	let z64: f64 = args.len as f64 - 1.0;
	line("function", union_in_function(z, 0), union_in_function(z, 1),
		union_in_function(z, 2));
	let holder = alloc Holder { cell: Bits32 { u: 0 } };
	line("method", holder.run(z, 0), holder.run(z, 1), holder.run(z, 2));
	delete(holder);
	line("loop", union_in_loop(z, 0), union_in_loop(z, 1), union_in_loop(z, 2));
	line("arm", union_in_arm(z, 0), union_in_arm(z, 1), union_in_arm(z, 2));
	line("if_let", union_in_if_let(z, 0), union_in_if_let(z, 1),
		union_in_if_let(z, 2));
	let d0: u32 = 0;
	let d1: u32 = 0;
	let d2: u32 = 0;
	union_in_defer(z, 0, &d0);
	union_in_defer(z, 1, &d1);
	union_in_defer(z, 2, &d2);
	line("defer", d0, d1, d2);
	line("closure", union_in_closure(z, 0), union_in_closure(z, 1),
		union_in_closure(z, 2));
	line("generic", union_in_generic<int>(z, 0), union_in_generic<int>(z, 1),
		union_in_generic<int>(z, 2));
	printf("union f64 %016llx %016llx %016llx\n".ptr,
		union64_in_function(z64, 0), union64_in_function(z64, 1),
		union64_in_function(z64, 2));
	return 0;
}
