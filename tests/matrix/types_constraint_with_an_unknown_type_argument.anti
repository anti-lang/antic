//! A constraint whose type argument names no type gets the message on the type
//! alone.

abstract class Into<T>
{
	abstract fn into(self) -> int;
}

class Whole inherits Into<int>
{
	concrete fn into(self) -> int
	{
		return 1;
	}
}

fn pick<T: Into<Nope>>(own a: T) -> T
{
	return a;
}

fn main() -> int
{
	let n = pick(1);
	return 0;
}
