//! `return a ?? b` of two locals of a class with a `destruct`. The value is the
//! one `a` or `b` holds, and both are torn down at the end of the function, so
//! the `return` would give it a second owner.

class Owner
{
	pub n: int = 0,

	pub fn destruct(self)
	{
	}
}

fn pick() -> Owner
{
	let a: ?Owner = Owner { n: 1 };
	let b = Owner { n: 2 };
	return a ?? b;
}

fn main() -> int
{
	return pick().n as int;
}
