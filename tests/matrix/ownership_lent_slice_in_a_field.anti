//! `=` stores a lent slice in a field of an object, which could outlive the
//! call.

class Node
{
	pub n: int = 0,
}

class Holder
{
	pub p: ?*Node = none,
	pub s: []int,
}

fn run(lent s: []int, h: *Holder) -> int
{
	h.s = s;
	return 0;
}

fn main() -> int
{
	let numbers = [1, 2];
	let h = Holder { s: numbers[0..2] };
	return run(numbers[0..1], &h);
}
