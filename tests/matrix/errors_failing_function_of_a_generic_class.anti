//! A function of a generic class may fail. `pop` of an empty stack fails, and a
//! loop drains it until the handler breaks out.

import anti.collection.list.{List};
import anti.io;
import anti.lang;
import anti.text;

class Stack<T>
{
	items: List<T>,

	pub fn new() -> Stack<T>
	{
		return Stack<T> { items: List<T>.new() };
	}

	pub fn push(self, own x: T)
	{
		self.items.push(x);
	}

	pub fn pop(self) -> T may fail
	{
		let x = self.items.pop() else {
			fail lang.Error.new(1, "empty stack");
		};
		return x;
	}
}

fn say(s: str)
{
	io.println(s);
	free(s.ptr);
}

fn main() -> int
{
	let s = Stack<str>.new();
	s.push("a");
	s.push("b");
	while true do {
		let x = s.pop() catch e {
			say(f"{e.message}");
			break;
		};
		say(f"{x}");
	}
	let n = Stack<int>.new();
	n.push(4);
	let v = n.pop() catch fatal;
	say(f"{v}");
	return 0;
}
