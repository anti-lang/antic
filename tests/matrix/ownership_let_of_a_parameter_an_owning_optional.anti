//! `let` of a parameter that is not `own` and holds a `?T` of an owning value.
//! The value belongs to the caller, which tears it down.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn maybe(n: int) -> ?Key
{
	return key(n);
}

fn keep(x: ?Key) -> int
{
	let mine = x;
	return 0;
}

fn main() -> int
{
	let a = maybe(1);
	return keep(a);
}
