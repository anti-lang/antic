//! The six comparisons `== != < <= > >=`, in that order, on every integer type
//! at its limits. Each pair of digits is the answer the checker folds in a
//! constant and the answer the program computes from operands it cannot know
//! before it runs. An unsigned type compares its greatest value as greater than
//! one.

extern fn printf(format: ?*byte, ...) -> c_int;

fn on_i8(z: i8)
{
	const A0: i8 = -128;
	const B0: i8 = 127;
	const F0_eq: bool = A0 == B0;
	let r0_eq = (A0 ^ z) == (B0 ^ z);
	const F0_ne: bool = A0 != B0;
	let r0_ne = (A0 ^ z) != (B0 ^ z);
	const F0_lt: bool = A0 < B0;
