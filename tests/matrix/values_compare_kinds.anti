	let r1_le = (A1 ^ z) <= (B1 ^ z);
	const F1_gt: bool = A1 > B1;
	let r1_gt = (A1 ^ z) > (B1 ^ z);
	const F1_ge: bool = A1 >= B1;
	let r1_ge = (A1 ^ z) >= (B1 ^ z);
