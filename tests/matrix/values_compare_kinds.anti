	const F0_ge: bool = A0 >= B0;
	let r0_ge = (A0 ^ z) >= (B0 ^ z);
	printf("compare i8 -128 127 = %d%d %d%d %d%d %d%d %d%d %d%d\n".ptr, F0_eq as c_int, r0_eq as c_int, F0_ne as c_int, r0_ne as c_int, F0_lt as c_int, r0_lt as c_int, F0_le as c_int, r0_le as c_int, F0_gt as c_int, r0_gt as c_int, F0_ge as c_int, r0_ge as c_int);
