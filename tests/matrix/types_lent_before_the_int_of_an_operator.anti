//! `lent` marks a pointer result. The checker refuses `-> lent int` of
//! `operator fn value` with the message of `-> lent ?int`, by R063 of "Rules of
//! 2026-10-13".

class Walk
{
	pub n: int = 0,

	operator fn next(self) -> bool
	{
		return false;
	}

	operator fn value(self) -> lent int
	{
		return self.n;
	}
}

fn main() -> int
{
	return 0;
}
