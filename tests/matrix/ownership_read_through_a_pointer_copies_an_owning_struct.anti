//! `let` of `*p` where `p` points at a struct that owns something. The value
//! stays where it is, and the copy would give what it owns two owners.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

struct Pair
{
	k: Key,
	n: int,
}

fn pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

fn main() -> int
{
	let a = pair(1);
	let p = &a;
	let b = *p;
	return 0;
}
