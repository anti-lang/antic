//! A field that holds a `?T` of an owning value, named in the literal of
//! another object. The field keeps its value, and the literal would hold a
//! second owner.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn maybe(n: int) -> ?Key
{
	return key(n);
}

class Holder
{
	pub held: ?Key,
}

fn main() -> int
{
	let h = Holder { held: maybe(1) };
	let other = Holder { held: h.held };
	return 0;
}
