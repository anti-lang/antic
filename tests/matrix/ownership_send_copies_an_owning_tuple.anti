//! `send` of a local that holds a tuple that owns something. The channel would
//! hold a copy, and the local would stay a second owner.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn main() -> int
{
	let c = chan (Key, int)(1);
	let a = tuple(1);
	send(c, a);
	delete(c);
	return 0;
}
