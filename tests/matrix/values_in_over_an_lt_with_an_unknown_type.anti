//! `p in lo..hi` over a struct whose `operator fn lt` at module level names a
//! type that is not there. The declaration is the mistake and gets the one
//! message, and `in` gives none.

struct Pair
{
	v: int,
}

operator fn lt(a: Pair, b: Missing) -> bool
{
	return true;
}

fn main() -> int
{
	let p = Pair { v: 1 };
	if p in p..p {
		return 1;
	}
	return 0;
}
