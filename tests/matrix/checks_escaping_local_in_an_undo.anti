//! E1 in an undo: the block of the fail path stores the address of a local into
//! a static field, a global, which outlives the local.
import anti.lang;

class Last
{
	pub static atomic seen: ?*int = none;
}

fn remember(k: int) may fail
{
	let x = k;
	undo {
		Last.seen.store(&x);
	}
	fail "undone";
}

fn main() -> int
{
	remember(4) catch e {
		return 0;
	};
	return 1;
}
