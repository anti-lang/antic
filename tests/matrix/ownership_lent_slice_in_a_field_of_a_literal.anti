//! The literal of an object names a lent slice as a field. The object could
//! outlive the call.

class Node
{
	pub n: int = 0,
}

class Holder
{
	pub p: ?*Node = none,
	pub s: []int,
}

fn run(lent s: []int) -> int
{
	let h = Holder { s: s };
	return 0;
}

fn main() -> int
{
	let numbers = [1, 2];
	return run(numbers[0..2]);
}
