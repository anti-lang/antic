//! A byte pattern in the mode `(?x)` holds a comment from `#` to the end of the
//! line. A `[^é]` there is no class, so the pattern compiles, as the same text
//! compiles as a `Regex`.

import anti.io;
import anti.regex;
import anti.text;

fn main() -> int
{
	let data = "xab".to_bytes();
	let found = data.matches(re"(?x) a # [^é]
		b");
	if found {
		io.println("matched");
	}
	free(data.ptr);
	return 0;
}
