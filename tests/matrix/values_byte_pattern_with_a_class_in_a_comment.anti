//! A byte pattern in the mode `(?x)` holds a comment from `#` to the end of the
//! line. A `[^é]` there is no class, so the pattern compiles, as the same text
//! compiles as a `Regex`.

import anti.io;
import anti.regex;
import anti.text;

fn main() -> int
{
	let r = ByteRegex.compile("(?x) a # [^é] \n b") catch {
		io.println("refused");
		return 0;
	};
	io.println("compiled");
	let data = "xab".to_bytes();
	let found = data.matches(r) catch {
		free(data.ptr);
		return 0;
	};
	if found {
		io.println("matched");
	} else {
		io.println("no match");
	}
	free(data.ptr);
	return 0;
}
