//! A struct raised to the alignment of a cache line: its size, the size of an
//! array of it, a field of a struct that holds one, and `alloc(T, n)` of it,
//! whose elements are written and read back.

import anti.io;
import anti.text;

struct Line align(64)
{
	hits: int,
}

struct Holder
{
	tag: u8,
	line: Line,
}

fn say(s: str)
{
	io.println(s);
	free(s.ptr);
}

fn main() -> int
{
	let arr: [4]Line = [Line { hits: 1 }; 4];
	say(f"{size_of(Line)} {size_of([4]Line)} {size_of(Holder)}");
	let p = alloc(Line, 3) else {
		return 1;
	};
	let lines = []Line { ptr: p, len: 3 };
	for i in 0..3 {
		lines[i].hits = i + arr[i].hits;
	}
	say(f"{lines[0].hits} {lines[2].hits}");
	free(p);
	return 0;
}
