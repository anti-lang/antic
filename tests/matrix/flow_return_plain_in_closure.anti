//! A `return` without a value in a closure ends the closure and not the
//! function around it.

extern fn printf(format: ?*byte, ...) -> c_int;

fn each(count: int, f: fn(int))
{
	for i in 0..count {
		f(i);
	}
}

fn run(n: int, out: *int)
{
	let acc = 0;
	each(4, fn(i) {
		if i == n {
			return;
		}
		acc += i + 1;
	});
	*out = acc + 100;
}

fn main() -> int
{
	let got = 0;
	for n in 1..4 {
		got = 0;
		run(n, &got);
		printf("%d\n".ptr, got as c_int);
	}
	return 0;
}
