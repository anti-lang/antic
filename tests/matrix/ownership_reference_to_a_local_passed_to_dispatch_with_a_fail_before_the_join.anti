//! A `fail` between `dispatch` and its `join` leaves the block of the local
//! while the job may still run, so the address of the local is refused.

import anti.lang;

class Counter
{
	pub n: int = 0,
}

worker fn bump(c: *Counter, by: int) -> int
{
	c.n += by;
	return c.n;
}

fn run(n: int) -> int may fail
{
	let c = Counter { };
	let job = dispatch &c -> bump(1);
	if n < 0 {
		fail "below zero";
	}
	return join(job) + n;
}

fn main() -> int
{
	let r = run(0) catch fatal;
	return r - 1;
}
