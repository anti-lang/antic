//! `dispatch` hands its object to another thread until the job is joined, so
//! the address of a local is refused there when the block of the local joins
//! the job on one path alone.

class Counter
{
	pub n: int = 0,
}

worker fn bump(c: *Counter, by: int) -> int
{
	c.n += by;
	return c.n;
}

fn run(wait: bool) -> int
{
	let c = Counter { };
	let job = dispatch &c -> bump(1);
	if wait {
		return join(job);
	}
	return 0;
}

fn main() -> int
{
	return run(true) - 1;
}
