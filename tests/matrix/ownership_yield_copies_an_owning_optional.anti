//! `yield` of a local that holds a `?T` of an owning value. The value of the
//! `catch` would be a copy, and the local would stay a second owner.

import anti.lang;

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn maybe(n: int) -> ?Key
{
	return key(n);
}

fn failing(n: int) -> ?Key may fail
{
	if n > 0 {
		fail "refused";
	}
	return maybe(n);
}

fn main() -> int
{
	let a = maybe(1);
	let b = failing(1) catch e {
		yield a;
	};
	return 0;
}
