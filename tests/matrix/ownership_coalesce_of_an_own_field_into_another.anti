//! `b.one ?? alloc Node { }` stored into another `own` field. The value may be
//! the pointer `b.one` owns, so `b.two` would own it as well, and it is refused
//! as `b.two = b.one;` is.

class Node
{
	pub n: int = 0,
}

class Box
{
	pub own one: ?*Node = none,
	pub own two: ?*Node = none,
}

fn main() -> int
{
	let b = Box { };
	b.one = alloc Node { n: 1 };
	b.two = b.one ?? alloc Node { n: 2 };
	return 0;
}
