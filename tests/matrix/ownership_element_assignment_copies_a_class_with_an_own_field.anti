//! `=` of a local that holds a class with an `own` field to an element of an
//! array. The copy would give what the value owns two owners.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn main() -> int
{
	let a = key(1);
	let xs = [key(2), key(3)];
	xs[0] = a;
	return 0;
}
