	if !ok {
		fail "no variant";
	}
	return v;
}

fn kind_variant(ok: bool, a: Shape, b: Shape) -> int
{
	let got = give_variant(ok, a) catch {
		yield b;
	};
	return ((got is Shape.Circle) as c_int) as int;
}

fn give_function(ok: bool, keep v: Op) -> Op may fail
{
	if !ok {
		fail "no function value";
	}
	return v;
}

fn kind_function(ok: bool, keep a: Op, keep b: Op) -> int
{
	let got = give_function(ok, a) catch {
		yield b;
	};
	return (got(5) as c_int) as int;
}

fn give_failing(ok: bool, keep v: Risky) -> Risky may fail
{
	if !ok {
		fail "no may-fail function value";
	}
	return v;
}

fn kind_failing(ok: bool, keep a: Risky, keep b: Risky) -> int
{
	let got = give_failing(ok, a) catch {
		yield b;
	};
	return (result_of(got) as c_int) as int;
}

