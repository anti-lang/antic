{
	if !ok {
		fail "no interface";
	}
	return v;
}

fn kind_interface(ok: bool, a: *Named, b: *Named) -> int
{
	let got = give_interface(ok, a) catch {
		yield b;
	};
	return (got.id() as c_int) as int;
}

fn give_nullable(ok: bool, v: ?*int) -> ?*int may fail
{
	if !ok {
		fail "no nullable pointer";
	}
	return v;
}

fn kind_nullable(ok: bool, a: ?*int, b: ?*int) -> int
{
	let got = give_nullable(ok, a) catch {
		yield b;
	};
	return (pointee(got) as c_int) as int;
}

fn give_optional(ok: bool, v: ?int) -> ?int may fail
{
	if !ok {
		fail "no optional value";
	}
	return v;
}

fn kind_optional(ok: bool, a: ?int, b: ?int) -> int
{
	let got = give_optional(ok, a) catch {
		yield b;
	};
	return ((got ?? -7) as c_int) as int;
}

fn main() -> int
{
	let one = 1;
	let two = 2;
	let numbers = [1, 2, 3, 4];
	let c1 = chan int(1);
	let c2 = chan int(1);
	send(c1, 31);
	send(c2, 32);
	let counter_a = alloc Counter { n: 3 };
	let counter_b = alloc Counter { n: 4 };
	let gauge_a = alloc Gauge { };
	let gauge_b = alloc Gauge { };
	gauge_a.n.store(5);
	gauge_b.n.store(6);
	let tag_a = alloc Tag { n: 7 };
	let tag_b = alloc Tag { n: 8 };
	printf("i8: %d %d\n".ptr, kind_i8(true, -3, 5) as c_int,
		kind_i8(false, -3, 5) as c_int);
	printf("i16: %d %d\n".ptr, kind_i16(true, -300, 500) as c_int,
		kind_i16(false, -300, 500) as c_int);
	printf("i32: %d %d\n".ptr, kind_i32(true, 70000, -5) as c_int,
		kind_i32(false, 70000, -5) as c_int);
	printf("i64: %d %d\n".ptr, kind_i64(true, 5000000000, 6) as c_int,
		kind_i64(false, 5000000000, 6) as c_int);
	printf("int: %d %d\n".ptr, kind_int(true, 6, 7) as c_int,
		kind_int(false, 6, 7) as c_int);
	printf("u8: %d %d\n".ptr, kind_u8(true, 200, 5) as c_int,
		kind_u8(false, 200, 5) as c_int);
	printf("u16: %d %d\n".ptr, kind_u16(true, 60000, 5) as c_int,
		kind_u16(false, 60000, 5) as c_int);
	printf("u32: %d %d\n".ptr, kind_u32(true, 4000000000, 5) as c_int,
		kind_u32(false, 4000000000, 5) as c_int);
	printf("u64: %d %d\n".ptr, kind_u64(true, 8, 9) as c_int,
		kind_u64(false, 8, 9) as c_int);
	printf("uint: %d %d\n".ptr, kind_uint(true, 9, 10) as c_int,
		kind_uint(false, 9, 10) as c_int);
	printf("byte: %d %d\n".ptr, kind_byte(true, 10, 11) as c_int,
		kind_byte(false, 10, 11) as c_int);
	printf("f32: %d %d\n".ptr, kind_f32(true, 1.5, 2.5) as c_int,
		kind_f32(false, 1.5, 2.5) as c_int);
	printf("f64: %d %d\n".ptr, kind_f64(true, 2.25, 3.5) as c_int,
		kind_f64(false, 2.25, 3.5) as c_int);
	printf("bool: %d %d\n".ptr, kind_bool(true, true, false) as c_int,
		kind_bool(false, true, false) as c_int);
	printf("char: %d %d\n".ptr, kind_char(true, 'x', 'y') as c_int,
		kind_char(false, 'x', 'y') as c_int);
	printf("str: %d %d\n".ptr, kind_str(true, "four", "sevens") as c_int,
		kind_str(false, "four", "sevens") as c_int);
	printf("slice: %d %d\n".ptr, kind_slice(true, numbers[0..2], numbers[0..3]) as c_int,
		kind_slice(false, numbers[0..2], numbers[0..3]) as c_int);
	printf("fixed array: %d %d\n".ptr, kind_array(true, [1, 2, 3], [4, 5, 6]) as c_int,
		kind_array(false, [1, 2, 3], [4, 5, 6]) as c_int);
	printf("pointer: %d %d\n".ptr, kind_pointer(true, &one, &two) as c_int,
		kind_pointer(false, &one, &two) as c_int);
	printf("tuple: %d %d\n".ptr, kind_tuple(true, (1, 2), (3, 4)) as c_int,
		kind_tuple(false, (1, 2), (3, 4)) as c_int);
	printf("struct: %d %d\n".ptr, kind_struct(true, Point { x: 1, y: 2 }, Point { x: 3, y: 4 }) as c_int,
		kind_struct(false, Point { x: 1, y: 2 }, Point { x: 3, y: 4 }) as c_int);
	printf("packed struct: %d %d\n".ptr, kind_packed(true, Record { tag: 1, n: 2 }, Record { tag: 3, n: 4 }) as c_int,
		kind_packed(false, Record { tag: 1, n: 2 }, Record { tag: 3, n: 4 }) as c_int);
	printf("simd struct: %d %d\n".ptr, kind_simd(true, Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 4.0 }, Vec4 { x: 5.0, y: 6.0, z: 7.0, w: 8.0 }) as c_int,
		kind_simd(false, Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 4.0 }, Vec4 { x: 5.0, y: 6.0, z: 7.0, w: 8.0 }) as c_int);
	printf("union: %d %d\n".ptr, kind_union(true, Word { n: 7 }, Word { n: 8 }) as c_int,
		kind_union(false, Word { n: 7 }, Word { n: 8 }) as c_int);
	printf("enum: %d %d\n".ptr, kind_enum(true, Level.High, Level.Low) as c_int,
		kind_enum(false, Level.High, Level.Low) as c_int);
	printf("variant: %d %d\n".ptr, kind_variant(true, Shape.Circle { r: 3 }, Shape.Empty) as c_int,
		kind_variant(false, Shape.Circle { r: 3 }, Shape.Empty) as c_int);
	printf("function value: %d %d\n".ptr, kind_function(true, twice, thrice) as c_int,
		kind_function(false, twice, thrice) as c_int);
	printf("may-fail function value: %d %d\n".ptr, kind_failing(true, failing, passing) as c_int,
		kind_failing(false, failing, passing) as c_int);
	printf("channel: %d %d\n".ptr, kind_channel(true, c1, c2) as c_int,
		kind_channel(false, c1, c2) as c_int);
	printf("class: %d %d\n".ptr, kind_class(true, Plain { n: 11 }, Plain { n: 12 }) as c_int,
		kind_class(false, Plain { n: 11 }, Plain { n: 12 }) as c_int);
	printf("synchronized class: %d %d\n".ptr, kind_synchronized(true, counter_a, counter_b) as c_int,
		kind_synchronized(false, counter_a, counter_b) as c_int);
	printf("concurrent class: %d %d\n".ptr, kind_concurrent(true, gauge_a, gauge_b) as c_int,
		kind_concurrent(false, gauge_a, gauge_b) as c_int);
	printf("interface: %d %d\n".ptr, kind_interface(true, tag_a, tag_b) as c_int,
		kind_interface(false, tag_a, tag_b) as c_int);
	printf("nullable pointer: %d %d\n".ptr, kind_nullable(true, &one, none) as c_int,
		kind_nullable(false, &one, none) as c_int);
	printf("optional value: %d %d\n".ptr, kind_optional(true, 5, none) as c_int,
		kind_optional(false, 5, none) as c_int);
	delete(tag_b);
	delete(tag_a);
	delete(gauge_b);
	delete(gauge_a);
	delete(counter_b);
	delete(counter_a);
	delete(c2);
	delete(c1);
	return 0;
}

type Op = fn(int) -> int;

type Risky = fn(int) -> int may fail;
