{
	if !ok {
		fail "no concurrent class";
	}
	return v;
}

fn kind_concurrent(ok: bool, a: *Gauge, b: *Gauge) -> int
{
	let got = give_concurrent(ok, a) catch {
		yield b;
	};
	return (got.n.load() as c_int) as int;
}

