//! `yield` of a value of each kind. A function per kind may fail and gives a
//! value of the kind, and the handler of its call yields another one. Each line
//! prints the value the call gave and the value the handler gave.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

struct Point
{
	x: int,
	y: int,
}

packed struct Record
{
	tag: u8,
	n: int,
}

simd struct Vec4 { x: f32, y: f32, z: f32, w: f32 }

union Word
{
	n: int,
	f: f32,
}

enum Level
{
	Low,
	High,
}

variant Shape
{
	Circle { r: int },
	Empty,
}

synchronized class Counter
{
	pub n: int = 0,

	pub fn get(self) -> int
	{
		return self.n;
	}
}

concurrent class Gauge
{
	pub atomic n: int = 0,
}

abstract class Named
{
	pub abstract fn id(self) -> int;
}

class Tag inherits Named
{
	pub n: int = 0,

	pub concrete fn id(self) -> int
	{
		return self.n;
	}
}

class Plain
{
	pub n: int = 0,
}

fn twice(n: int) -> int
{
	return n * 2;
}

fn thrice(n: int) -> int
{
	return n * 3;
}

fn failing(n: int) -> int may fail
{
	if n > 0 {
		fail "refused";
	}
	return n + 100;
}

fn passing(n: int) -> int may fail
{
	if n < 0 {
		fail "refused";
	}
	return n + 200;
}

fn result_of(f: fn(int) -> int may fail) -> int
{
	let got = f(0) catch {
		yield -1;
	};
	return got;
}

fn mark_of(c: chan int) -> int
{
	let p = recv(c) else {
		return -1;
	};
	let mark = *p;
	send(c, mark);
	return mark;
}

fn pointee(p: ?*int) -> int
{
	if let q = p {
		return *q;
	}
	return -7;
}

fn give_i8(ok: bool, v: i8) -> i8 may fail
{
	if !ok {
		fail "no i8";
	}
	return v;
}

fn kind_i8(ok: bool, a: i8, b: i8) -> int
{
	let got = give_i8(ok, a) catch {
		yield b;
	};
	return (got as c_int) as int;
}

fn give_i16(ok: bool, v: i16) -> i16 may fail
{
	if !ok {
		fail "no i16";
	}
	return v;
}

fn kind_i16(ok: bool, a: i16, b: i16) -> int
{
	let got = give_i16(ok, a) catch {
		yield b;
	};
	return (got as c_int) as int;
}

fn give_i32(ok: bool, v: i32) -> i32 may fail
{
	if !ok {
		fail "no i32";
	}
	return v;
}

fn kind_i32(ok: bool, a: i32, b: i32) -> int
{
	let got = give_i32(ok, a) catch {
		yield b;
	};
	return (got as c_int) as int;
}

fn give_i64(ok: bool, v: i64) -> i64 may fail
{
	if !ok {
		fail "no i64";
	}
	return v;
}

fn kind_i64(ok: bool, a: i64, b: i64) -> int
{
	let got = give_i64(ok, a) catch {
		yield b;
	};
	return ((got / 1000000) as c_int) as int;
}

