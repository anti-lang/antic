{
	let got = give_class(ok, a) catch {
		yield b;
	};
	return (got.n as c_int) as int;
}

fn give_synchronized(ok: bool, v: *Counter) -> *Counter may fail
{
	if !ok {
		fail "no synchronized class";
	}
	return v;
}

fn kind_synchronized(ok: bool, a: *Counter, b: *Counter) -> int
{
	let got = give_synchronized(ok, a) catch {
		yield b;
	};
	return (got.get() as c_int) as int;
}

