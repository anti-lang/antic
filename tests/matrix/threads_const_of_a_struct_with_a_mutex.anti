//! A constant of a struct that holds a Mutex. The literal leaves the Mutex out,
//! so the constant holds a free lock, and a read of another field gives the
//! value of the literal.

extern fn printf(format: ?*byte, ...) -> c_int;

struct Guard
{
	lock: Mutex,
	n: int,
}

const START: Guard = Guard { n: 7 };

fn main() -> int
{
	printf("%d\n".ptr, START.n as c_int);
	return 0;
}
