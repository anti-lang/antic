//! A constant of a struct that holds a Mutex is refused, by R047 of "Rules of
//! 2026-10-13": a constant is a value of the program text, and a lock is a
//! place that threads share.

struct Guard
{
	lock: Mutex,
	n: int,
}

const START: Guard = Guard { n: 7 };

fn main() -> int
{
	return START.n;
}
