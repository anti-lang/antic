//! `return` of a parameter that is not `own` and holds a class with an `own`
//! field. The value belongs to the caller, which tears it down.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn back(x: Key) -> Key
{
	return x;
}

fn main() -> int
{
	let a = key(1);
	let b = back(a);
	return 0;
}
