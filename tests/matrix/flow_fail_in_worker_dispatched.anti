//! A `worker fn` that may fail and holds a `fail` is refused at its `dispatch`.
//! R013 of the rules of 2026-10-13 keeps the refusal, and its message names the
//! reason and counts no out pointer.

import anti.lang;

class Task
{
	pub n: int = 0,
}

worker fn run(t: *Task) -> int may fail
{
	if t.n > 2 {
		fail "too large";
	}
	return t.n;
}

fn main() -> int
{
	let t = alloc Task { };
	let job = dispatch t -> run();
	let got = join(job);
	delete(t);
	return got;
}
