//! A class that replaces `equals`, beside an `operator fn hash` at module level
//! that names a type that is not there. The declaration is the mistake and gets
//! the one message, and the class does not lack its hash.

class Point
{
	pub x: int = 0,

	concrete fn equals(self, other: *Object) -> bool
	{
		return true;
	}
}

operator fn hash(a: Point, b: Missing) -> u64
{
	return 1;
}

fn main() -> int
{
	return 0;
}
