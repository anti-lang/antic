fn on_byte(z: byte)
{
	const A0: byte = 255;
	const N0: byte = ~A0;
	let n0: byte = ~(A0 ^ z);
	printf("not byte 255 = %llu %llu\n".ptr, N0 as u64, n0 as u64);
	const A1: byte = 0;
	const N1: byte = ~A1;
	let n1: byte = ~(A1 ^ z);
