//! Unary `~` on every integer type and unary `-` on every signed one, at the
//! limits of the type. Each line holds the value the checker folds in a
//! constant and the value the program computes. `-` of the least value gives
//! the least value in every build, and no check stops it.

extern fn printf(format: ?*byte, ...) -> c_int;

fn on_i8(z: i8)
{
	const A0: i8 = 127;
	const N0: i8 = ~A0;
	let n0: i8 = ~(A0 ^ z);
	printf("not i8 127 = %lld %lld\n".ptr, N0 as int, n0 as int);
	const M0: i8 = -A0;
	let m0: i8 = -(A0 ^ z);
	printf("neg i8 127 = %lld %lld\n".ptr, M0 as int, m0 as int);
	const A1: i8 = -128;
	const N1: i8 = ~A1;
	let n1: i8 = ~(A1 ^ z);
	printf("not i8 -128 = %lld %lld\n".ptr, N1 as int, n1 as int);
	const M1: i8 = -A1;
	let m1: i8 = -(A1 ^ z);
	printf("neg i8 -128 = %lld %lld\n".ptr, M1 as int, m1 as int);
	const A2: i8 = 0;
	const N2: i8 = ~A2;
	let n2: i8 = ~(A2 ^ z);
	printf("not i8 0 = %lld %lld\n".ptr, N2 as int, n2 as int);
	const M2: i8 = -A2;
	let m2: i8 = -(A2 ^ z);
	printf("neg i8 0 = %lld %lld\n".ptr, M2 as int, m2 as int);
	const A3: i8 = 1;
	const N3: i8 = ~A3;
	let n3: i8 = ~(A3 ^ z);
	printf("not i8 1 = %lld %lld\n".ptr, N3 as int, n3 as int);
	const M3: i8 = -A3;
	let m3: i8 = -(A3 ^ z);
	printf("neg i8 1 = %lld %lld\n".ptr, M3 as int, m3 as int);
	const A4: i8 = 5;
	const N4: i8 = ~A4;
	let n4: i8 = ~(A4 ^ z);
	printf("not i8 5 = %lld %lld\n".ptr, N4 as int, n4 as int);
	const M4: i8 = -A4;
	let m4: i8 = -(A4 ^ z);
	printf("neg i8 5 = %lld %lld\n".ptr, M4 as int, m4 as int);
	const A5: i8 = -1;
	const N5: i8 = ~A5;
	let n5: i8 = ~(A5 ^ z);
	printf("not i8 -1 = %lld %lld\n".ptr, N5 as int, n5 as int);
	const M5: i8 = -A5;
	let m5: i8 = -(A5 ^ z);
	printf("neg i8 -1 = %lld %lld\n".ptr, M5 as int, m5 as int);
	const A6: i8 = -127;
	const N6: i8 = ~A6;
	let n6: i8 = ~(A6 ^ z);
	printf("not i8 -127 = %lld %lld\n".ptr, N6 as int, n6 as int);
	const M6: i8 = -A6;
	let m6: i8 = -(A6 ^ z);
	printf("neg i8 -127 = %lld %lld\n".ptr, M6 as int, m6 as int);
}

