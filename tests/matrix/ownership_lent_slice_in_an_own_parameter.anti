//! A lent slice passed to an `own` parameter, which takes over what it is
//! given. The lender still owns it.

class Node
{
	pub n: int = 0,
}

fn take_it(own p: *Node) -> int
{
	return p.n;
}

fn take_all(own s: []int) -> int
{
	return s.len;
}

fn run(lent s: []int) -> int
{
	return take_all(s);
}

fn main() -> int
{
	let numbers = [1, 2];
	return run(numbers[0..2]);
}
