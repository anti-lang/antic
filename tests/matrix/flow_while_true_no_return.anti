//! A `while true` without a `break` of its own ends the path of its function,
//! by R003 of the rules of 2026-10-13, so no `return` follows it.

extern fn printf(format: ?*byte, ...) -> c_int;

fn forever(n: int) -> int
{
	let i = 0;
	while true do {
		if i * i >= n {
			return i;
		}
		i += 1;
	}
}

fn main() -> int
{
	printf("%d %d\n".ptr, forever(1) as c_int, forever(17) as c_int);
	return 0;
}
