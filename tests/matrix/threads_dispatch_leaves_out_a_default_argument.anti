//! A `dispatch` and a `parallel` fill in the default value of a parameter of
//! the worker that they leave out, as a call does. A worker named without
//! parentheses takes every default, and an argument that is written wins.

extern fn printf(format: ?*byte, ...) -> c_int;

class Task
{
	pub n: int = 0,
}

worker fn add(t: *Task, k: int = 5, scale: int = 2) -> int
{
	return (t.n + k) * scale;
}

worker fn sum(chunk: []int, plus: int = 100) -> int
{
	let n = plus;
	for v in chunk {
		n += v;
	}
	return n;
}

fn main() -> int
{
	let t = alloc Task { n: 1 };
	let bare = dispatch t -> add;
	printf("no parentheses: %d\n".ptr, join(bare) as c_int);
	let empty = dispatch t -> add();
	printf("no argument: %d\n".ptr, join(empty) as c_int);
	let one = dispatch t -> add(9);
	printf("one argument: %d\n".ptr, join(one) as c_int);
	let both = dispatch t -> add(9, 3);
	printf("both arguments: %d\n".ptr, join(both) as c_int);
	delete(t);

	let items = [1, 2, 3, 4];
	unchecked(escaping-local, "until the step sweep")
	let parts = parallel items[0..4] by 2 -> sum;
	printf("parallel: %d %d\n".ptr, parts[0] as c_int, parts[1] as c_int);
	free(parts.ptr);
	return 0;
}
