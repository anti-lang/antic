//! The values that the safety check `index-out-of-range` follows through forms
//! of their own, each in an index that the check proves in range or cannot
//! prove out of range, so it refuses none. A difference of an unknown from
//! itself, a copy of a slice, a literal `str`, a loop variable on the right of
//! a sum, a step over an unknown length, a product by zero, a product and a
//! difference that leave the bound the check follows, an unknown on both sides
//! of a sum, a carry, a loop body that a `try` or a walk of a collection may
//! leave, and a loop body whose every statement the check walks. A dev build
//! checks each index the check allows.
//!
//! The forms after `walked_body` follow. Constants and sums past the bound, the
//! length of a slice as the index of an array, and a loop whose bounds name
//! another loop variable or a parameter. Parts of a slice whose bounds the
//! check cannot follow, a copy of a slice that changes, and products of loop
//! variables, of parameters and of an unknown. A field named `len`, and a loop
//! body that a `try` block, `catch fatal`, a call that never returns, `fail`, a
//! `while`, a `do`, a `fallthrough` or a `yield` may leave. A copy of a slice
//! that a closure captures, the complement `~`, the least step, an array past
//! the bound, a slice literal in a loop, and a loop body with nine indices
//! beside `&&`, `||` and `??` in a function of five loops.
import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

const NEAR_BOUND: int = 1099511627775;
const PAST_BOUND: int = 1099511627776;
const BELOW_BOUND: int = -1099511627776;

struct Span
{
	len: int,
}

fn opaque(n: int) -> int
{
	return n;
}

fn difference(k: int) -> int
{
	let xs = [1, 2, 3];
	return xs[k - k + 2];
}

fn copied(s: []int) -> int
{
	let t = s;
	return t[t.len - 1];
}

fn literal_text() -> byte
{
	return "abc"[2];
}

fn sum_on_the_right() -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len - 1 {
		total += xs[1 + i];
	}
	return total;
}

fn step_over_a_length(s: []int) -> int
{
	let total = 0;
	for i in 0..s.len + 1 by 2 {
		total += s[i];
	}
	return total;
}

fn times_zero() -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len {
		total += xs[i * 0];
	}
	return total;
}

fn product_past_the_bound(s: []int) -> int
{
	let total = 0;
	for i in 0..2000 {
		if opaque(i) < s.len {
			total += s[i * 1000000000];
		}
	}
	return total;
}

fn difference_past_the_bound(s: []int) -> int
{
	let total = 0;
	for i in -2..0 {
		if opaque(i) > 0 {
			total += s[NEAR_BOUND - i];
		}
	}
	return total;
}

fn unknown_on_both_sides(n: int, s: []int) -> int
{
	let total = 0;
	for i in 0..s.len + 1 {
		if opaque(i) < 0 {
			total += s[n + i] + s[5 - i];
		}
	}
	return total;
}

fn with_a_carry(a: int, b: int) -> int
{
	let xs = [1, 2, 3];
	let (sum, f) = a + b;
	return xs[a + b + f.carry] + sum;
}

fn checked(n: int) -> int may fail
{
	if n < 0 {
		fail "below zero";
	}
	return n;
}

fn with_a_try() -> int may fail
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len {
		total += try checked(i);
		total += xs[i];
	}
	return total;
}

fn with_a_walk() -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len {
		for x in xs {
			total += x;
		}
		total += xs[i];
	}
	return total;
}

fn walked_body() -> int
{
	let xs = [1, 2, 3];
	let m = Mutex.new();
	let total = 0;
	for i in 0..xs.len {
		let pair = (xs[i], 0);
		let three = [xs[i], 0, 0];
		let part = xs[0..xs[i] - xs[i] + 1];
		{
			total += xs[i];
		}
		sync m {
			total += xs[i];
		}
		switch xs[i] {
			1 => total += pair.0,
			else => total += three[0] + part[0],
		}
		defer total += 0;
	}
	return total;
}

fn constants_past_the_bound(s: []int) -> int
{
	if opaque(s.len) < 0 {
		return s[PAST_BOUND] + s[BELOW_BOUND];
	}
	return 0;
}

fn slice_length_on_an_array(s: []int) -> int
{
	let xs = [1, 2, 3];
	return xs[s.len];
}

fn sums_past_the_bound(s: []int) -> int
{
	let total = 0;
	for i in 1..3 {
		if opaque(i) < 0 {
			total += s[-NEAR_BOUND - i] + s[NEAR_BOUND + i] +
				s[i + (NEAR_BOUND - 1)];
		}
	}
	for i in -1..1 {
		if opaque(i) > 5 {
			total += s[NEAR_BOUND - i];
		}
	}
	return total;
}

fn bounds_of_a_variable(n: int) -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..2 {
		for j in i..3 {
			total += xs[j] + xs[i + j - i];
		}
	}
	for i in n..n + 2 {
		if opaque(i) < 0 {
			total += xs[i] + xs[5 - i];
		}
	}
	for i in n..n + 4 by 2 {
		if opaque(i) < 0 {
			total += xs[i];
		}
	}
	return total;
}

fn parts_of_a_slice(s: []int, n: int, m: int) -> int
{
	let total = 0;
	for i in 0..2 {
		let low = s[i..3];
		let high = s[0..i + 1];
		total += low[0] + high[0];
	}
	if opaque(n) < 0 {
		let between = s[n..m];
		let crossed = s[3..1];
		total += between[0] + crossed[0];
	}
	return total;
}

fn changed_copy(s: []int) -> int
{
	let u = s;
	u = s;
	let t = u;
	return t[t.len - 1];
}

fn products(s: []int, n: int, m: int) -> int
{
	let xs = [1, 2, 3, 4, 5];
	let total = xs[opaque(1) * 2];
	for i in 0..2 {
		total += xs[i * 2] + xs[2 * i];
		for j in 0..2 {
			total += xs[i * j];
		}
	}
	for i in 0..s.len + 1 {
		if opaque(i) < 0 {
			total += xs[i * 2];
		}
	}
	if opaque(n) < 0 {
		total += xs[n * m] + xs[2 * n];
	}
	for i in 2000..2002 {
		if opaque(i) < 0 {
			total += s[i * 1000000000];
		}
	}
	return total;
}

fn field_named_len(span: Span) -> int
{
	let xs = [1, 2, 3];
	return xs[span.len];
}

fn stop() -> never
{
	while true do {
	}
}

fn left_by_a_try_block() -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len + 1 {
		try {
			total += checked(xs.len - 1 - i);
		} catch e {
			return total;
		}
		total += xs[i];
	}
	return total;
}

fn left_by_a_fatal_handler() -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len {
		total += checked(i) catch fatal;
		total += xs[i];
	}
	return total;
}

fn left_by_a_call_that_never_returns() -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len + 1 {
		if opaque(i) > xs.len {
			stop();
		}
		if i == xs.len {
			return total;
		}
		total += xs[i];
	}
	return total;
}

fn left_by_a_failure() -> int may fail
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len + 1 {
		if i == xs.len {
			fail "past the end";
		}
		total += xs[i];
	}
	return total;
}

fn left_by_a_while() -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len + 1 {
		while i == xs.len do {
			return total;
		}
		total += xs[i];
	}
	return total;
}

fn left_by_a_do() -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len + 1 {
		do {
			if i == xs.len {
				return total;
			}
		} while false
		total += xs[i];
	}
	return total;
}

fn left_by_a_fallthrough() -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len + 1 {
		switch i {
			3 => {
				fallthrough;
			},
			else => {
				if i == xs.len {
					return total;
				}
			},
		}
		total += xs[i];
	}
	return total;
}

fn left_by_a_yield() -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len + 1 {
		total += checked(xs.len - 1 - i) catch {
			yield 0;
		};
		if i == xs.len {
			return total;
		}
		total += xs[i];
	}
	return total;
}

fn captured_copy(s: []int) -> int
{
	let t = s;
	let f = fn() -> int {
		return t.len;
	};
	return t[t.len - 1] + f();
}

fn complement() -> int
{
	let xs = [1, 2, 3];
	return xs[~opaque(-2)];
}

fn least_step() -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..3 by -9223372036854775807 - 1 {
		total += xs[i];
	}
	return total;
}

fn huge_array(p: *[1099511627776]int) -> int
{
	let k = 3;
	return (*p)[k];
}

fn slice_literal_in_a_loop(p: *int) -> int
{
	let total = 0;
	for i in 1..3 {
		let s = []int { ptr: p, len: i };
		total += s[0];
	}
	return total;
}

fn many_indices(v: ?int) -> int
{
	let xs = [1, 2, 3];
	let total = 0;
	for i in 0..xs.len {
		let small = xs[i] > 0 && xs[i] < 9 || xs[i] == 5;
		total += v ?? xs[i];
		total += xs[i] + xs[i] + xs[i] + xs[i] + xs[i] + xs[i] + xs[i] + xs[i];
		if small {
			total += 1;
		}
	}
	for i in 0..xs.len {
		total += xs[i];
	}
	for i in 0..xs.len {
		total += xs[i];
	}
	for i in 0..xs.len {
		total += xs[i];
	}
	for i in 0..xs.len {
		total += xs[i];
	}
	return total;
}

fn main() -> int
{
	let xs = [1, 2, 3];
	printf("a difference: %d\n".ptr, difference(5) as c_int);
	printf("a copy: %d\n".ptr, copied(xs[0..3]) as c_int);
	printf("a literal: %c\n".ptr, literal_text() as c_int);
	printf("a sum on the right: %d\n".ptr, sum_on_the_right() as c_int);
	printf("a step over a length: %d\n".ptr,
		step_over_a_length(xs[0..3]) as c_int);
	printf("times zero: %d\n".ptr, times_zero() as c_int);
	printf("a product past the bound: %d\n".ptr,
		product_past_the_bound(xs[0..0]) as c_int);
	printf("a difference past the bound: %d\n".ptr,
		difference_past_the_bound(xs[0..3]) as c_int);
	printf("unknown on both sides: %d\n".ptr,
		unknown_on_both_sides(4, xs[0..3]) as c_int);
	printf("with a carry: %d\n".ptr, with_a_carry(0, 1) as c_int);
	let tried = with_a_try() catch e {
		return 1;
	};
	printf("with a try: %d\n".ptr, tried as c_int);
	printf("with a walk: %d\n".ptr, with_a_walk() as c_int);
	printf("a walked body: %d\n".ptr, walked_body() as c_int);
	printf("constants past the bound: %d\n".ptr,
		constants_past_the_bound(xs[0..3]) as c_int);
	printf("the length of a slice on an array: %d\n".ptr,
		slice_length_on_an_array(xs[0..2]) as c_int);
	printf("sums past the bound: %d\n".ptr,
		sums_past_the_bound(xs[0..3]) as c_int);
	printf("bounds of a variable: %d\n".ptr, bounds_of_a_variable(0) as c_int);
	printf("parts of a slice: %d\n".ptr,
		parts_of_a_slice(xs[0..3], 0, 1) as c_int);
	printf("a changed copy: %d\n".ptr, changed_copy(xs[0..3]) as c_int);
	printf("products: %d\n".ptr, products(xs[0..3], 0, 0) as c_int);
	printf("a field named len: %d\n".ptr,
		field_named_len(Span { len: 1 }) as c_int);
	printf("left by a try block: %d\n".ptr, left_by_a_try_block() as c_int);
	printf("left by a fatal handler: %d\n".ptr,
		left_by_a_fatal_handler() as c_int);
	printf("left by a call that never returns: %d\n".ptr,
		left_by_a_call_that_never_returns() as c_int);
	let failed = left_by_a_failure() catch e {
		yield -1;
	};
	printf("left by a failure: %d\n".ptr, failed as c_int);
	printf("left by a while: %d\n".ptr, left_by_a_while() as c_int);
	printf("left by a do: %d\n".ptr, left_by_a_do() as c_int);
	printf("left by a fallthrough: %d\n".ptr, left_by_a_fallthrough() as c_int);
	printf("left by a yield: %d\n".ptr, left_by_a_yield() as c_int);
	printf("a captured copy: %d\n".ptr, captured_copy(xs[0..3]) as c_int);
	printf("a complement: %d\n".ptr, complement() as c_int);
	printf("the least step: %d\n".ptr, least_step() as c_int);
	let one = 1;
	printf("a slice literal in a loop: %d\n".ptr,
		slice_literal_in_a_loop(&one) as c_int);
	printf("many indices: %d\n".ptr, many_indices(none) as c_int);
	return 0;
}
