//! A `Grid<int>` of 4 by 3 filled with a value, written and read with `g[x,
//! y]`, and `get` that gives `none` outside it.

import anti.collection.grid.{Grid};
import anti.io;
import anti.text;

fn say(s: str)
{
	io.println(s);
	free(s.ptr);
}

fn main() -> int
{
	let g = Grid<int>.new(4, 3, 1);
	for x in 0..4 {
		g[x, 1] = x * 10;
	}
	g[3, 2] = 7;
	let sum = 0;
	for y in 0..3 {
		for x in 0..4 {
			sum += g[x, y];
		}
	}
	let outside = g.get(4, 0);
	say(f"{sum} {g[2, 1]} {g.get(3, 2) ?? -1} {outside == none}");
	return 0;
}
