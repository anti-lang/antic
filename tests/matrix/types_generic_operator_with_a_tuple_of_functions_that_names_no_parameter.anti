//! A generic `operator fn add` whose second operand is a tuple of one function
//! type twice. The walk of R067 of "Rules of 2026-10-13" reads the parameters
//! and the result of the first, passes over the second it has read, and finds
//! no `T`, so the operator is refused where it is declared.

struct Box
{
	v: int,
}

operator fn add<T>(a: Box, b: (fn(int) -> int, fn(int) -> int)) -> Box
{
	return a;
}

fn main() -> int
{
	return 0;
}
