//! An abstract function takes `self`, by R117 of the rules of 2026-10-13. One
//! without it is refused where it is declared, so no `concrete fn` fills it,
//! with `self` or without.

abstract class Shape
{
	abstract fn sides() -> int;
}

class Square inherits Shape
{
	pub n: int = 0,

	concrete fn sides(self) -> int
	{
		return 4;
	}
}

fn main() -> int
{
	return 0;
}
