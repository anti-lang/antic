//! C1 and a read at the index of a write: the call that takes `&i` sets it to 3.
//! C1 counts a local that a pointer may change as a case it cannot follow, so
//! the read passes, by 11 of "Answers of 2026-11-23". It reads element 3, which
//! no path wrote, so the line names the index alone.

extern fn printf(format: ?*byte, ...) -> c_int;

fn bump(n: *int)
{
	*n = 3;
}

fn main() -> int
{
	let p = alloc(int, 4) else {
		return 1;
	};
	let i = 0;
	p[i] = 1;
	bump(&i);
	let x = p[i];
	free(p);
	printf("read at index %d\n".ptr, i as c_int);
	return 0;
}
