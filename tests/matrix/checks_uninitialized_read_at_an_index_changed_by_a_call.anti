//! C1 and a read at the index of a write: the call that takes `&i` sets it to
//! 3, so the read reads element 3, which no path wrote.

fn bump(n: *int)
{
	*n = 3;
}

fn main() -> int
{
	let p = alloc(int, 4) else {
		return 1;
	};
	let i = 0;
	p[i] = 1;
	bump(&i);
	let x = p[i];
	free(p);
	return x;
}
