//! A `construct` sets a field without a default in every arm of a `switch`.

import anti.lang;

fn step(x: int) -> int may fail
{
	if x > 100 {
		fail "too large";
	}
	return x + 1;
}

class Box
{
	pub a: int,

	fn construct(self, x: int) may fail
	{
		if x > 1000 {
			fail "far too large";
		}
		let v = try step(x);
		switch v {
			1 => self.a = 1,
			else => { },
		}
	}
}

fn main() -> int
{
	return 0;
}
