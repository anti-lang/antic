//! An `own` field of `self` read after it moved into an `own` parameter.

class Node
{
	pub n: int = 0,
}

fn take(own p: *Node)
{
	delete(p);
}

class Box
{
	pub own one: *Node,

	pub fn give(self) -> int
	{
		take(self.one);
		return self.one.n;
	}
}

fn main() -> int
{
	let b = alloc Box { one: alloc Node { n: 1 } };
	return b.give();
}
