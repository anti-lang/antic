//! A `yield` outside a `catch` handler is refused, in a function and in a
//! closure that stands in a handler.

import anti.lang;

fn risky(n: int) -> int may fail
{
	if n == 2 {
		fail "refused";
	}
	return n * 10;
}

fn each(count: int, f: fn(int))
{
	for i in 0..count {
		f(i);
	}
}

fn main() -> int
{
	let acc = 0;
	let got = risky(2) catch {
		each(2, fn(i) {
			if i == 1 {
				yield 5;
			}
			acc += 1;
		});
		yield acc;
	};
	return got;
}
