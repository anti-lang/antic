//! `yield` of a local that holds a class with a `destruct`. The value of the
//! `catch` would be a copy, and the local would stay a second owner.

import anti.lang;

class Counted
{
	pub n: int = 0,

	fn destruct(self)
	{
	}
}

fn counted(n: int) -> Counted
{
	return Counted { n: n };
}

fn failing(n: int) -> Counted may fail
{
	if n > 0 {
		fail "refused";
	}
	return counted(n);
}

fn main() -> int
{
	let a = counted(1);
	let b = failing(1) catch e {
		yield a;
	};
	return 0;
}
