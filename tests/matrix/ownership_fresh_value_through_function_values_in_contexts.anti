//! A call result passed through a function value to a function whose parameter
//! is not `own`, in each place a function value stands. The caller owns the
//! value, so it is torn down once, after the call returns, by "Answers of
//! 2026-11-13". Each `Key` prints its teardown.

extern fn printf(format: ?*byte, ...) -> c_int;

class Key
{
	pub n: int = 0,

	fn destruct(self)
	{
		printf("  teardown of key %d\n".ptr, self.n as c_int);
	}
}

class Box
{
	pub m: int = 0,
	pub own f: ?fn(Key) -> int = none,

	pub fn look(self, k: Key) -> int
	{
		return k.n + self.m;
	}
}

fn key(n: int) -> Key
{
	return Key { n: n };
}

fn number(k: Key) -> int
{
	return k.n;
}

fn pick() -> fn(Key) -> int
{
	return number;
}

fn through(f: fn(Key) -> int) -> int
{
	return f(key(2));
}

fn kept(keep f: fn(Key) -> int) -> int
{
	return f(key(3));
}

fn main() -> int
{
	let local = number;
	printf("through a local: %d\n".ptr, local(key(1)) as c_int);
	printf("through a parameter: %d\n".ptr, through(number) as c_int);
	printf("through a keep parameter: %d\n".ptr, kept(number) as c_int);
	let b = Box { };
	let bound = b.look;
	printf("through a bound function: %d\n".ptr, bound(key(4)) as c_int);
	let base = 0;
	let closure = fn(k: Key) -> int { return k.n + base; };
	printf("through a closure: %d\n".ptr, closure(key(5)) as c_int);
	printf("through a result: %d\n".ptr, pick()(key(6)) as c_int);
	let all = [number, number];
	printf("through an element: %d\n".ptr, all[1](key(7)) as c_int);
	b.f = number;
	if let g = b.f {
		printf("through an own field: %d\n".ptr, g(key(8)) as c_int);
	}
	return 0;
}
