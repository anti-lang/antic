//! `patch` with a limit counts the places it patches. A match whose group took
//! no part is no place, so a limit of 1 and one of -1 each patch one group.

import anti.io;
import anti.regex;
import anti.text;

fn say(s: str)
{
	io.println(s);
	free(s.ptr);
}

fn patched(input: str, limit: int)
{
	let data = input.to_bytes();
	let n = data.patch(re"a(b)?", b"X", 0, 0, limit);
	let result = data.to_text() catch {
		free(data.ptr);
		return;
	};
	say(f"limit {limit}: {n} {result}");
	free(result.ptr);
	free(data.ptr);
}

fn main() -> int
{
	patched("a ab ab", 1);
	patched("ab ab a", -1);
	return 0;
}
