//! C3 of the compile-time checks: the `else` of a `let` reaches its end without
//! leaving. A `switch` has an arm that reaches its end.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

extern fn exit(status: c_int) -> never;

fn value(n: int) -> int may fail
{
	if n > 2 {
		fail lang.Error.new(n, "refused");
	}
	return n;
}

fn stop(n: int) -> never
{
	exit(n as c_int);
}

fn f(p: ?*int, q: ?*int, n: int) -> int
{
	let w = q else {
		switch n {
			1 => {
				return 0;
			},
			2 => {
				printf("two\n".ptr);
			},
			else => {
				return 0;
			},
		}
	};
	return *w;
}

fn main() -> int
{
	return 0;
}
