//! `operator fn eq` gives a `bool`, by R105 of the rules of 2026-10-13. One
//! that gives an `int` is refused where it is declared, so `equals` of the
//! class never meets it.

extern fn printf(format: ?*byte, ...) -> c_int;

class Pair
{
	pub left: int = 0,
	pub note: int = 0,
}

operator fn eq(a: *Pair, b: *Pair) -> int
{
	return 1;
}

fn main() -> int
{
	let a = Pair { left: 1, note: 2 };
	let b = Pair { left: 1, note: 3 };
	printf("%d\n".ptr, a.equals(&b) as c_int);
	return 0;
}
