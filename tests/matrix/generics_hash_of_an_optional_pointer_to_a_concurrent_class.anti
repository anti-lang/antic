//! A `?*T` hashes by its address, so a `?*Tally` of a concurrent class without
//! a hash of its own meets the constraint `hash`, where a `*Tally` does not.
//! The program prints whether two hashes of one pointer agree.

extern fn printf(format: ?*byte, ...) -> c_int;

concurrent class Tally
{
	pub atomic hits: int = 0,
}

fn key<T: hash>(x: T) -> u64
{
	return x.hash();
}

fn main() -> int
{
	let a = alloc Tally { };
	let p: ?*Tally = a;
	printf("same %d\n".ptr, (key(p) == key(p)) as c_int);
	delete(a);
	return 0;
}
