//! `yield;` in the handler of a `try` block ends the handler, by R014 of the
//! rules of 2026-10-13. The statements after it do not run, the `defer` of the
//! handler runs, the error is deleted, and the program goes on after the block.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Counted inherits lang.Error
{
	static atomic live: int = 0;

	/// An error that counts itself alive until it is deleted.
	pub fn make(code: int) -> *Counted
	{
		let e = alloc Counted { };
		e.code = code;
		e.message = "counted";
		Counted.live.add(1);
		return e;
	}

	concrete fn destruct(self)
	{
		Counted.live.sub(1);
	}
}

fn step(n: int) may fail
{
	if n <= 0 {
		fail Counted.make(1 - n);
	}
}

fn run(n: int) -> int
{
	let acc = 0;
	try {
		step(n);
		acc += 1;
	} catch e {
		defer acc += 10;
		if e.code == 1 {
			yield;
		}
		acc += 100;
	}
	acc += 1000;
	return acc;
}

fn main() -> int
{
	printf("%d %d %d, alive %d\n".ptr, run(1) as c_int, run(0) as c_int,
		run(-1) as c_int, Counted.live.load() as c_int);
	return 0;
}
