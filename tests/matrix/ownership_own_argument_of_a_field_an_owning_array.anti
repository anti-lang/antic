//! A field that holds an array of owning values, passed to an `own` parameter.
//! A value that stays where it is cannot move, and the copy would give what it
//! owns two owners.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

class Holder
{
	pub held: [2]Key,
}

fn take(own x: [2]Key) -> int
{
	return x[0].n;
}

fn main() -> int
{
	let h = Holder { held: row(1) };
	return take(h.held);
}
