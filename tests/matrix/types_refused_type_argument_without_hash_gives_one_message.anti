//! A type argument that lacks `hash` is one mistake, so the second use of the
//! copy gets no message.

concurrent class Counter
{
	atomic n: int = 0,
}

fn key<T: hash>(x: T) -> u64
{
	return x.hash();
}

fn main() -> int
{
	let c = alloc Counter { };
	let a = key(c);
	let b = key(c);
	delete(c);
	if a == b {
		return 0;
	}
	return 1;
}
