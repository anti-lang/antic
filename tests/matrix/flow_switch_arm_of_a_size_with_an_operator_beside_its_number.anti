//! A `switch` on an integer with the arm `size_of(i64) + 1` before the arm `9`.
//! The checker reads no value computed from a size with an operator, so both
//! arms stay, as the entry of R010 of the rules of 2026-10-13 records, and the
//! first one that holds the value runs.

extern fn printf(format: ?*byte, ...) -> c_int;

fn kind(n: int) -> int
{
	let k = 0;
	switch n {
		size_of(i64) + 1 => k = 1,
		9 => k = 2,
		else => k = 3,
	}
	return k;
}

fn main() -> int
{
	printf("%d %d\n".ptr, kind(9) as c_int, kind(8) as c_int);
	return 0;
}
