//! `(x > 3) as int` counts the matches of a comparison without an `if`, and
//! `bool` as `u8` sums into a byte.

import anti.io;
import anti.text;

fn say(s: str)
{
	io.println(s);
	free(s.ptr);
}

fn main() -> int
{
	let xs: [7]int = [1, 5, 3, 9, 4, 0, 8];
	let count = 0;
	let flags: u8 = 0;
	for x in xs {
		count += (x > 3) as int;
		flags += (x % 2 == 0) as u8;
	}
	say(f"{count} {flags}");
	return 0;
}
