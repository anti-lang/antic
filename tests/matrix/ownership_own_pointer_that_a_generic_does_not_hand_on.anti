//! An `own` parameter of a type parameter in a copy whose type argument is a
//! plain pointer, by R081 of "Answers of 2026-10-18". `own x: T` with `T` a
//! `*Key` owns the pointer value, one word, and not the object it names, so a
//! generic that does not hand the parameter on deletes nothing, and neither
//! does one that hands it on, by `return` or into a field. The program keeps a
//! second pointer to each key and deletes it itself. A copy whose type argument
//! is a value tears the value down where the function ends. Each `Key` prints
//! its teardown, and each line prints the keys alive.

extern fn printf(format: ?*byte, ...) -> c_int;

class Key
{
	pub n: int = 0,

	pub static atomic live: int = 0;

	fn construct(self)
	{
		Key.live.add(1);
	}

	fn destruct(self)
	{
		Key.live.sub(1);
		printf("  teardown of key %d\n".ptr, self.n as c_int);
	}
}

struct Slot<T>
{
	held: T,
}

fn alive() -> c_int
{
	return Key.live.load() as c_int;
}

fn dropped<T>(own x: T)
{
}

fn handed_on<T>(own x: T) -> T
{
	return x;
}

fn on_one_path<T>(yes: bool, own x: T) -> ?T
{
	if yes {
		return x;
	}
	return none;
}

fn in_a_field<T>(own x: T) -> Slot<T>
{
	return Slot<T> { held: x };
}

fn main() -> int
{
	let one = alloc Key { n: 1 };
	let kept = one;
	dropped<*Key>(one);
	printf("not handed on: alive %d\n".ptr, alive());
	delete(kept);
	let p = handed_on<*Key>(alloc Key { n: 2 });
	printf("handed on by return: %d, alive %d\n".ptr, p.n as c_int, alive());
	delete(p);
	let three = alloc Key { n: 3 };
	let also = three;
	let gone = on_one_path<*Key>(false, three);
	printf("not handed on one path: %d, alive %d\n".ptr, (gone != none) as c_int, alive());
	delete(also);
	let q = on_one_path<*Key>(true, alloc Key { n: 4 }) else {
		return 1;
	};
	printf("handed on the other path: %d, alive %d\n".ptr, q.n as c_int, alive());
	delete(q);
	let s = in_a_field<*Key>(alloc Key { n: 5 });
	printf("handed on into a field: %d, alive %d\n".ptr, s.held.n as c_int, alive());
	delete(s.held);
	dropped<Key>(Key { n: 6 });
	printf("a value that is not handed on: alive %d\n".ptr, alive());
	return 0;
}
