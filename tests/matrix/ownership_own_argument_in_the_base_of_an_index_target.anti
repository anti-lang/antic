//! The base of the target of `e[i] = v` and `e[i] += v` is a call that takes an
//! owning local. The local moves into the call once, the assignment writes
//! through the slice the call gives, and the callee tears the local down once.
extern fn printf(format: ?*byte, ...) -> c_int;

class Box
{
	pub n: int = 0,

	pub static atomic live: int = 0;

	fn construct(self)
	{
		Box.live.add(1);
	}

	fn destruct(self)
	{
		Box.live.sub(1);
	}
}

fn slots(own b: Box, into: []int) -> []int
{
	into[3] = b.n;
	return into;
}

fn alive() -> c_int
{
	return Box.live.load() as c_int;
}

fn assigned() -> c_int
{
	let store = [0, 0, 0, 0];
	let b = Box { n: 5 };
	slots(b, store[0..4])[0] = 2;
	return (store[0] + store[3]) as c_int;
}

fn compound() -> c_int
{
	let store = [1, 0, 0, 0];
	let b = Box { n: 7 };
	slots(b, store[0..4])[0] += 2;
	return (store[0] + store[3]) as c_int;
}

fn main() -> int
{
	let a = assigned();
	printf("e[i] = v: %d, alive %d\n".ptr, a, alive());
	let c = compound();
	printf("e[i] += v: %d, alive %d\n".ptr, c, alive());
	return 0;
}
