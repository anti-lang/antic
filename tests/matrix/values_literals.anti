{
	lock: Mutex,
	entered: int,
}

fn in_sync_bool(g: *Guarded_bool, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let on = true;
		let off = false;
		if on {
			acc += n;
		}
		if off {
			acc += 100;
		}
	}
	return acc;
}

fn in_select_bool(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let on = true;
			let off = false;
			if on {
				acc += n;
			}
			if off {
				acc += 100;
			}
		},
	}
	return acc;
}

class Outer_bool
{
	class Inner_bool
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let on = true;
			let off = false;
			if on {
				acc += n;
			}
			if off {
				acc += 100;
			}
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_bool { base: 1000 };
		return inner.run(n);
	}
}

fn in_loop_here(n: int) -> int
{
	let acc = 0;
	for turn in 0..2 {
		acc += turn;
		let at = here;
		if at.line > 0 && at.file.len > 0 {
			acc += n;
		}
	}
	return acc;
}

fn in_arm_here(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let at = here;
			if at.line > 0 && at.file.len > 0 {
				acc += n;
			}
		},
	}
	return acc;
}

fn held_here(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_here(n: int) -> int
{
	let acc = 0;
	if let v = held_here(n) {
		acc += v - n * 3;
		let at = here;
		if at.line > 0 && at.file.len > 0 {
			acc += n;
		}
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_here(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let at = here;
		if at.line > 0 && at.file.len > 0 {
			acc += n;
		}
	}
	acc = 5;
}

fn in_undo_here(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let at = here;
		if at.line > 0 && at.file.len > 0 {
			acc += n;
		}
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_here(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_here(n: int) -> int
{
	let acc = 0;
	let got = risky_here(n) catch {
		let at = here;
		if at.line > 0 && at.file.len > 0 {
			acc += n;
		}
		yield acc;
	};
	return got;
}

fn apply_here(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_here(start: int) -> int
{
	let acc = 0;
	let got = apply_here(start, fn(n) {
		let at = here;
		if at.line > 0 && at.file.len > 0 {
			acc += n;
		}
		return acc;
	});
	return got + acc;
}

worker fn in_worker_here(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let at = here;
	if at.line > 0 && at.file.len > 0 {
		acc += n;
	}
	return acc;
}

worker fn work_here(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_here(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_here(fn(n) {
		let acc = 0;
		let at = here;
		if at.line > 0 && at.file.len > 0 {
			acc += n;
		}
		return acc;
	});
	return join(job);
}

struct Guarded_here
{
	lock: Mutex,
	entered: int,
}

fn in_sync_here(g: *Guarded_here, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let at = here;
		if at.line > 0 && at.file.len > 0 {
			acc += n;
		}
	}
	return acc;
}

fn in_select_here(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let at = here;
			if at.line > 0 && at.file.len > 0 {
				acc += n;
			}
		},
	}
	return acc;
}

class Outer_here
{
	class Inner_here
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let at = here;
			if at.line > 0 && at.file.len > 0 {
				acc += n;
			}
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_here { base: 1000 };
		return inner.run(n);
	}
}

fn main() -> int
{
	let task = alloc Task { };
	{
		let outer = Outer_literal_int { };
		printf("literal_int nested %d\n".ptr, outer.go(1) as c_int);
		printf("literal_int nested %d\n".ptr, outer.go(2) as c_int);
		printf("literal_int nested %d\n".ptr, outer.go(3) as c_int);
		printf("literal_int nested %d\n".ptr, outer.go(4) as c_int);
	}
	{
		let deferred = 0;
		in_defer_literal_float(1, &deferred);
		printf("literal_float defer %d\n".ptr, deferred as c_int);
		in_defer_literal_float(2, &deferred);
		printf("literal_float defer %d\n".ptr, deferred as c_int);
		in_defer_literal_float(3, &deferred);
		printf("literal_float defer %d\n".ptr, deferred as c_int);
		in_defer_literal_float(4, &deferred);
		printf("literal_float defer %d\n".ptr, deferred as c_int);
		let undone = 0;
		in_undo_literal_float(0, &undone) catch {
			yield;
		};
		printf("literal_float undo %d\n".ptr, undone as c_int);
		in_undo_literal_float(1, &undone) catch {
			yield;
		};
		printf("literal_float undo %d\n".ptr, undone as c_int);
		in_undo_literal_float(2, &undone) catch {
			yield;
		};
		printf("literal_float undo %d\n".ptr, undone as c_int);
		in_undo_literal_float(3, &undone) catch {
			yield;
		};
		printf("literal_float undo %d\n".ptr, undone as c_int);
		in_undo_literal_float(4, &undone) catch {
			yield;
		};
		printf("literal_float undo %d\n".ptr, undone as c_int);
		task.n = 1;
		let job0 = dispatch task -> in_worker_literal_float();
		printf("literal_float worker %d\n".ptr, join(job0) as c_int);
		task.n = 2;
		let job1 = dispatch task -> in_worker_literal_float();
		printf("literal_float worker %d\n".ptr, join(job1) as c_int);
		task.n = 3;
		let job2 = dispatch task -> in_worker_literal_float();
		printf("literal_float worker %d\n".ptr, join(job2) as c_int);
		task.n = 4;
		let job3 = dispatch task -> in_worker_literal_float();
		printf("literal_float worker %d\n".ptr, join(job3) as c_int);
		printf("literal_float dispatch %d\n".ptr, in_dispatch_literal_float(task, 1) as c_int);
		printf("literal_float dispatch %d\n".ptr, in_dispatch_literal_float(task, 2) as c_int);
		printf("literal_float dispatch %d\n".ptr, in_dispatch_literal_float(task, 3) as c_int);
		printf("literal_float dispatch %d\n".ptr, in_dispatch_literal_float(task, 4) as c_int);
		let g = Guarded_literal_float { lock: Mutex.new(), entered: 0 };
		printf("literal_float sync %d\n".ptr, in_sync_literal_float(&g, 1) as c_int);
		printf("literal_float sync %d\n".ptr, in_sync_literal_float(&g, 2) as c_int);
		printf("literal_float sync %d\n".ptr, in_sync_literal_float(&g, 3) as c_int);
		printf("literal_float sync %d\n".ptr, in_sync_literal_float(&g, 4) as c_int);
		printf("literal_float sync entered %d\n".ptr, g.entered as c_int);
		g.lock.destroy();
		let c = chan int(1);
		printf("literal_float select %d\n".ptr, in_select_literal_float(c, 1) as c_int);
		printf("literal_float select %d\n".ptr, in_select_literal_float(c, 2) as c_int);
		printf("literal_float select %d\n".ptr, in_select_literal_float(c, 3) as c_int);
		printf("literal_float select %d\n".ptr, in_select_literal_float(c, 4) as c_int);
		delete(c);
		printf("literal_float generic %d %d\n".ptr, in_generic_literal_float<int>(1) as c_int,
			in_generic_literal_float<str>(1) as c_int);
		printf("literal_float generic %d %d\n".ptr, in_generic_literal_float<int>(2) as c_int,
			in_generic_literal_float<str>(2) as c_int);
		printf("literal_float generic %d %d\n".ptr, in_generic_literal_float<int>(3) as c_int,
			in_generic_literal_float<str>(3) as c_int);
		printf("literal_float generic %d %d\n".ptr, in_generic_literal_float<int>(4) as c_int,
			in_generic_literal_float<str>(4) as c_int);
		let outer = Outer_literal_float { };
		printf("literal_float nested %d\n".ptr, outer.go(1) as c_int);
		printf("literal_float nested %d\n".ptr, outer.go(2) as c_int);
		printf("literal_float nested %d\n".ptr, outer.go(3) as c_int);
		printf("literal_float nested %d\n".ptr, outer.go(4) as c_int);
	}
	{
		let box = Box_literal_char { base: 1000 };
