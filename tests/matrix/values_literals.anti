	pub fn go(self, n: int) -> int
	{
		let inner = Inner_literal_str { base: 1000 };
		return inner.run(n);
	}
}

fn in_arm_bool(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let on = true;
			let off = false;
			if on {
				acc += n;
			}
			if off {
				acc += 100;
			}
		},
	}
	return acc;
}

fn in_defer_bool(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let on = true;
		let off = false;
		if on {
			acc += n;
		}
		if off {
			acc += 100;
		}
	}
	acc = 5;
}

fn in_undo_bool(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let on = true;
		let off = false;
		if on {
			acc += n;
		}
		if off {
			acc += 100;
		}
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

worker fn work_bool(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_bool(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_bool(fn(n) {
		let acc = 0;
		let on = true;
		let off = false;
		if on {
			acc += n;
		}
		if off {
			acc += 100;
		}
		return acc;
	});
	return join(job);
}

