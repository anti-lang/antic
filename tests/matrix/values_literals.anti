//! The literals of numbers and of text of the values area, each in every place
//! its row of docs/notes/test-matrix.md left open: literal_int, literal_float,
//! literal_char, literal_str, bool, here. Each construct in each place is a
//! function of its own, named after both, and the program prints one line per
//! construct, place and input.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Task
{
	pub n: int = 0,
}

class Outer_literal_int
{
	class Inner_literal_int
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			acc += 42 + 0x1F + 1_000 * n;
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_literal_int { base: 1000 };
		return inner.run(n);
	}
}

fn in_defer_literal_float(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let x = 2.5;
		let y = 1.0e2;
		acc += (x * (n as float)) as int + (y as int);
	}
	acc = 5;
}

fn in_undo_literal_float(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let x = 2.5;
		let y = 1.0e2;
		acc += (x * (n as float)) as int + (y as int);
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

worker fn in_worker_literal_float(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let x = 2.5;
	let y = 1.0e2;
	acc += (x * (n as float)) as int + (y as int);
	return acc;
}

worker fn work_literal_float(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_literal_float(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_literal_float(fn(n) {
		let acc = 0;
		let x = 2.5;
		let y = 1.0e2;
		acc += (x * (n as float)) as int + (y as int);
		return acc;
	});
	return join(job);
}

struct Guarded_literal_float
{
	lock: Mutex,
	entered: int,
}

fn in_sync_literal_float(g: *Guarded_literal_float, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let x = 2.5;
		let y = 1.0e2;
		acc += (x * (n as float)) as int + (y as int);
	}
	return acc;
}

fn in_select_literal_float(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let x = 2.5;
			let y = 1.0e2;
			acc += (x * (n as float)) as int + (y as int);
		},
	}
	return acc;
}

fn in_generic_literal_float<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	let x = 2.5;
	let y = 1.0e2;
	acc += (x * (n as float)) as int + (y as int);
	return acc;
}

class Outer_literal_float
{
	class Inner_literal_float
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let x = 2.5;
			let y = 1.0e2;
			acc += (x * (n as float)) as int + (y as int);
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_literal_float { base: 1000 };
		return inner.run(n);
	}
}

class Box_literal_char
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		let c = 'a';
		let tab = '\t';
		acc += (c as u32) as int + (tab as u32) as int + n;
		return acc;
	}
}

fn in_arm_literal_char(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let c = 'a';
			let tab = '\t';
			acc += (c as u32) as int + (tab as u32) as int + n;
		},
	}
	return acc;
}

fn held_literal_char(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_literal_char(n: int) -> int
{
	let acc = 0;
	if let v = held_literal_char(n) {
		acc += v - n * 3;
		let c = 'a';
		let tab = '\t';
		acc += (c as u32) as int + (tab as u32) as int + n;
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_literal_char(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let c = 'a';
		let tab = '\t';
		acc += (c as u32) as int + (tab as u32) as int + n;
	}
	acc = 5;
}

fn in_undo_literal_char(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let c = 'a';
		let tab = '\t';
		acc += (c as u32) as int + (tab as u32) as int + n;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_literal_char(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_literal_char(n: int) -> int
{
	let acc = 0;
	let got = risky_literal_char(n) catch {
		let c = 'a';
		let tab = '\t';
		acc += (c as u32) as int + (tab as u32) as int + n;
		yield acc;
	};
	return got;
}

fn apply_literal_char(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_literal_char(start: int) -> int
{
	let acc = 0;
	let got = apply_literal_char(start, fn(n) {
		let c = 'a';
		let tab = '\t';
		acc += (c as u32) as int + (tab as u32) as int + n;
		return acc;
	});
	return got + acc;
}

worker fn in_worker_literal_char(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let c = 'a';
	let tab = '\t';
	acc += (c as u32) as int + (tab as u32) as int + n;
	return acc;
}

worker fn work_literal_char(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_literal_char(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_literal_char(fn(n) {
		let acc = 0;
		let c = 'a';
		let tab = '\t';
		acc += (c as u32) as int + (tab as u32) as int + n;
		return acc;
	});
	return join(job);
}

struct Guarded_literal_char
{
	lock: Mutex,
	entered: int,
}

fn in_sync_literal_char(g: *Guarded_literal_char, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let c = 'a';
		let tab = '\t';
		acc += (c as u32) as int + (tab as u32) as int + n;
	}
	return acc;
}

fn in_select_literal_char(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let c = 'a';
			let tab = '\t';
			acc += (c as u32) as int + (tab as u32) as int + n;
		},
	}
	return acc;
}

fn in_generic_literal_char<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	let c = 'a';
	let tab = '\t';
	acc += (c as u32) as int + (tab as u32) as int + n;
	return acc;
}

class Outer_literal_char
{
	class Inner_literal_char
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let c = 'a';
			let tab = '\t';
			acc += (c as u32) as int + (tab as u32) as int + n;
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_literal_char { base: 1000 };
		return inner.run(n);
	}
}

worker fn in_worker_literal_str(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let s = "four\n";
	acc += s.len * n + (s[4] as int);
	return acc;
}

worker fn work_literal_str(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_literal_str(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_literal_str(fn(n) {
		let acc = 0;
		let s = "four\n";
		acc += s.len * n + (s[4] as int);
		return acc;
	});
	return join(job);
}

fn in_select_literal_str(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let s = "four\n";
			acc += s.len * n + (s[4] as int);
		},
	}
	return acc;
}

class Outer_literal_str
{
	class Inner_literal_str
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let s = "four\n";
			acc += s.len * n + (s[4] as int);
			return acc;
		}
