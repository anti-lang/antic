//! An `own fn` field passes to a `concurrent` parameter. What it holds is
//! concurrent: a snapshot, which reads its copies alone, or a function that
//! captures nothing. The chunks of a `parallel` call each through the field.

extern fn printf(format: ?*byte, ...) -> c_int;

fn twice(n: int) -> int
{
	return n * 2;
}

class Scale
{
	pub own by: fn(int) -> int = twice,

	pub fn set(self, keep own f: fn(int) -> int)
	{
		self.by = f;
	}
}

worker fn each(chunk: []int, concurrent f: fn(int) -> int) -> int
{
	let n = 0;
	for v in chunk {
		n += f(v);
	}
	return n;
}

fn main() -> int
{
	let items = [1, 2, 3, 4];
	let s = alloc Scale { };
	unchecked(escaping-local, "parallel waits for every chunk while the array lives")
	let plain = parallel items[0..4] by 2 -> each(s.by);
	printf("a function that captures nothing: %d %d\n".ptr, plain[0] as c_int, plain[1] as c_int);
	free(plain.ptr);

	let factor = 10;
	s.set(snapshot fn(n) -> int {
		return n * factor;
	});
	unchecked(escaping-local, "parallel waits for every chunk while the array lives")
	let copied = parallel items[0..4] by 2 -> each(s.by);
	printf("a snapshot: %d %d\n".ptr, copied[0] as c_int, copied[1] as c_int);
	free(copied.ptr);
	delete(s);
	return 0;
}
