//! A class with an `own` slice of structs that hold a union has no default
//! `==`, since it compares the elements of the slice one by one and no default
//! can read a union.

union Bits
{
	a: int,
	b: f32,
}

struct Part
{
	n: int,
	bits: Bits,
}

class Holder
{
	pub n: int = 0,
	pub own parts: []Part,
}

fn same(a: Holder, b: Holder) -> bool
{
	return a == b;
}

fn main() -> int
{
	return 0;
}
