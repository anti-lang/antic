{
	let base = [1, 2, 3];
	let first: []int = base[0..1];
	let second = first;
	let third: []int = base[0..3];
	printf("let slice %lld %lld\n".ptr, second.len, third.len);
}

fn let_on_fixed_array()
{
	let first: [2]int = [1, 2];
	let second = first;
	let third: [2]int = [3, 4];
	printf("let fixed_array %lld %lld\n".ptr, second[1], third[1]);
}

fn let_on_pointer()
{
	let a = 11;
	let b = 22;
	let first: *int = &a;
	let second = first;
	let third: *int = &b;
	printf("let pointer %lld %lld\n".ptr, *second, *third);
}

fn let_on_nullable_pointer()
{
	let a = 11;
	let b = 22;
	let first: ?*int = &a;
	let second = first;
	let third: ?*int = none;
	printf("let nullable_pointer %lld %lld\n".ptr, *(second ?? &b), *(third ?? &b));
}

fn let_on_optional()
{
	let first: ?int = 5;
	let second = first;
	let third: ?int = none;
	printf("let optional %lld %lld\n".ptr, (second ?? -1), (third ?? -1));
}

fn let_on_may_fail_fn()
{
	let first: fn(int) -> int may fail = risky_up;
	let second = first;
	let third: fn(int) -> int may fail = risky_down;
	printf("let may_fail_fn %lld %lld\n".ptr, settle(second), settle(third));
}

fn let_on_fn()
{
	let first: fn(int) -> int = up;
	let second = first;
	let third: fn(int) -> int = down;
	printf("let fn %lld %lld\n".ptr, second(10), third(10));
}

fn let_on_tuple()
{
	let first: (int, bool) = (1, true);
	let second = first;
	let third: (int, bool) = (2, false);
	printf("let tuple %lld %lld\n".ptr, second.0, third.0);
}

fn let_on_channel()
{
	let c1 = chan int(1);
	let c2 = chan int(1);
	let first: chan int = c1;
	let second = first;
	let third: chan int = c2;
	printf("let channel %d %d\n".ptr, (second == c1) as c_int, (third == c1) as c_int);
	delete(c1);
	delete(c2);
}

fn let_on_struct()
{
	let first: Pt = Pt { x: 1, y: 2 };
	let second = first;
	let third: Pt = Pt { x: 3, y: 4 };
	printf("let struct %lld %lld\n".ptr, second.y, third.y);
}

fn let_on_packed_struct()
{
	let first: Pk = Pk { a: 1, b: 2 };
	let second = first;
	let third: Pk = Pk { a: 3, b: 4 };
	printf("let packed_struct %lld %lld\n".ptr, second.b as int, third.b as int);
}

fn let_on_simd_struct()
{
	let first: I32x4 = I32x4 { a: 1, b: 2, c: 3, d: 4 };
	let second = first;
	let third: I32x4 = I32x4 { a: 5, b: 6, c: 7, d: 8 };
	printf("let simd_struct %lld %lld\n".ptr, second.c as int, third.c as int);
}

fn let_on_union()
{
	let first: Bits = Bits { i: 7 };
	let second = first;
	let third: Bits = Bits { i: 9 };
	printf("let union %lld %lld\n".ptr, second.i as int, third.i as int);
}

fn let_on_enum()
{
	let first: Color = Color.Green;
	let second = first;
	let third: Color = Color.Blue;
	printf("let enum %lld %lld\n".ptr, second as int, third as int);
}

fn let_on_variant()
{
	let first: Shape = Shape.Circle { r: 2 };
	let second = first;
	let third: Shape = Shape.Empty;
	printf("let variant %d %d\n".ptr, (second is Shape.Circle) as c_int, (third is Shape.Circle) as c_int);
}

fn let_on_class()
{
	let first: Counter = Counter { n: 5 };
	let second = first;
	let third: Counter = Counter { n: 6 };
	printf("let class %lld %lld\n".ptr, second.n, third.n);
}

fn let_on_concurrent_class()
{
	let first: Hits = Hits { n: 5 };
	let second = first;
	let third: Hits = Hits { n: 6 };
	printf("let concurrent_class %lld %lld\n".ptr, second.n.load(), third.n.load());
}

fn let_on_interface()
{
	let one = One { };
	let two = Two { };
	let first: *Named = &one;
	let second = first;
	let third: *Named = &two;
	printf("let interface %lld %lld\n".ptr, second.id(), third.id());
}

fn let_on_generic<T>(a: T, b: T, read: fn(T) -> int)
{
	let first: T = dup(a);
	let second = first;
	let third: T = dup(b);
	printf("let generic %lld %lld\n".ptr, read(second), read(third));
}

