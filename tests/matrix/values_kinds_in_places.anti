fn field_on_generic<T>(a: T, b: T, read: fn(T) -> int)
{
	let h = Hold_generic<T> { f: dup(a), tag: 1 };
	let i = Hold_generic<T> { tag: 2, f: dup(a) };
	i.f = dup(b);
	printf("field generic %lld %lld\n".ptr, read(h.f), read(i.f));
}

