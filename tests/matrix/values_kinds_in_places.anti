fn assign_on_i8()
{
	let first: i8 = 127;
	let second: i8 = -128;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("assign i8 %lld %lld\n".ptr, second as int, first as int);
}

