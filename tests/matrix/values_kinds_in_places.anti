	let a = 11;
	let b = 22;
	let first = pass_pointer(&a);
	printf("call pointer %lld %lld\n".ptr, *first, *pass_pointer(&b));
}

fn call_on_nullable_pointer()
{
	let a = 11;
	let b = 22;
	let first = pass_nullable_pointer(&a);
	printf("call nullable_pointer %lld %lld\n".ptr, *(first ?? &b), *(pass_nullable_pointer(none) ?? &b));
}

fn call_on_optional()
{
	let first = pass_optional(5);
	printf("call optional %lld %lld\n".ptr, (first ?? -1), (pass_optional(none) ?? -1));
}

fn call_on_may_fail_fn()
{
	let first = pass_may_fail_fn(risky_up);
	printf("call may_fail_fn %lld %lld\n".ptr, settle(first), settle(pass_may_fail_fn(risky_down)));
}

fn call_on_fn()
{
	let first = pass_fn(up);
	printf("call fn %lld %lld\n".ptr, first(10), pass_fn(down)(10));
}

fn call_on_tuple()
{
	let first = pass_tuple((1, true));
	printf("call tuple %lld %lld\n".ptr, first.0, pass_tuple((2, false)).0);
}

fn call_on_channel()
{
	let c1 = chan int(1);
	let c2 = chan int(1);
	let first = pass_channel(c1);
	printf("call channel %d %d\n".ptr, (first == c1) as c_int, (pass_channel(c2) == c1) as c_int);
	delete(c1);
	delete(c2);
}

fn call_on_struct()
{
	let first = pass_struct(Pt { x: 1, y: 2 });
	printf("call struct %lld %lld\n".ptr, first.y, pass_struct(Pt { x: 3, y: 4 }).y);
}

fn call_on_packed_struct()
{
	let first = pass_packed_struct(Pk { a: 1, b: 2 });
	printf("call packed_struct %lld %lld\n".ptr, first.b as int, pass_packed_struct(Pk { a: 3, b: 4 }).b as int);
}

fn call_on_simd_struct()
{
	let first = pass_simd_struct(I32x4 { a: 1, b: 2, c: 3, d: 4 });
	printf("call simd_struct %lld %lld\n".ptr, first.c as int, pass_simd_struct(I32x4 { a: 5, b: 6, c: 7, d: 8 }).c as int);
}

fn call_on_union()
{
	let first = pass_union(Bits { i: 7 });
	printf("call union %lld %lld\n".ptr, first.i as int, pass_union(Bits { i: 9 }).i as int);
}

fn call_on_enum()
{
	let first = pass_enum(Color.Green);
	printf("call enum %lld %lld\n".ptr, first as int, pass_enum(Color.Blue) as int);
}

fn call_on_variant()
{
	let first = pass_variant(Shape.Circle { r: 2 });
	printf("call variant %d %d\n".ptr, (first is Shape.Circle) as c_int, (pass_variant(Shape.Empty) is Shape.Circle) as c_int);
}

fn call_on_class()
{
	let first = pass_class(Counter { n: 5 });
	printf("call class %lld %lld\n".ptr, first.n, pass_class(Counter { n: 6 }).n);
}

fn call_on_concurrent_class()
{
	let first = pass_concurrent_class(Hits { n: 5 });
	printf("call concurrent_class %lld %lld\n".ptr, first.n.load(), pass_concurrent_class(Hits { n: 6 }).n.load());
}

fn call_on_interface()
{
	let one = One { };
	let two = Two { };
	let first = pass_interface(&one);
	printf("call interface %lld %lld\n".ptr, first.id(), pass_interface(&two).id());
}

