//! A `switch` on an enum that covers every value and returns in every arm ends
//! the path of its function, by R003 of the rules of 2026-10-13, so no `return`
//! follows it.

extern fn printf(format: ?*byte, ...) -> c_int;

enum Kind
{
	A,
	B,
}

fn name(k: Kind) -> int
{
	switch k {
		Kind.A => {
			return 1;
		},
		Kind.B => {
			return 2;
		},
	}
}

fn main() -> int
{
	printf("%d %d\n".ptr, name(Kind.A) as c_int, name(Kind.B) as c_int);
	return 0;
}
