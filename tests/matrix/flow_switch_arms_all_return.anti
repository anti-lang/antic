//! A function whose `switch` returns in every arm still needs a `return` after
//! it. No document states the rule, and the test holds what antic 0.2.0 does.

enum Kind
{
	A,
	B,
}

fn name(k: Kind) -> int
{
	switch k {
		Kind.A => {
			return 1;
		},
		Kind.B => {
			return 2;
		},
	}
}

fn main() -> int
{
	return name(Kind.A);
}
