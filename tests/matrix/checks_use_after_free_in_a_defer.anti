//! E2 in a defer: the deferred block reads a node after it deleted it.

extern fn printf(format: ?*byte, ...) -> c_int;

class Node
{
	pub n: int = 0,
}

fn show(k: int)
{
	let p = alloc Node { n: k };
	defer {
		delete(p);
		printf("%d\n".ptr, p.n);
	}
}

fn main() -> int
{
	show(1);
	return 0;
}
