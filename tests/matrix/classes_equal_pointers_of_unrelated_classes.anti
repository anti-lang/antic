//! Decision 27: `==` on class pointers compares the identity of one object.
//! Pointers of two classes that share no chain are a type error.

class A
{
	pub n: int = 0,
}

class B
{
	pub n: int = 0,
}

fn main() -> int
{
	let a = A { };
	let b = B { };
	let pa = &a;
	let pb = &b;
	if pa == pb {
		return 1;
	}
	return 0;
}
