//! C1 in a worker: a worker reads element 1 of `alloc(T, n)`, which no path
//! wrote.

worker fn tally(part: []int) -> int
{
	let p = alloc(int, 4) else {
		return -1;
	};
	p[0] = part[0];
	let w = p[1];
	free(p);
	return w;
}

fn main() -> int
{
	let room = alloc([2]int, 1) else {
		return 1;
	};
	(*room)[0] = 1;
	(*room)[1] = 2;
	let sums = parallel (*room)[0..2] by 2 -> tally;
	let n = sums[0] + sums[1];
	free(sums.ptr);
	free(room);
	return n;
}
