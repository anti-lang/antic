//! `destroy` of a part of a singleton, by R083 of "Answers of 2026-10-18". The
//! singleton outlives the program, and so do its parts.

extern fn printf(format: ?*byte, ...) -> c_int;

class Part
{
	pub n: int = 4,

	fn destruct(self)
	{
		printf("destruct %d\n".ptr, self.n as c_int);
	}
}

singleton class Config
{
	pub part: Part,
}

fn main() -> int
{
	destroy(&Config.get().part);
	printf("done\n".ptr);
	return 0;
}
