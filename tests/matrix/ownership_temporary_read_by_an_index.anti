//! A call result that is an array of owning values, read by an index and by
//! nothing else. The statement drops it, so its elements are torn down where
//! the statement ends.
extern fn printf(format: ?*byte, ...) -> c_int;

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,

	pub static atomic live: int = 0;

	fn construct(self)
	{
		Key.live.add(1);
	}

	fn destruct(self)
	{
		Key.live.sub(1);
	}
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn alive() -> c_int
{
	return Key.live.load() as c_int;
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

fn main() -> int
{
	let n = row(2)[1].n;
	printf("an index on a call result: %d, alive %d\n".ptr, n as c_int, alive());
	return 0;
}
