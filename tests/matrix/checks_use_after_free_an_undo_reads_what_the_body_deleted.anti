//! E2 and an undo: the block of the fail path runs at the `fail`, after the
//! body deleted the node, and reads it there on every run.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Node
{
	pub n: int = 0,
}

fn work(own p: *Node) may fail
{
	undo {
		printf("%d\n".ptr, p.n);
	}
	delete(p);
	fail "undone";
}

fn main() -> int
{
	work(alloc Node { n: 1 }) catch e {
		return 0;
	};
	return 1;
}
