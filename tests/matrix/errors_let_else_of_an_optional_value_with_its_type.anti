//! `let v: int = get(n) else { }` on a `?int`. The declared type is that of the
//! value the `else` leaves bound.

extern fn printf(format: ?*byte, ...) -> c_int;

fn get(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn tripled(n: int) -> int
{
	let v: int = get(n) else {
		return -1;
	};
	return v;
}

fn main() -> int
{
	printf("%d %d\n".ptr, tripled(0) as c_int, tripled(2) as c_int);
	return 0;
}
