//! A `sync` block calls a function that holds a `select`, which may wait while
//! the block holds its lock. The call gets the warning `blocking-under-lock`,
//! which a release build refuses.

fn pick(c: chan int) -> int
{
	let n = 0;
	select {
		c v => {
			let x = v else {
				return 0;
			};
			n = *x;
		}
	}
	return n;
}

struct Inbox
{
	lock: Mutex,
	count: int,
}

fn work(box: *Inbox, c: chan int) -> int
{
	sync box.lock {
		box.count += pick(c);
	}
	return box.count;
}

fn main() -> int
{
	let box = Inbox { count: 0 };
	let c = chan int(1);
	send(c, 4);
	let n = work(&box, c);
	delete(c);
	return n - 4;
}
