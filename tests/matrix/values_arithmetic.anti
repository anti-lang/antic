//! The arithmetic operators of the values area, each in every place its row of
//! docs/notes/test-matrix.md left open: arith, wrapping, saturating, mul_high,
//! unary, as. Each construct in each place is a function of its own, named
//! after both, and the program prints one line per construct, place and input.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Task
{
	pub n: int = 0,
}

fn in_undo_arith(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		acc += (n + 3) * 2 - n / 2 + n % 3;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn in_select_arith(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			acc += (n + 3) * 2 - n / 2 + n % 3;
		},
	}
	return acc;
}

fn in_arm_wrapping(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let big: int = 9223372036854775807;
			let w = big +% n;
			let back = w -% big;
			let m = big *% 2;
			let gone = n <<% 64;
			acc += back + m + gone + (n <<% 2);
		},
	}
	return acc;
}

fn held_wrapping(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_wrapping(n: int) -> int
{
	let acc = 0;
	if let v = held_wrapping(n) {
		acc += v - n * 3;
		let big: int = 9223372036854775807;
		let w = big +% n;
		let back = w -% big;
		let m = big *% 2;
		let gone = n <<% 64;
		acc += back + m + gone + (n <<% 2);
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_wrapping(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let big: int = 9223372036854775807;
		let w = big +% n;
		let back = w -% big;
		let m = big *% 2;
		let gone = n <<% 64;
		acc += back + m + gone + (n <<% 2);
	}
	acc = 5;
}

fn in_undo_wrapping(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let big: int = 9223372036854775807;
		let w = big +% n;
		let back = w -% big;
		let m = big *% 2;
		let gone = n <<% 64;
		acc += back + m + gone + (n <<% 2);
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_wrapping(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_wrapping(n: int) -> int
{
	let acc = 0;
	let got = risky_wrapping(n) catch {
		let big: int = 9223372036854775807;
		let w = big +% n;
		let back = w -% big;
		let m = big *% 2;
		let gone = n <<% 64;
		acc += back + m + gone + (n <<% 2);
		yield acc;
	};
	return got;
}

fn apply_wrapping(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_wrapping(start: int) -> int
{
	let acc = 0;
	let got = apply_wrapping(start, fn(n) {
		let big: int = 9223372036854775807;
		let w = big +% n;
		let back = w -% big;
		let m = big *% 2;
		let gone = n <<% 64;
		acc += back + m + gone + (n <<% 2);
		return acc;
	});
	return got + acc;
}

worker fn in_worker_wrapping(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let big: int = 9223372036854775807;
	let w = big +% n;
	let back = w -% big;
	let m = big *% 2;
	let gone = n <<% 64;
	acc += back + m + gone + (n <<% 2);
	return acc;
}

worker fn work_wrapping(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_wrapping(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_wrapping(fn(n) {
		let acc = 0;
		let big: int = 9223372036854775807;
		let w = big +% n;
		let back = w -% big;
		let m = big *% 2;
		let gone = n <<% 64;
		acc += back + m + gone + (n <<% 2);
		return acc;
	});
	return join(job);
}

struct Guarded_wrapping
{
	lock: Mutex,
	entered: int,
}

fn in_sync_wrapping(g: *Guarded_wrapping, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let big: int = 9223372036854775807;
		let w = big +% n;
		let back = w -% big;
		let m = big *% 2;
		let gone = n <<% 64;
		acc += back + m + gone + (n <<% 2);
	}
	return acc;
}

fn in_select_wrapping(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let big: int = 9223372036854775807;
			let w = big +% n;
			let back = w -% big;
			let m = big *% 2;
			let gone = n <<% 64;
			acc += back + m + gone + (n <<% 2);
		},
	}
	return acc;
}

fn in_generic_wrapping<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	let big: int = 9223372036854775807;
	let w = big +% n;
	let back = w -% big;
	let m = big *% 2;
	let gone = n <<% 64;
	acc += back + m + gone + (n <<% 2);
	return acc;
}

class Outer_wrapping
{
	class Inner_wrapping
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let big: int = 9223372036854775807;
			let w = big +% n;
			let back = w -% big;
			let m = big *% 2;
			let gone = n <<% 64;
			acc += back + m + gone + (n <<% 2);
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_wrapping { base: 1000 };
		return inner.run(n);
	}
}

class Box_saturating
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		let small: i8 = 100;
		let up = small +| (n as i8 * 10);
		let down = (0 - small) -| (n as i8 * 10);
		let times = small *| (n as i8);
		acc += up as int - down as int + times as int;
		return acc;
	}
}

fn in_loop_saturating(n: int) -> int
{
	let acc = 0;
	for turn in 0..2 {
		acc += turn;
		let small: i8 = 100;
		let up = small +| (n as i8 * 10);
		let down = (0 - small) -| (n as i8 * 10);
		let times = small *| (n as i8);
		acc += up as int - down as int + times as int;
	}
	return acc;
}

fn in_arm_saturating(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let small: i8 = 100;
			let up = small +| (n as i8 * 10);
			let down = (0 - small) -| (n as i8 * 10);
			let times = small *| (n as i8);
			acc += up as int - down as int + times as int;
		},
	}
	return acc;
}

fn held_saturating(n: int) -> ?int
{
	if n == 0 {
		return none;
