		printf("unary if_let %d\n".ptr, in_if_let_unary(1) as c_int);
		printf("unary if_let %d\n".ptr, in_if_let_unary(2) as c_int);
		printf("unary if_let %d\n".ptr, in_if_let_unary(3) as c_int);
		printf("unary if_let %d\n".ptr, in_if_let_unary(4) as c_int);
		let deferred = 0;
		in_defer_unary(1, &deferred);
		printf("unary defer %d\n".ptr, deferred as c_int);
		in_defer_unary(2, &deferred);
		printf("unary defer %d\n".ptr, deferred as c_int);
		in_defer_unary(3, &deferred);
		printf("unary defer %d\n".ptr, deferred as c_int);
		in_defer_unary(4, &deferred);
		printf("unary defer %d\n".ptr, deferred as c_int);
		let undone = 0;
		in_undo_unary(0, &undone) catch {
			yield;
		};
		printf("unary undo %d\n".ptr, undone as c_int);
		in_undo_unary(1, &undone) catch {
			yield;
		};
		printf("unary undo %d\n".ptr, undone as c_int);
		in_undo_unary(2, &undone) catch {
			yield;
		};
		printf("unary undo %d\n".ptr, undone as c_int);
		in_undo_unary(3, &undone) catch {
			yield;
		};
		printf("unary undo %d\n".ptr, undone as c_int);
		in_undo_unary(4, &undone) catch {
			yield;
		};
		printf("unary undo %d\n".ptr, undone as c_int);
		let c = chan int(1);
		printf("unary select %d\n".ptr, in_select_unary(c, 1) as c_int);
		printf("unary select %d\n".ptr, in_select_unary(c, 2) as c_int);
		printf("unary select %d\n".ptr, in_select_unary(c, 3) as c_int);
		printf("unary select %d\n".ptr, in_select_unary(c, 4) as c_int);
		delete(c);
		let outer = Outer_unary { };
		printf("unary nested %d\n".ptr, outer.go(1) as c_int);
		printf("unary nested %d\n".ptr, outer.go(2) as c_int);
		printf("unary nested %d\n".ptr, outer.go(3) as c_int);
		printf("unary nested %d\n".ptr, outer.go(4) as c_int);
	}
	{
		let deferred = 0;
		in_defer_as(1, &deferred);
		printf("as defer %d\n".ptr, deferred as c_int);
		in_defer_as(2, &deferred);
		printf("as defer %d\n".ptr, deferred as c_int);
		in_defer_as(3, &deferred);
		printf("as defer %d\n".ptr, deferred as c_int);
		in_defer_as(4, &deferred);
		printf("as defer %d\n".ptr, deferred as c_int);
		let undone = 0;
		in_undo_as(0, &undone) catch {
			yield;
		};
		printf("as undo %d\n".ptr, undone as c_int);
		in_undo_as(1, &undone) catch {
			yield;
		};
		printf("as undo %d\n".ptr, undone as c_int);
		in_undo_as(2, &undone) catch {
			yield;
		};
		printf("as undo %d\n".ptr, undone as c_int);
		in_undo_as(3, &undone) catch {
			yield;
		};
		printf("as undo %d\n".ptr, undone as c_int);
		in_undo_as(4, &undone) catch {
			yield;
		};
		printf("as undo %d\n".ptr, undone as c_int);
		printf("as dispatch %d\n".ptr, in_dispatch_as(task, 1) as c_int);
		printf("as dispatch %d\n".ptr, in_dispatch_as(task, 2) as c_int);
		printf("as dispatch %d\n".ptr, in_dispatch_as(task, 3) as c_int);
		printf("as dispatch %d\n".ptr, in_dispatch_as(task, 4) as c_int);
		let g = Guarded_as { lock: Mutex.new(), entered: 0 };
		printf("as sync %d\n".ptr, in_sync_as(&g, 1) as c_int);
		printf("as sync %d\n".ptr, in_sync_as(&g, 2) as c_int);
		printf("as sync %d\n".ptr, in_sync_as(&g, 3) as c_int);
		printf("as sync %d\n".ptr, in_sync_as(&g, 4) as c_int);
		printf("as sync entered %d\n".ptr, g.entered as c_int);
		g.lock.destroy();
		let c = chan int(1);
		printf("as select %d\n".ptr, in_select_as(c, 1) as c_int);
		printf("as select %d\n".ptr, in_select_as(c, 2) as c_int);
		printf("as select %d\n".ptr, in_select_as(c, 3) as c_int);
		printf("as select %d\n".ptr, in_select_as(c, 4) as c_int);
		delete(c);
	}
	delete(task);
	return 0;
}
