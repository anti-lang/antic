fn in_arm_unary(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let neg = -n;
			let no = !(n > 2);
			acc += neg * neg - -3;
			if no {
				acc += 100;
			}
		},
	}
	return acc;
}

fn held_unary(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_unary(n: int) -> int
{
	let acc = 0;
	if let v = held_unary(n) {
		acc += v - n * 3;
		let neg = -n;
		let no = !(n > 2);
		acc += neg * neg - -3;
		if no {
			acc += 100;
		}
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_unary(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let neg = -n;
		let no = !(n > 2);
		acc += neg * neg - -3;
		if no {
			acc += 100;
		}
	}
	acc = 5;
}

fn in_undo_unary(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let neg = -n;
		let no = !(n > 2);
		acc += neg * neg - -3;
		if no {
			acc += 100;
		}
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn in_select_unary(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let neg = -n;
			let no = !(n > 2);
			acc += neg * neg - -3;
			if no {
				acc += 100;
			}
		},
	}
	return acc;
}

class Outer_unary
{
	class Inner_unary
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let neg = -n;
			let no = !(n > 2);
			acc += neg * neg - -3;
			if no {
				acc += 100;
			}
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_unary { base: 1000 };
		return inner.run(n);
	}
}

fn in_defer_as(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let small = (n + 250) as u8;
		let f = n as f64;
		let wide = small as u32;
		acc += small as int + (f * 1.5) as int + wide as int;
	}
	acc = 5;
}

fn in_undo_as(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let small = (n + 250) as u8;
		let f = n as f64;
		let wide = small as u32;
		acc += small as int + (f * 1.5) as int + wide as int;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

worker fn work_as(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_as(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_as(fn(n) {
		let acc = 0;
		let small = (n + 250) as u8;
		let f = n as f64;
		let wide = small as u32;
		acc += small as int + (f * 1.5) as int + wide as int;
		return acc;
	});
	return join(job);
}

struct Guarded_as
{
	lock: Mutex,
	entered: int,
}

fn in_sync_as(g: *Guarded_as, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let small = (n + 250) as u8;
		let f = n as f64;
		let wide = small as u32;
		acc += small as int + (f * 1.5) as int + wide as int;
	}
	return acc;
}

fn in_select_as(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let small = (n + 250) as u8;
			let f = n as f64;
			let wide = small as u32;
			acc += small as int + (f * 1.5) as int + wide as int;
		},
	}
	return acc;
}

