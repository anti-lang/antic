class Box_mul_high
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		let wide = (n as u64) << 60;
		acc += mul_high(wide, 32) as int + mul_high(0 - n, 2);
		return acc;
	}
}

fn in_loop_mul_high(n: int) -> int
{
	let acc = 0;
	for turn in 0..2 {
		acc += turn;
		let wide = (n as u64) << 60;
		acc += mul_high(wide, 32) as int + mul_high(0 - n, 2);
	}
	return acc;
}

fn in_arm_mul_high(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let wide = (n as u64) << 60;
			acc += mul_high(wide, 32) as int + mul_high(0 - n, 2);
		},
	}
	return acc;
}

fn held_mul_high(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_mul_high(n: int) -> int
{
