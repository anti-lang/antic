//! `=` stores a lent slice in an element of an array that is not lent.

class Node
{
	pub n: int = 0,
}

fn run(lent s: []int) -> int
{
	let numbers = [1, 2];
	let xs = [numbers[0..1], numbers[1..2]];
	xs[0] = s;
	return 0;
}

fn main() -> int
{
	let numbers = [1, 2];
	return run(numbers[0..2]);
}
