//! `delete` of a `?*T` that no test has narrowed. `delete` runs the `destruct`
//! of an object, and `none` points at none.

class Node
{
	pub n: int = 0,
}

fn find(p: *Node, yes: bool) -> ?*Node
{
	if yes {
		return p;
	}
	return none;
}

fn main() -> int
{
	let p = alloc Node { };
	let q = find(p, true);
	delete(q);
	return 0;
}
