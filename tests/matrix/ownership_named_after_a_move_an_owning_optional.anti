//! A local that holds a `?T` of an owning value, named after it moved into an
//! `own` parameter. The function took the value over and tore it down.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn maybe(n: int) -> ?Key
{
	return key(n);
}

fn take(own x: ?Key) -> int
{
	return (x != none) as int;
}

fn main() -> int
{
	let a = maybe(1);
	let n = take(a);
	return n + take(a);
}
