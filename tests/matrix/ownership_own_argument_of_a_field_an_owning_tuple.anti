//! A field that holds a tuple that owns something, passed to an `own`
//! parameter. A value that stays where it is cannot move, and the copy would
//! give what it owns two owners.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

class Holder
{
	pub held: (Key, int),
}

fn take(own x: (Key, int)) -> int
{
	return x.1;
}

fn main() -> int
{
	let h = Holder { held: tuple(1) };
	return take(h.held);
}
