//! A `?T` of a slice compares by its flag and then the view it holds, its
//! address and its length, as a slice part of a tuple compares. Two values
//! equal by `==` hash alike. The program prints one line per pair.

extern fn printf(format: ?*byte, ...) -> c_int;

fn line(name: str, same: bool, hashed: bool)
{
	printf("%.*s %d %d\n".ptr, name.len as c_int, name.ptr, same as c_int,
		hashed as c_int);
}

fn main() -> int
{
	let a = [1, 2, 3];
	let b = [1, 2, 3];
	let x: ?[]int = a[0..2];
	let y: ?[]int = a[0..2];
	let shorter: ?[]int = a[0..1];
	let other: ?[]int = b[0..2];
	let empty: ?[]int = none;
	let blank: ?[]int = none;
	line("same view", x == y, x.hash() == y.hash());
	line("shorter view", x == shorter, true);
	line("other array", x == other, true);
	line("none and none", empty == blank, empty.hash() == blank.hash());
	line("view and none", x == empty, true);
	line("not equal", x != y, true);
	return 0;
}
