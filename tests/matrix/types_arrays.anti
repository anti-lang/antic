//! Fixed arrays of each kind of element, read and written with a constant index
//! and with an index the program computes, and changed by a compound assignment
//! through both. Then arrays of arrays, arrays as arguments, as results and as
//! fields, and the lengths the checker takes. A line names its element or its
//! subject. The arrays of packed structs, of unions, of enums and of variants
//! stand in the programs of those types.

extern fn printf(format: ?*byte, ...) -> c_int;

fn array_of_i8()
{
	let xs: [4]i8 = [1, 2, 3, 4];
	let i = 2;
	xs[0] = 10;
	xs[i] = 30;
	xs[3] += xs[i - 1];
	xs[i + 1] -= 1;
	printf("i8 %lld %lld %lld %lld\n".ptr, xs[0] as int, xs[1] as int,
		xs[i] as int, xs[3] as int);
}

