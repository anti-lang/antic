//! The aggregates of the values area and what reads them, each in every place
//! its row of docs/notes/test-matrix.md left open: array, array_repeat,
//! slice_literal, struct_literal, tuple, tuple_element, index, slice, field.
//! Each construct in each place is a function of its own, named after both, and
//! the program prints one line per construct, place and input.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

struct Pt
{
	x: int,
	y: int,
}

class Task
{
	pub n: int = 0,
}

fn in_arm_array(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let xs = [n, 20, 300];
			acc += xs[0] + xs[1] + xs[2] + xs.len;
		},
	}
	return acc;
}

fn held_array(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_array(n: int) -> int
{
	let acc = 0;
	if let v = held_array(n) {
		acc += v - n * 3;
		let xs = [n, 20, 300];
		acc += xs[0] + xs[1] + xs[2] + xs.len;
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_array(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let xs = [n, 20, 300];
		acc += xs[0] + xs[1] + xs[2] + xs.len;
	}
	acc = 5;
}

fn in_undo_array(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let xs = [n, 20, 300];
		acc += xs[0] + xs[1] + xs[2] + xs.len;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_array(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_array(n: int) -> int
{
	let acc = 0;
	let got = risky_array(n) catch {
		let xs = [n, 20, 300];
		acc += xs[0] + xs[1] + xs[2] + xs.len;
		yield acc;
	};
	return got;
}

fn apply_array(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_array(start: int) -> int
{
	let acc = 0;
	let got = apply_array(start, fn(n) {
		let xs = [n, 20, 300];
		acc += xs[0] + xs[1] + xs[2] + xs.len;
		return acc;
	});
	return got + acc;
}

worker fn in_worker_array(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let xs = [n, 20, 300];
	acc += xs[0] + xs[1] + xs[2] + xs.len;
	return acc;
}

worker fn work_array(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_array(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_array(fn(n) {
		let acc = 0;
		let xs = [n, 20, 300];
		acc += xs[0] + xs[1] + xs[2] + xs.len;
		return acc;
	});
	return join(job);
}

struct Guarded_array
{
	lock: Mutex,
	entered: int,
}

fn in_sync_array(g: *Guarded_array, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let xs = [n, 20, 300];
		acc += xs[0] + xs[1] + xs[2] + xs.len;
	}
	return acc;
}

fn in_select_array(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let xs = [n, 20, 300];
			acc += xs[0] + xs[1] + xs[2] + xs.len;
		},
	}
	return acc;
}

class Outer_array
{
	class Inner_array
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let xs = [n, 20, 300];
			acc += xs[0] + xs[1] + xs[2] + xs.len;
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_array { base: 1000 };
		return inner.run(n);
	}
}

fn in_loop_array_repeat(n: int) -> int
{
	let acc = 0;
	for turn in 0..2 {
		acc += turn;
		let xs = [n * 2; 4];
		acc += xs[0] + xs[3] + xs.len;
	}
	return acc;
}

fn in_arm_array_repeat(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let xs = [n * 2; 4];
			acc += xs[0] + xs[3] + xs.len;
		},
	}
	return acc;
}

