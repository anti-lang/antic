fn in_loop_slice_literal(n: int) -> int
{
	let acc = 0;
	for turn in 0..2 {
		acc += turn;
		let xs = [n, 20, 300];
		let s = []int { ptr: &xs[0], len: 2 };
		acc += s[0] + s[1] + s.len;
	}
	return acc;
}

