fn in_generic_tuple_element<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	let t = (n, 7);
	t.1 = t.0 * 10;
	acc += t.1 + t.0;
	return acc;
}

class Outer_tuple_element
{
	class Inner_tuple_element
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let t = (n, 7);
			t.1 = t.0 * 10;
			acc += t.1 + t.0;
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_tuple_element { base: 1000 };
		return inner.run(n);
	}
}

fn in_arm_index(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let xs = [10, 20, 30, 40, 50];
			xs[n] = xs[n] + 1;
			acc += xs[n] + xs[0];
		},
	}
	return acc;
}

fn held_index(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_index(n: int) -> int
{
	let acc = 0;
	if let v = held_index(n) {
		acc += v - n * 3;
		let xs = [10, 20, 30, 40, 50];
		xs[n] = xs[n] + 1;
		acc += xs[n] + xs[0];
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_index(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let xs = [10, 20, 30, 40, 50];
		xs[n] = xs[n] + 1;
		acc += xs[n] + xs[0];
	}
	acc = 5;
}

fn in_undo_index(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let xs = [10, 20, 30, 40, 50];
		xs[n] = xs[n] + 1;
		acc += xs[n] + xs[0];
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_index(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_index(n: int) -> int
{
	let acc = 0;
	let got = risky_index(n) catch {
		let xs = [10, 20, 30, 40, 50];
		xs[n] = xs[n] + 1;
		acc += xs[n] + xs[0];
		yield acc;
	};
	return got;
}

fn in_select_index(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let xs = [10, 20, 30, 40, 50];
			xs[n] = xs[n] + 1;
			acc += xs[n] + xs[0];
		},
	}
	return acc;
}

class Outer_index
{
	class Inner_index
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let xs = [10, 20, 30, 40, 50];
			xs[n] = xs[n] + 1;
			acc += xs[n] + xs[0];
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_index { base: 1000 };
		return inner.run(n);
	}
}

fn in_arm_slice(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let xs = [10, 20, 30, 40, 50];
			let s = xs[1..n + 1];
			acc += s.len * 100 + s[0] + s[n - 1];
		},
	}
	return acc;
}

fn held_slice(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_slice(n: int) -> int
{
	let acc = 0;
	if let v = held_slice(n) {
		acc += v - n * 3;
		let xs = [10, 20, 30, 40, 50];
		let s = xs[1..n + 1];
		acc += s.len * 100 + s[0] + s[n - 1];
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_slice(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let xs = [10, 20, 30, 40, 50];
		let s = xs[1..n + 1];
		acc += s.len * 100 + s[0] + s[n - 1];
	}
	acc = 5;
}

fn in_undo_slice(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let xs = [10, 20, 30, 40, 50];
		let s = xs[1..n + 1];
		acc += s.len * 100 + s[0] + s[n - 1];
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_slice(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_slice(n: int) -> int
{
	let acc = 0;
	let got = risky_slice(n) catch {
		let xs = [10, 20, 30, 40, 50];
		let s = xs[1..n + 1];
		acc += s.len * 100 + s[0] + s[n - 1];
		yield acc;
	};
	return got;
}

worker fn in_worker_slice(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let xs = [10, 20, 30, 40, 50];
	let s = xs[1..n + 1];
	acc += s.len * 100 + s[0] + s[n - 1];
	return acc;
}

struct Guarded_slice
{
	lock: Mutex,
	entered: int,
}

fn in_sync_slice(g: *Guarded_slice, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let xs = [10, 20, 30, 40, 50];
		let s = xs[1..n + 1];
		acc += s.len * 100 + s[0] + s[n - 1];
	}
	return acc;
}

fn in_select_slice(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let xs = [10, 20, 30, 40, 50];
			let s = xs[1..n + 1];
			acc += s.len * 100 + s[0] + s[n - 1];
		},
	}
	return acc;
}

fn in_generic_slice<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	let xs = [10, 20, 30, 40, 50];
	let s = xs[1..n + 1];
	acc += s.len * 100 + s[0] + s[n - 1];
	return acc;
}

class Outer_slice
{
	class Inner_slice
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let xs = [10, 20, 30, 40, 50];
			let s = xs[1..n + 1];
			acc += s.len * 100 + s[0] + s[n - 1];
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_slice { base: 1000 };
		return inner.run(n);
	}
}

fn in_select_field(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let p = Pt { x: n, y: 2 };
			p.y = p.x * 3;
			acc += p.x + p.y;
		},
	}
	return acc;
}

