fn in_arm_tuple_element(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let t = (n, 7);
			t.1 = t.0 * 10;
			acc += t.1 + t.0;
		},
	}
	return acc;
}

