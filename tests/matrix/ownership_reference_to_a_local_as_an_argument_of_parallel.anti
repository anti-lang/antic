//! `parallel` waits for every chunk before it gives its value, so the address
//! of a local passed as an argument of its worker never outlives the local.

import anti.io;
import anti.text;

fn say(s: str)
{
	io.println(s);
	free(s.ptr);
}

synchronized class Counter
{
	n: int = 0,

	pub fn bump(self, by: int) -> int
	{
		self.n += by;
		return self.n;
	}

	pub fn get(self) -> int
	{
		return self.n;
	}
}

worker fn count(chunk: []int, c: *Counter) -> int
{
	return c.bump(chunk.len);
}

fn main() -> int
{
	let xs = alloc([4]int, 1) else {
		return 1;
	};
	for i in 0..4 {
		(*xs)[i] = i;
	}
	let c = Counter { };
	let parts = parallel (*xs)[0..4] by 2 -> count(&c);
	say(f"the elements counted through a local: {c.get()}");
	free(parts.ptr);
	free(xs);
	return 0;
}
