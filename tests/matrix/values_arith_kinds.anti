fn on_byte(z: byte)
{
	const F0: byte = 255 + 1;
	let r0: byte = (255 ^ z) + (1 ^ z);
	printf("add byte 255 1 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: byte = 255 + 255;
	let r1: byte = (255 ^ z) + (255 ^ z);
	printf("add byte 255 255 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
