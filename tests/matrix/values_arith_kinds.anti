	const F41: byte = 0 % 1;
	let r41: byte = (0 ^ z) % (1 ^ z);
	printf("rem byte 0 1 = %llu %llu\n".ptr, F41 as u64, r41 as u64);
	const F42: byte = 1 % 255;
	let r42: byte = (1 ^ z) % (255 ^ z);
	printf("rem byte 1 255 = %llu %llu\n".ptr, F42 as u64, r42 as u64);
}

fn wrapping_on_i8(z: i8)
{
	const F0: i8 = 127 +% 1;
	let r0: i8 = (127 ^ z) +% (1 ^ z);
	printf("add_wrap i8 127 1 = %lld %lld\n".ptr, F0 as int, r0 as int);
	const F1: i8 = 127 +% 127;
	let r1: i8 = (127 ^ z) +% (127 ^ z);
