	const F27: i8 = 7 *% 2;
	let r27: i8 = (7 ^ z) *% (2 ^ z);
	printf("mul_wrap i8 7 2 = %lld %lld\n".ptr, F27 as int, r27 as int);
	const F28: i8 = -128 *% -128;
	let r28: i8 = (-128 ^ z) *% (-128 ^ z);
	printf("mul_wrap i8 -128 -128 = %lld %lld\n".ptr, F28 as int, r28 as int);
	const F29: i8 = -128 *% -1;
	let r29: i8 = (-128 ^ z) *% (-1 ^ z);
	printf("mul_wrap i8 -128 -1 = %lld %lld\n".ptr, F29 as int, r29 as int);
	const F30: i8 = 127 *% -1;
	let r30: i8 = (127 ^ z) *% (-1 ^ z);
	printf("mul_wrap i8 127 -1 = %lld %lld\n".ptr, F30 as int, r30 as int);
	const F31: i8 = -7 *% 2;
	let r31: i8 = (-7 ^ z) *% (2 ^ z);
	printf("mul_wrap i8 -7 2 = %lld %lld\n".ptr, F31 as int, r31 as int);
	const F32: i8 = 7 *% -2;
	let r32: i8 = (7 ^ z) *% (-2 ^ z);
	printf("mul_wrap i8 7 -2 = %lld %lld\n".ptr, F32 as int, r32 as int);
