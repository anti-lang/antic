	const F47: byte = 254 % 255;
	let r47: byte = (254 ^ z) % (255 ^ z);
	printf("rem byte 254 255 = %llu %llu\n".ptr, F47 as u64, r47 as u64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	on_i8(zero as i8);
	on_i16(zero as i16);
	on_i32(zero as i32);
	on_i64(zero as i64);
	on_int(zero as int);
	on_u8(zero as u8);
	on_u16(zero as u16);
	on_u32(zero as u32);
	on_u64(zero as u64);
	on_uint(zero as uint);
	on_byte(zero as byte);
	return 0;
}
