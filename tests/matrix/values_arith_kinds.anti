//! `+ - * / %` on every integer type at its limits. An unsigned result wraps in
//! every build. A signed one that leaves its range wraps in a constant and
//! stops a dev build at run time. Each line holds the value the checker folds
//! in a constant and the value the program computes from operands it cannot
//! know before it runs. `none` stands where the checker refuses the constant,
//! and `checked` where a dev build stops, so the program does not run the case.

extern fn printf(format: ?*byte, ...) -> c_int;

fn on_i8(z: i8)
{
	const F0: i8 = 127 + 1;
	printf("add i8 127 1 = %lld checked\n".ptr, F0 as int);
	const F1: i8 = 127 + 127;
	printf("add i8 127 127 = %lld checked\n".ptr, F1 as int);
	const F2: i8 = -128 + 1;
	let r2: i8 = (-128 ^ z) + (1 ^ z);
	printf("add i8 -128 1 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: i8 = -128 + 127;
	let r3: i8 = (-128 ^ z) + (127 ^ z);
	printf("add i8 -128 127 = %lld %lld\n".ptr, F3 as int, r3 as int);
	const F4: i8 = 127 + 2;
	printf("add i8 127 2 = %lld checked\n".ptr, F4 as int);
	const F5: i8 = 7 + 2;
	let r5: i8 = (7 ^ z) + (2 ^ z);
	printf("add i8 7 2 = %lld %lld\n".ptr, F5 as int, r5 as int);
	const F6: i8 = -128 + -128;
	printf("add i8 -128 -128 = %lld checked\n".ptr, F6 as int);
	const F7: i8 = -128 + -1;
	printf("add i8 -128 -1 = %lld checked\n".ptr, F7 as int);
	const F8: i8 = 127 + -1;
	let r8: i8 = (127 ^ z) + (-1 ^ z);
	printf("add i8 127 -1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i8 = -7 + 2;
	let r9: i8 = (-7 ^ z) + (2 ^ z);
	printf("add i8 -7 2 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i8 = 7 + -2;
	let r10: i8 = (7 ^ z) + (-2 ^ z);
	printf("add i8 7 -2 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i8 = -1 + -1;
	let r11: i8 = (-1 ^ z) + (-1 ^ z);
	printf("add i8 -1 -1 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i8 = -127 + -1;
	let r12: i8 = (-127 ^ z) + (-1 ^ z);
	printf("add i8 -127 -1 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: i8 = 127 - 1;
	let r13: i8 = (127 ^ z) - (1 ^ z);
	printf("sub i8 127 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: i8 = 127 - 127;
	let r14: i8 = (127 ^ z) - (127 ^ z);
	printf("sub i8 127 127 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: i8 = -128 - 1;
	printf("sub i8 -128 1 = %lld checked\n".ptr, F15 as int);
	const F16: i8 = -128 - 127;
	printf("sub i8 -128 127 = %lld checked\n".ptr, F16 as int);
	const F17: i8 = 127 - 2;
	let r17: i8 = (127 ^ z) - (2 ^ z);
	printf("sub i8 127 2 = %lld %lld\n".ptr, F17 as int, r17 as int);
	const F18: i8 = 7 - 2;
	let r18: i8 = (7 ^ z) - (2 ^ z);
	printf("sub i8 7 2 = %lld %lld\n".ptr, F18 as int, r18 as int);
	const F19: i8 = -128 - -128;
	let r19: i8 = (-128 ^ z) - (-128 ^ z);
	printf("sub i8 -128 -128 = %lld %lld\n".ptr, F19 as int, r19 as int);
	const F20: i8 = -128 - -1;
	let r20: i8 = (-128 ^ z) - (-1 ^ z);
	printf("sub i8 -128 -1 = %lld %lld\n".ptr, F20 as int, r20 as int);
	const F21: i8 = 127 - -1;
	printf("sub i8 127 -1 = %lld checked\n".ptr, F21 as int);
	const F22: i8 = -7 - 2;
	let r22: i8 = (-7 ^ z) - (2 ^ z);
	printf("sub i8 -7 2 = %lld %lld\n".ptr, F22 as int, r22 as int);
	const F23: i8 = 7 - -2;
	let r23: i8 = (7 ^ z) - (-2 ^ z);
	printf("sub i8 7 -2 = %lld %lld\n".ptr, F23 as int, r23 as int);
	const F24: i8 = -1 - -1;
	let r24: i8 = (-1 ^ z) - (-1 ^ z);
	printf("sub i8 -1 -1 = %lld %lld\n".ptr, F24 as int, r24 as int);
	const F25: i8 = -127 - -1;
	let r25: i8 = (-127 ^ z) - (-1 ^ z);
	printf("sub i8 -127 -1 = %lld %lld\n".ptr, F25 as int, r25 as int);
	const F26: i8 = 127 * 1;
	let r26: i8 = (127 ^ z) * (1 ^ z);
	printf("mul i8 127 1 = %lld %lld\n".ptr, F26 as int, r26 as int);
	const F27: i8 = 127 * 127;
	printf("mul i8 127 127 = %lld checked\n".ptr, F27 as int);
	const F28: i8 = -128 * 1;
	let r28: i8 = (-128 ^ z) * (1 ^ z);
	printf("mul i8 -128 1 = %lld %lld\n".ptr, F28 as int, r28 as int);
	const F29: i8 = -128 * 127;
	printf("mul i8 -128 127 = %lld checked\n".ptr, F29 as int);
	const F30: i8 = 127 * 2;
	printf("mul i8 127 2 = %lld checked\n".ptr, F30 as int);
	const F31: i8 = 7 * 2;
	let r31: i8 = (7 ^ z) * (2 ^ z);
	printf("mul i8 7 2 = %lld %lld\n".ptr, F31 as int, r31 as int);
	const F32: i8 = -128 * -128;
	printf("mul i8 -128 -128 = %lld checked\n".ptr, F32 as int);
	const F33: i8 = -128 * -1;
	printf("mul i8 -128 -1 = %lld checked\n".ptr, F33 as int);
	const F34: i8 = 127 * -1;
	let r34: i8 = (127 ^ z) * (-1 ^ z);
	printf("mul i8 127 -1 = %lld %lld\n".ptr, F34 as int, r34 as int);
	const F35: i8 = -7 * 2;
	let r35: i8 = (-7 ^ z) * (2 ^ z);
	printf("mul i8 -7 2 = %lld %lld\n".ptr, F35 as int, r35 as int);
	const F36: i8 = 7 * -2;
	let r36: i8 = (7 ^ z) * (-2 ^ z);
	printf("mul i8 7 -2 = %lld %lld\n".ptr, F36 as int, r36 as int);
	const F37: i8 = -1 * -1;
	let r37: i8 = (-1 ^ z) * (-1 ^ z);
	printf("mul i8 -1 -1 = %lld %lld\n".ptr, F37 as int, r37 as int);
	const F38: i8 = -127 * -1;
	let r38: i8 = (-127 ^ z) * (-1 ^ z);
	printf("mul i8 -127 -1 = %lld %lld\n".ptr, F38 as int, r38 as int);
	const F39: i8 = 127 / 1;
	let r39: i8 = (127 ^ z) / (1 ^ z);
	printf("div i8 127 1 = %lld %lld\n".ptr, F39 as int, r39 as int);
	const F40: i8 = 127 / 127;
	let r40: i8 = (127 ^ z) / (127 ^ z);
	printf("div i8 127 127 = %lld %lld\n".ptr, F40 as int, r40 as int);
	const F41: i8 = -128 / 1;
	let r41: i8 = (-128 ^ z) / (1 ^ z);
	printf("div i8 -128 1 = %lld %lld\n".ptr, F41 as int, r41 as int);
	const F42: i8 = -128 / 127;
	let r42: i8 = (-128 ^ z) / (127 ^ z);
	printf("div i8 -128 127 = %lld %lld\n".ptr, F42 as int, r42 as int);
	const F43: i8 = 127 / 2;
	let r43: i8 = (127 ^ z) / (2 ^ z);
	printf("div i8 127 2 = %lld %lld\n".ptr, F43 as int, r43 as int);
	const F44: i8 = 7 / 2;
	let r44: i8 = (7 ^ z) / (2 ^ z);
	printf("div i8 7 2 = %lld %lld\n".ptr, F44 as int, r44 as int);
	const F45: i8 = -128 / -128;
	let r45: i8 = (-128 ^ z) / (-128 ^ z);
	printf("div i8 -128 -128 = %lld %lld\n".ptr, F45 as int, r45 as int);
	let r46: i8 = (-128 ^ z) / (-1 ^ z);
	printf("div i8 -128 -1 = none %lld\n".ptr, r46 as int);
	const F47: i8 = 127 / -1;
	let r47: i8 = (127 ^ z) / (-1 ^ z);
	printf("div i8 127 -1 = %lld %lld\n".ptr, F47 as int, r47 as int);
	const F48: i8 = -7 / 2;
	let r48: i8 = (-7 ^ z) / (2 ^ z);
	printf("div i8 -7 2 = %lld %lld\n".ptr, F48 as int, r48 as int);
	const F49: i8 = 7 / -2;
	let r49: i8 = (7 ^ z) / (-2 ^ z);
	printf("div i8 7 -2 = %lld %lld\n".ptr, F49 as int, r49 as int);
	const F50: i8 = -1 / -1;
	let r50: i8 = (-1 ^ z) / (-1 ^ z);
	printf("div i8 -1 -1 = %lld %lld\n".ptr, F50 as int, r50 as int);
	const F51: i8 = -127 / -1;
	let r51: i8 = (-127 ^ z) / (-1 ^ z);
	printf("div i8 -127 -1 = %lld %lld\n".ptr, F51 as int, r51 as int);
	const F52: i8 = 127 % 1;
	let r52: i8 = (127 ^ z) % (1 ^ z);
	printf("rem i8 127 1 = %lld %lld\n".ptr, F52 as int, r52 as int);
	const F53: i8 = 127 % 127;
	let r53: i8 = (127 ^ z) % (127 ^ z);
	printf("rem i8 127 127 = %lld %lld\n".ptr, F53 as int, r53 as int);
	const F54: i8 = -128 % 1;
	let r54: i8 = (-128 ^ z) % (1 ^ z);
	printf("rem i8 -128 1 = %lld %lld\n".ptr, F54 as int, r54 as int);
	const F55: i8 = -128 % 127;
	let r55: i8 = (-128 ^ z) % (127 ^ z);
	printf("rem i8 -128 127 = %lld %lld\n".ptr, F55 as int, r55 as int);
	const F56: i8 = 127 % 2;
	let r56: i8 = (127 ^ z) % (2 ^ z);
	printf("rem i8 127 2 = %lld %lld\n".ptr, F56 as int, r56 as int);
	const F57: i8 = 7 % 2;
	let r57: i8 = (7 ^ z) % (2 ^ z);
	printf("rem i8 7 2 = %lld %lld\n".ptr, F57 as int, r57 as int);
	const F58: i8 = -128 % -128;
	let r58: i8 = (-128 ^ z) % (-128 ^ z);
	printf("rem i8 -128 -128 = %lld %lld\n".ptr, F58 as int, r58 as int);
	let r59: i8 = (-128 ^ z) % (-1 ^ z);
	printf("rem i8 -128 -1 = none %lld\n".ptr, r59 as int);
	const F60: i8 = 127 % -1;
	let r60: i8 = (127 ^ z) % (-1 ^ z);
	printf("rem i8 127 -1 = %lld %lld\n".ptr, F60 as int, r60 as int);
	const F61: i8 = -7 % 2;
	let r61: i8 = (-7 ^ z) % (2 ^ z);
	printf("rem i8 -7 2 = %lld %lld\n".ptr, F61 as int, r61 as int);
	const F62: i8 = 7 % -2;
	let r62: i8 = (7 ^ z) % (-2 ^ z);
	printf("rem i8 7 -2 = %lld %lld\n".ptr, F62 as int, r62 as int);
	const F63: i8 = -1 % -1;
	let r63: i8 = (-1 ^ z) % (-1 ^ z);
	printf("rem i8 -1 -1 = %lld %lld\n".ptr, F63 as int, r63 as int);
	const F64: i8 = -127 % -1;
	let r64: i8 = (-127 ^ z) % (-1 ^ z);
	printf("rem i8 -127 -1 = %lld %lld\n".ptr, F64 as int, r64 as int);
}

fn on_i16(z: i16)
{
	const F0: i16 = 32767 + 1;
	printf("add i16 32767 1 = %lld checked\n".ptr, F0 as int);
	const F1: i16 = 32767 + 32767;
	printf("add i16 32767 32767 = %lld checked\n".ptr, F1 as int);
	const F2: i16 = -32768 + 1;
	let r2: i16 = (-32768 ^ z) + (1 ^ z);
	printf("add i16 -32768 1 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: i16 = -32768 + 32767;
	let r3: i16 = (-32768 ^ z) + (32767 ^ z);
	printf("add i16 -32768 32767 = %lld %lld\n".ptr, F3 as int, r3 as int);
	const F4: i16 = 32767 + 2;
	printf("add i16 32767 2 = %lld checked\n".ptr, F4 as int);
	const F5: i16 = 7 + 2;
	let r5: i16 = (7 ^ z) + (2 ^ z);
	printf("add i16 7 2 = %lld %lld\n".ptr, F5 as int, r5 as int);
	const F6: i16 = -32768 + -32768;
	printf("add i16 -32768 -32768 = %lld checked\n".ptr, F6 as int);
	const F7: i16 = -32768 + -1;
	printf("add i16 -32768 -1 = %lld checked\n".ptr, F7 as int);
