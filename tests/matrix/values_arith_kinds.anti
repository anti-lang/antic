	const F39: byte = 255 % 1;
	let r39: byte = (255 ^ z) % (1 ^ z);
	printf("rem byte 255 1 = %llu %llu\n".ptr, F39 as u64, r39 as u64);
	const F40: byte = 255 % 255;
	let r40: byte = (255 ^ z) % (255 ^ z);
	printf("rem byte 255 255 = %llu %llu\n".ptr, F40 as u64, r40 as u64);
	const F41: byte = 0 % 1;
	let r41: byte = (0 ^ z) % (1 ^ z);
	printf("rem byte 0 1 = %llu %llu\n".ptr, F41 as u64, r41 as u64);
	const F42: byte = 0 % 255;
