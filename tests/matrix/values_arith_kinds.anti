//! The arithmetic of every integer type at its limits: `+ - * / %`, the
//! wrapping `+% -% *%`, the saturating `+| -| *|` and `mul_high`. At run time
//! an unsigned result wraps in every build, and a signed `+ - *` that leaves
//! its range stops a dev build. A constant `+ - *` that leaves the range of its
//! type is refused, by R029 of "Rules of 2026-10-13". The wrapping and the
//! saturating operators are never checked. A line names the operator, the type
//! and the operands. It holds the value the checker folds in a constant and the
//! value the program computes from operands it cannot know before it runs.
//! `none` stands where the checker refuses the constant, and `checked` where a
//! dev build stops, so the program does not run the case.

extern fn printf(format: ?*byte, ...) -> c_int;

fn arith_on_i8(z: i8)
{
	printf("add i8 127 1 = none checked\n".ptr);
	printf("add i8 127 127 = none checked\n".ptr);
	const F2: i8 = -128 + 1;
	let r2: i8 = (-128 ^ z) + (1 ^ z);
	printf("add i8 -128 1 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: i8 = -128 + 127;
	let r3: i8 = (-128 ^ z) + (127 ^ z);
	printf("add i8 -128 127 = %lld %lld\n".ptr, F3 as int, r3 as int);
	printf("add i8 127 2 = none checked\n".ptr);
	const F5: i8 = 7 + 2;
	let r5: i8 = (7 ^ z) + (2 ^ z);
	printf("add i8 7 2 = %lld %lld\n".ptr, F5 as int, r5 as int);
	printf("add i8 -128 -128 = none checked\n".ptr);
	printf("add i8 -128 -1 = none checked\n".ptr);
	const F8: i8 = 127 + -1;
	let r8: i8 = (127 ^ z) + (-1 ^ z);
	printf("add i8 127 -1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i8 = -7 + 2;
	let r9: i8 = (-7 ^ z) + (2 ^ z);
	printf("add i8 -7 2 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i8 = 7 + -2;
	let r10: i8 = (7 ^ z) + (-2 ^ z);
	printf("add i8 7 -2 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i8 = 127 - 1;
	let r11: i8 = (127 ^ z) - (1 ^ z);
	printf("sub i8 127 1 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i8 = 127 - 127;
	let r12: i8 = (127 ^ z) - (127 ^ z);
	printf("sub i8 127 127 = %lld %lld\n".ptr, F12 as int, r12 as int);
	printf("sub i8 -128 1 = none checked\n".ptr);
	printf("sub i8 -128 127 = none checked\n".ptr);
	const F15: i8 = 127 - 2;
	let r15: i8 = (127 ^ z) - (2 ^ z);
	printf("sub i8 127 2 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: i8 = 7 - 2;
	let r16: i8 = (7 ^ z) - (2 ^ z);
	printf("sub i8 7 2 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: i8 = -128 - -128;
	let r17: i8 = (-128 ^ z) - (-128 ^ z);
	printf("sub i8 -128 -128 = %lld %lld\n".ptr, F17 as int, r17 as int);
	const F18: i8 = -128 - -1;
	let r18: i8 = (-128 ^ z) - (-1 ^ z);
	printf("sub i8 -128 -1 = %lld %lld\n".ptr, F18 as int, r18 as int);
	printf("sub i8 127 -1 = none checked\n".ptr);
	const F20: i8 = -7 - 2;
	let r20: i8 = (-7 ^ z) - (2 ^ z);
	printf("sub i8 -7 2 = %lld %lld\n".ptr, F20 as int, r20 as int);
	const F21: i8 = 7 - -2;
	let r21: i8 = (7 ^ z) - (-2 ^ z);
	printf("sub i8 7 -2 = %lld %lld\n".ptr, F21 as int, r21 as int);
	const F22: i8 = 127 * 1;
	let r22: i8 = (127 ^ z) * (1 ^ z);
	printf("mul i8 127 1 = %lld %lld\n".ptr, F22 as int, r22 as int);
	printf("mul i8 127 127 = none checked\n".ptr);
	const F24: i8 = -128 * 1;
	let r24: i8 = (-128 ^ z) * (1 ^ z);
	printf("mul i8 -128 1 = %lld %lld\n".ptr, F24 as int, r24 as int);
	printf("mul i8 -128 127 = none checked\n".ptr);
	printf("mul i8 127 2 = none checked\n".ptr);
	const F27: i8 = 7 * 2;
	let r27: i8 = (7 ^ z) * (2 ^ z);
	printf("mul i8 7 2 = %lld %lld\n".ptr, F27 as int, r27 as int);
	printf("mul i8 -128 -128 = none checked\n".ptr);
	printf("mul i8 -128 -1 = none checked\n".ptr);
	const F30: i8 = 127 * -1;
	let r30: i8 = (127 ^ z) * (-1 ^ z);
	printf("mul i8 127 -1 = %lld %lld\n".ptr, F30 as int, r30 as int);
	const F31: i8 = -7 * 2;
	let r31: i8 = (-7 ^ z) * (2 ^ z);
	printf("mul i8 -7 2 = %lld %lld\n".ptr, F31 as int, r31 as int);
	const F32: i8 = 7 * -2;
	let r32: i8 = (7 ^ z) * (-2 ^ z);
	printf("mul i8 7 -2 = %lld %lld\n".ptr, F32 as int, r32 as int);
	const F33: i8 = 127 / 1;
	let r33: i8 = (127 ^ z) / (1 ^ z);
	printf("div i8 127 1 = %lld %lld\n".ptr, F33 as int, r33 as int);
	const F34: i8 = 127 / 127;
	let r34: i8 = (127 ^ z) / (127 ^ z);
	printf("div i8 127 127 = %lld %lld\n".ptr, F34 as int, r34 as int);
	const F35: i8 = -128 / 1;
	let r35: i8 = (-128 ^ z) / (1 ^ z);
	printf("div i8 -128 1 = %lld %lld\n".ptr, F35 as int, r35 as int);
	const F36: i8 = -128 / 127;
	let r36: i8 = (-128 ^ z) / (127 ^ z);
	printf("div i8 -128 127 = %lld %lld\n".ptr, F36 as int, r36 as int);
	const F37: i8 = 127 / 2;
	let r37: i8 = (127 ^ z) / (2 ^ z);
	printf("div i8 127 2 = %lld %lld\n".ptr, F37 as int, r37 as int);
	const F38: i8 = 7 / 2;
	let r38: i8 = (7 ^ z) / (2 ^ z);
	printf("div i8 7 2 = %lld %lld\n".ptr, F38 as int, r38 as int);
	const F39: i8 = -128 / -128;
	let r39: i8 = (-128 ^ z) / (-128 ^ z);
	printf("div i8 -128 -128 = %lld %lld\n".ptr, F39 as int, r39 as int);
	let r40: i8 = (-128 ^ z) / (-1 ^ z);
	printf("div i8 -128 -1 = none %lld\n".ptr, r40 as int);
	const F41: i8 = 127 / -1;
	let r41: i8 = (127 ^ z) / (-1 ^ z);
	printf("div i8 127 -1 = %lld %lld\n".ptr, F41 as int, r41 as int);
	const F42: i8 = -7 / 2;
	let r42: i8 = (-7 ^ z) / (2 ^ z);
	printf("div i8 -7 2 = %lld %lld\n".ptr, F42 as int, r42 as int);
	const F43: i8 = 7 / -2;
	let r43: i8 = (7 ^ z) / (-2 ^ z);
	printf("div i8 7 -2 = %lld %lld\n".ptr, F43 as int, r43 as int);
	const F44: i8 = 127 % 1;
	let r44: i8 = (127 ^ z) % (1 ^ z);
	printf("rem i8 127 1 = %lld %lld\n".ptr, F44 as int, r44 as int);
	const F45: i8 = 127 % 127;
	let r45: i8 = (127 ^ z) % (127 ^ z);
	printf("rem i8 127 127 = %lld %lld\n".ptr, F45 as int, r45 as int);
	const F46: i8 = -128 % 1;
	let r46: i8 = (-128 ^ z) % (1 ^ z);
	printf("rem i8 -128 1 = %lld %lld\n".ptr, F46 as int, r46 as int);
	const F47: i8 = -128 % 127;
	let r47: i8 = (-128 ^ z) % (127 ^ z);
	printf("rem i8 -128 127 = %lld %lld\n".ptr, F47 as int, r47 as int);
	const F48: i8 = 127 % 2;
	let r48: i8 = (127 ^ z) % (2 ^ z);
	printf("rem i8 127 2 = %lld %lld\n".ptr, F48 as int, r48 as int);
	const F49: i8 = 7 % 2;
	let r49: i8 = (7 ^ z) % (2 ^ z);
	printf("rem i8 7 2 = %lld %lld\n".ptr, F49 as int, r49 as int);
	const F50: i8 = -128 % -128;
	let r50: i8 = (-128 ^ z) % (-128 ^ z);
	printf("rem i8 -128 -128 = %lld %lld\n".ptr, F50 as int, r50 as int);
	let r51: i8 = (-128 ^ z) % (-1 ^ z);
	printf("rem i8 -128 -1 = none %lld\n".ptr, r51 as int);
	const F52: i8 = 127 % -1;
	let r52: i8 = (127 ^ z) % (-1 ^ z);
	printf("rem i8 127 -1 = %lld %lld\n".ptr, F52 as int, r52 as int);
	const F53: i8 = -7 % 2;
	let r53: i8 = (-7 ^ z) % (2 ^ z);
	printf("rem i8 -7 2 = %lld %lld\n".ptr, F53 as int, r53 as int);
	const F54: i8 = 7 % -2;
	let r54: i8 = (7 ^ z) % (-2 ^ z);
	printf("rem i8 7 -2 = %lld %lld\n".ptr, F54 as int, r54 as int);
}

fn arith_on_i16(z: i16)
{
	printf("add i16 32767 1 = none checked\n".ptr);
	printf("add i16 32767 32767 = none checked\n".ptr);
	const F2: i16 = -32768 + 1;
	let r2: i16 = (-32768 ^ z) + (1 ^ z);
	printf("add i16 -32768 1 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: i16 = -32768 + 32767;
	let r3: i16 = (-32768 ^ z) + (32767 ^ z);
	printf("add i16 -32768 32767 = %lld %lld\n".ptr, F3 as int, r3 as int);
	printf("add i16 32767 2 = none checked\n".ptr);
	const F5: i16 = 7 + 2;
	let r5: i16 = (7 ^ z) + (2 ^ z);
	printf("add i16 7 2 = %lld %lld\n".ptr, F5 as int, r5 as int);
	printf("add i16 -32768 -32768 = none checked\n".ptr);
	printf("add i16 -32768 -1 = none checked\n".ptr);
	const F8: i16 = 32767 + -1;
	let r8: i16 = (32767 ^ z) + (-1 ^ z);
	printf("add i16 32767 -1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i16 = -7 + 2;
	let r9: i16 = (-7 ^ z) + (2 ^ z);
	printf("add i16 -7 2 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i16 = 7 + -2;
	let r10: i16 = (7 ^ z) + (-2 ^ z);
	printf("add i16 7 -2 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i16 = 32767 - 1;
	let r11: i16 = (32767 ^ z) - (1 ^ z);
	printf("sub i16 32767 1 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i16 = 32767 - 32767;
	let r12: i16 = (32767 ^ z) - (32767 ^ z);
	printf("sub i16 32767 32767 = %lld %lld\n".ptr, F12 as int, r12 as int);
	printf("sub i16 -32768 1 = none checked\n".ptr);
	printf("sub i16 -32768 32767 = none checked\n".ptr);
	const F15: i16 = 32767 - 2;
	let r15: i16 = (32767 ^ z) - (2 ^ z);
	printf("sub i16 32767 2 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: i16 = 7 - 2;
	let r16: i16 = (7 ^ z) - (2 ^ z);
	printf("sub i16 7 2 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: i16 = -32768 - -32768;
	let r17: i16 = (-32768 ^ z) - (-32768 ^ z);
	printf("sub i16 -32768 -32768 = %lld %lld\n".ptr, F17 as int, r17 as int);
	const F18: i16 = -32768 - -1;
	let r18: i16 = (-32768 ^ z) - (-1 ^ z);
	printf("sub i16 -32768 -1 = %lld %lld\n".ptr, F18 as int, r18 as int);
	printf("sub i16 32767 -1 = none checked\n".ptr);
	const F20: i16 = -7 - 2;
	let r20: i16 = (-7 ^ z) - (2 ^ z);
	printf("sub i16 -7 2 = %lld %lld\n".ptr, F20 as int, r20 as int);
	const F21: i16 = 7 - -2;
	let r21: i16 = (7 ^ z) - (-2 ^ z);
	printf("sub i16 7 -2 = %lld %lld\n".ptr, F21 as int, r21 as int);
	const F22: i16 = 32767 * 1;
	let r22: i16 = (32767 ^ z) * (1 ^ z);
	printf("mul i16 32767 1 = %lld %lld\n".ptr, F22 as int, r22 as int);
	printf("mul i16 32767 32767 = none checked\n".ptr);
	const F24: i16 = -32768 * 1;
	let r24: i16 = (-32768 ^ z) * (1 ^ z);
	printf("mul i16 -32768 1 = %lld %lld\n".ptr, F24 as int, r24 as int);
	printf("mul i16 -32768 32767 = none checked\n".ptr);
	printf("mul i16 32767 2 = none checked\n".ptr);
	const F27: i16 = 7 * 2;
	let r27: i16 = (7 ^ z) * (2 ^ z);
	printf("mul i16 7 2 = %lld %lld\n".ptr, F27 as int, r27 as int);
	printf("mul i16 -32768 -32768 = none checked\n".ptr);
	printf("mul i16 -32768 -1 = none checked\n".ptr);
	const F30: i16 = 32767 * -1;
	let r30: i16 = (32767 ^ z) * (-1 ^ z);
	printf("mul i16 32767 -1 = %lld %lld\n".ptr, F30 as int, r30 as int);
	const F31: i16 = -7 * 2;
	let r31: i16 = (-7 ^ z) * (2 ^ z);
	printf("mul i16 -7 2 = %lld %lld\n".ptr, F31 as int, r31 as int);
	const F32: i16 = 7 * -2;
	let r32: i16 = (7 ^ z) * (-2 ^ z);
	printf("mul i16 7 -2 = %lld %lld\n".ptr, F32 as int, r32 as int);
	const F33: i16 = 32767 / 1;
	let r33: i16 = (32767 ^ z) / (1 ^ z);
	printf("div i16 32767 1 = %lld %lld\n".ptr, F33 as int, r33 as int);
	const F34: i16 = 32767 / 32767;
	let r34: i16 = (32767 ^ z) / (32767 ^ z);
	printf("div i16 32767 32767 = %lld %lld\n".ptr, F34 as int, r34 as int);
	const F35: i16 = -32768 / 1;
	let r35: i16 = (-32768 ^ z) / (1 ^ z);
	printf("div i16 -32768 1 = %lld %lld\n".ptr, F35 as int, r35 as int);
	const F36: i16 = -32768 / 32767;
	let r36: i16 = (-32768 ^ z) / (32767 ^ z);
	printf("div i16 -32768 32767 = %lld %lld\n".ptr, F36 as int, r36 as int);
	const F37: i16 = 32767 / 2;
	let r37: i16 = (32767 ^ z) / (2 ^ z);
	printf("div i16 32767 2 = %lld %lld\n".ptr, F37 as int, r37 as int);
	const F38: i16 = 7 / 2;
	let r38: i16 = (7 ^ z) / (2 ^ z);
	printf("div i16 7 2 = %lld %lld\n".ptr, F38 as int, r38 as int);
	const F39: i16 = -32768 / -32768;
	let r39: i16 = (-32768 ^ z) / (-32768 ^ z);
	printf("div i16 -32768 -32768 = %lld %lld\n".ptr, F39 as int, r39 as int);
	let r40: i16 = (-32768 ^ z) / (-1 ^ z);
	printf("div i16 -32768 -1 = none %lld\n".ptr, r40 as int);
	const F41: i16 = 32767 / -1;
	let r41: i16 = (32767 ^ z) / (-1 ^ z);
	printf("div i16 32767 -1 = %lld %lld\n".ptr, F41 as int, r41 as int);
	const F42: i16 = -7 / 2;
	let r42: i16 = (-7 ^ z) / (2 ^ z);
	printf("div i16 -7 2 = %lld %lld\n".ptr, F42 as int, r42 as int);
	const F43: i16 = 7 / -2;
	let r43: i16 = (7 ^ z) / (-2 ^ z);
	printf("div i16 7 -2 = %lld %lld\n".ptr, F43 as int, r43 as int);
	const F44: i16 = 32767 % 1;
	let r44: i16 = (32767 ^ z) % (1 ^ z);
	printf("rem i16 32767 1 = %lld %lld\n".ptr, F44 as int, r44 as int);
	const F45: i16 = 32767 % 32767;
	let r45: i16 = (32767 ^ z) % (32767 ^ z);
	printf("rem i16 32767 32767 = %lld %lld\n".ptr, F45 as int, r45 as int);
	const F46: i16 = -32768 % 1;
	let r46: i16 = (-32768 ^ z) % (1 ^ z);
	printf("rem i16 -32768 1 = %lld %lld\n".ptr, F46 as int, r46 as int);
	const F47: i16 = -32768 % 32767;
	let r47: i16 = (-32768 ^ z) % (32767 ^ z);
	printf("rem i16 -32768 32767 = %lld %lld\n".ptr, F47 as int, r47 as int);
	const F48: i16 = 32767 % 2;
	let r48: i16 = (32767 ^ z) % (2 ^ z);
	printf("rem i16 32767 2 = %lld %lld\n".ptr, F48 as int, r48 as int);
	const F49: i16 = 7 % 2;
	let r49: i16 = (7 ^ z) % (2 ^ z);
	printf("rem i16 7 2 = %lld %lld\n".ptr, F49 as int, r49 as int);
	const F50: i16 = -32768 % -32768;
	let r50: i16 = (-32768 ^ z) % (-32768 ^ z);
	printf("rem i16 -32768 -32768 = %lld %lld\n".ptr, F50 as int, r50 as int);
	let r51: i16 = (-32768 ^ z) % (-1 ^ z);
	printf("rem i16 -32768 -1 = none %lld\n".ptr, r51 as int);
	const F52: i16 = 32767 % -1;
	let r52: i16 = (32767 ^ z) % (-1 ^ z);
	printf("rem i16 32767 -1 = %lld %lld\n".ptr, F52 as int, r52 as int);
	const F53: i16 = -7 % 2;
	let r53: i16 = (-7 ^ z) % (2 ^ z);
	printf("rem i16 -7 2 = %lld %lld\n".ptr, F53 as int, r53 as int);
	const F54: i16 = 7 % -2;
	let r54: i16 = (7 ^ z) % (-2 ^ z);
	printf("rem i16 7 -2 = %lld %lld\n".ptr, F54 as int, r54 as int);
}

fn arith_on_i32(z: i32)
{
	printf("add i32 2147483647 1 = none checked\n".ptr);
	printf("add i32 2147483647 2147483647 = none checked\n".ptr);
	const F2: i32 = -2147483648 + 1;
	let r2: i32 = (-2147483648 ^ z) + (1 ^ z);
	printf("add i32 -2147483648 1 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: i32 = -2147483648 + 2147483647;
	let r3: i32 = (-2147483648 ^ z) + (2147483647 ^ z);
	printf("add i32 -2147483648 2147483647 = %lld %lld\n".ptr, F3 as int, r3 as int);
	printf("add i32 2147483647 2 = none checked\n".ptr);
	const F5: i32 = 7 + 2;
	let r5: i32 = (7 ^ z) + (2 ^ z);
	printf("add i32 7 2 = %lld %lld\n".ptr, F5 as int, r5 as int);
	printf("add i32 -2147483648 -2147483648 = none checked\n".ptr);
	printf("add i32 -2147483648 -1 = none checked\n".ptr);
	const F8: i32 = 2147483647 + -1;
	let r8: i32 = (2147483647 ^ z) + (-1 ^ z);
	printf("add i32 2147483647 -1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i32 = -7 + 2;
	let r9: i32 = (-7 ^ z) + (2 ^ z);
	printf("add i32 -7 2 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i32 = 7 + -2;
	let r10: i32 = (7 ^ z) + (-2 ^ z);
	printf("add i32 7 -2 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i32 = 2147483647 - 1;
	let r11: i32 = (2147483647 ^ z) - (1 ^ z);
	printf("sub i32 2147483647 1 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i32 = 2147483647 - 2147483647;
	let r12: i32 = (2147483647 ^ z) - (2147483647 ^ z);
	printf("sub i32 2147483647 2147483647 = %lld %lld\n".ptr, F12 as int, r12 as int);
	printf("sub i32 -2147483648 1 = none checked\n".ptr);
	printf("sub i32 -2147483648 2147483647 = none checked\n".ptr);
	const F15: i32 = 2147483647 - 2;
	let r15: i32 = (2147483647 ^ z) - (2 ^ z);
	printf("sub i32 2147483647 2 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: i32 = 7 - 2;
	let r16: i32 = (7 ^ z) - (2 ^ z);
	printf("sub i32 7 2 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: i32 = -2147483648 - -2147483648;
	let r17: i32 = (-2147483648 ^ z) - (-2147483648 ^ z);
	printf("sub i32 -2147483648 -2147483648 = %lld %lld\n".ptr, F17 as int, r17 as int);
	const F18: i32 = -2147483648 - -1;
	let r18: i32 = (-2147483648 ^ z) - (-1 ^ z);
	printf("sub i32 -2147483648 -1 = %lld %lld\n".ptr, F18 as int, r18 as int);
	printf("sub i32 2147483647 -1 = none checked\n".ptr);
	const F20: i32 = -7 - 2;
	let r20: i32 = (-7 ^ z) - (2 ^ z);
	printf("sub i32 -7 2 = %lld %lld\n".ptr, F20 as int, r20 as int);
	const F21: i32 = 7 - -2;
	let r21: i32 = (7 ^ z) - (-2 ^ z);
	printf("sub i32 7 -2 = %lld %lld\n".ptr, F21 as int, r21 as int);
	const F22: i32 = 2147483647 * 1;
	let r22: i32 = (2147483647 ^ z) * (1 ^ z);
	printf("mul i32 2147483647 1 = %lld %lld\n".ptr, F22 as int, r22 as int);
	printf("mul i32 2147483647 2147483647 = none checked\n".ptr);
	const F24: i32 = -2147483648 * 1;
	let r24: i32 = (-2147483648 ^ z) * (1 ^ z);
	printf("mul i32 -2147483648 1 = %lld %lld\n".ptr, F24 as int, r24 as int);
	printf("mul i32 -2147483648 2147483647 = none checked\n".ptr);
	printf("mul i32 2147483647 2 = none checked\n".ptr);
	const F27: i32 = 7 * 2;
