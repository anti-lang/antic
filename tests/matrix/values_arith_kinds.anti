	printf("sub_wrap i8 -128 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: i8 = -128 -% 127;
	let r14: i8 = (-128 ^ z) -% (127 ^ z);
	printf("sub_wrap i8 -128 127 = %lld %lld\n".ptr, F14 as int, r14 as int);
