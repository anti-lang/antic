	const F36: uint = 18446744073709551615 % 18446744073709551615;
	let r36: uint = (18446744073709551615 ^ z) % (18446744073709551615 ^ z);
	printf("rem uint 18446744073709551615 18446744073709551615 = %llu %llu\n".ptr, F36 as u64, r36 as u64);
	const F37: uint = 0 % 1;
	let r37: uint = (0 ^ z) % (1 ^ z);
	printf("rem uint 0 1 = %llu %llu\n".ptr, F37 as u64, r37 as u64);
	const F38: uint = 0 % 18446744073709551615;
	let r38: uint = (0 ^ z) % (18446744073709551615 ^ z);
	printf("rem uint 0 18446744073709551615 = %llu %llu\n".ptr, F38 as u64, r38 as u64);
	const F39: uint = 18446744073709551615 % 2;
	let r39: uint = (18446744073709551615 ^ z) % (2 ^ z);
	printf("rem uint 18446744073709551615 2 = %llu %llu\n".ptr, F39 as u64, r39 as u64);
	const F40: uint = 7 % 2;
	let r40: uint = (7 ^ z) % (2 ^ z);
	printf("rem uint 7 2 = %llu %llu\n".ptr, F40 as u64, r40 as u64);
	const F41: uint = 0 % 1;
	let r41: uint = (0 ^ z) % (1 ^ z);
	printf("rem uint 0 1 = %llu %llu\n".ptr, F41 as u64, r41 as u64);
	const F42: uint = 1 % 18446744073709551615;
