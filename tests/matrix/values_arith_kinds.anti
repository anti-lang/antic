	printf("rem uint 1 18446744073709551615 = %llu %llu\n".ptr, F42 as u64, r42 as u64);
}

fn arith_on_byte(z: byte)
{
	let r0: byte = (255 ^ z) + (1 ^ z);
	printf("add byte 255 1 = none %llu\n".ptr, r0 as u64);
	let r1: byte = (255 ^ z) + (255 ^ z);
	printf("add byte 255 255 = none %llu\n".ptr, r1 as u64);
	const F2: byte = 0 + 1;
	let r2: byte = (0 ^ z) + (1 ^ z);
	printf("add byte 0 1 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: byte = 0 + 255;
	let r3: byte = (0 ^ z) + (255 ^ z);
	printf("add byte 0 255 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	let r4: byte = (255 ^ z) + (2 ^ z);
	printf("add byte 255 2 = none %llu\n".ptr, r4 as u64);
	const F5: byte = 7 + 2;
	let r5: byte = (7 ^ z) + (2 ^ z);
	printf("add byte 7 2 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: byte = 0 + 0;
	let r6: byte = (0 ^ z) + (0 ^ z);
	printf("add byte 0 0 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: byte = 0 + 1;
	let r7: byte = (0 ^ z) + (1 ^ z);
	printf("add byte 0 1 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	let r8: byte = (1 ^ z) + (255 ^ z);
	printf("add byte 1 255 = none %llu\n".ptr, r8 as u64);
	const F9: byte = 255 - 1;
	let r9: byte = (255 ^ z) - (1 ^ z);
	printf("sub byte 255 1 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
	const F10: byte = 255 - 255;
	let r10: byte = (255 ^ z) - (255 ^ z);
	printf("sub byte 255 255 = %llu %llu\n".ptr, F10 as u64, r10 as u64);
	let r11: byte = (0 ^ z) - (1 ^ z);
	printf("sub byte 0 1 = none %llu\n".ptr, r11 as u64);
	let r12: byte = (0 ^ z) - (255 ^ z);
	printf("sub byte 0 255 = none %llu\n".ptr, r12 as u64);
	const F13: byte = 255 - 2;
	let r13: byte = (255 ^ z) - (2 ^ z);
	printf("sub byte 255 2 = %llu %llu\n".ptr, F13 as u64, r13 as u64);
	const F14: byte = 7 - 2;
	let r14: byte = (7 ^ z) - (2 ^ z);
	printf("sub byte 7 2 = %llu %llu\n".ptr, F14 as u64, r14 as u64);
	const F15: byte = 0 - 0;
	let r15: byte = (0 ^ z) - (0 ^ z);
	printf("sub byte 0 0 = %llu %llu\n".ptr, F15 as u64, r15 as u64);
	let r16: byte = (0 ^ z) - (1 ^ z);
	printf("sub byte 0 1 = none %llu\n".ptr, r16 as u64);
	let r17: byte = (1 ^ z) - (255 ^ z);
	printf("sub byte 1 255 = none %llu\n".ptr, r17 as u64);
	const F18: byte = 255 * 1;
	let r18: byte = (255 ^ z) * (1 ^ z);
	printf("mul byte 255 1 = %llu %llu\n".ptr, F18 as u64, r18 as u64);
	let r19: byte = (255 ^ z) * (255 ^ z);
	printf("mul byte 255 255 = none %llu\n".ptr, r19 as u64);
	const F20: byte = 0 * 1;
	let r20: byte = (0 ^ z) * (1 ^ z);
	printf("mul byte 0 1 = %llu %llu\n".ptr, F20 as u64, r20 as u64);
	const F21: byte = 0 * 255;
	let r21: byte = (0 ^ z) * (255 ^ z);
	printf("mul byte 0 255 = %llu %llu\n".ptr, F21 as u64, r21 as u64);
	let r22: byte = (255 ^ z) * (2 ^ z);
	printf("mul byte 255 2 = none %llu\n".ptr, r22 as u64);
	const F23: byte = 7 * 2;
	let r23: byte = (7 ^ z) * (2 ^ z);
	printf("mul byte 7 2 = %llu %llu\n".ptr, F23 as u64, r23 as u64);
	const F24: byte = 0 * 0;
	let r24: byte = (0 ^ z) * (0 ^ z);
	printf("mul byte 0 0 = %llu %llu\n".ptr, F24 as u64, r24 as u64);
	const F25: byte = 0 * 1;
	let r25: byte = (0 ^ z) * (1 ^ z);
	printf("mul byte 0 1 = %llu %llu\n".ptr, F25 as u64, r25 as u64);
	const F26: byte = 1 * 255;
	let r26: byte = (1 ^ z) * (255 ^ z);
	printf("mul byte 1 255 = %llu %llu\n".ptr, F26 as u64, r26 as u64);
	const F27: byte = 255 / 1;
	let r27: byte = (255 ^ z) / (1 ^ z);
	printf("div byte 255 1 = %llu %llu\n".ptr, F27 as u64, r27 as u64);
	const F28: byte = 255 / 255;
	let r28: byte = (255 ^ z) / (255 ^ z);
	printf("div byte 255 255 = %llu %llu\n".ptr, F28 as u64, r28 as u64);
	const F29: byte = 0 / 1;
	let r29: byte = (0 ^ z) / (1 ^ z);
	printf("div byte 0 1 = %llu %llu\n".ptr, F29 as u64, r29 as u64);
	const F30: byte = 0 / 255;
	let r30: byte = (0 ^ z) / (255 ^ z);
	printf("div byte 0 255 = %llu %llu\n".ptr, F30 as u64, r30 as u64);
	const F31: byte = 255 / 2;
	let r31: byte = (255 ^ z) / (2 ^ z);
	printf("div byte 255 2 = %llu %llu\n".ptr, F31 as u64, r31 as u64);
	const F32: byte = 7 / 2;
	let r32: byte = (7 ^ z) / (2 ^ z);
	printf("div byte 7 2 = %llu %llu\n".ptr, F32 as u64, r32 as u64);
	const F33: byte = 0 / 1;
	let r33: byte = (0 ^ z) / (1 ^ z);
	printf("div byte 0 1 = %llu %llu\n".ptr, F33 as u64, r33 as u64);
	const F34: byte = 1 / 255;
	let r34: byte = (1 ^ z) / (255 ^ z);
	printf("div byte 1 255 = %llu %llu\n".ptr, F34 as u64, r34 as u64);
	const F35: byte = 255 % 1;
	let r35: byte = (255 ^ z) % (1 ^ z);
	printf("rem byte 255 1 = %llu %llu\n".ptr, F35 as u64, r35 as u64);
	const F36: byte = 255 % 255;
	let r36: byte = (255 ^ z) % (255 ^ z);
	printf("rem byte 255 255 = %llu %llu\n".ptr, F36 as u64, r36 as u64);
	const F37: byte = 0 % 1;
	let r37: byte = (0 ^ z) % (1 ^ z);
	printf("rem byte 0 1 = %llu %llu\n".ptr, F37 as u64, r37 as u64);
	const F38: byte = 0 % 255;
	let r38: byte = (0 ^ z) % (255 ^ z);
	printf("rem byte 0 255 = %llu %llu\n".ptr, F38 as u64, r38 as u64);
	const F39: byte = 255 % 2;
	let r39: byte = (255 ^ z) % (2 ^ z);
	printf("rem byte 255 2 = %llu %llu\n".ptr, F39 as u64, r39 as u64);
