	printf("sub_wrap byte 7 2 = %llu %llu\n".ptr, F14 as u64, r14 as u64);
	const F15: byte = 0 -% 0;
	let r15: byte = (0 ^ z) -% (0 ^ z);
	printf("sub_wrap byte 0 0 = %llu %llu\n".ptr, F15 as u64, r15 as u64);
	const F16: byte = 0 -% 1;
