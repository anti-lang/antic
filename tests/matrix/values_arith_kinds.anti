	let r8: i16 = (32767 ^ z) + (-1 ^ z);
	printf("add i16 32767 -1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i16 = -7 + 2;
	let r9: i16 = (-7 ^ z) + (2 ^ z);
	printf("add i16 -7 2 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i16 = 7 + -2;
	let r10: i16 = (7 ^ z) + (-2 ^ z);
	printf("add i16 7 -2 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i16 = -1 + -1;
	let r11: i16 = (-1 ^ z) + (-1 ^ z);
	printf("add i16 -1 -1 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i16 = -32767 + -1;
	let r12: i16 = (-32767 ^ z) + (-1 ^ z);
	printf("add i16 -32767 -1 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: i16 = 32767 - 1;
	let r13: i16 = (32767 ^ z) - (1 ^ z);
	printf("sub i16 32767 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: i16 = 32767 - 32767;
	let r14: i16 = (32767 ^ z) - (32767 ^ z);
	printf("sub i16 32767 32767 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: i16 = -32768 - 1;
	printf("sub i16 -32768 1 = %lld checked\n".ptr, F15 as int);
	const F16: i16 = -32768 - 32767;
	printf("sub i16 -32768 32767 = %lld checked\n".ptr, F16 as int);
	const F17: i16 = 32767 - 2;
	let r17: i16 = (32767 ^ z) - (2 ^ z);
	printf("sub i16 32767 2 = %lld %lld\n".ptr, F17 as int, r17 as int);
	const F18: i16 = 7 - 2;
	let r18: i16 = (7 ^ z) - (2 ^ z);
	printf("sub i16 7 2 = %lld %lld\n".ptr, F18 as int, r18 as int);
	const F19: i16 = -32768 - -32768;
	let r19: i16 = (-32768 ^ z) - (-32768 ^ z);
	printf("sub i16 -32768 -32768 = %lld %lld\n".ptr, F19 as int, r19 as int);
	const F20: i16 = -32768 - -1;
	let r20: i16 = (-32768 ^ z) - (-1 ^ z);
	printf("sub i16 -32768 -1 = %lld %lld\n".ptr, F20 as int, r20 as int);
	const F21: i16 = 32767 - -1;
	printf("sub i16 32767 -1 = %lld checked\n".ptr, F21 as int);
	const F22: i16 = -7 - 2;
	let r22: i16 = (-7 ^ z) - (2 ^ z);
	printf("sub i16 -7 2 = %lld %lld\n".ptr, F22 as int, r22 as int);
	const F23: i16 = 7 - -2;
	let r23: i16 = (7 ^ z) - (-2 ^ z);
	printf("sub i16 7 -2 = %lld %lld\n".ptr, F23 as int, r23 as int);
	const F24: i16 = -1 - -1;
	let r24: i16 = (-1 ^ z) - (-1 ^ z);
	printf("sub i16 -1 -1 = %lld %lld\n".ptr, F24 as int, r24 as int);
	const F25: i16 = -32767 - -1;
	let r25: i16 = (-32767 ^ z) - (-1 ^ z);
	printf("sub i16 -32767 -1 = %lld %lld\n".ptr, F25 as int, r25 as int);
	const F26: i16 = 32767 * 1;
	let r26: i16 = (32767 ^ z) * (1 ^ z);
	printf("mul i16 32767 1 = %lld %lld\n".ptr, F26 as int, r26 as int);
	const F27: i16 = 32767 * 32767;
	printf("mul i16 32767 32767 = %lld checked\n".ptr, F27 as int);
	const F28: i16 = -32768 * 1;
	let r28: i16 = (-32768 ^ z) * (1 ^ z);
	printf("mul i16 -32768 1 = %lld %lld\n".ptr, F28 as int, r28 as int);
	const F29: i16 = -32768 * 32767;
	printf("mul i16 -32768 32767 = %lld checked\n".ptr, F29 as int);
	const F30: i16 = 32767 * 2;
	printf("mul i16 32767 2 = %lld checked\n".ptr, F30 as int);
	const F31: i16 = 7 * 2;
	let r31: i16 = (7 ^ z) * (2 ^ z);
	printf("mul i16 7 2 = %lld %lld\n".ptr, F31 as int, r31 as int);
	const F32: i16 = -32768 * -32768;
	printf("mul i16 -32768 -32768 = %lld checked\n".ptr, F32 as int);
	const F33: i16 = -32768 * -1;
	printf("mul i16 -32768 -1 = %lld checked\n".ptr, F33 as int);
	const F34: i16 = 32767 * -1;
	let r34: i16 = (32767 ^ z) * (-1 ^ z);
	printf("mul i16 32767 -1 = %lld %lld\n".ptr, F34 as int, r34 as int);
	const F35: i16 = -7 * 2;
	let r35: i16 = (-7 ^ z) * (2 ^ z);
	printf("mul i16 -7 2 = %lld %lld\n".ptr, F35 as int, r35 as int);
	const F36: i16 = 7 * -2;
	let r36: i16 = (7 ^ z) * (-2 ^ z);
	printf("mul i16 7 -2 = %lld %lld\n".ptr, F36 as int, r36 as int);
	const F37: i16 = -1 * -1;
	let r37: i16 = (-1 ^ z) * (-1 ^ z);
	printf("mul i16 -1 -1 = %lld %lld\n".ptr, F37 as int, r37 as int);
	const F38: i16 = -32767 * -1;
	let r38: i16 = (-32767 ^ z) * (-1 ^ z);
	printf("mul i16 -32767 -1 = %lld %lld\n".ptr, F38 as int, r38 as int);
	const F39: i16 = 32767 / 1;
	let r39: i16 = (32767 ^ z) / (1 ^ z);
	printf("div i16 32767 1 = %lld %lld\n".ptr, F39 as int, r39 as int);
	const F40: i16 = 32767 / 32767;
	let r40: i16 = (32767 ^ z) / (32767 ^ z);
	printf("div i16 32767 32767 = %lld %lld\n".ptr, F40 as int, r40 as int);
	const F41: i16 = -32768 / 1;
	let r41: i16 = (-32768 ^ z) / (1 ^ z);
	printf("div i16 -32768 1 = %lld %lld\n".ptr, F41 as int, r41 as int);
	const F42: i16 = -32768 / 32767;
	let r42: i16 = (-32768 ^ z) / (32767 ^ z);
	printf("div i16 -32768 32767 = %lld %lld\n".ptr, F42 as int, r42 as int);
	const F43: i16 = 32767 / 2;
	let r43: i16 = (32767 ^ z) / (2 ^ z);
	printf("div i16 32767 2 = %lld %lld\n".ptr, F43 as int, r43 as int);
	const F44: i16 = 7 / 2;
	let r44: i16 = (7 ^ z) / (2 ^ z);
	printf("div i16 7 2 = %lld %lld\n".ptr, F44 as int, r44 as int);
	const F45: i16 = -32768 / -32768;
	let r45: i16 = (-32768 ^ z) / (-32768 ^ z);
	printf("div i16 -32768 -32768 = %lld %lld\n".ptr, F45 as int, r45 as int);
	let r46: i16 = (-32768 ^ z) / (-1 ^ z);
	printf("div i16 -32768 -1 = none %lld\n".ptr, r46 as int);
	const F47: i16 = 32767 / -1;
	let r47: i16 = (32767 ^ z) / (-1 ^ z);
	printf("div i16 32767 -1 = %lld %lld\n".ptr, F47 as int, r47 as int);
	const F48: i16 = -7 / 2;
	let r48: i16 = (-7 ^ z) / (2 ^ z);
	printf("div i16 -7 2 = %lld %lld\n".ptr, F48 as int, r48 as int);
	const F49: i16 = 7 / -2;
	let r49: i16 = (7 ^ z) / (-2 ^ z);
	printf("div i16 7 -2 = %lld %lld\n".ptr, F49 as int, r49 as int);
	const F50: i16 = -1 / -1;
	let r50: i16 = (-1 ^ z) / (-1 ^ z);
	printf("div i16 -1 -1 = %lld %lld\n".ptr, F50 as int, r50 as int);
	const F51: i16 = -32767 / -1;
	let r51: i16 = (-32767 ^ z) / (-1 ^ z);
	printf("div i16 -32767 -1 = %lld %lld\n".ptr, F51 as int, r51 as int);
	const F52: i16 = 32767 % 1;
	let r52: i16 = (32767 ^ z) % (1 ^ z);
	printf("rem i16 32767 1 = %lld %lld\n".ptr, F52 as int, r52 as int);
	const F53: i16 = 32767 % 32767;
	let r53: i16 = (32767 ^ z) % (32767 ^ z);
	printf("rem i16 32767 32767 = %lld %lld\n".ptr, F53 as int, r53 as int);
	const F54: i16 = -32768 % 1;
	let r54: i16 = (-32768 ^ z) % (1 ^ z);
	printf("rem i16 -32768 1 = %lld %lld\n".ptr, F54 as int, r54 as int);
	const F55: i16 = -32768 % 32767;
	let r55: i16 = (-32768 ^ z) % (32767 ^ z);
	printf("rem i16 -32768 32767 = %lld %lld\n".ptr, F55 as int, r55 as int);
	const F56: i16 = 32767 % 2;
	let r56: i16 = (32767 ^ z) % (2 ^ z);
	printf("rem i16 32767 2 = %lld %lld\n".ptr, F56 as int, r56 as int);
	const F57: i16 = 7 % 2;
	let r57: i16 = (7 ^ z) % (2 ^ z);
	printf("rem i16 7 2 = %lld %lld\n".ptr, F57 as int, r57 as int);
	const F58: i16 = -32768 % -32768;
	let r58: i16 = (-32768 ^ z) % (-32768 ^ z);
	printf("rem i16 -32768 -32768 = %lld %lld\n".ptr, F58 as int, r58 as int);
	let r59: i16 = (-32768 ^ z) % (-1 ^ z);
	printf("rem i16 -32768 -1 = none %lld\n".ptr, r59 as int);
