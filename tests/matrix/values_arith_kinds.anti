	let r0: uint = mul_high((18446744073709551615 ^ z), (1 ^ z));
	printf("mul_high uint 18446744073709551615 1 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: uint = mul_high(18446744073709551615, 18446744073709551615);
	let r1: uint = mul_high((18446744073709551615 ^ z), (18446744073709551615 ^ z));
	printf("mul_high uint 18446744073709551615 18446744073709551615 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: uint = mul_high(0, 1);
	let r2: uint = mul_high((0 ^ z), (1 ^ z));
	printf("mul_high uint 0 1 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: uint = mul_high(0, 18446744073709551615);
	let r3: uint = mul_high((0 ^ z), (18446744073709551615 ^ z));
	printf("mul_high uint 0 18446744073709551615 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: uint = mul_high(18446744073709551615, 2);
	let r4: uint = mul_high((18446744073709551615 ^ z), (2 ^ z));
	printf("mul_high uint 18446744073709551615 2 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: uint = mul_high(7, 2);
	let r5: uint = mul_high((7 ^ z), (2 ^ z));
	printf("mul_high uint 7 2 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: uint = mul_high(0, 0);
	let r6: uint = mul_high((0 ^ z), (0 ^ z));
	printf("mul_high uint 0 0 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: uint = mul_high(0, 1);
	let r7: uint = mul_high((0 ^ z), (1 ^ z));
	printf("mul_high uint 0 1 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	const F8: uint = mul_high(1, 18446744073709551615);
	let r8: uint = mul_high((1 ^ z), (18446744073709551615 ^ z));
	printf("mul_high uint 1 18446744073709551615 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
}

fn mul_high_on_byte(z: byte)
{
	const F0: byte = mul_high(255, 1);
	let r0: byte = mul_high((255 ^ z), (1 ^ z));
	printf("mul_high byte 255 1 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: byte = mul_high(255, 255);
	let r1: byte = mul_high((255 ^ z), (255 ^ z));
	printf("mul_high byte 255 255 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: byte = mul_high(0, 1);
	let r2: byte = mul_high((0 ^ z), (1 ^ z));
	printf("mul_high byte 0 1 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: byte = mul_high(0, 255);
	let r3: byte = mul_high((0 ^ z), (255 ^ z));
	printf("mul_high byte 0 255 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: byte = mul_high(255, 2);
	let r4: byte = mul_high((255 ^ z), (2 ^ z));
	printf("mul_high byte 255 2 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: byte = mul_high(7, 2);
	let r5: byte = mul_high((7 ^ z), (2 ^ z));
	printf("mul_high byte 7 2 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: byte = mul_high(0, 0);
	let r6: byte = mul_high((0 ^ z), (0 ^ z));
	printf("mul_high byte 0 0 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: byte = mul_high(0, 1);
	let r7: byte = mul_high((0 ^ z), (1 ^ z));
	printf("mul_high byte 0 1 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	const F8: byte = mul_high(1, 255);
	let r8: byte = mul_high((1 ^ z), (255 ^ z));
	printf("mul_high byte 1 255 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	arith_on_i8(zero as i8);
	arith_on_i16(zero as i16);
	arith_on_i32(zero as i32);
	arith_on_i64(zero as i64);
	arith_on_int(zero as int);
	arith_on_u8(zero as u8);
	arith_on_u16(zero as u16);
	arith_on_u32(zero as u32);
	arith_on_u64(zero as u64);
	arith_on_uint(zero as uint);
	arith_on_byte(zero as byte);
	wrapping_on_i8(zero as i8);
	wrapping_on_i16(zero as i16);
	wrapping_on_i32(zero as i32);
	wrapping_on_i64(zero as i64);
	wrapping_on_int(zero as int);
	wrapping_on_u8(zero as u8);
	wrapping_on_u16(zero as u16);
	wrapping_on_u32(zero as u32);
	wrapping_on_u64(zero as u64);
	wrapping_on_uint(zero as uint);
	wrapping_on_byte(zero as byte);
	saturating_on_i8(zero as i8);
	saturating_on_i16(zero as i16);
	saturating_on_i32(zero as i32);
	saturating_on_i64(zero as i64);
	saturating_on_int(zero as int);
	saturating_on_u8(zero as u8);
	saturating_on_u16(zero as u16);
	saturating_on_u32(zero as u32);
	saturating_on_u64(zero as u64);
	saturating_on_uint(zero as uint);
	saturating_on_byte(zero as byte);
	mul_high_on_i8(zero as i8);
	mul_high_on_i16(zero as i16);
	mul_high_on_i32(zero as i32);
	mul_high_on_i64(zero as i64);
	mul_high_on_int(zero as int);
	mul_high_on_u8(zero as u8);
	mul_high_on_u16(zero as u16);
	mul_high_on_u32(zero as u32);
	mul_high_on_u64(zero as u64);
	mul_high_on_uint(zero as uint);
	mul_high_on_byte(zero as byte);
	return 0;
}
