fn saturating_on_i8(z: i8)
{
	const F0: i8 = 127 +| 1;
	let r0: i8 = (127 ^ z) +| (1 ^ z);
	printf("add_sat i8 127 1 = %lld %lld\n".ptr, F0 as int, r0 as int);
	const F1: i8 = 127 +| 127;
	let r1: i8 = (127 ^ z) +| (127 ^ z);
	printf("add_sat i8 127 127 = %lld %lld\n".ptr, F1 as int, r1 as int);
	const F2: i8 = -128 +| 1;
	let r2: i8 = (-128 ^ z) +| (1 ^ z);
	printf("add_sat i8 -128 1 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: i8 = -128 +| 127;
	let r3: i8 = (-128 ^ z) +| (127 ^ z);
	printf("add_sat i8 -128 127 = %lld %lld\n".ptr, F3 as int, r3 as int);
	const F4: i8 = 127 +| 2;
	let r4: i8 = (127 ^ z) +| (2 ^ z);
	printf("add_sat i8 127 2 = %lld %lld\n".ptr, F4 as int, r4 as int);
	const F5: i8 = 7 +| 2;
	let r5: i8 = (7 ^ z) +| (2 ^ z);
	printf("add_sat i8 7 2 = %lld %lld\n".ptr, F5 as int, r5 as int);
	const F6: i8 = -128 +| -128;
	let r6: i8 = (-128 ^ z) +| (-128 ^ z);
	printf("add_sat i8 -128 -128 = %lld %lld\n".ptr, F6 as int, r6 as int);
	const F7: i8 = -128 +| -1;
	let r7: i8 = (-128 ^ z) +| (-1 ^ z);
	printf("add_sat i8 -128 -1 = %lld %lld\n".ptr, F7 as int, r7 as int);
	const F8: i8 = 127 +| -1;
	let r8: i8 = (127 ^ z) +| (-1 ^ z);
	printf("add_sat i8 127 -1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i8 = -7 +| 2;
	let r9: i8 = (-7 ^ z) +| (2 ^ z);
	printf("add_sat i8 -7 2 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i8 = 7 +| -2;
	let r10: i8 = (7 ^ z) +| (-2 ^ z);
	printf("add_sat i8 7 -2 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i8 = 127 -| 1;
	let r11: i8 = (127 ^ z) -| (1 ^ z);
	printf("sub_sat i8 127 1 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i8 = 127 -| 127;
	let r12: i8 = (127 ^ z) -| (127 ^ z);
	printf("sub_sat i8 127 127 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: i8 = -128 -| 1;
	let r13: i8 = (-128 ^ z) -| (1 ^ z);
	printf("sub_sat i8 -128 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: i8 = -128 -| 127;
	let r14: i8 = (-128 ^ z) -| (127 ^ z);
	printf("sub_sat i8 -128 127 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: i8 = 127 -| 2;
	let r15: i8 = (127 ^ z) -| (2 ^ z);
	printf("sub_sat i8 127 2 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: i8 = 7 -| 2;
	let r16: i8 = (7 ^ z) -| (2 ^ z);
	printf("sub_sat i8 7 2 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: i8 = -128 -| -128;
	let r17: i8 = (-128 ^ z) -| (-128 ^ z);
	printf("sub_sat i8 -128 -128 = %lld %lld\n".ptr, F17 as int, r17 as int);
	const F18: i8 = -128 -| -1;
	let r18: i8 = (-128 ^ z) -| (-1 ^ z);
	printf("sub_sat i8 -128 -1 = %lld %lld\n".ptr, F18 as int, r18 as int);
	const F19: i8 = 127 -| -1;
	let r19: i8 = (127 ^ z) -| (-1 ^ z);
	printf("sub_sat i8 127 -1 = %lld %lld\n".ptr, F19 as int, r19 as int);
	const F20: i8 = -7 -| 2;
	let r20: i8 = (-7 ^ z) -| (2 ^ z);
	printf("sub_sat i8 -7 2 = %lld %lld\n".ptr, F20 as int, r20 as int);
	const F21: i8 = 7 -| -2;
	let r21: i8 = (7 ^ z) -| (-2 ^ z);
	printf("sub_sat i8 7 -2 = %lld %lld\n".ptr, F21 as int, r21 as int);
	const F22: i8 = 127 *| 1;
	let r22: i8 = (127 ^ z) *| (1 ^ z);
	printf("mul_sat i8 127 1 = %lld %lld\n".ptr, F22 as int, r22 as int);
	const F23: i8 = 127 *| 127;
	let r23: i8 = (127 ^ z) *| (127 ^ z);
	printf("mul_sat i8 127 127 = %lld %lld\n".ptr, F23 as int, r23 as int);
	const F24: i8 = -128 *| 1;
	let r24: i8 = (-128 ^ z) *| (1 ^ z);
	printf("mul_sat i8 -128 1 = %lld %lld\n".ptr, F24 as int, r24 as int);
	const F25: i8 = -128 *| 127;
	let r25: i8 = (-128 ^ z) *| (127 ^ z);
	printf("mul_sat i8 -128 127 = %lld %lld\n".ptr, F25 as int, r25 as int);
	const F26: i8 = 127 *| 2;
	let r26: i8 = (127 ^ z) *| (2 ^ z);
	printf("mul_sat i8 127 2 = %lld %lld\n".ptr, F26 as int, r26 as int);
	const F27: i8 = 7 *| 2;
	let r27: i8 = (7 ^ z) *| (2 ^ z);
	printf("mul_sat i8 7 2 = %lld %lld\n".ptr, F27 as int, r27 as int);
	const F28: i8 = -128 *| -128;
	let r28: i8 = (-128 ^ z) *| (-128 ^ z);
	printf("mul_sat i8 -128 -128 = %lld %lld\n".ptr, F28 as int, r28 as int);
	const F29: i8 = -128 *| -1;
	let r29: i8 = (-128 ^ z) *| (-1 ^ z);
	printf("mul_sat i8 -128 -1 = %lld %lld\n".ptr, F29 as int, r29 as int);
	const F30: i8 = 127 *| -1;
	let r30: i8 = (127 ^ z) *| (-1 ^ z);
	printf("mul_sat i8 127 -1 = %lld %lld\n".ptr, F30 as int, r30 as int);
