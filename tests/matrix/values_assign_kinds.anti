//! An assignment `=`, to a local and through a pointer, for each of these kinds
//! of value: i8, i16, i32, i64, int, u8, u16, u32, u64, uint, byte, f32, f64,
//! bool, char, str, slice, fixed array, pointer, nullable pointer, optional,
//! may fail fn, fn, tuple, channel, struct, packed struct, simd struct, union,
//! enum, variant, class, concurrent class, interface. Each kind is a function
//! of its own, which prints the two values it holds.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

fn risky_up(n: int) -> int may fail
{
	if n < 0 {
		fail "negative";
	}
	return n + 1;
}

fn risky_down(n: int) -> int may fail
{
	if n > 0 {
		fail "positive";
	}
	return n - 1;
}

fn settle(f: fn(int) -> int may fail) -> int
{
	let got = f(10) catch {
		yield -1;
	};
	return got;
}

fn up(n: int) -> int
{
	return n + 1;
}

fn down(n: int) -> int
{
	return n - 1;
}

struct Pt
{
	x: int,
	y: int,
}

packed struct Pk
{
	a: u8,
	b: i32,
}

simd struct I32x4
{
	a: i32,
	b: i32,
	c: i32,
	d: i32,
}

union Bits
{
	i: i32,
	f: f32,
}

enum Color
{
	Red,
	Green,
	Blue,
}

variant Shape
{
	Circle { r: int },
	Empty,
}

class Counter
{
	pub n: int = 0,
}

concurrent class Hits
{
	pub atomic n: int = 0,
}

abstract class Named
{
	abstract fn id(self) -> int;
}

class One inherits Named
{
	concrete fn id(self) -> int
	{
		return 1;
	}
}

class Two inherits Named
{
	concrete fn id(self) -> int
	{
		return 2;
	}
}

fn on_i8()
{
	let first: i8 = 127;
	let second: i8 = -128;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("i8 %lld %lld\n".ptr, second as int, first as int);
}

fn on_i16()
{
	let first: i16 = 32767;
	let second: i16 = -32768;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("i16 %lld %lld\n".ptr, second as int, first as int);
}

fn on_i32()
{
	let first: i32 = 2147483647;
	let second: i32 = -2147483648;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("i32 %lld %lld\n".ptr, second as int, first as int);
}

fn on_i64()
{
	let first: i64 = 9223372036854775807;
	let second: i64 = -9223372036854775808;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("i64 %lld %lld\n".ptr, second as int, first as int);
}

fn on_int()
{
	let first: int = 9223372036854775807;
	let second: int = -9223372036854775808;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("int %lld %lld\n".ptr, second as int, first as int);
}

fn on_u8()
{
	let first: u8 = 255;
	let second: u8 = 1;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("u8 %llu %llu\n".ptr, second as u64, first as u64);
}

fn on_u16()
{
	let first: u16 = 65535;
	let second: u16 = 1;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("u16 %llu %llu\n".ptr, second as u64, first as u64);
}

fn on_u32()
{
	let first: u32 = 4294967295;
	let second: u32 = 1;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("u32 %llu %llu\n".ptr, second as u64, first as u64);
}

fn on_u64()
{
	let first: u64 = 18446744073709551615;
	let second: u64 = 1;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("u64 %llu %llu\n".ptr, second as u64, first as u64);
}

fn on_uint()
{
	let first: uint = 18446744073709551615;
	let second: uint = 1;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("uint %llu %llu\n".ptr, second as u64, first as u64);
}

fn on_byte()
{
	let first: byte = 255;
	let second: byte = 1;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("byte %llu %llu\n".ptr, second as u64, first as u64);
}

fn on_f32()
{
	let first: f32 = 1.5;
	let second: f32 = -0.25;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("f32 %g %g\n".ptr, second as f64, first as f64);
}

fn on_f64()
{
	let first: f64 = 1.5;
	let second: f64 = -0.25;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("f64 %g %g\n".ptr, second, first);
}

fn on_bool()
{
	let first: bool = true;
	let second: bool = false;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("bool %d %d\n".ptr, second as c_int, first as c_int);
}

fn on_char()
{
	let first: char = 'a';
	let second: char = '\u{10FFFF}';
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("char %u %u\n".ptr, second as u32, first as u32);
}

fn on_str()
{
	let first: str = "one";
	let second: str = "three";
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("str %lld %lld\n".ptr, second.len, first.len);
}

fn on_slice()
{
	let base = [1, 2, 3];
	let first: []int = base[0..1];
	let second: []int = base[0..3];
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("slice %lld %lld\n".ptr, second.len, first.len);
}

fn on_fixed_array()
{
	let first: [2]int = [1, 2];
	let second: [2]int = [3, 4];
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("fixed_array %lld %lld\n".ptr, second[1], first[1]);
}

fn on_pointer()
{
	let a = 11;
	let b = 22;
	let first: *int = &a;
	let second: *int = &b;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("pointer %lld %lld\n".ptr, *second, *first);
}

fn on_nullable_pointer()
{
	let a = 11;
	let b = 22;
	let first: ?*int = &a;
	let second: ?*int = none;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("nullable_pointer %lld %lld\n".ptr, *(second ?? &b), *(first ?? &b));
}

fn on_optional()
{
	let first: ?int = 5;
	let second: ?int = none;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("optional %lld %lld\n".ptr, (second ?? -1), (first ?? -1));
}

fn on_may_fail_fn()
{
	let first: fn(int) -> int may fail = risky_up;
	let second: fn(int) -> int may fail = risky_down;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("may_fail_fn %lld %lld\n".ptr, settle(second), settle(first));
}

fn on_fn()
{
	let first: fn(int) -> int = up;
	let second: fn(int) -> int = down;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("fn %lld %lld\n".ptr, second(10), first(10));
}

fn on_tuple()
{
	let first: (int, bool) = (1, true);
	let second: (int, bool) = (2, false);
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("tuple %lld %lld\n".ptr, second.0, first.0);
}

fn on_channel()
{
	let c1 = chan int(1);
	let c2 = chan int(1);
	let first: chan int = c1;
	let second: chan int = c2;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("channel %d %d\n".ptr, (second == c1) as c_int, (first == c1) as c_int);
	delete(c1);
	delete(c2);
}

fn on_struct()
{
	let first: Pt = Pt { x: 1, y: 2 };
	let second: Pt = Pt { x: 3, y: 4 };
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("struct %lld %lld\n".ptr, second.y, first.y);
}

fn on_packed_struct()
{
	let first: Pk = Pk { a: 1, b: 2 };
	let second: Pk = Pk { a: 3, b: 4 };
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("packed_struct %lld %lld\n".ptr, second.b as int, first.b as int);
}

fn on_simd_struct()
{
	let first: I32x4 = I32x4 { a: 1, b: 2, c: 3, d: 4 };
	let second: I32x4 = I32x4 { a: 5, b: 6, c: 7, d: 8 };
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("simd_struct %lld %lld\n".ptr, second.c as int, first.c as int);
}

fn on_union()
{
	let first: Bits = Bits { i: 7 };
	let second: Bits = Bits { i: 9 };
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("union %lld %lld\n".ptr, second.i as int, first.i as int);
}

fn on_enum()
{
	let first: Color = Color.Green;
	let second: Color = Color.Blue;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("enum %lld %lld\n".ptr, second as int, first as int);
}

fn on_variant()
{
	let first: Shape = Shape.Circle { r: 2 };
	let second: Shape = Shape.Empty;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("variant %d %d\n".ptr, (second is Shape.Circle) as c_int, (first is Shape.Circle) as c_int);
}

fn on_class()
{
	let first: Counter = Counter { n: 5 };
	let second: Counter = Counter { n: 6 };
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("class %lld %lld\n".ptr, second.n, first.n);
}

fn on_concurrent_class()
{
	let first: Hits = Hits { n: 5 };
	let second: Hits = Hits { n: 6 };
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("concurrent_class %lld %lld\n".ptr, second.n.load(), first.n.load());
}

fn on_interface()
{
	let one = One { };
	let two = Two { };
	let first: *Named = &one;
	let second: *Named = &two;
	let kept = first;
	first = second;
	let p = &second;
	*p = kept;
	printf("interface %lld %lld\n".ptr, second.id(), first.id());
}

fn main() -> int
{
	on_i8();
	on_i16();
	on_i32();
	on_i64();
	on_int();
	on_u8();
	on_u16();
	on_u32();
	on_u64();
	on_uint();
	on_byte();
	on_f32();
	on_f64();
	on_bool();
	on_char();
	on_str();
	on_slice();
	on_fixed_array();
	on_pointer();
	on_nullable_pointer();
	on_optional();
	on_may_fail_fn();
	on_fn();
	on_tuple();
	on_channel();
	on_struct();
	on_packed_struct();
	on_simd_struct();
	on_union();
	on_enum();
	on_variant();
	on_class();
	on_concurrent_class();
	on_interface();
	return 0;
}
