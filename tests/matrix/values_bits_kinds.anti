	const F12: i8 = 127 | 127;
	let r12: i8 = (127 ^ z) | (127 ^ z);
	printf("or i8 127 127 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: i8 = -128 | 1;
	let r13: i8 = (-128 ^ z) | (1 ^ z);
	printf("or i8 -128 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: i8 = -128 | 127;
	let r14: i8 = (-128 ^ z) | (127 ^ z);
	printf("or i8 -128 127 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: i8 = 127 | 2;
	let r15: i8 = (127 ^ z) | (2 ^ z);
	printf("or i8 127 2 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: i8 = 7 | 2;
	let r16: i8 = (7 ^ z) | (2 ^ z);
	printf("or i8 7 2 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: i8 = -128 | -128;
	let r17: i8 = (-128 ^ z) | (-128 ^ z);
	printf("or i8 -128 -128 = %lld %lld\n".ptr, F17 as int, r17 as int);
	const F18: i8 = -128 | -1;
	let r18: i8 = (-128 ^ z) | (-1 ^ z);
	printf("or i8 -128 -1 = %lld %lld\n".ptr, F18 as int, r18 as int);
	const F19: i8 = 127 | -1;
	let r19: i8 = (127 ^ z) | (-1 ^ z);
	printf("or i8 127 -1 = %lld %lld\n".ptr, F19 as int, r19 as int);
