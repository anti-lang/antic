	let r4: i32 = (1 ^ z) << (1 ^ z);
	printf("shl i32 1 1 = %lld %lld\n".ptr, F4 as int, r4 as int);
	const F5: i32 = -2147483648 << 31;
	let r5: i32 = (-2147483648 ^ z) << (31 ^ z);
	printf("shl i32 -2147483648 31 = %lld %lld\n".ptr, F5 as int, r5 as int);
	const F6: i32 = -8 << 1;
	let r6: i32 = (-8 ^ z) << (1 ^ z);
	printf("shl i32 -8 1 = %lld %lld\n".ptr, F6 as int, r6 as int);
	const F7: i32 = -1 << 31;
	let r7: i32 = (-1 ^ z) << (31 ^ z);
	printf("shl i32 -1 31 = %lld %lld\n".ptr, F7 as int, r7 as int);
	const F8: i32 = -2147483648 << 1;
	let r8: i32 = (-2147483648 ^ z) << (1 ^ z);
	printf("shl i32 -2147483648 1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i32 = 1 >> 31;
	let r9: i32 = (1 ^ z) >> (31 ^ z);
	printf("shr i32 1 31 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i32 = 2147483647 >> 1;
	let r10: i32 = (2147483647 ^ z) >> (1 ^ z);
	printf("shr i32 2147483647 1 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i32 = 2147483647 >> 31;
	let r11: i32 = (2147483647 ^ z) >> (31 ^ z);
	printf("shr i32 2147483647 31 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i32 = 3 >> 0;
	let r12: i32 = (3 ^ z) >> (0 ^ z);
	printf("shr i32 3 0 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: i32 = 1 >> 1;
	let r13: i32 = (1 ^ z) >> (1 ^ z);
	printf("shr i32 1 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: i32 = -2147483648 >> 31;
	let r14: i32 = (-2147483648 ^ z) >> (31 ^ z);
	printf("shr i32 -2147483648 31 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: i32 = -8 >> 1;
	let r15: i32 = (-8 ^ z) >> (1 ^ z);
	printf("shr i32 -8 1 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: i32 = -1 >> 31;
	let r16: i32 = (-1 ^ z) >> (31 ^ z);
	printf("shr i32 -1 31 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: i32 = -2147483648 >> 1;
	let r17: i32 = (-2147483648 ^ z) >> (1 ^ z);
	printf("shr i32 -2147483648 1 = %lld %lld\n".ptr, F17 as int, r17 as int);
}

fn shift_on_i64(z: i64)
{
	const F0: i64 = 1 << 63;
	let r0: i64 = (1 ^ z) << (63 ^ z);
	printf("shl i64 1 63 = %lld %lld\n".ptr, F0 as int, r0 as int);
	const F1: i64 = 9223372036854775807 << 1;
	let r1: i64 = (9223372036854775807 ^ z) << (1 ^ z);
	printf("shl i64 9223372036854775807 1 = %lld %lld\n".ptr, F1 as int, r1 as int);
	const F2: i64 = 9223372036854775807 << 63;
	let r2: i64 = (9223372036854775807 ^ z) << (63 ^ z);
	printf("shl i64 9223372036854775807 63 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: i64 = 3 << 0;
	let r3: i64 = (3 ^ z) << (0 ^ z);
	printf("shl i64 3 0 = %lld %lld\n".ptr, F3 as int, r3 as int);
	const F4: i64 = 1 << 1;
	let r4: i64 = (1 ^ z) << (1 ^ z);
	printf("shl i64 1 1 = %lld %lld\n".ptr, F4 as int, r4 as int);
	const F5: i64 = -9223372036854775808 << 63;
	let r5: i64 = (-9223372036854775808 ^ z) << (63 ^ z);
	printf("shl i64 -9223372036854775808 63 = %lld %lld\n".ptr, F5 as int, r5 as int);
	const F6: i64 = -8 << 1;
	let r6: i64 = (-8 ^ z) << (1 ^ z);
	printf("shl i64 -8 1 = %lld %lld\n".ptr, F6 as int, r6 as int);
	const F7: i64 = -1 << 63;
	let r7: i64 = (-1 ^ z) << (63 ^ z);
	printf("shl i64 -1 63 = %lld %lld\n".ptr, F7 as int, r7 as int);
	const F8: i64 = -9223372036854775808 << 1;
	let r8: i64 = (-9223372036854775808 ^ z) << (1 ^ z);
	printf("shl i64 -9223372036854775808 1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i64 = 1 >> 63;
	let r9: i64 = (1 ^ z) >> (63 ^ z);
	printf("shr i64 1 63 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i64 = 9223372036854775807 >> 1;
	let r10: i64 = (9223372036854775807 ^ z) >> (1 ^ z);
	printf("shr i64 9223372036854775807 1 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i64 = 9223372036854775807 >> 63;
	let r11: i64 = (9223372036854775807 ^ z) >> (63 ^ z);
	printf("shr i64 9223372036854775807 63 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i64 = 3 >> 0;
	let r12: i64 = (3 ^ z) >> (0 ^ z);
	printf("shr i64 3 0 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: i64 = 1 >> 1;
	let r13: i64 = (1 ^ z) >> (1 ^ z);
	printf("shr i64 1 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: i64 = -9223372036854775808 >> 63;
	let r14: i64 = (-9223372036854775808 ^ z) >> (63 ^ z);
	printf("shr i64 -9223372036854775808 63 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: i64 = -8 >> 1;
	let r15: i64 = (-8 ^ z) >> (1 ^ z);
	printf("shr i64 -8 1 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: i64 = -1 >> 63;
	let r16: i64 = (-1 ^ z) >> (63 ^ z);
	printf("shr i64 -1 63 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: i64 = -9223372036854775808 >> 1;
	let r17: i64 = (-9223372036854775808 ^ z) >> (1 ^ z);
	printf("shr i64 -9223372036854775808 1 = %lld %lld\n".ptr, F17 as int, r17 as int);
}

fn shift_on_int(z: int)
{
	const F0: int = 1 << 63;
	let r0: int = (1 ^ z) << (63 ^ z);
	printf("shl int 1 63 = %lld %lld\n".ptr, F0 as int, r0 as int);
	const F1: int = 9223372036854775807 << 1;
	let r1: int = (9223372036854775807 ^ z) << (1 ^ z);
	printf("shl int 9223372036854775807 1 = %lld %lld\n".ptr, F1 as int, r1 as int);
	const F2: int = 9223372036854775807 << 63;
	let r2: int = (9223372036854775807 ^ z) << (63 ^ z);
	printf("shl int 9223372036854775807 63 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: int = 3 << 0;
	let r3: int = (3 ^ z) << (0 ^ z);
	printf("shl int 3 0 = %lld %lld\n".ptr, F3 as int, r3 as int);
	const F4: int = 1 << 1;
	let r4: int = (1 ^ z) << (1 ^ z);
	printf("shl int 1 1 = %lld %lld\n".ptr, F4 as int, r4 as int);
	const F5: int = -9223372036854775808 << 63;
	let r5: int = (-9223372036854775808 ^ z) << (63 ^ z);
	printf("shl int -9223372036854775808 63 = %lld %lld\n".ptr, F5 as int, r5 as int);
	const F6: int = -8 << 1;
	let r6: int = (-8 ^ z) << (1 ^ z);
	printf("shl int -8 1 = %lld %lld\n".ptr, F6 as int, r6 as int);
	const F7: int = -1 << 63;
	let r7: int = (-1 ^ z) << (63 ^ z);
	printf("shl int -1 63 = %lld %lld\n".ptr, F7 as int, r7 as int);
	const F8: int = -9223372036854775808 << 1;
	let r8: int = (-9223372036854775808 ^ z) << (1 ^ z);
	printf("shl int -9223372036854775808 1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: int = 1 >> 63;
	let r9: int = (1 ^ z) >> (63 ^ z);
	printf("shr int 1 63 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: int = 9223372036854775807 >> 1;
	let r10: int = (9223372036854775807 ^ z) >> (1 ^ z);
	printf("shr int 9223372036854775807 1 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: int = 9223372036854775807 >> 63;
	let r11: int = (9223372036854775807 ^ z) >> (63 ^ z);
	printf("shr int 9223372036854775807 63 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: int = 3 >> 0;
	let r12: int = (3 ^ z) >> (0 ^ z);
	printf("shr int 3 0 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: int = 1 >> 1;
	let r13: int = (1 ^ z) >> (1 ^ z);
	printf("shr int 1 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: int = -9223372036854775808 >> 63;
	let r14: int = (-9223372036854775808 ^ z) >> (63 ^ z);
	printf("shr int -9223372036854775808 63 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: int = -8 >> 1;
	let r15: int = (-8 ^ z) >> (1 ^ z);
	printf("shr int -8 1 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: int = -1 >> 63;
	let r16: int = (-1 ^ z) >> (63 ^ z);
	printf("shr int -1 63 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: int = -9223372036854775808 >> 1;
	let r17: int = (-9223372036854775808 ^ z) >> (1 ^ z);
	printf("shr int -9223372036854775808 1 = %lld %lld\n".ptr, F17 as int, r17 as int);
}

fn shift_on_u8(z: u8)
{
	const F0: u8 = 1 << 7;
	let r0: u8 = (1 ^ z) << (7 ^ z);
	printf("shl u8 1 7 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: u8 = 255 << 1;
	let r1: u8 = (255 ^ z) << (1 ^ z);
	printf("shl u8 255 1 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: u8 = 255 << 7;
	let r2: u8 = (255 ^ z) << (7 ^ z);
	printf("shl u8 255 7 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: u8 = 3 << 0;
	let r3: u8 = (3 ^ z) << (0 ^ z);
	printf("shl u8 3 0 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: u8 = 1 << 1;
	let r4: u8 = (1 ^ z) << (1 ^ z);
	printf("shl u8 1 1 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: u8 = 1 >> 7;
	let r5: u8 = (1 ^ z) >> (7 ^ z);
	printf("shr u8 1 7 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: u8 = 255 >> 1;
	let r6: u8 = (255 ^ z) >> (1 ^ z);
	printf("shr u8 255 1 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: u8 = 255 >> 7;
	let r7: u8 = (255 ^ z) >> (7 ^ z);
	printf("shr u8 255 7 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	const F8: u8 = 3 >> 0;
	let r8: u8 = (3 ^ z) >> (0 ^ z);
	printf("shr u8 3 0 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
	const F9: u8 = 1 >> 1;
	let r9: u8 = (1 ^ z) >> (1 ^ z);
	printf("shr u8 1 1 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
}

fn shift_on_u16(z: u16)
{
	const F0: u16 = 1 << 15;
	let r0: u16 = (1 ^ z) << (15 ^ z);
	printf("shl u16 1 15 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: u16 = 65535 << 1;
	let r1: u16 = (65535 ^ z) << (1 ^ z);
	printf("shl u16 65535 1 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: u16 = 65535 << 15;
	let r2: u16 = (65535 ^ z) << (15 ^ z);
	printf("shl u16 65535 15 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: u16 = 3 << 0;
	let r3: u16 = (3 ^ z) << (0 ^ z);
	printf("shl u16 3 0 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: u16 = 1 << 1;
	let r4: u16 = (1 ^ z) << (1 ^ z);
	printf("shl u16 1 1 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: u16 = 1 >> 15;
	let r5: u16 = (1 ^ z) >> (15 ^ z);
	printf("shr u16 1 15 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: u16 = 65535 >> 1;
	let r6: u16 = (65535 ^ z) >> (1 ^ z);
	printf("shr u16 65535 1 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: u16 = 65535 >> 15;
	let r7: u16 = (65535 ^ z) >> (15 ^ z);
