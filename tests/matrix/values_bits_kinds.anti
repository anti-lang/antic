	printf("xor i8 -7 2 = %lld %lld\n".ptr, F31 as int, r31 as int);
	const F32: i8 = 7 ^ -2;
	let r32: i8 = (7 ^ z) ^ (-2 ^ z);
	printf("xor i8 7 -2 = %lld %lld\n".ptr, F32 as int, r32 as int);
