fn main(args: []str) -> int
{
	let zero = args.len - 1;
	shift_on_i8(zero as i8);
	shift_on_i16(zero as i16);
	shift_on_i32(zero as i32);
	shift_on_i64(zero as i64);
	shift_on_int(zero as int);
	shift_on_u8(zero as u8);
	shift_on_u16(zero as u16);
	shift_on_u32(zero as u32);
	shift_on_u64(zero as u64);
	shift_on_uint(zero as uint);
	shift_on_byte(zero as byte);
	shift_wrap_on_i8(zero as i8);
	shift_wrap_on_i16(zero as i16);
	shift_wrap_on_i32(zero as i32);
	shift_wrap_on_i64(zero as i64);
	shift_wrap_on_int(zero as int);
	shift_wrap_on_u8(zero as u8);
	shift_wrap_on_u16(zero as u16);
	shift_wrap_on_u32(zero as u32);
	shift_wrap_on_u64(zero as u64);
	shift_wrap_on_uint(zero as uint);
	shift_wrap_on_byte(zero as byte);
	bitwise_on_i8(zero as i8);
	bitwise_on_i16(zero as i16);
	bitwise_on_i32(zero as i32);
	bitwise_on_i64(zero as i64);
	bitwise_on_int(zero as int);
	bitwise_on_u8(zero as u8);
	bitwise_on_u16(zero as u16);
	bitwise_on_u32(zero as u32);
	bitwise_on_u64(zero as u64);
	bitwise_on_uint(zero as uint);
	bitwise_on_byte(zero as byte);
	unary_on_i8(zero as i8);
	unary_on_i16(zero as i16);
	unary_on_i32(zero as i32);
	unary_on_i64(zero as i64);
	unary_on_int(zero as int);
	unary_on_u8(zero as u8);
	unary_on_u16(zero as u16);
	unary_on_u32(zero as u32);
	unary_on_u64(zero as u64);
	unary_on_uint(zero as uint);
	unary_on_byte(zero as byte);
	compare_on_i8(zero as i8);
	compare_on_i16(zero as i16);
	compare_on_i32(zero as i32);
	compare_on_i64(zero as i64);
	compare_on_int(zero as int);
	compare_on_u8(zero as u8);
	compare_on_u16(zero as u16);
	compare_on_u32(zero as u32);
	compare_on_u64(zero as u64);
	compare_on_uint(zero as uint);
	compare_on_byte(zero as byte);
	return 0;
}
