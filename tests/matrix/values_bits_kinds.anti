//! The shifts, the bitwise operators, unary `-` and `~` and the comparisons of
//! every integer type at its limits. `>>` keeps the sign of a signed type.
//! `<<%` gives 0 for a count at or above the width, and no build checks it. `-`
//! of the least value gives the least value in every build. A `compare` line
//! holds one pair of digits per operator of `== != < <= > >=`, the folded
//! answer and the computed one. A line names the operator, the type and the
//! operands. It holds the value the checker folds in a constant and the value
//! the program computes from operands it cannot know before it runs. `none`
//! stands where the checker refuses the constant, and `checked` where a dev
//! build stops, so the program does not run the case.

extern fn printf(format: ?*byte, ...) -> c_int;

fn shift_on_i8(z: i8)
{
	const F0: i8 = 1 << 7;
	let r0: i8 = (1 ^ z) << (7 ^ z);
	printf("shl i8 1 7 = %lld %lld\n".ptr, F0 as int, r0 as int);
	const F1: i8 = 127 << 1;
	let r1: i8 = (127 ^ z) << (1 ^ z);
	printf("shl i8 127 1 = %lld %lld\n".ptr, F1 as int, r1 as int);
	const F2: i8 = 127 << 7;
	let r2: i8 = (127 ^ z) << (7 ^ z);
	printf("shl i8 127 7 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: i8 = 3 << 0;
	let r3: i8 = (3 ^ z) << (0 ^ z);
	printf("shl i8 3 0 = %lld %lld\n".ptr, F3 as int, r3 as int);
	const F4: i8 = 1 << 1;
	let r4: i8 = (1 ^ z) << (1 ^ z);
	printf("shl i8 1 1 = %lld %lld\n".ptr, F4 as int, r4 as int);
	const F5: i8 = -128 << 7;
	let r5: i8 = (-128 ^ z) << (7 ^ z);
	printf("shl i8 -128 7 = %lld %lld\n".ptr, F5 as int, r5 as int);
	const F6: i8 = -8 << 1;
	let r6: i8 = (-8 ^ z) << (1 ^ z);
	printf("shl i8 -8 1 = %lld %lld\n".ptr, F6 as int, r6 as int);
	const F7: i8 = -1 << 7;
	let r7: i8 = (-1 ^ z) << (7 ^ z);
	printf("shl i8 -1 7 = %lld %lld\n".ptr, F7 as int, r7 as int);
	const F8: i8 = -128 << 1;
	let r8: i8 = (-128 ^ z) << (1 ^ z);
	printf("shl i8 -128 1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i8 = 1 >> 7;
	let r9: i8 = (1 ^ z) >> (7 ^ z);
	printf("shr i8 1 7 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i8 = 127 >> 1;
	let r10: i8 = (127 ^ z) >> (1 ^ z);
	printf("shr i8 127 1 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i8 = 127 >> 7;
	let r11: i8 = (127 ^ z) >> (7 ^ z);
	printf("shr i8 127 7 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i8 = 3 >> 0;
	let r12: i8 = (3 ^ z) >> (0 ^ z);
	printf("shr i8 3 0 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: i8 = 1 >> 1;
	let r13: i8 = (1 ^ z) >> (1 ^ z);
	printf("shr i8 1 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: i8 = -128 >> 7;
	let r14: i8 = (-128 ^ z) >> (7 ^ z);
	printf("shr i8 -128 7 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: i8 = -8 >> 1;
	let r15: i8 = (-8 ^ z) >> (1 ^ z);
	printf("shr i8 -8 1 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: i8 = -1 >> 7;
	let r16: i8 = (-1 ^ z) >> (7 ^ z);
	printf("shr i8 -1 7 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: i8 = -128 >> 1;
	let r17: i8 = (-128 ^ z) >> (1 ^ z);
	printf("shr i8 -128 1 = %lld %lld\n".ptr, F17 as int, r17 as int);
}

fn shift_on_i16(z: i16)
{
	const F0: i16 = 1 << 15;
	let r0: i16 = (1 ^ z) << (15 ^ z);
	printf("shl i16 1 15 = %lld %lld\n".ptr, F0 as int, r0 as int);
	const F1: i16 = 32767 << 1;
	let r1: i16 = (32767 ^ z) << (1 ^ z);
	printf("shl i16 32767 1 = %lld %lld\n".ptr, F1 as int, r1 as int);
	const F2: i16 = 32767 << 15;
	let r2: i16 = (32767 ^ z) << (15 ^ z);
	printf("shl i16 32767 15 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: i16 = 3 << 0;
	let r3: i16 = (3 ^ z) << (0 ^ z);
	printf("shl i16 3 0 = %lld %lld\n".ptr, F3 as int, r3 as int);
	const F4: i16 = 1 << 1;
	let r4: i16 = (1 ^ z) << (1 ^ z);
	printf("shl i16 1 1 = %lld %lld\n".ptr, F4 as int, r4 as int);
	const F5: i16 = -32768 << 15;
	let r5: i16 = (-32768 ^ z) << (15 ^ z);
	printf("shl i16 -32768 15 = %lld %lld\n".ptr, F5 as int, r5 as int);
	const F6: i16 = -8 << 1;
	let r6: i16 = (-8 ^ z) << (1 ^ z);
	printf("shl i16 -8 1 = %lld %lld\n".ptr, F6 as int, r6 as int);
	const F7: i16 = -1 << 15;
	let r7: i16 = (-1 ^ z) << (15 ^ z);
	printf("shl i16 -1 15 = %lld %lld\n".ptr, F7 as int, r7 as int);
	const F8: i16 = -32768 << 1;
	let r8: i16 = (-32768 ^ z) << (1 ^ z);
	printf("shl i16 -32768 1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i16 = 1 >> 15;
	let r9: i16 = (1 ^ z) >> (15 ^ z);
	printf("shr i16 1 15 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i16 = 32767 >> 1;
	let r10: i16 = (32767 ^ z) >> (1 ^ z);
	printf("shr i16 32767 1 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i16 = 32767 >> 15;
	let r11: i16 = (32767 ^ z) >> (15 ^ z);
	printf("shr i16 32767 15 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i16 = 3 >> 0;
	let r12: i16 = (3 ^ z) >> (0 ^ z);
	printf("shr i16 3 0 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: i16 = 1 >> 1;
	let r13: i16 = (1 ^ z) >> (1 ^ z);
	printf("shr i16 1 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: i16 = -32768 >> 15;
	let r14: i16 = (-32768 ^ z) >> (15 ^ z);
	printf("shr i16 -32768 15 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: i16 = -8 >> 1;
	let r15: i16 = (-8 ^ z) >> (1 ^ z);
	printf("shr i16 -8 1 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: i16 = -1 >> 15;
	let r16: i16 = (-1 ^ z) >> (15 ^ z);
	printf("shr i16 -1 15 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: i16 = -32768 >> 1;
	let r17: i16 = (-32768 ^ z) >> (1 ^ z);
	printf("shr i16 -32768 1 = %lld %lld\n".ptr, F17 as int, r17 as int);
}

fn shift_on_i32(z: i32)
{
	const F0: i32 = 1 << 31;
	let r0: i32 = (1 ^ z) << (31 ^ z);
	printf("shl i32 1 31 = %lld %lld\n".ptr, F0 as int, r0 as int);
	const F1: i32 = 2147483647 << 1;
	let r1: i32 = (2147483647 ^ z) << (1 ^ z);
	printf("shl i32 2147483647 1 = %lld %lld\n".ptr, F1 as int, r1 as int);
