//! A `recv` inside a `sync` block may wait while the block holds its lock. It
//! gets the warning `blocking-under-lock`, which a release build refuses.

struct Inbox
{
	lock: Mutex,
	count: int,
}

fn work(box: *Inbox, c: chan int) -> int
{
	sync box.lock {
		let v = recv(c) else {
			return box.count;
		};
		box.count += *v;
	}
	return box.count;
}

fn main() -> int
{
	let box = Inbox { count: 0 };
	let c = chan int(1);
	send(c, 4);
	let n = work(&box, c);
	delete(c);
	return n - 4;
}
