//! A field that holds a `?T` of an owning value, passed to an `own` parameter.
//! A value that stays where it is cannot move, and the copy would give what it
//! owns two owners.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn maybe(n: int) -> ?Key
{
	return key(n);
}

class Holder
{
	pub held: ?Key,
}

fn take(own x: ?Key) -> int
{
	return (x != none) as int;
}

fn main() -> int
{
	let h = Holder { held: maybe(1) };
	return take(h.held);
}
