//! `as` of a constant that is the least or the largest value of the target type
//! is taken, by R026 of "Rules of 2026-10-13".

extern fn printf(format: ?*byte, ...) -> c_int;

const TOP_U8: u8 = 255 as u8;
const LOW_I8: i8 = -128 as i8;
const TOP_I8: i8 = 127 as i8;
const TOP_U16: u16 = 65535 as u16;
const LOW_I32: i32 = -2147483648 as i32;
const TOP_U32: u32 = 4294967295 as u32;
const SAME_WIDTH: i8 = TOP_I8 as u8 as i8;
const FROM_BOOL: u8 = true as u8;

fn main() -> int
{
	printf("u8 %d\n".ptr, TOP_U8 as c_int);
	printf("i8 %d %d\n".ptr, LOW_I8 as c_int, TOP_I8 as c_int);
	printf("u16 %d\n".ptr, TOP_U16 as c_int);
	printf("i32 %d\n".ptr, LOW_I32 as c_int);
	printf("u32 %u\n".ptr, TOP_U32);
	printf("same width %d\n".ptr, SAME_WIDTH as c_int);
	printf("bool %d\n".ptr, FROM_BOOL as c_int);
	printf("local %d\n".ptr, (0 as u8) as c_int);
	return 0;
}
