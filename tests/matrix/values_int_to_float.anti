//! An integer converted to `f32` and to `f64`, at the limits of its type and
//! where the float cannot hold every bit. The conversion rounds to the nearest
//! float, a tie to the even one, and reads an unsigned value as unsigned. Each
//! line holds the value the checker folds in a constant and the value the
//! program computes.

extern fn printf(format: ?*byte, ...) -> c_int;

fn run(zero: int)
{
	const A0: i8 = -128;
	const F0: f32 = A0 as f32;
	let r0: f32 = (A0 ^ (zero as i8)) as f32;
	printf("as f32 i8 -128 = %.17g %.17g\n".ptr, F0 as f64, r0 as f64);
	const A1: i8 = -128;
	const F1: f64 = A1 as f64;
	let r1: f64 = (A1 ^ (zero as i8)) as f64;
	printf("as f64 i8 -128 = %.17g %.17g\n".ptr, F1 as f64, r1 as f64);
	const A2: i8 = 127;
	const F2: f32 = A2 as f32;
	let r2: f32 = (A2 ^ (zero as i8)) as f32;
	printf("as f32 i8 127 = %.17g %.17g\n".ptr, F2 as f64, r2 as f64);
	const A3: i8 = 127;
	const F3: f64 = A3 as f64;
	let r3: f64 = (A3 ^ (zero as i8)) as f64;
	printf("as f64 i8 127 = %.17g %.17g\n".ptr, F3 as f64, r3 as f64);
	const A4: u8 = 255;
	const F4: f32 = A4 as f32;
	let r4: f32 = (A4 ^ (zero as u8)) as f32;
	printf("as f32 u8 255 = %.17g %.17g\n".ptr, F4 as f64, r4 as f64);
	const A5: u8 = 255;
	const F5: f64 = A5 as f64;
	let r5: f64 = (A5 ^ (zero as u8)) as f64;
	printf("as f64 u8 255 = %.17g %.17g\n".ptr, F5 as f64, r5 as f64);
	const A6: i16 = -32768;
	const F6: f32 = A6 as f32;
	let r6: f32 = (A6 ^ (zero as i16)) as f32;
	printf("as f32 i16 -32768 = %.17g %.17g\n".ptr, F6 as f64, r6 as f64);
	const A7: i16 = -32768;
	const F7: f64 = A7 as f64;
	let r7: f64 = (A7 ^ (zero as i16)) as f64;
	printf("as f64 i16 -32768 = %.17g %.17g\n".ptr, F7 as f64, r7 as f64);
	const A8: u16 = 65535;
	const F8: f32 = A8 as f32;
	let r8: f32 = (A8 ^ (zero as u16)) as f32;
	printf("as f32 u16 65535 = %.17g %.17g\n".ptr, F8 as f64, r8 as f64);
	const A9: u16 = 65535;
	const F9: f64 = A9 as f64;
	let r9: f64 = (A9 ^ (zero as u16)) as f64;
	printf("as f64 u16 65535 = %.17g %.17g\n".ptr, F9 as f64, r9 as f64);
	const A10: i32 = 16777217;
	const F10: f32 = A10 as f32;
	let r10: f32 = (A10 ^ (zero as i32)) as f32;
	printf("as f32 i32 16777217 = %.17g %.17g\n".ptr, F10 as f64, r10 as f64);
	const A11: i32 = 16777217;
	const F11: f64 = A11 as f64;
	let r11: f64 = (A11 ^ (zero as i32)) as f64;
	printf("as f64 i32 16777217 = %.17g %.17g\n".ptr, F11 as f64, r11 as f64);
	const A12: i32 = -2147483648;
	const F12: f32 = A12 as f32;
	let r12: f32 = (A12 ^ (zero as i32)) as f32;
	printf("as f32 i32 -2147483648 = %.17g %.17g\n".ptr, F12 as f64, r12 as f64);
	const A13: i32 = -2147483648;
	const F13: f64 = A13 as f64;
	let r13: f64 = (A13 ^ (zero as i32)) as f64;
	printf("as f64 i32 -2147483648 = %.17g %.17g\n".ptr, F13 as f64, r13 as f64);
	const A14: u32 = 4294967295;
	const F14: f32 = A14 as f32;
	let r14: f32 = (A14 ^ (zero as u32)) as f32;
	printf("as f32 u32 4294967295 = %.17g %.17g\n".ptr, F14 as f64, r14 as f64);
	const A15: u32 = 4294967295;
	const F15: f64 = A15 as f64;
	let r15: f64 = (A15 ^ (zero as u32)) as f64;
	printf("as f64 u32 4294967295 = %.17g %.17g\n".ptr, F15 as f64, r15 as f64);
	const A16: u32 = 16777219;
	const F16: f32 = A16 as f32;
	let r16: f32 = (A16 ^ (zero as u32)) as f32;
	printf("as f32 u32 16777219 = %.17g %.17g\n".ptr, F16 as f64, r16 as f64);
	const A17: u32 = 16777219;
	const F17: f64 = A17 as f64;
	let r17: f64 = (A17 ^ (zero as u32)) as f64;
	printf("as f64 u32 16777219 = %.17g %.17g\n".ptr, F17 as f64, r17 as f64);
	const A18: i64 = 9223372036854775807;
	const F18: f32 = A18 as f32;
	let r18: f32 = (A18 ^ (zero as i64)) as f32;
	printf("as f32 i64 9223372036854775807 = %.17g %.17g\n".ptr, F18 as f64, r18 as f64);
	const A19: i64 = 9223372036854775807;
	const F19: f64 = A19 as f64;
	let r19: f64 = (A19 ^ (zero as i64)) as f64;
	printf("as f64 i64 9223372036854775807 = %.17g %.17g\n".ptr, F19 as f64, r19 as f64);
	const A20: i64 = -9223372036854775808;
	const F20: f32 = A20 as f32;
	let r20: f32 = (A20 ^ (zero as i64)) as f32;
	printf("as f32 i64 -9223372036854775808 = %.17g %.17g\n".ptr, F20 as f64, r20 as f64);
	const A21: i64 = -9223372036854775808;
	const F21: f64 = A21 as f64;
	let r21: f64 = (A21 ^ (zero as i64)) as f64;
	printf("as f64 i64 -9223372036854775808 = %.17g %.17g\n".ptr, F21 as f64, r21 as f64);
	const A22: i64 = 9007199254740993;
	const F22: f32 = A22 as f32;
	let r22: f32 = (A22 ^ (zero as i64)) as f32;
	printf("as f32 i64 9007199254740993 = %.17g %.17g\n".ptr, F22 as f64, r22 as f64);
	const A23: i64 = 9007199254740993;
	const F23: f64 = A23 as f64;
	let r23: f64 = (A23 ^ (zero as i64)) as f64;
	printf("as f64 i64 9007199254740993 = %.17g %.17g\n".ptr, F23 as f64, r23 as f64);
	const A24: int = -9007199254740993;
	const F24: f32 = A24 as f32;
	let r24: f32 = (A24 ^ (zero as int)) as f32;
	printf("as f32 int -9007199254740993 = %.17g %.17g\n".ptr, F24 as f64, r24 as f64);
	const A25: int = -9007199254740993;
	const F25: f64 = A25 as f64;
	let r25: f64 = (A25 ^ (zero as int)) as f64;
	printf("as f64 int -9007199254740993 = %.17g %.17g\n".ptr, F25 as f64, r25 as f64);
	const A26: u64 = 18446744073709551615;
	const F26: f32 = A26 as f32;
	let r26: f32 = (A26 ^ (zero as u64)) as f32;
	printf("as f32 u64 18446744073709551615 = %.17g %.17g\n".ptr, F26 as f64, r26 as f64);
	const A27: u64 = 18446744073709551615;
	const F27: f64 = A27 as f64;
	let r27: f64 = (A27 ^ (zero as u64)) as f64;
	printf("as f64 u64 18446744073709551615 = %.17g %.17g\n".ptr, F27 as f64, r27 as f64);
	const A28: u64 = 9223372036854775808;
	const F28: f32 = A28 as f32;
	let r28: f32 = (A28 ^ (zero as u64)) as f32;
	printf("as f32 u64 9223372036854775808 = %.17g %.17g\n".ptr, F28 as f64, r28 as f64);
	const A29: u64 = 9223372036854775808;
	const F29: f64 = A29 as f64;
	let r29: f64 = (A29 ^ (zero as u64)) as f64;
	printf("as f64 u64 9223372036854775808 = %.17g %.17g\n".ptr, F29 as f64, r29 as f64);
	const A30: uint = 9007199254740995;
	const F30: f32 = A30 as f32;
	let r30: f32 = (A30 ^ (zero as uint)) as f32;
	printf("as f32 uint 9007199254740995 = %.17g %.17g\n".ptr, F30 as f64, r30 as f64);
	const A31: uint = 9007199254740995;
	const F31: f64 = A31 as f64;
	let r31: f64 = (A31 ^ (zero as uint)) as f64;
	printf("as f64 uint 9007199254740995 = %.17g %.17g\n".ptr, F31 as f64, r31 as f64);
	const A32: byte = 200;
	const F32: f32 = A32 as f32;
	let r32: f32 = (A32 ^ (zero as byte)) as f32;
	printf("as f32 byte 200 = %.17g %.17g\n".ptr, F32 as f64, r32 as f64);
	const A33: byte = 200;
	const F33: f64 = A33 as f64;
	let r33: f64 = (A33 ^ (zero as byte)) as f64;
	printf("as f64 byte 200 = %.17g %.17g\n".ptr, F33 as f64, r33 as f64);
	const A34: int = 0;
	const F34: f32 = A34 as f32;
	let r34: f32 = (A34 ^ (zero as int)) as f32;
	printf("as f32 int 0 = %.17g %.17g\n".ptr, F34 as f64, r34 as f64);
	const A35: int = 0;
	const F35: f64 = A35 as f64;
	let r35: f64 = (A35 ^ (zero as int)) as f64;
	printf("as f64 int 0 = %.17g %.17g\n".ptr, F35 as f64, r35 as f64);
	const A36: i64 = 36028797018963969;
	const F36: f32 = A36 as f32;
	let r36: f32 = (A36 ^ (zero as i64)) as f32;
	printf("as f32 i64 36028797018963969 = %.17g %.17g\n".ptr, F36 as f64, r36 as f64);
	const A37: i64 = 36028797018963969;
	const F37: f64 = A37 as f64;
	let r37: f64 = (A37 ^ (zero as i64)) as f64;
	printf("as f64 i64 36028797018963969 = %.17g %.17g\n".ptr, F37 as f64, r37 as f64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	run(zero);
	return 0;
}
