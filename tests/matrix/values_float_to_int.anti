	printf("as uint 0 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
	let r10: uint = (1.8446744073709552e19 * one) as uint;
	printf("as uint 1.8446744073709552e+19 = none %llu\n".ptr, r10 as u64);
	let r11: uint = (-1.0 * one) as uint;
	printf("as uint -1 = none %llu\n".ptr, r11 as u64);
}

fn to_byte(one: f64)
{
	let r0: byte = ((one - one) / (one - one)) as byte;
	printf("as byte nan = none %llu\n".ptr, r0 as u64);
	let r1: byte = (one / (one - one)) as byte;
	printf("as byte inf = none %llu\n".ptr, r1 as u64);
	let r2: byte = (-one / (one - one)) as byte;
	printf("as byte -inf = none %llu\n".ptr, r2 as u64);
	let r3: byte = (1.0e30 * one) as byte;
	printf("as byte 1e+30 = none %llu\n".ptr, r3 as u64);
	let r4: byte = (-1.0e30 * one) as byte;
	printf("as byte -1e+30 = none %llu\n".ptr, r4 as u64);
	const F5: byte = 3.99 as byte;
	let r5: byte = (3.99 * one) as byte;
	printf("as byte 3.9900000000000002 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	let r6: byte = (-3.99 * one) as byte;
	printf("as byte -3.9900000000000002 = none %llu\n".ptr, r6 as u64);
	const F7: byte = -0.99 as byte;
	let r7: byte = (-0.99 * one) as byte;
	printf("as byte -0.98999999999999999 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	const F8: byte = 255.0 as byte;
	let r8: byte = (255.0 * one) as byte;
	printf("as byte 255 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
	const F9: byte = 0.0 as byte;
	let r9: byte = (0.0 * one) as byte;
	printf("as byte 0 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
	const F10: byte = 255.99 as byte;
	let r10: byte = (255.99 * one) as byte;
	printf("as byte 255.99000000000001 = %llu %llu\n".ptr, F10 as u64, r10 as u64);
	let r11: byte = (256.0 * one) as byte;
	printf("as byte 256 = none %llu\n".ptr, r11 as u64);
	const F12: byte = -0.99 as byte;
	let r12: byte = (-0.99 * one) as byte;
	printf("as byte -0.98999999999999999 = %llu %llu\n".ptr, F12 as u64, r12 as u64);
	let r13: byte = (-1.0 * one) as byte;
	printf("as byte -1 = none %llu\n".ptr, r13 as u64);
}

fn from_f32(one: f32)
{
	let r0: i32 = ((one - one) / (one - one)) as i32;
	printf("as i32 f32 nan = %lld\n".ptr, r0 as int);
	let r1: i32 = (one / (one - one)) as i32;
	printf("as i32 f32 inf = %lld\n".ptr, r1 as int);
	let r2: i32 = (-one / (one - one)) as i32;
	printf("as i32 f32 -inf = %lld\n".ptr, r2 as int);
	let r3: i32 = (3.0e9 * one) as i32;
	printf("as i32 f32 3000000000 = %lld\n".ptr, r3 as int);
	let r4: i32 = (-3.0e9 * one) as i32;
	printf("as i32 f32 -3000000000 = %lld\n".ptr, r4 as int);
	let r5: i32 = (2.5 * one) as i32;
	printf("as i32 f32 2.5 = %lld\n".ptr, r5 as int);
	let r6: u8 = ((one - one) / (one - one)) as u8;
	printf("as u8 f32 nan = %llu\n".ptr, r6 as u64);
	let r7: u8 = (one / (one - one)) as u8;
	printf("as u8 f32 inf = %llu\n".ptr, r7 as u64);
	let r8: u8 = (-one / (one - one)) as u8;
	printf("as u8 f32 -inf = %llu\n".ptr, r8 as u64);
	let r9: u8 = (3.0e9 * one) as u8;
	printf("as u8 f32 3000000000 = %llu\n".ptr, r9 as u64);
	let r10: u8 = (-3.0e9 * one) as u8;
	printf("as u8 f32 -3000000000 = %llu\n".ptr, r10 as u64);
	let r11: u8 = (2.5 * one) as u8;
	printf("as u8 f32 2.5 = %llu\n".ptr, r11 as u64);
	let r12: i64 = ((one - one) / (one - one)) as i64;
	printf("as i64 f32 nan = %lld\n".ptr, r12 as int);
	let r13: i64 = (one / (one - one)) as i64;
	printf("as i64 f32 inf = %lld\n".ptr, r13 as int);
	let r14: i64 = (-one / (one - one)) as i64;
	printf("as i64 f32 -inf = %lld\n".ptr, r14 as int);
	let r15: i64 = (3.0e9 * one) as i64;
	printf("as i64 f32 3000000000 = %lld\n".ptr, r15 as int);
	let r16: i64 = (-3.0e9 * one) as i64;
	printf("as i64 f32 -3000000000 = %lld\n".ptr, r16 as int);
	let r17: i64 = (2.5 * one) as i64;
	printf("as i64 f32 2.5 = %lld\n".ptr, r17 as int);
	let r18: u64 = ((one - one) / (one - one)) as u64;
	printf("as u64 f32 nan = %llu\n".ptr, r18 as u64);
	let r19: u64 = (one / (one - one)) as u64;
	printf("as u64 f32 inf = %llu\n".ptr, r19 as u64);
	let r20: u64 = (-one / (one - one)) as u64;
	printf("as u64 f32 -inf = %llu\n".ptr, r20 as u64);
	let r21: u64 = (3.0e9 * one) as u64;
	printf("as u64 f32 3000000000 = %llu\n".ptr, r21 as u64);
	let r22: u64 = (-3.0e9 * one) as u64;
	printf("as u64 f32 -3000000000 = %llu\n".ptr, r22 as u64);
	let r23: u64 = (2.5 * one) as u64;
	printf("as u64 f32 2.5 = %llu\n".ptr, r23 as u64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	to_i8((zero + 1) as f64);
	to_i16((zero + 1) as f64);
	to_i32((zero + 1) as f64);
	to_i64((zero + 1) as f64);
	to_int((zero + 1) as f64);
	to_u8((zero + 1) as f64);
	to_u16((zero + 1) as f64);
	to_u32((zero + 1) as f64);
	to_u64((zero + 1) as f64);
	to_uint((zero + 1) as f64);
	to_byte((zero + 1) as f64);
	from_f32((zero + 1) as f32);
	return 0;
}
