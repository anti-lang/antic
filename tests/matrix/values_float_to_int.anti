//! A float converted to every integer type. The conversion truncates toward
//! zero. A value outside the range of the type gives the nearest limit and a
//! NaN gives 0, in every build. Each line holds the value the checker folds in
//! a constant and the value the program computes. `none` stands where the value
//! is outside the range, which the checker refuses in a constant.

extern fn printf(format: ?*byte, ...) -> c_int;

fn to_i8(one: f64)
{
	let r0: i8 = ((one - one) / (one - one)) as i8;
	printf("as i8 nan = none %lld\n".ptr, r0 as int);
	let r1: i8 = (one / (one - one)) as i8;
	printf("as i8 inf = none %lld\n".ptr, r1 as int);
	let r2: i8 = (-one / (one - one)) as i8;
	printf("as i8 -inf = none %lld\n".ptr, r2 as int);
	let r3: i8 = (1.0e30 * one) as i8;
	printf("as i8 1e+30 = none %lld\n".ptr, r3 as int);
	let r4: i8 = (-1.0e30 * one) as i8;
	printf("as i8 -1e+30 = none %lld\n".ptr, r4 as int);
	const F5: i8 = 3.99 as i8;
	let r5: i8 = (3.99 * one) as i8;
	printf("as i8 3.9900000000000002 = %lld %lld\n".ptr, F5 as int, r5 as int);
	const F6: i8 = -3.99 as i8;
	let r6: i8 = (-3.99 * one) as i8;
	printf("as i8 -3.9900000000000002 = %lld %lld\n".ptr, F6 as int, r6 as int);
	const F7: i8 = -0.99 as i8;
	let r7: i8 = (-0.99 * one) as i8;
	printf("as i8 -0.98999999999999999 = %lld %lld\n".ptr, F7 as int, r7 as int);
	const F8: i8 = 127.0 as i8;
	let r8: i8 = (127.0 * one) as i8;
	printf("as i8 127 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i8 = -128.0 as i8;
	let r9: i8 = (-128.0 * one) as i8;
	printf("as i8 -128 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i8 = 127.99 as i8;
	let r10: i8 = (127.99 * one) as i8;
	printf("as i8 127.98999999999999 = %lld %lld\n".ptr, F10 as int, r10 as int);
	let r11: i8 = (128.0 * one) as i8;
	printf("as i8 128 = none %lld\n".ptr, r11 as int);
	const F12: i8 = -128.99 as i8;
	let r12: i8 = (-128.99 * one) as i8;
	printf("as i8 -128.99000000000001 = %lld %lld\n".ptr, F12 as int, r12 as int);
	let r13: i8 = (-129.0 * one) as i8;
	printf("as i8 -129 = none %lld\n".ptr, r13 as int);
}

