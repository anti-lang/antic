//! A pointer to a concurrent class without a hash of its own is no type
//! argument of a parameter that needs `hash`.

concurrent class Tally
{
	pub atomic hits: int = 0,
}

struct Keyed<T: hash>
{
	v: T,
}

fn main() -> int
{
	let a = alloc Tally { };
	let k = Keyed<*Tally> { v: a };
	delete(a);
	return 0;
}
