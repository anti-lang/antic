//! E2 in an undo: the block of the fail path reads a node after it deleted it.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Node
{
	pub n: int = 0,
}

fn show(k: int) may fail
{
	let p = alloc Node { n: k };
	undo {
		delete(p);
		printf("%d\n".ptr, p.n);
	}
	fail "undone";
}

fn main() -> int
{
	show(1) catch e {
		return 0;
	};
	return 1;
}
