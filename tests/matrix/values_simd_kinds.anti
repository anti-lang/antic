//! The operators of a simd struct, lane by lane, on integer and on float lanes:
//! `- / & | ^`, unary `-` and `~`, the six comparisons, whose result is a mask,
//! and the compound assignments. The lanes hold values the program cannot know
//! before it runs.

extern fn printf(format: ?*byte, ...) -> c_int;

simd struct I32x4
{
	a: i32,
	b: i32,
	c: i32,
	d: i32,
}

simd struct F32x4
{
	a: f32,
	b: f32,
	c: f32,
	d: f32,
}

fn show(name: str, v: I32x4)
{
	printf("%s %d %d %d %d\n".ptr, name.ptr, v.a, v.b, v.c, v.d);
}

fn show_floats(name: str, v: F32x4)
{
	printf("%s %g %g %g %g\n".ptr, name.ptr, v.a as f64, v.b as f64,
		v.c as f64, v.d as f64);
}

fn integers(z: i32)
{
	let v = I32x4 { a: 8 + z, b: -6 + z, c: 4 + z, d: 2 + z };
	let w = I32x4 { a: 2 + z, b: 3 + z, c: 4 + z, d: -1 + z };
	show("sub", v - w);
	show("div", v / w);
	show("and", v & w);
	show("or", v | w);
	show("xor", v ^ w);
	show("not", ~v);
	show("neg", -v);
	let eq = v == w;
	let ne = v != w;
	let lt = v < w;
	let le = v <= w;
	let gt = v > w;
	let ge = v >= w;
	printf("eq %d %d %d %d\n".ptr, eq.a as c_int, eq.b as c_int,
		eq.c as c_int, eq.d as c_int);
	printf("ne %d %d %d %d\n".ptr, ne.a as c_int, ne.b as c_int,
		ne.c as c_int, ne.d as c_int);
	printf("lt %d %d %d %d\n".ptr, lt.a as c_int, lt.b as c_int,
		lt.c as c_int, lt.d as c_int);
	printf("le %d %d %d %d\n".ptr, le.a as c_int, le.b as c_int,
		le.c as c_int, le.d as c_int);
	printf("gt %d %d %d %d\n".ptr, gt.a as c_int, gt.b as c_int,
		gt.c as c_int, gt.d as c_int);
	printf("ge %d %d %d %d\n".ptr, ge.a as c_int, ge.b as c_int,
		ge.c as c_int, ge.d as c_int);
}

fn floats(one: f32)
{
	let v = F32x4 { a: 1.5 * one, b: -2.0 * one, c: 0.0 * one, d: 8.0 };
	let w = F32x4 { a: 0.5 * one, b: 4.0 * one, c: 1.0 * one, d: -2.0 };
	show_floats("float sub", v - w);
	show_floats("float div", v / w);
	show_floats("float neg", -v);
	let lt = v < w;
	printf("float lt %d %d %d %d\n".ptr, lt.a as c_int, lt.b as c_int,
		lt.c as c_int, lt.d as c_int);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	integers(zero as i32);
	floats(args.len as f32);
	return 0;
}
