//! A job of `dispatch` that its block joins on every path while the local lives
//! may take the address of the local, as its object and as an argument of its
//! worker. A loop with a `break` of its own, a handler that yields and a
//! closure that returns stand between the two, and none leaves the block.

import anti.io;
import anti.text;

fn say(s: str)
{
	io.println(s);
	free(s.ptr);
}

class Counter
{
	pub n: int = 0,
}

worker fn bump(c: *Counter, by: int) -> int
{
	c.n += by;
	return c.n;
}

synchronized class Step
{
	n: int = 3,

	pub fn get(self) -> int
	{
		return self.n;
	}
}

worker fn add(c: *Counter, step: *Step) -> int
{
	c.n += step.get();
	return c.n;
}

fn checked(n: int) -> int may fail
{
	if n < 0 {
		fail "below zero";
	}
	return n;
}

fn twice(f: fn(int) -> int, n: int) -> int
{
	return f(f(n));
}

fn returned() -> int
{
	let c = Counter { };
	let job = dispatch &c -> bump(5);
	return join(job) - 1;
}

fn main() -> int
{
	let c = Counter { };
	let job = dispatch &c -> bump(2);
	let r = join(job);
	say(f"the object, joined by a let: {r}");
	say(f"the object, joined by a return: {returned()}");
	let d = Step { };
	let both = dispatch &c -> add(&d);
	let steps = 0;
	for i in 0..10 {
		if i == 3 {
			break;
		}
		steps += 1;
	}
	let k = checked(-1) catch {
		yield 4;
	};
	let m = twice(fn(x) {
		return x + 1;
	}, k);
	say(f"an argument, joined after a loop, a handler and a closure: {join(both)} {steps} {m}");
	return 0;
}
