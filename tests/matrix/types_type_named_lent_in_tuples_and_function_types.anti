//! `lent` is a contextual word, so a type named `lent` stands alone as an
//! element of a tuple and as a parameter of a function type.
import anti.io;

struct lent
{
	n: int,
}

fn first(p: lent, q: int) -> int
{
	return p.n + q;
}

fn last(q: int, p: lent) -> int
{
	return p.n - q;
}

fn main() -> int
{
	let a: (lent, int) = (lent { n: 1 }, 2);
	let b: (int, lent) = (3, lent { n: 4 });
	let f: fn(lent, int) -> int = first;
	let g: fn(int, lent) -> int = last;
	if f(a.0, a.1) == 3 && g(b.0, b.1) == 1 {
		io.println("lent 3 1");
	}
	return 0;
}
