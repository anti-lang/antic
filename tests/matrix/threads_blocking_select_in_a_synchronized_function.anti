//! A `select` in a public function of a synchronized class may wait while the
//! function holds the hidden lock of its object. It gets the warning
//! `blocking-under-lock`, which a release build refuses.

synchronized class Inbox
{
	count: int = 0,

	pub fn work(self, c: chan int) -> int
	{
		select {
			c v => {
				let x = v else {
					return self.count;
				};
				self.count += *x;
			}
		}
		return self.count;
	}
}

fn main() -> int
{
	let box = alloc Inbox { };
	let c = chan int(1);
	send(c, 4);
	let n = box.work(c);
	delete(c);
	delete(box);
	return n - 4;
}
