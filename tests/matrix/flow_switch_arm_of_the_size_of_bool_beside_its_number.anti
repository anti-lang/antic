//! A `switch` on an integer with the arm `size_of(bool)` before the arm `1`.
//! The size of a `bool` is 1 on every target, so the two arms hold one value,
//! and the second is refused, by R010 of the rules of 2026-10-13.

fn kind(n: int) -> int
{
	let k = 0;
	switch n {
		size_of(bool) => k = 1,
		1 => k = 2,
		else => k = 3,
	}
	return k;
}

fn main() -> int
{
	return kind(1);
}
