//! `return` of a parameter that is not `own` and holds a tuple that owns
//! something. The value belongs to the caller, which tears it down.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn back(x: (Key, int)) -> (Key, int)
{
	return x;
}

fn main() -> int
{
	let a = tuple(1);
	let b = back(a);
	return 0;
}
