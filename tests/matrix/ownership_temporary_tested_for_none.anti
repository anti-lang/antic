//! A call result of type `?T` that owns something, compared with `none` and
//! read by nothing else. The statement drops it, so it is torn down where the
//! statement ends.
extern fn printf(format: ?*byte, ...) -> c_int;

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,

	pub static atomic live: int = 0;

	fn construct(self)
	{
		Key.live.add(1);
	}

	fn destruct(self)
	{
		Key.live.sub(1);
	}
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn alive() -> c_int
{
	return Key.live.load() as c_int;
}

fn maybe(n: int) -> ?Key
{
	return key(n);
}

fn main() -> int
{
	let held = maybe(2) != none;
	printf("a test of a call result: %d, alive %d\n".ptr, held as c_int, alive());
	return 0;
}
