//! `yield` of a local that holds a struct that owns something. The value of the
//! `catch` would be a copy, and the local would stay a second owner.

import anti.lang;

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

struct Pair
{
	k: Key,
	n: int,
}

fn pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

fn failing(n: int) -> Pair may fail
{
	if n > 0 {
		fail "refused";
	}
	return pair(n);
}

fn main() -> int
{
	let a = pair(1);
	let b = failing(1) catch e {
		yield a;
	};
	return 0;
}
