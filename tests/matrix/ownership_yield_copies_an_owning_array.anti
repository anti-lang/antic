//! `yield` of a local that holds an array of owning values. The value of the
//! `catch` would be a copy, and the local would stay a second owner.

import anti.lang;

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

fn failing(n: int) -> [2]Key may fail
{
	if n > 0 {
		fail "refused";
	}
	return row(n);
}

fn main() -> int
{
	let a = row(1);
	let b = failing(1) catch e {
		yield a;
	};
	return 0;
}
