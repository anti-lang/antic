//! A function of a singleton class named `instance`. The compiler writes a
//! global of that name for every singleton, which holds the one object, and the
//! name of the class's own function is no other.

import anti.io;
import anti.text;

singleton class Config
{
	pub n: int = 3,

	pub fn instance(self) -> int
	{
		return self.n + 1;
	}
}

fn main() -> int
{
	let s = f"instance: {Config.get().instance()}";
	io.println(s);
	free(s.ptr);
	return 0;
}
