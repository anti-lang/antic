//! `send` of a local that holds an array of owning values. The channel would
//! hold a copy, and the local would stay a second owner.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

fn main() -> int
{
	let c = chan [2]Key(1);
	let a = row(1);
	send(c, a);
	delete(c);
	return 0;
}
