//! `yield` gives a lent slice as the value of a `catch`, which a local then
//! holds.

import anti.lang;

class Node
{
	pub n: int = 0,
}

fn failing(n: int) -> []int may fail
{
	fail "refused";
}

fn run(lent s: []int) -> int
{
	let t = failing(1) catch e {
		yield s;
	};
	return t.len;
}

fn main() -> int
{
	let numbers = [1, 2];
	return run(numbers[0..2]);
}
