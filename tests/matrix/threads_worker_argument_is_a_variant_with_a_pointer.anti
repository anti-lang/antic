//! An argument of a worker holds no pointer, so no two threads reach one piece
//! of memory through it. A variant with a case that holds a pointer is refused.

variant Link
{
	To { p: *int },
	None,
}

class Task
{
	pub n: int = 0,
}

worker fn read(t: *Task, v: Link) -> int
{
	return t.n;
}

fn main() -> int
{
	let n = 5;
	let numbers = [1, 2, 3];
	let t = alloc Task { };
	let job = dispatch t -> read(Link.To { p: &n });
	let got = join(job);
	delete(t);
	return got + n + numbers[0];
}
