//! C3 of the compile-time checks: a `may fail` function with a result reaches
//! its end without `return` or `fail`. An `if` without `else` deep inside
//! branches that end the path.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

extern fn exit(status: c_int) -> never;

fn value(n: int) -> int may fail
{
	if n > 2 {
		fail lang.Error.new(n, "refused");
	}
	return n;
}

fn stop(n: int) -> never
{
	exit(n as c_int);
}

fn f(p: ?*int, n: int) -> int may fail
{
	if n > 0 {
		switch n {
			1 => {
				fail "no value";
			},
			else => {
				if n > 5 {
					fail "no value";
				}
			},
		}
	} else {
		fail "no value";
	}
}

fn main() -> int
{
	return 0;
}
