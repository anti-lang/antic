//! An `if let` on a `?int` whose arm and whose `else` both return ends the path
//! of its function, since the missing-return rule reads an `if let` as an `if`
//! with an `else`.

extern fn printf(format: ?*byte, ...) -> c_int;

fn half(n: int) -> ?int
{
	if n % 2 == 0 {
		return n / 2;
	}
	return none;
}

fn run(n: int) -> int
{
	if let h = half(n) {
		return h;
	} else {
		return -1;
	}
}

fn main() -> int
{
	printf("%d %d\n".ptr, run(4) as c_int, run(3) as c_int);
	return 0;
}
