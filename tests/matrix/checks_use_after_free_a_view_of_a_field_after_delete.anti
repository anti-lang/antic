//! E2 and a view as bytes of an `own` field of `self` that `delete` ended: the
//! view is refused, as it is for a local.

extern fn printf(format: ?*byte, ...) -> c_int;

class Node
{
	pub n: int = 0,
}

class Holder
{
	pub own n: *Node,

	pub fn drop(self) -> *byte
	{
		delete(self.n);
		return self.n as *byte;
	}
}

fn main() -> int
{
	let h = alloc Holder { n: alloc Node { n: 1 } };
	let at = h.drop();
	printf("%p\n".ptr, at);
	return 0;
}
