//! A fresh owning value as an argument of a `parallel`, to a parameter that is
//! not `own`. The value has no owner but the caller, which tears it down once
//! every chunk has run, as it tears down the argument of a call.
import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,

	static atomic live: int = 0;

	fn construct(self)
	{
		Key.live.add(1);
	}

	fn destruct(self)
	{
		Key.live.sub(1);
	}
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn alive() -> c_int
{
	return Key.live.load() as c_int;
}

worker fn sum(chunk: []int, k: Key) -> int
{
	let total = k.n;
	for x in chunk {
		total += x;
	}
	return total;
}

fn run()
{
	let items = [1, 2, 3, 4];
	let parts = parallel items[0..4] by 2 -> sum(key(10));
	let total = 0;
	for p in parts {
		total += p;
	}
	printf("the parts: %d\n".ptr, total as c_int);
	free(parts.ptr);
}

fn main() -> int
{
	run();
	printf("after the function: alive %d\n".ptr, alive());
	return 0;
}
