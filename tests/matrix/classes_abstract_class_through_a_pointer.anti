//! `*p` of a pointer to an abstract class gives no complete value.

abstract class Shape
{
	abstract fn area(self) -> int;
}

class Square inherits Shape
{
	concrete fn area(self) -> int
	{
		return 1;
	}
}

fn main() -> int
{
	let sq = Square { };
	let p: *Shape = &sq;
	let copy = *p;
	return 0;
}
