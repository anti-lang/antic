fn main(args: []str) -> int
{
	let zero = args.len - 1;
	to_i8((zero + 1) as f64);
	to_i16((zero + 1) as f64);
	to_i32((zero + 1) as f64);
	to_i64((zero + 1) as f64);
	to_int((zero + 1) as f64);
	to_u8((zero + 1) as f64);
	to_u16((zero + 1) as f64);
	to_u32((zero + 1) as f64);
	to_u64((zero + 1) as f64);
	to_uint((zero + 1) as f64);
	to_byte((zero + 1) as f64);
	from_f32((zero + 1) as f32);
	from_int_run(zero);
	from_i8(zero as i8);
	from_i16(zero as i16);
	from_i32(zero as i32);
	from_i64(zero as i64);
	from_int(zero as int);
	from_u8(zero as u8);
	from_u16(zero as u16);
	from_u32(zero as u32);
	from_u64(zero as u64);
	from_uint(zero as uint);
	from_byte(zero as byte);
	return 0;
}
