//! `==` compares two function values of one signature. Two of one parameter
//! list and other results are refused.

fn f(n: int) -> int
{
	return n;
}

fn g(n: int) -> bool
{
	return n > 0;
}

fn main() -> int
{
	let a: fn(int) -> int = f;
	let b: fn(int) -> bool = g;
	if a == b {
		return 1;
	}
	return 0;
}
