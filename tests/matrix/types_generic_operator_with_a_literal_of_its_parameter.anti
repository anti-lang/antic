//! A literal as the second operand of a generic operator whose second
//! parameter is its type parameter. The first operand gives `T`, so the
//! literal takes `T`, as the call `add(a, 5)` would give it.

extern fn printf(format: ?*byte, ...) -> c_int;

struct Key<T>
{
	k: T,
}

operator fn add<T: Number>(a: Key<T>, b: T) -> T
{
	return a.k + b;
}

fn main() -> int
{
	let a = Key<int> { k: 1 };
	let n = a + 5;
	printf("%lld\n".ptr, n);
	return 0;
}
