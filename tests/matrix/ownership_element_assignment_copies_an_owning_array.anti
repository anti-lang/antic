//! `=` of a local that holds an array of owning values to an element of an
//! array. The copy would give what the value owns two owners.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

fn main() -> int
{
	let a = row(1);
	let xs = [row(2), row(3)];
	xs[0] = a;
	return 0;
}
