//! A generic `operator fn eq` with a type parameter that neither operand names.
//! `==` gives the operator no type arguments, so nothing gives `U`, and R067 of
//! "Rules of 2026-10-13" refuses the operator where it is declared.

struct Key<T>
{
	k: T,
}

operator fn eq<T, U>(a: Key<T>, b: Key<T>) -> bool
{
	return true;
}

fn main() -> int
{
	let a = Key<int> { k: 1 };
	let b = Key<int> { k: 1 };
	if a == b {
		return 0;
	}
	return 1;
}
