//! `let` of `*p` where `p` points at a class with a `destruct`. The value stays
//! where it is, and the copy would give what it owns two owners.

class Counted
{
	pub n: int = 0,

	fn destruct(self)
	{
	}
}

fn counted(n: int) -> Counted
{
	return Counted { n: n };
}

fn main() -> int
{
	let a = counted(1);
	let p = &a;
	let b = *p;
	return 0;
}
