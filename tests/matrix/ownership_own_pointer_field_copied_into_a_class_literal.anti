//! A class literal that gives its `own` field the pointer another `own`
//! field holds would give the node two owners, as `=` would. It is refused
//! with the same words.

class Node
{
	pub value: int = 0,
}

class Holder
{
	pub own head: ?*Node = none,
}

fn main() -> int
{
	let first = Holder { head: alloc Node { value: 1 } };
	let second = Holder { head: first.head };
	return 0;
}
