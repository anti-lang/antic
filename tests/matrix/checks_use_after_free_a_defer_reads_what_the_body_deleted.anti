//! E2 and a defer: the deferred block runs at the exit, after the body deleted
//! the node, and reads it there on every run.

extern fn printf(format: ?*byte, ...) -> c_int;

class Node
{
	pub n: int = 0,
}

fn main() -> int
{
	let p = alloc Node { n: 1 };
	defer {
		printf("%d\n".ptr, p.n);
	}
	delete(p);
	return 0;
}
