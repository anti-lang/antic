//! `yield` in each of these places: function, method, loop body, switch arm, if
//! let, defer, undo, catch handler, closure, worker, dispatch or parallel, sync
//! block, select arm, generic body, nested type. Each place is a function of
//! its own. A handler yields from inside an `if` and at its end, and the
//! handler of a call without a result ends with a `yield` that takes no value.
//! The program prints one line per place and input.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Task
{
	pub n: int = 0,
}

fn risky(n: int) -> int may fail
{
	if n > 2 {
		fail lang.Error.new(n, "refused");
	}
	return n * 10;
}

fn step(n: int) may fail
{
	if n == 0 {
		fail "no step";
	}
}

fn in_function(n: int) -> int
{
	let acc = 0;
	let got = risky(n) catch e {
		if e.code > 3 {
			yield e.code * 100;
		}
		let twice = e.code * 2;
		yield twice;
	};
	acc += got;
	step(n) catch {
		acc += 1000;
		yield;
	};
	return acc;
}

class Host
{
	pub base: int = 0,

	pub fn in_method(self, n: int) -> int
	{
		let acc = self.base;
		let got = risky(n) catch e {
			if e.code > 3 {
				yield e.code * 100;
			}
			let twice = e.code * 2;
			yield twice;
		};
		acc += got;
		step(n) catch {
			acc += 1000;
			yield;
		};
		return acc;
	}
}

fn in_loop(n: int) -> int
{
	let acc = 0;
	for turn in 0..2 {
		acc += turn;
		let got = risky(n) catch e {
			if e.code > 3 {
				yield e.code * 100;
			}
			let twice = e.code * 2;
			yield twice;
		};
		acc += got;
		step(n) catch {
			acc += 1000;
			yield;
		};
	}
	return acc;
}

fn in_arm(n: int) -> int
{
	let acc = 0;
	switch n {
		100 => acc = -5,
		else => {
			let got = risky(n) catch e {
				if e.code > 3 {
					yield e.code * 100;
				}
				let twice = e.code * 2;
				yield twice;
			};
			acc += got;
			step(n) catch {
				acc += 1000;
				yield;
			};
		},
	}
	return acc;
}

fn hold(k: int) -> ?int
{
	if k < 0 {
		return none;
	}
	return k;
}

fn in_if_let(k: int) -> int
{
	let acc = 0;
	if let n = hold(k) {
		let got = risky(n) catch e {
			if e.code > 3 {
				yield e.code * 100;
			}
			let twice = e.code * 2;
			yield twice;
		};
		acc += got;
		step(n) catch {
			acc += 1000;
			yield;
		};
	} else {
		acc = -9;
	}
	return acc;
}

fn in_defer(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let got = risky(n) catch e {
			if e.code > 3 {
				yield e.code * 100;
			}
			let twice = e.code * 2;
			yield twice;
		};
		acc += got;
		step(n) catch {
			acc += 1000;
			yield;
		};
	}
	acc = 1;
}

fn in_undo(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let got = risky(n) catch e {
			if e.code > 3 {
				yield e.code * 100;
			}
			let twice = e.code * 2;
			yield twice;
		};
		acc += got;
		step(n) catch {
			acc += 1000;
			yield;
		};
	}
	acc = 2;
	fail "undone";
}

fn always() may fail
{
	fail "always";
}

fn in_catch(n: int) -> int
{
	let acc = 0;
	always() catch {
		let got = risky(n) catch e {
			if e.code > 3 {
				yield e.code * 100;
			}
			let twice = e.code * 2;
			yield twice;
		};
		acc += got;
		step(n) catch {
			acc += 1000;
			yield;
		};
	};
	return acc;
}

fn apply(n: int, f: fn(int))
{
	f(n);
}

fn in_closure(k: int) -> int
{
	let acc = 0;
	apply(k, fn(n) {
		let got = risky(n) catch e {
			if e.code > 3 {
				yield e.code * 100;
			}
			let twice = e.code * 2;
			yield twice;
		};
		acc += got;
		step(n) catch {
			acc += 1000;
			yield;
		};
	});
	return acc;
}

worker fn in_worker(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let got = risky(n) catch e {
		if e.code > 3 {
			yield e.code * 100;
		}
		let twice = e.code * 2;
		yield twice;
	};
	acc += got;
	step(n) catch {
		acc += 1000;
		yield;
	};
	return acc;
}

worker fn work(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch(t: *Task, k: int) -> int
{
	t.n = k;
	let job = dispatch t -> work(fn(n) {
		let acc = 0;
		let got = risky(n) catch e {
			if e.code > 3 {
				yield e.code * 100;
			}
			let twice = e.code * 2;
			yield twice;
		};
		acc += got;
		step(n) catch {
			acc += 1000;
			yield;
		};
		return acc;
	});
	return join(job);
}

struct Guarded
{
	lock: Mutex,
	entered: int,
}

fn in_sync(g: *Guarded, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let got = risky(n) catch e {
			if e.code > 3 {
				yield e.code * 100;
			}
			let twice = e.code * 2;
			yield twice;
		};
		acc += got;
		step(n) catch {
			acc += 1000;
			yield;
		};
	}
	return acc;
}

fn in_select(c: chan int, k: int) -> int
{
	let acc = 0;
	send(c, k);
	select {
		c x => {
			let v = x else {
				return -9;
			};
			let n = *v;
			let got = risky(n) catch e {
				if e.code > 3 {
					yield e.code * 100;
				}
				let twice = e.code * 2;
				yield twice;
			};
			acc += got;
			step(n) catch {
				acc += 1000;
				yield;
			};
		},
	}
	return acc;
}

fn in_generic<T>(n: int) -> int
{
	let acc = size_of(T) as int * 10000;
	let got = risky(n) catch e {
		if e.code > 3 {
			yield e.code * 100;
		}
		let twice = e.code * 2;
		yield twice;
	};
	acc += got;
	step(n) catch {
		acc += 1000;
		yield;
	};
	return acc;
}

class Outer
{
	class Inner
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let got = risky(n) catch e {
				if e.code > 3 {
					yield e.code * 100;
				}
				let twice = e.code * 2;
				yield twice;
			};
			acc += got;
			step(n) catch {
				acc += 1000;
				yield;
			};
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner { base: 0 };
		return inner.run(n);
	}
}

fn main() -> int
{
	let task = alloc Task { };
	let host = Host { base: 0 };
	let g = Guarded { lock: Mutex.new(), entered: 0 };
	let c = chan int(1);
	let outer = Outer { };
	for n in 0..5 {
		printf("function %d %d\n".ptr, n as c_int, in_function(n) as c_int);
		printf("method %d %d\n".ptr, n as c_int, host.in_method(n) as c_int);
		printf("loop %d %d\n".ptr, n as c_int, in_loop(n) as c_int);
		printf("arm %d %d\n".ptr, n as c_int, in_arm(n) as c_int);
		printf("if_let %d %d\n".ptr, n as c_int, in_if_let(n) as c_int);
		let deferred = 0;
		in_defer(n, &deferred);
		printf("defer %d %d\n".ptr, n as c_int, deferred as c_int);
		let undone = 0;
		in_undo(n, &undone) catch {
			yield;
		};
		printf("undo %d %d\n".ptr, n as c_int, undone as c_int);
		printf("catch %d %d\n".ptr, n as c_int, in_catch(n) as c_int);
		printf("closure %d %d\n".ptr, n as c_int, in_closure(n) as c_int);
		task.n = n;
		let job = dispatch task -> in_worker();
		printf("worker %d %d\n".ptr, n as c_int, join(job) as c_int);
		printf("dispatch %d %d\n".ptr, n as c_int, in_dispatch(task, n) as c_int);
		printf("sync %d %d\n".ptr, n as c_int, in_sync(&g, n) as c_int);
		printf("select %d %d\n".ptr, n as c_int, in_select(c, n) as c_int);
		printf("generic %d %d %d\n".ptr, n as c_int, in_generic<int>(n) as c_int,
			in_generic<bool>(n) as c_int);
		printf("nested %d %d\n".ptr, n as c_int, outer.go(n) as c_int);
	}
	printf("sync entered %d\n".ptr, g.entered as c_int);
	g.lock.destroy();
	delete(c);
	delete(task);
	return 0;
}
