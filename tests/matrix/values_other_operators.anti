//! The comparisons on the kinds of value that are no numbers, and the operators
//! of a simd struct. The parts are `compare`, `simd`. Each is a function with
//! the comment of its subject before it, and a line `-- <part>` stands before
//! its output.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

// `==` and `!=` on the kinds of value that are no numbers, and `<` to `>=` on
// the ones that have an order. A struct, a packed struct, a tuple, a variant,
// a fixed array and a class compare part by part. A pointer, a channel and a
// function value compare by identity. A `char` orders by its code point and a
// `str` by its bytes. A struct with `operator fn lt` takes `>`, `<=` and `>=`
// from it.

struct Pt
{
	x: int,
	y: int,
}

packed struct Pk
{
	a: u8,
	b: i32,
}

enum Color
{
	Red,
	Green,
	Blue,
}

variant Shape
{
	Circle { r: int },
	Empty,
}

class Counter
{
	pub n: int = 0,
}

struct Version
{
	major: int,
	minor: int,
}

operator fn lt(a: Version, b: Version) -> bool
{
	return a.major < b.major || (a.major == b.major && a.minor < b.minor);
}

fn up(n: int) -> int
{
	return n + 1;
}

fn down(n: int) -> int
{
	return n - 1;
}

fn show(name: str, same: bool, differs: bool)
{
	printf("%s %d %d\n".ptr, name.ptr, same as c_int, differs as c_int);
}

fn equality(zero: int)
{
	let a = 1 + zero;
	let b = 1 + zero;
	let yes = zero == 0;
	let letter = 'a';
	let text = "one";
	let color = Color.Green;
	let pa = &a;
	let maybe: ?*int = &a;
	let held: ?int = a;
	let f: fn(int) -> int = up;
	let c1 = chan int(1);
	let c2 = chan int(1);
	let row = [a, 2, 3];
	let counter = Counter { n: a };
	show("bool", yes == true, yes != true);
	show("char", letter == 'a', letter != 'a');
	show("str", text == "one", text != "one");
	show("str of other bytes", text == "two", text != "two");
	show("enum", color == Color.Green, color != Color.Green);
	show("pointer", pa == &a, pa != &a);
	show("pointer to an equal value", pa == &b, pa != &b);
	show("nullable pointer", maybe == none, maybe != none);
	show("optional value", held == none, held != none);
	show("function value", f == up, f != up);
	show("other function", f == down, f != down);
	show("channel", c1 == c1, c1 != c1);
	show("other channel", c1 == c2, c1 != c2);
	show("struct", Pt { x: a, y: 2 } == Pt { x: 1, y: 2 },
		Pt { x: a, y: 2 } != Pt { x: 1, y: 2 });
	show("struct of another field", Pt { x: a, y: 2 } == Pt { x: 1, y: 3 },
		Pt { x: a, y: 2 } != Pt { x: 1, y: 3 });
	show("packed struct", Pk { a: 1, b: -2 } == Pk { a: 1, b: -2 },
		Pk { a: 1, b: -2 } != Pk { a: 1, b: -2 });
	show("tuple", (a, true) == (1, true), (a, true) != (1, true));
	show("variant", Shape.Circle { r: a } == Shape.Circle { r: 1 },
		Shape.Circle { r: a } != Shape.Circle { r: 1 });
	show("variant of another case", Shape.Circle { r: a } == Shape.Empty,
		Shape.Circle { r: a } != Shape.Empty);
	show("fixed array", row == [1, 2, 3], row != [1, 2, 3]);
	show("class", counter == Counter { n: 1 }, counter != Counter { n: 1 });
	delete(c1);
	delete(c2);
}

fn order(zero: int)
{
	let b: char = 'b';
	let last = '\u{10FFFF}';
	let pear = "pear";
	let v1 = Version { major: 1, minor: 9 + zero };
	let v2 = Version { major: 2, minor: 0 };
	printf("char %d %d %d %d\n".ptr, ('a' < b) as c_int, (b <= 'b') as c_int,
		(b > last) as c_int, (last >= b) as c_int);
	printf("str %d %d %d %d\n".ptr, (pear < "plum") as c_int,
		(pear <= "pear") as c_int, (pear > "pea") as c_int,
		("" >= pear) as c_int);
	printf("str by bytes %d %d\n".ptr, ("Z" < "a") as c_int,
		("z" < "\u{e9}") as c_int);
	printf("struct with lt %d %d\n".ptr, (v1 < v2) as c_int,
		(v2 < v1) as c_int);
	printf("derived from lt %d %d %d %d\n".ptr, (v1 > v2) as c_int,
		(v1 <= v2) as c_int, (v1 >= v2) as c_int, (v2 >= v2) as c_int);
}

fn compare_part(args: []str) -> int
{
	let zero = args.len - 1;
	equality(zero);
	order(zero);
	return 0;
}

// The operators of a simd struct, lane by lane, on integer and on float lanes:
// `- / & | ^`, unary `-` and `~`, the six comparisons, whose result is a mask,
// and the compound assignments. The lanes hold values the program cannot know
// before it runs.

simd struct I32x4
{
	a: i32,
	b: i32,
	c: i32,
	d: i32,
}

simd struct F32x4
{
	a: f32,
	b: f32,
	c: f32,
	d: f32,
}

fn show_simd(name: str, v: I32x4)
{
	printf("%s %d %d %d %d\n".ptr, name.ptr, v.a, v.b, v.c, v.d);
}

fn show_floats(name: str, v: F32x4)
{
	printf("%s %g %g %g %g\n".ptr, name.ptr, v.a as f64, v.b as f64,
		v.c as f64, v.d as f64);
}

fn integers(z: i32)
{
	let v = I32x4 { a: 8 + z, b: -6 + z, c: 4 + z, d: 2 + z };
	let w = I32x4 { a: 2 + z, b: 3 + z, c: 4 + z, d: -1 + z };
	show_simd("sub", v - w);
	show_simd("div", v / w);
	show_simd("and", v & w);
	show_simd("or", v | w);
	show_simd("xor", v ^ w);
	show_simd("not", ~v);
	show_simd("neg", -v);
	let eq = v == w;
	let ne = v != w;
	let lt = v < w;
	let le = v <= w;
	let gt = v > w;
	let ge = v >= w;
	printf("eq %d %d %d %d\n".ptr, eq.a as c_int, eq.b as c_int,
		eq.c as c_int, eq.d as c_int);
	printf("ne %d %d %d %d\n".ptr, ne.a as c_int, ne.b as c_int,
		ne.c as c_int, ne.d as c_int);
	printf("lt %d %d %d %d\n".ptr, lt.a as c_int, lt.b as c_int,
		lt.c as c_int, lt.d as c_int);
	printf("le %d %d %d %d\n".ptr, le.a as c_int, le.b as c_int,
		le.c as c_int, le.d as c_int);
	printf("gt %d %d %d %d\n".ptr, gt.a as c_int, gt.b as c_int,
		gt.c as c_int, gt.d as c_int);
	printf("ge %d %d %d %d\n".ptr, ge.a as c_int, ge.b as c_int,
		ge.c as c_int, ge.d as c_int);
}

fn floats(one: f32)
{
	let v = F32x4 { a: 1.5 * one, b: -2.0 * one, c: 0.0 * one, d: 8.0 };
	let w = F32x4 { a: 0.5 * one, b: 4.0 * one, c: 1.0 * one, d: -2.0 };
	show_floats("float sub", v - w);
	show_floats("float div", v / w);
	show_floats("float neg", -v);
	let lt = v < w;
	printf("float lt %d %d %d %d\n".ptr, lt.a as c_int, lt.b as c_int,
		lt.c as c_int, lt.d as c_int);
}

fn simd_part(args: []str) -> int
{
	let zero = args.len - 1;
	integers(zero as i32);
	floats(args.len as f32);
	return 0;
}

fn main(args: []str) -> int
{
	printf("-- compare\n".ptr);
	compare_part(args);
	printf("-- simd\n".ptr);
	simd_part(args);
	return 0;
}
