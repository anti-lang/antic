//! A lent pointer passed to a parameter that is not `lent`, which may keep what
//! it takes.

class Node
{
	pub n: int = 0,
}

fn keep_it(p: *Node) -> int
{
	return p.n;
}

fn keep_all(s: []int) -> int
{
	return s.len;
}

fn run(lent p: *Node) -> int
{
	return keep_it(p);
}

fn main() -> int
{
	let node = Node { n: 7 };
	return run(&node);
}
