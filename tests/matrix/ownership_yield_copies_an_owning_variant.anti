//! `yield` of a local that holds a variant with an owning case. The value of
//! the `catch` would be a copy, and the local would stay a second owner.

import anti.lang;

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

variant Shape
{
	Keyed { k: Key },
	Empty,
}

fn shape(n: int) -> Shape
{
	return Shape.Keyed { k: key(n) };
}

fn failing(n: int) -> Shape may fail
{
	if n > 0 {
		fail "refused";
	}
	return shape(n);
}

fn main() -> int
{
	let a = shape(1);
	let b = failing(1) catch e {
		yield a;
	};
	return 0;
}
