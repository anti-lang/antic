//! A field of a class takes a length computed from `size_of`, as a field of a
//! struct does, by R043 of "Rules of 2026-10-13". A literal names the field,
//! and the back end decides the length on each target.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

struct Pair
{
	a: i64,
	b: i64,
}

class Room
{
	pub cells: [size_of(Pair)]int,
	pub rows: [2][size_of(Pair) / 4]i8,
}

fn main() -> int
{
	let r = Room { cells: [3; size_of(Pair)], rows: [[1; size_of(Pair) / 4]; 2] };
	r.cells[15] = 9;
	printf("cells %lld %lld %lld\n".ptr, r.cells.len, r.cells[0], r.cells[15]);
	printf("rows %lld %lld %d\n".ptr, r.rows.len, r.rows[1].len, r.rows[1][3] as c_int);
	return 0;
}
