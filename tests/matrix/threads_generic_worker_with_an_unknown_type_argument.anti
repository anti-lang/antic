//! The type argument of a dispatch of a generic worker is a type of the
//! program.

class Task
{
	pub n: int = 0,
}

worker fn read<T>(t: *Task, v: T) -> int
{
	return t.n;
}

fn main() -> int
{
	let t = alloc Task { };
	let job = dispatch t -> read<Missing>(5);
	let got = join(job);
	delete(t);
	return got;
}
