//! An element of an array that holds a tuple that owns something, named in an
//! array literal. The element stays where it is, so the literal would hold a
//! copy and the array would stay a second owner. A local moves there, by R079
//! of "Rules of 2026-10-13".

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn main() -> int
{
	let held = [tuple(1), tuple(2)];
	let xs = [held[0], tuple(3)];
	return 0;
}
