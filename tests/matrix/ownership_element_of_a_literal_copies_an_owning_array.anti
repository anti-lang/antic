//! An element of an array that holds an array of owning values, named in an
//! array literal. The element stays where it is, so the literal would hold a
//! copy and the array would stay a second owner. A local moves there, by R079
//! of "Rules of 2026-10-13".

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

fn main() -> int
{
	let held = [row(1), row(2)];
	let xs = [held[0], row(3)];
	return 0;
}
