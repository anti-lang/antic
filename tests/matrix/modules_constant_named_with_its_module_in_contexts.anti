//! A constant of another module named with its module, followed by a call of a
//! function of the module that declares its type, `graphics.PINK.fade(0.5)`, by
//! a field, `graphics.PINK.r`, and by the hook `hash`, in each of these places:
//! function, method, loop body, switch arm, if let, defer, undo, catch handler,
//! closure, worker, dispatch or parallel, sync block, select arm, generic body,
//! nested type. Each place is a function of its own, and the program prints one
//! line per place and input.

import anti.graphics;
import anti.lang;
import anti.math;
import anti.reflect;

extern fn printf(format: ?*byte, ...) -> c_int;

class Task
{
	pub n: int = 0,
	pub env: ?*Env = none,
}

struct Env
{
	lock: Mutex,
	gate: chan int,
	task: *Task,
}

fn in_function(e: *Env, k: int) -> int
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = k;
	let c = graphics.PINK.fade(0.5);
	acc += c.a as int + graphics.PINK.r as int;
	acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
	if reflect.BAD_INDEX.hash() == one.hash() {
		acc += 1000;
	}
	if math.PI.hash() == pi.hash() {
		acc += 10000;
	}
	return acc;
}

class Host
{
	pub base: int = 0,

	pub fn in_method(self, e: *Env, k: int) -> int
	{
		let one = 1;
		let pi: f32 = 3.14159265358979323846;
		let acc = self.base + k;
		let c = graphics.PINK.fade(0.5);
		acc += c.a as int + graphics.PINK.r as int;
		acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
		if reflect.BAD_INDEX.hash() == one.hash() {
			acc += 1000;
		}
		if math.PI.hash() == pi.hash() {
			acc += 10000;
		}
		return acc;
	}
}

fn in_loop(e: *Env, k: int) -> int
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = 0;
	for turn in 0..2 {
		acc += turn + k;
		let c = graphics.PINK.fade(0.5);
		acc += c.a as int + graphics.PINK.r as int;
		acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
		if reflect.BAD_INDEX.hash() == one.hash() {
			acc += 1000;
		}
		if math.PI.hash() == pi.hash() {
			acc += 10000;
		}
	}
	return acc;
}

fn in_arm(e: *Env, k: int) -> int
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = 0;
	switch k {
		100 => acc = -5,
		else => {
			acc += k;
			let c = graphics.PINK.fade(0.5);
			acc += c.a as int + graphics.PINK.r as int;
			acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
			if reflect.BAD_INDEX.hash() == one.hash() {
				acc += 1000;
			}
			if math.PI.hash() == pi.hash() {
				acc += 10000;
			}
		},
	}
	return acc;
}

fn hold(k: int) -> ?int
{
	if k < 0 {
		return none;
	}
	return k;
}

fn in_if_let(e: *Env, start: int) -> int
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = 0;
	if let k = hold(start) {
		acc += k;
		let c = graphics.PINK.fade(0.5);
		acc += c.a as int + graphics.PINK.r as int;
		acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
		if reflect.BAD_INDEX.hash() == one.hash() {
			acc += 1000;
		}
		if math.PI.hash() == pi.hash() {
			acc += 10000;
		}
	} else {
		acc = -9;
	}
	return acc;
}

fn in_defer(e: *Env, k: int, out: *int)
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = 0;
	defer *out = acc;
	defer {
		acc += k;
		let c = graphics.PINK.fade(0.5);
		acc += c.a as int + graphics.PINK.r as int;
		acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
		if reflect.BAD_INDEX.hash() == one.hash() {
			acc += 1000;
		}
		if math.PI.hash() == pi.hash() {
			acc += 10000;
		}
	}
	acc = 1;
}

fn in_undo(e: *Env, k: int, out: *int) may fail
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = 0;
	undo *out = acc;
	undo {
		acc += k;
		let c = graphics.PINK.fade(0.5);
		acc += c.a as int + graphics.PINK.r as int;
		acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
		if reflect.BAD_INDEX.hash() == one.hash() {
			acc += 1000;
		}
		if math.PI.hash() == pi.hash() {
			acc += 10000;
		}
	}
	acc = 2;
	fail "undone";
}

fn always() may fail
{
	fail "always";
}

fn in_catch(e: *Env, k: int) -> int
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = 0;
	always() catch {
		acc += k;
		let c = graphics.PINK.fade(0.5);
		acc += c.a as int + graphics.PINK.r as int;
		acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
		if reflect.BAD_INDEX.hash() == one.hash() {
			acc += 1000;
		}
		if math.PI.hash() == pi.hash() {
			acc += 10000;
		}
	};
	return acc;
}

fn apply(n: int, f: fn(int))
{
	f(n);
}

fn in_closure(e: *Env, start: int) -> int
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = 0;
	apply(start, fn(k) {
		acc += k;
		let c = graphics.PINK.fade(0.5);
		acc += c.a as int + graphics.PINK.r as int;
		acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
		if reflect.BAD_INDEX.hash() == one.hash() {
			acc += 1000;
		}
		if math.PI.hash() == pi.hash() {
			acc += 10000;
		}
	});
	return acc;
}

worker fn in_worker(t: *Task) -> int
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = t.n;
	let c = graphics.PINK.fade(0.5);
	acc += c.a as int + graphics.PINK.r as int;
	acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
	if reflect.BAD_INDEX.hash() == one.hash() {
		acc += 1000;
	}
	if math.PI.hash() == pi.hash() {
		acc += 10000;
	}
	return acc;
}

fn run_worker(e: *Env, k: int) -> int
{
	e.task.n = k;
	let job = dispatch e.task -> in_worker;
	let got = join(job);

	return got;
}

worker fn work(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch(e: *Env, start: int) -> int
{
	e.task.n = start;
	let job = dispatch e.task -> work(fn(k) {
		let one = 1;
		let pi: f32 = 3.14159265358979323846;
		let acc = k;
		let c = graphics.PINK.fade(0.5);
		acc += c.a as int + graphics.PINK.r as int;
		acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
		if reflect.BAD_INDEX.hash() == one.hash() {
			acc += 1000;
		}
		if math.PI.hash() == pi.hash() {
			acc += 10000;
		}
		return acc;
	});
	return join(job);
}

fn in_sync(e: *Env, k: int) -> int
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = 0;
	sync e.lock {
		acc += k;
		let c = graphics.PINK.fade(0.5);
		acc += c.a as int + graphics.PINK.r as int;
		acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
		if reflect.BAD_INDEX.hash() == one.hash() {
			acc += 1000;
		}
		if math.PI.hash() == pi.hash() {
			acc += 10000;
		}
	}
	return acc;
}

fn in_select(e: *Env, start: int) -> int
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = 0;
	send(e.gate, start);
	select {
		e.gate x => {
			let v = x else {
				return -9;
			};
			acc += *v;
			let c = graphics.PINK.fade(0.5);
			acc += c.a as int + graphics.PINK.r as int;
			acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
			if reflect.BAD_INDEX.hash() == one.hash() {
				acc += 1000;
			}
			if math.PI.hash() == pi.hash() {
				acc += 10000;
			}
		},
	}
	return acc;
}

fn in_generic<T>(e: *Env, k: int) -> int
{
	let one = 1;
	let pi: f32 = 3.14159265358979323846;
	let acc = size_of(T) as int * 100000 + k;
	let c = graphics.PINK.fade(0.5);
	acc += c.a as int + graphics.PINK.r as int;
	acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
	if reflect.BAD_INDEX.hash() == one.hash() {
		acc += 1000;
	}
	if math.PI.hash() == pi.hash() {
		acc += 10000;
	}
	return acc;
}

class Outer
{
	class Inner
	{
		pub base: int = 0,

		pub fn run(self, e: *Env, k: int) -> int
		{
			let one = 1;
			let pi: f32 = 3.14159265358979323846;
			let acc = self.base + k;
			let c = graphics.PINK.fade(0.5);
			acc += c.a as int + graphics.PINK.r as int;
			acc += graphics.PINK.lerp(graphics.LIME, 1.0).g as int;
			if reflect.BAD_INDEX.hash() == one.hash() {
				acc += 1000;
			}
			if math.PI.hash() == pi.hash() {
				acc += 10000;
			}
			return acc;
		}
	}

	pub fn go(self, e: *Env, k: int) -> int
	{
		let inner = Inner { base: 0 };
		return inner.run(e, k);
	}
}

fn main() -> int
{
	let task = alloc Task { };
	let e = alloc Env { lock: Mutex.new(), gate: chan int(1), task: task };
	task.env = e;
	let host = Host { base: 0 };
	let outer = Outer { };
	for k in 1..3 {
		printf("function %d %d\n".ptr, k as c_int, in_function(e, k) as c_int);
		printf("method %d %d\n".ptr, k as c_int, host.in_method(e, k) as c_int);
		printf("loop %d %d\n".ptr, k as c_int, in_loop(e, k) as c_int);
		printf("arm %d %d\n".ptr, k as c_int, in_arm(e, k) as c_int);
		printf("if_let %d %d\n".ptr, k as c_int, in_if_let(e, k) as c_int);
		let deferred = 0;
		in_defer(e, k, &deferred);
		printf("defer %d %d\n".ptr, k as c_int, deferred as c_int);
		let undone = 0;
		in_undo(e, k, &undone) catch {
			yield;
		};
		printf("undo %d %d\n".ptr, k as c_int, undone as c_int);
		printf("catch %d %d\n".ptr, k as c_int, in_catch(e, k) as c_int);
		printf("closure %d %d\n".ptr, k as c_int, in_closure(e, k) as c_int);
		printf("worker %d %d\n".ptr, k as c_int, run_worker(e, k) as c_int);
		printf("dispatch %d %d\n".ptr, k as c_int, in_dispatch(e, k) as c_int);
		printf("sync %d %d\n".ptr, k as c_int, in_sync(e, k) as c_int);
		printf("select %d %d\n".ptr, k as c_int, in_select(e, k) as c_int);
		printf("generic %d %d\n".ptr, k as c_int, in_generic<i32>(e, k) as c_int);
		printf("nested %d %d\n".ptr, k as c_int, outer.go(e, k) as c_int);
	}
	delete(e.gate);
	free(e);
	delete(task);
	return 0;
}
