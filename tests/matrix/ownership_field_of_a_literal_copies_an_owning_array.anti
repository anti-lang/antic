//! A field that holds an array of owning values, named in the literal of
//! another object. The field keeps its value, and the literal would hold a
//! second owner.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

class Holder
{
	pub held: [2]Key,
}

fn main() -> int
{
	let h = Holder { held: row(1) };
	let other = Holder { held: h.held };
	return 0;
}
