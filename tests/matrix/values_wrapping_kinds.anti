	const F9: i16 = -7 +% 2;
	let r9: i16 = (-7 ^ z) +% (2 ^ z);
	printf("add_wrap i16 -7 2 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i16 = 7 +% -2;
