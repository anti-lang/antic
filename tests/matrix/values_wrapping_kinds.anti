	printf("mul_wrap byte 0 0 = %llu %llu\n".ptr, F26 as u64, r26 as u64);
	const F27: byte = 0 *% 1;
	let r27: byte = (0 ^ z) *% (1 ^ z);
	printf("mul_wrap byte 0 1 = %llu %llu\n".ptr, F27 as u64, r27 as u64);
	const F28: byte = 1 *% 255;
	let r28: byte = (1 ^ z) *% (255 ^ z);
	printf("mul_wrap byte 1 255 = %llu %llu\n".ptr, F28 as u64, r28 as u64);
	const F29: byte = 254 *% 255;
	let r29: byte = (254 ^ z) *% (255 ^ z);
	printf("mul_wrap byte 254 255 = %llu %llu\n".ptr, F29 as u64, r29 as u64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	on_i8(zero as i8);
	on_i16(zero as i16);
	on_i32(zero as i32);
	on_i64(zero as i64);
	on_int(zero as int);
	on_u8(zero as u8);
	on_u16(zero as u16);
	on_u32(zero as u32);
	on_u64(zero as u64);
	on_uint(zero as uint);
	on_byte(zero as byte);
	return 0;
}
