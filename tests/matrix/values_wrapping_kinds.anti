	const F14: byte = 255 -% 2;
	let r14: byte = (255 ^ z) -% (2 ^ z);
	printf("sub_wrap byte 255 2 = %llu %llu\n".ptr, F14 as u64, r14 as u64);
	const F15: byte = 7 -% 2;
	let r15: byte = (7 ^ z) -% (2 ^ z);
	printf("sub_wrap byte 7 2 = %llu %llu\n".ptr, F15 as u64, r15 as u64);
	const F16: byte = 0 -% 0;
	let r16: byte = (0 ^ z) -% (0 ^ z);
	printf("sub_wrap byte 0 0 = %llu %llu\n".ptr, F16 as u64, r16 as u64);
	const F17: byte = 0 -% 1;
	let r17: byte = (0 ^ z) -% (1 ^ z);
	printf("sub_wrap byte 0 1 = %llu %llu\n".ptr, F17 as u64, r17 as u64);
	const F18: byte = 1 -% 255;
	let r18: byte = (1 ^ z) -% (255 ^ z);
	printf("sub_wrap byte 1 255 = %llu %llu\n".ptr, F18 as u64, r18 as u64);
	const F19: byte = 254 -% 255;
	let r19: byte = (254 ^ z) -% (255 ^ z);
	printf("sub_wrap byte 254 255 = %llu %llu\n".ptr, F19 as u64, r19 as u64);
	const F20: byte = 255 *% 1;
	let r20: byte = (255 ^ z) *% (1 ^ z);
	printf("mul_wrap byte 255 1 = %llu %llu\n".ptr, F20 as u64, r20 as u64);
	const F21: byte = 255 *% 255;
	let r21: byte = (255 ^ z) *% (255 ^ z);
