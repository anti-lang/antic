fn on_byte(z: byte)
{
	const F0: byte = 255 +% 1;
	let r0: byte = (255 ^ z) +% (1 ^ z);
	printf("add_wrap byte 255 1 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
