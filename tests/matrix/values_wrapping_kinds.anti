	const F9: byte = 254 +% 255;
	let r9: byte = (254 ^ z) +% (255 ^ z);
	printf("add_wrap byte 254 255 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
	const F10: byte = 255 -% 1;
	let r10: byte = (255 ^ z) -% (1 ^ z);
	printf("sub_wrap byte 255 1 = %llu %llu\n".ptr, F10 as u64, r10 as u64);
	const F11: byte = 255 -% 255;
	let r11: byte = (255 ^ z) -% (255 ^ z);
	printf("sub_wrap byte 255 255 = %llu %llu\n".ptr, F11 as u64, r11 as u64);
	const F12: byte = 0 -% 1;
	let r12: byte = (0 ^ z) -% (1 ^ z);
	printf("sub_wrap byte 0 1 = %llu %llu\n".ptr, F12 as u64, r12 as u64);
	const F13: byte = 0 -% 255;
	let r13: byte = (0 ^ z) -% (255 ^ z);
