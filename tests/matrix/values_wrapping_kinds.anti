	let r20: i32 = (-2147483648 ^ z) -% (-1 ^ z);
	printf("sub_wrap i32 -2147483648 -1 = %lld %lld\n".ptr, F20 as int, r20 as int);
	const F21: i32 = 2147483647 -% -1;
	let r21: i32 = (2147483647 ^ z) -% (-1 ^ z);
	printf("sub_wrap i32 2147483647 -1 = %lld %lld\n".ptr, F21 as int, r21 as int);
	const F22: i32 = -7 -% 2;
	let r22: i32 = (-7 ^ z) -% (2 ^ z);
	printf("sub_wrap i32 -7 2 = %lld %lld\n".ptr, F22 as int, r22 as int);
	const F23: i32 = 7 -% -2;
	let r23: i32 = (7 ^ z) -% (-2 ^ z);
	printf("sub_wrap i32 7 -2 = %lld %lld\n".ptr, F23 as int, r23 as int);
	const F24: i32 = -1 -% -1;
	let r24: i32 = (-1 ^ z) -% (-1 ^ z);
	printf("sub_wrap i32 -1 -1 = %lld %lld\n".ptr, F24 as int, r24 as int);
	const F25: i32 = -2147483647 -% -1;
	let r25: i32 = (-2147483647 ^ z) -% (-1 ^ z);
