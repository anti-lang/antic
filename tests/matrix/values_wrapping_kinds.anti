	printf("mul_wrap byte 255 2 = %llu %llu\n".ptr, F24 as u64, r24 as u64);
	const F25: byte = 7 *% 2;
	let r25: byte = (7 ^ z) *% (2 ^ z);
	printf("mul_wrap byte 7 2 = %llu %llu\n".ptr, F25 as u64, r25 as u64);
	const F26: byte = 0 *% 0;
