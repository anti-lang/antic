	const F9: i32 = -7 +% 2;
	let r9: i32 = (-7 ^ z) +% (2 ^ z);
	printf("add_wrap i32 -7 2 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i32 = 7 +% -2;
	let r10: i32 = (7 ^ z) +% (-2 ^ z);
	printf("add_wrap i32 7 -2 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i32 = -1 +% -1;
	let r11: i32 = (-1 ^ z) +% (-1 ^ z);
	printf("add_wrap i32 -1 -1 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i32 = -2147483647 +% -1;
	let r12: i32 = (-2147483647 ^ z) +% (-1 ^ z);
	printf("add_wrap i32 -2147483647 -1 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: i32 = 2147483647 -% 1;
	let r13: i32 = (2147483647 ^ z) -% (1 ^ z);
	printf("sub_wrap i32 2147483647 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: i32 = 2147483647 -% 2147483647;
	let r14: i32 = (2147483647 ^ z) -% (2147483647 ^ z);
	printf("sub_wrap i32 2147483647 2147483647 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: i32 = -2147483648 -% 1;
	let r15: i32 = (-2147483648 ^ z) -% (1 ^ z);
	printf("sub_wrap i32 -2147483648 1 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: i32 = -2147483648 -% 2147483647;
	let r16: i32 = (-2147483648 ^ z) -% (2147483647 ^ z);
	printf("sub_wrap i32 -2147483648 2147483647 = %lld %lld\n".ptr, F16 as int, r16 as int);
