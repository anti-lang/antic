	let r30: i16 = (32767 ^ z) *% (2 ^ z);
	printf("mul_wrap i16 32767 2 = %lld %lld\n".ptr, F30 as int, r30 as int);
	const F31: i16 = 7 *% 2;
	let r31: i16 = (7 ^ z) *% (2 ^ z);
	printf("mul_wrap i16 7 2 = %lld %lld\n".ptr, F31 as int, r31 as int);
	const F32: i16 = -32768 *% -32768;
	let r32: i16 = (-32768 ^ z) *% (-32768 ^ z);
	printf("mul_wrap i16 -32768 -32768 = %lld %lld\n".ptr, F32 as int, r32 as int);
	const F33: i16 = -32768 *% -1;
	let r33: i16 = (-32768 ^ z) *% (-1 ^ z);
	printf("mul_wrap i16 -32768 -1 = %lld %lld\n".ptr, F33 as int, r33 as int);
	const F34: i16 = 32767 *% -1;
	let r34: i16 = (32767 ^ z) *% (-1 ^ z);
	printf("mul_wrap i16 32767 -1 = %lld %lld\n".ptr, F34 as int, r34 as int);
	const F35: i16 = -7 *% 2;
	let r35: i16 = (-7 ^ z) *% (2 ^ z);
	printf("mul_wrap i16 -7 2 = %lld %lld\n".ptr, F35 as int, r35 as int);
	const F36: i16 = 7 *% -2;
	let r36: i16 = (7 ^ z) *% (-2 ^ z);
	printf("mul_wrap i16 7 -2 = %lld %lld\n".ptr, F36 as int, r36 as int);
	const F37: i16 = -1 *% -1;
	let r37: i16 = (-1 ^ z) *% (-1 ^ z);
	printf("mul_wrap i16 -1 -1 = %lld %lld\n".ptr, F37 as int, r37 as int);
	const F38: i16 = -32767 *% -1;
	let r38: i16 = (-32767 ^ z) *% (-1 ^ z);
	printf("mul_wrap i16 -32767 -1 = %lld %lld\n".ptr, F38 as int, r38 as int);
}

fn on_i32(z: i32)
{
	const F0: i32 = 2147483647 +% 1;
	let r0: i32 = (2147483647 ^ z) +% (1 ^ z);
	printf("add_wrap i32 2147483647 1 = %lld %lld\n".ptr, F0 as int, r0 as int);
	const F1: i32 = 2147483647 +% 2147483647;
	let r1: i32 = (2147483647 ^ z) +% (2147483647 ^ z);
	printf("add_wrap i32 2147483647 2147483647 = %lld %lld\n".ptr, F1 as int, r1 as int);
	const F2: i32 = -2147483648 +% 1;
	let r2: i32 = (-2147483648 ^ z) +% (1 ^ z);
	printf("add_wrap i32 -2147483648 1 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: i32 = -2147483648 +% 2147483647;
