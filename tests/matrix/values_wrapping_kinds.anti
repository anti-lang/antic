	printf("add_wrap i16 -1 -1 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i16 = -32767 +% -1;
	let r12: i16 = (-32767 ^ z) +% (-1 ^ z);
	printf("add_wrap i16 -32767 -1 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: i16 = 32767 -% 1;
	let r13: i16 = (32767 ^ z) -% (1 ^ z);
	printf("sub_wrap i16 32767 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: i16 = 32767 -% 32767;
	let r14: i16 = (32767 ^ z) -% (32767 ^ z);
	printf("sub_wrap i16 32767 32767 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: i16 = -32768 -% 1;
	let r15: i16 = (-32768 ^ z) -% (1 ^ z);
	printf("sub_wrap i16 -32768 1 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: i16 = -32768 -% 32767;
	let r16: i16 = (-32768 ^ z) -% (32767 ^ z);
	printf("sub_wrap i16 -32768 32767 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: i16 = 32767 -% 2;
	let r17: i16 = (32767 ^ z) -% (2 ^ z);
	printf("sub_wrap i16 32767 2 = %lld %lld\n".ptr, F17 as int, r17 as int);
	const F18: i16 = 7 -% 2;
	let r18: i16 = (7 ^ z) -% (2 ^ z);
	printf("sub_wrap i16 7 2 = %lld %lld\n".ptr, F18 as int, r18 as int);
	const F19: i16 = -32768 -% -32768;
	let r19: i16 = (-32768 ^ z) -% (-32768 ^ z);
	printf("sub_wrap i16 -32768 -32768 = %lld %lld\n".ptr, F19 as int, r19 as int);
	const F20: i16 = -32768 -% -1;
	let r20: i16 = (-32768 ^ z) -% (-1 ^ z);
	printf("sub_wrap i16 -32768 -1 = %lld %lld\n".ptr, F20 as int, r20 as int);
	const F21: i16 = 32767 -% -1;
	let r21: i16 = (32767 ^ z) -% (-1 ^ z);
	printf("sub_wrap i16 32767 -1 = %lld %lld\n".ptr, F21 as int, r21 as int);
	const F22: i16 = -7 -% 2;
	let r22: i16 = (-7 ^ z) -% (2 ^ z);
	printf("sub_wrap i16 -7 2 = %lld %lld\n".ptr, F22 as int, r22 as int);
	const F23: i16 = 7 -% -2;
	let r23: i16 = (7 ^ z) -% (-2 ^ z);
	printf("sub_wrap i16 7 -2 = %lld %lld\n".ptr, F23 as int, r23 as int);
	const F24: i16 = -1 -% -1;
