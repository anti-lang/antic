	printf("sub_wrap i16 -32767 -1 = %lld %lld\n".ptr, F25 as int, r25 as int);
	const F26: i16 = 32767 *% 1;
	let r26: i16 = (32767 ^ z) *% (1 ^ z);
	printf("mul_wrap i16 32767 1 = %lld %lld\n".ptr, F26 as int, r26 as int);
	const F27: i16 = 32767 *% 32767;
	let r27: i16 = (32767 ^ z) *% (32767 ^ z);
	printf("mul_wrap i16 32767 32767 = %lld %lld\n".ptr, F27 as int, r27 as int);
	const F28: i16 = -32768 *% 1;
	let r28: i16 = (-32768 ^ z) *% (1 ^ z);
	printf("mul_wrap i16 -32768 1 = %lld %lld\n".ptr, F28 as int, r28 as int);
	const F29: i16 = -32768 *% 32767;
	let r29: i16 = (-32768 ^ z) *% (32767 ^ z);
	printf("mul_wrap i16 -32768 32767 = %lld %lld\n".ptr, F29 as int, r29 as int);
