fn main() -> int
{
	let one = 1;
	let two = 2;
	let numbers = [1, 2, 3, 4];
	let c1 = chan int(1);
	let c2 = chan int(1);
	send(c1, 31);
	send(c2, 32);
	let counter_a = alloc Counter { n: 3 };
	let counter_b = alloc Counter { n: 4 };
	let gauge_a = alloc Gauge { };
	let gauge_b = alloc Gauge { };
	gauge_a.n.store(5);
	gauge_b.n.store(6);
	let tag_a = alloc Tag { n: 7 };
	let tag_b = alloc Tag { n: 8 };
	seen_i8(0, -3, 5);
	seen_i8(1, -3, 5);
	seen_i8(2, -3, 5);
	seen_i16(0, -300, 500);
	seen_i16(1, -300, 500);
	seen_i16(2, -300, 500);
	seen_i32(0, 70000, -5);
	seen_i32(1, 70000, -5);
	seen_i32(2, 70000, -5);
	seen_i64(0, 5000000000, 6);
	seen_i64(1, 5000000000, 6);
	seen_i64(2, 5000000000, 6);
	seen_int(0, 6, 7);
	seen_int(1, 6, 7);
	seen_int(2, 6, 7);
	seen_u8(0, 200, 5);
	seen_u8(1, 200, 5);
	seen_u8(2, 200, 5);
	seen_u16(0, 60000, 5);
	seen_u16(1, 60000, 5);
	seen_u16(2, 60000, 5);
	seen_u32(0, 4000000000, 5);
	seen_u32(1, 4000000000, 5);
	seen_u32(2, 4000000000, 5);
	seen_u64(0, 8, 9);
	seen_u64(1, 8, 9);
	seen_u64(2, 8, 9);
	seen_uint(0, 9, 10);
	seen_uint(1, 9, 10);
	seen_uint(2, 9, 10);
	seen_byte(0, 10, 11);
	seen_byte(1, 10, 11);
	seen_byte(2, 10, 11);
	seen_f32(0, 1.5, 2.5);
	seen_f32(1, 1.5, 2.5);
	seen_f32(2, 1.5, 2.5);
	seen_f64(0, 2.25, 3.5);
	seen_f64(1, 2.25, 3.5);
	seen_f64(2, 2.25, 3.5);
	seen_bool(0, true, false);
	seen_bool(1, true, false);
	seen_bool(2, true, false);
	seen_char(0, 'x', 'y');
	seen_char(1, 'x', 'y');
	seen_char(2, 'x', 'y');
	seen_str(0, "four", "sevens");
	seen_str(1, "four", "sevens");
	seen_str(2, "four", "sevens");
	seen_slice(0, numbers[0..2], numbers[0..3]);
	seen_slice(1, numbers[0..2], numbers[0..3]);
	seen_slice(2, numbers[0..2], numbers[0..3]);
	seen_array(0, [1, 2, 3], [4, 5, 6]);
	seen_array(1, [1, 2, 3], [4, 5, 6]);
	seen_array(2, [1, 2, 3], [4, 5, 6]);
	seen_pointer(0, &one, &two);
	seen_pointer(1, &one, &two);
	seen_pointer(2, &one, &two);
	seen_tuple(0, (1, 2), (3, 4));
	seen_tuple(1, (1, 2), (3, 4));
	seen_tuple(2, (1, 2), (3, 4));
	seen_struct(0, Point { x: 1, y: 2 }, Point { x: 3, y: 4 });
	seen_struct(1, Point { x: 1, y: 2 }, Point { x: 3, y: 4 });
	seen_struct(2, Point { x: 1, y: 2 }, Point { x: 3, y: 4 });
	seen_packed(0, Record { tag: 1, n: 2 }, Record { tag: 3, n: 4 });
	seen_packed(1, Record { tag: 1, n: 2 }, Record { tag: 3, n: 4 });
	seen_packed(2, Record { tag: 1, n: 2 }, Record { tag: 3, n: 4 });
	seen_simd(0, Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 4.0 }, Vec4 { x: 5.0, y: 6.0, z: 7.0, w: 8.0 });
	seen_simd(1, Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 4.0 }, Vec4 { x: 5.0, y: 6.0, z: 7.0, w: 8.0 });
	seen_simd(2, Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 4.0 }, Vec4 { x: 5.0, y: 6.0, z: 7.0, w: 8.0 });
	seen_union(0, Word { n: 7 }, Word { n: 8 });
	seen_union(1, Word { n: 7 }, Word { n: 8 });
	seen_union(2, Word { n: 7 }, Word { n: 8 });
	seen_enum(0, Level.High, Level.Low);
	seen_enum(1, Level.High, Level.Low);
	seen_enum(2, Level.High, Level.Low);
	seen_variant(0, Shape.Circle { r: 3 }, Shape.Empty);
	seen_variant(1, Shape.Circle { r: 3 }, Shape.Empty);
	seen_variant(2, Shape.Circle { r: 3 }, Shape.Empty);
	seen_function(0, twice, thrice);
	seen_function(1, twice, thrice);
	seen_function(2, twice, thrice);
	seen_failing(0, failing, passing);
	seen_failing(1, failing, passing);
	seen_failing(2, failing, passing);
	seen_channel(0, c1, c2);
	seen_channel(1, c1, c2);
	seen_channel(2, c1, c2);
	seen_class(0, Plain { n: 11 }, Plain { n: 12 });
	seen_class(1, Plain { n: 11 }, Plain { n: 12 });
	seen_class(2, Plain { n: 11 }, Plain { n: 12 });
	seen_synchronized(0, counter_a, counter_b);
	seen_synchronized(1, counter_a, counter_b);
	seen_synchronized(2, counter_a, counter_b);
	seen_concurrent(0, gauge_a, gauge_b);
	seen_concurrent(1, gauge_a, gauge_b);
	seen_concurrent(2, gauge_a, gauge_b);
	seen_interface(0, tag_a, tag_b);
	seen_interface(1, tag_a, tag_b);
	seen_interface(2, tag_a, tag_b);
	delete(tag_b);
	delete(tag_a);
	delete(gauge_b);
	delete(gauge_a);
	delete(counter_b);
	delete(counter_a);
	delete(c2);
	delete(c1);
	return 0;
}

type Op = fn(int) -> int;

type Risky = fn(int) -> int may fail;
