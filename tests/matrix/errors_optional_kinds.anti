	let o = opt_function(k, a) catch {
		yield b;
	};
	let first = -99;
	if let v = o {
		first = (v(5) as c_int) as int;
	}
	let second = -99;
	let p = opt_function(k, a) catch none;
	let w = p else {
		printf("function value %d: %d none\n".ptr, k as c_int, first as c_int);
		return;
