//! A `may fail` function that gives a `?T`, for each kind of `T`. Its call
//! fails, gives `none` or gives a value. A handler yields another value for the
//! failure and `if let` binds what is there. `catch none` counts the failure as
//! `none`, and `let ... else` binds the value or leaves. Each line prints both
//! for one of the three outcomes.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

struct Point
{
	x: int,
	y: int,
}

packed struct Record
{
	tag: u8,
	n: int,
}

simd struct Vec4 { x: f32, y: f32, z: f32, w: f32 }

union Word
{
	n: int,
	f: f32,
}

enum Level
{
	Low,
	High,
}

variant Shape
{
	Circle { r: int },
	Empty,
}

synchronized class Counter
{
	pub n: int = 0,

	pub fn get(self) -> int
	{
		return self.n;
	}
}

concurrent class Gauge
{
	pub atomic n: int = 0,
}

abstract class Named
{
	pub abstract fn id(self) -> int;
}

class Tag inherits Named
{
	pub n: int = 0,

	pub concrete fn id(self) -> int
	{
		return self.n;
	}
}

class Plain
{
	pub n: int = 0,
}

fn twice(n: int) -> int
{
	return n * 2;
}

fn thrice(n: int) -> int
{
	return n * 3;
}

fn failing(n: int) -> int may fail
{
	if n > 0 {
		fail "refused";
	}
	return n + 100;
}

fn passing(n: int) -> int may fail
{
	if n < 0 {
		fail "refused";
	}
	return n + 200;
}

fn result_of(f: fn(int) -> int may fail) -> int
{
	let got = f(0) catch {
		yield -1;
	};
	return got;
}

fn mark_of(c: chan int) -> int
{
	let p = recv(c) else {
		return -1;
	};
	let mark = *p;
	send(c, mark);
	return mark;
}

fn pointee(p: ?*int) -> int
{
	if let q = p {
		return *q;
	}
	return -7;
}

fn opt_i8(k: int, v: i8) -> ?i8 may fail
{
	if k == 0 {
		fail "no i8";
	}
	if k == 1 {
		return none;
	}
	return v;
}

fn seen_i8(k: int, a: i8, b: i8)
{
	let o = opt_i8(k, a) catch {
		yield b;
	};
	let first = -99;
	if let v = o {
		first = (v as c_int) as int;
	}
	let second = -99;
	let p = opt_i8(k, a) catch none;
	let w = p else {
		printf("i8 %d: %d none\n".ptr, k as c_int, first as c_int);
		return;
	};
	second = (w as c_int) as int;
	printf("i8 %d: %d %d\n".ptr, k as c_int, first as c_int,
		second as c_int);
}

