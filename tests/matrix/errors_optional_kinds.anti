		second as c_int);
}

fn opt_failing(k: int, keep v: Risky) -> ?Risky may fail
{
	if k == 0 {
		fail "no may-fail function value";
	}
	if k == 1 {
		return none;
	}
	return v;
}

fn seen_failing(k: int, keep a: Risky, keep b: Risky)
{
	let o = opt_failing(k, a) catch {
		yield b;
	};
	let first = -99;
	if let v = o {
		first = (result_of(v) as c_int) as int;
	}
	let second = -99;
	let p = opt_failing(k, a) catch none;
	let w = p else {
		printf("may-fail function value %d: %d none\n".ptr, k as c_int, first as c_int);
		return;
	};
	second = (result_of(w) as c_int) as int;
	printf("may-fail function value %d: %d %d\n".ptr, k as c_int, first as c_int,
		second as c_int);
}

