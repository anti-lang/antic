	let p = opt_enum(k, a) catch none;
	let w = p else {
		printf("enum %d: %d none\n".ptr, k as c_int, first as c_int);
		return;
	};
	second = (w as c_int) as int;
	printf("enum %d: %d %d\n".ptr, k as c_int, first as c_int,
		second as c_int);
}

fn opt_variant(k: int, v: Shape) -> ?Shape may fail
{
	if k == 0 {
		fail "no variant";
	}
	if k == 1 {
		return none;
	}
	return v;
}

fn seen_variant(k: int, a: Shape, b: Shape)
{
	let o = opt_variant(k, a) catch {
		yield b;
	};
	let first = -99;
	if let v = o {
		first = ((v is Shape.Circle) as c_int) as int;
	}
	let second = -99;
	let p = opt_variant(k, a) catch none;
	let w = p else {
		printf("variant %d: %d none\n".ptr, k as c_int, first as c_int);
		return;
	};
	second = ((w is Shape.Circle) as c_int) as int;
	printf("variant %d: %d %d\n".ptr, k as c_int, first as c_int,
		second as c_int);
}

