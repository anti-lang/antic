//! A field of a struct literal refuses a function whose parameter is `own` and
//! needs a teardown, by "Answers of 2026-11-13".

class Key
{
	pub n: int = 0,

	fn destruct(self)
	{
	}
}

struct Ops
{
	f: fn(Key) -> int,
}

fn take(own k: Key) -> int
{
	return k.n;
}

fn main() -> int
{
	let ops = Ops { f: take };
	return 0;
}
