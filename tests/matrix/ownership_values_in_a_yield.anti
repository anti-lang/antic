//! `yield` of each kind of owning value: the handler of a call that failed
//! gives a fresh value, the call that did not fail gives its own, and a
//! statement that drops the result tears down what the handler gave. Each line
//! prints the values and the values alive. A failing function that gives an
//! owning variant has a program of its own.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Counted
{
	pub n: int = 0,

	static atomic live: int = 0;

	fn construct(self)
	{
		Counted.live.add(1);
	}

	fn destruct(self)
	{
		Counted.live.sub(1);
	}
}

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,

	static atomic live: int = 0;

	fn construct(self)
	{
		Key.live.add(1);
	}

	fn destruct(self)
	{
		Key.live.sub(1);
	}
}

struct Pair
{
	k: Key,
	n: int,
}

variant Shape
{
	Keyed { k: Key },
	Empty,
}

fn counted(n: int) -> Counted
{
	return Counted { n: n };
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn shape(n: int) -> Shape
{
	return Shape.Keyed { k: key(n) };
}

fn maybe(n: int) -> ?Key
{
	return key(n);
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

/// The values alive now. A copy that `dup` made runs no `construct`, so the
/// program counts it with `copies`.
fn alive() -> c_int
{
	return (Key.live.load() + Counted.live.load()) as c_int;
}

/// Count `n` more values alive, for a copy.
fn copies(n: int)
{
	Key.live.add(n);
}

fn failing_counted(n: int) -> Counted may fail
{
	if n > 0 {
		fail "refused";
	}
	return counted(n);
}

fn in_counted()
{
	let a = failing_counted(1) catch e {
		yield counted(5);
	};
	let b = failing_counted(0) catch e {
		yield counted(6);
	};
	printf("yield of a class with a destruct: %d %d, alive %d\n".ptr, a.n as c_int, b.n as c_int, alive());
	failing_counted(1) catch e {
		yield counted(7);
	};
	failing_counted(0) catch e {
		yield counted(8);
	};
	printf("yield of a class with a destruct dropped: alive %d\n".ptr, alive());
}

fn failing_key(n: int) -> Key may fail
{
	if n > 0 {
		fail "refused";
	}
	return key(n);
}

fn in_key()
{
	let a = failing_key(1) catch e {
		yield key(5);
	};
	let b = failing_key(0) catch e {
		yield key(6);
	};
	printf("yield of a class with an own field: %d %d, alive %d\n".ptr, a.n as c_int, b.n as c_int, alive());
	failing_key(1) catch e {
		yield key(7);
	};
	failing_key(0) catch e {
		yield key(8);
	};
	printf("yield of a class with an own field dropped: alive %d\n".ptr, alive());
}

fn failing_pair(n: int) -> Pair may fail
{
	if n > 0 {
		fail "refused";
	}
	return pair(n);
}

fn in_pair()
{
	let a = failing_pair(1) catch e {
		yield pair(5);
	};
	let b = failing_pair(0) catch e {
		yield pair(6);
	};
	printf("yield of an owning struct: %d %d, alive %d\n".ptr, a.k.n as c_int, b.k.n as c_int, alive());
	failing_pair(1) catch e {
		yield pair(7);
	};
	failing_pair(0) catch e {
		yield pair(8);
	};
	printf("yield of an owning struct dropped: alive %d\n".ptr, alive());
}

fn failing_tuple(n: int) -> (Key, int) may fail
{
	if n > 0 {
		fail "refused";
	}
	return tuple(n);
}

fn in_tuple()
{
	let a = failing_tuple(1) catch e {
		yield tuple(5);
	};
	let b = failing_tuple(0) catch e {
		yield tuple(6);
	};
	printf("yield of an owning tuple: %d %d, alive %d\n".ptr, a.0.n as c_int, b.0.n as c_int, alive());
	failing_tuple(1) catch e {
		yield tuple(7);
	};
	failing_tuple(0) catch e {
		yield tuple(8);
	};
	printf("yield of an owning tuple dropped: alive %d\n".ptr, alive());
}

fn failing_maybe(n: int) -> ?Key may fail
{
	if n > 0 {
		fail "refused";
	}
	return maybe(n);
}

fn in_maybe()
{
	let a = failing_maybe(1) catch e {
		yield maybe(5);
	};
	let b = failing_maybe(0) catch e {
		yield maybe(6);
	};
	printf("yield of an owning optional: %d %d, alive %d\n".ptr, (a != none) as int as c_int, (b != none) as int as c_int, alive());
	failing_maybe(1) catch e {
		yield maybe(7);
	};
	failing_maybe(0) catch e {
		yield maybe(8);
	};
	printf("yield of an owning optional dropped: alive %d\n".ptr, alive());
}

fn failing_row(n: int) -> [2]Key may fail
{
	if n > 0 {
		fail "refused";
	}
	return row(n);
}

fn in_row()
{
	let a = failing_row(1) catch e {
		yield row(5);
	};
	let b = failing_row(0) catch e {
		yield row(6);
	};
	printf("yield of an owning array: %d %d, alive %d\n".ptr, a[0].n as c_int, b[0].n as c_int, alive());
	failing_row(1) catch e {
		yield row(7);
	};
	failing_row(0) catch e {
		yield row(8);
	};
	printf("yield of an owning array dropped: alive %d\n".ptr, alive());
}

fn main() -> int
{
	in_counted();
	in_key();
	in_pair();
	in_tuple();
	in_maybe();
	in_row();
	printf("at the end: alive %d\n".ptr, alive());
	return 0;
}
