//! A move of an owning local inside a loop that stands around its declaration
//! is refused: the second turn would use the moved value.

class Texture
{
	pub id: int = 0,

	fn destruct(self)
	{
	}
}

fn take(own t: Texture)
{
}

fn main() -> int
{
	let t = Texture { id: 7 };
	for i in 0..3 {
		take(t);
	}
	return 0;
}
