//! A local that holds a variant with an owning case, named in an array literal.
//! An element of an array literal is a copy, and the local would stay a second
//! owner.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

variant Shape
{
	Keyed { k: Key },
	Empty,
}

fn shape(n: int) -> Shape
{
	return Shape.Keyed { k: key(n) };
}

fn main() -> int
{
	let a = shape(1);
	let xs = [a, shape(2)];
	return 0;
}
