//! An element of an array that holds a variant with an owning case, named in an
//! array literal. The element stays where it is, so the literal would hold a
//! copy and the array would stay a second owner. A local moves there, by R079
//! of "Rules of 2026-10-13".

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

variant Shape
{
	Keyed { k: Key },
	Empty,
}

fn shape(n: int) -> Shape
{
	return Shape.Keyed { k: key(n) };
}

fn main() -> int
{
	let held = [shape(1), shape(2)];
	let xs = [held[0], shape(3)];
	return 0;
}
