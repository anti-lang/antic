//! `send` of a local that holds a variant with an owning case. The channel
//! would hold a copy, and the local would stay a second owner.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

variant Shape
{
	Keyed { k: Key },
	Empty,
}

fn shape(n: int) -> Shape
{
	return Shape.Keyed { k: key(n) };
}

fn main() -> int
{
	let c = chan Shape(1);
	let a = shape(1);
	send(c, a);
	delete(c);
	return 0;
}
