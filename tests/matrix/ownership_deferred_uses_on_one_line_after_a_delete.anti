//! A `defer` that reads two deleted objects on one line, in a function with two
//! exits. Each use gets its message once, at its own column.

extern fn printf(format: ?*byte, ...) -> c_int;

class Box
{
	pub n: int = 0,
}

fn show(n: int)
{
	printf("%d\n".ptr, n as c_int);
}

fn run(k: int) -> int
{
	let a = alloc Box { n: 1 };
	let b = alloc Box { n: 2 };
	defer { show(a.n); show(b.n); }
	delete(a);
	delete(b);
	if k > 0 {
		return 1;
	}
	return 0;
}

fn main() -> int
{
	return run(0);
}
