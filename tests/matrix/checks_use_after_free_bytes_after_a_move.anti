//! E2 at `p as *byte`: the bytes of an object are read after `destroy`, and a
//! move left no memory of the program's there, so the conversion after it is
//! refused.

class Node
{
	pub n: int = 0,
}

fn take(own p: *Node)
{
	delete(p);
}

fn main() -> int
{
	let p = alloc Node { n: 3 };
	take(p);
	let bytes = p as *byte;
	return 0;
}
