//! The `changed` hook under `--trace writes` on a class with a `transient`
//! field: a write to the field before it calls the hook, and a write to the
//! `transient` field calls none, since the field list holds no record of it.
//! Without `--trace writes` the program prints the values alone.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

trace class Flags
{
	pub plain: int = 0,
	transient cache: ?*int = none,

	pub fn keep(self, at: ?*int)
	{
		self.cache = at;
	}

	pub fn kept(self) -> int
	{
		if let at = self.cache {
			return *at;
		}
		return 0;
	}
}

class Watch inherits lang.TraceHandler
{
	concrete fn created(self, o: *Object) { }

	concrete fn destroyed(self, o: *Object) { }

	concrete fn copied(self, o: *Object, from: *Object) { }

	concrete fn dispatched(self, o: *Object) { }

	concrete fn joined(self, o: *Object) { }

	concrete fn enter(self, o: *Object, name: str) { }

	concrete fn leave(self, o: *Object, name: str) { }

	concrete fn failed(self, o: *Object, name: str, e: *lang.Error) { }

	concrete fn changed(self, o: *Object, field: *FieldDescriptor)
	{
		printf("changed %.*s\n".ptr, field.name.len as c_int, field.name.ptr);
	}
}

fn main() -> int
{
	let watch = alloc Watch { };
	lang.Trace.install(watch);

	let flags = alloc Flags { };
	let seven = 7;
	flags.plain = 1;
	flags.keep(&seven);
	printf("fields %d %d\n".ptr, flags.plain as c_int, flags.kept() as c_int);

	lang.Trace.install(none);
	delete(flags);
	delete(watch);
	return 0;
}
