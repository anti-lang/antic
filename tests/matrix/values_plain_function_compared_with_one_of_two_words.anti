//! A local that a named function initialises holds the plain form of its type,
//! and a parameter of function type the form of two words. `==` compares
//! function values of one form, so the two are refused. Both forms have the
//! name `fn(int) -> int`, so the message names the forms as well.

fn twice(n: int) -> int
{
	return n * 2;
}

fn same(p: fn(int) -> int) -> bool
{
	let g: fn(int) -> int = twice;
	return g == p;
}

fn main() -> int
{
	if same(twice) {
		return 1;
	}
	return 0;
}
