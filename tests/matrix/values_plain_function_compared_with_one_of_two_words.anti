//! A local that a named function initialises holds the plain form of its type,
//! and a parameter of function type the form of two words. `==` and `!=`
//! compare the two by their code, on either side, by C of "Answers of
//! 2026-11-19".

extern fn printf(format: ?*byte, ...) -> c_int;

fn twice(n: int) -> int
{
	return n * 2;
}

fn thrice(n: int) -> int
{
	return n * 3;
}

fn same(p: fn(int) -> int) -> bool
{
	let g: fn(int) -> int = twice;
	return g == p;
}

fn other(p: fn(int) -> int) -> bool
{
	let g: fn(int) -> int = twice;
	return p != g;
}

fn main() -> int
{
	printf("twice %d %d\n".ptr, same(twice) as c_int, other(twice) as c_int);
	printf("thrice %d %d\n".ptr, same(thrice) as c_int, other(thrice) as c_int);
	return 0;
}
