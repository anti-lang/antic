//! A pointer to a guarded field that was taken inside the `sync` on its lock is
//! used in the block that took it, in a block inside it as well. A variable
//! that names another place since is used anywhere.

extern fn printf(format: ?*byte, ...) -> c_int;

concurrent class Tally
{
	lock: Mutex,
	size: int = 0 guarded by lock,

	pub fn in_its_block(self) -> int
	{
		sync self.lock {
			let p = &self.size;
			*p += 1;
			return *p;
		}
	}

	pub fn in_a_block_inside(self, more: bool) -> int
	{
		sync self.lock {
			let p = &self.size;
			if more {
				*p += 10;
			}
			return *p;
		}
	}

	pub fn named_again(self) -> int
	{
		let other = 100;
		let p = &other;
		sync self.lock {
			p = &self.size;
			*p += 1;
		}
		p = &other;
		return *p;
	}
}

fn main() -> int
{
	let t = alloc Tally { };
	printf("in its block: %d\n".ptr, t.in_its_block() as c_int);
	printf("in a block inside: %d\n".ptr, t.in_a_block_inside(true) as c_int);
	printf("named again: %d\n".ptr, t.named_again() as c_int);
	delete(t);
	return 0;
}
