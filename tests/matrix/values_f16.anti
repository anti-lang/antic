//! An `f16` is storage: a local, a field, an element of an array, of a slice
//! and of a tuple, and the value behind a pointer. A read gives an `f32` and
//! `as f16` makes the value a write takes. The conversion rounds to the nearest
//! half, a tie to the even one. Past the greatest half it gives an infinity and
//! below the smallest it gives zero. The first value of a rounding line is
//! folded in a constant, and the second is computed.

extern fn printf(format: ?*byte, ...) -> c_int;

struct Sample
{
	level: f16,
	count: int,
}

const EXACT: f16 = 1.5 as f16;
const TIE_DOWN: f16 = 1.00048828125 as f16;
const TIE_UP: f16 = 1.00146484375 as f16;
const GREATEST: f16 = 65504.0 as f16;
const BELOW_INF: f16 = 65519.0 as f16;
const TO_INF: f16 = 65520.0 as f16;
const TO_NEG_INF: f16 = -65520.0 as f16;
const SMALLEST: f16 = 5.9604645e-8 as f16;
const TIE_TO_ZERO: f16 = 2.9802322e-8 as f16;
const ABOVE_THE_TIE: f16 = 3.0e-8 as f16;
const TO_ZERO: f16 = 1.0e-8 as f16;
const NEG_ZERO: f16 = -0.0 as f16;
const TENTH: f16 = 0.1 as f16;

fn rounding(one: f32)
{
	let exact: f16 = (1.5 * one) as f16;
	let tie_down: f16 = (1.00048828125 * one) as f16;
	let tie_up: f16 = (1.00146484375 * one) as f16;
	let greatest: f16 = (65504.0 * one) as f16;
	let below_inf: f16 = (65519.0 * one) as f16;
	let to_inf: f16 = (65520.0 * one) as f16;
	let to_neg_inf: f16 = (-65520.0 * one) as f16;
	let smallest: f16 = (5.9604645e-8 * one) as f16;
	let tie_to_zero: f16 = (2.9802322e-8 * one) as f16;
	let above_the_tie: f16 = (3.0e-8 * one) as f16;
	let to_zero: f16 = (1.0e-8 * one) as f16;
	let neg_zero: f16 = (-0.0 * one) as f16;
	let tenth: f16 = (0.1 * one) as f16;
	let nan: f16 = ((one - one) / (one - one)) as f16;
	printf("exact %.17g %.17g\n".ptr, EXACT as f64, exact as f64);
	printf("tie down %.17g %.17g\n".ptr, TIE_DOWN as f64, tie_down as f64);
	printf("tie up %.17g %.17g\n".ptr, TIE_UP as f64, tie_up as f64);
	printf("greatest %.17g %.17g\n".ptr, GREATEST as f64, greatest as f64);
	printf("below inf %.17g %.17g\n".ptr, BELOW_INF as f64,
		below_inf as f64);
	printf("to inf %.17g %.17g\n".ptr, TO_INF as f64, to_inf as f64);
	printf("to -inf %.17g %.17g\n".ptr, TO_NEG_INF as f64,
		to_neg_inf as f64);
	printf("smallest %.17g %.17g\n".ptr, SMALLEST as f64, smallest as f64);
	printf("tie to zero %.17g %.17g\n".ptr, TIE_TO_ZERO as f64,
		tie_to_zero as f64);
	printf("above the tie %.17g %.17g\n".ptr, ABOVE_THE_TIE as f64,
		above_the_tie as f64);
	printf("to zero %.17g %.17g\n".ptr, TO_ZERO as f64, to_zero as f64);
	printf("-0 %.17g %.17g\n".ptr, NEG_ZERO as f64, neg_zero as f64);
	printf("tenth %.17g %.17g\n".ptr, TENTH as f64, tenth as f64);
	let read = nan;
	printf("nan %d\n".ptr, (read != read) as c_int);
}

fn storage(one: f32)
{
	let local: f16 = (0.25 * one) as f16;
	let sample = Sample { level: (0.5 * one) as f16, count: 2 };
	let row: [3]f16 = [1.0 as f16, 2.0 as f16, (4.0 * one) as f16];
	let part = row[1..3];
	let pair: (f16, int) = (8.0 as f16, 1);
	let p = &local;
	*p = (*p * 3.0) as f16;
	sample.level = (sample.level + 1.0) as f16;
	row[0] = (row[2] * row[1]) as f16;
	printf("local %g\n".ptr, local as f64);
	printf("field %g\n".ptr, sample.level as f64);
	printf("array %g %g %g\n".ptr, row[0] as f64, row[1] as f64,
		row[2] as f64);
	printf("slice %g %lld\n".ptr, part[1] as f64, part.len);
	printf("tuple %g\n".ptr, pair.0 as f64);
	printf("pointer %g\n".ptr, *p as f64);
	printf("size %lld %lld\n".ptr, size_of(f16), size_of(Sample));
}

fn main(args: []str) -> int
{
	let one = args.len as f32;
	rounding(one);
	storage(one);
	return 0;
}
