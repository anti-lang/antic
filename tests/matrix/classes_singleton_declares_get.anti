//! A singleton class may not declare `get`, by R112 of the rules of 2026-10-13.
//! The compiler writes it.

extern fn printf(format: ?*byte, ...) -> c_int;

singleton class Config
{
	pub n: int = 0,

	pub fn get() -> int
	{
		return 41;
	}
}

fn main() -> int
{
	printf("%d\n".ptr, Config.get() as c_int);
	return 0;
}
