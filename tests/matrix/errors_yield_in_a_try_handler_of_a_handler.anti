//! A `yield` belongs to the innermost handler that holds it, by R015 of the
//! rules of 2026-10-13. In the handler of a `try` block that stands inside the
//! handler of a `let`, `yield;` ends the handler of the `try` block, and the
//! handler of the `let` goes on after the block. Both errors are deleted, which
//! the count of the errors alive shows.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Counted inherits lang.Error
{
	pub static atomic live: int = 0;

	/// An error that counts itself alive until it is deleted.
	pub fn make(code: int) -> *Counted
	{
		let e = alloc Counted { };
		e.code = code;
		e.message = "counted";
		Counted.live.add(1);
		return e;
	}

	concrete fn destruct(self)
	{
		Counted.live.sub(1);
	}
}

fn value(code: int) -> int may fail
{
	if code > 0 {
		fail Counted.make(code);
	}
	return 0;
}

fn plain(code: int) may fail
{
	if code > 0 {
		fail Counted.make(code);
	}
}

fn run(a: int, b: int) -> int
{
	let got = value(a) catch first {
		let seen = 0;
		try {
			plain(b);
		} catch second {
			seen = second.code;
			if seen > 0 {
				yield;
			}
			seen = 100;
		}
		yield first.code * 10 + seen;
	};
	return got;
}

fn main() -> int
{
	printf("%d %d %d, alive %d\n".ptr, run(0, 5) as c_int, run(3, 0) as c_int,
		run(3, 5) as c_int, Counted.live.load() as c_int);
	return 0;
}
