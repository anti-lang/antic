//! A local named after `destroy(&a)`. `destroy` of a local counts as a move:
//! the value is torn down, and the block tears it down no more.

class Key
{
	pub n: int = 0,

	fn destruct(self)
	{
	}
}

fn take(own k: Key) -> int
{
	return k.n;
}

fn main() -> int
{
	let a = Key { n: 1 };
	destroy(&a);
	return a.n;
}
