//! A generic class, a generic function, a generic variant and a generic
//! interface, each in a copy for every kind of value. A line holds the value of
//! one kind after it went through a field and `dup`, through an `own` parameter
//! and a result, through a case of the variant and through the table of the
//! interface.

extern fn printf(format: ?*byte, ...) -> c_int;

struct Pair
{
	a: int,
	b: int,
}

packed struct Packed
{
	tag: u8,
	wide: i64,
}

enum Color
{
	Red,
	Green,
}

variant Shape
{
	Circle { r: int },
	Empty,
}

simd struct Vec4
{
	x: f32,
	y: f32,
	z: f32,
	w: f32,
}

class Point
{
	pub x: int = 0,
}

abstract class Named
{
	abstract fn name(self) -> int;
}

class Twenty
{
	implements nm: Named,

	concrete fn name(self) -> int
	{
		return 20;
	}
}

fn twice(n: int) -> int
{
	return n * 2;
}

fn pass(p: *int) -> ?*int
{
	return p;
}

fn keep(p: *Point) -> *Point
{
	return p;
}

fn again(n: *Named) -> *Named
{
	return n;
}

fn radius(s: Shape) -> int
{
	let r = 0;
	switch s {
		Circle c => r = c.r,
		Empty => r = 0,
	}
	return r;
}

class Box<T>
{
	pub v: T,

	pub fn get(self) -> T
	{
		return dup(self.v);
	}
}

variant Maybe<T>
{
	Some { value: T },
	Nothing,
}

abstract class Source<T>
{
	abstract fn next(self) -> T;
}

class Fixed<T> inherits Source<T>
{
	pub v: T,

	concrete fn next(self) -> T
	{
		return dup(self.v);
	}
}

fn same<T>(own v: T) -> T
{
	return v;
}

fn kind_00(x: int, numbers: []int, point: *Point, named: *Named)
{
	let some: ?int = 13;
	let box = Box<i8> { v: 0 - 3 };
	let got = box.get();
	let through = same<i8>(0 - 3);
	let inside = 0 as c_int;
	let wrapped = Maybe<i8>.Some { value: 0 - 3 };
	switch wrapped {
		Some s => inside = s.value as c_int,
		Nothing => inside = 0 - 1,
	}
	let fixed = Fixed<i8> { v: 0 - 3 };
	let source: *Source<i8> = &fixed;
	let next = source.next();
	printf("i8: %d %d %d %d\n".ptr, got as c_int, through as c_int, inside, next as c_int);
}

