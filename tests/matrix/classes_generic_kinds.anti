	let through = same<?*int>(pass(&x));
	let inside = 0 as c_int;
	let wrapped = Maybe<?*int>.Some { value: pass(&x) };
	switch wrapped {
		Some s => inside = (s.value != none) as c_int,
		Nothing => inside = 0 - 1,
	}
	let fixed = Fixed<?*int> { v: pass(&x) };
	let source: *Source<?*int> = &fixed;
	let next = source.next();
	printf("nullable pointer: %d %d %d %d\n".ptr, (got != none) as c_int, (through != none) as c_int, inside, (next != none) as c_int);
}

