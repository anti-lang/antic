	let box = Box<Vec4> { v: Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 22.0 } };
	let got = box.get();
	let through = same<Vec4>(Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 22.0 });
	let inside = 0 as c_int;
	let wrapped = Maybe<Vec4>.Some { value: Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 22.0 } };
	switch wrapped {
		Some s => inside = s.value.w as c_int,
		Nothing => inside = 0 - 1,
	}
	let fixed = Fixed<Vec4> { v: Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 22.0 } };
	let source: *Source<Vec4> = &fixed;
	let next = source.next();
	printf("simd struct: %d %d %d %d\n".ptr, got.w as c_int, through.w as c_int, inside, next.w as c_int);
}

