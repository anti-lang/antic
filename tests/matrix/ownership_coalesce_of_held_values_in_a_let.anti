//! `a ?? b` of two locals of a class with a `destruct` as the value of a `let`.
//! The value is the one `a` or `b` holds, so the `let` would give it a second
//! owner, and it is refused as `let c = b;` is.

class Owner
{
	pub n: int = 0,

	pub fn destruct(self)
	{
	}
}

fn main() -> int
{
	let a: ?Owner = Owner { n: 1 };
	let b = Owner { n: 2 };
	let c = a ?? b;
	return c.n as int;
}
