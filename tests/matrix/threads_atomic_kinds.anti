fn of_bool(c: *Cells)
{
	let on: atomic bool = false;
	on.store(true);
	let local_swapped = on.swap(false);
	let local_joined = on.or(true);
	let local_masked = on.and(false);
	let local_first = on.compare_swap(false, true);
	let local_second = on.compare_swap(false, true);
	printf("bool local %d %d %d %d %d %d\n".ptr, local_swapped as c_int, local_joined as c_int,
		local_masked as c_int, local_first as c_int, local_second as c_int, on.load() as c_int);
	c.on.store(true);
	let field_swapped = c.on.swap(false);
	let field_joined = c.on.or(true);
	let field_masked = c.on.and(false);
	let field_first = c.on.compare_swap(false, true);
	let field_second = c.on.compare_swap(false, true);
	printf("bool field %d %d %d %d %d %d\n".ptr, field_swapped as c_int, field_joined as c_int,
		field_masked as c_int, field_first as c_int, field_second as c_int, c.on.load() as c_int);
}

fn of_char(c: *Cells)
{
	let letter: atomic char = 'a';
	letter.store('b');
	let local_swapped = letter.swap('c');
	let local_first = letter.compare_swap('c', 'd');
	let local_second = letter.compare_swap('c', 'e');
	printf("char local %u %d %d %u\n".ptr, local_swapped as u32, local_first as c_int,
		local_second as c_int, letter.load() as u32);
	c.letter.store('b');
	let field_swapped = c.letter.swap('c');
	let field_first = c.letter.compare_swap('c', 'd');
	let field_second = c.letter.compare_swap('c', 'e');
	printf("char field %u %d %d %u\n".ptr, field_swapped as u32, field_first as c_int,
		field_second as c_int, c.letter.load() as u32);
}

fn of_f16(c: *Cells)
{
	c.half.store(1.5 as f16);
	let swapped = c.half.swap(2.5 as f16);
	let first = c.half.compare_swap(2.5 as f16, 0.25 as f16);
	let second = c.half.compare_swap(2.5 as f16, 8.0 as f16);
	printf("f16 field %g %d %d %g\n".ptr, swapped as f64, first as c_int, second as c_int,
		c.half.load() as f64);
}

fn of_pointer(links: *Links, a: *int, b: *int)
{
	let p: atomic *int = a;
	p.store(b);
	let local_swapped = p.swap(a);
	let local_first = p.compare_swap(a, b);
	let local_second = p.compare_swap(a, b);
	printf("pointer local %d %d %d %d\n".ptr, *local_swapped as c_int, local_first as c_int,
		local_second as c_int, *p.load() as c_int);
	links.p.store(b);
	let field_swapped = links.p.swap(a);
	let field_first = links.p.compare_swap(a, b);
	let field_second = links.p.compare_swap(a, b);
	printf("pointer field %d %d %d %d\n".ptr, *field_swapped as c_int, field_first as c_int,
		field_second as c_int, *links.p.load() as c_int);
}

fn of_nullable_pointer(links: *Links, a: *int, b: *int)
{
	let q: atomic ?*int = none;
	let local_empty = q.load();
	q.store(b);
	let local_swapped = q.swap(none);
	let local_first = q.compare_swap(none, a);
	let local_second = q.compare_swap(none, b);
	printf("nullable_pointer local %d %d %d %d %d\n".ptr, pointee(local_empty) as c_int,
		pointee(local_swapped) as c_int, local_first as c_int, local_second as c_int,
		pointee(q.load()) as c_int);
	let field_empty = links.q.load();
	links.q.store(b);
	let field_swapped = links.q.swap(none);
	let field_first = links.q.compare_swap(none, a);
	let field_second = links.q.compare_swap(none, b);
	printf("nullable_pointer field %d %d %d %d %d\n".ptr, pointee(field_empty) as c_int,
		pointee(field_swapped) as c_int, field_first as c_int, field_second as c_int,
		pointee(links.q.load()) as c_int);
}

fn main() -> int
{
	let cells = alloc Cells { };
	let a = 10;
	let b = 20;
	let links = alloc Links { p: &a };
	of_i8(cells);
	of_i16(cells);
	of_i32(cells);
	of_i64(cells);
	of_int(cells);
	of_u8(cells);
	of_u16(cells);
	of_u32(cells);
	of_u64(cells);
	of_uint(cells);
	of_byte(cells);
	of_bool(cells);
	of_char(cells);
	of_f16(cells);
	of_pointer(links, &a, &b);
	of_nullable_pointer(links, &a, &b);
	delete(links);
	delete(cells);
	return 0;
}
