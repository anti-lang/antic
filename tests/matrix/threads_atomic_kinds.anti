//! The eight atomic operations on each kind of value an atomic holds, on a
//! field and on a local: every integer type with all eight, at the highest
//! value of its type, and a `bool`, a `char`, a pointer, a nullable pointer and
//! an `f16` field with the ones that are no arithmetic. A `bool` takes `and`
//! and `or` as well. Each line holds what the operations gave, in the order the
//! program wrote them.

extern fn printf(format: ?*byte, ...) -> c_int;

class Cells
{
	pub atomic v_i8: i8 = 0,
	pub atomic v_i16: i16 = 0,
	pub atomic v_i32: i32 = 0,
	pub atomic v_i64: i64 = 0,
	pub atomic v_int: int = 0,
	pub atomic v_u8: u8 = 0,
	pub atomic v_u16: u16 = 0,
	pub atomic v_u32: u32 = 0,
	pub atomic v_u64: u64 = 0,
	pub atomic v_uint: uint = 0,
	pub atomic v_byte: byte = 0,
	pub atomic on: bool = false,
	pub atomic letter: char = 'a',
	pub atomic half: f16 = 0.0 as f16,
}

class Links
{
	pub atomic p: *int,
	pub atomic q: ?*int = none,
}

fn pointee(p: ?*int) -> int
{
	if let q = p {
		return *q;
	}
	return -1;
}

fn of_i8(c: *Cells)
{
	let n: atomic i8 = 5;
	let local_swapped = n.swap(100);
	let local_added = n.add(27);
	let local_subtracted = n.sub(7);
	let local_masked = n.and(15);
	let local_joined = n.or(3);
	let local_first = n.compare_swap(11, -2);
	let local_second = n.compare_swap(11, 0);
	printf("i8 local %lld %lld %lld %lld %lld %d %d %lld\n".ptr, local_swapped as i64,
		local_added as i64, local_subtracted as i64, local_masked as i64, local_joined as i64,
		local_first as c_int, local_second as c_int, n.load() as i64);
	c.v_i8.store(5);
	let field_swapped = c.v_i8.swap(100);
	let field_added = c.v_i8.add(27);
	let field_subtracted = c.v_i8.sub(7);
	let field_masked = c.v_i8.and(15);
	let field_joined = c.v_i8.or(3);
	let field_first = c.v_i8.compare_swap(11, -2);
	let field_second = c.v_i8.compare_swap(11, 0);
	printf("i8 field %lld %lld %lld %lld %lld %d %d %lld\n".ptr, field_swapped as i64,
		field_added as i64, field_subtracted as i64, field_masked as i64, field_joined as i64,
		field_first as c_int, field_second as c_int, c.v_i8.load() as i64);
}

