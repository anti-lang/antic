//! `==` compares two function values of one form. A bound function and a plain
//! function value of the same parameters and result are refused.

class Shape
{
	pub n: int = 1,

	pub fn area(self) -> int
	{
		return self.n;
	}
}

fn one() -> int
{
	return 1;
}

fn main() -> int
{
	let s = Shape { };
	let a = s.area;
	let b: fn() -> int = one;
	if a == b {
		return 1;
	}
	return 0;
}
