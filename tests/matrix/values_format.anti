//! An `f"..."` and an `rf"..."`, in each of these places: switch arm, if let,
//! defer, undo, closure, worker, dispatch or parallel, sync block, select arm,
//! nested type. Each place is a function of its own, and the program prints one
//! line per place and input.

import anti.lang;
import anti.text;

extern fn printf(format: ?*byte, ...) -> c_int;

class Task
{
	pub n: int = 0,
}

fn in_arm(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let s = f"n={n:>4}";
			let raw = rf"\d{n}";
			acc += s.len * 10 + raw.len + n;
			free(s.ptr);
			free(raw.ptr);
		},
	}
	return acc;
}

fn held(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let(n: int) -> int
{
	let acc = 0;
	if let v = held(n) {
		acc += v - n * 3;
		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
	}
	acc = 5;
}

fn in_undo(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn apply(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure(start: int) -> int
{
	let acc = 0;
	let got = apply(start, fn(n) {
		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
		return acc;
	});
	return got + acc;
}

worker fn in_worker(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let s = f"n={n:>4}";
	let raw = rf"\d{n}";
	acc += s.len * 10 + raw.len + n;
	free(s.ptr);
	free(raw.ptr);
	return acc;
}

worker fn work(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work(fn(n) {
		let acc = 0;
		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
		return acc;
	});
	return join(job);
}

struct Guarded
{
	lock: Mutex,
	entered: int,
}

fn in_sync(g: *Guarded, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
	}
	return acc;
}

fn in_select(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let s = f"n={n:>4}";
			let raw = rf"\d{n}";
			acc += s.len * 10 + raw.len + n;
			free(s.ptr);
			free(raw.ptr);
		},
	}
	return acc;
}

class Outer
{
	class Inner
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let s = f"n={n:>4}";
			let raw = rf"\d{n}";
			acc += s.len * 10 + raw.len + n;
			free(s.ptr);
			free(raw.ptr);
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner { base: 1000 };
		return inner.run(n);
	}
}

fn main() -> int
{
	let task = alloc Task { };
	printf("arm %d\n".ptr, in_arm(0) as c_int);
	printf("arm %d\n".ptr, in_arm(1) as c_int);
	printf("arm %d\n".ptr, in_arm(2) as c_int);
	printf("arm %d\n".ptr, in_arm(3) as c_int);
	printf("arm %d\n".ptr, in_arm(4) as c_int);
	printf("if_let %d\n".ptr, in_if_let(0) as c_int);
	printf("if_let %d\n".ptr, in_if_let(1) as c_int);
	printf("if_let %d\n".ptr, in_if_let(2) as c_int);
	printf("if_let %d\n".ptr, in_if_let(3) as c_int);
	printf("if_let %d\n".ptr, in_if_let(4) as c_int);
	let deferred = 0;
	in_defer(1, &deferred);
	printf("defer %d\n".ptr, deferred as c_int);
	in_defer(2, &deferred);
	printf("defer %d\n".ptr, deferred as c_int);
	in_defer(3, &deferred);
	printf("defer %d\n".ptr, deferred as c_int);
	in_defer(4, &deferred);
	printf("defer %d\n".ptr, deferred as c_int);
	let undone = 0;
	in_undo(0, &undone) catch {
		yield;
	};
	printf("undo %d\n".ptr, undone as c_int);
	in_undo(1, &undone) catch {
		yield;
	};
	printf("undo %d\n".ptr, undone as c_int);
	in_undo(2, &undone) catch {
		yield;
	};
	printf("undo %d\n".ptr, undone as c_int);
	in_undo(3, &undone) catch {
		yield;
	};
	printf("undo %d\n".ptr, undone as c_int);
	in_undo(4, &undone) catch {
		yield;
	};
	printf("undo %d\n".ptr, undone as c_int);
	printf("closure %d\n".ptr, in_closure(1) as c_int);
	printf("closure %d\n".ptr, in_closure(2) as c_int);
	printf("closure %d\n".ptr, in_closure(3) as c_int);
	printf("closure %d\n".ptr, in_closure(4) as c_int);
	task.n = 1;
	let job0 = dispatch task -> in_worker();
	printf("worker %d\n".ptr, join(job0) as c_int);
	task.n = 2;
	let job1 = dispatch task -> in_worker();
	printf("worker %d\n".ptr, join(job1) as c_int);
	task.n = 3;
	let job2 = dispatch task -> in_worker();
	printf("worker %d\n".ptr, join(job2) as c_int);
	task.n = 4;
	let job3 = dispatch task -> in_worker();
	printf("worker %d\n".ptr, join(job3) as c_int);
	printf("dispatch %d\n".ptr, in_dispatch(task, 1) as c_int);
	printf("dispatch %d\n".ptr, in_dispatch(task, 2) as c_int);
	printf("dispatch %d\n".ptr, in_dispatch(task, 3) as c_int);
	printf("dispatch %d\n".ptr, in_dispatch(task, 4) as c_int);
	let g = Guarded { lock: Mutex.new(), entered: 0 };
	printf("sync %d\n".ptr, in_sync(&g, 1) as c_int);
	printf("sync %d\n".ptr, in_sync(&g, 2) as c_int);
	printf("sync %d\n".ptr, in_sync(&g, 3) as c_int);
	printf("sync %d\n".ptr, in_sync(&g, 4) as c_int);
	printf("sync entered %d\n".ptr, g.entered as c_int);
	g.lock.destroy();
	let c = chan int(1);
	printf("select %d\n".ptr, in_select(c, 1) as c_int);
	printf("select %d\n".ptr, in_select(c, 2) as c_int);
	printf("select %d\n".ptr, in_select(c, 3) as c_int);
	printf("select %d\n".ptr, in_select(c, 4) as c_int);
	delete(c);
	let outer = Outer { };
	printf("nested %d\n".ptr, outer.go(1) as c_int);
	printf("nested %d\n".ptr, outer.go(2) as c_int);
	printf("nested %d\n".ptr, outer.go(3) as c_int);
	printf("nested %d\n".ptr, outer.go(4) as c_int);
	delete(task);
	return 0;
}
