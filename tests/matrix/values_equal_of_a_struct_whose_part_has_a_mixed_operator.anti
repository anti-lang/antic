//! `==` of a struct with a field of a struct whose `operator fn eq` takes an
//! `int` on the right. The default `==` of the outer struct compares the field
//! with itself, which that operator does not take.

struct Key
{
	id: int,
}

operator fn eq(a: Key, b: int) -> bool
{
	return a.id == b;
}

struct Pair
{
	left: Key,
}

fn main() -> int
{
	let a = Pair { left: Key { id: 1 } };
	let b = Pair { left: Key { id: 1 } };
	if a == b {
		return 1;
	}
	return 0;
}
