//! E2 and a `defer` inside a `defer`: the inner one runs where the block of the
//! outer one is left, after the outer one deleted the node, on every run.

extern fn printf(format: ?*byte, ...) -> c_int;

class Node
{
	pub n: int = 0,
}

fn main() -> int
{
	let p = alloc Node { n: 1 };
	defer {
		defer {
			printf("%d\n".ptr, p.n);
		}
		delete(p);
	}
	return 0;
}
