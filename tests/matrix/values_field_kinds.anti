//! A field `e.x`, read and written, for each of these kinds of value: i8, i16,
//! i32, i64, int, u8, u16, u32, u64, uint, byte, f32, f64, f16, bool, char,
//! str, slice, fixed array, pointer, nullable pointer, optional, may fail fn,
//! fn, tuple, channel, struct, packed struct, simd struct, union, enum,
//! variant, class, concurrent class, interface, generic. Each kind is a
//! function of its own, which prints the two values it holds.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

struct Hold_i8
{
	f: i8,
	tag: int,
}

struct Hold_i16
{
	f: i16,
	tag: int,
}

struct Hold_i32
{
	f: i32,
	tag: int,
}

struct Hold_i64
{
	f: i64,
	tag: int,
}

struct Hold_int
{
	f: int,
	tag: int,
}

struct Hold_u8
{
	f: u8,
	tag: int,
}

struct Hold_u16
{
	f: u16,
	tag: int,
}

struct Hold_u32
{
	f: u32,
	tag: int,
}

struct Hold_u64
{
	f: u64,
	tag: int,
}

struct Hold_uint
{
	f: uint,
	tag: int,
}

struct Hold_byte
{
	f: byte,
	tag: int,
}

struct Hold_f32
{
	f: f32,
	tag: int,
}

struct Hold_f64
{
	f: f64,
	tag: int,
}

struct Hold_f16
{
	f: f16,
	tag: int,
}

struct Hold_bool
{
	f: bool,
	tag: int,
}

struct Hold_char
{
	f: char,
	tag: int,
}

struct Hold_str
{
	f: str,
	tag: int,
}

struct Hold_slice
{
	f: []int,
	tag: int,
}

struct Hold_fixed_array
{
	f: [2]int,
	tag: int,
}

struct Hold_pointer
{
	f: *int,
	tag: int,
}

struct Hold_nullable_pointer
{
	f: ?*int,
	tag: int,
}

struct Hold_optional
{
	f: ?int,
	tag: int,
}

fn risky_up(n: int) -> int may fail
{
	if n < 0 {
		fail "negative";
	}
	return n + 1;
}

fn risky_down(n: int) -> int may fail
{
	if n > 0 {
		fail "positive";
	}
	return n - 1;
}

fn settle(f: fn(int) -> int may fail) -> int
{
	let got = f(10) catch {
		yield -1;
	};
	return got;
}

struct Hold_may_fail_fn
{
	f: fn(int) -> int may fail,
	tag: int,
}

fn up(n: int) -> int
{
	return n + 1;
}

fn down(n: int) -> int
{
	return n - 1;
}

struct Hold_fn
{
	f: fn(int) -> int,
	tag: int,
}

struct Hold_tuple
{
	f: (int, bool),
	tag: int,
}

struct Hold_channel
{
	f: chan int,
	tag: int,
}

struct Pt
{
	x: int,
	y: int,
}

struct Hold_struct
{
	f: Pt,
	tag: int,
}

packed struct Pk
{
	a: u8,
	b: i32,
}

struct Hold_packed_struct
{
	f: Pk,
	tag: int,
}

simd struct I32x4
{
	a: i32,
	b: i32,
	c: i32,
	d: i32,
}

struct Hold_simd_struct
{
	f: I32x4,
	tag: int,
}

union Bits
{
	i: i32,
	f: f32,
}

struct Hold_union
{
	f: Bits,
	tag: int,
}

enum Color
{
	Red,
	Green,
	Blue,
}

struct Hold_enum
{
	f: Color,
	tag: int,
}

variant Shape
{
	Circle { r: int },
	Empty,
}

struct Hold_variant
{
	f: Shape,
	tag: int,
}

class Counter
{
	pub n: int = 0,
}

struct Hold_class
{
	f: Counter,
	tag: int,
}

concurrent class Hits
{
	pub atomic n: int = 0,
}

struct Hold_concurrent_class
{
	f: Hits,
	tag: int,
}

abstract class Named
{
	abstract fn id(self) -> int;
}

class One inherits Named
{
	concrete fn id(self) -> int
	{
		return 1;
	}
}

class Two inherits Named
{
	concrete fn id(self) -> int
	{
		return 2;
	}
}

struct Hold_interface
{
	f: *Named,
	tag: int,
}

fn same(n: int) -> int
{
	return n;
}

struct Hold_generic<T>
{
	f: T,
	tag: int,
}

fn on_i8()
{
	let h = Hold_i8 { f: 127, tag: 1 };
	let i = Hold_i8 { tag: 2, f: 127 };
	i.f = -128;
	printf("i8 %lld %lld\n".ptr, h.f as int, i.f as int);
}

fn on_i16()
{
	let h = Hold_i16 { f: 32767, tag: 1 };
	let i = Hold_i16 { tag: 2, f: 32767 };
	i.f = -32768;
	printf("i16 %lld %lld\n".ptr, h.f as int, i.f as int);
}

fn on_i32()
{
	let h = Hold_i32 { f: 2147483647, tag: 1 };
	let i = Hold_i32 { tag: 2, f: 2147483647 };
	i.f = -2147483648;
	printf("i32 %lld %lld\n".ptr, h.f as int, i.f as int);
}

fn on_i64()
{
	let h = Hold_i64 { f: 9223372036854775807, tag: 1 };
	let i = Hold_i64 { tag: 2, f: 9223372036854775807 };
	i.f = -9223372036854775808;
	printf("i64 %lld %lld\n".ptr, h.f as int, i.f as int);
}

fn on_int()
{
	let h = Hold_int { f: 9223372036854775807, tag: 1 };
	let i = Hold_int { tag: 2, f: 9223372036854775807 };
	i.f = -9223372036854775808;
	printf("int %lld %lld\n".ptr, h.f as int, i.f as int);
}

fn on_u8()
{
	let h = Hold_u8 { f: 255, tag: 1 };
	let i = Hold_u8 { tag: 2, f: 255 };
	i.f = 1;
	printf("u8 %llu %llu\n".ptr, h.f as u64, i.f as u64);
}

fn on_u16()
{
	let h = Hold_u16 { f: 65535, tag: 1 };
	let i = Hold_u16 { tag: 2, f: 65535 };
	i.f = 1;
	printf("u16 %llu %llu\n".ptr, h.f as u64, i.f as u64);
}

fn on_u32()
{
	let h = Hold_u32 { f: 4294967295, tag: 1 };
	let i = Hold_u32 { tag: 2, f: 4294967295 };
	i.f = 1;
	printf("u32 %llu %llu\n".ptr, h.f as u64, i.f as u64);
}

fn on_u64()
{
	let h = Hold_u64 { f: 18446744073709551615, tag: 1 };
	let i = Hold_u64 { tag: 2, f: 18446744073709551615 };
	i.f = 1;
	printf("u64 %llu %llu\n".ptr, h.f as u64, i.f as u64);
}

fn on_uint()
{
	let h = Hold_uint { f: 18446744073709551615, tag: 1 };
	let i = Hold_uint { tag: 2, f: 18446744073709551615 };
	i.f = 1;
	printf("uint %llu %llu\n".ptr, h.f as u64, i.f as u64);
}

fn on_byte()
{
	let h = Hold_byte { f: 255, tag: 1 };
	let i = Hold_byte { tag: 2, f: 255 };
	i.f = 1;
	printf("byte %llu %llu\n".ptr, h.f as u64, i.f as u64);
}

fn on_f32()
{
	let h = Hold_f32 { f: 1.5, tag: 1 };
	let i = Hold_f32 { tag: 2, f: 1.5 };
	i.f = -0.25;
	printf("f32 %g %g\n".ptr, h.f as f64, i.f as f64);
}

fn on_f64()
{
	let h = Hold_f64 { f: 1.5, tag: 1 };
	let i = Hold_f64 { tag: 2, f: 1.5 };
	i.f = -0.25;
	printf("f64 %g %g\n".ptr, h.f, i.f);
}

fn on_f16()
{
	let h = Hold_f16 { f: 1.5 as f16, tag: 1 };
	let i = Hold_f16 { tag: 2, f: 1.5 as f16 };
	i.f = -0.25 as f16;
	printf("f16 %g %g\n".ptr, h.f as f64, i.f as f64);
}

fn on_bool()
{
	let h = Hold_bool { f: true, tag: 1 };
	let i = Hold_bool { tag: 2, f: true };
	i.f = false;
	printf("bool %d %d\n".ptr, h.f as c_int, i.f as c_int);
}

fn on_char()
{
	let h = Hold_char { f: 'a', tag: 1 };
	let i = Hold_char { tag: 2, f: 'a' };
	i.f = '\u{10FFFF}';
	printf("char %u %u\n".ptr, h.f as u32, i.f as u32);
}

fn on_str()
{
	let h = Hold_str { f: "one", tag: 1 };
	let i = Hold_str { tag: 2, f: "one" };
	i.f = "three";
	printf("str %lld %lld\n".ptr, h.f.len, i.f.len);
}

fn on_slice()
{
	let base = [1, 2, 3];
	let h = Hold_slice { f: base[0..1], tag: 1 };
	let i = Hold_slice { tag: 2, f: base[0..1] };
	i.f = base[0..3];
	printf("slice %lld %lld\n".ptr, h.f.len, i.f.len);
}

fn on_fixed_array()
{
	let h = Hold_fixed_array { f: [1, 2], tag: 1 };
	let i = Hold_fixed_array { tag: 2, f: [1, 2] };
	i.f = [3, 4];
	printf("fixed_array %lld %lld\n".ptr, h.f[1], i.f[1]);
}

fn on_pointer()
{
	let a = 11;
	let b = 22;
	let h = Hold_pointer { f: &a, tag: 1 };
	let i = Hold_pointer { tag: 2, f: &a };
	i.f = &b;
	printf("pointer %lld %lld\n".ptr, *h.f, *i.f);
}

fn on_nullable_pointer()
{
	let a = 11;
	let b = 22;
	let h = Hold_nullable_pointer { f: &a, tag: 1 };
	let i = Hold_nullable_pointer { tag: 2, f: &a };
	i.f = none;
	printf("nullable_pointer %lld %lld\n".ptr, *(h.f ?? &b), *(i.f ?? &b));
}

fn on_optional()
{
	let h = Hold_optional { f: 5, tag: 1 };
	let i = Hold_optional { tag: 2, f: 5 };
	i.f = none;
	printf("optional %lld %lld\n".ptr, (h.f ?? -1), (i.f ?? -1));
}

fn on_may_fail_fn()
{
	let h = Hold_may_fail_fn { f: risky_up, tag: 1 };
	let i = Hold_may_fail_fn { tag: 2, f: risky_up };
	i.f = risky_down;
	printf("may_fail_fn %lld %lld\n".ptr, settle(h.f), settle(i.f));
}

fn on_fn()
{
	let h = Hold_fn { f: up, tag: 1 };
	let i = Hold_fn { tag: 2, f: up };
	i.f = down;
	printf("fn %lld %lld\n".ptr, h.f(10), i.f(10));
}

fn on_tuple()
{
	let h = Hold_tuple { f: (1, true), tag: 1 };
	let i = Hold_tuple { tag: 2, f: (1, true) };
	i.f = (2, false);
	printf("tuple %lld %lld\n".ptr, h.f.0, i.f.0);
}

fn on_channel()
{
	let c1 = chan int(1);
	let c2 = chan int(1);
	let h = Hold_channel { f: c1, tag: 1 };
	let i = Hold_channel { tag: 2, f: c1 };
	i.f = c2;
	printf("channel %d %d\n".ptr, (h.f == c1) as c_int, (i.f == c1) as c_int);
	delete(c1);
	delete(c2);
}

fn on_struct()
{
	let h = Hold_struct { f: Pt { x: 1, y: 2 }, tag: 1 };
	let i = Hold_struct { tag: 2, f: Pt { x: 1, y: 2 } };
	i.f = Pt { x: 3, y: 4 };
	printf("struct %lld %lld\n".ptr, h.f.y, i.f.y);
}

fn on_packed_struct()
{
	let h = Hold_packed_struct { f: Pk { a: 1, b: 2 }, tag: 1 };
	let i = Hold_packed_struct { tag: 2, f: Pk { a: 1, b: 2 } };
	i.f = Pk { a: 3, b: 4 };
	printf("packed_struct %lld %lld\n".ptr, h.f.b as int, i.f.b as int);
}

fn on_simd_struct()
{
	let h = Hold_simd_struct { f: I32x4 { a: 1, b: 2, c: 3, d: 4 }, tag: 1 };
	let i = Hold_simd_struct { tag: 2, f: I32x4 { a: 1, b: 2, c: 3, d: 4 } };
	i.f = I32x4 { a: 5, b: 6, c: 7, d: 8 };
	printf("simd_struct %lld %lld\n".ptr, h.f.c as int, i.f.c as int);
}

fn on_union()
{
	let h = Hold_union { f: Bits { i: 7 }, tag: 1 };
	let i = Hold_union { tag: 2, f: Bits { i: 7 } };
	i.f = Bits { i: 9 };
	printf("union %lld %lld\n".ptr, h.f.i as int, i.f.i as int);
}

fn on_enum()
{
	let h = Hold_enum { f: Color.Green, tag: 1 };
	let i = Hold_enum { tag: 2, f: Color.Green };
	i.f = Color.Blue;
	printf("enum %lld %lld\n".ptr, h.f as int, i.f as int);
}

fn on_variant()
{
	let h = Hold_variant { f: Shape.Circle { r: 2 }, tag: 1 };
	let i = Hold_variant { tag: 2, f: Shape.Circle { r: 2 } };
	i.f = Shape.Empty;
	printf("variant %d %d\n".ptr, (h.f is Shape.Circle) as c_int, (i.f is Shape.Circle) as c_int);
}

fn on_class()
{
	let h = Hold_class { f: Counter { n: 5 }, tag: 1 };
	let i = Hold_class { tag: 2, f: Counter { n: 5 } };
	i.f = Counter { n: 6 };
	printf("class %lld %lld\n".ptr, h.f.n, i.f.n);
}

fn on_concurrent_class()
{
	let h = Hold_concurrent_class { f: Hits { n: 5 }, tag: 1 };
	let i = Hold_concurrent_class { tag: 2, f: Hits { n: 5 } };
	i.f = Hits { n: 6 };
	printf("concurrent_class %lld %lld\n".ptr, h.f.n.load(), i.f.n.load());
}

fn on_interface()
{
	let one = One { };
	let two = Two { };
	let h = Hold_interface { f: &one, tag: 1 };
	let i = Hold_interface { tag: 2, f: &one };
	i.f = &two;
	printf("interface %lld %lld\n".ptr, h.f.id(), i.f.id());
}

fn on_generic<T>(a: T, b: T, read: fn(T) -> int)
{
	let h = Hold_generic<T> { f: dup(a), tag: 1 };
	let i = Hold_generic<T> { tag: 2, f: dup(a) };
	i.f = dup(b);
	printf("generic %lld %lld\n".ptr, read(h.f), read(i.f));
}

fn main() -> int
{
	on_i8();
	on_i16();
	on_i32();
	on_i64();
	on_int();
	on_u8();
	on_u16();
	on_u32();
	on_u64();
	on_uint();
	on_byte();
	on_f32();
	on_f64();
	on_f16();
	on_bool();
	on_char();
	on_str();
	on_slice();
	on_fixed_array();
	on_pointer();
	on_nullable_pointer();
	on_optional();
	on_may_fail_fn();
	on_fn();
	on_tuple();
	on_channel();
	on_struct();
	on_packed_struct();
	on_simd_struct();
	on_union();
	on_enum();
	on_variant();
	on_class();
	on_concurrent_class();
	on_interface();
	on_generic<int>(11, 22, same);
	return 0;
}
