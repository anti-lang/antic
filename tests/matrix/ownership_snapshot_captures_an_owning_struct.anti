//! A `snapshot fn` that captures a local that holds a struct that owns
//! something. A snapshot copies what it captures, and the copy would give what
//! the value owns two owners.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

struct Pair
{
	k: Key,
	n: int,
}

fn pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

fn main() -> int
{
	let a = pair(1);
	let f = snapshot fn() -> int {
		return a.n;
	};
	return f();
}
