//! An anonymous function passed to a helper holds a `switch` on its `int`
//! parameter, and its arms change three locals the closure captures.

import anti.io;
import anti.text;

fn say(s: str)
{
	io.println(s);
	free(s.ptr);
}

fn each(xs: []int, f: fn(int))
{
	for x in xs {
		f(x);
	}
}

fn main() -> int
{
	let values: [6]int = [0, 5, 12, 0, 30, 7];
	let zeros = 0;
	let small = 0;
	let big = 0;
	each(values[0..6], fn(n) {
		switch n {
			0 => zeros += 1,
			else => {
				if n < 10 {
					small += 1;
				} else {
					big += n;
				}
			},
		}
	});
	say(f"zeros {zeros} small {small} big {big}");
	return 0;
}
