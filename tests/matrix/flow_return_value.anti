//! A `return` of a value, in each of these places: select arm. Each place is a
//! function of its own, and the program prints one line per place and input.

extern fn printf(format: ?*byte, ...) -> c_int;

fn in_select(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			if n == 2 {
				return 50;
			}
			acc += n;
		},
	}
	return acc;
}

fn main() -> int
{
	let c = chan int(1);
	printf("select %d\n".ptr, in_select(c, 1) as c_int);
	printf("select %d\n".ptr, in_select(c, 2) as c_int);
	printf("select %d\n".ptr, in_select(c, 3) as c_int);
	printf("select %d\n".ptr, in_select(c, 4) as c_int);
	delete(c);
	return 0;
}
