//! A float that is a power of two writes the fewest digits that read back as
//! it. Below such a value the next float lies half as far as the one above, so
//! the digits may round up into the wider half.

import anti.io;
import anti.text;

fn say(s: str)
{
	io.println(s);
	free(s.ptr);
}

fn main() -> int
{
	let wide: f64 = 5.960464477539063e-08;
	let narrow: f32 = 1.5474251e+26;
	say(f"f64 {wide}");
	say(f"f32 {narrow}");
	return 0;
}
