//! `as` to the type a value has already does nothing, by R059 of "Rules of
//! 2026-10-13". A tuple converts to no other type.

extern fn printf(format: ?*byte, ...) -> c_int;

fn pair() -> (int, int)
{
	return (3, 4);
}

fn main() -> int
{
	let t = (1, 2) as (int, int);
	let u = t as (int, int);
	u.0 = 7;
	printf("%lld %lld %lld %lld\n".ptr, t.0, t.1, u.0, (pair() as (int, int)).1);
	return 0;
}
