//! `+=` on a simd struct takes a value of the same simd struct, as `+` does.

simd struct I32x4
{
	a: i32,
	b: i32,
	c: i32,
	d: i32,
}

simd struct U32x4
{
	a: u32,
	b: u32,
	c: u32,
	d: u32,
}

fn main() -> int
{
	let v = I32x4 { a: 1, b: 2, c: 3, d: 4 };
	let w = U32x4 { a: 1, b: 2, c: 3, d: 4 };
	v += w;
	return 0;
}
