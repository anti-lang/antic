//! `delete(c)` of a channel that still holds values. Each value the channel
//! holds is torn down, the oldest first, as `recv` would give them: a class
//! with a `destruct`, a class with an `own` field, an owning struct, tuple,
//! variant, optional and array. A value the program received before stays with
//! the program. A channel that was closed, one that wrapped around its queue
//! and one that holds nothing are deleted the same way. Each `Key` prints its
//! teardown, so the order shows.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,

	pub static atomic live: int = 0;

	fn construct(self)
	{
		Key.live.add(1);
	}

	fn destruct(self)
	{
		Key.live.sub(1);
		printf("  teardown of key %d\n".ptr, self.n as c_int);
	}
}

struct Pair
{
	k: Key,
	n: int,
}

variant Shape
{
	Keyed { k: Key },
	Empty,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn shape(n: int) -> Shape
{
	return Shape.Keyed { k: key(n) };
}

fn maybe(n: int) -> ?Key
{
	return key(n);
}

fn nothing() -> ?Key
{
	return none;
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 1)];
}

fn alive() -> c_int
{
	return Key.live.load() as c_int;
}

fn of_keys()
{
	let c = chan Key(4);
	send(c, key(1));
	send(c, key(2));
	send(c, key(3));
	printf("a channel of a class: alive %d\n".ptr, alive());
	delete(c);
	printf("after delete: alive %d\n".ptr, alive());
}

fn of_structs()
{
	let c = chan Pair(2);
	send(c, pair(10));
	send(c, pair(11));
	delete(c);
	printf("a channel of an owning struct after delete: alive %d\n".ptr, alive());
}

fn of_tuples()
{
	let c = chan (Key, int)(2);
	send(c, tuple(20));
	delete(c);
	printf("a channel of an owning tuple after delete: alive %d\n".ptr, alive());
}

fn of_variants()
{
	let c = chan Shape(3);
	send(c, shape(30));
	send(c, Shape.Empty);
	send(c, shape(31));
	delete(c);
	printf("a channel of an owning variant after delete: alive %d\n".ptr, alive());
}

fn of_optionals()
{
	let c = chan ?Key(3);
	send(c, maybe(40));
	send(c, nothing());
	send(c, maybe(41));
	delete(c);
	printf("a channel of an owning optional after delete: alive %d\n".ptr, alive());
}

fn of_arrays()
{
	let c = chan [2]Key(2);
	send(c, row(50));
	send(c, row(52));
	delete(c);
	printf("a channel of an owning array after delete: alive %d\n".ptr, alive());
}

fn received_before()
{
	let c = chan Key(3);
	send(c, key(60));
	send(c, key(61));
	let first = recv(c) else {
		return;
	};
	delete(c);
	printf("one value received before: %d, alive %d\n".ptr, (*first).n as c_int, alive());
	destroy(first);
	printf("after its destroy: alive %d\n".ptr, alive());
}

fn closed()
{
	let c = chan Key(2);
	send(c, key(70));
	send(c, key(71));
	close(c);
	delete(c);
	printf("a closed channel after delete: alive %d\n".ptr, alive());
}

fn wrapped()
{
	let c = chan Key(2);
	send(c, key(80));
	send(c, key(81));
	let first = recv(c) else {
		return;
	};
	destroy(first);
	send(c, key(82));
	delete(c);
	printf("a channel that wrapped around after delete: alive %d\n".ptr, alive());
}

fn empty()
{
	let c = chan Key(2);
	send(c, key(90));
	let first = recv(c) else {
		return;
	};
	destroy(first);
	delete(c);
	printf("an empty channel after delete: alive %d\n".ptr, alive());
}

fn deferred()
{
	let c = chan Key(2);
	defer delete(c);
	send(c, key(100));
	printf("a deferred delete: alive %d\n".ptr, alive());
}

fn main() -> int
{
	of_keys();
	of_structs();
	of_tuples();
	of_variants();
	of_optionals();
	of_arrays();
	received_before();
	closed();
	wrapped();
	empty();
	deferred();
	printf("at the end: alive %d\n".ptr, alive());
	return 0;
}
