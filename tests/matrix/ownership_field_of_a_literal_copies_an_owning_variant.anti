//! A field that holds a variant with an owning case, named in the literal of
//! another object. The field keeps its value, and the literal would hold a
//! second owner.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

variant Shape
{
	Keyed { k: Key },
	Empty,
}

fn shape(n: int) -> Shape
{
	return Shape.Keyed { k: key(n) };
}

class Holder
{
	pub held: Shape,
}

fn main() -> int
{
	let h = Holder { held: shape(1) };
	let other = Holder { held: h.held };
	return 0;
}
