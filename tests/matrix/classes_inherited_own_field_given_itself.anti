//! `b.one = b.one` of an `own` field that `Crate` inherits from `Box`. The
//! field keeps the pointer it holds and its one owner, as a field of `Box`
//! itself does, and the teardown of `b` frees the node once.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Node
{
	pub n: int = 0,
}

class Box
{
	pub own one: ?*Node = none,
}

class Crate inherits Box
{
	pub k: int = 0,
}

fn main() -> int
{
	let b = Crate { };
	b.one = alloc Node { n: 1 };
	b.one = b.one;
	if let got = b.one {
		printf("one %d\n".ptr, got.n as c_int);
	}
	return 0;
}
