//! A public function of a synchronized class calls a function that holds a
//! `select`, which may wait while the hidden lock of the object is held. The
//! call gets the warning `blocking-under-lock`, which a release build refuses.

fn pick(c: chan int) -> int
{
	let n = 0;
	select {
		c v => {
			let x = v else {
				return 0;
			};
			n = *x;
		}
	}
	return n;
}

synchronized class Inbox
{
	count: int = 0,

	pub fn work(self, c: chan int) -> int
	{
		self.count += pick(c);
		return self.count;
	}
}

fn main() -> int
{
	let box = alloc Inbox { };
	let c = chan int(1);
	send(c, 4);
	let n = box.work(c);
	delete(c);
	delete(box);
	return n - 4;
}
