//! `operator fn eq` takes no class with a Mutex by value, by R105 of the rules
//! of 2026-10-13. A call would copy the Mutex, so the operator is refused where
//! it is declared, and `equals` of the class never meets it.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Guarded
{
	pub lock: Mutex,
	pub n: int = 0,
}

operator fn eq(a: Guarded, b: Guarded) -> bool
{
	return true;
}

fn main() -> int
{
	let a = Guarded { lock: Mutex.new(), n: 1 };
	let b = Guarded { lock: Mutex.new(), n: 2 };
	printf("%d\n".ptr, a.equals(&b) as c_int);
	return 0;
}
