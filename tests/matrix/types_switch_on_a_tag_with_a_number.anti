//! The `tag` has an enum of its own that no program writes, so an arm cannot
//! name its value. `as` gives its number.

variant Shape
{
	Circle { r: int },
	Rect { w: int, h: int },
	Empty,
}

fn main() -> int
{
	let s = Shape.Empty;
	let n = 0;
	switch s.tag {
		0 => n = 1,
		else => n = 2,
	}
	return n;
}
