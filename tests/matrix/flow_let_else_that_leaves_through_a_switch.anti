//! The `else` of a `let` leaves the block it stands in. A `switch` whose arms
//! and `else` all return is such a statement, by R003 of the rules of
//! 2026-10-13.

extern fn printf(format: ?*byte, ...) -> c_int;

fn maybe(p: *int, n: int) -> ?*int
{
	if n > 2 {
		return p;
	}
	return none;
}

fn pick(n: int) -> int
{
	let seven = 7;
	let p = maybe(&seven, n) else {
		switch n {
			1 => {
				return -1;
			},
			else => {
				return -2;
			},
		}
	};
	return *p;
}

fn main() -> int
{
	printf("%d %d %d\n".ptr, pick(1) as c_int, pick(2) as c_int,
		pick(3) as c_int);
	return 0;
}
