//! A name shadowed in two inner blocks by values of other types, a `str` and an
//! `f64`, keeps its own value and type in the outer block.

import anti.io;
import anti.text;

fn say(s: str)
{
	io.println(s);
	free(s.ptr);
}

fn main() -> int
{
	let x = 5;
	{
		let x = "five";
		say(f"{x} {x.len}");
	}
	if x > 0 {
		let x = 2.5;
		x *= 2.0;
		say(f"{x}");
	}
	x += 1;
	say(f"{x}");
	return 0;
}
