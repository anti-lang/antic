//! A struct with a field of a `?T` of a slice has no default `==`. The value a
//! `?T` holds follows the rule of a value of its type, and a slice has no `==`,
//! as the provisional entry on the parts of a tuple and the value of a `?T`
//! under "Generics and collections" in `docs/decisions.md` gives it.

struct Window
{
	view: ?[]int,
	n: int,
}

fn same(a: Window, b: Window) -> bool
{
	return a == b;
}

fn main() -> int
{
	return 0;
}
