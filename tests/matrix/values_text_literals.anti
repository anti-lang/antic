//! The raw, byte, hex, interpolated and pattern literals of the values area,
//! each in every place its row of docs/notes/test-matrix.md left open:
//! literal_raw, literal_bytes, literal_hex, format, pattern. Each construct in
//! each place is a function of its own, named after both, and the program
//! prints one line per construct, place and input.

import anti.lang;
import anti.regex;
import anti.text;

extern fn printf(format: ?*byte, ...) -> c_int;

class Task
{
	pub n: int = 0,
}

class Box_literal_raw
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		let s = r"a\nb";
		acc += s.len * n + (s[1] as int);
		return acc;
	}
}

fn in_arm_literal_raw(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let s = r"a\nb";
			acc += s.len * n + (s[1] as int);
		},
	}
	return acc;
}

fn held_literal_raw(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_literal_raw(n: int) -> int
{
	let acc = 0;
	if let v = held_literal_raw(n) {
		acc += v - n * 3;
		let s = r"a\nb";
		acc += s.len * n + (s[1] as int);
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_literal_raw(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let s = r"a\nb";
		acc += s.len * n + (s[1] as int);
	}
	acc = 5;
}

fn in_undo_literal_raw(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let s = r"a\nb";
		acc += s.len * n + (s[1] as int);
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_literal_raw(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_literal_raw(n: int) -> int
{
	let acc = 0;
	let got = risky_literal_raw(n) catch {
		let s = r"a\nb";
		acc += s.len * n + (s[1] as int);
		yield acc;
	};
	return got;
}

fn apply_literal_raw(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_literal_raw(start: int) -> int
{
	let acc = 0;
	let got = apply_literal_raw(start, fn(n) {
		let s = r"a\nb";
		acc += s.len * n + (s[1] as int);
		return acc;
	});
	return got + acc;
}

worker fn in_worker_literal_raw(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let s = r"a\nb";
	acc += s.len * n + (s[1] as int);
	return acc;
}

worker fn work_literal_raw(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_literal_raw(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_literal_raw(fn(n) {
		let acc = 0;
		let s = r"a\nb";
		acc += s.len * n + (s[1] as int);
		return acc;
	});
	return join(job);
}

struct Guarded_literal_raw
{
	lock: Mutex,
	entered: int,
}

fn in_sync_literal_raw(g: *Guarded_literal_raw, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let s = r"a\nb";
		acc += s.len * n + (s[1] as int);
	}
	return acc;
}

fn in_select_literal_raw(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let s = r"a\nb";
			acc += s.len * n + (s[1] as int);
		},
	}
	return acc;
}

fn in_generic_literal_raw<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	let s = r"a\nb";
	acc += s.len * n + (s[1] as int);
	return acc;
}

class Outer_literal_raw
{
	class Inner_literal_raw
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let s = r"a\nb";
			acc += s.len * n + (s[1] as int);
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_literal_raw { base: 1000 };
		return inner.run(n);
	}
}

class Box_literal_bytes
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		let b = b"\x00\xff";
		let raw = br"\x00";
		acc += b.len * n + (b[1] as int) + raw.len;
		return acc;
	}
}

fn in_arm_literal_bytes(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let b = b"\x00\xff";
			let raw = br"\x00";
			acc += b.len * n + (b[1] as int) + raw.len;
		},
	}
	return acc;
}

