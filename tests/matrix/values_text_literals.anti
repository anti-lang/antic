		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
	}
	return acc;
}

fn in_select_format(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let s = f"n={n:>4}";
			let raw = rf"\d{n}";
			acc += s.len * 10 + raw.len + n;
			free(s.ptr);
			free(raw.ptr);
		},
