class Box_literal_hex
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		let h = x"00 AB CC";
		acc += h.len * n + (h[1] as int);
		return acc;
	}
}

fn in_loop_literal_hex(n: int) -> int
{
	let acc = 0;
	for turn in 0..2 {
		acc += turn;
		let h = x"00 AB CC";
		acc += h.len * n + (h[1] as int);
	}
	return acc;
}

fn in_arm_literal_hex(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let h = x"00 AB CC";
			acc += h.len * n + (h[1] as int);
