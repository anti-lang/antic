fn in_arm_format(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let s = f"n={n:>4}";
			let raw = rf"\d{n}";
			acc += s.len * 10 + raw.len + n;
			free(s.ptr);
			free(raw.ptr);
		},
	}
	return acc;
}

fn held_format(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_format(n: int) -> int
{
	let acc = 0;
	if let v = held_format(n) {
		acc += v - n * 3;
		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_format(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
	}
	acc = 5;
}

fn in_undo_format(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn apply_format(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_format(start: int) -> int
{
	let acc = 0;
	let got = apply_format(start, fn(n) {
		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
		return acc;
	});
	return got + acc;
}

worker fn in_worker_format(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let s = f"n={n:>4}";
	let raw = rf"\d{n}";
	acc += s.len * 10 + raw.len + n;
	free(s.ptr);
	free(raw.ptr);
	return acc;
}

worker fn work_format(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_format(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_format(fn(n) {
		let acc = 0;
		let s = f"n={n:>4}";
		let raw = rf"\d{n}";
		acc += s.len * 10 + raw.len + n;
		free(s.ptr);
		free(raw.ptr);
		return acc;
	});
	return join(job);
}

