	}
}

class Box_pattern
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		if "a12".matches(re"[0-9]+") {
			acc += n;
		}
		if "abc".matches(re"[0-9]+") {
			acc += 100;
		}
		return acc;
	}
}

fn in_arm_pattern(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			if "a12".matches(re"[0-9]+") {
				acc += n;
			}
			if "abc".matches(re"[0-9]+") {
				acc += 100;
			}
		},
	}
	return acc;
}

fn held_pattern(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_pattern(n: int) -> int
{
	let acc = 0;
	if let v = held_pattern(n) {
		acc += v - n * 3;
		if "a12".matches(re"[0-9]+") {
			acc += n;
		}
		if "abc".matches(re"[0-9]+") {
			acc += 100;
		}
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_pattern(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		if "a12".matches(re"[0-9]+") {
			acc += n;
		}
		if "abc".matches(re"[0-9]+") {
			acc += 100;
		}
	}
	acc = 5;
}

fn in_undo_pattern(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		if "a12".matches(re"[0-9]+") {
			acc += n;
		}
		if "abc".matches(re"[0-9]+") {
			acc += 100;
		}
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_pattern(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_pattern(n: int) -> int
{
	let acc = 0;
	let got = risky_pattern(n) catch {
		if "a12".matches(re"[0-9]+") {
			acc += n;
		}
		if "abc".matches(re"[0-9]+") {
			acc += 100;
		}
		yield acc;
	};
	return got;
}

fn apply_pattern(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_pattern(start: int) -> int
{
	let acc = 0;
	let got = apply_pattern(start, fn(n) {
		if "a12".matches(re"[0-9]+") {
			acc += n;
		}
		if "abc".matches(re"[0-9]+") {
			acc += 100;
		}
		return acc;
	});
	return got + acc;
}

worker fn in_worker_pattern(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	if "a12".matches(re"[0-9]+") {
		acc += n;
	}
	if "abc".matches(re"[0-9]+") {
		acc += 100;
	}
	return acc;
}

worker fn work_pattern(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_pattern(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_pattern(fn(n) {
		let acc = 0;
		if "a12".matches(re"[0-9]+") {
			acc += n;
		}
		if "abc".matches(re"[0-9]+") {
			acc += 100;
		}
		return acc;
	});
	return join(job);
}

struct Guarded_pattern
{
	lock: Mutex,
	entered: int,
}

fn in_sync_pattern(g: *Guarded_pattern, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		if "a12".matches(re"[0-9]+") {
			acc += n;
		}
		if "abc".matches(re"[0-9]+") {
			acc += 100;
		}
	}
	return acc;
}

fn in_select_pattern(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			if "a12".matches(re"[0-9]+") {
				acc += n;
			}
			if "abc".matches(re"[0-9]+") {
				acc += 100;
			}
		},
	}
	return acc;
}

fn in_generic_pattern<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	if "a12".matches(re"[0-9]+") {
		acc += n;
	}
	if "abc".matches(re"[0-9]+") {
		acc += 100;
	}
	return acc;
}

class Outer_pattern
{
	class Inner_pattern
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			if "a12".matches(re"[0-9]+") {
				acc += n;
			}
			if "abc".matches(re"[0-9]+") {
				acc += 100;
			}
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_pattern { base: 1000 };
		return inner.run(n);
	}
}

