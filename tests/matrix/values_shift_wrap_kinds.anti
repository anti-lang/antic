	let r1: byte = (255 ^ z) <<% (1 ^ z);
	printf("shl_wrap byte 255 1 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: byte = 255 <<% 7;
	let r2: byte = (255 ^ z) <<% (7 ^ z);
	printf("shl_wrap byte 255 7 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: byte = 3 <<% 0;
	let r3: byte = (3 ^ z) <<% (0 ^ z);
	printf("shl_wrap byte 3 0 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: byte = 1 <<% 1;
	let r4: byte = (1 ^ z) <<% (1 ^ z);
	printf("shl_wrap byte 1 1 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: byte = 1 <<% 8;
	let r5: byte = (1 ^ z) <<% (8 ^ z);
	printf("shl_wrap byte 1 8 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: byte = 3 <<% 9;
	let r6: byte = (3 ^ z) <<% (9 ^ z);
	printf("shl_wrap byte 3 9 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: byte = 255 <<% 8;
	let r7: byte = (255 ^ z) <<% (8 ^ z);
	printf("shl_wrap byte 255 8 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	on_i8(zero as i8);
	on_i16(zero as i16);
	on_i32(zero as i32);
	on_i64(zero as i64);
	on_int(zero as int);
	on_u8(zero as u8);
	on_u16(zero as u16);
	on_u32(zero as u32);
	on_u64(zero as u64);
	on_uint(zero as uint);
	on_byte(zero as byte);
	return 0;
}
