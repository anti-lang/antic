//! `<<%` on every integer type. A count at or above the width gives 0, and no
//! build checks it. Each line holds the value the checker folds in a constant
//! and the value the program computes from operands it cannot know before it
//! runs. `none` stands where the checker refuses the constant, and `checked`
//! where a dev build stops, so the program does not run the case.

extern fn printf(format: ?*byte, ...) -> c_int;

fn on_i8(z: i8)
{
	const F0: i8 = 1 <<% 7;
	let r0: i8 = (1 ^ z) <<% (7 ^ z);
	printf("shl_wrap i8 1 7 = %lld %lld\n".ptr, F0 as int, r0 as int);
	const F1: i8 = 127 <<% 1;
	let r1: i8 = (127 ^ z) <<% (1 ^ z);
	printf("shl_wrap i8 127 1 = %lld %lld\n".ptr, F1 as int, r1 as int);
	const F2: i8 = 127 <<% 7;
	let r2: i8 = (127 ^ z) <<% (7 ^ z);
	printf("shl_wrap i8 127 7 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: i8 = 3 <<% 0;
	let r3: i8 = (3 ^ z) <<% (0 ^ z);
	printf("shl_wrap i8 3 0 = %lld %lld\n".ptr, F3 as int, r3 as int);
	const F4: i8 = 1 <<% 1;
	let r4: i8 = (1 ^ z) <<% (1 ^ z);
	printf("shl_wrap i8 1 1 = %lld %lld\n".ptr, F4 as int, r4 as int);
	const F5: i8 = -128 <<% 7;
	let r5: i8 = (-128 ^ z) <<% (7 ^ z);
	printf("shl_wrap i8 -128 7 = %lld %lld\n".ptr, F5 as int, r5 as int);
	const F6: i8 = -8 <<% 1;
	let r6: i8 = (-8 ^ z) <<% (1 ^ z);
	printf("shl_wrap i8 -8 1 = %lld %lld\n".ptr, F6 as int, r6 as int);
	const F7: i8 = -1 <<% 7;
	let r7: i8 = (-1 ^ z) <<% (7 ^ z);
	printf("shl_wrap i8 -1 7 = %lld %lld\n".ptr, F7 as int, r7 as int);
	const F8: i8 = -128 <<% 1;
	let r8: i8 = (-128 ^ z) <<% (1 ^ z);
	printf("shl_wrap i8 -128 1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: i8 = 1 <<% 8;
	let r9: i8 = (1 ^ z) <<% (8 ^ z);
	printf("shl_wrap i8 1 8 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i8 = 3 <<% 9;
	let r10: i8 = (3 ^ z) <<% (9 ^ z);
	printf("shl_wrap i8 3 9 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i8 = 127 <<% 8;
	let r11: i8 = (127 ^ z) <<% (8 ^ z);
	printf("shl_wrap i8 127 8 = %lld %lld\n".ptr, F11 as int, r11 as int);
}

