//! `return` of a field that holds a struct that owns something, which decision
//! 22 of "Decisions of 2026-10-11" refuses by the rule of `let` and `=`: the
//! field keeps its value, and the caller would hold a second owner.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

struct Pair
{
	k: Key,
	n: int,
}

fn pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

class Holder
{
	pub held: Pair,
}

fn give(h: *Holder) -> Pair
{
	return h.held;
}

fn main() -> int
{
	let h = Holder { held: pair(1) };
	let b = give(&h);
	return 0;
}
