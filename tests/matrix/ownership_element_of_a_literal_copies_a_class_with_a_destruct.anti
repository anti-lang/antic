//! An element of an array that holds a class with a `destruct`, named in an
//! array literal. The element stays where it is, so the literal would hold a
//! copy and the array would stay a second owner. A local moves there, by R079
//! of "Rules of 2026-10-13".

class Counted
{
	pub n: int = 0,

	fn destruct(self)
	{
	}
}

fn counted(n: int) -> Counted
{
	return Counted { n: n };
}

fn main() -> int
{
	let held = [counted(1), counted(2)];
	let xs = [held[0], counted(3)];
	return 0;
}
