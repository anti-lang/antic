	let x61: byte = 255 ^ z;
	x61 *|= 2 ^ z;
	printf("mul_sat byte 255 2 = %llu\n".ptr, x61 as u64);
	let x62: byte = 7 ^ z;
	x62 *|= 2 ^ z;
	printf("mul_sat byte 7 2 = %llu\n".ptr, x62 as u64);
	let x63: byte = 0 ^ z;
	x63 *|= 0 ^ z;
	printf("mul_sat byte 0 0 = %llu\n".ptr, x63 as u64);
	let x64: byte = 0 ^ z;
	x64 *|= 1 ^ z;
	printf("mul_sat byte 0 1 = %llu\n".ptr, x64 as u64);
	let x65: byte = 1 ^ z;
	x65 *|= 255 ^ z;
	printf("mul_sat byte 1 255 = %llu\n".ptr, x65 as u64);
	let x66: byte = 254 ^ z;
	x66 *|= 255 ^ z;
	printf("mul_sat byte 254 255 = %llu\n".ptr, x66 as u64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	on_i8(zero as i8);
	on_i16(zero as i16);
	on_i32(zero as i32);
	on_i64(zero as i64);
	on_int(zero as int);
	on_u8(zero as u8);
	on_u16(zero as u16);
	on_u32(zero as u32);
	on_u64(zero as u64);
	on_uint(zero as uint);
	on_byte(zero as byte);
	return 0;
}
