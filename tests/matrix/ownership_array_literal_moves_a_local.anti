//! An owning local named in an array literal moves into it, as into a tuple, a
//! struct and a class literal: a class with a `destruct`, a class with an `own`
//! field, an owning struct, tuple, variant, optional and array. So does an
//! `own` parameter, and a local of a type parameter in a generic. A later
//! element still reads the local, since it moves once the literal has read
//! every element. A local that owns nothing is copied and stays. Each line
//! prints the values alive with the array and after its block, so a teardown
//! that is missed or runs twice shows.

extern fn printf(format: ?*byte, ...) -> c_int;

class Leaf
{
	pub n: int = 0,
}

class Counted
{
	pub n: int = 0,

	static atomic live: int = 0;

	fn construct(self)
	{
		Counted.live.add(1);
	}

	fn destruct(self)
	{
		Counted.live.sub(1);
	}
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,

	static atomic live: int = 0;

	fn construct(self)
	{
		Key.live.add(1);
	}

	fn destruct(self)
	{
		Key.live.sub(1);
	}
}

struct Pair
{
	k: Key,
	n: int,
}

variant Shape
{
	Keyed { k: Key },
	Empty,
}

fn counted(n: int) -> Counted
{
	return Counted { n: n };
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn shape(n: int) -> Shape
{
	return Shape.Keyed { k: key(n) };
}

fn maybe(n: int) -> ?Key
{
	return key(n);
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

fn alive() -> c_int
{
	return (Key.live.load() + Counted.live.load()) as c_int;
}

fn of_counted()
{
	let a = counted(1);
	let b = counted(2);
	let xs = [a, b, counted(3)];
	printf("a class with a destruct: %d %d %d, alive %d\n".ptr, xs[0].n as c_int, xs[1].n as c_int,
		xs[2].n as c_int, alive());
}

fn of_keys()
{
	let a = key(1);
	let xs = [key(2), a];
	printf("a class with an own field: %d %d, alive %d\n".ptr, xs[0].n as c_int, xs[1].n as c_int,
		alive());
}

fn of_pairs()
{
	let a = pair(1);
	let xs = [a, pair(2)];
	printf("an owning struct: %d %d, alive %d\n".ptr, xs[0].k.n as c_int, xs[1].k.n as c_int, alive());
}

fn of_tuples()
{
	let a = tuple(1);
	let xs = [a, tuple(2)];
	printf("an owning tuple: %d %d, alive %d\n".ptr, xs[0].0.n as c_int, xs[1].0.n as c_int, alive());
}

fn of_shapes()
{
	let a = shape(1);
	let b = Shape.Empty;
	let xs = [a, b];
	printf("an owning variant: %d %d, alive %d\n".ptr, (xs[0] is Shape.Keyed) as c_int,
		(xs[1] is Shape.Empty) as c_int, alive());
}

fn of_optionals()
{
	let a = maybe(1);
	let xs = [a, maybe(2)];
	printf("an owning optional: %d %d, alive %d\n".ptr, (xs[0] != none) as c_int,
		(xs[1] != none) as c_int, alive());
}

fn of_rows()
{
	let a = row(1);
	let xs = [a, row(2)];
	printf("an owning array: %d %d, alive %d\n".ptr, xs[0][1].n as c_int, xs[1][0].n as c_int, alive());
}

fn later_element()
{
	let a = key(7);
	let xs = [a, key(a.n + 1)];
	printf("a later element reads the local: %d %d, alive %d\n".ptr, xs[0].n as c_int,
		xs[1].n as c_int, alive());
}

fn of_a_parameter(own k: Key) -> int
{
	let xs = [k, key(10)];
	printf("an own parameter: %d %d, alive %d\n".ptr, xs[0].n as c_int, xs[1].n as c_int, alive());
	return xs[0].n;
}

fn in_a_generic<T>(own x: T, own y: T) -> [2]T
{
	let a = x;
	return [a, y];
}

fn returned() -> [2]Key
{
	let a = key(20);
	let b = key(21);
	return [a, b];
}

fn on_one_path(yes: bool)
{
	let a = key(30);
	if yes {
		let xs = [a, key(31)];
		printf("on one path: %d, alive %d\n".ptr, xs[0].n as c_int, alive());
	}
	printf("after the path: alive %d\n".ptr, alive());
}

fn of_numbers()
{
	let n = 5;
	let xs = [n, n + 1];
	printf("a local that owns nothing stays: %d %d %d\n".ptr, xs[0] as c_int, xs[1] as c_int, n as c_int);
}

fn main() -> int
{
	of_counted();
	printf("after the block: alive %d\n".ptr, alive());
	of_keys();
	of_pairs();
	of_tuples();
	of_shapes();
	of_optionals();
	of_rows();
	printf("after the blocks: alive %d\n".ptr, alive());
	later_element();
	let n = of_a_parameter(key(9));
	printf("after the function: %d, alive %d\n".ptr, n as c_int, alive());
	let g = in_a_generic<Key>(key(11), key(12));
	let h = in_a_generic<int>(13, 14);
	printf("in a generic: %d %d %d %d, alive %d\n".ptr, g[0].n as c_int, g[1].n as c_int, h[0] as c_int,
		h[1] as c_int, alive());
	let r = returned();
	printf("returned: %d %d, alive %d\n".ptr, r[0].n as c_int, r[1].n as c_int, alive());
	on_one_path(true);
	on_one_path(false);
	of_numbers();
	return 0;
}
