//! A class that replaces `equals`, beside a plain function `hash` of its module
//! that takes it. A hash of the module is written `operator fn`, so the class
//! lacks one.

class Point
{
	pub x: int = 0,

	concrete fn equals(self, other: *Object) -> bool
	{
		return true;
	}
}

fn hash(a: Point) -> u64
{
	return 1;
}

fn main() -> int
{
	return 0;
}
