//! C3 of the compile-time checks: a `may fail` function with a result reaches
//! its end without `return` or `fail`. A call statement whose handler ends the
//! path goes on when the call succeeds.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

extern fn exit(status: c_int) -> never;

fn value(n: int) -> int may fail
{
	if n > 2 {
		fail lang.Error.new(n, "refused");
	}
	return n;
}

fn stop(n: int) -> never
{
	exit(n as c_int);
}

fn f(p: ?*int, n: int) -> int may fail
{
	value(n) catch failed {
		fail failed;
	};
}

fn main() -> int
{
	return 0;
}
