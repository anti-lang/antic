//! A struct whose field is a variant with a case that owns memory owns it too,
//! and `=` copies no such value.

class Node
{
	pub own p: ?*int = none,
}

variant Slot
{
	Full { node: Node },
	Empty,
}

struct Rows
{
	part: Slot,
}

fn copy(a: *Rows, b: *Rows)
{
	*a = *b;
}

fn main() -> int
{
	return 0;
}
