//! A `snapshot fn` that captures a local that holds a tuple that owns
//! something. A snapshot copies what it captures, and the copy would give what
//! the value owns two owners.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn main() -> int
{
	let a = tuple(1);
	let f = snapshot fn() -> int {
		return a.1;
	};
	return f();
}
