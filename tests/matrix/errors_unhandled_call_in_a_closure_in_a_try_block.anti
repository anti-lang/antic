//! A `try` block handles the failing calls of its own function. A failing call
//! in an anonymous function inside the block reaches no handler and is refused.

import anti.lang;

fn step(n: int) may fail
{
	if n == 0 {
		fail "no step";
	}
}

fn apply(f: fn(int))
{
	f(0);
}

fn main() -> int
{
	try {
		apply(fn(n) {
			step(n);
		});
	} catch { }
	return 0;
}
