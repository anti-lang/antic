//! Each kind of owning value as an element: an array literal of fresh values,
//! `=` to an element at a constant index and at one the program computes, which
//! destroys the value the element held, and an element of `alloc(T, n)`, whose
//! memory is zero and holds no value yet. Each line prints the values and the
//! values alive.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Counted
{
	pub n: int = 0,

	static atomic live: int = 0;

	fn construct(self)
	{
		Counted.live.add(1);
	}

	fn destruct(self)
	{
		Counted.live.sub(1);
	}
}

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,

	static atomic live: int = 0;

	fn construct(self)
	{
		Key.live.add(1);
	}

	fn destruct(self)
	{
		Key.live.sub(1);
	}
}

struct Pair
{
	k: Key,
	n: int,
}

variant Shape
{
	Keyed { k: Key },
	Empty,
}

fn counted(n: int) -> Counted
{
	return Counted { n: n };
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn shape(n: int) -> Shape
{
	return Shape.Keyed { k: key(n) };
}

fn maybe(n: int) -> ?Key
{
	return key(n);
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

/// The values alive now. A copy that `dup` made runs no `construct`, so the
/// program counts it with `copies`.
fn alive() -> c_int
{
	return (Key.live.load() + Counted.live.load()) as c_int;
}

/// Count `n` more values alive, for a copy.
fn copies(n: int)
{
	Key.live.add(n);
}

fn one() -> int
{
	return 1;
}

fn in_counted()
{
	let xs = [counted(1), counted(2)];
	xs[0] = counted(3);
	let i = one();
	xs[i] = counted(4);
	printf("element of a class with a destruct: %d %d, alive %d\n".ptr, xs[0].n as c_int, xs[i].n as c_int,
		alive());
	let q = alloc(Counted, 2) else {
		return;
	};
	q[i] = counted(5);
	q[i] = counted(6);
	printf("element of alloc of a class with a destruct: %d, alive %d\n".ptr, q[i].n as c_int, alive());
	destroy(&q[i]);
	free(q);
	printf("element of a class with a destruct after destroy: alive %d\n".ptr, alive());
}

fn in_key()
{
	let xs = [key(1), key(2)];
	xs[0] = key(3);
	let i = one();
	xs[i] = key(4);
	printf("element of a class with an own field: %d %d, alive %d\n".ptr, xs[0].n as c_int, xs[i].n as c_int,
		alive());
	let q = alloc(Key, 2) else {
		return;
	};
	q[i] = key(5);
	q[i] = key(6);
	printf("element of alloc of a class with an own field: %d, alive %d\n".ptr, q[i].n as c_int, alive());
	destroy(&q[i]);
	free(q);
	printf("element of a class with an own field after destroy: alive %d\n".ptr, alive());
}

fn in_pair()
{
	let xs = [pair(1), pair(2)];
	xs[0] = pair(3);
	let i = one();
	xs[i] = pair(4);
	printf("element of an owning struct: %d %d, alive %d\n".ptr, xs[0].k.n as c_int, xs[i].k.n as c_int,
		alive());
	let q = alloc(Pair, 2) else {
		return;
	};
	q[i] = pair(5);
	q[i] = pair(6);
	printf("element of alloc of an owning struct: %d, alive %d\n".ptr, q[i].k.n as c_int, alive());
	destroy(&q[i]);
	free(q);
	printf("element of an owning struct after destroy: alive %d\n".ptr, alive());
}

fn in_tuple()
{
	let xs = [tuple(1), tuple(2)];
	xs[0] = tuple(3);
	let i = one();
	xs[i] = tuple(4);
	printf("element of an owning tuple: %d %d, alive %d\n".ptr, xs[0].0.n as c_int, xs[i].0.n as c_int,
		alive());
	let q = alloc((Key, int), 2) else {
		return;
	};
	q[i] = tuple(5);
	q[i] = tuple(6);
	printf("element of alloc of an owning tuple: %d, alive %d\n".ptr, q[i].0.n as c_int, alive());
	destroy(&q[i]);
	free(q);
	printf("element of an owning tuple after destroy: alive %d\n".ptr, alive());
}

fn in_shape()
{
	let xs = [shape(1), shape(2)];
	xs[0] = shape(3);
	let i = one();
	xs[i] = shape(4);
	printf("element of an owning variant: %d %d, alive %d\n".ptr, (xs[0] is Shape.Keyed) as int as c_int, (xs[i] is Shape.Keyed) as int as c_int,
		alive());
	let q = alloc(Shape, 2) else {
		return;
	};
	q[i] = shape(5);
	q[i] = shape(6);
	printf("element of alloc of an owning variant: %d, alive %d\n".ptr, (q[i] is Shape.Keyed) as int as c_int, alive());
	destroy(&q[i]);
	free(q);
	printf("element of an owning variant after destroy: alive %d\n".ptr, alive());
}

fn in_maybe()
{
	let xs = [maybe(1), maybe(2)];
	xs[0] = maybe(3);
	let i = one();
	xs[i] = maybe(4);
	printf("element of an owning optional: %d %d, alive %d\n".ptr, (xs[0] != none) as int as c_int, (xs[i] != none) as int as c_int,
		alive());
	let q = alloc(?Key, 2) else {
		return;
	};
	q[i] = maybe(5);
	q[i] = maybe(6);
	printf("element of alloc of an owning optional: %d, alive %d\n".ptr, (q[i] != none) as int as c_int, alive());
	destroy(&q[i]);
	free(q);
	printf("element of an owning optional after destroy: alive %d\n".ptr, alive());
}

fn in_row()
{
	let xs = [row(1), row(2)];
	xs[0] = row(3);
	let i = one();
	xs[i] = row(4);
	printf("element of an owning array: %d %d, alive %d\n".ptr, xs[0][0].n as c_int, xs[i][0].n as c_int,
		alive());
	let q = alloc([2]Key, 2) else {
		return;
	};
	q[i] = row(5);
	q[i] = row(6);
	printf("element of alloc of an owning array: %d, alive %d\n".ptr, q[i][0].n as c_int, alive());
	destroy(&q[i]);
	free(q);
	printf("element of an owning array after destroy: alive %d\n".ptr, alive());
}

fn main() -> int
{
	in_counted();
	in_key();
	in_pair();
	in_tuple();
	in_shape();
	in_maybe();
	in_row();
	printf("at the end: alive %d\n".ptr, alive());
	return 0;
}
