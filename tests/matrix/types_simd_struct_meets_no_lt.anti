//! A simd struct does not meet `lt`, by Q18 of "Answers of 2026-10-24": its
//! comparisons give a mask of its lanes and no `bool`.

simd struct Vec4
{
	x: f32,
	y: f32,
	z: f32,
	w: f32,
}

fn larger<T: lt>(own a: T, own b: T) -> T
{
	if a < b {
		return b;
	}
	return a;
}

fn main() -> int
{
	let v = larger(Vec4.splat(1.0), Vec4.splat(2.0));
	return 0;
}
