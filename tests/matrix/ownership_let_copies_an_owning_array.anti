//! `let` of a local that holds an array of owning values. The copy would give
//! what the value owns two owners, and `dup` is the copy.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

fn main() -> int
{
	let a = row(1);
	let b = a;
	return 0;
}
