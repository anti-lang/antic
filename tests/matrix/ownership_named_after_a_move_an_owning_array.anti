//! A local that holds an array of owning values, named after it moved into an
//! `own` parameter. The function took the value over and tore it down.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

fn take(own x: [2]Key) -> int
{
	return x[0].n;
}

fn main() -> int
{
	let a = row(1);
	let n = take(a);
	return n + take(a);
}
