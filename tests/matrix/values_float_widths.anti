//! `as` between `f32` and `f64`: a value that `f32` holds inexactly, one past
//! its range, one below its smallest, a tie between two neighbours, a NaN and
//! an infinity. Each line holds the value the checker folds in a constant and
//! the value the program computes. The last two lines hold one literal just
//! above a tie: as an `f32` literal it is rounded once, and before `as f32` it
//! is an `f64` first.

extern fn printf(format: ?*byte, ...) -> c_int;

fn run(one: f64)
{
	const A0: f64 = 0.1;
	const F0: f32 = A0 as f32;
	let a0: f64 = 0.1 * one;
	let r0: f32 = a0 as f32;
	printf("as f32 0.10000000000000001 = %.17g %.17g\n".ptr, F0 as f64, r0 as f64);
	const A1: f64 = 1.0e40;
	const F1: f32 = A1 as f32;
	let a1: f64 = 1.0e40 * one;
	let r1: f32 = a1 as f32;
	printf("as f32 1e+40 = %.17g %.17g\n".ptr, F1 as f64, r1 as f64);
	const A2: f64 = -1.0e40;
	const F2: f32 = A2 as f32;
	let a2: f64 = -1.0e40 * one;
	let r2: f32 = a2 as f32;
	printf("as f32 -1e+40 = %.17g %.17g\n".ptr, F2 as f64, r2 as f64);
	const A3: f64 = 1.0e-50;
	const F3: f32 = A3 as f32;
	let a3: f64 = 1.0e-50 * one;
	let r3: f32 = a3 as f32;
	printf("as f32 1e-50 = %.17g %.17g\n".ptr, F3 as f64, r3 as f64);
	const A4: f64 = -0.0;
	const F4: f32 = A4 as f32;
	let a4: f64 = -0.0 * one;
	let r4: f32 = a4 as f32;
	printf("as f32 -0 = %.17g %.17g\n".ptr, F4 as f64, r4 as f64);
	const A5: f64 = 0.0 / 0.0;
	const F5: f32 = A5 as f32;
	let a5: f64 = (one - one) / (one - one);
	let r5: f32 = a5 as f32;
	printf("as f32 nan = nan %d %d\n".ptr, (F5 != F5) as c_int, (r5 != r5) as c_int);
	const A6: f64 = 1.0 / 0.0;
	const F6: f32 = A6 as f32;
	let a6: f64 = one / (one - one);
	let r6: f32 = a6 as f32;
	printf("as f32 inf = %.17g %.17g\n".ptr, F6 as f64, r6 as f64);
	const A7: f64 = 16777217.0;
	const F7: f32 = A7 as f32;
	let a7: f64 = 16777217.0 * one;
	let r7: f32 = a7 as f32;
	printf("as f32 16777217 = %.17g %.17g\n".ptr, F7 as f64, r7 as f64);
	const A8: f64 = 3.4028234663852886e38;
	const F8: f32 = A8 as f32;
	let a8: f64 = 3.4028234663852886e38 * one;
	let r8: f32 = a8 as f32;
	printf("as f32 3.4028234663852886e+38 = %.17g %.17g\n".ptr, F8 as f64, r8 as f64);
	const A9: f64 = 1.0000000596046448;
	const F9: f32 = A9 as f32;
	let a9: f64 = 1.0000000596046448 * one;
	let r9: f32 = a9 as f32;
	printf("as f32 1.0000000596046448 = %.17g %.17g\n".ptr, F9 as f64, r9 as f64);
	const A10: f64 = 1.0000000596046450;
	const F10: f32 = A10 as f32;
	let a10: f64 = 1.0000000596046450 * one;
	let r10: f32 = a10 as f32;
	printf("as f32 1.000000059604645 = %.17g %.17g\n".ptr, F10 as f64, r10 as f64);
	const A11: f64 = 1.0e-45;
	const F11: f32 = A11 as f32;
	let a11: f64 = 1.0e-45 * one;
	let r11: f32 = a11 as f32;
	printf("as f32 9.9999999999999998e-46 = %.17g %.17g\n".ptr, F11 as f64, r11 as f64);
	const A12: f64 = 0.5;
	const F12: f32 = A12 as f32;
	let a12: f64 = 0.5 * one;
	let r12: f32 = a12 as f32;
	printf("as f32 0.5 = %.17g %.17g\n".ptr, F12 as f64, r12 as f64);
	const A13: f32 = 0.1;
	const F13: f64 = A13 as f64;
	let a13: f32 = 0.1 * (one as f32);
	let r13: f64 = a13 as f64;
	printf("as f64 f32 0.1 = %.17g %.17g\n".ptr, F13 as f64, r13 as f64);
	const A14: f32 = 16777216.0;
	const F14: f64 = A14 as f64;
	let a14: f32 = 16777216.0 * (one as f32);
	let r14: f64 = a14 as f64;
	printf("as f64 f32 16777216.0 = %.17g %.17g\n".ptr, F14 as f64, r14 as f64);
	const A15: f32 = 3.4028235e38;
	const F15: f64 = A15 as f64;
	let a15: f32 = 3.4028235e38 * (one as f32);
	let r15: f64 = a15 as f64;
	printf("as f64 f32 3.4028235e38 = %.17g %.17g\n".ptr, F15 as f64, r15 as f64);
	const A16: f32 = 1.0e-45;
	const F16: f64 = A16 as f64;
	let a16: f32 = 1.0e-45 * (one as f32);
	let r16: f64 = a16 as f64;
	printf("as f64 f32 1.0e-45 = %.17g %.17g\n".ptr, F16 as f64, r16 as f64);
	const A17: f32 = -0.0;
	const F17: f64 = A17 as f64;
	let a17: f32 = -0.0 * (one as f32);
	let r17: f64 = a17 as f64;
	printf("as f64 f32 -0.0 = %.17g %.17g\n".ptr, F17 as f64, r17 as f64);
	const DIRECT: f32 = 1.0000000596046447753906250000001;
	const TWICE: f32 = 1.0000000596046447753906250000001 as f32;
	let direct: f32 = 1.0000000596046447753906250000001 * (one as f32);
	let twice: f32 = (1.0000000596046447753906250000001 * one) as f32;
	printf("literal f32 = %.17g %.17g\n".ptr, DIRECT as f64, direct as f64);
	printf("literal f64 as f32 = %.17g %.17g\n".ptr, TWICE as f64, twice as f64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	run((zero + 1) as f64);
	return 0;
}
