//! C3 of the compile-time checks: a `may fail` function with a result reaches
//! its end without `return` or `fail`. A `while true` whose `break` stands in
//! the `else` of a `let` in a `switch` arm.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

extern fn exit(status: c_int) -> never;

fn value(n: int) -> int may fail
{
	if n > 2 {
		fail lang.Error.new(n, "refused");
	}
	return n;
}

fn stop(n: int) -> never
{
	exit(n as c_int);
}

fn f(p: ?*int, n: int) -> int may fail
{
	while true do {
		switch n {
			1 => {
				let v = p else {
					break;
				};
				n += *v;
			},
			else => {
				fail "no value";
			},
		}
	}
}

fn main() -> int
{
	return 0;
}
