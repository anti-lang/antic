//! `alloc C { }` of a class whose `align(N)` lies above 16 gives an object at a
//! multiple of N, as `alloc(T, n)` does by R050 of "Rules of 2026-10-13". A
//! block of one byte stands between two objects, so the memory of `malloc`
//! would move each by 16. The line counts the objects that stand elsewhere.

extern fn printf(format: ?*byte, ...) -> c_int;

union Address
{
	p: ?*byte,
	n: u64,
}

class Wide align(64)
{
	pub a: u8 = 7,
}

fn main() -> int
{
	let bad = 0;
	for i in 0..8 {
		let pad = alloc(u8, 1);
		let o = alloc Wide { };
		let a = Address { p: o as *byte };
		if a.n % 64 != 0 {
			bad += 1;
		}
		delete(o);
		free(pad);
	}
	printf("misaligned %lld\n".ptr, bad);
	return 0;
}
