//! C3 in a worker: the `else` of a `let` in a worker reaches its end without
//! leaving.

fn first(part: []int) -> ?int
{
	if part.len == 0 {
		return none;
	}
	return part[0];
}

worker fn tally(part: []int) -> int
{
	let total = 0;
	let v = first(part) else {
		total += 1;
	};
	return total + v;
}

fn main() -> int
{
	let room = alloc([2]int, 1) else {
		return 1;
	};
	(*room)[0] = 1;
	(*room)[1] = 2;
	let sums = parallel (*room)[0..2] by 2 -> tally;
	let n = sums[0] + sums[1];
	free(sums.ptr);
	free(room);
	return n - 3;
}
