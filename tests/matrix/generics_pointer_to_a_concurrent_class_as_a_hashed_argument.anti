//! A pointer to a concurrent class without a hash of its own meets no `hash`,
//! since `x.hash()` on it calls the hash the class lacks.

concurrent class Tally
{
	pub atomic hits: int = 0,
}

fn key<T: hash>(x: T) -> u64
{
	return x.hash();
}

fn main() -> int
{
	let a = alloc Tally { };
	let k = key(a);
	delete(a);
	if k == 0 {
		return 1;
	}
	return 0;
}
