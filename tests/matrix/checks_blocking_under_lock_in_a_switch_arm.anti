//! C5 in a switch arm: a `recv` in an arm inside a `sync` block may wait while
//! the block holds its lock.

struct Inbox
{
	lock: Mutex,
	count: int,
}

fn work(box: *Inbox, c: chan int, k: int)
{
	sync box.lock {
		switch k {
			1 => {
				let v = recv(c) else {
					return;
				};
				box.count += *v;
			},
			else => {
				box.count = -1;
			},
		}
	}
}

fn main() -> int
{
	let box = Inbox { count: 0 };
	let c = chan int(1);
	send(c, 4);
	work(&box, c, 1);
	delete(c);
	return box.count - 4;
}
