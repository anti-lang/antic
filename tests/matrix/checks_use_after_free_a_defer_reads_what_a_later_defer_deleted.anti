//! E2 and two defers: they run in the reverse order, so the second deletes the
//! node before the first reads it, on every run.

extern fn printf(format: ?*byte, ...) -> c_int;

class Node
{
	pub n: int = 0,
}

fn main() -> int
{
	let p = alloc Node { n: 1 };
	defer {
		printf("%d\n".ptr, p.n);
	}
	defer {
		delete(p);
	}
	return 0;
}
