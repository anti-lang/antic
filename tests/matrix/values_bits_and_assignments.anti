class Outer_compound_wrapping
{
	class Inner_compound_wrapping
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let w: u8 = 250;
			w +%= n as u8 * 3;
			w -%= 10;
			w *%= 3;
			w <<%= 1;
			let s: i8 = 120;
			s +|= n as i8 * 3;
			s -|= 100;
			s *|= 5;
			acc += w as int + s as int;
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_compound_wrapping { base: 1000 };
		return inner.run(n);
	}
}

