//! The shifts, the bitwise operators, the comparisons and the assignments of
//! the values area, each in every place its row of docs/notes/test-matrix.md
//! left open: shift, bitwise, compare, assign, compound, compound_wrapping.
//! Each construct in each place is a function of its own, named after both, and
//! the program prints one line per construct, place and input.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Task
{
	pub n: int = 0,
}

class Box_shift
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		let neg = 0 - 256;
		acc += (n << 3) + (256 >> n) + (neg >> n);
		return acc;
	}
}

fn in_arm_shift(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let neg = 0 - 256;
			acc += (n << 3) + (256 >> n) + (neg >> n);
		},
	}
	return acc;
}

fn held_shift(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_shift(n: int) -> int
{
	let acc = 0;
	if let v = held_shift(n) {
		acc += v - n * 3;
		let neg = 0 - 256;
		acc += (n << 3) + (256 >> n) + (neg >> n);
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_shift(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let neg = 0 - 256;
		acc += (n << 3) + (256 >> n) + (neg >> n);
	}
	acc = 5;
}

fn in_undo_shift(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let neg = 0 - 256;
		acc += (n << 3) + (256 >> n) + (neg >> n);
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_shift(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_shift(n: int) -> int
{
	let acc = 0;
	let got = risky_shift(n) catch {
		let neg = 0 - 256;
		acc += (n << 3) + (256 >> n) + (neg >> n);
		yield acc;
	};
	return got;
}

fn apply_shift(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_shift(start: int) -> int
{
	let acc = 0;
	let got = apply_shift(start, fn(n) {
		let neg = 0 - 256;
		acc += (n << 3) + (256 >> n) + (neg >> n);
		return acc;
	});
	return got + acc;
}

worker fn in_worker_shift(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let neg = 0 - 256;
	acc += (n << 3) + (256 >> n) + (neg >> n);
	return acc;
}

worker fn work_shift(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_shift(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_shift(fn(n) {
		let acc = 0;
		let neg = 0 - 256;
		acc += (n << 3) + (256 >> n) + (neg >> n);
		return acc;
	});
	return join(job);
}

struct Guarded_shift
{
	lock: Mutex,
	entered: int,
}

fn in_sync_shift(g: *Guarded_shift, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let neg = 0 - 256;
		acc += (n << 3) + (256 >> n) + (neg >> n);
	}
	return acc;
}

fn in_select_shift(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let neg = 0 - 256;
			acc += (n << 3) + (256 >> n) + (neg >> n);
		},
	}
	return acc;
}

class Outer_shift
{
	class Inner_shift
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let neg = 0 - 256;
			acc += (n << 3) + (256 >> n) + (neg >> n);
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_shift { base: 1000 };
		return inner.run(n);
	}
}

fn in_arm_bitwise(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
		},
	}
	return acc;
}

fn held_bitwise(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_bitwise(n: int) -> int
{
	let acc = 0;
	if let v = held_bitwise(n) {
		acc += v - n * 3;
		acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_bitwise(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
	}
	acc = 5;
}

fn in_undo_bitwise(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_bitwise(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_bitwise(n: int) -> int
{
	let acc = 0;
	let got = risky_bitwise(n) catch {
		acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
		yield acc;
	};
	return got;
}

fn apply_bitwise(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_bitwise(start: int) -> int
{
	let acc = 0;
	let got = apply_bitwise(start, fn(n) {
		acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
		return acc;
	});
	return got + acc;
}

worker fn in_worker_bitwise(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
	return acc;
}

worker fn work_bitwise(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_bitwise(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_bitwise(fn(n) {
		let acc = 0;
		acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
		return acc;
	});
	return join(job);
}

struct Guarded_bitwise
{
	lock: Mutex,
	entered: int,
}

fn in_sync_bitwise(g: *Guarded_bitwise, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
	}
	return acc;
}

fn in_select_bitwise(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
		},
	}
	return acc;
}

fn in_generic_bitwise<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
	return acc;
}

class Outer_bitwise
{
	class Inner_bitwise
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			acc += (n & 6) + (n | 8) + (n ^ 5) + (~n & 0xf);
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_bitwise { base: 1000 };
		return inner.run(n);
	}
}

fn held_compare(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_compare(n: int) -> int
{
	let acc = 0;
	if let v = held_compare(n) {
		acc += v - n * 3;
		acc += (n == 2) as int + (n != 2) as int * 2 + (n < 3) as int * 4 + (n <= 3) as int * 8 + (n > 1) as int * 16 + (n >= 4) as int * 32;
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_compare(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		acc += (n == 2) as int + (n != 2) as int * 2 + (n < 3) as int * 4 + (n <= 3) as int * 8 + (n > 1) as int * 16 + (n >= 4) as int * 32;
	}
	acc = 5;
}

fn in_undo_compare(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		acc += (n == 2) as int + (n != 2) as int * 2 + (n < 3) as int * 4 + (n <= 3) as int * 8 + (n > 1) as int * 16 + (n >= 4) as int * 32;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

worker fn work_compare(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_compare(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_compare(fn(n) {
		let acc = 0;
		acc += (n == 2) as int + (n != 2) as int * 2 + (n < 3) as int * 4 + (n <= 3) as int * 8 + (n > 1) as int * 16 + (n >= 4) as int * 32;
		return acc;
	});
	return join(job);
}

fn in_select_compare(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			acc += (n == 2) as int + (n != 2) as int * 2 + (n < 3) as int * 4 + (n <= 3) as int * 8 + (n > 1) as int * 16 + (n >= 4) as int * 32;
		},
	}
	return acc;
}

fn held_assign(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_assign(n: int) -> int
{
	let acc = 0;
	if let v = held_assign(n) {
		acc += v - n * 3;
		let x = 0;
		x = n * 3;
		let p = &x;
		*p = x + 1;
		acc = acc + x;
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_assign(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let x = 0;
		x = n * 3;
		let p = &x;
		*p = x + 1;
		acc = acc + x;
	}
	acc = 5;
}

fn in_undo_assign(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let x = 0;
		x = n * 3;
		let p = &x;
		*p = x + 1;
		acc = acc + x;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

worker fn work_assign(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_assign(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_assign(fn(n) {
		let acc = 0;
		let x = 0;
		x = n * 3;
		let p = &x;
		*p = x + 1;
		acc = acc + x;
		return acc;
	});
	return join(job);
}

fn in_select_assign(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let x = 0;
			x = n * 3;
			let p = &x;
			*p = x + 1;
			acc = acc + x;
		},
	}
	return acc;
}

fn held_compound(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_compound(n: int) -> int
{
	let acc = 0;
	if let v = held_compound(n) {
		acc += v - n * 3;
		let x = n;
		x += 5;
		x -= 1;
		x *= 3;
		x /= 2;
		x %= 7;
		x <<= 2;
		x >>= 1;
		x |= 8;
		x &= 0xff;
		x ^= 1;
		acc += x;
	} else {
		acc = -1;
	}
	return acc;
}

fn in_undo_compound(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let x = n;
		x += 5;
		x -= 1;
		x *= 3;
		x /= 2;
		x %= 7;
		x <<= 2;
		x >>= 1;
		x |= 8;
		x &= 0xff;
		x ^= 1;
		acc += x;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

worker fn work_compound(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_compound(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_compound(fn(n) {
		let acc = 0;
		let x = n;
		x += 5;
		x -= 1;
		x *= 3;
		x /= 2;
		x %= 7;
		x <<= 2;
		x >>= 1;
		x |= 8;
		x &= 0xff;
		x ^= 1;
		acc += x;
		return acc;
	});
	return join(job);
}

class Outer_compound
{
	class Inner_compound
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let x = n;
			x += 5;
			x -= 1;
			x *= 3;
			x /= 2;
			x %= 7;
			x <<= 2;
			x >>= 1;
			x |= 8;
			x &= 0xff;
			x ^= 1;
			acc += x;
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_compound { base: 1000 };
		return inner.run(n);
	}
}

class Box_compound_wrapping
{
	pub base: int = 0,

	pub fn run(self, n: int) -> int
	{
		let acc = self.base;
		let w: u8 = 250;
		w +%= n as u8 * 3;
		w -%= 10;
		w *%= 3;
		w <<%= 1;
		let s: i8 = 120;
		s +|= n as i8 * 3;
		s -|= 100;
		s *|= 5;
		acc += w as int + s as int;
		return acc;
	}
}

fn in_arm_compound_wrapping(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let w: u8 = 250;
			w +%= n as u8 * 3;
			w -%= 10;
			w *%= 3;
			w <<%= 1;
			let s: i8 = 120;
			s +|= n as i8 * 3;
			s -|= 100;
			s *|= 5;
			acc += w as int + s as int;
		},
	}
	return acc;
}

fn held_compound_wrapping(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_compound_wrapping(n: int) -> int
{
	let acc = 0;
	if let v = held_compound_wrapping(n) {
		acc += v - n * 3;
		let w: u8 = 250;
		w +%= n as u8 * 3;
		w -%= 10;
		w *%= 3;
		w <<%= 1;
		let s: i8 = 120;
		s +|= n as i8 * 3;
		s -|= 100;
		s *|= 5;
		acc += w as int + s as int;
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_compound_wrapping(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let w: u8 = 250;
		w +%= n as u8 * 3;
		w -%= 10;
		w *%= 3;
		w <<%= 1;
		let s: i8 = 120;
		s +|= n as i8 * 3;
		s -|= 100;
		s *|= 5;
		acc += w as int + s as int;
	}
	acc = 5;
}

fn in_undo_compound_wrapping(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let w: u8 = 250;
		w +%= n as u8 * 3;
		w -%= 10;
		w *%= 3;
		w <<%= 1;
		let s: i8 = 120;
		s +|= n as i8 * 3;
		s -|= 100;
		s *|= 5;
		acc += w as int + s as int;
	}
	acc = 5;
	*out = -1;
