		printf("compound_wrapping worker %d\n".ptr, join(job2) as c_int);
		task.n = 4;
		let job3 = dispatch task -> in_worker_compound_wrapping();
		printf("compound_wrapping worker %d\n".ptr, join(job3) as c_int);
		printf("compound_wrapping dispatch %d\n".ptr, in_dispatch_compound_wrapping(task, 1) as c_int);
		printf("compound_wrapping dispatch %d\n".ptr, in_dispatch_compound_wrapping(task, 2) as c_int);
		printf("compound_wrapping dispatch %d\n".ptr, in_dispatch_compound_wrapping(task, 3) as c_int);
		printf("compound_wrapping dispatch %d\n".ptr, in_dispatch_compound_wrapping(task, 4) as c_int);
		let g = Guarded_compound_wrapping { lock: Mutex.new(), entered: 0 };
		printf("compound_wrapping sync %d\n".ptr, in_sync_compound_wrapping(&g, 1) as c_int);
		printf("compound_wrapping sync %d\n".ptr, in_sync_compound_wrapping(&g, 2) as c_int);
		printf("compound_wrapping sync %d\n".ptr, in_sync_compound_wrapping(&g, 3) as c_int);
		printf("compound_wrapping sync %d\n".ptr, in_sync_compound_wrapping(&g, 4) as c_int);
		printf("compound_wrapping sync entered %d\n".ptr, g.entered as c_int);
		g.lock.destroy();
		let c = chan int(1);
		printf("compound_wrapping select %d\n".ptr, in_select_compound_wrapping(c, 1) as c_int);
		printf("compound_wrapping select %d\n".ptr, in_select_compound_wrapping(c, 2) as c_int);
		printf("compound_wrapping select %d\n".ptr, in_select_compound_wrapping(c, 3) as c_int);
		printf("compound_wrapping select %d\n".ptr, in_select_compound_wrapping(c, 4) as c_int);
		delete(c);
		printf("compound_wrapping generic %d %d\n".ptr, in_generic_compound_wrapping<int>(1) as c_int,
			in_generic_compound_wrapping<str>(1) as c_int);
		printf("compound_wrapping generic %d %d\n".ptr, in_generic_compound_wrapping<int>(2) as c_int,
			in_generic_compound_wrapping<str>(2) as c_int);
		printf("compound_wrapping generic %d %d\n".ptr, in_generic_compound_wrapping<int>(3) as c_int,
			in_generic_compound_wrapping<str>(3) as c_int);
		printf("compound_wrapping generic %d %d\n".ptr, in_generic_compound_wrapping<int>(4) as c_int,
			in_generic_compound_wrapping<str>(4) as c_int);
		let outer = Outer_compound_wrapping { };
		printf("compound_wrapping nested %d\n".ptr, outer.go(1) as c_int);
		printf("compound_wrapping nested %d\n".ptr, outer.go(2) as c_int);
		printf("compound_wrapping nested %d\n".ptr, outer.go(3) as c_int);
		printf("compound_wrapping nested %d\n".ptr, outer.go(4) as c_int);
	}
	delete(task);
	return 0;
}
