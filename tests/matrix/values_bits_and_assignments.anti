fn risky_compound_wrapping(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_compound_wrapping(n: int) -> int
{
	let acc = 0;
	let got = risky_compound_wrapping(n) catch {
		let w: u8 = 250;
		w +%= n as u8 * 3;
		w -%= 10;
		w *%= 3;
		w <<%= 1;
		let s: i8 = 120;
		s +|= n as i8 * 3;
		s -|= 100;
		s *|= 5;
		acc += w as int + s as int;
		yield acc;
	};
	return got;
}

fn apply_compound_wrapping(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_compound_wrapping(start: int) -> int
{
	let acc = 0;
	let got = apply_compound_wrapping(start, fn(n) {
		let w: u8 = 250;
		w +%= n as u8 * 3;
		w -%= 10;
		w *%= 3;
		w <<%= 1;
		let s: i8 = 120;
		s +|= n as i8 * 3;
		s -|= 100;
		s *|= 5;
		acc += w as int + s as int;
		return acc;
	});
	return got + acc;
}

