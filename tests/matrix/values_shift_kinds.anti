	const F8: u16 = 3 >> 0;
	let r8: u16 = (3 ^ z) >> (0 ^ z);
	printf("shr u16 3 0 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
	const F9: u16 = 1 >> 1;
	let r9: u16 = (1 ^ z) >> (1 ^ z);
	printf("shr u16 1 1 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
}

fn on_u32(z: u32)
{
	const F0: u32 = 1 << 31;
	let r0: u32 = (1 ^ z) << (31 ^ z);
	printf("shl u32 1 31 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: u32 = 4294967295 << 1;
	let r1: u32 = (4294967295 ^ z) << (1 ^ z);
	printf("shl u32 4294967295 1 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: u32 = 4294967295 << 31;
	let r2: u32 = (4294967295 ^ z) << (31 ^ z);
	printf("shl u32 4294967295 31 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: u32 = 3 << 0;
	let r3: u32 = (3 ^ z) << (0 ^ z);
	printf("shl u32 3 0 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: u32 = 1 << 1;
	let r4: u32 = (1 ^ z) << (1 ^ z);
	printf("shl u32 1 1 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: u32 = 1 >> 31;
	let r5: u32 = (1 ^ z) >> (31 ^ z);
	printf("shr u32 1 31 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: u32 = 4294967295 >> 1;
	let r6: u32 = (4294967295 ^ z) >> (1 ^ z);
	printf("shr u32 4294967295 1 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: u32 = 4294967295 >> 31;
	let r7: u32 = (4294967295 ^ z) >> (31 ^ z);
	printf("shr u32 4294967295 31 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	const F8: u32 = 3 >> 0;
	let r8: u32 = (3 ^ z) >> (0 ^ z);
	printf("shr u32 3 0 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
	const F9: u32 = 1 >> 1;
	let r9: u32 = (1 ^ z) >> (1 ^ z);
	printf("shr u32 1 1 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
}

fn on_u64(z: u64)
{
	const F0: u64 = 1 << 63;
	let r0: u64 = (1 ^ z) << (63 ^ z);
	printf("shl u64 1 63 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: u64 = 18446744073709551615 << 1;
	let r1: u64 = (18446744073709551615 ^ z) << (1 ^ z);
	printf("shl u64 18446744073709551615 1 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: u64 = 18446744073709551615 << 63;
	let r2: u64 = (18446744073709551615 ^ z) << (63 ^ z);
	printf("shl u64 18446744073709551615 63 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: u64 = 3 << 0;
	let r3: u64 = (3 ^ z) << (0 ^ z);
	printf("shl u64 3 0 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: u64 = 1 << 1;
	let r4: u64 = (1 ^ z) << (1 ^ z);
	printf("shl u64 1 1 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: u64 = 1 >> 63;
	let r5: u64 = (1 ^ z) >> (63 ^ z);
	printf("shr u64 1 63 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: u64 = 18446744073709551615 >> 1;
	let r6: u64 = (18446744073709551615 ^ z) >> (1 ^ z);
	printf("shr u64 18446744073709551615 1 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: u64 = 18446744073709551615 >> 63;
	let r7: u64 = (18446744073709551615 ^ z) >> (63 ^ z);
	printf("shr u64 18446744073709551615 63 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	const F8: u64 = 3 >> 0;
	let r8: u64 = (3 ^ z) >> (0 ^ z);
	printf("shr u64 3 0 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
	const F9: u64 = 1 >> 1;
	let r9: u64 = (1 ^ z) >> (1 ^ z);
	printf("shr u64 1 1 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
}

fn on_uint(z: uint)
{
	const F0: uint = 1 << 63;
	let r0: uint = (1 ^ z) << (63 ^ z);
	printf("shl uint 1 63 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: uint = 18446744073709551615 << 1;
	let r1: uint = (18446744073709551615 ^ z) << (1 ^ z);
	printf("shl uint 18446744073709551615 1 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: uint = 18446744073709551615 << 63;
	let r2: uint = (18446744073709551615 ^ z) << (63 ^ z);
	printf("shl uint 18446744073709551615 63 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: uint = 3 << 0;
	let r3: uint = (3 ^ z) << (0 ^ z);
	printf("shl uint 3 0 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: uint = 1 << 1;
	let r4: uint = (1 ^ z) << (1 ^ z);
	printf("shl uint 1 1 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: uint = 1 >> 63;
	let r5: uint = (1 ^ z) >> (63 ^ z);
	printf("shr uint 1 63 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: uint = 18446744073709551615 >> 1;
	let r6: uint = (18446744073709551615 ^ z) >> (1 ^ z);
	printf("shr uint 18446744073709551615 1 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: uint = 18446744073709551615 >> 63;
	let r7: uint = (18446744073709551615 ^ z) >> (63 ^ z);
	printf("shr uint 18446744073709551615 63 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	const F8: uint = 3 >> 0;
	let r8: uint = (3 ^ z) >> (0 ^ z);
	printf("shr uint 3 0 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
	const F9: uint = 1 >> 1;
	let r9: uint = (1 ^ z) >> (1 ^ z);
	printf("shr uint 1 1 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
}

fn on_byte(z: byte)
{
	const F0: byte = 1 << 7;
	let r0: byte = (1 ^ z) << (7 ^ z);
	printf("shl byte 1 7 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: byte = 255 << 1;
	let r1: byte = (255 ^ z) << (1 ^ z);
	printf("shl byte 255 1 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: byte = 255 << 7;
	let r2: byte = (255 ^ z) << (7 ^ z);
	printf("shl byte 255 7 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: byte = 3 << 0;
	let r3: byte = (3 ^ z) << (0 ^ z);
	printf("shl byte 3 0 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: byte = 1 << 1;
	let r4: byte = (1 ^ z) << (1 ^ z);
	printf("shl byte 1 1 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: byte = 1 >> 7;
	let r5: byte = (1 ^ z) >> (7 ^ z);
	printf("shr byte 1 7 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: byte = 255 >> 1;
	let r6: byte = (255 ^ z) >> (1 ^ z);
	printf("shr byte 255 1 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: byte = 255 >> 7;
	let r7: byte = (255 ^ z) >> (7 ^ z);
	printf("shr byte 255 7 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	const F8: byte = 3 >> 0;
	let r8: byte = (3 ^ z) >> (0 ^ z);
	printf("shr byte 3 0 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
	const F9: byte = 1 >> 1;
	let r9: byte = (1 ^ z) >> (1 ^ z);
	printf("shr byte 1 1 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	on_i8(zero as i8);
	on_i16(zero as i16);
	on_i32(zero as i32);
	on_i64(zero as i64);
	on_int(zero as int);
	on_u8(zero as u8);
	on_u16(zero as u16);
	on_u32(zero as u32);
	on_u64(zero as u64);
	on_uint(zero as uint);
	on_byte(zero as byte);
	return 0;
}
