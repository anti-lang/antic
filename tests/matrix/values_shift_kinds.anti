	const F6: u16 = 65535 >> 1;
	let r6: u16 = (65535 ^ z) >> (1 ^ z);
	printf("shr u16 65535 1 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: u16 = 65535 >> 15;
	let r7: u16 = (65535 ^ z) >> (15 ^ z);
