fn on_int(z: int)
{
	const F0: int = 1 << 63;
	let r0: int = (1 ^ z) << (63 ^ z);
	printf("shl int 1 63 = %lld %lld\n".ptr, F0 as int, r0 as int);
	const F1: int = 9223372036854775807 << 1;
	let r1: int = (9223372036854775807 ^ z) << (1 ^ z);
	printf("shl int 9223372036854775807 1 = %lld %lld\n".ptr, F1 as int, r1 as int);
	const F2: int = 9223372036854775807 << 63;
	let r2: int = (9223372036854775807 ^ z) << (63 ^ z);
	printf("shl int 9223372036854775807 63 = %lld %lld\n".ptr, F2 as int, r2 as int);
	const F3: int = 3 << 0;
	let r3: int = (3 ^ z) << (0 ^ z);
	printf("shl int 3 0 = %lld %lld\n".ptr, F3 as int, r3 as int);
	const F4: int = 1 << 1;
	let r4: int = (1 ^ z) << (1 ^ z);
	printf("shl int 1 1 = %lld %lld\n".ptr, F4 as int, r4 as int);
	const F5: int = -9223372036854775808 << 63;
	let r5: int = (-9223372036854775808 ^ z) << (63 ^ z);
	printf("shl int -9223372036854775808 63 = %lld %lld\n".ptr, F5 as int, r5 as int);
	const F6: int = -8 << 1;
	let r6: int = (-8 ^ z) << (1 ^ z);
	printf("shl int -8 1 = %lld %lld\n".ptr, F6 as int, r6 as int);
	const F7: int = -1 << 63;
	let r7: int = (-1 ^ z) << (63 ^ z);
	printf("shl int -1 63 = %lld %lld\n".ptr, F7 as int, r7 as int);
	const F8: int = -9223372036854775808 << 1;
	let r8: int = (-9223372036854775808 ^ z) << (1 ^ z);
	printf("shl int -9223372036854775808 1 = %lld %lld\n".ptr, F8 as int, r8 as int);
	const F9: int = 1 >> 63;
	let r9: int = (1 ^ z) >> (63 ^ z);
	printf("shr int 1 63 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: int = 9223372036854775807 >> 1;
	let r10: int = (9223372036854775807 ^ z) >> (1 ^ z);
	printf("shr int 9223372036854775807 1 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: int = 9223372036854775807 >> 63;
	let r11: int = (9223372036854775807 ^ z) >> (63 ^ z);
	printf("shr int 9223372036854775807 63 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: int = 3 >> 0;
	let r12: int = (3 ^ z) >> (0 ^ z);
	printf("shr int 3 0 = %lld %lld\n".ptr, F12 as int, r12 as int);
	const F13: int = 1 >> 1;
	let r13: int = (1 ^ z) >> (1 ^ z);
	printf("shr int 1 1 = %lld %lld\n".ptr, F13 as int, r13 as int);
	const F14: int = -9223372036854775808 >> 63;
	let r14: int = (-9223372036854775808 ^ z) >> (63 ^ z);
	printf("shr int -9223372036854775808 63 = %lld %lld\n".ptr, F14 as int, r14 as int);
	const F15: int = -8 >> 1;
	let r15: int = (-8 ^ z) >> (1 ^ z);
	printf("shr int -8 1 = %lld %lld\n".ptr, F15 as int, r15 as int);
	const F16: int = -1 >> 63;
	let r16: int = (-1 ^ z) >> (63 ^ z);
	printf("shr int -1 63 = %lld %lld\n".ptr, F16 as int, r16 as int);
	const F17: int = -9223372036854775808 >> 1;
