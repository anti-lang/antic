	x35 %= 2 ^ z;
	printf("rem i16 32767 2 = %lld\n".ptr, x35 as int);
	let x36: i16 = 7 ^ z;
	x36 %= 2 ^ z;
	printf("rem i16 7 2 = %lld\n".ptr, x36 as int);
