	x44 &= 1 ^ z;
	printf("and i16 -32768 1 = %lld\n".ptr, x44 as int);
	let x45: i16 = -32768 ^ z;
	x45 &= 32767 ^ z;
	printf("and i16 -32768 32767 = %lld\n".ptr, x45 as int);
	let x46: i16 = 32767 ^ z;
	x46 &= 2 ^ z;
	printf("and i16 32767 2 = %lld\n".ptr, x46 as int);
	let x47: i16 = 7 ^ z;
	x47 &= 2 ^ z;
	printf("and i16 7 2 = %lld\n".ptr, x47 as int);
	let x48: i16 = -32768 ^ z;
	x48 &= -32768 ^ z;
	printf("and i16 -32768 -32768 = %lld\n".ptr, x48 as int);
	let x49: i16 = -32768 ^ z;
	x49 &= -1 ^ z;
	printf("and i16 -32768 -1 = %lld\n".ptr, x49 as int);
	let x50: i16 = 32767 ^ z;
	x50 &= -1 ^ z;
	printf("and i16 32767 -1 = %lld\n".ptr, x50 as int);
	let x51: i16 = -7 ^ z;
	x51 &= 2 ^ z;
	printf("and i16 -7 2 = %lld\n".ptr, x51 as int);
	let x52: i16 = 7 ^ z;
	x52 &= -2 ^ z;
	printf("and i16 7 -2 = %lld\n".ptr, x52 as int);
	let x53: i16 = 32767 ^ z;
	x53 |= 1 ^ z;
	printf("or i16 32767 1 = %lld\n".ptr, x53 as int);
	let x54: i16 = 32767 ^ z;
	x54 |= 32767 ^ z;
	printf("or i16 32767 32767 = %lld\n".ptr, x54 as int);
	let x55: i16 = -32768 ^ z;
	x55 |= 1 ^ z;
	printf("or i16 -32768 1 = %lld\n".ptr, x55 as int);
