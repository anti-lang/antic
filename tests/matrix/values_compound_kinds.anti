	printf("div i16 -32768 -32768 = %lld\n".ptr, x32 as int);
	let x33: i16 = -32768 ^ z;
	x33 /= -1 ^ z;
	printf("div i16 -32768 -1 = %lld\n".ptr, x33 as int);
	let x34: i16 = 32767 ^ z;
	x34 /= -1 ^ z;
	printf("div i16 32767 -1 = %lld\n".ptr, x34 as int);
	let x35: i16 = -7 ^ z;
	x35 /= 2 ^ z;
	printf("div i16 -7 2 = %lld\n".ptr, x35 as int);
