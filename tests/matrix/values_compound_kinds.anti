	printf("shl_wrap uint 18446744073709551615 1 = %llu\n".ptr, x28 as u64);
	let x29: uint = 18446744073709551615 ^ z;
	x29 <<%= 63 ^ z;
	printf("shl_wrap uint 18446744073709551615 63 = %llu\n".ptr, x29 as u64);
	let x30: uint = 3 ^ z;
	x30 <<%= 0 ^ z;
	printf("shl_wrap uint 3 0 = %llu\n".ptr, x30 as u64);
	let x31: uint = 1 ^ z;
	x31 <<%= 1 ^ z;
	printf("shl_wrap uint 1 1 = %llu\n".ptr, x31 as u64);
	let x32: uint = 1 ^ z;
	x32 <<%= 64 ^ z;
	printf("shl_wrap uint 1 64 = %llu\n".ptr, x32 as u64);
	let x33: uint = 3 ^ z;
	x33 <<%= 65 ^ z;
	printf("shl_wrap uint 3 65 = %llu\n".ptr, x33 as u64);
	let x34: uint = 18446744073709551615 ^ z;
	x34 +|= 1 ^ z;
	printf("add_sat uint 18446744073709551615 1 = %llu\n".ptr, x34 as u64);
	let x35: uint = 18446744073709551615 ^ z;
	x35 +|= 18446744073709551615 ^ z;
	printf("add_sat uint 18446744073709551615 18446744073709551615 = %llu\n".ptr, x35 as u64);
	let x36: uint = 0 ^ z;
	x36 +|= 1 ^ z;
	printf("add_sat uint 0 1 = %llu\n".ptr, x36 as u64);
	let x37: uint = 0 ^ z;
	x37 +|= 18446744073709551615 ^ z;
	printf("add_sat uint 0 18446744073709551615 = %llu\n".ptr, x37 as u64);
	let x38: uint = 18446744073709551615 ^ z;
	x38 +|= 2 ^ z;
	printf("add_sat uint 18446744073709551615 2 = %llu\n".ptr, x38 as u64);
	let x39: uint = 7 ^ z;
	x39 +|= 2 ^ z;
	printf("add_sat uint 7 2 = %llu\n".ptr, x39 as u64);
	let x40: uint = 0 ^ z;
	x40 +|= 0 ^ z;
	printf("add_sat uint 0 0 = %llu\n".ptr, x40 as u64);
	let x41: uint = 0 ^ z;
	x41 +|= 1 ^ z;
	printf("add_sat uint 0 1 = %llu\n".ptr, x41 as u64);
	let x42: uint = 1 ^ z;
	x42 +|= 18446744073709551615 ^ z;
	printf("add_sat uint 1 18446744073709551615 = %llu\n".ptr, x42 as u64);
	let x43: uint = 18446744073709551615 ^ z;
	x43 -|= 1 ^ z;
	printf("sub_sat uint 18446744073709551615 1 = %llu\n".ptr, x43 as u64);
	let x44: uint = 18446744073709551615 ^ z;
	x44 -|= 18446744073709551615 ^ z;
	printf("sub_sat uint 18446744073709551615 18446744073709551615 = %llu\n".ptr, x44 as u64);
	let x45: uint = 0 ^ z;
	x45 -|= 1 ^ z;
	printf("sub_sat uint 0 1 = %llu\n".ptr, x45 as u64);
	let x46: uint = 0 ^ z;
	x46 -|= 18446744073709551615 ^ z;
	printf("sub_sat uint 0 18446744073709551615 = %llu\n".ptr, x46 as u64);
	let x47: uint = 18446744073709551615 ^ z;
	x47 -|= 2 ^ z;
	printf("sub_sat uint 18446744073709551615 2 = %llu\n".ptr, x47 as u64);
	let x48: uint = 7 ^ z;
	x48 -|= 2 ^ z;
	printf("sub_sat uint 7 2 = %llu\n".ptr, x48 as u64);
	let x49: uint = 0 ^ z;
	x49 -|= 0 ^ z;
	printf("sub_sat uint 0 0 = %llu\n".ptr, x49 as u64);
	let x50: uint = 0 ^ z;
	x50 -|= 1 ^ z;
	printf("sub_sat uint 0 1 = %llu\n".ptr, x50 as u64);
	let x51: uint = 1 ^ z;
	x51 -|= 18446744073709551615 ^ z;
	printf("sub_sat uint 1 18446744073709551615 = %llu\n".ptr, x51 as u64);
	let x52: uint = 18446744073709551615 ^ z;
	x52 *|= 1 ^ z;
	printf("mul_sat uint 18446744073709551615 1 = %llu\n".ptr, x52 as u64);
	let x53: uint = 18446744073709551615 ^ z;
	x53 *|= 18446744073709551615 ^ z;
	printf("mul_sat uint 18446744073709551615 18446744073709551615 = %llu\n".ptr, x53 as u64);
	let x54: uint = 0 ^ z;
	x54 *|= 1 ^ z;
	printf("mul_sat uint 0 1 = %llu\n".ptr, x54 as u64);
	let x55: uint = 0 ^ z;
	x55 *|= 18446744073709551615 ^ z;
	printf("mul_sat uint 0 18446744073709551615 = %llu\n".ptr, x55 as u64);
	let x56: uint = 18446744073709551615 ^ z;
	x56 *|= 2 ^ z;
	printf("mul_sat uint 18446744073709551615 2 = %llu\n".ptr, x56 as u64);
	let x57: uint = 7 ^ z;
	x57 *|= 2 ^ z;
	printf("mul_sat uint 7 2 = %llu\n".ptr, x57 as u64);
	let x58: uint = 0 ^ z;
	x58 *|= 0 ^ z;
	printf("mul_sat uint 0 0 = %llu\n".ptr, x58 as u64);
	let x59: uint = 0 ^ z;
	x59 *|= 1 ^ z;
	printf("mul_sat uint 0 1 = %llu\n".ptr, x59 as u64);
	let x60: uint = 1 ^ z;
	x60 *|= 18446744073709551615 ^ z;
	printf("mul_sat uint 1 18446744073709551615 = %llu\n".ptr, x60 as u64);
}

fn compound_wrapping_on_byte(z: byte)
{
	let x0: byte = 255 ^ z;
	x0 +%= 1 ^ z;
	printf("add_wrap byte 255 1 = %llu\n".ptr, x0 as u64);
	let x1: byte = 255 ^ z;
	x1 +%= 255 ^ z;
	printf("add_wrap byte 255 255 = %llu\n".ptr, x1 as u64);
	let x2: byte = 0 ^ z;
	x2 +%= 1 ^ z;
	printf("add_wrap byte 0 1 = %llu\n".ptr, x2 as u64);
	let x3: byte = 0 ^ z;
	x3 +%= 255 ^ z;
	printf("add_wrap byte 0 255 = %llu\n".ptr, x3 as u64);
	let x4: byte = 255 ^ z;
	x4 +%= 2 ^ z;
	printf("add_wrap byte 255 2 = %llu\n".ptr, x4 as u64);
	let x5: byte = 7 ^ z;
	x5 +%= 2 ^ z;
	printf("add_wrap byte 7 2 = %llu\n".ptr, x5 as u64);
	let x6: byte = 0 ^ z;
	x6 +%= 0 ^ z;
	printf("add_wrap byte 0 0 = %llu\n".ptr, x6 as u64);
	let x7: byte = 0 ^ z;
	x7 +%= 1 ^ z;
	printf("add_wrap byte 0 1 = %llu\n".ptr, x7 as u64);
	let x8: byte = 1 ^ z;
	x8 +%= 255 ^ z;
	printf("add_wrap byte 1 255 = %llu\n".ptr, x8 as u64);
	let x9: byte = 255 ^ z;
	x9 -%= 1 ^ z;
	printf("sub_wrap byte 255 1 = %llu\n".ptr, x9 as u64);
	let x10: byte = 255 ^ z;
	x10 -%= 255 ^ z;
	printf("sub_wrap byte 255 255 = %llu\n".ptr, x10 as u64);
	let x11: byte = 0 ^ z;
	x11 -%= 1 ^ z;
	printf("sub_wrap byte 0 1 = %llu\n".ptr, x11 as u64);
	let x12: byte = 0 ^ z;
	x12 -%= 255 ^ z;
	printf("sub_wrap byte 0 255 = %llu\n".ptr, x12 as u64);
	let x13: byte = 255 ^ z;
	x13 -%= 2 ^ z;
	printf("sub_wrap byte 255 2 = %llu\n".ptr, x13 as u64);
	let x14: byte = 7 ^ z;
	x14 -%= 2 ^ z;
	printf("sub_wrap byte 7 2 = %llu\n".ptr, x14 as u64);
	let x15: byte = 0 ^ z;
	x15 -%= 0 ^ z;
	printf("sub_wrap byte 0 0 = %llu\n".ptr, x15 as u64);
	let x16: byte = 0 ^ z;
	x16 -%= 1 ^ z;
	printf("sub_wrap byte 0 1 = %llu\n".ptr, x16 as u64);
	let x17: byte = 1 ^ z;
	x17 -%= 255 ^ z;
	printf("sub_wrap byte 1 255 = %llu\n".ptr, x17 as u64);
	let x18: byte = 255 ^ z;
	x18 *%= 1 ^ z;
	printf("mul_wrap byte 255 1 = %llu\n".ptr, x18 as u64);
	let x19: byte = 255 ^ z;
	x19 *%= 255 ^ z;
	printf("mul_wrap byte 255 255 = %llu\n".ptr, x19 as u64);
	let x20: byte = 0 ^ z;
	x20 *%= 1 ^ z;
	printf("mul_wrap byte 0 1 = %llu\n".ptr, x20 as u64);
	let x21: byte = 0 ^ z;
	x21 *%= 255 ^ z;
	printf("mul_wrap byte 0 255 = %llu\n".ptr, x21 as u64);
	let x22: byte = 255 ^ z;
	x22 *%= 2 ^ z;
	printf("mul_wrap byte 255 2 = %llu\n".ptr, x22 as u64);
	let x23: byte = 7 ^ z;
	x23 *%= 2 ^ z;
	printf("mul_wrap byte 7 2 = %llu\n".ptr, x23 as u64);
	let x24: byte = 0 ^ z;
	x24 *%= 0 ^ z;
	printf("mul_wrap byte 0 0 = %llu\n".ptr, x24 as u64);
	let x25: byte = 0 ^ z;
	x25 *%= 1 ^ z;
	printf("mul_wrap byte 0 1 = %llu\n".ptr, x25 as u64);
	let x26: byte = 1 ^ z;
	x26 *%= 255 ^ z;
	printf("mul_wrap byte 1 255 = %llu\n".ptr, x26 as u64);
	let x27: byte = 1 ^ z;
	x27 <<%= 7 ^ z;
	printf("shl_wrap byte 1 7 = %llu\n".ptr, x27 as u64);
	let x28: byte = 255 ^ z;
	x28 <<%= 1 ^ z;
	printf("shl_wrap byte 255 1 = %llu\n".ptr, x28 as u64);
	let x29: byte = 255 ^ z;
	x29 <<%= 7 ^ z;
	printf("shl_wrap byte 255 7 = %llu\n".ptr, x29 as u64);
	let x30: byte = 3 ^ z;
	x30 <<%= 0 ^ z;
	printf("shl_wrap byte 3 0 = %llu\n".ptr, x30 as u64);
	let x31: byte = 1 ^ z;
	x31 <<%= 1 ^ z;
	printf("shl_wrap byte 1 1 = %llu\n".ptr, x31 as u64);
	let x32: byte = 1 ^ z;
	x32 <<%= 8 ^ z;
	printf("shl_wrap byte 1 8 = %llu\n".ptr, x32 as u64);
	let x33: byte = 3 ^ z;
	x33 <<%= 9 ^ z;
	printf("shl_wrap byte 3 9 = %llu\n".ptr, x33 as u64);
	let x34: byte = 255 ^ z;
	x34 +|= 1 ^ z;
	printf("add_sat byte 255 1 = %llu\n".ptr, x34 as u64);
	let x35: byte = 255 ^ z;
	x35 +|= 255 ^ z;
	printf("add_sat byte 255 255 = %llu\n".ptr, x35 as u64);
	let x36: byte = 0 ^ z;
	x36 +|= 1 ^ z;
	printf("add_sat byte 0 1 = %llu\n".ptr, x36 as u64);
	let x37: byte = 0 ^ z;
	x37 +|= 255 ^ z;
	printf("add_sat byte 0 255 = %llu\n".ptr, x37 as u64);
	let x38: byte = 255 ^ z;
	x38 +|= 2 ^ z;
	printf("add_sat byte 255 2 = %llu\n".ptr, x38 as u64);
	let x39: byte = 7 ^ z;
	x39 +|= 2 ^ z;
	printf("add_sat byte 7 2 = %llu\n".ptr, x39 as u64);
	let x40: byte = 0 ^ z;
	x40 +|= 0 ^ z;
	printf("add_sat byte 0 0 = %llu\n".ptr, x40 as u64);
	let x41: byte = 0 ^ z;
	x41 +|= 1 ^ z;
	printf("add_sat byte 0 1 = %llu\n".ptr, x41 as u64);
	let x42: byte = 1 ^ z;
	x42 +|= 255 ^ z;
	printf("add_sat byte 1 255 = %llu\n".ptr, x42 as u64);
	let x43: byte = 255 ^ z;
	x43 -|= 1 ^ z;
	printf("sub_sat byte 255 1 = %llu\n".ptr, x43 as u64);
	let x44: byte = 255 ^ z;
	x44 -|= 255 ^ z;
	printf("sub_sat byte 255 255 = %llu\n".ptr, x44 as u64);
	let x45: byte = 0 ^ z;
	x45 -|= 1 ^ z;
	printf("sub_sat byte 0 1 = %llu\n".ptr, x45 as u64);
	let x46: byte = 0 ^ z;
	x46 -|= 255 ^ z;
	printf("sub_sat byte 0 255 = %llu\n".ptr, x46 as u64);
	let x47: byte = 255 ^ z;
	x47 -|= 2 ^ z;
	printf("sub_sat byte 255 2 = %llu\n".ptr, x47 as u64);
	let x48: byte = 7 ^ z;
	x48 -|= 2 ^ z;
	printf("sub_sat byte 7 2 = %llu\n".ptr, x48 as u64);
	let x49: byte = 0 ^ z;
	x49 -|= 0 ^ z;
	printf("sub_sat byte 0 0 = %llu\n".ptr, x49 as u64);
	let x50: byte = 0 ^ z;
	x50 -|= 1 ^ z;
	printf("sub_sat byte 0 1 = %llu\n".ptr, x50 as u64);
	let x51: byte = 1 ^ z;
	x51 -|= 255 ^ z;
	printf("sub_sat byte 1 255 = %llu\n".ptr, x51 as u64);
	let x52: byte = 255 ^ z;
	x52 *|= 1 ^ z;
	printf("mul_sat byte 255 1 = %llu\n".ptr, x52 as u64);
	let x53: byte = 255 ^ z;
	x53 *|= 255 ^ z;
	printf("mul_sat byte 255 255 = %llu\n".ptr, x53 as u64);
	let x54: byte = 0 ^ z;
	x54 *|= 1 ^ z;
	printf("mul_sat byte 0 1 = %llu\n".ptr, x54 as u64);
	let x55: byte = 0 ^ z;
	x55 *|= 255 ^ z;
	printf("mul_sat byte 0 255 = %llu\n".ptr, x55 as u64);
	let x56: byte = 255 ^ z;
	x56 *|= 2 ^ z;
	printf("mul_sat byte 255 2 = %llu\n".ptr, x56 as u64);
	let x57: byte = 7 ^ z;
	x57 *|= 2 ^ z;
	printf("mul_sat byte 7 2 = %llu\n".ptr, x57 as u64);
	let x58: byte = 0 ^ z;
	x58 *|= 0 ^ z;
	printf("mul_sat byte 0 0 = %llu\n".ptr, x58 as u64);
	let x59: byte = 0 ^ z;
	x59 *|= 1 ^ z;
	printf("mul_sat byte 0 1 = %llu\n".ptr, x59 as u64);
	let x60: byte = 1 ^ z;
	x60 *|= 255 ^ z;
	printf("mul_sat byte 1 255 = %llu\n".ptr, x60 as u64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	compound_on_i8(zero as i8);
	compound_on_i16(zero as i16);
	compound_on_i32(zero as i32);
	compound_on_i64(zero as i64);
	compound_on_int(zero as int);
	compound_on_u8(zero as u8);
	compound_on_u16(zero as u16);
	compound_on_u32(zero as u32);
	compound_on_u64(zero as u64);
	compound_on_uint(zero as uint);
	compound_on_byte(zero as byte);
	compound_wrapping_on_i8(zero as i8);
	compound_wrapping_on_i16(zero as i16);
	compound_wrapping_on_i32(zero as i32);
	compound_wrapping_on_i64(zero as i64);
	compound_wrapping_on_int(zero as int);
	compound_wrapping_on_u8(zero as u8);
	compound_wrapping_on_u16(zero as u16);
	compound_wrapping_on_u32(zero as u32);
	compound_wrapping_on_u64(zero as u64);
	compound_wrapping_on_uint(zero as uint);
	compound_wrapping_on_byte(zero as byte);
	return 0;
}
