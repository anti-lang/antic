//! The compound assignments `+= -= *= /= %= &= |= ^= <<= >>=` on every integer
//! type at its limits, from operands the program cannot know before it runs. A
//! case that would stop a dev build is left out.

extern fn printf(format: ?*byte, ...) -> c_int;

fn on_i8(z: i8)
{
	let x0: i8 = -128 ^ z;
	x0 += 1 ^ z;
	printf("add i8 -128 1 = %lld\n".ptr, x0 as int);
	let x1: i8 = -128 ^ z;
	x1 += 127 ^ z;
	printf("add i8 -128 127 = %lld\n".ptr, x1 as int);
	let x2: i8 = 7 ^ z;
	x2 += 2 ^ z;
	printf("add i8 7 2 = %lld\n".ptr, x2 as int);
	let x3: i8 = 127 ^ z;
	x3 += -1 ^ z;
	printf("add i8 127 -1 = %lld\n".ptr, x3 as int);
	let x4: i8 = -7 ^ z;
	x4 += 2 ^ z;
	printf("add i8 -7 2 = %lld\n".ptr, x4 as int);
	let x5: i8 = 7 ^ z;
	x5 += -2 ^ z;
	printf("add i8 7 -2 = %lld\n".ptr, x5 as int);
	let x6: i8 = -1 ^ z;
	x6 += -1 ^ z;
	printf("add i8 -1 -1 = %lld\n".ptr, x6 as int);
	let x7: i8 = -127 ^ z;
	x7 += -1 ^ z;
	printf("add i8 -127 -1 = %lld\n".ptr, x7 as int);
	let x8: i8 = 127 ^ z;
	x8 -= 1 ^ z;
	printf("sub i8 127 1 = %lld\n".ptr, x8 as int);
	let x9: i8 = 127 ^ z;
	x9 -= 127 ^ z;
	printf("sub i8 127 127 = %lld\n".ptr, x9 as int);
	let x10: i8 = 127 ^ z;
	x10 -= 2 ^ z;
	printf("sub i8 127 2 = %lld\n".ptr, x10 as int);
	let x11: i8 = 7 ^ z;
	x11 -= 2 ^ z;
	printf("sub i8 7 2 = %lld\n".ptr, x11 as int);
	let x12: i8 = -128 ^ z;
	x12 -= -128 ^ z;
	printf("sub i8 -128 -128 = %lld\n".ptr, x12 as int);
	let x13: i8 = -128 ^ z;
	x13 -= -1 ^ z;
	printf("sub i8 -128 -1 = %lld\n".ptr, x13 as int);
	let x14: i8 = -7 ^ z;
	x14 -= 2 ^ z;
	printf("sub i8 -7 2 = %lld\n".ptr, x14 as int);
	let x15: i8 = 7 ^ z;
	x15 -= -2 ^ z;
	printf("sub i8 7 -2 = %lld\n".ptr, x15 as int);
	let x16: i8 = -1 ^ z;
	x16 -= -1 ^ z;
	printf("sub i8 -1 -1 = %lld\n".ptr, x16 as int);
	let x17: i8 = -127 ^ z;
	x17 -= -1 ^ z;
	printf("sub i8 -127 -1 = %lld\n".ptr, x17 as int);
	let x18: i8 = 127 ^ z;
	x18 *= 1 ^ z;
	printf("mul i8 127 1 = %lld\n".ptr, x18 as int);
	let x19: i8 = -128 ^ z;
	x19 *= 1 ^ z;
	printf("mul i8 -128 1 = %lld\n".ptr, x19 as int);
	let x20: i8 = 7 ^ z;
	x20 *= 2 ^ z;
	printf("mul i8 7 2 = %lld\n".ptr, x20 as int);
	let x21: i8 = 127 ^ z;
	x21 *= -1 ^ z;
	printf("mul i8 127 -1 = %lld\n".ptr, x21 as int);
	let x22: i8 = -7 ^ z;
	x22 *= 2 ^ z;
	printf("mul i8 -7 2 = %lld\n".ptr, x22 as int);
	let x23: i8 = 7 ^ z;
	x23 *= -2 ^ z;
	printf("mul i8 7 -2 = %lld\n".ptr, x23 as int);
	let x24: i8 = -1 ^ z;
	x24 *= -1 ^ z;
	printf("mul i8 -1 -1 = %lld\n".ptr, x24 as int);
	let x25: i8 = -127 ^ z;
	x25 *= -1 ^ z;
	printf("mul i8 -127 -1 = %lld\n".ptr, x25 as int);
	let x26: i8 = 127 ^ z;
	x26 /= 1 ^ z;
	printf("div i8 127 1 = %lld\n".ptr, x26 as int);
	let x27: i8 = 127 ^ z;
	x27 /= 127 ^ z;
	printf("div i8 127 127 = %lld\n".ptr, x27 as int);
	let x28: i8 = -128 ^ z;
	x28 /= 1 ^ z;
	printf("div i8 -128 1 = %lld\n".ptr, x28 as int);
	let x29: i8 = -128 ^ z;
	x29 /= 127 ^ z;
	printf("div i8 -128 127 = %lld\n".ptr, x29 as int);
	let x30: i8 = 127 ^ z;
	x30 /= 2 ^ z;
	printf("div i8 127 2 = %lld\n".ptr, x30 as int);
	let x31: i8 = 7 ^ z;
	x31 /= 2 ^ z;
	printf("div i8 7 2 = %lld\n".ptr, x31 as int);
	let x32: i8 = -128 ^ z;
	x32 /= -128 ^ z;
	printf("div i8 -128 -128 = %lld\n".ptr, x32 as int);
	let x33: i8 = -128 ^ z;
	x33 /= -1 ^ z;
	printf("div i8 -128 -1 = %lld\n".ptr, x33 as int);
	let x34: i8 = 127 ^ z;
	x34 /= -1 ^ z;
	printf("div i8 127 -1 = %lld\n".ptr, x34 as int);
	let x35: i8 = -7 ^ z;
	x35 /= 2 ^ z;
	printf("div i8 -7 2 = %lld\n".ptr, x35 as int);
	let x36: i8 = 7 ^ z;
	x36 /= -2 ^ z;
	printf("div i8 7 -2 = %lld\n".ptr, x36 as int);
	let x37: i8 = -1 ^ z;
	x37 /= -1 ^ z;
	printf("div i8 -1 -1 = %lld\n".ptr, x37 as int);
	let x38: i8 = -127 ^ z;
	x38 /= -1 ^ z;
	printf("div i8 -127 -1 = %lld\n".ptr, x38 as int);
	let x39: i8 = 127 ^ z;
	x39 %= 1 ^ z;
	printf("rem i8 127 1 = %lld\n".ptr, x39 as int);
	let x40: i8 = 127 ^ z;
	x40 %= 127 ^ z;
	printf("rem i8 127 127 = %lld\n".ptr, x40 as int);
	let x41: i8 = -128 ^ z;
	x41 %= 1 ^ z;
	printf("rem i8 -128 1 = %lld\n".ptr, x41 as int);
	let x42: i8 = -128 ^ z;
	x42 %= 127 ^ z;
	printf("rem i8 -128 127 = %lld\n".ptr, x42 as int);
	let x43: i8 = 127 ^ z;
	x43 %= 2 ^ z;
	printf("rem i8 127 2 = %lld\n".ptr, x43 as int);
	let x44: i8 = 7 ^ z;
	x44 %= 2 ^ z;
	printf("rem i8 7 2 = %lld\n".ptr, x44 as int);
	let x45: i8 = -128 ^ z;
	x45 %= -128 ^ z;
	printf("rem i8 -128 -128 = %lld\n".ptr, x45 as int);
	let x46: i8 = -128 ^ z;
	x46 %= -1 ^ z;
	printf("rem i8 -128 -1 = %lld\n".ptr, x46 as int);
	let x47: i8 = 127 ^ z;
	x47 %= -1 ^ z;
	printf("rem i8 127 -1 = %lld\n".ptr, x47 as int);
	let x48: i8 = -7 ^ z;
	x48 %= 2 ^ z;
	printf("rem i8 -7 2 = %lld\n".ptr, x48 as int);
	let x49: i8 = 7 ^ z;
	x49 %= -2 ^ z;
	printf("rem i8 7 -2 = %lld\n".ptr, x49 as int);
	let x50: i8 = -1 ^ z;
	x50 %= -1 ^ z;
	printf("rem i8 -1 -1 = %lld\n".ptr, x50 as int);
	let x51: i8 = -127 ^ z;
	x51 %= -1 ^ z;
	printf("rem i8 -127 -1 = %lld\n".ptr, x51 as int);
	let x52: i8 = 127 ^ z;
	x52 &= 1 ^ z;
	printf("and i8 127 1 = %lld\n".ptr, x52 as int);
	let x53: i8 = 127 ^ z;
	x53 &= 127 ^ z;
	printf("and i8 127 127 = %lld\n".ptr, x53 as int);
	let x54: i8 = -128 ^ z;
	x54 &= 1 ^ z;
	printf("and i8 -128 1 = %lld\n".ptr, x54 as int);
	let x55: i8 = -128 ^ z;
	x55 &= 127 ^ z;
	printf("and i8 -128 127 = %lld\n".ptr, x55 as int);
	let x56: i8 = 127 ^ z;
	x56 &= 2 ^ z;
	printf("and i8 127 2 = %lld\n".ptr, x56 as int);
	let x57: i8 = 7 ^ z;
	x57 &= 2 ^ z;
	printf("and i8 7 2 = %lld\n".ptr, x57 as int);
	let x58: i8 = -128 ^ z;
	x58 &= -128 ^ z;
	printf("and i8 -128 -128 = %lld\n".ptr, x58 as int);
	let x59: i8 = -128 ^ z;
	x59 &= -1 ^ z;
	printf("and i8 -128 -1 = %lld\n".ptr, x59 as int);
	let x60: i8 = 127 ^ z;
	x60 &= -1 ^ z;
	printf("and i8 127 -1 = %lld\n".ptr, x60 as int);
	let x61: i8 = -7 ^ z;
	x61 &= 2 ^ z;
	printf("and i8 -7 2 = %lld\n".ptr, x61 as int);
	let x62: i8 = 7 ^ z;
	x62 &= -2 ^ z;
	printf("and i8 7 -2 = %lld\n".ptr, x62 as int);
	let x63: i8 = -1 ^ z;
	x63 &= -1 ^ z;
	printf("and i8 -1 -1 = %lld\n".ptr, x63 as int);
	let x64: i8 = -127 ^ z;
	x64 &= -1 ^ z;
	printf("and i8 -127 -1 = %lld\n".ptr, x64 as int);
	let x65: i8 = 127 ^ z;
	x65 |= 1 ^ z;
	printf("or i8 127 1 = %lld\n".ptr, x65 as int);
	let x66: i8 = 127 ^ z;
	x66 |= 127 ^ z;
	printf("or i8 127 127 = %lld\n".ptr, x66 as int);
	let x67: i8 = -128 ^ z;
	x67 |= 1 ^ z;
	printf("or i8 -128 1 = %lld\n".ptr, x67 as int);
	let x68: i8 = -128 ^ z;
	x68 |= 127 ^ z;
	printf("or i8 -128 127 = %lld\n".ptr, x68 as int);
	let x69: i8 = 127 ^ z;
	x69 |= 2 ^ z;
	printf("or i8 127 2 = %lld\n".ptr, x69 as int);
	let x70: i8 = 7 ^ z;
	x70 |= 2 ^ z;
	printf("or i8 7 2 = %lld\n".ptr, x70 as int);
	let x71: i8 = -128 ^ z;
	x71 |= -128 ^ z;
	printf("or i8 -128 -128 = %lld\n".ptr, x71 as int);
	let x72: i8 = -128 ^ z;
	x72 |= -1 ^ z;
	printf("or i8 -128 -1 = %lld\n".ptr, x72 as int);
	let x73: i8 = 127 ^ z;
	x73 |= -1 ^ z;
	printf("or i8 127 -1 = %lld\n".ptr, x73 as int);
	let x74: i8 = -7 ^ z;
	x74 |= 2 ^ z;
	printf("or i8 -7 2 = %lld\n".ptr, x74 as int);
	let x75: i8 = 7 ^ z;
	x75 |= -2 ^ z;
	printf("or i8 7 -2 = %lld\n".ptr, x75 as int);
	let x76: i8 = -1 ^ z;
	x76 |= -1 ^ z;
	printf("or i8 -1 -1 = %lld\n".ptr, x76 as int);
	let x77: i8 = -127 ^ z;
	x77 |= -1 ^ z;
	printf("or i8 -127 -1 = %lld\n".ptr, x77 as int);
	let x78: i8 = 127 ^ z;
	x78 ^= 1 ^ z;
	printf("xor i8 127 1 = %lld\n".ptr, x78 as int);
	let x79: i8 = 127 ^ z;
	x79 ^= 127 ^ z;
	printf("xor i8 127 127 = %lld\n".ptr, x79 as int);
	let x80: i8 = -128 ^ z;
	x80 ^= 1 ^ z;
	printf("xor i8 -128 1 = %lld\n".ptr, x80 as int);
	let x81: i8 = -128 ^ z;
	x81 ^= 127 ^ z;
	printf("xor i8 -128 127 = %lld\n".ptr, x81 as int);
	let x82: i8 = 127 ^ z;
	x82 ^= 2 ^ z;
	printf("xor i8 127 2 = %lld\n".ptr, x82 as int);
	let x83: i8 = 7 ^ z;
	x83 ^= 2 ^ z;
	printf("xor i8 7 2 = %lld\n".ptr, x83 as int);
	let x84: i8 = -128 ^ z;
	x84 ^= -128 ^ z;
	printf("xor i8 -128 -128 = %lld\n".ptr, x84 as int);
	let x85: i8 = -128 ^ z;
	x85 ^= -1 ^ z;
	printf("xor i8 -128 -1 = %lld\n".ptr, x85 as int);
	let x86: i8 = 127 ^ z;
	x86 ^= -1 ^ z;
	printf("xor i8 127 -1 = %lld\n".ptr, x86 as int);
	let x87: i8 = -7 ^ z;
	x87 ^= 2 ^ z;
	printf("xor i8 -7 2 = %lld\n".ptr, x87 as int);
	let x88: i8 = 7 ^ z;
	x88 ^= -2 ^ z;
	printf("xor i8 7 -2 = %lld\n".ptr, x88 as int);
	let x89: i8 = -1 ^ z;
	x89 ^= -1 ^ z;
	printf("xor i8 -1 -1 = %lld\n".ptr, x89 as int);
	let x90: i8 = -127 ^ z;
	x90 ^= -1 ^ z;
	printf("xor i8 -127 -1 = %lld\n".ptr, x90 as int);
	let x91: i8 = 1 ^ z;
	x91 <<= 7 ^ z;
	printf("shl i8 1 7 = %lld\n".ptr, x91 as int);
	let x92: i8 = 127 ^ z;
	x92 <<= 1 ^ z;
	printf("shl i8 127 1 = %lld\n".ptr, x92 as int);
	let x93: i8 = 127 ^ z;
	x93 <<= 7 ^ z;
	printf("shl i8 127 7 = %lld\n".ptr, x93 as int);
	let x94: i8 = 3 ^ z;
	x94 <<= 0 ^ z;
	printf("shl i8 3 0 = %lld\n".ptr, x94 as int);
	let x95: i8 = 1 ^ z;
	x95 <<= 1 ^ z;
	printf("shl i8 1 1 = %lld\n".ptr, x95 as int);
	let x96: i8 = -128 ^ z;
	x96 <<= 7 ^ z;
	printf("shl i8 -128 7 = %lld\n".ptr, x96 as int);
	let x97: i8 = -8 ^ z;
	x97 <<= 1 ^ z;
	printf("shl i8 -8 1 = %lld\n".ptr, x97 as int);
	let x98: i8 = -1 ^ z;
	x98 <<= 7 ^ z;
	printf("shl i8 -1 7 = %lld\n".ptr, x98 as int);
	let x99: i8 = -128 ^ z;
	x99 <<= 1 ^ z;
	printf("shl i8 -128 1 = %lld\n".ptr, x99 as int);
	let x100: i8 = 1 ^ z;
	x100 >>= 7 ^ z;
	printf("shr i8 1 7 = %lld\n".ptr, x100 as int);
	let x101: i8 = 127 ^ z;
	x101 >>= 1 ^ z;
	printf("shr i8 127 1 = %lld\n".ptr, x101 as int);
	let x102: i8 = 127 ^ z;
	x102 >>= 7 ^ z;
	printf("shr i8 127 7 = %lld\n".ptr, x102 as int);
	let x103: i8 = 3 ^ z;
	x103 >>= 0 ^ z;
	printf("shr i8 3 0 = %lld\n".ptr, x103 as int);
	let x104: i8 = 1 ^ z;
	x104 >>= 1 ^ z;
	printf("shr i8 1 1 = %lld\n".ptr, x104 as int);
	let x105: i8 = -128 ^ z;
	x105 >>= 7 ^ z;
	printf("shr i8 -128 7 = %lld\n".ptr, x105 as int);
	let x106: i8 = -8 ^ z;
	x106 >>= 1 ^ z;
	printf("shr i8 -8 1 = %lld\n".ptr, x106 as int);
	let x107: i8 = -1 ^ z;
