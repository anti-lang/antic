//! Every compound assignment on every integer type at its limits, from operands
//! the program cannot know before it runs: `+= -= *= /= %= &= |= ^= <<= >>=`,
//! the wrapping `+%= -%= *%= <<%=` and the saturating `+|= -|= *|=`. A case
//! that would stop a dev build is left out, and the wrapping and the saturating
//! ones never stop one.

extern fn printf(format: ?*byte, ...) -> c_int;

fn compound_on_i8(z: i8)
{
	let x0: i8 = -128 ^ z;
	x0 += 1 ^ z;
	printf("add i8 -128 1 = %lld\n".ptr, x0 as int);
	let x1: i8 = -128 ^ z;
	x1 += 127 ^ z;
	printf("add i8 -128 127 = %lld\n".ptr, x1 as int);
	let x2: i8 = 7 ^ z;
	x2 += 2 ^ z;
	printf("add i8 7 2 = %lld\n".ptr, x2 as int);
	let x3: i8 = 127 ^ z;
	x3 += -1 ^ z;
	printf("add i8 127 -1 = %lld\n".ptr, x3 as int);
	let x4: i8 = -7 ^ z;
	x4 += 2 ^ z;
	printf("add i8 -7 2 = %lld\n".ptr, x4 as int);
	let x5: i8 = 7 ^ z;
	x5 += -2 ^ z;
	printf("add i8 7 -2 = %lld\n".ptr, x5 as int);
	let x6: i8 = 127 ^ z;
	x6 -= 1 ^ z;
	printf("sub i8 127 1 = %lld\n".ptr, x6 as int);
	let x7: i8 = 127 ^ z;
	x7 -= 127 ^ z;
	printf("sub i8 127 127 = %lld\n".ptr, x7 as int);
	let x8: i8 = 127 ^ z;
	x8 -= 2 ^ z;
	printf("sub i8 127 2 = %lld\n".ptr, x8 as int);
	let x9: i8 = 7 ^ z;
	x9 -= 2 ^ z;
	printf("sub i8 7 2 = %lld\n".ptr, x9 as int);
	let x10: i8 = -128 ^ z;
	x10 -= -128 ^ z;
	printf("sub i8 -128 -128 = %lld\n".ptr, x10 as int);
	let x11: i8 = -128 ^ z;
	x11 -= -1 ^ z;
	printf("sub i8 -128 -1 = %lld\n".ptr, x11 as int);
	let x12: i8 = -7 ^ z;
	x12 -= 2 ^ z;
	printf("sub i8 -7 2 = %lld\n".ptr, x12 as int);
	let x13: i8 = 7 ^ z;
	x13 -= -2 ^ z;
	printf("sub i8 7 -2 = %lld\n".ptr, x13 as int);
	let x14: i8 = 127 ^ z;
	x14 *= 1 ^ z;
	printf("mul i8 127 1 = %lld\n".ptr, x14 as int);
	let x15: i8 = -128 ^ z;
	x15 *= 1 ^ z;
	printf("mul i8 -128 1 = %lld\n".ptr, x15 as int);
	let x16: i8 = 7 ^ z;
	x16 *= 2 ^ z;
	printf("mul i8 7 2 = %lld\n".ptr, x16 as int);
	let x17: i8 = 127 ^ z;
	x17 *= -1 ^ z;
	printf("mul i8 127 -1 = %lld\n".ptr, x17 as int);
	let x18: i8 = -7 ^ z;
	x18 *= 2 ^ z;
	printf("mul i8 -7 2 = %lld\n".ptr, x18 as int);
	let x19: i8 = 7 ^ z;
	x19 *= -2 ^ z;
	printf("mul i8 7 -2 = %lld\n".ptr, x19 as int);
	let x20: i8 = 127 ^ z;
	x20 /= 1 ^ z;
	printf("div i8 127 1 = %lld\n".ptr, x20 as int);
	let x21: i8 = 127 ^ z;
	x21 /= 127 ^ z;
	printf("div i8 127 127 = %lld\n".ptr, x21 as int);
	let x22: i8 = -128 ^ z;
	x22 /= 1 ^ z;
	printf("div i8 -128 1 = %lld\n".ptr, x22 as int);
	let x23: i8 = -128 ^ z;
	x23 /= 127 ^ z;
	printf("div i8 -128 127 = %lld\n".ptr, x23 as int);
	let x24: i8 = 127 ^ z;
	x24 /= 2 ^ z;
	printf("div i8 127 2 = %lld\n".ptr, x24 as int);
	let x25: i8 = 7 ^ z;
	x25 /= 2 ^ z;
	printf("div i8 7 2 = %lld\n".ptr, x25 as int);
	let x26: i8 = -128 ^ z;
	x26 /= -128 ^ z;
	printf("div i8 -128 -128 = %lld\n".ptr, x26 as int);
	let x28: i8 = 127 ^ z;
	x28 /= -1 ^ z;
	printf("div i8 127 -1 = %lld\n".ptr, x28 as int);
	let x29: i8 = -7 ^ z;
	x29 /= 2 ^ z;
	printf("div i8 -7 2 = %lld\n".ptr, x29 as int);
	let x30: i8 = 7 ^ z;
	x30 /= -2 ^ z;
	printf("div i8 7 -2 = %lld\n".ptr, x30 as int);
	let x31: i8 = 127 ^ z;
	x31 %= 1 ^ z;
	printf("rem i8 127 1 = %lld\n".ptr, x31 as int);
	let x32: i8 = 127 ^ z;
	x32 %= 127 ^ z;
	printf("rem i8 127 127 = %lld\n".ptr, x32 as int);
	let x33: i8 = -128 ^ z;
	x33 %= 1 ^ z;
	printf("rem i8 -128 1 = %lld\n".ptr, x33 as int);
	let x34: i8 = -128 ^ z;
	x34 %= 127 ^ z;
	printf("rem i8 -128 127 = %lld\n".ptr, x34 as int);
	let x35: i8 = 127 ^ z;
	x35 %= 2 ^ z;
	printf("rem i8 127 2 = %lld\n".ptr, x35 as int);
	let x36: i8 = 7 ^ z;
	x36 %= 2 ^ z;
	printf("rem i8 7 2 = %lld\n".ptr, x36 as int);
	let x37: i8 = -128 ^ z;
	x37 %= -128 ^ z;
	printf("rem i8 -128 -128 = %lld\n".ptr, x37 as int);
	let x39: i8 = 127 ^ z;
	x39 %= -1 ^ z;
	printf("rem i8 127 -1 = %lld\n".ptr, x39 as int);
	let x40: i8 = -7 ^ z;
	x40 %= 2 ^ z;
	printf("rem i8 -7 2 = %lld\n".ptr, x40 as int);
	let x41: i8 = 7 ^ z;
	x41 %= -2 ^ z;
	printf("rem i8 7 -2 = %lld\n".ptr, x41 as int);
	let x42: i8 = 127 ^ z;
	x42 &= 1 ^ z;
	printf("and i8 127 1 = %lld\n".ptr, x42 as int);
	let x43: i8 = 127 ^ z;
	x43 &= 127 ^ z;
	printf("and i8 127 127 = %lld\n".ptr, x43 as int);
	let x44: i8 = -128 ^ z;
	x44 &= 1 ^ z;
	printf("and i8 -128 1 = %lld\n".ptr, x44 as int);
	let x45: i8 = -128 ^ z;
	x45 &= 127 ^ z;
	printf("and i8 -128 127 = %lld\n".ptr, x45 as int);
	let x46: i8 = 127 ^ z;
	x46 &= 2 ^ z;
	printf("and i8 127 2 = %lld\n".ptr, x46 as int);
	let x47: i8 = 7 ^ z;
	x47 &= 2 ^ z;
	printf("and i8 7 2 = %lld\n".ptr, x47 as int);
	let x48: i8 = -128 ^ z;
	x48 &= -128 ^ z;
	printf("and i8 -128 -128 = %lld\n".ptr, x48 as int);
	let x49: i8 = -128 ^ z;
	x49 &= -1 ^ z;
	printf("and i8 -128 -1 = %lld\n".ptr, x49 as int);
	let x50: i8 = 127 ^ z;
	x50 &= -1 ^ z;
	printf("and i8 127 -1 = %lld\n".ptr, x50 as int);
	let x51: i8 = -7 ^ z;
	x51 &= 2 ^ z;
	printf("and i8 -7 2 = %lld\n".ptr, x51 as int);
	let x52: i8 = 7 ^ z;
	x52 &= -2 ^ z;
	printf("and i8 7 -2 = %lld\n".ptr, x52 as int);
	let x53: i8 = 127 ^ z;
	x53 |= 1 ^ z;
	printf("or i8 127 1 = %lld\n".ptr, x53 as int);
	let x54: i8 = 127 ^ z;
	x54 |= 127 ^ z;
	printf("or i8 127 127 = %lld\n".ptr, x54 as int);
	let x55: i8 = -128 ^ z;
	x55 |= 1 ^ z;
	printf("or i8 -128 1 = %lld\n".ptr, x55 as int);
	let x56: i8 = -128 ^ z;
	x56 |= 127 ^ z;
	printf("or i8 -128 127 = %lld\n".ptr, x56 as int);
	let x57: i8 = 127 ^ z;
	x57 |= 2 ^ z;
	printf("or i8 127 2 = %lld\n".ptr, x57 as int);
	let x58: i8 = 7 ^ z;
	x58 |= 2 ^ z;
	printf("or i8 7 2 = %lld\n".ptr, x58 as int);
	let x59: i8 = -128 ^ z;
	x59 |= -128 ^ z;
	printf("or i8 -128 -128 = %lld\n".ptr, x59 as int);
	let x60: i8 = -128 ^ z;
	x60 |= -1 ^ z;
	printf("or i8 -128 -1 = %lld\n".ptr, x60 as int);
	let x61: i8 = 127 ^ z;
	x61 |= -1 ^ z;
	printf("or i8 127 -1 = %lld\n".ptr, x61 as int);
	let x62: i8 = -7 ^ z;
	x62 |= 2 ^ z;
	printf("or i8 -7 2 = %lld\n".ptr, x62 as int);
	let x63: i8 = 7 ^ z;
	x63 |= -2 ^ z;
	printf("or i8 7 -2 = %lld\n".ptr, x63 as int);
	let x64: i8 = 127 ^ z;
	x64 ^= 1 ^ z;
	printf("xor i8 127 1 = %lld\n".ptr, x64 as int);
	let x65: i8 = 127 ^ z;
	x65 ^= 127 ^ z;
	printf("xor i8 127 127 = %lld\n".ptr, x65 as int);
	let x66: i8 = -128 ^ z;
	x66 ^= 1 ^ z;
	printf("xor i8 -128 1 = %lld\n".ptr, x66 as int);
	let x67: i8 = -128 ^ z;
	x67 ^= 127 ^ z;
	printf("xor i8 -128 127 = %lld\n".ptr, x67 as int);
	let x68: i8 = 127 ^ z;
	x68 ^= 2 ^ z;
	printf("xor i8 127 2 = %lld\n".ptr, x68 as int);
	let x69: i8 = 7 ^ z;
	x69 ^= 2 ^ z;
	printf("xor i8 7 2 = %lld\n".ptr, x69 as int);
	let x70: i8 = -128 ^ z;
	x70 ^= -128 ^ z;
	printf("xor i8 -128 -128 = %lld\n".ptr, x70 as int);
	let x71: i8 = -128 ^ z;
	x71 ^= -1 ^ z;
	printf("xor i8 -128 -1 = %lld\n".ptr, x71 as int);
	let x72: i8 = 127 ^ z;
	x72 ^= -1 ^ z;
	printf("xor i8 127 -1 = %lld\n".ptr, x72 as int);
	let x73: i8 = -7 ^ z;
	x73 ^= 2 ^ z;
	printf("xor i8 -7 2 = %lld\n".ptr, x73 as int);
	let x74: i8 = 7 ^ z;
	x74 ^= -2 ^ z;
	printf("xor i8 7 -2 = %lld\n".ptr, x74 as int);
	let x75: i8 = 1 ^ z;
	x75 <<= 7 ^ z;
	printf("shl i8 1 7 = %lld\n".ptr, x75 as int);
	let x76: i8 = 127 ^ z;
	x76 <<= 1 ^ z;
	printf("shl i8 127 1 = %lld\n".ptr, x76 as int);
	let x77: i8 = 127 ^ z;
	x77 <<= 7 ^ z;
	printf("shl i8 127 7 = %lld\n".ptr, x77 as int);
	let x78: i8 = 3 ^ z;
	x78 <<= 0 ^ z;
	printf("shl i8 3 0 = %lld\n".ptr, x78 as int);
	let x79: i8 = 1 ^ z;
	x79 <<= 1 ^ z;
	printf("shl i8 1 1 = %lld\n".ptr, x79 as int);
	let x80: i8 = -128 ^ z;
	x80 <<= 7 ^ z;
	printf("shl i8 -128 7 = %lld\n".ptr, x80 as int);
	let x81: i8 = -8 ^ z;
	x81 <<= 1 ^ z;
	printf("shl i8 -8 1 = %lld\n".ptr, x81 as int);
	let x82: i8 = -1 ^ z;
	x82 <<= 7 ^ z;
	printf("shl i8 -1 7 = %lld\n".ptr, x82 as int);
	let x83: i8 = -128 ^ z;
	x83 <<= 1 ^ z;
	printf("shl i8 -128 1 = %lld\n".ptr, x83 as int);
	let x84: i8 = 1 ^ z;
	x84 >>= 7 ^ z;
	printf("shr i8 1 7 = %lld\n".ptr, x84 as int);
	let x85: i8 = 127 ^ z;
	x85 >>= 1 ^ z;
	printf("shr i8 127 1 = %lld\n".ptr, x85 as int);
	let x86: i8 = 127 ^ z;
	x86 >>= 7 ^ z;
	printf("shr i8 127 7 = %lld\n".ptr, x86 as int);
	let x87: i8 = 3 ^ z;
	x87 >>= 0 ^ z;
	printf("shr i8 3 0 = %lld\n".ptr, x87 as int);
	let x88: i8 = 1 ^ z;
	x88 >>= 1 ^ z;
	printf("shr i8 1 1 = %lld\n".ptr, x88 as int);
	let x89: i8 = -128 ^ z;
	x89 >>= 7 ^ z;
	printf("shr i8 -128 7 = %lld\n".ptr, x89 as int);
	let x90: i8 = -8 ^ z;
	x90 >>= 1 ^ z;
	printf("shr i8 -8 1 = %lld\n".ptr, x90 as int);
	let x91: i8 = -1 ^ z;
	x91 >>= 7 ^ z;
	printf("shr i8 -1 7 = %lld\n".ptr, x91 as int);
	let x92: i8 = -128 ^ z;
	x92 >>= 1 ^ z;
	printf("shr i8 -128 1 = %lld\n".ptr, x92 as int);
}

fn compound_on_i16(z: i16)
{
	let x0: i16 = -32768 ^ z;
	x0 += 1 ^ z;
	printf("add i16 -32768 1 = %lld\n".ptr, x0 as int);
	let x1: i16 = -32768 ^ z;
	x1 += 32767 ^ z;
	printf("add i16 -32768 32767 = %lld\n".ptr, x1 as int);
	let x2: i16 = 7 ^ z;
	x2 += 2 ^ z;
	printf("add i16 7 2 = %lld\n".ptr, x2 as int);
	let x3: i16 = 32767 ^ z;
	x3 += -1 ^ z;
	printf("add i16 32767 -1 = %lld\n".ptr, x3 as int);
	let x4: i16 = -7 ^ z;
	x4 += 2 ^ z;
	printf("add i16 -7 2 = %lld\n".ptr, x4 as int);
	let x5: i16 = 7 ^ z;
	x5 += -2 ^ z;
	printf("add i16 7 -2 = %lld\n".ptr, x5 as int);
	let x6: i16 = 32767 ^ z;
	x6 -= 1 ^ z;
	printf("sub i16 32767 1 = %lld\n".ptr, x6 as int);
	let x7: i16 = 32767 ^ z;
	x7 -= 32767 ^ z;
	printf("sub i16 32767 32767 = %lld\n".ptr, x7 as int);
	let x8: i16 = 32767 ^ z;
	x8 -= 2 ^ z;
	printf("sub i16 32767 2 = %lld\n".ptr, x8 as int);
	let x9: i16 = 7 ^ z;
	x9 -= 2 ^ z;
	printf("sub i16 7 2 = %lld\n".ptr, x9 as int);
	let x10: i16 = -32768 ^ z;
	x10 -= -32768 ^ z;
	printf("sub i16 -32768 -32768 = %lld\n".ptr, x10 as int);
	let x11: i16 = -32768 ^ z;
	x11 -= -1 ^ z;
	printf("sub i16 -32768 -1 = %lld\n".ptr, x11 as int);
	let x12: i16 = -7 ^ z;
	x12 -= 2 ^ z;
	printf("sub i16 -7 2 = %lld\n".ptr, x12 as int);
	let x13: i16 = 7 ^ z;
	x13 -= -2 ^ z;
	printf("sub i16 7 -2 = %lld\n".ptr, x13 as int);
	let x14: i16 = 32767 ^ z;
	x14 *= 1 ^ z;
	printf("mul i16 32767 1 = %lld\n".ptr, x14 as int);
	let x15: i16 = -32768 ^ z;
	x15 *= 1 ^ z;
	printf("mul i16 -32768 1 = %lld\n".ptr, x15 as int);
	let x16: i16 = 7 ^ z;
	x16 *= 2 ^ z;
	printf("mul i16 7 2 = %lld\n".ptr, x16 as int);
	let x17: i16 = 32767 ^ z;
	x17 *= -1 ^ z;
	printf("mul i16 32767 -1 = %lld\n".ptr, x17 as int);
	let x18: i16 = -7 ^ z;
	x18 *= 2 ^ z;
	printf("mul i16 -7 2 = %lld\n".ptr, x18 as int);
	let x19: i16 = 7 ^ z;
	x19 *= -2 ^ z;
	printf("mul i16 7 -2 = %lld\n".ptr, x19 as int);
	let x20: i16 = 32767 ^ z;
	x20 /= 1 ^ z;
	printf("div i16 32767 1 = %lld\n".ptr, x20 as int);
	let x21: i16 = 32767 ^ z;
	x21 /= 32767 ^ z;
	printf("div i16 32767 32767 = %lld\n".ptr, x21 as int);
	let x22: i16 = -32768 ^ z;
	x22 /= 1 ^ z;
	printf("div i16 -32768 1 = %lld\n".ptr, x22 as int);
	let x23: i16 = -32768 ^ z;
	x23 /= 32767 ^ z;
	printf("div i16 -32768 32767 = %lld\n".ptr, x23 as int);
	let x24: i16 = 32767 ^ z;
	x24 /= 2 ^ z;
	printf("div i16 32767 2 = %lld\n".ptr, x24 as int);
	let x25: i16 = 7 ^ z;
	x25 /= 2 ^ z;
	printf("div i16 7 2 = %lld\n".ptr, x25 as int);
	let x26: i16 = -32768 ^ z;
	x26 /= -32768 ^ z;
	printf("div i16 -32768 -32768 = %lld\n".ptr, x26 as int);
	let x28: i16 = 32767 ^ z;
	x28 /= -1 ^ z;
	printf("div i16 32767 -1 = %lld\n".ptr, x28 as int);
	let x29: i16 = -7 ^ z;
	x29 /= 2 ^ z;
	printf("div i16 -7 2 = %lld\n".ptr, x29 as int);
	let x30: i16 = 7 ^ z;
	x30 /= -2 ^ z;
	printf("div i16 7 -2 = %lld\n".ptr, x30 as int);
	let x31: i16 = 32767 ^ z;
	x31 %= 1 ^ z;
	printf("rem i16 32767 1 = %lld\n".ptr, x31 as int);
	let x32: i16 = 32767 ^ z;
	x32 %= 32767 ^ z;
	printf("rem i16 32767 32767 = %lld\n".ptr, x32 as int);
	let x33: i16 = -32768 ^ z;
	x33 %= 1 ^ z;
	printf("rem i16 -32768 1 = %lld\n".ptr, x33 as int);
