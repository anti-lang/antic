	printf("div i16 -32767 -1 = %lld\n".ptr, x38 as int);
	let x39: i16 = 32767 ^ z;
	x39 %= 1 ^ z;
	printf("rem i16 32767 1 = %lld\n".ptr, x39 as int);
	let x40: i16 = 32767 ^ z;
	x40 %= 32767 ^ z;
	printf("rem i16 32767 32767 = %lld\n".ptr, x40 as int);
	let x41: i16 = -32768 ^ z;
	x41 %= 1 ^ z;
	printf("rem i16 -32768 1 = %lld\n".ptr, x41 as int);
	let x42: i16 = -32768 ^ z;
	x42 %= 32767 ^ z;
	printf("rem i16 -32768 32767 = %lld\n".ptr, x42 as int);
	let x43: i16 = 32767 ^ z;
	x43 %= 2 ^ z;
	printf("rem i16 32767 2 = %lld\n".ptr, x43 as int);
	let x44: i16 = 7 ^ z;
	x44 %= 2 ^ z;
	printf("rem i16 7 2 = %lld\n".ptr, x44 as int);
	let x45: i16 = -32768 ^ z;
	x45 %= -32768 ^ z;
	printf("rem i16 -32768 -32768 = %lld\n".ptr, x45 as int);
	let x46: i16 = -32768 ^ z;
	x46 %= -1 ^ z;
	printf("rem i16 -32768 -1 = %lld\n".ptr, x46 as int);
	let x47: i16 = 32767 ^ z;
	x47 %= -1 ^ z;
	printf("rem i16 32767 -1 = %lld\n".ptr, x47 as int);
	let x48: i16 = -7 ^ z;
	x48 %= 2 ^ z;
	printf("rem i16 -7 2 = %lld\n".ptr, x48 as int);
