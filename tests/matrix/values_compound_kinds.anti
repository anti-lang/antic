	x56 |= 32767 ^ z;
	printf("or i16 -32768 32767 = %lld\n".ptr, x56 as int);
	let x57: i16 = 32767 ^ z;
	x57 |= 2 ^ z;
	printf("or i16 32767 2 = %lld\n".ptr, x57 as int);
	let x58: i16 = 7 ^ z;
	x58 |= 2 ^ z;
	printf("or i16 7 2 = %lld\n".ptr, x58 as int);
	let x59: i16 = -32768 ^ z;
	x59 |= -32768 ^ z;
	printf("or i16 -32768 -32768 = %lld\n".ptr, x59 as int);
	let x60: i16 = -32768 ^ z;
	x60 |= -1 ^ z;
	printf("or i16 -32768 -1 = %lld\n".ptr, x60 as int);
	let x61: i16 = 32767 ^ z;
	x61 |= -1 ^ z;
	printf("or i16 32767 -1 = %lld\n".ptr, x61 as int);
	let x62: i16 = -7 ^ z;
	x62 |= 2 ^ z;
	printf("or i16 -7 2 = %lld\n".ptr, x62 as int);
	let x63: i16 = 7 ^ z;
	x63 |= -2 ^ z;
	printf("or i16 7 -2 = %lld\n".ptr, x63 as int);
	let x64: i16 = 32767 ^ z;
	x64 ^= 1 ^ z;
	printf("xor i16 32767 1 = %lld\n".ptr, x64 as int);
	let x65: i16 = 32767 ^ z;
	x65 ^= 32767 ^ z;
	printf("xor i16 32767 32767 = %lld\n".ptr, x65 as int);
