	printf("shr i8 -1 7 = %lld\n".ptr, x107 as int);
	let x108: i8 = -128 ^ z;
	x108 >>= 1 ^ z;
	printf("shr i8 -128 1 = %lld\n".ptr, x108 as int);
}

fn on_i16(z: i16)
{
	let x0: i16 = -32768 ^ z;
	x0 += 1 ^ z;
	printf("add i16 -32768 1 = %lld\n".ptr, x0 as int);
	let x1: i16 = -32768 ^ z;
	x1 += 32767 ^ z;
	printf("add i16 -32768 32767 = %lld\n".ptr, x1 as int);
	let x2: i16 = 7 ^ z;
	x2 += 2 ^ z;
	printf("add i16 7 2 = %lld\n".ptr, x2 as int);
	let x3: i16 = 32767 ^ z;
	x3 += -1 ^ z;
	printf("add i16 32767 -1 = %lld\n".ptr, x3 as int);
	let x4: i16 = -7 ^ z;
	x4 += 2 ^ z;
	printf("add i16 -7 2 = %lld\n".ptr, x4 as int);
	let x5: i16 = 7 ^ z;
	x5 += -2 ^ z;
	printf("add i16 7 -2 = %lld\n".ptr, x5 as int);
	let x6: i16 = -1 ^ z;
	x6 += -1 ^ z;
	printf("add i16 -1 -1 = %lld\n".ptr, x6 as int);
	let x7: i16 = -32767 ^ z;
	x7 += -1 ^ z;
	printf("add i16 -32767 -1 = %lld\n".ptr, x7 as int);
	let x8: i16 = 32767 ^ z;
	x8 -= 1 ^ z;
	printf("sub i16 32767 1 = %lld\n".ptr, x8 as int);
	let x9: i16 = 32767 ^ z;
	x9 -= 32767 ^ z;
	printf("sub i16 32767 32767 = %lld\n".ptr, x9 as int);
	let x10: i16 = 32767 ^ z;
	x10 -= 2 ^ z;
	printf("sub i16 32767 2 = %lld\n".ptr, x10 as int);
	let x11: i16 = 7 ^ z;
	x11 -= 2 ^ z;
	printf("sub i16 7 2 = %lld\n".ptr, x11 as int);
	let x12: i16 = -32768 ^ z;
	x12 -= -32768 ^ z;
	printf("sub i16 -32768 -32768 = %lld\n".ptr, x12 as int);
	let x13: i16 = -32768 ^ z;
	x13 -= -1 ^ z;
	printf("sub i16 -32768 -1 = %lld\n".ptr, x13 as int);
	let x14: i16 = -7 ^ z;
	x14 -= 2 ^ z;
	printf("sub i16 -7 2 = %lld\n".ptr, x14 as int);
	let x15: i16 = 7 ^ z;
	x15 -= -2 ^ z;
	printf("sub i16 7 -2 = %lld\n".ptr, x15 as int);
	let x16: i16 = -1 ^ z;
	x16 -= -1 ^ z;
	printf("sub i16 -1 -1 = %lld\n".ptr, x16 as int);
	let x17: i16 = -32767 ^ z;
	x17 -= -1 ^ z;
	printf("sub i16 -32767 -1 = %lld\n".ptr, x17 as int);
	let x18: i16 = 32767 ^ z;
	x18 *= 1 ^ z;
	printf("mul i16 32767 1 = %lld\n".ptr, x18 as int);
	let x19: i16 = -32768 ^ z;
	x19 *= 1 ^ z;
	printf("mul i16 -32768 1 = %lld\n".ptr, x19 as int);
	let x20: i16 = 7 ^ z;
	x20 *= 2 ^ z;
	printf("mul i16 7 2 = %lld\n".ptr, x20 as int);
	let x21: i16 = 32767 ^ z;
	x21 *= -1 ^ z;
	printf("mul i16 32767 -1 = %lld\n".ptr, x21 as int);
	let x22: i16 = -7 ^ z;
	x22 *= 2 ^ z;
	printf("mul i16 -7 2 = %lld\n".ptr, x22 as int);
	let x23: i16 = 7 ^ z;
	x23 *= -2 ^ z;
	printf("mul i16 7 -2 = %lld\n".ptr, x23 as int);
	let x24: i16 = -1 ^ z;
	x24 *= -1 ^ z;
	printf("mul i16 -1 -1 = %lld\n".ptr, x24 as int);
	let x25: i16 = -32767 ^ z;
	x25 *= -1 ^ z;
	printf("mul i16 -32767 -1 = %lld\n".ptr, x25 as int);
	let x26: i16 = 32767 ^ z;
	x26 /= 1 ^ z;
	printf("div i16 32767 1 = %lld\n".ptr, x26 as int);
	let x27: i16 = 32767 ^ z;
	x27 /= 32767 ^ z;
	printf("div i16 32767 32767 = %lld\n".ptr, x27 as int);
	let x28: i16 = -32768 ^ z;
	x28 /= 1 ^ z;
	printf("div i16 -32768 1 = %lld\n".ptr, x28 as int);
	let x29: i16 = -32768 ^ z;
	x29 /= 32767 ^ z;
	printf("div i16 -32768 32767 = %lld\n".ptr, x29 as int);
	let x30: i16 = 32767 ^ z;
	x30 /= 2 ^ z;
	printf("div i16 32767 2 = %lld\n".ptr, x30 as int);
	let x31: i16 = 7 ^ z;
	x31 /= 2 ^ z;
	printf("div i16 7 2 = %lld\n".ptr, x31 as int);
