//! `send` of a local that holds a struct that owns something. The channel would
//! hold a copy, and the local would stay a second owner.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

struct Pair
{
	k: Key,
	n: int,
}

fn pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

fn main() -> int
{
	let c = chan Pair(1);
	let a = pair(1);
	send(c, a);
	delete(c);
	return 0;
}
