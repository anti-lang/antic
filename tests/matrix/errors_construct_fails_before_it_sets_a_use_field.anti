//! A `construct` that fails before it sets a `use` field whose class has a
//! field without a default and an `own` field. The teardown passes over the
//! field that nothing set, and the leaf of the one that succeeds is freed once.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Leaf
{
	pub n: int = 0,

	pub static atomic live: int = 0;

	fn construct(self)
	{
		Leaf.live.add(1);
	}

	fn destruct(self)
	{
		Leaf.live.sub(1);
	}
}

class Part
{
	pub n: int,
	pub own leaf: ?*Leaf = none,
}

class Whole
{
	use part: Part,
	pub w: int = 0,

	fn construct(self, n: int) may fail
	{
		if n > 0 {
			fail "refused";
		}
		self.part = Part { n: n, leaf: alloc Leaf { n: n } };
		self.w = n;
	}
}

fn make(n: int) -> int
{
	let w = alloc Whole(n) catch e {
		return -1;
	};
	let got = w.part.n;
	delete(w);
	return got;
}

fn main() -> int
{
	printf("%d %d\n".ptr, make(1) as c_int, Leaf.live.load() as c_int);
	printf("%d %d\n".ptr, make(0) as c_int, Leaf.live.load() as c_int);
	return 0;
}
