//! `alloc(T, n)` for each kind of element, a slice and a pointer among them,
//! and `free` of each. The memory of a class is zero, so its first element has
//! no table yet and a literal fills it. `delete` takes a `?*T` after each of
//! the tests that narrow it: a comparison, `if let` and `let ... else`.

extern fn printf(format: ?*byte, ...) -> c_int;

struct Point
{
	x: int,
	y: int,
}

class Node
{
	pub n: int = 0,

	static atomic live: int = 0;

	fn construct(self)
	{
		Node.live.add(1);
	}

	fn destruct(self)
	{
		Node.live.sub(1);
	}
}

fn twice(n: int) -> int
{
	return n * 2;
}

fn find(p: *Node, yes: bool) -> ?*Node
{
	if yes {
		return p;
	}
	return none;
}

fn elements() -> int
{
	let numbers = [1, 2, 3];
	let x = 5;
	let slices = alloc([]int, 2) else {
		return 1;
	};
	slices[0] = numbers[0..2];
	slices[1] = numbers[1..3];
	printf("slice: %d %d\n".ptr, slices[0].len as c_int, slices[1][1] as c_int);
	free(slices);
	let pointers = alloc(*int, 2) else {
		return 1;
	};
	pointers[0] = &x;
	pointers[1] = &numbers[2];
	printf("pointer: %d %d\n".ptr, *pointers[0] as c_int, *pointers[1] as c_int);
	free(pointers);
	let maybes = alloc(?*int, 2) else {
		return 1;
	};
	maybes[0] = none;
	maybes[1] = &x;
	printf("nullable pointer: %d %d\n".ptr, (maybes[0] == none) as c_int,
		(maybes[1] == &x) as c_int);
	free(maybes);
	let points = alloc(Point, 2) else {
		return 1;
	};
	points[1] = Point { x: 3, y: 4 };
	printf("struct: %d\n".ptr, points[1].y as c_int);
	free(points);
	let tuples = alloc((int, bool), 2) else {
		return 1;
	};
	tuples[1] = (6, true);
	printf("tuple: %d %d\n".ptr, tuples[1].0 as c_int, tuples[1].1 as c_int);
	free(tuples);
	let rows = alloc([4]int, 2) else {
		return 1;
	};
	rows[1] = [7, 8, 9, 10];
	printf("fixed array: %d %d\n".ptr, rows[1][3] as c_int, rows[1].len as c_int);
	free(rows);
	let functions = alloc(fn(int) -> int, 2) else {
		return 1;
	};
	functions[1] = twice;
	printf("function value: %d\n".ptr, functions[1](11) as c_int);
	free(functions);
	let options = alloc(?int, 2) else {
		return 1;
	};
	options[0] = none;
	options[1] = 12;
	printf("optional value: %d %d\n".ptr, (options[0] ?? -1) as c_int,
		(options[1] ?? -1) as c_int);
	free(options);
	let nodes = alloc(Node, 2) else {
		return 1;
	};
	nodes[1] = Node { n: 13 };
	printf("class: %d, alive %d\n".ptr, nodes[1].n as c_int, Node.live.load() as c_int);
	destroy(&nodes[1]);
	free(nodes);
	printf("class after destroy: alive %d\n".ptr, Node.live.load() as c_int);
	return 0;
}

fn narrowed()
{
	let a = find(alloc Node { n: 1 }, true);
	if a != none {
		delete(a);
	}
	printf("delete after a comparison: alive %d\n".ptr, Node.live.load() as c_int);
	if let b = find(alloc Node { n: 2 }, true) {
		delete(b);
	}
		printf("delete in an if let: alive %d\n".ptr, Node.live.load() as c_int);
	let c = find(alloc Node { n: 3 }, true) else {
		return;
	};
	delete(c);
	printf("delete after let else: alive %d\n".ptr, Node.live.load() as c_int);
	let d = find(alloc Node { n: 4 }, true);
	if d != none {
		destroy(d);
	}
	free(d);
	printf("destroy and free of a ?*T: alive %d\n".ptr, Node.live.load() as c_int);
}

fn main() -> int
{
	let status = elements();
	narrowed();
	return status;
}
