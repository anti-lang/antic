//! A snapshot takes the values it uses when it is made, so the one a local
//! keeps from the first turn of a loop gives the value of that turn.

import anti.io;
import anti.text;

fn main() -> int
{
	let start = 7;
	let kept = snapshot fn() { io.println(f"kept {start}"); };
	for i in 0..3 {
		let v = i * 10;
		let s = snapshot fn() { io.println(f"kept {v}"); };
		if i == 0 {
			kept = s;
		}
	}
	kept();
	return 0;
}
