//! `=` of a local that holds a tuple that owns something. The copy would give
//! what the value owns two owners, and `dup` is the copy.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn main() -> int
{
	let a = tuple(1);
	let b = tuple(2);
	b = a;
	return 0;
}
