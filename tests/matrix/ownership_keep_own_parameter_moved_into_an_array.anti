//! A `keep own` parameter in an array literal moves into the array, as it moves
//! into an `own` field of a class literal. The array then frees the snapshot
//! and the parameter passes over it, so it is freed once.

extern fn printf(format: ?*byte, ...) -> c_int;

fn hand(keep own f: fn(int))
{
	let a = [f];
	a[0](1);
}

fn main() -> int
{
	let k = 3;
	hand(snapshot fn(x: int) { printf("%d\n".ptr, (x + k) as c_int); });
	return 0;
}
