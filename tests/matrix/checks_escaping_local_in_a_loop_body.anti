//! E1 in a loop body: the address of a local of the body is stored into a local
//! of the function, which outlives the turn that declared it.

fn last(n: int) -> int
{
	let p: ?*int = none;
	for i in 0..n {
		let x = i;
		p = &x;
	}
	let q = p else {
		return -1;
	};
	return *q;
}

fn main() -> int
{
	return last(3) - 2;
}
