//! `return` of a field that holds a variant with an owning case, which decision
//! 22 of "Decisions of 2026-10-11" refuses by the rule of `let` and `=`: the
//! field keeps its value, and the caller would hold a second owner.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

variant Shape
{
	Keyed { k: Key },
	Empty,
}

fn shape(n: int) -> Shape
{
	return Shape.Keyed { k: key(n) };
}

class Holder
{
	pub held: Shape,
}

fn give(h: *Holder) -> Shape
{
	return h.held;
}

fn main() -> int
{
	let h = Holder { held: shape(1) };
	let b = give(&h);
	return 0;
}
