//! An assignment that copies a tuple with a concurrent class in it is refused,
//! by R039 of "Rules of 2026-10-13": the copy would copy the class.

import anti.lang;

concurrent class Hits
{
	pub atomic n: int = 0,
}

fn main() -> int
{
	let first = (Hits { n: 5 }, 1);
	let second = (Hits { n: 6 }, 2);
	first = second;
	return first.1;
}
