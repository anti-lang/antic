//! A `protected fn` has no entry in the table and is called directly, so a
//! `concrete fn` of the same name in a derived class replaces nothing, and a
//! call of the base never reaches it. It is refused as a `concrete fn` without
//! a function of the base is. A programmer from C++ writes the protected
//! virtual hook of a template method this way.

abstract class Report
{
	protected fn footer(self) -> str
	{
		return "end";
	}

	pub fn render(self) -> str
	{
		return self.footer();
	}
}

class Weekly inherits Report
{
	concrete fn footer(self) -> str
	{
		return "signed";
	}
}

fn main() -> int
{
	let w = Weekly { };
	return w.render().len;
}
