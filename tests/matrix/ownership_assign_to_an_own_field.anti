//! `=` to an `own` field tears down the value the field held, by R074 of
//! "Answers of 2026-10-18", in each place an `own` field stands: through
//! `self`, through a pointer, in a class value of a local and of a struct, in
//! an element of an array and in the base of a class. An `own` slice tears its
//! elements down last to first and frees its buffer, an `own` buffer of bytes
//! goes back to the C library, `none` tears the old value down and holds
//! nothing, and a field that holds `none` tears nothing down. A field given the
//! pointer it holds keeps it, and a call that fails leaves the field as it was.
//! Each `Key` prints its teardown, and each line prints the keys alive.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;
extern fn malloc(size: c_size_t) -> ?*byte;

class Key
{
	pub n: int = 0,

	pub static atomic live: int = 0;

	fn construct(self)
	{
		Key.live.add(1);
	}

	fn destruct(self)
	{
		Key.live.sub(1);
		printf("  teardown of key %d\n".ptr, self.n as c_int);
	}
}

class Box
{
	pub own one: ?*Key = none,
	pub own bytes: ?*byte = none,

	pub fn replace(self, n: int)
	{
		self.one = alloc Key { n: n };
	}
}

class Lower inherits Box
{
	pub extra: int = 0,
}

class Shelf
{
	pub own many: []Key,
}

struct Holder
{
	box: Box,
	n: int,
}

fn keys(first: int, n: int) -> []Key
{
	let q = alloc(Key, n) else {
		return []Key { ptr: none, len: 0 };
	};
	for i in 0..n {
		q[i] = Key { n: first + i };
	}
	return []Key { ptr: q, len: n };
}

/// The number of the key that p points at, or 0 for `none`.
fn held(p: ?*Key) -> c_int
{
	let k = p else {
		return 0;
	};
	return k.n as c_int;
}

fn alive() -> c_int
{
	return Key.live.load() as c_int;
}

fn through_self()
{
	let b = alloc Box { one: alloc Key { n: 1 } };
	b.replace(2);
	printf("through self: %d, alive %d\n".ptr, held(b.one), alive());
	delete(b);
}

fn through_a_pointer()
{
	let b = alloc Box { one: alloc Key { n: 3 } };
	let p = b;
	p.one = alloc Key { n: 4 };
	printf("through a pointer: %d, alive %d\n".ptr, held(b.one), alive());
	delete(b);
}

fn in_a_class_value()
{
	let c = Box { one: alloc Key { n: 5 } };
	c.one = alloc Key { n: 6 };
	printf("in a class value: %d, alive %d\n".ptr, held(c.one), alive());
}

fn in_a_struct()
{
	let s = Holder { box: Box { one: alloc Key { n: 7 } }, n: 1 };
	s.box.one = alloc Key { n: 8 };
	printf("in a struct: %d, alive %d\n".ptr, held(s.box.one), alive());
}

fn in_an_element()
{
	let row = [Box { one: alloc Key { n: 9 } }, Box { }];
	row[0].one = alloc Key { n: 10 };
	printf("in an element: %d, alive %d\n".ptr, held(row[0].one), alive());
}

fn in_a_base()
{
	let b = alloc Lower { one: alloc Key { n: 11 } };
	b.one = alloc Key { n: 12 };
	printf("in a base: %d, alive %d\n".ptr, held(b.one), alive());
	delete(b);
}

fn a_slice()
{
	let b = alloc Shelf { many: keys(20, 2) };
	b.many = keys(30, 1);
	printf("an own slice: %d, alive %d\n".ptr, b.many.len as c_int, alive());
	delete(b);
}

fn a_buffer()
{
	let b = alloc Box { bytes: malloc(16) };
	b.bytes = malloc(32);
	b.bytes = none;
	printf("an own buffer of bytes: %d, alive %d\n".ptr, (b.bytes == none) as c_int, alive());
	delete(b);
}

fn to_none()
{
	let b = alloc Box { one: alloc Key { n: 13 } };
	b.one = none;
	printf("none: %d, alive %d\n".ptr, (b.one == none) as c_int, alive());
	b.one = alloc Key { n: 14 };
	printf("after none: %d, alive %d\n".ptr, held(b.one), alive());
	delete(b);
}

fn the_same_pointer()
{
	let b = alloc Box { one: alloc Key { n: 15 } };
	b.one = b.one;
	printf("the same pointer: %d, alive %d\n".ptr, held(b.one), alive());
	delete(b);
}

/// A new key, or a failure for a number below zero.
fn made(n: int) -> *Key may fail
{
	if n < 0 {
		fail "below zero";
	}
	return alloc Key { n: n };
}

fn from_a_call_that_may_fail()
{
	let b = alloc Box { one: alloc Key { n: 16 } };
	b.one = made(17) catch {
		delete(b);
		return;
	};
	printf("from a call that may fail: %d, alive %d\n".ptr, held(b.one), alive());
	b.one = made(-1) catch {
		printf("a call that failed leaves the field: %d, alive %d\n".ptr, held(b.one), alive());
		delete(b);
		return;
	};
	delete(b);
}

fn main() -> int
{
	through_self();
	through_a_pointer();
	in_a_class_value();
	in_a_struct();
	in_an_element();
	in_a_base();
	a_slice();
	a_buffer();
	to_none();
	the_same_pointer();
	from_a_call_that_may_fail();
	printf("at the end: alive %d\n".ptr, alive());
	return 0;
}
