	const F9: i16 = mul_high(-7, 2);
	let r9: i16 = mul_high((-7 ^ z), (2 ^ z));
	printf("mul_high i16 -7 2 = %lld %lld\n".ptr, F9 as int, r9 as int);
	const F10: i16 = mul_high(7, -2);
	let r10: i16 = mul_high((7 ^ z), (-2 ^ z));
	printf("mul_high i16 7 -2 = %lld %lld\n".ptr, F10 as int, r10 as int);
	const F11: i16 = mul_high(-1, -1);
	let r11: i16 = mul_high((-1 ^ z), (-1 ^ z));
	printf("mul_high i16 -1 -1 = %lld %lld\n".ptr, F11 as int, r11 as int);
	const F12: i16 = mul_high(-32767, -1);
	let r12: i16 = mul_high((-32767 ^ z), (-1 ^ z));
	printf("mul_high i16 -32767 -1 = %lld %lld\n".ptr, F12 as int, r12 as int);
}

