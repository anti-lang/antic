fn on_u8(z: u8)
{
	const F0: u8 = mul_high(255, 1);
	let r0: u8 = mul_high((255 ^ z), (1 ^ z));
	printf("mul_high u8 255 1 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: u8 = mul_high(255, 255);
	let r1: u8 = mul_high((255 ^ z), (255 ^ z));
	printf("mul_high u8 255 255 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: u8 = mul_high(0, 1);
	let r2: u8 = mul_high((0 ^ z), (1 ^ z));
	printf("mul_high u8 0 1 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: u8 = mul_high(0, 255);
	let r3: u8 = mul_high((0 ^ z), (255 ^ z));
	printf("mul_high u8 0 255 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: u8 = mul_high(255, 2);
	let r4: u8 = mul_high((255 ^ z), (2 ^ z));
	printf("mul_high u8 255 2 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: u8 = mul_high(7, 2);
	let r5: u8 = mul_high((7 ^ z), (2 ^ z));
	printf("mul_high u8 7 2 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: u8 = mul_high(0, 0);
	let r6: u8 = mul_high((0 ^ z), (0 ^ z));
	printf("mul_high u8 0 0 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: u8 = mul_high(0, 1);
	let r7: u8 = mul_high((0 ^ z), (1 ^ z));
	printf("mul_high u8 0 1 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	const F8: u8 = mul_high(1, 255);
	let r8: u8 = mul_high((1 ^ z), (255 ^ z));
	printf("mul_high u8 1 255 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
	const F9: u8 = mul_high(254, 255);
	let r9: u8 = mul_high((254 ^ z), (255 ^ z));
	printf("mul_high u8 254 255 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
}

