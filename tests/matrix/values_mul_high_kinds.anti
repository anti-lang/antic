fn on_byte(z: byte)
{
	const F0: byte = mul_high(255, 1);
	let r0: byte = mul_high((255 ^ z), (1 ^ z));
	printf("mul_high byte 255 1 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: byte = mul_high(255, 255);
	let r1: byte = mul_high((255 ^ z), (255 ^ z));
	printf("mul_high byte 255 255 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: byte = mul_high(0, 1);
	let r2: byte = mul_high((0 ^ z), (1 ^ z));
	printf("mul_high byte 0 1 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: byte = mul_high(0, 255);
	let r3: byte = mul_high((0 ^ z), (255 ^ z));
	printf("mul_high byte 0 255 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: byte = mul_high(255, 2);
	let r4: byte = mul_high((255 ^ z), (2 ^ z));
	printf("mul_high byte 255 2 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: byte = mul_high(7, 2);
	let r5: byte = mul_high((7 ^ z), (2 ^ z));
	printf("mul_high byte 7 2 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: byte = mul_high(0, 0);
	let r6: byte = mul_high((0 ^ z), (0 ^ z));
	printf("mul_high byte 0 0 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: byte = mul_high(0, 1);
	let r7: byte = mul_high((0 ^ z), (1 ^ z));
	printf("mul_high byte 0 1 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	const F8: byte = mul_high(1, 255);
	let r8: byte = mul_high((1 ^ z), (255 ^ z));
	printf("mul_high byte 1 255 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
	const F9: byte = mul_high(254, 255);
	let r9: byte = mul_high((254 ^ z), (255 ^ z));
	printf("mul_high byte 254 255 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
}

fn main(args: []str) -> int
{
	let zero = args.len - 1;
	on_i8(zero as i8);
	on_i16(zero as i16);
	on_i32(zero as i32);
	on_i64(zero as i64);
	on_int(zero as int);
	on_u8(zero as u8);
	on_u16(zero as u16);
	on_u32(zero as u32);
	on_u64(zero as u64);
	on_uint(zero as uint);
	on_byte(zero as byte);
	return 0;
}
