fn on_u32(z: u32)
{
	const F0: u32 = mul_high(4294967295, 1);
	let r0: u32 = mul_high((4294967295 ^ z), (1 ^ z));
	printf("mul_high u32 4294967295 1 = %llu %llu\n".ptr, F0 as u64, r0 as u64);
	const F1: u32 = mul_high(4294967295, 4294967295);
	let r1: u32 = mul_high((4294967295 ^ z), (4294967295 ^ z));
	printf("mul_high u32 4294967295 4294967295 = %llu %llu\n".ptr, F1 as u64, r1 as u64);
	const F2: u32 = mul_high(0, 1);
	let r2: u32 = mul_high((0 ^ z), (1 ^ z));
	printf("mul_high u32 0 1 = %llu %llu\n".ptr, F2 as u64, r2 as u64);
	const F3: u32 = mul_high(0, 4294967295);
	let r3: u32 = mul_high((0 ^ z), (4294967295 ^ z));
	printf("mul_high u32 0 4294967295 = %llu %llu\n".ptr, F3 as u64, r3 as u64);
	const F4: u32 = mul_high(4294967295, 2);
	let r4: u32 = mul_high((4294967295 ^ z), (2 ^ z));
	printf("mul_high u32 4294967295 2 = %llu %llu\n".ptr, F4 as u64, r4 as u64);
	const F5: u32 = mul_high(7, 2);
	let r5: u32 = mul_high((7 ^ z), (2 ^ z));
	printf("mul_high u32 7 2 = %llu %llu\n".ptr, F5 as u64, r5 as u64);
	const F6: u32 = mul_high(0, 0);
	let r6: u32 = mul_high((0 ^ z), (0 ^ z));
	printf("mul_high u32 0 0 = %llu %llu\n".ptr, F6 as u64, r6 as u64);
	const F7: u32 = mul_high(0, 1);
	let r7: u32 = mul_high((0 ^ z), (1 ^ z));
	printf("mul_high u32 0 1 = %llu %llu\n".ptr, F7 as u64, r7 as u64);
	const F8: u32 = mul_high(1, 4294967295);
	let r8: u32 = mul_high((1 ^ z), (4294967295 ^ z));
	printf("mul_high u32 1 4294967295 = %llu %llu\n".ptr, F8 as u64, r8 as u64);
	const F9: u32 = mul_high(4294967294, 4294967295);
	let r9: u32 = mul_high((4294967294 ^ z), (4294967295 ^ z));
	printf("mul_high u32 4294967294 4294967295 = %llu %llu\n".ptr, F9 as u64, r9 as u64);
}

