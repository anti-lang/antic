//! A generic function of a class counts its parameters after `self`, so the
//! message of R065 of "Rules of 2026-10-13" names `values` and not the
//! receiver.

class Counter
{
	pub n: int = 0,

	pub fn add<T>(self, values: []T) -> int
	{
		self.n += values.len;
		return self.n;
	}
}

fn main() -> int
{
	let c = Counter { };
	return c.add(4);
}
