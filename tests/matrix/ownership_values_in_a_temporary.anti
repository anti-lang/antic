//! Each kind of owning value as a temporary: a call result that a statement
//! drops, one that the statement reads a field of, and one passed to a
//! parameter that is not `own`. Each is torn down where its statement ends.
//! Each line prints the numbers and the values alive. A variant, an optional
//! and an array are passed twice, since `is`, a test for `none` and an index on
//! such a temporary have programs of their own.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Counted
{
	pub n: int = 0,

	pub static atomic live: int = 0;

	fn construct(self)
	{
		Counted.live.add(1);
	}

	fn destruct(self)
	{
		Counted.live.sub(1);
	}
}

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,

	pub static atomic live: int = 0;

	fn construct(self)
	{
		Key.live.add(1);
	}

	fn destruct(self)
	{
		Key.live.sub(1);
	}
}

struct Pair
{
	k: Key,
	n: int,
}

variant Shape
{
	Keyed { k: Key },
	Empty,
}

fn counted(n: int) -> Counted
{
	return Counted { n: n };
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn shape(n: int) -> Shape
{
	return Shape.Keyed { k: key(n) };
}

fn maybe(n: int) -> ?Key
{
	return key(n);
}

fn row(n: int) -> [2]Key
{
	return [key(n), key(n + 100)];
}

/// The values alive now. A copy that `dup` made runs no `construct`, so the
/// program counts it with `copies`.
fn alive() -> c_int
{
	return (Key.live.load() + Counted.live.load()) as c_int;
}

/// Count `n` more values alive, for a copy.
fn copies(n: int)
{
	Key.live.add(n);
}

fn peek_counted(x: Counted) -> int
{
	return x.n;
}

fn in_counted()
{
	counted(1);
	let before = alive();
	let n = counted(2).n;
	let m = peek_counted(counted(3));
	printf("temporary of a class with a destruct: %d %d, alive %d then %d\n".ptr, n as c_int, m as c_int, before,
		alive());
}

fn peek_key(x: Key) -> int
{
	return x.n;
}

fn in_key()
{
	key(1);
	let before = alive();
	let n = key(2).n;
	let m = peek_key(key(3));
	printf("temporary of a class with an own field: %d %d, alive %d then %d\n".ptr, n as c_int, m as c_int, before,
		alive());
}

fn peek_pair(x: Pair) -> int
{
	return x.k.n;
}

fn in_pair()
{
	pair(1);
	let before = alive();
	let n = pair(2).k.n;
	let m = peek_pair(pair(3));
	printf("temporary of an owning struct: %d %d, alive %d then %d\n".ptr, n as c_int, m as c_int, before,
		alive());
}

fn peek_tuple(x: (Key, int)) -> int
{
	return x.0.n;
}

fn in_tuple()
{
	tuple(1);
	let before = alive();
	let n = tuple(2).0.n;
	let m = peek_tuple(tuple(3));
	printf("temporary of an owning tuple: %d %d, alive %d then %d\n".ptr, n as c_int, m as c_int, before,
		alive());
}

fn peek_shape(x: Shape) -> int
{
	return (x is Shape.Keyed) as int;
}

fn in_shape()
{
	shape(1);
	let before = alive();
	let n = peek_shape(shape(2));
	let m = peek_shape(shape(3));
	printf("temporary of an owning variant: %d %d, alive %d then %d\n".ptr, n as c_int, m as c_int, before,
		alive());
}

fn peek_maybe(x: ?Key) -> int
{
	return (x != none) as int;
}

fn in_maybe()
{
	maybe(1);
	let before = alive();
	let n = peek_maybe(maybe(2));
	let m = peek_maybe(maybe(3));
	printf("temporary of an owning optional: %d %d, alive %d then %d\n".ptr, n as c_int, m as c_int, before,
		alive());
}

fn peek_row(x: [2]Key) -> int
{
	return x[0].n;
}

fn in_row()
{
	row(1);
	let before = alive();
	let n = peek_row(row(2));
	let m = peek_row(row(3));
	printf("temporary of an owning array: %d %d, alive %d then %d\n".ptr, n as c_int, m as c_int, before,
		alive());
}

fn main() -> int
{
	in_counted();
	in_key();
	in_pair();
	in_tuple();
	in_shape();
	in_maybe();
	in_row();
	printf("at the end: alive %d\n".ptr, alive());
	return 0;
}
