//! Functions of a class body named `descriptor`, `fields`, `functions` and
//! `ancestors`, called on a value of the class and on a pointer to one. The
//! compiler writes data of those names for every class, and the name of the
//! class's own function is no other.

import anti.io;
import anti.text;

class Counter
{
	pub n: int = 1,

	pub fn descriptor(self) -> int
	{
		return self.n + 1;
	}

	pub fn fields(self) -> int
	{
		return self.n + 2;
	}

	pub fn functions(self) -> int
	{
		return self.n + 3;
	}

	pub fn ancestors(self) -> int
	{
		return self.n + 4;
	}
}

fn main() -> int
{
	let c = Counter { };
	let p = alloc Counter { n: 5 };
	let s = f"descriptor: {c.descriptor()} {p.descriptor()}, fields: {c.fields()} {p.fields()}, functions: {c.functions()} {p.functions()}, ancestors: {c.ancestors()} {p.ancestors()}";
	delete(p);
	io.println(s);
	free(s.ptr);
	return 0;
}
