//! A `?T` whose type parameter takes a `?*int` is a `?T` of its own with a
//! flag, so its `none` and the `none` of the pointer are two values. `maybe`
//! gives the outer `none` or the pointer, and `??` takes the second value where
//! the first is the outer `none`.

extern fn printf(format: ?*byte, ...) -> c_int;

fn pointee(p: ?*int) -> int
{
	if let q = p {
		return *q;
	}
	return -7;
}

fn maybe<T>(k: int, own v: T) -> ?T
{
	if k == 1 {
		return none;
	}
	return v;
}

fn chosen<T>(k: int, own a: T, own b: T) -> T
{
	let o = maybe<T>(k, a);
	return o ?? b;
}

fn main() -> int
{
	let one = 1;
	let two = 2;
	let r1 = chosen<?*int>(1, &one, &two);
	let r2 = chosen<?*int>(2, &one, &two);
	let r3 = chosen<?*int>(1, &one, none);
	let r4 = chosen<?*int>(2, none, &two);
	printf("%d %d %d %d\n".ptr, pointee(r1) as c_int, pointee(r2) as c_int,
		pointee(r3) as c_int, pointee(r4) as c_int);
	return 0;
}
