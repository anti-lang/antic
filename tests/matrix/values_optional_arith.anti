//! The operators on an optional value that a test has proved: a name narrowed
//! from a `?u8` reads its value, the compound assignments change that value and
//! keep the narrowing, and a literal beside it takes the type of the value.
//! `??` gives the value or its right side, whose literal takes the same type.

extern fn printf(format: ?*byte, ...) -> c_int;

fn pick(n: int) -> ?u8
{
	if n == 0 {
		return none;
	}
	return 250;
}

fn narrowed(n: int) -> int
{
	let maybe = pick(n);
	if maybe != none {
		maybe += 10;
		maybe *= 2;
		let wide = maybe + 1;
		return wide as int;
	}
	return -1;
}

fn bound(n: int) -> int
{
	if let held = pick(n) {
		let twice = held +| held;
		return twice as int + (held >> 1) as int;
	}
	return -1;
}

fn defaulted(n: int) -> int
{
	let value = pick(n) ?? 255;
	return (value + 1) as int;
}

fn main() -> int
{
	printf("narrowed %lld %lld\n".ptr, narrowed(1), narrowed(0));
	printf("bound %lld %lld\n".ptr, bound(1), bound(0));
	printf("defaulted %lld %lld\n".ptr, defaulted(1), defaulted(0));
	return 0;
}
