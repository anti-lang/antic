//! `a ?? b` of two locals of a class with a `destruct` passed to an `own`
//! parameter. The value is the one `a` or `b` holds, so the callee would tear
//! down a value that a local still owns.

class Owner
{
	pub n: int = 0,

	pub fn destruct(self)
	{
	}
}

fn keep(own x: Owner) -> int
{
	return x.n;
}

fn main() -> int
{
	let a: ?Owner = Owner { n: 1 };
	let b = Owner { n: 2 };
	return keep(a ?? b) as int;
}
