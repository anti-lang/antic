//! `let` of a parameter that is not `own` and holds a struct that owns
//! something. The value belongs to the caller, which tears it down.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

struct Pair
{
	k: Key,
	n: int,
}

fn pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

fn keep(x: Pair) -> int
{
	let mine = x;
	return 0;
}

fn main() -> int
{
	let a = pair(1);
	return keep(a);
}
