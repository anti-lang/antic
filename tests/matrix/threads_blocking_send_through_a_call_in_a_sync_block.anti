//! A `sync` block calls a function that holds a `send`, which may wait while
//! the block holds its lock. The call gets the warning `blocking-under-lock`,
//! which a release build refuses.

fn put(c: chan int, n: int)
{
	send(c, n);
}

struct Inbox
{
	lock: Mutex,
	count: int,
}

fn work(box: *Inbox, c: chan int) -> int
{
	sync box.lock {
		put(c, box.count);
	}
	return box.count;
}

fn main() -> int
{
	let box = Inbox { count: 0 };
	let c = chan int(1);
	send(c, 4);
	let n = work(&box, c);
	delete(c);
	return n - 4;
}
