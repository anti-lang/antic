//! A local that holds a tuple that owns something, named after it moved into an
//! `own` parameter. The function took the value over and tore it down.

class Leaf
{
	pub n: int = 0,
}

class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

fn key(n: int) -> Key
{
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn take(own x: (Key, int)) -> int
{
	return x.1;
}

fn main() -> int
{
	let a = tuple(1);
	let n = take(a);
	return n + take(a);
}
