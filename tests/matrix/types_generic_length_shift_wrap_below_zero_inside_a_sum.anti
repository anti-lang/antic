//! A length of a copy of a generic struct holds `<<%` by a count below zero
//! inside a sum. The copy finds the shift under the `+` and refuses it as a
//! constant does, by Q13 of "Answers of 2026-10-24".

extern fn printf(format: ?*byte, ...) -> c_int;

struct Box<N: int>
{
	cells: [(1 <<% (N - 4)) + 1]int,
}

fn main() -> int
{
	printf("size %d\n".ptr, size_of(Box<3>) as c_int);
	return 0;
}
