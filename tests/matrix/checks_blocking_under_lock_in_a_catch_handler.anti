//! C5 in a catch handler: a `recv` in a handler inside a `sync` block may wait
//! while the block holds its lock.

import anti.lang;

struct Inbox
{
	lock: Mutex,
	count: int,
}

fn failing(k: int) -> int may fail
{
	fail "refused";
}

fn work(box: *Inbox, c: chan int)
{
	sync box.lock {
		let got = failing(1) catch e {
			let v = recv(c) else {
				yield 0;
			};
			yield *v;
		};
		box.count += got;
	}
}

fn main() -> int
{
	let box = Inbox { count: 0 };
	let c = chan int(1);
	send(c, 4);
	work(&box, c);
	delete(c);
	return box.count - 4;
}
