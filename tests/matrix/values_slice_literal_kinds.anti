//! A slice literal over an array, for each of these kinds of value: i8, i16,
//! i32, i64, int, u8, u16, u32, u64, uint, byte, f32, f64, f16, bool, char,
//! str, slice, fixed array, pointer, nullable pointer, optional, may fail fn,
//! fn, tuple, channel, struct, packed struct, simd struct, union, enum,
//! variant, class, synchronized class, concurrent class, interface, generic.
//! Each kind is a function of its own, which prints the two values it holds.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

fn risky_up(n: int) -> int may fail
{
	if n < 0 {
		fail "negative";
	}
	return n + 1;
}

fn risky_down(n: int) -> int may fail
{
	if n > 0 {
		fail "positive";
	}
	return n - 1;
}

fn settle(f: fn(int) -> int may fail) -> int
{
	let got = f(10) catch {
		yield -1;
	};
	return got;
}

fn up(n: int) -> int
{
	return n + 1;
}

fn down(n: int) -> int
{
	return n - 1;
}

struct Pt
{
	x: int,
	y: int,
}

packed struct Pk
{
	a: u8,
	b: i32,
}

simd struct I32x4
{
	a: i32,
	b: i32,
	c: i32,
	d: i32,
}

union Bits
{
	i: i32,
	f: f32,
}

enum Color
{
	Red,
	Green,
	Blue,
}

variant Shape
{
	Circle { r: int },
	Empty,
}

class Counter
{
	pub n: int = 0,
}

synchronized class Tally
{
	pub n: int = 0,

	pub fn get(self) -> int
	{
		return self.n;
	}
}

concurrent class Hits
{
	pub atomic n: int = 0,
}

abstract class Named
{
	abstract fn id(self) -> int;
}

class One inherits Named
{
	concrete fn id(self) -> int
	{
		return 1;
	}
}

class Two inherits Named
{
	concrete fn id(self) -> int
	{
		return 2;
	}
}

fn same(n: int) -> int
{
	return n;
}

fn on_i8()
{
	let xs: [2]i8 = [127, -128];
	let s = []i8 { ptr: &xs[0], len: 2 };
	printf("i8 %lld %lld\n".ptr, s[0] as int, s[1] as int);
}

fn on_i16()
{
	let xs: [2]i16 = [32767, -32768];
	let s = []i16 { ptr: &xs[0], len: 2 };
	printf("i16 %lld %lld\n".ptr, s[0] as int, s[1] as int);
}

fn on_i32()
{
	let xs: [2]i32 = [2147483647, -2147483648];
	let s = []i32 { ptr: &xs[0], len: 2 };
	printf("i32 %lld %lld\n".ptr, s[0] as int, s[1] as int);
}

fn on_i64()
{
	let xs: [2]i64 = [9223372036854775807, -9223372036854775808];
	let s = []i64 { ptr: &xs[0], len: 2 };
	printf("i64 %lld %lld\n".ptr, s[0] as int, s[1] as int);
}

fn on_int()
{
	let xs: [2]int = [9223372036854775807, -9223372036854775808];
	let s = []int { ptr: &xs[0], len: 2 };
	printf("int %lld %lld\n".ptr, s[0] as int, s[1] as int);
}

fn on_u8()
{
	let xs: [2]u8 = [255, 1];
	let s = []u8 { ptr: &xs[0], len: 2 };
	printf("u8 %llu %llu\n".ptr, s[0] as u64, s[1] as u64);
}

fn on_u16()
{
	let xs: [2]u16 = [65535, 1];
	let s = []u16 { ptr: &xs[0], len: 2 };
	printf("u16 %llu %llu\n".ptr, s[0] as u64, s[1] as u64);
}

fn on_u32()
{
	let xs: [2]u32 = [4294967295, 1];
	let s = []u32 { ptr: &xs[0], len: 2 };
	printf("u32 %llu %llu\n".ptr, s[0] as u64, s[1] as u64);
}

fn on_u64()
{
	let xs: [2]u64 = [18446744073709551615, 1];
	let s = []u64 { ptr: &xs[0], len: 2 };
	printf("u64 %llu %llu\n".ptr, s[0] as u64, s[1] as u64);
}

fn on_uint()
{
	let xs: [2]uint = [18446744073709551615, 1];
	let s = []uint { ptr: &xs[0], len: 2 };
	printf("uint %llu %llu\n".ptr, s[0] as u64, s[1] as u64);
}

fn on_byte()
{
	let xs: [2]byte = [255, 1];
	let s = []byte { ptr: &xs[0], len: 2 };
	printf("byte %llu %llu\n".ptr, s[0] as u64, s[1] as u64);
}

fn on_f32()
{
	let xs: [2]f32 = [1.5, -0.25];
	let s = []f32 { ptr: &xs[0], len: 2 };
	printf("f32 %g %g\n".ptr, s[0] as f64, s[1] as f64);
}

fn on_f64()
{
	let xs: [2]f64 = [1.5, -0.25];
	let s = []f64 { ptr: &xs[0], len: 2 };
	printf("f64 %g %g\n".ptr, s[0], s[1]);
}

fn on_f16()
{
	let xs: [2]f16 = [1.5 as f16, -0.25 as f16];
	let s = []f16 { ptr: &xs[0], len: 2 };
	printf("f16 %g %g\n".ptr, s[0] as f64, s[1] as f64);
}

fn on_bool()
{
	let xs: [2]bool = [true, false];
	let s = []bool { ptr: &xs[0], len: 2 };
	printf("bool %d %d\n".ptr, s[0] as c_int, s[1] as c_int);
}

fn on_char()
{
	let xs: [2]char = ['a', '\u{10FFFF}'];
	let s = []char { ptr: &xs[0], len: 2 };
	printf("char %u %u\n".ptr, s[0] as u32, s[1] as u32);
}

fn on_str()
{
	let xs: [2]str = ["one", "three"];
	let s = []str { ptr: &xs[0], len: 2 };
	printf("str %lld %lld\n".ptr, s[0].len, s[1].len);
}

fn on_slice()
{
	let base = [1, 2, 3];
	let xs: [2][]int = [base[0..1], base[0..3]];
	let s = [][]int { ptr: &xs[0], len: 2 };
	printf("slice %lld %lld\n".ptr, s[0].len, s[1].len);
}

fn on_fixed_array()
{
	let xs: [2][2]int = [[1, 2], [3, 4]];
	let s = [][2]int { ptr: &xs[0], len: 2 };
	printf("fixed_array %lld %lld\n".ptr, s[0][1], s[1][1]);
}

fn on_pointer()
{
	let a = 11;
	let b = 22;
	let xs: [2]*int = [&a, &b];
	let s = []*int { ptr: &xs[0], len: 2 };
	printf("pointer %lld %lld\n".ptr, *s[0], *s[1]);
}

fn on_nullable_pointer()
{
	let a = 11;
	let b = 22;
	let xs: [2]?*int = [&a, none];
	let s = []?*int { ptr: &xs[0], len: 2 };
	printf("nullable_pointer %lld %lld\n".ptr, *(s[0] ?? &b), *(s[1] ?? &b));
}

fn on_optional()
{
	let xs: [2] ?int = [5, none];
	let s = [] ?int { ptr: &xs[0], len: 2 };
	printf("optional %lld %lld\n".ptr, (s[0] ?? -1), (s[1] ?? -1));
}

fn on_may_fail_fn()
{
	let xs: [2] fn(int) -> int may fail = [risky_up, risky_down];
	let s = [] fn(int) -> int may fail { ptr: &xs[0], len: 2 };
	printf("may_fail_fn %lld %lld\n".ptr, settle(s[0]), settle(s[1]));
}

fn on_fn()
{
	let xs: [2] fn(int) -> int = [up, down];
	let s = [] fn(int) -> int { ptr: &xs[0], len: 2 };
	printf("fn %lld %lld\n".ptr, s[0](10), s[1](10));
}

fn on_tuple()
{
	let xs: [2](int, bool) = [(1, true), (2, false)];
	let s = [](int, bool) { ptr: &xs[0], len: 2 };
	printf("tuple %lld %lld\n".ptr, s[0].0, s[1].0);
}

fn on_channel()
{
	let c1 = chan int(1);
	let c2 = chan int(1);
	let xs: [2] chan int = [c1, c2];
	let s = [] chan int { ptr: &xs[0], len: 2 };
	printf("channel %d %d\n".ptr, (s[0] == c1) as c_int, (s[1] == c1) as c_int);
	delete(c1);
	delete(c2);
}

fn on_struct()
{
	let xs: [2]Pt = [Pt { x: 1, y: 2 }, Pt { x: 3, y: 4 }];
	let s = []Pt { ptr: &xs[0], len: 2 };
	printf("struct %lld %lld\n".ptr, s[0].y, s[1].y);
}

fn on_packed_struct()
{
	let xs: [2]Pk = [Pk { a: 1, b: 2 }, Pk { a: 3, b: 4 }];
	let s = []Pk { ptr: &xs[0], len: 2 };
	printf("packed_struct %lld %lld\n".ptr, s[0].b as int, s[1].b as int);
}

fn on_simd_struct()
{
	let xs: [2]I32x4 = [I32x4 { a: 1, b: 2, c: 3, d: 4 }, I32x4 { a: 5, b: 6, c: 7, d: 8 }];
	let s = []I32x4 { ptr: &xs[0], len: 2 };
	printf("simd_struct %lld %lld\n".ptr, s[0].c as int, s[1].c as int);
}

fn on_union()
{
	let xs: [2]Bits = [Bits { i: 7 }, Bits { i: 9 }];
	let s = []Bits { ptr: &xs[0], len: 2 };
	printf("union %lld %lld\n".ptr, s[0].i as int, s[1].i as int);
}

fn on_enum()
{
	let xs: [2]Color = [Color.Green, Color.Blue];
	let s = []Color { ptr: &xs[0], len: 2 };
	printf("enum %lld %lld\n".ptr, s[0] as int, s[1] as int);
}

fn on_variant()
{
	let xs: [2]Shape = [Shape.Circle { r: 2 }, Shape.Empty];
	let s = []Shape { ptr: &xs[0], len: 2 };
	printf("variant %d %d\n".ptr, (s[0] is Shape.Circle) as c_int, (s[1] is Shape.Circle) as c_int);
}

fn on_class()
{
	let xs: [2]Counter = [Counter { n: 5 }, Counter { n: 6 }];
	let s = []Counter { ptr: &xs[0], len: 2 };
	printf("class %lld %lld\n".ptr, s[0].n, s[1].n);
}

fn on_synchronized_class()
{
	let xs: [2]Tally = [Tally { n: 5 }, Tally { n: 6 }];
	let s = []Tally { ptr: &xs[0], len: 2 };
	printf("synchronized_class %lld %lld\n".ptr, s[0].get(), s[1].get());
}

fn on_concurrent_class()
{
	let xs: [2]Hits = [Hits { n: 5 }, Hits { n: 6 }];
	let s = []Hits { ptr: &xs[0], len: 2 };
	printf("concurrent_class %lld %lld\n".ptr, s[0].n.load(), s[1].n.load());
}

fn on_interface()
{
	let one = One { };
	let two = Two { };
	let xs: [2]*Named = [&one, &two];
	let s = []*Named { ptr: &xs[0], len: 2 };
	printf("interface %lld %lld\n".ptr, s[0].id(), s[1].id());
}

fn on_generic<T>(a: T, b: T, read: fn(T) -> int)
{
	let xs: [2]T = [dup(a), dup(b)];
	let s = []T { ptr: &xs[0], len: 2 };
	printf("generic %lld %lld\n".ptr, read(s[0]), read(s[1]));
}

fn main() -> int
{
	on_i8();
	on_i16();
	on_i32();
	on_i64();
	on_int();
	on_u8();
	on_u16();
	on_u32();
	on_u64();
	on_uint();
	on_byte();
	on_f32();
	on_f64();
	on_f16();
	on_bool();
	on_char();
	on_str();
	on_slice();
	on_fixed_array();
	on_pointer();
	on_nullable_pointer();
	on_optional();
	on_may_fail_fn();
	on_fn();
	on_tuple();
	on_channel();
	on_struct();
	on_packed_struct();
	on_simd_struct();
	on_union();
	on_enum();
	on_variant();
	on_class();
	on_synchronized_class();
	on_concurrent_class();
	on_interface();
	on_generic<int>(11, 22, same);
	return 0;
}
