//! A `join` inside a `sync` block may wait while the block holds its lock. It
//! gets the warning `blocking-under-lock`, which a release build refuses.

class Task
{
	pub n: int = 4,
}

worker fn read(t: *Task) -> int
{
	return t.n;
}

struct Inbox
{
	lock: Mutex,
	count: int,
}

fn work(box: *Inbox, t: *Task) -> int
{
	sync box.lock {
		let job = dispatch t -> read;
		box.count += join(job);
	}
	return box.count;
}

fn main() -> int
{
	let box = Inbox { count: 0 };
	let t = alloc Task { };
	let n = work(&box, t);
	delete(t);
	return n - 4;
}
