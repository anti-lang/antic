//! `as` between every pair of integer types. A value both types hold converts
//! unchanged. A value the target cannot hold keeps its low bits in a constant,
//! and `checked` stands where a dev build stops the conversion at run time, so
//! the program does not run it. Each line holds the value the checker folds in
//! a constant and the value the program computes.

extern fn printf(format: ?*byte, ...) -> c_int;

fn from_i8(z: i8)
{
	const A0: i8 = 100;
	const F0: i8 = A0 as i8;
	let r0: i8 = (A0 ^ z) as i8;
	printf("as i8 i8 100 = %lld %lld\n".ptr, F0 as int, r0 as int);
	const A1: i8 = 127;
	const F1: i8 = A1 as i8;
	let r1: i8 = (A1 ^ z) as i8;
	printf("as i8 i8 127 = %lld %lld\n".ptr, F1 as int, r1 as int);
	const A2: i8 = -128;
	const F2: i8 = A2 as i8;
	let r2: i8 = (A2 ^ z) as i8;
	printf("as i8 i8 -128 = %lld %lld\n".ptr, F2 as int, r2 as int);
