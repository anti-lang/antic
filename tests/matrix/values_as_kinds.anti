fn main(args: []str) -> int
{
	let zero = args.len - 1;
	from_i8(zero as i8);
	from_i16(zero as i16);
	from_i32(zero as i32);
	from_i64(zero as i64);
	from_int(zero as int);
	from_u8(zero as u8);
	from_u16(zero as u16);
	from_u32(zero as u32);
	from_u64(zero as u64);
	from_uint(zero as uint);
	from_byte(zero as byte);
	return 0;
}
