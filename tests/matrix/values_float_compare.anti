	let r1_0 = a1 == b1;
	const F1_1: bool = A1 != B1;
	let r1_1 = a1 != b1;
	const F1_2: bool = A1 < B1;
	let r1_2 = a1 < b1;
	const F1_3: bool = A1 <= B1;
	let r1_3 = a1 <= b1;
	const F1_4: bool = A1 > B1;
	let r1_4 = a1 > b1;
	const F1_5: bool = A1 >= B1;
	let r1_5 = a1 >= b1;
	printf("compare f32 1 nan = %d%d %d%d %d%d %d%d %d%d %d%d\n".ptr, F1_0 as c_int, r1_0 as c_int, F1_1 as c_int, r1_1 as c_int, F1_2 as c_int, r1_2 as c_int, F1_3 as c_int, r1_3 as c_int, F1_4 as c_int, r1_4 as c_int, F1_5 as c_int, r1_5 as c_int);
