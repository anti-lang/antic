	let r2_0 = a2 == b2;
	const F2_1: bool = A2 != B2;
	let r2_1 = a2 != b2;
	const F2_2: bool = A2 < B2;
	let r2_2 = a2 < b2;
	const F2_3: bool = A2 <= B2;
	let r2_3 = a2 <= b2;
	const F2_4: bool = A2 > B2;
	let r2_4 = a2 > b2;
