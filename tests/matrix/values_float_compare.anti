	const A3: f32 = -0.0;
	const B3: f32 = 0.0;
	let a3: f32 = -0.0 * one;
	let b3: f32 = 0.0 * one;
	const F3_0: bool = A3 == B3;
	let r3_0 = a3 == b3;
	const F3_1: bool = A3 != B3;
	let r3_1 = a3 != b3;
	const F3_2: bool = A3 < B3;
	let r3_2 = a3 < b3;
	const F3_3: bool = A3 <= B3;
	let r3_3 = a3 <= b3;
	const F3_4: bool = A3 > B3;
	let r3_4 = a3 > b3;
	const F3_5: bool = A3 >= B3;
	let r3_5 = a3 >= b3;
	printf("compare f32 -0 0 = %d%d %d%d %d%d %d%d %d%d %d%d\n".ptr, F3_0 as c_int, r3_0 as c_int, F3_1 as c_int, r3_1 as c_int, F3_2 as c_int, r3_2 as c_int, F3_3 as c_int, r3_3 as c_int, F3_4 as c_int, r3_4 as c_int, F3_5 as c_int, r3_5 as c_int);
	const A4: f32 = 1.0 / 0.0;
	const B4: f32 = 1.0e30;
