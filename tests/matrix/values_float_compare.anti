	let r0_5 = a0 >= b0;
	printf("compare f32 nan 1 = %d%d %d%d %d%d %d%d %d%d %d%d\n".ptr, F0_0 as c_int, r0_0 as c_int, F0_1 as c_int, r0_1 as c_int, F0_2 as c_int, r0_2 as c_int, F0_3 as c_int, r0_3 as c_int, F0_4 as c_int, r0_4 as c_int, F0_5 as c_int, r0_5 as c_int);
