	const A6: f32 = 1.0 / 0.0;
	const B6: f32 = 1.0 / 0.0;
	let a6: f32 = one / (one - one);
	let b6: f32 = one / (one - one);
	const F6_0: bool = A6 == B6;
	let r6_0 = a6 == b6;
	const F6_1: bool = A6 != B6;
	let r6_1 = a6 != b6;
	const F6_2: bool = A6 < B6;
	let r6_2 = a6 < b6;
	const F6_3: bool = A6 <= B6;
	let r6_3 = a6 <= b6;
	const F6_4: bool = A6 > B6;
	let r6_4 = a6 > b6;
	const F6_5: bool = A6 >= B6;
	let r6_5 = a6 >= b6;
	printf("compare f32 inf inf = %d%d %d%d %d%d %d%d %d%d %d%d\n".ptr, F6_0 as c_int, r6_0 as c_int, F6_1 as c_int, r6_1 as c_int, F6_2 as c_int, r6_2 as c_int, F6_3 as c_int, r6_3 as c_int, F6_4 as c_int, r6_4 as c_int, F6_5 as c_int, r6_5 as c_int);
	const A7: f32 = 1.5;
	const B7: f32 = 1.5;
	let a7: f32 = 1.5 * one;
	let b7: f32 = 1.5 * one;
	const F7_0: bool = A7 == B7;
	let r7_0 = a7 == b7;
	const F7_1: bool = A7 != B7;
	let r7_1 = a7 != b7;
	const F7_2: bool = A7 < B7;
	let r7_2 = a7 < b7;
	const F7_3: bool = A7 <= B7;
	let r7_3 = a7 <= b7;
	const F7_4: bool = A7 > B7;
	let r7_4 = a7 > b7;
	const F7_5: bool = A7 >= B7;
	let r7_5 = a7 >= b7;
	printf("compare f32 1.5 1.5 = %d%d %d%d %d%d %d%d %d%d %d%d\n".ptr, F7_0 as c_int, r7_0 as c_int, F7_1 as c_int, r7_1 as c_int, F7_2 as c_int, r7_2 as c_int, F7_3 as c_int, r7_3 as c_int, F7_4 as c_int, r7_4 as c_int, F7_5 as c_int, r7_5 as c_int);
	const A8: f32 = 0.1;
	const B8: f32 = 0.2;
	let a8: f32 = 0.1 * one;
	let b8: f32 = 0.2 * one;
