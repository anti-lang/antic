//! The six comparisons `== != < <= > >=`, in that order, on `f32` and `f64`: a
//! NaN on either side, both zeros and the infinities. Each pair of digits is
//! the answer the checker folds in a constant and the answer the program
//! computes. A NaN equals nothing, itself included, and both zeros are equal.

extern fn printf(format: ?*byte, ...) -> c_int;

fn on_f32(one: f32)
{
	const A0: f32 = 0.0 / 0.0;
	const B0: f32 = 1.0;
	let a0: f32 = (one - one) / (one - one);
	let b0: f32 = 1.0 * one;
	const F0_0: bool = A0 == B0;
	let r0_0 = a0 == b0;
	const F0_1: bool = A0 != B0;
	let r0_1 = a0 != b0;
	const F0_2: bool = A0 < B0;
	let r0_2 = a0 < b0;
	const F0_3: bool = A0 <= B0;
	let r0_3 = a0 <= b0;
