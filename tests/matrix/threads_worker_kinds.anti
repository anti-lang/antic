//! An argument and a result of a `dispatch`, and an element and a result of a
//! `parallel`, with each kind of value that holds no pointer: the numbers,
//! `f16`, `bool`, `char`, `str`, a fixed array, an optional value, a tuple, a
//! struct, a packed struct, a simd struct, a union, an enum, a variant and a
//! class value. A worker takes a pointer to a synchronized object, to a
//! concurrent object and to a Mutex as well. Each kind is a worker of its own,
//! which gives its argument back.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

struct Point
{
	x: int,
	y: int,
}

packed struct Record
{
	tag: u8,
	n: int,
}

simd struct Vec4 { x: f32, y: f32, z: f32, w: f32 }

union Word
{
	n: int,
	f: f32,
}

enum Level
{
	Low,
	High,
}

variant Shape
{
	Circle { r: int },
	Empty,
}

class Plain
{
	pub n: int = 0,
}

synchronized class Counter
{
	pub n: int = 0,

	pub fn get(self) -> int
	{
		return self.n;
	}
}

concurrent class Gauge
{
	pub atomic n: int = 0,
}

fn area(s: Shape) -> int
{
	let size = -1;
	switch s {
		Circle c => size = c.r * 3,
		Empty => size = -1,
	}
	return size;
}

class Task
{
	pub n: int = 0,
}

worker fn pass_i8(t: *Task, v: i8) -> i8
{
	t.n += 1;
	return v;
}

worker fn last_i8(chunk: []i8, v: i8) -> i8
{
	if chunk.len == 2 {
		return chunk[1];
	}
	return v;
}

fn of_i8(t: *Task)
{
	let first = dispatch t -> pass_i8(-8);
	let a = join(first);
	let pa = &a;
	let items: [2]i8 = [-8, 7];
	unchecked(escaping-local, "until the step sweep")
	let parts = parallel items[0..2] by 1 -> last_i8(-8);
	let pb = &parts[0];
	printf("i8 %d %d\n".ptr, *pa as c_int, *pb as c_int);
	free(parts.ptr);
}

