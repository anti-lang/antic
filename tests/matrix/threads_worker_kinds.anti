fn of_simd_struct(t: *Task)
{
	let first = dispatch t -> pass_simd_struct(Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 4.0 });
	let a = join(first);
	let pa = &a;
	let items: [2]Vec4 = [Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 4.0 }, Vec4 { x: 0.5, y: 0.5, z: 0.5, w: 0.5 }];
	unchecked(escaping-local, "until the step sweep")
	let parts = parallel items[0..2] by 1 -> last_simd_struct(Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 4.0 });
	let pb = &parts[0];
	printf("simd_struct %g %g\n".ptr, (pa.x + pa.y + pa.z + pa.w) as f64, (pb.x + pb.y + pb.z + pb.w) as f64);
	free(parts.ptr);
}

