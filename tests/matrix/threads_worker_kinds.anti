	let pb = &parts[0];
	printf("class %d %d\n".ptr, pa.n as c_int, pb.n as c_int);
	free(parts.ptr);
}

worker fn touch(t: *Task, c: *Counter, g: *Gauge, m: *Mutex) -> int
{
	sync *m {
		t.n += 1;
	}
	g.n.add(c.get());
	return g.n.load();
}

fn of_thread_safe(t: *Task)
{
	let c = alloc Counter { n: 5 };
	let g = alloc Gauge { n: 7 };
	let m = Mutex.new();
	let job = dispatch t -> touch(c, g, &m);
	printf("thread_safe %d\n".ptr, join(job) as c_int);
	m.destroy();
	delete(c);
	delete(g);
}

fn main() -> int
{
	let t = alloc Task { };
	of_i8(t);
	of_i16(t);
	of_i32(t);
	of_i64(t);
	of_u8(t);
	of_u16(t);
	of_u32(t);
	of_u64(t);
	of_uint(t);
	of_byte(t);
	of_f32(t);
	of_f64(t);
	of_f16();
	of_bool(t);
	of_char(t);
	of_str(t);
	of_fixed_array(t);
	of_optional_value(t);
	of_tuple(t);
	of_struct(t);
	of_packed_struct(t);
	of_simd_struct(t);
	of_union(t);
	of_enum(t);
	of_variant(t);
	of_class(t);
	of_thread_safe(t);
	printf("jobs %d\n".ptr, t.n as c_int);
	delete(t);
	return 0;
}
