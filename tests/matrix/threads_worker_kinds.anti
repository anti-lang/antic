worker fn last_f16(chunk: []f16) -> f32
{
	return chunk[chunk.len - 1];
}

fn of_f16()
{
	let items: [2]f16 = [1.5 as f16, -0.5 as f16];
	unchecked(escaping-local, "until the step sweep")
	let whole = parallel items[0..2] by 1 -> last_f16;
	unchecked(escaping-local, "until the step sweep")
	let halves = parallel items[0..2] by 2 -> last_f16;
	printf("f16 %g %g\n".ptr, halves[0] as f64, whole[0] as f64);
	free(whole.ptr);
	free(halves.ptr);
}

