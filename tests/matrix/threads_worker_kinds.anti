	let first = dispatch t -> pass_class(Plain { n: 3 });
	let a = join(first);
	let pa = &a;
	let items: [2]Plain = [Plain { n: 3 }, Plain { n: 4 }];
	unchecked(escaping-local, "until the step sweep")
