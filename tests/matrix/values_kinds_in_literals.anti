fn array_on_generic<T>(a: T, b: T, read: fn(T) -> int)
{
	let xs: [2]T = [dup(a), dup(b)];
	printf("array generic %lld %lld\n".ptr, read(xs[0]), read(xs[1]));
}

fn array_repeat_on_i8()
{
	let xs: [3]i8 = [127; 3];
	let ys: [2]i8 = [-128; 2];
	printf("array_repeat i8 %lld %lld\n".ptr, xs[2] as int, ys[0] as int);
}

