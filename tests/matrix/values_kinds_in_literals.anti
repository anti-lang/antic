fn array_repeat_on_generic<T>(a: T, b: T, read: fn(T) -> int)
{
	let xs: [3]T = [dup(a); 3];
	let ys: [2]T = [dup(b); 2];
	printf("array_repeat generic %lld %lld\n".ptr, read(xs[2]), read(ys[0]));
}

fn slice_literal_on_i8()
{
	let xs: [2]i8 = [127, -128];
	let s = []i8 { ptr: &xs[0], len: 2 };
	printf("slice_literal i8 %lld %lld\n".ptr, s[0] as int, s[1] as int);
}

