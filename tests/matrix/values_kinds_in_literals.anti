	let b = 22;
	let xs: [3]*int = [&a; 3];
	let ys: [2]*int = [&b; 2];
	printf("array_repeat pointer %lld %lld\n".ptr, *xs[2], *ys[0]);
}

fn array_repeat_on_nullable_pointer()
{
	let a = 11;
	let b = 22;
	let some: ?*int = &a;
	let nothing: ?*int = none;
	let xs: [3]?*int = [some; 3];
	let ys: [2]?*int = [nothing; 2];
	printf("array_repeat nullable_pointer %lld %lld\n".ptr, *(xs[2] ?? &b), *(ys[0] ?? &b));
}

fn array_repeat_on_optional()
{
	let some: ?int = 5;
	let nothing: ?int = none;
	let xs: [3] ?int = [some; 3];
	let ys: [2] ?int = [nothing; 2];
	printf("array_repeat optional %lld %lld\n".ptr, (xs[2] ?? -1), (ys[0] ?? -1));
}

fn array_repeat_on_may_fail_fn()
{
	let xs: [3] fn(int) -> int may fail = [risky_up; 3];
	let ys: [2] fn(int) -> int may fail = [risky_down; 2];
	printf("array_repeat may_fail_fn %lld %lld\n".ptr, settle(xs[2]), settle(ys[0]));
}

fn array_repeat_on_fn()
{
	let xs: [3] fn(int) -> int = [up; 3];
	let ys: [2] fn(int) -> int = [down; 2];
	printf("array_repeat fn %lld %lld\n".ptr, xs[2](10), ys[0](10));
}

fn array_repeat_on_tuple()
{
	let xs: [3](int, bool) = [(1, true); 3];
	let ys: [2](int, bool) = [(2, false); 2];
	printf("array_repeat tuple %lld %lld\n".ptr, xs[2].0, ys[0].0);
}

fn array_repeat_on_channel()
{
	let c1 = chan int(1);
	let c2 = chan int(1);
	let xs: [3] chan int = [c1; 3];
	let ys: [2] chan int = [c2; 2];
	printf("array_repeat channel %d %d\n".ptr, (xs[2] == c1) as c_int, (ys[0] == c1) as c_int);
	delete(c1);
	delete(c2);
}

