fn array_on_channel()
{
	let c1 = chan int(1);
	let c2 = chan int(1);
	let xs: [2] chan int = [c1, c2];
	printf("array channel %d %d\n".ptr, (xs[0] == c1) as c_int, (xs[1] == c1) as c_int);
	delete(c1);
	delete(c2);
}

