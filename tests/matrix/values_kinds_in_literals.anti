fn slice_literal_on_uint()
{
	let xs: [2]uint = [18446744073709551615, 1];
	let s = []uint { ptr: &xs[0], len: 2 };
	printf("slice_literal uint %llu %llu\n".ptr, s[0] as u64, s[1] as u64);
}

fn slice_literal_on_byte()
{
	let xs: [2]byte = [255, 1];
	let s = []byte { ptr: &xs[0], len: 2 };
	printf("slice_literal byte %llu %llu\n".ptr, s[0] as u64, s[1] as u64);
}

fn slice_literal_on_f32()
{
	let xs: [2]f32 = [1.5, -0.25];
	let s = []f32 { ptr: &xs[0], len: 2 };
	printf("slice_literal f32 %g %g\n".ptr, s[0] as f64, s[1] as f64);
}

fn slice_literal_on_f64()
{
	let xs: [2]f64 = [1.5, -0.25];
	let s = []f64 { ptr: &xs[0], len: 2 };
	printf("slice_literal f64 %g %g\n".ptr, s[0], s[1]);
}

fn slice_literal_on_f16()
{
	let xs: [2]f16 = [1.5 as f16, -0.25 as f16];
	let s = []f16 { ptr: &xs[0], len: 2 };
	printf("slice_literal f16 %g %g\n".ptr, s[0] as f64, s[1] as f64);
}

fn slice_literal_on_bool()
{
	let xs: [2]bool = [true, false];
	let s = []bool { ptr: &xs[0], len: 2 };
	printf("slice_literal bool %d %d\n".ptr, s[0] as c_int, s[1] as c_int);
}

fn slice_literal_on_char()
{
	let xs: [2]char = ['a', '\u{10FFFF}'];
	let s = []char { ptr: &xs[0], len: 2 };
	printf("slice_literal char %u %u\n".ptr, s[0] as u32, s[1] as u32);
}

fn slice_literal_on_str()
{
	let xs: [2]str = ["one", "three"];
	let s = []str { ptr: &xs[0], len: 2 };
	printf("slice_literal str %lld %lld\n".ptr, s[0].len, s[1].len);
}

fn slice_literal_on_slice()
{
	let base = [1, 2, 3];
	let xs: [2][]int = [base[0..1], base[0..3]];
	let s = [][]int { ptr: &xs[0], len: 2 };
	printf("slice_literal slice %lld %lld\n".ptr, s[0].len, s[1].len);
}

fn slice_literal_on_fixed_array()
{
	let xs: [2][2]int = [[1, 2], [3, 4]];
	let s = [][2]int { ptr: &xs[0], len: 2 };
	printf("slice_literal fixed_array %lld %lld\n".ptr, s[0][1], s[1][1]);
}

fn slice_literal_on_pointer()
{
	let a = 11;
	let b = 22;
	let xs: [2]*int = [&a, &b];
	let s = []*int { ptr: &xs[0], len: 2 };
	printf("slice_literal pointer %lld %lld\n".ptr, *s[0], *s[1]);
}

fn slice_literal_on_nullable_pointer()
{
	let a = 11;
	let b = 22;
	let xs: [2]?*int = [&a, none];
	let s = []?*int { ptr: &xs[0], len: 2 };
	printf("slice_literal nullable_pointer %lld %lld\n".ptr, *(s[0] ?? &b), *(s[1] ?? &b));
}

fn slice_literal_on_optional()
{
	let xs: [2] ?int = [5, none];
	let s = [] ?int { ptr: &xs[0], len: 2 };
	printf("slice_literal optional %lld %lld\n".ptr, (s[0] ?? -1), (s[1] ?? -1));
}

fn slice_literal_on_may_fail_fn()
{
	let xs: [2] fn(int) -> int may fail = [risky_up, risky_down];
	let s = [] fn(int) -> int may fail { ptr: &xs[0], len: 2 };
	printf("slice_literal may_fail_fn %lld %lld\n".ptr, settle(s[0]), settle(s[1]));
}

fn slice_literal_on_fn()
{
	let xs: [2] fn(int) -> int = [up, down];
	let s = [] fn(int) -> int { ptr: &xs[0], len: 2 };
	printf("slice_literal fn %lld %lld\n".ptr, s[0](10), s[1](10));
}

fn slice_literal_on_tuple()
{
	let xs: [2](int, bool) = [(1, true), (2, false)];
	let s = [](int, bool) { ptr: &xs[0], len: 2 };
	printf("slice_literal tuple %lld %lld\n".ptr, s[0].0, s[1].0);
}

fn slice_literal_on_channel()
{
	let c1 = chan int(1);
	let c2 = chan int(1);
	let xs: [2] chan int = [c1, c2];
	let s = [] chan int { ptr: &xs[0], len: 2 };
	printf("slice_literal channel %d %d\n".ptr, (s[0] == c1) as c_int, (s[1] == c1) as c_int);
	delete(c1);
	delete(c2);
}

fn slice_literal_on_struct()
{
	let xs: [2]Pt = [Pt { x: 1, y: 2 }, Pt { x: 3, y: 4 }];
	let s = []Pt { ptr: &xs[0], len: 2 };
	printf("slice_literal struct %lld %lld\n".ptr, s[0].y, s[1].y);
}

fn slice_literal_on_packed_struct()
{
	let xs: [2]Pk = [Pk { a: 1, b: 2 }, Pk { a: 3, b: 4 }];
	let s = []Pk { ptr: &xs[0], len: 2 };
	printf("slice_literal packed_struct %lld %lld\n".ptr, s[0].b as int, s[1].b as int);
}

fn slice_literal_on_simd_struct()
{
	let xs: [2]I32x4 = [I32x4 { a: 1, b: 2, c: 3, d: 4 }, I32x4 { a: 5, b: 6, c: 7, d: 8 }];
	let s = []I32x4 { ptr: &xs[0], len: 2 };
	printf("slice_literal simd_struct %lld %lld\n".ptr, s[0].c as int, s[1].c as int);
}

fn slice_literal_on_union()
{
	let xs: [2]Bits = [Bits { i: 7 }, Bits { i: 9 }];
	let s = []Bits { ptr: &xs[0], len: 2 };
	printf("slice_literal union %lld %lld\n".ptr, s[0].i as int, s[1].i as int);
}

fn slice_literal_on_enum()
{
	let xs: [2]Color = [Color.Green, Color.Blue];
	let s = []Color { ptr: &xs[0], len: 2 };
	printf("slice_literal enum %lld %lld\n".ptr, s[0] as int, s[1] as int);
}

fn slice_literal_on_variant()
{
	let xs: [2]Shape = [Shape.Circle { r: 2 }, Shape.Empty];
	let s = []Shape { ptr: &xs[0], len: 2 };
	printf("slice_literal variant %d %d\n".ptr, (s[0] is Shape.Circle) as c_int, (s[1] is Shape.Circle) as c_int);
}

fn slice_literal_on_class()
{
	let xs: [2]Counter = [Counter { n: 5 }, Counter { n: 6 }];
	let s = []Counter { ptr: &xs[0], len: 2 };
	printf("slice_literal class %lld %lld\n".ptr, s[0].n, s[1].n);
}

fn slice_literal_on_synchronized_class()
{
	let xs: [2]Tally = [Tally { n: 5 }, Tally { n: 6 }];
	let s = []Tally { ptr: &xs[0], len: 2 };
	printf("slice_literal synchronized_class %lld %lld\n".ptr, s[0].get(), s[1].get());
}

fn slice_literal_on_concurrent_class()
{
	let xs: [2]Hits = [Hits { n: 5 }, Hits { n: 6 }];
	let s = []Hits { ptr: &xs[0], len: 2 };
	printf("slice_literal concurrent_class %lld %lld\n".ptr, s[0].n.load(), s[1].n.load());
}

fn slice_literal_on_interface()
{
	let one = One { };
	let two = Two { };
	let xs: [2]*Named = [&one, &two];
	let s = []*Named { ptr: &xs[0], len: 2 };
	printf("slice_literal interface %lld %lld\n".ptr, s[0].id(), s[1].id());
}

fn slice_literal_on_generic<T>(a: T, b: T, read: fn(T) -> int)
{
	let xs: [2]T = [dup(a), dup(b)];
	let s = []T { ptr: &xs[0], len: 2 };
	printf("slice_literal generic %lld %lld\n".ptr, read(s[0]), read(s[1]));
}

fn tuple_element_on_i8()
{
	let t: (i8, int) = (127, 7);
	let u: (int, i8) = (7, -128);
	printf("tuple_element i8 %lld %lld\n".ptr, t.0 as int, u.1 as int);
}

fn tuple_element_on_i16()
{
	let t: (i16, int) = (32767, 7);
	let u: (int, i16) = (7, -32768);
	printf("tuple_element i16 %lld %lld\n".ptr, t.0 as int, u.1 as int);
}

fn tuple_element_on_i32()
{
	let t: (i32, int) = (2147483647, 7);
	let u: (int, i32) = (7, -2147483648);
	printf("tuple_element i32 %lld %lld\n".ptr, t.0 as int, u.1 as int);
}

fn tuple_element_on_i64()
{
	let t: (i64, int) = (9223372036854775807, 7);
	let u: (int, i64) = (7, -9223372036854775808);
	printf("tuple_element i64 %lld %lld\n".ptr, t.0 as int, u.1 as int);
}

fn tuple_element_on_int()
{
	let t: (int, int) = (9223372036854775807, 7);
	let u: (int, int) = (7, -9223372036854775808);
	printf("tuple_element int %lld %lld\n".ptr, t.0 as int, u.1 as int);
}

