//! Each kind of value in the literals that hold one: an array literal `[a, b]`
//! with an index into it, an array repeat `[v; n]`, a slice literal over an
//! array and the elements `t.0` and `t.1` of a tuple. Each construct with each
//! kind is a function of its own, named after both, which prints the two values
//! it holds.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

fn risky_up(n: int) -> int may fail
{
	if n < 0 {
		fail "negative";
	}
	return n + 1;
}

fn risky_down(n: int) -> int may fail
{
	if n > 0 {
		fail "positive";
	}
	return n - 1;
}

fn settle(f: fn(int) -> int may fail) -> int
{
	let got = f(10) catch {
		yield -1;
	};
	return got;
}

fn up(n: int) -> int
{
	return n + 1;
}

fn down(n: int) -> int
{
	return n - 1;
}

struct Pt
{
	x: int,
	y: int,
}

packed struct Pk
{
	a: u8,
	b: i32,
}

simd struct I32x4
{
	a: i32,
	b: i32,
	c: i32,
	d: i32,
}

union Bits
{
	i: i32,
	f: f32,
}

enum Color
{
	Red,
	Green,
	Blue,
}

variant Shape
{
	Circle { r: int },
	Empty,
}

class Counter
{
	pub n: int = 0,
}

synchronized class Tally
{
	pub n: int = 0,

	pub fn get(self) -> int
	{
		return self.n;
	}
}

concurrent class Hits
{
	pub atomic n: int = 0,
}

abstract class Named
{
	abstract fn id(self) -> int;
}

class One inherits Named
{
	concrete fn id(self) -> int
	{
		return 1;
	}
}

class Two inherits Named
{
	concrete fn id(self) -> int
	{
		return 2;
	}
}

fn same(n: int) -> int
{
	return n;
}

fn array_on_i8()
{
	let xs: [2]i8 = [127, -128];
	printf("array i8 %lld %lld\n".ptr, xs[0] as int, xs[1] as int);
}

