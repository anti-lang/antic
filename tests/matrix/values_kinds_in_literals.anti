fn array_on_pointer()
{
	let a = 11;
	let b = 22;
	let xs: [2]*int = [&a, &b];
	printf("array pointer %lld %lld\n".ptr, *xs[0], *xs[1]);
}

fn array_on_nullable_pointer()
{
	let a = 11;
	let b = 22;
	let xs: [2]?*int = [&a, none];
	printf("array nullable_pointer %lld %lld\n".ptr, *(xs[0] ?? &b), *(xs[1] ?? &b));
}

fn array_on_optional()
{
	let xs: [2] ?int = [5, none];
	printf("array optional %lld %lld\n".ptr, (xs[0] ?? -1), (xs[1] ?? -1));
}

fn array_on_may_fail_fn()
{
	let xs: [2] fn(int) -> int may fail = [risky_up, risky_down];
	printf("array may_fail_fn %lld %lld\n".ptr, settle(xs[0]), settle(xs[1]));
}

fn array_on_fn()
{
	let xs: [2] fn(int) -> int = [up, down];
	printf("array fn %lld %lld\n".ptr, xs[0](10), xs[1](10));
}

fn array_on_tuple()
{
	let xs: [2](int, bool) = [(1, true), (2, false)];
