{
	let t: (u16, int) = (65535, 7);
	let u: (int, u16) = (7, 1);
	printf("tuple_element u16 %llu %llu\n".ptr, t.0 as u64, u.1 as u64);
}

fn tuple_element_on_u32()
{
	let t: (u32, int) = (4294967295, 7);
	let u: (int, u32) = (7, 1);
	printf("tuple_element u32 %llu %llu\n".ptr, t.0 as u64, u.1 as u64);
}

fn tuple_element_on_u64()
{
	let t: (u64, int) = (18446744073709551615, 7);
	let u: (int, u64) = (7, 1);
	printf("tuple_element u64 %llu %llu\n".ptr, t.0 as u64, u.1 as u64);
}

fn tuple_element_on_uint()
{
	let t: (uint, int) = (18446744073709551615, 7);
	let u: (int, uint) = (7, 1);
	printf("tuple_element uint %llu %llu\n".ptr, t.0 as u64, u.1 as u64);
}

fn tuple_element_on_byte()
{
	let t: (byte, int) = (255, 7);
	let u: (int, byte) = (7, 1);
	printf("tuple_element byte %llu %llu\n".ptr, t.0 as u64, u.1 as u64);
}

fn tuple_element_on_f32()
{
	let t: (f32, int) = (1.5, 7);
	let u: (int, f32) = (7, -0.25);
	printf("tuple_element f32 %g %g\n".ptr, t.0 as f64, u.1 as f64);
}

fn tuple_element_on_f64()
{
	let t: (f64, int) = (1.5, 7);
	let u: (int, f64) = (7, -0.25);
	printf("tuple_element f64 %g %g\n".ptr, t.0, u.1);
}

fn tuple_element_on_f16()
{
	let t: (f16, int) = (1.5 as f16, 7);
	let u: (int, f16) = (7, -0.25 as f16);
	printf("tuple_element f16 %g %g\n".ptr, t.0 as f64, u.1 as f64);
}

fn tuple_element_on_bool()
{
	let t: (bool, int) = (true, 7);
	let u: (int, bool) = (7, false);
	printf("tuple_element bool %d %d\n".ptr, t.0 as c_int, u.1 as c_int);
}

fn tuple_element_on_char()
{
	let t: (char, int) = ('a', 7);
	let u: (int, char) = (7, '\u{10FFFF}');
	printf("tuple_element char %u %u\n".ptr, t.0 as u32, u.1 as u32);
}

fn tuple_element_on_str()
{
	let t: (str, int) = ("one", 7);
	let u: (int, str) = (7, "three");
	printf("tuple_element str %lld %lld\n".ptr, t.0.len, u.1.len);
}

fn tuple_element_on_slice()
{
	let base = [1, 2, 3];
	let t: ([]int, int) = (base[0..1], 7);
	let u: (int, []int) = (7, base[0..3]);
	printf("tuple_element slice %lld %lld\n".ptr, t.0.len, u.1.len);
}

fn tuple_element_on_fixed_array()
{
	let t: ([2]int, int) = ([1, 2], 7);
	let u: (int, [2]int) = (7, [3, 4]);
	printf("tuple_element fixed_array %lld %lld\n".ptr, t.0[1], u.1[1]);
}

fn tuple_element_on_pointer()
{
	let a = 11;
	let b = 22;
	let t: (*int, int) = (&a, 7);
	let u: (int, *int) = (7, &b);
	printf("tuple_element pointer %lld %lld\n".ptr, *t.0, *u.1);
}

fn tuple_element_on_nullable_pointer()
{
	let a = 11;
	let b = 22;
	let t: (?*int, int) = (&a, 7);
	let u: (int, ?*int) = (7, none);
	printf("tuple_element nullable_pointer %lld %lld\n".ptr, *(t.0 ?? &b), *(u.1 ?? &b));
}

fn tuple_element_on_optional()
{
	let t: (?int, int) = (5, 7);
	let u: (int, ?int) = (7, none);
	printf("tuple_element optional %lld %lld\n".ptr, (t.0 ?? -1), (u.1 ?? -1));
}

fn tuple_element_on_may_fail_fn()
{
	let t: (fn(int) -> int may fail, int) = (risky_up, 7);
	let u: (int, fn(int) -> int may fail) = (7, risky_down);
	printf("tuple_element may_fail_fn %lld %lld\n".ptr, settle(t.0), settle(u.1));
}

fn tuple_element_on_fn()
{
	let t: (fn(int) -> int, int) = (up, 7);
	let u: (int, fn(int) -> int) = (7, down);
	printf("tuple_element fn %lld %lld\n".ptr, t.0(10), u.1(10));
}

fn tuple_element_on_tuple()
{
	let t: ((int, bool), int) = ((1, true), 7);
	let u: (int, (int, bool)) = (7, (2, false));
	printf("tuple_element tuple %lld %lld\n".ptr, t.0.0, u.1.0);
}

fn tuple_element_on_channel()
{
	let c1 = chan int(1);
	let c2 = chan int(1);
	let t: (chan int, int) = (c1, 7);
	let u: (int, chan int) = (7, c2);
	printf("tuple_element channel %d %d\n".ptr, (t.0 == c1) as c_int, (u.1 == c1) as c_int);
	delete(c1);
	delete(c2);
}

fn tuple_element_on_struct()
{
	let t: (Pt, int) = (Pt { x: 1, y: 2 }, 7);
	let u: (int, Pt) = (7, Pt { x: 3, y: 4 });
	printf("tuple_element struct %lld %lld\n".ptr, t.0.y, u.1.y);
}

fn tuple_element_on_packed_struct()
{
	let t: (Pk, int) = (Pk { a: 1, b: 2 }, 7);
	let u: (int, Pk) = (7, Pk { a: 3, b: 4 });
	printf("tuple_element packed_struct %lld %lld\n".ptr, t.0.b as int, u.1.b as int);
}

fn tuple_element_on_simd_struct()
{
	let t: (I32x4, int) = (I32x4 { a: 1, b: 2, c: 3, d: 4 }, 7);
	let u: (int, I32x4) = (7, I32x4 { a: 5, b: 6, c: 7, d: 8 });
	printf("tuple_element simd_struct %lld %lld\n".ptr, t.0.c as int, u.1.c as int);
}

fn tuple_element_on_union()
{
	let t: (Bits, int) = (Bits { i: 7 }, 7);
	let u: (int, Bits) = (7, Bits { i: 9 });
	printf("tuple_element union %lld %lld\n".ptr, t.0.i as int, u.1.i as int);
}

fn tuple_element_on_enum()
{
	let t: (Color, int) = (Color.Green, 7);
	let u: (int, Color) = (7, Color.Blue);
	printf("tuple_element enum %lld %lld\n".ptr, t.0 as int, u.1 as int);
}

fn tuple_element_on_variant()
{
	let t: (Shape, int) = (Shape.Circle { r: 2 }, 7);
	let u: (int, Shape) = (7, Shape.Empty);
	printf("tuple_element variant %d %d\n".ptr, (t.0 is Shape.Circle) as c_int, (u.1 is Shape.Circle) as c_int);
}

fn tuple_element_on_class()
{
	let t: (Counter, int) = (Counter { n: 5 }, 7);
	let u: (int, Counter) = (7, Counter { n: 6 });
	printf("tuple_element class %lld %lld\n".ptr, t.0.n, u.1.n);
}

fn tuple_element_on_synchronized_class()
{
	let t: (Tally, int) = (Tally { n: 5 }, 7);
	let u: (int, Tally) = (7, Tally { n: 6 });
	printf("tuple_element synchronized_class %lld %lld\n".ptr, t.0.get(), u.1.get());
}

fn tuple_element_on_concurrent_class()
{
	let t: (Hits, int) = (Hits { n: 5 }, 7);
	let u: (int, Hits) = (7, Hits { n: 6 });
	printf("tuple_element concurrent_class %lld %lld\n".ptr, t.0.n.load(), u.1.n.load());
}

fn tuple_element_on_interface()
{
	let one = One { };
	let two = Two { };
	let t: (*Named, int) = (&one, 7);
	let u: (int, *Named) = (7, &two);
	printf("tuple_element interface %lld %lld\n".ptr, t.0.id(), u.1.id());
}

fn tuple_element_on_generic<T>(a: T, b: T, read: fn(T) -> int)
{
	let t: (T, int) = (dup(a), 7);
	let u: (int, T) = (7, dup(b));
	printf("tuple_element generic %lld %lld\n".ptr, read(t.0), read(u.1));
}

