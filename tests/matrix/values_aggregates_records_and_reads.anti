//! The struct literals, the tuples and their elements of the values area, and
//! what reads an aggregate: index, slice and field, each in every place its row
//! of docs/notes/test-matrix.md left open. Each construct in each place is a
//! function of its own, named after both, and the program prints one line per
//! construct, place and input. The array literals, the array repeats and the
//! slice literals stand in values_aggregates_arrays.anti, by Q9 of "Answers of
//! 2026-10-24".

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

struct Pt
{
	x: int,
	y: int,
}

class Task
{
	pub n: int = 0,
}

fn in_defer_struct_literal(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let p = Pt { y: 2, x: n };
		acc += p.x * 10 + p.y;
	}
	acc = 5;
}

fn in_undo_struct_literal(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let p = Pt { y: 2, x: n };
		acc += p.x * 10 + p.y;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn apply_struct_literal(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_struct_literal(start: int) -> int
{
	let acc = 0;
	let got = apply_struct_literal(start, fn(n) {
		let p = Pt { y: 2, x: n };
		acc += p.x * 10 + p.y;
		return acc;
	});
	return got + acc;
}

worker fn work_struct_literal(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_struct_literal(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_struct_literal(fn(n) {
		let acc = 0;
		let p = Pt { y: 2, x: n };
		acc += p.x * 10 + p.y;
		return acc;
	});
	return join(job);
}

struct Guarded_struct_literal
{
	lock: Mutex,
	entered: int,
}

fn in_sync_struct_literal(g: *Guarded_struct_literal, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let p = Pt { y: 2, x: n };
		acc += p.x * 10 + p.y;
	}
	return acc;
}

fn in_select_struct_literal(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let p = Pt { y: 2, x: n };
			acc += p.x * 10 + p.y;
		},
	}
	return acc;
}

fn in_arm_tuple(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let t = (n, 7, n * 2);
			acc += t.0 + t.1 + t.2;
		},
	}
	return acc;
}

fn held_tuple(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_tuple(n: int) -> int
{
	let acc = 0;
	if let v = held_tuple(n) {
		acc += v - n * 3;
		let t = (n, 7, n * 2);
		acc += t.0 + t.1 + t.2;
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_tuple(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let t = (n, 7, n * 2);
		acc += t.0 + t.1 + t.2;
	}
	acc = 5;
}

fn in_undo_tuple(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let t = (n, 7, n * 2);
		acc += t.0 + t.1 + t.2;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn apply_tuple(n: int, f: fn(int) -> int) -> int
{
	return f(n);
}

fn in_closure_tuple(start: int) -> int
{
	let acc = 0;
	let got = apply_tuple(start, fn(n) {
		let t = (n, 7, n * 2);
		acc += t.0 + t.1 + t.2;
		return acc;
	});
	return got + acc;
}

worker fn work_tuple(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_tuple(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_tuple(fn(n) {
		let acc = 0;
		let t = (n, 7, n * 2);
		acc += t.0 + t.1 + t.2;
		return acc;
	});
	return join(job);
}

struct Guarded_tuple
{
	lock: Mutex,
	entered: int,
}

fn in_sync_tuple(g: *Guarded_tuple, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let t = (n, 7, n * 2);
		acc += t.0 + t.1 + t.2;
	}
	return acc;
}

fn in_select_tuple(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let t = (n, 7, n * 2);
			acc += t.0 + t.1 + t.2;
		},
	}
	return acc;
}

class Outer_tuple
{
	class Inner_tuple
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let t = (n, 7, n * 2);
			acc += t.0 + t.1 + t.2;
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_tuple { base: 1000 };
		return inner.run(n);
	}
}

fn in_arm_tuple_element(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let t = (n, 7);
			t.1 = t.0 * 10;
			acc += t.1 + t.0;
		},
	}
	return acc;
}

fn held_tuple_element(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_tuple_element(n: int) -> int
{
	let acc = 0;
	if let v = held_tuple_element(n) {
		acc += v - n * 3;
		let t = (n, 7);
		t.1 = t.0 * 10;
		acc += t.1 + t.0;
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_tuple_element(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let t = (n, 7);
		t.1 = t.0 * 10;
		acc += t.1 + t.0;
	}
	acc = 5;
}

fn in_undo_tuple_element(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let t = (n, 7);
		t.1 = t.0 * 10;
		acc += t.1 + t.0;
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_tuple_element(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_tuple_element(n: int) -> int
{
	let acc = 0;
	let got = risky_tuple_element(n) catch {
		let t = (n, 7);
		t.1 = t.0 * 10;
		acc += t.1 + t.0;
		yield acc;
	};
	return got;
}

worker fn work_tuple_element(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

fn in_dispatch_tuple_element(t: *Task, start: int) -> int
{
	t.n = start;
	let job = dispatch t -> work_tuple_element(fn(n) {
		let acc = 0;
		let t = (n, 7);
		t.1 = t.0 * 10;
		acc += t.1 + t.0;
		return acc;
	});
	return join(job);
}

struct Guarded_tuple_element
{
	lock: Mutex,
	entered: int,
}

fn in_sync_tuple_element(g: *Guarded_tuple_element, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let t = (n, 7);
		t.1 = t.0 * 10;
		acc += t.1 + t.0;
	}
	return acc;
}

fn in_select_tuple_element(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let t = (n, 7);
			t.1 = t.0 * 10;
			acc += t.1 + t.0;
		},
	}
	return acc;
}

fn in_generic_tuple_element<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	let t = (n, 7);
	t.1 = t.0 * 10;
	acc += t.1 + t.0;
	return acc;
}

class Outer_tuple_element
{
	class Inner_tuple_element
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let t = (n, 7);
			t.1 = t.0 * 10;
			acc += t.1 + t.0;
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_tuple_element { base: 1000 };
		return inner.run(n);
	}
}

fn in_arm_index(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let xs = [10, 20, 30, 40, 50];
			xs[n] = xs[n] + 1;
			acc += xs[n] + xs[0];
		},
	}
	return acc;
}

fn held_index(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_index(n: int) -> int
{
	let acc = 0;
	if let v = held_index(n) {
		acc += v - n * 3;
		let xs = [10, 20, 30, 40, 50];
		xs[n] = xs[n] + 1;
		acc += xs[n] + xs[0];
	} else {
		acc = -1;
	}
	return acc;
}

