	let acc = 0;
	undo *out = acc;
	undo {
		let xs = [10, 20, 30, 40, 50];
		xs[n] = xs[n] + 1;
		acc += xs[n] + xs[0];
	}
	acc = 5;
	*out = -1;
	if n != 0 {
