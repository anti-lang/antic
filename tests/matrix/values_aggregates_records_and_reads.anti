}

fn in_catch_index(n: int) -> int
{
	let acc = 0;
	let got = risky_index(n) catch {
		let xs = [10, 20, 30, 40, 50];
		xs[n] = xs[n] + 1;
		acc += xs[n] + xs[0];
		yield acc;
	};
	return got;
}

fn in_select_index(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let xs = [10, 20, 30, 40, 50];
			xs[n] = xs[n] + 1;
			acc += xs[n] + xs[0];
		},
	}
