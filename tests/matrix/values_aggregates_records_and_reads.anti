}

class Outer_index
{
	class Inner_index
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let xs = [10, 20, 30, 40, 50];
			xs[n] = xs[n] + 1;
			acc += xs[n] + xs[0];
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_index { base: 1000 };
		return inner.run(n);
	}
}

fn in_arm_slice(n: int) -> int
{
	let acc = 0;
	switch n {
		0 => acc = -1,
		else => {
			let xs = [10, 20, 30, 40, 50];
			let s = xs[1..n + 1];
			acc += s.len * 100 + s[0] + s[n - 1];
		},
	}
	return acc;
}

fn held_slice(n: int) -> ?int
{
	if n == 0 {
		return none;
	}
	return n * 3;
}

fn in_if_let_slice(n: int) -> int
{
	let acc = 0;
	if let v = held_slice(n) {
		acc += v - n * 3;
		let xs = [10, 20, 30, 40, 50];
		let s = xs[1..n + 1];
		acc += s.len * 100 + s[0] + s[n - 1];
	} else {
		acc = -1;
	}
	return acc;
}

fn in_defer_slice(n: int, out: *int)
{
	let acc = 0;
	defer *out = acc;
	defer {
		let xs = [10, 20, 30, 40, 50];
		let s = xs[1..n + 1];
		acc += s.len * 100 + s[0] + s[n - 1];
	}
	acc = 5;
}

fn in_undo_slice(n: int, out: *int) may fail
{
	let acc = 0;
	undo *out = acc;
	undo {
		let xs = [10, 20, 30, 40, 50];
		let s = xs[1..n + 1];
		acc += s.len * 100 + s[0] + s[n - 1];
	}
	acc = 5;
	*out = -1;
	if n != 0 {
		fail "undone";
	}
}

fn risky_slice(n: int) -> int may fail
{
	if n != 0 {
		fail "refused";
	}
	return -1;
}

fn in_catch_slice(n: int) -> int
{
	let acc = 0;
	let got = risky_slice(n) catch {
		let xs = [10, 20, 30, 40, 50];
		let s = xs[1..n + 1];
		acc += s.len * 100 + s[0] + s[n - 1];
		yield acc;
	};
	return got;
}

worker fn in_worker_slice(t: *Task) -> int
{
	let n = t.n;
	let acc = 0;
	let xs = [10, 20, 30, 40, 50];
	let s = xs[1..n + 1];
	acc += s.len * 100 + s[0] + s[n - 1];
	return acc;
}

struct Guarded_slice
{
	lock: Mutex,
	entered: int,
}

fn in_sync_slice(g: *Guarded_slice, n: int) -> int
{
	let acc = 0;
	sync g.lock {
		g.entered += 1;
		let xs = [10, 20, 30, 40, 50];
		let s = xs[1..n + 1];
		acc += s.len * 100 + s[0] + s[n - 1];
	}
	return acc;
}

fn in_select_slice(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let xs = [10, 20, 30, 40, 50];
			let s = xs[1..n + 1];
			acc += s.len * 100 + s[0] + s[n - 1];
		},
	}
	return acc;
}

fn in_generic_slice<T>(n: int) -> int
{
	let acc = size_of(T) as int;
	if size_of(T) > 8 {
		acc += 100;
	}
	let xs = [10, 20, 30, 40, 50];
	let s = xs[1..n + 1];
	acc += s.len * 100 + s[0] + s[n - 1];
	return acc;
}

class Outer_slice
{
	class Inner_slice
	{
		pub base: int = 0,

		pub fn run(self, n: int) -> int
		{
			let acc = self.base;
			let xs = [10, 20, 30, 40, 50];
			let s = xs[1..n + 1];
			acc += s.len * 100 + s[0] + s[n - 1];
			return acc;
		}
	}

	pub fn go(self, n: int) -> int
	{
		let inner = Inner_slice { base: 1000 };
		return inner.run(n);
	}
}

fn in_select_field(c: chan int, n: int) -> int
{
	let acc = 0;
	send(c, n * 3);
	select {
		c x => {
			let v = x else {
				return -1;
			};
			acc += *v - n * 3;
			let p = Pt { x: n, y: 2 };
			p.y = p.x * 3;
			acc += p.x + p.y;
		},
	}
	return acc;
}

fn main() -> int
{
	let task = alloc Task { };
	{
		let deferred = 0;
		in_defer_struct_literal(1, &deferred);
		printf("struct_literal defer %d\n".ptr, deferred as c_int);
		in_defer_struct_literal(2, &deferred);
		printf("struct_literal defer %d\n".ptr, deferred as c_int);
		in_defer_struct_literal(3, &deferred);
		printf("struct_literal defer %d\n".ptr, deferred as c_int);
		in_defer_struct_literal(4, &deferred);
		printf("struct_literal defer %d\n".ptr, deferred as c_int);
		let undone = 0;
		in_undo_struct_literal(0, &undone) catch {
			yield;
		};
		printf("struct_literal undo %d\n".ptr, undone as c_int);
		in_undo_struct_literal(1, &undone) catch {
			yield;
		};
		printf("struct_literal undo %d\n".ptr, undone as c_int);
		in_undo_struct_literal(2, &undone) catch {
			yield;
		};
		printf("struct_literal undo %d\n".ptr, undone as c_int);
		in_undo_struct_literal(3, &undone) catch {
			yield;
		};
		printf("struct_literal undo %d\n".ptr, undone as c_int);
		in_undo_struct_literal(4, &undone) catch {
			yield;
		};
		printf("struct_literal undo %d\n".ptr, undone as c_int);
		printf("struct_literal closure %d\n".ptr, in_closure_struct_literal(1) as c_int);
		printf("struct_literal closure %d\n".ptr, in_closure_struct_literal(2) as c_int);
		printf("struct_literal closure %d\n".ptr, in_closure_struct_literal(3) as c_int);
		printf("struct_literal closure %d\n".ptr, in_closure_struct_literal(4) as c_int);
		printf("struct_literal dispatch %d\n".ptr, in_dispatch_struct_literal(task, 1) as c_int);
		printf("struct_literal dispatch %d\n".ptr, in_dispatch_struct_literal(task, 2) as c_int);
		printf("struct_literal dispatch %d\n".ptr, in_dispatch_struct_literal(task, 3) as c_int);
		printf("struct_literal dispatch %d\n".ptr, in_dispatch_struct_literal(task, 4) as c_int);
		let g = Guarded_struct_literal { lock: Mutex.new(), entered: 0 };
		printf("struct_literal sync %d\n".ptr, in_sync_struct_literal(&g, 1) as c_int);
		printf("struct_literal sync %d\n".ptr, in_sync_struct_literal(&g, 2) as c_int);
		printf("struct_literal sync %d\n".ptr, in_sync_struct_literal(&g, 3) as c_int);
		printf("struct_literal sync %d\n".ptr, in_sync_struct_literal(&g, 4) as c_int);
		printf("struct_literal sync entered %d\n".ptr, g.entered as c_int);
		g.lock.destroy();
		let c = chan int(1);
		printf("struct_literal select %d\n".ptr, in_select_struct_literal(c, 1) as c_int);
		printf("struct_literal select %d\n".ptr, in_select_struct_literal(c, 2) as c_int);
		printf("struct_literal select %d\n".ptr, in_select_struct_literal(c, 3) as c_int);
		printf("struct_literal select %d\n".ptr, in_select_struct_literal(c, 4) as c_int);
		delete(c);
	}
	{
		printf("tuple arm %d\n".ptr, in_arm_tuple(0) as c_int);
		printf("tuple arm %d\n".ptr, in_arm_tuple(1) as c_int);
		printf("tuple arm %d\n".ptr, in_arm_tuple(2) as c_int);
		printf("tuple arm %d\n".ptr, in_arm_tuple(3) as c_int);
		printf("tuple arm %d\n".ptr, in_arm_tuple(4) as c_int);
		printf("tuple if_let %d\n".ptr, in_if_let_tuple(0) as c_int);
		printf("tuple if_let %d\n".ptr, in_if_let_tuple(1) as c_int);
		printf("tuple if_let %d\n".ptr, in_if_let_tuple(2) as c_int);
		printf("tuple if_let %d\n".ptr, in_if_let_tuple(3) as c_int);
		printf("tuple if_let %d\n".ptr, in_if_let_tuple(4) as c_int);
		let deferred = 0;
		in_defer_tuple(1, &deferred);
		printf("tuple defer %d\n".ptr, deferred as c_int);
		in_defer_tuple(2, &deferred);
		printf("tuple defer %d\n".ptr, deferred as c_int);
		in_defer_tuple(3, &deferred);
		printf("tuple defer %d\n".ptr, deferred as c_int);
		in_defer_tuple(4, &deferred);
		printf("tuple defer %d\n".ptr, deferred as c_int);
		let undone = 0;
		in_undo_tuple(0, &undone) catch {
			yield;
		};
		printf("tuple undo %d\n".ptr, undone as c_int);
		in_undo_tuple(1, &undone) catch {
			yield;
		};
		printf("tuple undo %d\n".ptr, undone as c_int);
		in_undo_tuple(2, &undone) catch {
			yield;
		};
		printf("tuple undo %d\n".ptr, undone as c_int);
		in_undo_tuple(3, &undone) catch {
			yield;
		};
		printf("tuple undo %d\n".ptr, undone as c_int);
		in_undo_tuple(4, &undone) catch {
			yield;
		};
		printf("tuple undo %d\n".ptr, undone as c_int);
		printf("tuple closure %d\n".ptr, in_closure_tuple(1) as c_int);
		printf("tuple closure %d\n".ptr, in_closure_tuple(2) as c_int);
		printf("tuple closure %d\n".ptr, in_closure_tuple(3) as c_int);
