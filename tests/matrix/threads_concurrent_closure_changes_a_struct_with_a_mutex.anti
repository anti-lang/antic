//! A closure at a `concurrent` parameter may run on more than one thread at
//! once, so it changes no captured variable whose type is not thread-safe. Here
//! it changes one that holds a Mutex, inside a `sync` on it, since a struct is
//! no thread-safe class.

class Task
{
	pub n: int = 0,
}

worker fn work(t: *Task, concurrent f: fn(int) -> int) -> int
{
	return f(t.n);
}

struct Guard
{
	lock: Mutex,
	n: int,
}

fn main() -> int
{
	let t = alloc Task { };
	let g = Guard { n: 0 };
	let job = dispatch t -> work(fn(n) {
		sync g.lock {
			g.n += n;
		}
		return 1;
	});
	let got = join(job);
	delete(t);
	return got;
}
