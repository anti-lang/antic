//! A function in an array literal of a field default is no constant expression.
//! A library file could carry no such default.

fn twice(n: int) -> int
{
	return n * 2;
}

class Box
{
	pub calls: [2] fn(int) -> int = [twice, twice],
}

fn main() -> int
{
	let b = alloc Box { };
	let r = b.calls[1](3);
	delete(b);
	return r;
}
