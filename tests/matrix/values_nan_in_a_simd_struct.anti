//! One NaN on every target in the lanes of a simd struct, by Q1 of "Answers of
//! 2026-11-06, fourth set". A simd operation writes its lanes to memory, so
//! each context is a function of its own that makes a NaN in a lane and reads
//! the bits of that lane: a splat, a division, a negation and a sum. Each line
//! holds the bits of three NaNs: 0/0 of a zero read at run time, whose sign
//! follows the processor, its negation and a negative NaN with a payload. Every
//! target gives the canonical NaN for all three.

extern fn printf(format: ?*byte, ...) -> c_int;

union Bits32
{
	f: f32,
	u: u32,
}

union Bits64
{
	f: f64,
	u: u64,
}

/// NaN number `kind` of the three, from the zero `z`.
fn make(z: f32, kind: int) -> f32
{
	if kind == 0 {
		return z / z;
	}
	if kind == 1 {
		return -(z / z);
	}
	let b = Bits32 { u: 0xffd00000 };
	return b.f + z;
}

fn make64(z: f64, kind: int) -> f64
{
	if kind == 0 {
		return z / z;
	}
	if kind == 1 {
		return -(z / z);
	}
	let b = Bits64 { u: 0xfffa000000000000 };
	return b.f + z;
}
simd struct Vec4 { x: f32, y: f32, z: f32, w: f32 }

simd struct F64x2 { x: f64, y: f64 }

fn lane(v: *Vec4) -> u32
{
	return *(v as *u32);
}

fn simd_in_function(z: f32, kind: int) -> u32
{
	let v = Vec4.splat(make(z, kind));
	return lane(&v);
}

fn simd64_in_function(z: f64, kind: int) -> u64
{
	let v = F64x2.splat(make64(z, kind));
	return *(&v as *u64);
}

class Holder
{
	pub v: Vec4 = Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 },

	pub fn run(self, z: f32, kind: int) -> u32
	{
		let zero = Vec4.splat(z);
		let w = Vec4.splat(make(z, kind));
		self.v = zero + w;
		return *(&self.v as *u32);
	}
}

fn simd_in_loop(z: f32, kind: int) -> u32
{
	let bits: u32 = 0;
	for i in 0..2 {
		let v = Vec4.splat(make(z, kind) + i as f32);
		let w = -v;
		bits = lane(&w);
	}
	return bits;
}

fn simd_in_arm(z: f32, kind: int) -> u32
{
	let bits: u32 = 0;
	switch kind {
		9 => bits = 1,
		else => {
			let a = Vec4.splat(z);
			let q = a / a;
			if kind == 0 {
				bits = lane(&q);
			} else {
				let n = Vec4.splat(make(z, kind));
				let s = q * n;
				bits = lane(&s);
			}
		},
	}
	return bits;
}

fn held(kind: int) -> ?int
{
	if kind == 9 {
		return none;
	}
	return kind;
}

fn simd_in_if_let(z: f32, kind: int) -> u32
{
	let bits: u32 = 0;
	if let k = held(kind) {
		let v = Vec4.splat(make(z, k));
		let w = v - Vec4.splat(z);
		bits = lane(&w);
	} else {
		bits = 1;
	}
	return bits;
}

fn simd_in_defer(z: f32, kind: int, out: *u32)
{
	defer {
		let v = Vec4.splat(make(z, kind));
		*out = lane(&v);
	}
	*out = 1;
}

fn apply(z: f32, f: fn(f32) -> u32) -> u32
{
	return f(z);
}

fn simd_in_closure(z: f32, kind: int) -> u32
{
	return apply(z, fn(v) {
		let w = Vec4.splat(make(v, kind));
		return lane(&w);
	});
}

fn simd_in_generic<T>(z: f32, kind: int) -> u32
{
	let v = Vec4.splat(make(z, kind));
	return lane(&v) + (size_of(T) - size_of(T)) as u32;
}

fn line(context: str, a: u32, b: u32, c: u32)
{
	printf("simd %.*s %08x %08x %08x\n".ptr, context.len as c_int,
		context.ptr, a, b, c);
}

fn main(args: []str) -> int
{
	let z: f32 = args.len as f32 - 1.0;
	let z64: f64 = args.len as f64 - 1.0;
	line("function", simd_in_function(z, 0), simd_in_function(z, 1),
		simd_in_function(z, 2));
	let holder = alloc Holder { };
	line("method", holder.run(z, 0), holder.run(z, 1), holder.run(z, 2));
	delete(holder);
	line("loop", simd_in_loop(z, 0), simd_in_loop(z, 1), simd_in_loop(z, 2));
	line("arm", simd_in_arm(z, 0), simd_in_arm(z, 1), simd_in_arm(z, 2));
	line("if_let", simd_in_if_let(z, 0), simd_in_if_let(z, 1),
		simd_in_if_let(z, 2));
	let d0: u32 = 0;
	let d1: u32 = 0;
	let d2: u32 = 0;
	simd_in_defer(z, 0, &d0);
	simd_in_defer(z, 1, &d1);
	simd_in_defer(z, 2, &d2);
	line("defer", d0, d1, d2);
	line("closure", simd_in_closure(z, 0), simd_in_closure(z, 1),
		simd_in_closure(z, 2));
	line("generic", simd_in_generic<int>(z, 0), simd_in_generic<int>(z, 1),
		simd_in_generic<int>(z, 2));
	printf("simd f64 %016llx %016llx %016llx\n".ptr, simd64_in_function(z64, 0),
		simd64_in_function(z64, 1), simd64_in_function(z64, 2));
	return 0;
}
