//! A length of a copy of a generic function shifts with `<<%` by a count below
//! zero, which a copy refuses as a constant does, by Q13 of "Answers of
//! 2026-10-24".

extern fn printf(format: ?*byte, ...) -> c_int;

fn cells<N: int>() -> int
{
	let a: [N <<% (N - 4)]int = [0; N <<% (N - 4)];
	return a.len;
}

fn main() -> int
{
	printf("cells %d\n".ptr, cells<3>() as c_int);
	return 0;
}
