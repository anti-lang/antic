//! An abstract function takes `self`, by R117 of the rules of 2026-10-13. One
//! without it is refused where it is declared, before the parameters of the
//! `concrete fn` that fills it are counted.

abstract class Shape
{
	abstract fn sides(scale: int, more: int) -> int;
}

class Square inherits Shape
{
	pub n: int = 0,

	concrete fn sides(scale: int) -> int
	{
		return 4;
	}
}

fn main() -> int
{
	return 0;
}
