//! `a ?? b` of a fresh value and a value a local holds, of a class with a
//! `destruct`, passed to a parameter that is not `own` and read through a
//! field. The fresh value is torn down where the statement ends when the `??`
//! took it, and the local keeps its own.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Owner
{
	pub n: int = 0,

	pub fn destruct(self)
	{
		printf("destruct %d\n".ptr, self.n as c_int);
	}
}

fn some(n: int) -> ?Owner
{
	return Owner { n: n };
}

fn nothing() -> ?Owner
{
	return none;
}

fn show(x: Owner)
{
	printf("show %d\n".ptr, x.n as c_int);
}

fn main() -> int
{
	let held = Owner { n: 9 };
	let empty: ?Owner = none;
	show(some(1) ?? held);
	show(nothing() ?? held);
	show(empty ?? Owner { n: 2 });
	let n = (some(3) ?? held).n;
	printf("n %d\n".ptr, n as c_int);
	let m = (empty ?? Owner { n: 4 }).n;
	printf("m %d\n".ptr, m as c_int);
	return 0;
}
