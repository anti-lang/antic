//! A `switch` on an integer with the arm `8` before the arm `size_of(i64)`. The
//! size of an `i64` is 8 on every target, so the two arms hold one value, and
//! the second is refused, by R010 of the rules of 2026-10-13.

extern fn printf(format: ?*byte, ...) -> c_int;

fn kind(n: int) -> int
{
	let k = 0;
	switch n {
		8 => {
			k = 1;
		},
		size_of(i64) => {
			k = 2;
		},
		else => {
			k = 3;
		},
	}
	return k;
}

fn main() -> int
{
	printf("%d %d\n".ptr, kind(8) as c_int, kind(9) as c_int);
	return 0;
}
