//! A matrix class with `operator fn index` and `set_index` of two indices:
//! `m[r, c]` reads and `m[r, c] = v` writes, inside loops, and a compound
//! change goes through the two.

import anti.io;
import anti.text;

fn say(s: str)
{
	io.println(s);
	free(s.ptr);
}

class Matrix
{
	cells: [9]int = [0; 9],

	operator fn index(self, r: int, c: int) -> int
	{
		return self.cells[r * 3 + c];
	}

	operator fn set_index(self, r: int, c: int, v: int)
	{
		self.cells[r * 3 + c] = v;
	}
}

fn main() -> int
{
	let m = Matrix { };
	for r in 0..3 {
		for c in 0..3 {
			m[r, c] = r * 10 + c;
		}
	}
	m[1, 1] = m[1, 1] + 100;
	let trace = 0;
	for i in 0..3 {
		trace += m[i, i];
	}
	say(f"{m[2, 1]} {m[1, 1]} {trace}");
	return 0;
}
