//! A library whose provided class cannot be built without arguments: it holds a
//! class whose `construct` takes one, and no default fills that field. The
//! loader refuses it at `instance` and not at the link.

import net.example.tasks;

provides net.example.tasks.Tasks as Holder;

/// A number that a `construct` with an argument sets.
pub class Seed
{
	pub n: int = 0,

	fn construct(self, n: int)
	{
		self.n = n;
	}
}

/// The tasks of the library, which hold a seed.
pub class Holder
{
	implements t: tasks.Tasks,
	seed: Seed,

	/// The number of the seed.
	pub concrete fn local(self, with_destruct: bool) -> int
	{
		return self.seed.n;
	}

	/// The text `none`, which the caller does not free.
	pub concrete fn label(self, n: int) -> str
	{
		return "none";
	}

	/// The seed and `n`.
	pub concrete fn squares(self, n: int) -> int
	{
		return self.seed.n + n;
	}
}
