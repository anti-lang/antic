//! A library that provides a `Greeter`, built with
//! `antic --lib shared --no-runtime`.

import net.example.greet;

provides net.example.greet.Greeter as Fancy;

/// The greeting of the library, which counts what it was asked.
pub class Fancy
{
	implements g: greet.Greeter,

	/// The greetings asked for so far.
	count: int = 0,

	/// The words of the greeting.
	pub concrete fn words(self) -> str
	{
		self.count = self.count + 1;
		return "from the library";
	}

	/// How often the greeting was asked for.
	pub concrete fn asked(self) -> int
	{
		return self.count;
	}
}
