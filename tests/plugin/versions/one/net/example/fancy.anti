//! A library built against the earlier interface.

import net.example.greet;

provides net.example.greet.Greeter as Fancy;

/// The greeting of the older library.
pub class Fancy
{
	implements g: greet.Greeter,

	/// The words of the greeting.
	pub concrete fn words(self) -> str
	{
		return "from the older library";
	}
}
