//! A library built against the earlier interface whose class inherits it, so
//! the interface stands at offset 0 of the object, and adds a function of its
//! own in the slot that `asked` takes in the later interface.

import net.example.greet;

provides net.example.greet.Greeter as Fancy;

/// The greeting of the library that inherits the interface.
pub class Fancy inherits greet.Greeter
{
	/// The words of the greeting.
	pub concrete fn words(self) -> str
	{
		return "from the inheriting library";
	}

	/// A function of the class that the interface does not declare.
	pub fn extra(self) -> int
	{
		return 42;
	}
}
