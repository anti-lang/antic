//! A host that loads the library its first argument names and asks it for a
//! `Tasks`. The class the library provides takes arguments the host has none
//! of, so `instance` fails with the reason of the loader, by R134 of "Answers
//! of 2026-10-18". Once the library is unloaded, `instance` fails with the
//! reason that it is not open.

import anti.lang;
import anti.plugin;
import net.example.tasks;

extern fn printf(format: ?*byte, ...) -> c_int;

fn ask(lib: *plugin.Library)
{
	let made = lib.instance(tasks.Tasks) catch e {
		printf("no object: %.*s\n".ptr, e.message.len as c_int, e.message.ptr);
		return;
	};
	printf("made %lld\n".ptr, made.squares(1));
	delete(made);
}

fn main(args: []str) -> int
{
	let lib = plugin.load(args[1]) catch fatal;
	ask(lib);
	lib.unload() catch fatal;
	ask(lib);
	delete(lib);
	return 0;
}
