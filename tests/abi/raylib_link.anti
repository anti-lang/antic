//! raylib of the runtime tree, reached through the C functions of
//! raylib_probe.c. A solid red image stays red once resized, a formatted text
//! has the length it should and an integer reads back from text, a colour packs
//! as raylib packs it, and the window, drawing, model and audio functions
//! resolve at link.

extern fn printf(format: ?*byte, ...) -> i32;
extern fn raylib_probe_resize() -> i32;
extern fn raylib_probe_text() -> i32;
extern fn raylib_probe_color() -> i32;
extern fn raylib_probe_linked() -> i32;

fn show(v: i32)
{
	printf("%d\n".ptr, v as c_int);
}

fn main() -> int
{
	show(raylib_probe_resize());
	show(raylib_probe_text());
	show(raylib_probe_color());
	show(raylib_probe_linked());
	return 0;
}
