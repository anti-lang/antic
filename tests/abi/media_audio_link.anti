//! raylib and miniaudio of the runtime tree in one program, reached through the
//! C functions of media_audio_probe.c. raylib resamples a wave through the ma_
//! functions of the miniaudio library, and the program calls a generator of
//! that library itself. The link holds one copy of each ma_ function.

extern fn printf(format: ?*byte, ...) -> i32;
extern fn media_audio_probe_raylib() -> i32;
extern fn media_audio_probe_miniaudio() -> i32;

fn show(v: i32)
{
	printf("%d\n".ptr, v as c_int);
}

fn main() -> int
{
	show(media_audio_probe_raylib());
	show(media_audio_probe_miniaudio());
	return 0;
}
