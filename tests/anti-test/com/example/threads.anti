//! Every construct of the threads area in a function of a `tests` block and in
//! a function of a `fixtures` block. `anti test` compiles both, and each test
//! asserts what its constructs compute. The workers stand at module level.

class Task
{
	pub n: int = 0,
}

class Counter
{
	pub atomic hits: int = 0,
}

struct Guard
{
	lock: Mutex,
	n: int,
}

worker fn add(t: *Task, k: int) -> int
{
	return t.n + k;
}

worker fn keep(t: *Task, k: int) -> int
{
	t.n = k;
	return 0;
}

worker fn sum(chunk: []int, plus: int) -> int
{
	let total = plus;
	for v in chunk {
		total += v;
	}
	return total;
}

worker fn count(chunk: []int) -> int
{
	return chunk.len;
}

fixtures
{
	fn fix_dispatch(k: int) -> int
	{
		let acc = 0;
		let a = alloc Task { n: 100 };
		let b = alloc Task { };
		let one = dispatch a -> add(k);
		let jobs = [dispatch b -> keep(k + 1)];
		join_all(jobs[0..1]);
		acc += join(one) + b.n;
		delete(a);
		delete(b);
		return acc;
	}

	fn fix_parallel(k: int) -> int
	{
		let acc = 0;
		let numbers = [1, 2, 3, 4, 5, 6, 7, 8];
		unchecked(escaping-local, "until the step sweep")
		let parts = parallel numbers[0..8] by 4 -> sum(k);
		for part in parts {
			acc += part;
		}
		free(parts.ptr);
		unchecked(escaping-local, "until the step sweep")
		let lengths = parallel numbers[0..8] -> count;
		for length in lengths {
			acc += length;
		}
		free(lengths.ptr);
		return acc;
	}

	fn fix_mutex(k: int) -> int
	{
		let acc = 0;
		let m = Mutex.new();
		sync m {
			acc += k;
		}
		m.destroy();
		let g = Guard { lock: Mutex.new(), n: k * 10 };
		sync g.lock {
			g.n += 1;
			acc += g.n;
		}
		g.lock.destroy();
		return acc;
	}

	fn fix_channel(k: int) -> int
	{
		let acc = 0;
		let c = chan int(2);
		send(c, k);
		send(c, k * 10);
		close(c);
		while true do {
			let v = recv(c) else {
				break;
			};
			acc += *v;
		}
		delete(c);
		return acc;
	}

	fn fix_select(k: int) -> int
	{
		let acc = 0;
		let c = chan int(1);
		let d = chan int(1);
		send(d, k);
		select {
			c x => acc -= 1000,
			d y => {
				if let v = y {
					acc += *v;
				}
			},
		}
		close(c);
		select {
			c x => {
				if x == none {
					acc += 100;
				}
			},
		}
		delete(c);
		delete(d);
		return acc;
	}

	fn fix_atomic_places(k: int) -> int
	{
		let acc = 0;
		let n: atomic int = 0;
		n.store(k);
		acc += n.swap(k + 5);
		if n.compare_swap(k + 5, 7) {
			acc += n.load();
		}
		let counter = Counter { };
		counter.hits.store(k * 2);
		acc += counter.hits.swap(1);
		if counter.hits.compare_swap(1, 3) {
			acc += counter.hits.load();
		}
		return acc;
	}

	fn fix_atomic_arithmetic(k: int) -> int
	{
		let acc = 0;
		let n: atomic int = k;
		acc += n.add(3);
		acc += n.sub(1);
		acc += n.or(8);
		acc += n.and(12);
		acc += n.load();
		let counter = Counter { hits: k };
		acc += counter.hits.add(3);
		acc += counter.hits.sub(1);
		acc += counter.hits.or(8);
		acc += counter.hits.and(12);
		acc += counter.hits.load();
		return acc;
	}
}

tests
{
	fn dispatch_in_fixtures()
	{
		let first = fix_dispatch(1);
		assert(first == 103);
		let second = fix_dispatch(2);
		assert(second == 105);
	}

	fn dispatch_in_tests()
	{
		let k = 3;
		let acc = 0;
		let a = alloc Task { n: 100 };
		let b = alloc Task { };
		let one = dispatch a -> add(k);
		let jobs = [dispatch b -> keep(k + 1)];
		join_all(jobs[0..1]);
		acc += join(one) + b.n;
		delete(a);
		delete(b);
		assert(acc == 107);
	}

	fn parallel_in_fixtures()
	{
		let first = fix_parallel(1);
		assert(first == 48);
		let second = fix_parallel(2);
		assert(second == 52);
	}

	fn parallel_in_tests()
	{
		let k = 3;
		let acc = 0;
		let numbers = [1, 2, 3, 4, 5, 6, 7, 8];
		unchecked(escaping-local, "until the step sweep")
		let parts = parallel numbers[0..8] by 4 -> sum(k);
		for part in parts {
			acc += part;
		}
		free(parts.ptr);
		unchecked(escaping-local, "until the step sweep")
		let lengths = parallel numbers[0..8] -> count;
		for length in lengths {
			acc += length;
		}
		free(lengths.ptr);
		assert(acc == 56);
	}

	fn mutex_in_fixtures()
	{
		let first = fix_mutex(1);
		assert(first == 12);
		let second = fix_mutex(2);
		assert(second == 23);
	}

	fn mutex_in_tests()
	{
		let k = 3;
		let acc = 0;
		let m = Mutex.new();
		sync m {
			acc += k;
		}
		m.destroy();
		let g = Guard { lock: Mutex.new(), n: k * 10 };
		sync g.lock {
			g.n += 1;
			acc += g.n;
		}
		g.lock.destroy();
		assert(acc == 34);
	}

	fn channel_in_fixtures()
	{
		let first = fix_channel(1);
		assert(first == 11);
		let second = fix_channel(2);
		assert(second == 22);
	}

	fn channel_in_tests()
	{
		let k = 3;
		let acc = 0;
		let c = chan int(2);
		send(c, k);
		send(c, k * 10);
		close(c);
		while true do {
			let v = recv(c) else {
				break;
			};
			acc += *v;
		}
		delete(c);
		assert(acc == 33);
	}

	fn select_in_fixtures()
	{
		let first = fix_select(1);
		assert(first == 101);
		let second = fix_select(2);
		assert(second == 102);
	}

	fn select_in_tests()
	{
		let k = 3;
		let acc = 0;
		let c = chan int(1);
		let d = chan int(1);
		send(d, k);
		select {
			c x => acc -= 1000,
			d y => {
				if let v = y {
					acc += *v;
				}
			},
		}
		close(c);
		select {
			c x => {
				if x == none {
					acc += 100;
				}
			},
		}
		delete(c);
		delete(d);
		assert(acc == 103);
	}

	fn atomic_places_in_fixtures()
	{
		let first = fix_atomic_places(1);
		assert(first == 13);
		let second = fix_atomic_places(2);
		assert(second == 16);
	}

	fn atomic_places_in_tests()
	{
		let k = 3;
		let acc = 0;
		let n: atomic int = 0;
		n.store(k);
		acc += n.swap(k + 5);
		if n.compare_swap(k + 5, 7) {
			acc += n.load();
		}
		let counter = Counter { };
		counter.hits.store(k * 2);
		acc += counter.hits.swap(1);
		if counter.hits.compare_swap(1, 3) {
			acc += counter.hits.load();
		}
		assert(acc == 19);
	}

	fn atomic_arithmetic_in_fixtures()
	{
		let first = fix_atomic_arithmetic(1);
		assert(first == 54);
		let second = fix_atomic_arithmetic(2);
		assert(second == 70);
	}

	fn atomic_arithmetic_in_tests()
	{
		let k = 3;
		let acc = 0;
		let n: atomic int = k;
		acc += n.add(3);
		acc += n.sub(1);
		acc += n.or(8);
		acc += n.and(12);
		acc += n.load();
		let counter = Counter { hits: k };
		acc += counter.hits.add(3);
		acc += counter.hits.sub(1);
		acc += counter.hits.or(8);
		acc += counter.hits.and(12);
		acc += counter.hits.load();
		assert(acc == 78);
	}
}
