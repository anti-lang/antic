	fn switch_else_in_fixtures()
	{
		let got0 = fix_switch_else(1);
		assert(got0 == 10);
		let got1 = fix_switch_else(2);
		assert(got1 == 7);
		let got2 = fix_switch_else(3);
		assert(got2 == 7);
		let got3 = fix_switch_else(4);
		assert(got3 == 7);
	}

	fn switch_else_in_tests()
	{
		let n = 3;
