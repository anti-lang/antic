		assert(got0 == 10);
		let got1 = fix_switch(2);
		assert(got1 == 0);
		let got2 = fix_switch(3);
		assert(got2 == 20);
		let got3 = fix_switch(4);
		assert(got3 == 0);
	}

	fn switch_in_tests()
	{
		let n = 3;
		let acc = 0;
		switch n {
			1 => acc += 10,
			3 => {
				acc += 20;
			},
