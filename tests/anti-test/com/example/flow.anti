		switch n {
			1 => acc += 10,
			else => acc += 7,
		}
		assert(acc == 7);
	}

	fn arm_binds_in_fixtures()
	{
		let got0 = fix_arm_binds(1);
		assert(got0 == 1);
		let got1 = fix_arm_binds(2);
		assert(got1 == 4);
		let got2 = fix_arm_binds(3);
		assert(got2 == 1);
		let got3 = fix_arm_binds(4);
		assert(got3 == 1);
	}

	fn arm_binds_in_tests()
	{
		let n = 3;
		let acc = 0;
		let shape = shape_of(n);
		switch shape {
			Circle c => acc += c.r,
			Square s => {
				acc += s.side * 2;
			},
			Empty => acc += 1,
		}
		assert(acc == 1);
	}

	fn arm_call_in_fixtures()
	{
		let got0 = fix_arm_call(1);
		assert(got0 == 10);
		let got1 = fix_arm_call(2);
		assert(got1 == 3);
		let got2 = fix_arm_call(3);
		assert(got2 == 3);
		let got3 = fix_arm_call(4);
		assert(got3 == 3);
	}

	fn arm_call_in_tests()
	{
		let n = 3;
		let acc = 0;
		switch n {
			1 => add_to(&acc, 10),
			else => acc = acc + 3,
		}
		assert(acc == 3);
	}

	fn fallthrough_in_fixtures()
	{
		let got0 = fix_fallthrough(1);
		assert(got0 == 30);
		let got1 = fix_fallthrough(2);
		assert(got1 == 20);
		let got2 = fix_fallthrough(3);
		assert(got2 == 1);
		let got3 = fix_fallthrough(4);
		assert(got3 == 1);
	}

	fn fallthrough_in_tests()
	{
		let n = 3;
		let acc = 0;
		switch n {
			1 => {
				acc += 10;
				fallthrough;
			},
			2 => {
				acc += 20;
			},
			else => {
				acc += 1;
			},
		}
		assert(acc == 1);
	}

	fn if_let_in_fixtures()
	{
		let got0 = fix_if_let(1);
		assert(got0 == 0);
		let got1 = fix_if_let(2);
		assert(got1 == 1);
		let got2 = fix_if_let(3);
		assert(got2 == 0);
		let got3 = fix_if_let(4);
		assert(got3 == 2);
	}

	fn if_let_in_tests()
	{
		let n = 3;
		let acc = 0;
		let maybe = half(n);
		if let h = maybe {
			acc += h;
		}
		assert(acc == 0);
	}

	fn if_let_else_in_fixtures()
	{
		let got0 = fix_if_let_else(1);
		assert(got0 == 100);
		let got1 = fix_if_let_else(2);
		assert(got1 == 1);
		let got2 = fix_if_let_else(3);
		assert(got2 == 100);
		let got3 = fix_if_let_else(4);
		assert(got3 == 2);
	}

	fn if_let_else_in_tests()
	{
		let n = 3;
		let acc = 0;
		let maybe = half(n);
		if let h = maybe {
			acc += h;
		} else {
			acc += 100;
		}
		assert(acc == 100);
	}

	fn defer_in_fixtures()
	{
		let got0 = fix_defer(1);
		assert(got0 == 1);
		let got1 = fix_defer(2);
		assert(got1 == 2);
		let got2 = fix_defer(3);
		assert(got2 == 3);
		let got3 = fix_defer(4);
		assert(got3 == 4);
	}

	fn defer_in_tests()
	{
		let n = 3;
		let acc = 0;
		{
			defer acc += n;
			acc *= 2;
		}
		assert(acc == 3);
	}

	fn assert_in_fixtures()
	{
		let got0 = fix_assert(1);
		assert(got0 == 1);
		let got1 = fix_assert(2);
		assert(got1 == 2);
		let got2 = fix_assert(3);
		assert(got2 == 3);
		let got3 = fix_assert(4);
		assert(got3 == 4);
	}

	fn assert_in_tests()
	{
		let n = 3;
		let acc = 0;
		assert(n > 0, "n is positive");
		acc += n;
		assert(acc == 3);
	}

	fn block_in_fixtures()
	{
		let got0 = fix_block(1);
		assert(got0 == 4);
		let got1 = fix_block(2);
		assert(got1 == 7);
		let got2 = fix_block(3);
		assert(got2 == 10);
		let got3 = fix_block(4);
		assert(got3 == 13);
	}

	fn block_in_tests()
	{
		let n = 3;
		let acc = 0;
		{
			let twice = n * 2;
			acc += twice;
		}
		{
			let twice = n + 1;
			acc += twice;
		}
		assert(acc == 10);
	}

	fn and_in_fixtures()
	{
		let got0 = fix_and(1);
		assert(got0 == 0);
		let got1 = fix_and(2);
		assert(got1 == 0);
		let got2 = fix_and(3);
		assert(got2 == 11);
		let got3 = fix_and(4);
		assert(got3 == 11);
	}

	fn and_in_tests()
	{
		let n = 3;
		let acc = 0;
		if n > 2 && seen(&acc, true) {
			acc += 10;
		}
		assert(acc == 11);
