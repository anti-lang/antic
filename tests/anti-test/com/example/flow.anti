	fn return_plain_in_fixtures()
	{
		let got = 0;
		fix_return_plain(2, &got);
		assert(got == 1);
		fix_return_plain(3, &got);
		assert(got == 30);
	}

	fn return_plain_in_tests()
	{
		let n = 2;
		let acc = 1;
		if n == 2 {
			assert(acc == 1);
			return;
		}
		acc = 0;
		assert(acc == 1);
	}
}
