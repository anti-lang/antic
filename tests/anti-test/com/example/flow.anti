//! Every construct of the flow area in a function of a `tests` block and in a
//! function of a `fixtures` block. `anti test` compiles both, and each test
//! asserts what its construct computes.

variant Shape
{
	Circle { r: int },
	Square { side: int },
	Empty,
}

fn shape_of(n: int) -> Shape
{
	if n == 1 {
		return Shape.Circle { r: n };
	}
	if n == 2 {
		return Shape.Square { side: n };
	}
	return Shape.Empty;
}

fn add_to(total: *int, by: int)
{
	*total += by;
}

fn half(n: int) -> ?int
{
	if n % 2 == 0 {
		return n / 2;
	}
	return none;
}

fn seen(count: *int, answer: bool) -> bool
{
	*count += 1;
	return answer;
}

fixtures
{
	fn fix_if(n: int) -> int
	{
		let acc = 0;
		if n > 2 {
			acc += n;
		}
		return acc;
	}

	fn fix_else(n: int) -> int
	{
		let acc = 0;
		if n > 2 {
			acc += n;
		} else if n == 2 {
			acc += 20;
		} else {
			acc += 100;
		}
		return acc;
	}

	fn fix_while(n: int) -> int
	{
		let acc = 0;
		let i = 0;
		while i < n do {
			acc += i;
			i += 1;
		}
		return acc;
	}

	fn fix_do_while(n: int) -> int
	{
		let acc = 0;
		let i = 0;
		do {
			acc += i + 1;
			i += 1;
		} while i < n
		return acc;
	}

	fn fix_for_range(n: int) -> int
	{
		let acc = 0;
		for i in 0..n {
			acc += i * 2;
		}
		return acc;
	}

	fn fix_for_each(n: int) -> int
	{
		let acc = 0;
		let items = [n, 20, 300];
		for x in items {
			acc += x;
		}
		return acc;
	}

	fn fix_for_lent(n: int) -> int
	{
		let acc = 0;
		let items = [n, 20, 300];
		for p in &items {
			*p += 1;
		}
		acc += items[0] + items[1] + items[2];
		return acc;
	}

	fn fix_for_index(n: int) -> int
	{
		let acc = 0;
		let items = [n, 20, 300];
		for i, x in items {
			acc += (i + 1) * x;
		}
		return acc;
	}

	fn fix_break(n: int) -> int
	{
		let acc = 0;
		for i in 0..10 {
			if i == n {
				break;
			}
			acc += 1;
		}
		return acc;
	}

	fn fix_continue(n: int) -> int
	{
		let acc = 0;
		for i in 0..5 {
			if i == n {
				continue;
			}
			acc += i;
		}
		return acc;
	}

	fn fix_return_value(n: int) -> int
	{
		let acc = 0;
		if n == 2 {
			return 50;
		}
		acc += n;
		return acc;
	}

	fn fix_switch(n: int) -> int
	{
		let acc = 0;
		switch n {
			1 => acc += 10,
			3 => {
				acc += 20;
			},
		}
		return acc;
	}

	fn fix_switch_else(n: int) -> int
	{
		let acc = 0;
		switch n {
			1 => acc += 10,
			else => acc += 7,
		}
		return acc;
	}

	fn fix_arm_binds(n: int) -> int
	{
		let acc = 0;
		let shape = shape_of(n);
		switch shape {
			Circle c => acc += c.r,
			Square s => {
				acc += s.side * 2;
			},
			Empty => acc += 1,
		}
		return acc;
	}

	fn fix_arm_call(n: int) -> int
	{
		let acc = 0;
		switch n {
			1 => add_to(&acc, 10),
			else => acc = acc + 3,
		}
		return acc;
	}

	fn fix_fallthrough(n: int) -> int
	{
		let acc = 0;
		switch n {
			1 => {
				acc += 10;
				fallthrough;
			},
			2 => {
				acc += 20;
			},
			else => {
				acc += 1;
			},
		}
		return acc;
	}

	fn fix_if_let(n: int) -> int
	{
		let acc = 0;
		let maybe = half(n);
		if let h = maybe {
			acc += h;
		}
		return acc;
	}

	fn fix_if_let_else(n: int) -> int
	{
		let acc = 0;
		let maybe = half(n);
		if let h = maybe {
			acc += h;
		} else {
			acc += 100;
		}
		return acc;
	}

	fn fix_defer(n: int) -> int
	{
		let acc = 0;
		{
			defer acc += n;
			acc *= 2;
		}
		return acc;
	}

	fn fix_assert(n: int) -> int
	{
		let acc = 0;
		assert(n > 0, "n is positive");
		acc += n;
		return acc;
	}

	fn fix_block(n: int) -> int
	{
		let acc = 0;
		{
			let twice = n * 2;
			acc += twice;
		}
		{
			let twice = n + 1;
			acc += twice;
		}
		return acc;
	}

	fn fix_and(n: int) -> int
	{
		let acc = 0;
		if n > 2 && seen(&acc, true) {
			acc += 10;
		}
		return acc;
	}

	fn fix_or(n: int) -> int
	{
		let acc = 0;
		if n > 2 || seen(&acc, false) {
			acc += 10;
		}
		return acc;
	}

	fn fix_in_range(n: int) -> int
	{
		let acc = 0;
		if n in 2..4 {
			acc += 10;
		}
		return acc;
	}

	fn fix_return_plain(n: int, out: *int)
	{
		*out = 1;
		if n == 2 {
			return;
		}
		*out = n * 10;
	}
}

tests
{
	fn if_in_fixtures()
	{
		let got0 = fix_if(1);
		assert(got0 == 0);
		let got1 = fix_if(2);
		assert(got1 == 0);
		let got2 = fix_if(3);
		assert(got2 == 3);
		let got3 = fix_if(4);
		assert(got3 == 4);
	}

	fn if_in_tests()
	{
		let n = 3;
		let acc = 0;
		if n > 2 {
			acc += n;
		}
		assert(acc == 3);
	}

	fn else_in_fixtures()
	{
		let got0 = fix_else(1);
		assert(got0 == 100);
		let got1 = fix_else(2);
		assert(got1 == 20);
		let got2 = fix_else(3);
		assert(got2 == 3);
		let got3 = fix_else(4);
		assert(got3 == 4);
	}

	fn else_in_tests()
	{
		let n = 3;
		let acc = 0;
		if n > 2 {
			acc += n;
		} else if n == 2 {
			acc += 20;
		} else {
			acc += 100;
		}
		assert(acc == 3);
	}

	fn while_in_fixtures()
	{
		let got0 = fix_while(0);
		assert(got0 == 0);
		let got1 = fix_while(1);
		assert(got1 == 0);
		let got2 = fix_while(3);
		assert(got2 == 3);
		let got3 = fix_while(5);
		assert(got3 == 10);
	}

	fn while_in_tests()
	{
		let n = 3;
		let acc = 0;
		let i = 0;
		while i < n do {
			acc += i;
			i += 1;
		}
		assert(acc == 3);
	}

	fn do_while_in_fixtures()
	{
		let got0 = fix_do_while(0);
		assert(got0 == 1);
		let got1 = fix_do_while(1);
		assert(got1 == 1);
		let got2 = fix_do_while(3);
		assert(got2 == 6);
		let got3 = fix_do_while(5);
		assert(got3 == 15);
	}

	fn do_while_in_tests()
	{
		let n = 3;
		let acc = 0;
		let i = 0;
		do {
			acc += i + 1;
			i += 1;
		} while i < n
		assert(acc == 6);
	}

	fn for_range_in_fixtures()
	{
		let got0 = fix_for_range(0);
		assert(got0 == 0);
		let got1 = fix_for_range(1);
		assert(got1 == 0);
		let got2 = fix_for_range(3);
		assert(got2 == 6);
		let got3 = fix_for_range(5);
		assert(got3 == 20);
	}

	fn for_range_in_tests()
	{
		let n = 3;
		let acc = 0;
		for i in 0..n {
			acc += i * 2;
		}
		assert(acc == 6);
	}

	fn for_each_in_fixtures()
	{
		let got0 = fix_for_each(1);
		assert(got0 == 321);
		let got1 = fix_for_each(2);
		assert(got1 == 322);
		let got2 = fix_for_each(3);
		assert(got2 == 323);
		let got3 = fix_for_each(4);
		assert(got3 == 324);
	}

	fn for_each_in_tests()
	{
		let n = 3;
		let acc = 0;
		let items = [n, 20, 300];
		for x in items {
			acc += x;
		}
