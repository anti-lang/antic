//! A class whose base, inline field and `own` slice come from
//! `com.example.parts`. Its teardown and its copy, which the compiler writes in
//! this module, reach the ones that module writes, in release mode and in dev
//! mode. A part moves into an `own` parameter of that module, which tears it
//! down, and a part and a slice are lent to its functions.

import com.example.parts;

extern fn printf(format: ?*byte, ...) -> c_int;

class Crate inherits parts.Box
{
	pub part: parts.Part = parts.Part { n: 0 },
	pub own list: []parts.Part,

	fn destruct(self)
	{
		printf("crate out %d\n".ptr, self.n as c_int);
	}
}

fn main() -> int
{
	let c = alloc Crate {
		n: 1,
		part: parts.Part { n: 2, leaf: alloc parts.Leaf { n: 3 } },
		list: []parts.Part { ptr: alloc(parts.Part, 1), len: 1 },
	};
	c.list[0] = parts.Part { n: 4, leaf: alloc parts.Leaf { n: 5 } };
	c.fill(6);
	let d = dup(c);
	let part_leaf = d.part.leaf else { return 1; };
	part_leaf.n = 30;
	let list_leaf = d.list[0].leaf else { return 1; };
	list_leaf.n = 50;
	printf("%d %d\n".ptr, (d.part.leaf != c.part.leaf) as c_int,
		(d.list[0].leaf != c.list[0].leaf) as c_int);
	delete(d);
	delete(c);
	let q = parts.Part { n: 7 };
	parts.take(q);
	let r = parts.Part { n: 8 };
	parts.lend(&r, parts.grow);
	parts.lend(&r, fn(p) { p.n += 10; });
	printf("lent %d\n".ptr, r.n as c_int);
	let numbers: [3]int = [1, 2, 3];
	parts.lend_numbers(numbers[0..3], fn(xs) { xs[0] = parts.total(xs); });
	printf("lent slice %d\n".ptr, numbers[0] as c_int);
	return 0;
}
