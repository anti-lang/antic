//! Classes that own memory, which the test `owned_modules` holds and extends in
//! a program. Each prints when it is destroyed. A function takes a part with an
//! `own` parameter, and two lend one with `lent`. Two more lend a slice.

extern fn printf(format: ?*byte, ...) -> c_int;

pub class Leaf
{
	pub n: int = 0,

	fn destruct(self)
	{
		printf("leaf out %d\n".ptr, self.n as c_int);
	}
}

pub class Part
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,

	fn destruct(self)
	{
		printf("part out %d\n".ptr, self.n as c_int);
	}
}

/// A base whose private `own` field only its own module names.
pub class Box
{
	pub n: int = 0,
	own leaf: ?*Leaf = none,

	fn destruct(self)
	{
		printf("box out %d\n".ptr, self.n as c_int);
	}

	/// Give the box a leaf numbered n.
	pub fn fill(self, n: int)
	{
		self.leaf = alloc Leaf { n: n };
	}
}

/// Take the part p over and tear it down when done.
pub fn take(own p: Part)
{
	printf("take %d\n".ptr, p.n as c_int);
}

/// Lend the part p to f for the call.
pub fn lend(p: *Part, f: fn(lent *Part))
{
	f(p);
}

/// Count the lent part p one up.
pub fn grow(lent p: *Part)
{
	p.n += 1;
}

/// Lend the numbers xs to f for the call.
pub fn lend_numbers(xs: []int, f: fn(lent []int))
{
	f(xs);
}

/// The sum of the lent numbers xs.
pub fn total(lent xs: []int) -> int
{
	let sum = 0;
	for x in xs {
		sum += x;
	}
	return sum;
}
