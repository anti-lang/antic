//! Types and generics of hashing that another module uses: a struct with a hash
//! of its own, a generic struct whose hash is generic, and generic functions
//! that hash and order a value of a type parameter. Three generics compare with
//! the default `==`: one over a type parameter, one over a tuple of two and one
//! over a struct whose part has `operator fn eq`.

/// A name whose hash reads the first letter alone.
pub struct Name
{
	text: str,
}

/// The hash of `n`, its first letter, so two names that start alike collide.
pub operator fn hash(n: Name) -> u64
{
	if n.text.len == 0 {
		return 0;
	}
	return n.text[0] as u64;
}

/// A value of any type that hashes, with the mark it carries.
pub struct Tag<T>
{
	item: T,
	mark: int,
}

/// The hash of a key of any type that has one.
pub fn key<T: hash>(v: T) -> u64
{
	return v.hash();
}

/// The hash of `v` with 1 after it, as the default hash of a tuple gives.
pub fn with_one<T: hash>(v: T) -> u64
{
	let t = (v, 1);
	return t.hash();
}

/// The larger of `a` and `b`.
pub fn larger<T: Ordered>(a: T, b: T) -> T
{
	if a < b {
		return b;
	}
	return a;
}

/// A code equal to another with the same last digit.
pub struct Code
{
	n: int,
}

/// Whether `a` and `b` end in the same digit.
pub operator fn eq(a: Code, b: Code) -> bool
{
	return a.n % 10 == b.n % 10;
}

/// A label equal to another with the same first letter.
pub struct Label
{
	text: str,
}

/// Whether `a` and `b` start with the same letter, a second `operator fn eq` of
/// the module.
pub operator fn eq(a: Label, b: Label) -> bool
{
	return a.text.len > 0 && b.text.len > 0 && a.text[0] == b.text[0];
}

/// A value in a box.
pub struct Boxed<T>
{
	item: T,
}

/// Whether the items of two boxes are equal, a generic `operator fn eq` beside
/// the other two.
pub operator fn eq<T: eq>(a: Boxed<T>, b: Boxed<T>) -> bool
{
	return a.item == b.item;
}

/// A code with a mark, whose `==` is the default.
pub struct Coded
{
	code: Code,
	mark: int,
}

/// Whether two tags are equal by the default `==`.
pub fn same_tags<T: eq>(a: Tag<T>, b: Tag<T>) -> bool
{
	return a == b;
}

/// Whether two pairs are equal by the default `==` of a tuple.
pub fn same_pair<A: eq, B: eq>(a: (A, B), b: (A, B)) -> bool
{
	return a == b;
}

/// `x` when `a` and `b` are equal by the default `==`, and `y` otherwise.
pub fn pick<T>(a: Coded, b: Coded, x: T, y: T) -> T
{
	if a == b {
		return x;
	}
	return y;
}
