/*!
    Plane geometry.
*/
/*#!
    Built for the tests.
*/
/**
  A point.

      Two fields.
*/
pub struct Point
{
	/**
        Across.
    */
	x: f64,
	y: f64,
}

/**
Dot product.
*/
/*#
  Not a note in the file.
*/
pub fn dot(a: Point, b: Point) -> f64
{
	return a.x * b.x + a.y * b.y;
}

/**
  Private, not in the file.
*/
fn hidden() -> f64
{
	return 1.0;
}
