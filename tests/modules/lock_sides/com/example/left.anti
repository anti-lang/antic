//! Takes the two locks of a pair, `a` first.

import com.example.pairs;

pub fn forward(p: *pairs.Pair)
{
	sync p.a {
		sync p.b {
			p.n += 1;
		}
	}
}

/// A pair, for a program that imports the module of the struct only through
/// this one.
pub fn pair() -> pairs.Pair
{
	return pairs.pair();
}
