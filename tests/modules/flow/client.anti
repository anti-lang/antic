//! The client of the flow library: every construct of the flow area in a
//! function of a library module, and in a generic one that this module compiles
//! a copy of.

import com.example.flow;

extern fn printf(format: ?*byte, ...) -> c_int;

fn main() -> int
{
	printf("if %d %d\n".ptr, flow.run_if(1) as c_int,
		flow.gen_if<str>(1) as c_int);
	printf("if %d %d\n".ptr, flow.run_if(2) as c_int,
		flow.gen_if<str>(2) as c_int);
	printf("if %d %d\n".ptr, flow.run_if(3) as c_int,
		flow.gen_if<str>(3) as c_int);
	printf("if %d %d\n".ptr, flow.run_if(4) as c_int,
