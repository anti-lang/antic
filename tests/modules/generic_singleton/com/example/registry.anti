//! A generic singleton, and a function that counts in its copy of `int`, so the
//! library file holds that copy.

/// One counter per type argument.
pub singleton class Reg<T>
{
	pub atomic count: int = 0,

	/// The size of the type argument, a function without `self` beside `get`.
	pub fn width() -> int
	{
		return size_of(T) as int;
	}
}

/// Add ten to the counter of `int`.
pub fn bump()
{
	Reg<int>.get().count.add(10);
}
