//! A class that a program of another module builds, tests and compares.
//! The test `shared_class` links it in release mode and in dev mode.

/// A point that this module and the program both build.
pub class Point
{
	pub x: int = 0,
	pub y: int = 0,

	/// Move the point right by `by` and give its new `x`.
	pub fn shift(self, by: int) -> int
	{
		self.x = self.x + by;
		return self.x;
	}
}

/// A point that this module allocates.
pub fn make(x: int) -> *Point
{
	return alloc Point { x: x };
}

/// Whether `o` is a point, tested against the descriptor this module
/// names.
pub fn is_point(o: *Object) -> bool
{
	return o is *Point;
}

/// Something that has a size.
pub abstract class Sized
{
	abstract fn size(self) -> int;
}

/// A crate, which has a size through its interface.
pub class Crate
{
	pub w: int = 2,
	implements sized: Sized,

	concrete fn Sized::size(self) -> int
	{
		return self.w * 10;
	}

	/// Widen the crate by `by` and give its new width.
	pub fn grow(self, by: int) -> int
	{
		self.w = self.w + by;
		return self.w;
	}
}
