//! A class that a program of another module builds, tests and compares,
//! and a struct that a class of each module holds. The test
//! `shared_class` links it in release mode and in dev mode.

/// A point that this module and the program both build.
pub class Point
{
	pub x: int = 0,
	pub y: int = 0,

	/// Move the point right by `by` and give its new `x`.
	pub fn shift(self, by: int) -> int
	{
		self.x = self.x + by;
		return self.x;
	}
}

/// A point that this module allocates.
pub fn make(x: int) -> *Point
{
	return alloc Point { x: x };
}

/// Whether `o` is a point, tested against the descriptor this module
/// names.
pub fn is_point(o: *Object) -> bool
{
	return o is *Point;
}

/// Something that has a size.
pub abstract class Sized
{
	abstract fn size(self) -> int;
}

/// A crate, which has a size through its interface.
pub class Crate
{
	pub w: int = 2,
	implements sized: Sized,

	concrete fn Sized::size(self) -> int
	{
		return self.w * 10;
	}

	/// Widen the crate by `by` and give its new width.
	pub fn grow(self, by: int) -> int
	{
		self.w = self.w + by;
		return self.w;
	}
}

/// Something drawn.
pub abstract class Drawable
{
	abstract fn draw(self) -> int;
}

/// Something dealt from.
pub abstract class Dealt
{
	abstract fn draw(self, n: int) -> int;
}

/// A deck, which fills `draw` once for each interface.
pub class Deck
{
	pub cards: int = 52,
	implements drawn: Drawable,
	implements dealt: Dealt,

	concrete fn Drawable::draw(self) -> int
	{
		return self.cards;
	}

	concrete fn Dealt::draw(self, n: int) -> int
	{
		self.cards = self.cards - n;
		return self.cards;
	}

	/// The count of cards left.
	pub fn left(self) -> int
	{
		return self.cards;
	}
}

/// An extent that a class of this module and one of the program hold.
/// This module writes its one descriptor.
pub struct Extent
{
	w: int,
	h: int,
}

/// A pallet with the extent it covers.
pub class Pallet
{
	pub extent: Extent = Extent { w: 1, h: 2 },
}
