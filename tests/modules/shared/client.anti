//! Tests a class of module `com.example.points` from another module. The
//! program and the library name one descriptor and one table, so `is`, `==`,
//! `equals`, `reflect.new` and `reflect.call` agree whichever module made the
//! object. `reflect.call` through a pointer to an interface calls the function
//! of the object's class that the index names. A class of each module holds the
//! struct `Extent`, whose one descriptor the library writes, and `serialize`
//! walks it from both. A class of the library with qualified bodies keeps its
//! tables here, and a class of the program inherits them. The one qualified
//! body of `Crate` is reached through its table from here, by a call, a bound
//! function and `points.Crate.size`, and a class here replaces it.

import com.example.points;
import anti.reflect;
import anti.text;

extern fn printf(format: ?*byte, ...) -> c_int;

class Bin
{
	pub extent: points.Extent = points.Extent { w: 0, h: 0 },
}

/* A deck of the program, whose tables start as those of the library's. */
class Shoe inherits points.Deck
{
	pub fn decks(self) -> int
	{
		return self.cards / 52;
	}
}

/* A crate of the program, whose plain body replaces the qualified one
   of the library in the table of Sized. */
class Box inherits points.Crate
{
	concrete fn size(self) -> int
	{
		return self.w;
	}
}

fn main() -> int
{
	let made = points.make(3);
	let local = alloc points.Point { x: 3 };
	let o: *Object = made;
	let same: *Object = made;

	printf("%d %d\n".ptr, (o is *points.Point) as c_int,
		points.is_point(local) as c_int);
	printf("%d %d %d\n".ptr, (o == same) as c_int, (o == local) as c_int,
		made.equals(local) as c_int);
	let built = reflect.new("com.example.points.Point");
	if built == none {
		return 1;
	}
	printf("%d %d\n".ptr, (built is *points.Point) as c_int,
		points.is_point(built) as c_int);
	let by = [reflect.of_int(4)];
	let shifted = reflect.call(made, 16, by[0..1]) catch fatal;
	printf("%d %d\n".ptr, shifted.kind as c_int, shifted.data.i as c_int);

	let crate = alloc points.Crate { w: 3 };
	let sized: *points.Sized = crate;
	let inside: *Object = sized;
	let d = reflect.describe(inside as *byte) else { return 1; };
	let grow = reflect.function(d, 16);
	printf("%s %d\n".ptr, grow.name.ptr, sized.size() as c_int);
	let wider = [reflect.of_int(2)];
	let grown = reflect.call(inside, 16, wider[0..1]) catch fatal;
	printf("%d %d %d\n".ptr, grown.kind as c_int, grown.data.i as c_int,
		sized.size() as c_int);
	let grew = crate.grow(1);
	printf("grew %d\n".ptr, grew as c_int);
	let box = alloc Box { w: 4 };
	let boxed: *points.Crate = box;
	let bound = boxed.size;
	let named = points.Crate.size;
	let from_crate = crate.size();
	let from_box = boxed.size();
	let from_bound = bound();
	let from_named = named(boxed);
	printf("size %d %d %d %d\n".ptr, from_crate as c_int, from_box as c_int,
		from_bound as c_int, from_named as c_int);
	delete(box);
	let deck = alloc points.Deck { };
	let drawn: *points.Drawable = deck;
	let dealt: *points.Dealt = deck;
	let seen = drawn.draw();
	let after = dealt.draw(2);
	let left = deck.left();
	printf("deck %d %d %d\n".ptr, seen as c_int, after as c_int,
		left as c_int);
	let shoe = alloc Shoe { cards: 104 };
	let from: *points.Deck = shoe;
	let shoe_drawn: *points.Drawable = shoe;
	let shoe_dealt: *points.Dealt = shoe;
	let dealt_shoe = shoe_dealt.draw(4);
	let shown = shoe_drawn.draw();
	let shoe_left = from.left();
	let decks = shoe.decks();
	printf("shoe %d %d %d %d\n".ptr, dealt_shoe as c_int, shown as c_int,
		shoe_left as c_int, decks as c_int);
	delete(deck);
	delete(shoe);
	let pallet = alloc points.Pallet { };
	let bin = alloc Bin { extent: points.Extent { w: 5, h: 6 } };
	let b = text.Builder.new();
	pallet.serialize(&b);
	b.append(" ");
	bin.serialize(&b);
	let written = b.text();
	printf("%.*s\n".ptr, written.len as c_int, written.ptr);
	delete(pallet);
	delete(bin);
	delete(crate);
	delete(made);
	delete(local);
	delete(built);
	return 0;
}
