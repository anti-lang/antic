//! Tests a class of module `com.example.points` from another module. The
//! program and the library name one descriptor and one table, so `is`,
//! `==`, `equals`, `reflect.new` and `reflect.call` agree whichever
//! module made the object. `reflect.call` through a pointer to an
//! interface calls the function of the object's class that the index
//! names.

import com.example.points;
import anti.reflect;

extern fn printf(format: *byte, ...) -> c_int;

fn main() -> int
{
	let made = points.make(3);
	let here = alloc points.Point { x: 3 };
	let o: *Object = made;
	let same: *Object = made;

	printf("%d %d\n".ptr, (o is *points.Point) as c_int,
		points.is_point(here) as c_int);
	printf("%d %d %d\n".ptr, (o == same) as c_int, (o == here) as c_int,
		made.equals(here) as c_int);
	let built = reflect.new("com.example.points.Point");
	if built == null {
		return 1;
	}
	printf("%d %d\n".ptr, (built is *points.Point) as c_int,
		points.is_point(built) as c_int);
	let by = [reflect.of_int(4)];
	let shifted = reflect.call(made, 7, by[0..1]);
	printf("%d %d\n".ptr, shifted.kind as c_int, shifted.data.i as c_int);

	let crate = alloc points.Crate { w: 3 };
	let sized: *points.Sized = crate;
	let inside: *Object = sized;
	let d = reflect.describe(inside as *byte);
	let grow = reflect.function(d, 7);
	printf("%s %d\n".ptr, grow.name.ptr, sized.size() as c_int);
	let wider = [reflect.of_int(2)];
	let grown = reflect.call(inside, 7, wider[0..1]);
	printf("%d %d %d\n".ptr, grown.kind as c_int, grown.data.i as c_int,
		sized.size() as c_int);
	delete(crate);
	delete(made);
	delete(here);
	delete(built);
	return 0;
}
