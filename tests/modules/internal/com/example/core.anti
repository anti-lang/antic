//! A module with one public item and one internal item.

/// Public everywhere.
pub fn open() -> int
{
	return 1 + tuning();
}

/// Reaches the modules of this package alone.
internal fn tuning() -> int
{
	return 41;
}

/// A generic that reaches the modules of this package alone, which the library
/// file carries with its declaration.
internal fn bits<T>() -> int
{
	return size_of(T) * 8;
}
