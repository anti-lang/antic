//! Functions whose parameters have default values. The library file carries
//! each default, so a call from another module leaves them out, and `here` is
//! the position of that call.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

/// Greet `name` a number of times, and name the line of the call.
pub fn greet(name: str, times: int = 2, at: lang.SourceLocation = here)
{
	let i = 0;
	while i < times do {
		printf("hello %.*s from %.*s:%d %.*s\n".ptr, name.len as c_int,
			name.ptr, at.file.len as c_int, at.file.ptr, at.line as c_int,
			at.function.len as c_int, at.function.ptr);
		i += 1;
	}
}

/// A total whose step has a default.
pub class Tally
{
	pub total: int = 0,

	/// Add `n`, or one when the call leaves it out.
	pub fn add(self, n: int = 1)
	{
		self.total += n;
	}
}

/// A class whose fields have defaults, and whose `construct` counts.
pub class Pair
{
	pub a: int = 5,
	pub b: int = 6,
	pub made: int = 0,

	fn construct(self)
	{
		self.made += 1;
	}

	/// The sum of both fields.
	pub fn sum(self) -> int
	{
		return self.a + self.b;
	}
}

/// A class whose field defaults to a literal that names one field of `Pair` and
/// leaves the other to its default.
pub class Holder
{
	pub pair: Pair = Pair { a: 1 },
	pub count: int = 9,
}

/// The fields of `p`, which defaults to a literal of a class.
pub fn show(p: Pair = Pair { b: 2 }) {
	printf("pair %d %d %d made %d\n".ptr, p.a as c_int, p.b as c_int,
		p.sum() as c_int, p.made as c_int);
}
