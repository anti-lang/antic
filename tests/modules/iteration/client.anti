//! A program that walks, indexes and collects the collections of another
//! module, and changes the elements of one in place.

import com.example.bag;

extern fn printf(format: ?*byte, ...) -> c_int;

fn main() -> int
{
	let b = bag.Bag { };
	b.add(2);
	b.add(4);
	b.add(6);
	let total = 0;
	for n in b {
		for m in b {
			total = total + n * m;
		}
	}
	printf("total %d\n".ptr, total as c_int);
	b[0] = b[2] + 1;
	printf("first %d\n".ptr, b[0] as c_int);
	let all = b.iter().to_slice();
	printf("all %d %d\n".ptr, all.len as c_int, all[0] as c_int);
	free(all.ptr);
	let s = bag.Shelf { };
	s.add(1);
	s.add(2);
	for x in &s {
		*x = *x * 10;
	}
	let kept = 0;
	for x in s {
		kept += x;
	}
	printf("shelf %d\n".ptr, kept as c_int);
	return 0;
}
