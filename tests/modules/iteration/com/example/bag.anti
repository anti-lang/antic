//! Two public collections with the language hooks and their iterators. Another
//! module walks, indexes and collects them through the library file alone.
//! `Shelf` lends its elements and counts its changes, and its iterator keeps
//! the `Watch` of them.

import anti.lang;

pub class Bag
{
	pub items: [4]int = [0; 4],
	pub count: int = 0,

	pub fn add(self, n: int)
	{
		self.items[self.count] = n;
		self.count = self.count + 1;
	}

	operator fn iter(self) -> BagIter
	{
		return BagIter { bag: self, at: -1 };
	}

	operator fn index(self, i: int) -> int
	{
		return self.items[i];
	}

	operator fn set_index(self, i: int, v: int)
	{
		self.items[i] = v;
	}
}

pub class BagIter
{
	pub bag: *Bag,
	pub at: int,

	operator fn next(self) -> bool
	{
		self.at = self.at + 1;
		return self.at < self.bag.count;
	}

	operator fn value(self) -> int
	{
		return self.bag.items[self.at];
	}
}

/// A collection that lends its elements through its iterator.
pub class Shelf
{
	pub items: [4]int = [0; 4],
	pub count: int = 0,
	changes: lang.Changes = lang.Changes {
		count: 0,
		at: lang.SourceLocation {
			file: "", line: 0, column: 0, function: "",
			module: ""
		},
	},

	pub fn add(self, n: int, at: lang.SourceLocation = here)
	{
		self.items[self.count] = n;
		self.count = self.count + 1;
		self.changes.count += 1;
		self.changes.at = at;
	}

	operator fn iter(self) -> ShelfIter
	{
		return ShelfIter {
			shelf: self,
			at: -1,
			watch: lang.Watch {
				changes: &self.changes,
				count: self.changes.count
			},
		};
	}
}

pub class ShelfIter
{
	pub shelf: *Shelf,
	pub at: int,
	pub watch: lang.Watch,

	operator fn next(self) -> bool
	{
		self.at = self.at + 1;
		return self.at < self.shelf.count;
	}

	operator fn value(self) -> lent *int
	{
		return &self.shelf.items[self.at];
	}
}
