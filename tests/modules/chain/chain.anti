//! A class whose base is `dog.Dog`, whose base is `animal.Animal`: a
//! chain over three modules. Dispatch, `super`, `is`, the fields,
//! `construct` and `destruct` follow the chain across the modules. `Cat`
//! calls the `construct` of its base in another module with an argument,
//! through `self.super`, and passes its error on.

import anti.lang;
import com.example.animal;
import com.example.dog;

extern fn printf(format: ?*byte, ...) -> c_int;

class Puppy inherits dog.Dog
{
	pub age: int = 0,

	fn construct(self)
	{
		printf("puppy %d\n".ptr, self.tail as c_int);
	}

	concrete fn sound(self) -> int
	{
		return 100 + self.super.sound();
	}
}

class Cat inherits animal.Pet
{
	pub lives: int = 9,

	fn construct(self, owner: int) may fail
	{
		try self.super.construct(owner * 2);
		printf("cat %d %d\n".ptr, self.owner as c_int, self.lives as c_int);
	}
}

fn scope()
{
	let v = dog.Dog { tail: 5 };
	printf("scope %d\n".ptr, v.tail as c_int);
}

fn main() -> int
{
	scope();
	let p = alloc Puppy { tail: 3, age: 1 };
	let a: *animal.Animal = p;
	let d: *dog.Dog = dog.make();
	let b: *animal.Animal = d;

	printf("%d %d %d\n".ptr, a.sound() as c_int, b.sound() as c_int,
		a.count() as c_int);
	printf("%d %d %d %d\n".ptr, (a is *Puppy) as c_int,
		(a is *dog.Dog) as c_int, (b is *Puppy) as c_int,
		(b is *animal.Animal) as c_int);
	printf("%d %d %d\n".ptr, p.legs as c_int, p.tail as c_int,
		p.age as c_int);
	delete(p);
	delete(d);

	let cat = alloc Cat(4) catch fatal;
	let pet: *animal.Pet = cat;
	printf("%d %d\n".ptr, pet.owner as c_int, (pet is *Cat) as c_int);
	delete(cat);
	let stray: ?*Cat = alloc Cat(-1) catch e {
		printf("stray %d\n".ptr, e.code as c_int);
		yield none;
	};
	if stray != none {
		return 1;
	}
	return 0;
}
