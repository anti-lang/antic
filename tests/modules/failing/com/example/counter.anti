//! A library whose functions are written `may fail`. The library file
//! records the flag, so the program that imports it handles the error
//! without seeing this source. It records a function type with its
//! `may fail` and its `?` as well.

import anti.lang;

/// Halve n, or fail when n is odd.
pub fn half(n: int) -> int may fail
{
	if n % 2 != 0 { fail "n is odd"; }
	return n / 2;
}

/// f of n, twice, and the first failure forwarded. The type of f carries
/// `may fail` over the module boundary.
pub fn twice_by(f: fn(int) -> int may fail, n: int) -> int may fail
{
	let once = try f(n);
	return try f(once);
}

/// f of n, or n when there is no f.
pub fn apply_or(f: ?fn(int) -> int, n: int) -> int
{
	let g = f else {
		return n;
	};
	return g(n);
}

/// A counter with a limit.
pub class Counter
{
	pub n: int = 0,
	pub limit: int = 2,

	/// Add one, or fail at the limit.
	pub fn step(self) may fail
	{
		if self.n >= self.limit {
			fail lang.Error.new(5, "the counter is at its limit");
		}
		self.n += 1;
	}

	/// Add one twice, forwarding the first failure.
	pub fn twice(self) may fail
	{
		try self.step();
		try self.step();
	}
}
