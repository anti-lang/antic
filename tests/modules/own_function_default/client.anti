//! The client of the held library. It builds the class of the library and a
//! class below it, which take the default `none` of the `own ?fn` field from
//! the library file, and deletes both, which frees what the field holds.

import com.example.held;

extern fn printf(format: ?*byte, ...) -> c_int;

class Derived inherits held.Base
{
	pub extra: int = 3,
}

fn main() -> int
{
	let d = alloc Derived { };
	printf("derived %d %d\n".ptr, d.extra as c_int, (d.maybe == none) as c_int);
	delete(d);
	let b = alloc held.Base { code: 5 };
	printf("base %d %d\n".ptr, b.code as c_int, (b.maybe == none) as c_int);
	b.maybe = held.twice;
	printf("set %d\n".ptr, (b.maybe == none) as c_int);
	delete(b);
	return 0;
}
