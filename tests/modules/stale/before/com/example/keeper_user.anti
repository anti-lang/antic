//! A user of the first version of `counter` whose class inherits `Shrinker` and
//! replaces `gone`, which the later file of `counter` lacks.

import com.example.counter;

/// A shrinker that counts by eight.
pub class Keeper inherits counter.Shrinker
{
	concrete fn gone(self) -> int
	{
		return self.v + 8;
	}
}

/// A new keeper.
pub fn make() -> *Keeper
{
	return alloc Keeper { };
}
