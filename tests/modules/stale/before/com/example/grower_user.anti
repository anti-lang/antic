//! A user of the first version of `counter` whose class inherits `Grower`,
//! whose later file adds a function at the end of its table.

import com.example.counter;

/// A grower that counts from three.
pub class Bigger inherits counter.Grower
{
	concrete fn get(self) -> int
	{
		return self.v + 3;
	}
}

/// A new bigger grower.
pub fn make() -> *Bigger
{
	return alloc Bigger { };
}
