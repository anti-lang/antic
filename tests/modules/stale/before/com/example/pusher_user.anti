//! A user of the first version of `counter` whose class inherits `Mover`, so
//! this file writes a table laid out against the first table of `Mover`.

import com.example.counter;

/// A mover that counts by seven.
pub class Pusher inherits counter.Mover
{
	concrete fn bump(self) -> int
	{
		return self.v + 7;
	}
}

/// A new pusher.
pub fn make() -> *Pusher
{
	return alloc Pusher { };
}
