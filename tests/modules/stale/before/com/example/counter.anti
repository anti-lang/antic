//! The first version of a library, whose later file in after/ lacks the
//! functions the users of this tree call.

/// A count that a user reads through its functions.
pub class Counter
{
	pub v: int = 0,

	/// The next count, called through the table of the class.
	pub fn bump(self) -> int
	{
		return self.v + 1;
	}

	/// The next count, called by its name.
	pub final fn step(self) -> int
	{
		return self.v + 2;
	}

	/// A count without an object.
	pub fn start() -> int
	{
		return 4;
	}
}

/// The count after n.
pub fn next(n: int) -> int
{
	return n + 1;
}

/// A count whose function stands at another slot in the later file.
pub class Mover
{
	pub v: int = 0,

	/// The next count, called through the table of the class.
	pub fn bump(self) -> int
	{
		return self.v + 1;
	}
}

/// An interface whose function stands at another slot in the later file.
pub abstract class Source
{
	/// The count of the source.
	pub abstract fn get(self) -> int;
}

/// A class that fills the table of `Source` as a sub-object.
pub class Holder
{
	implements s: Source,

	/// The count, reached through the table of `Source`.
	concrete fn Source::get(self) -> int
	{
		return 5;
	}
}

/// A class that the later file lacks.
pub class Gone
{
	pub v: int = 0,

	/// The next count, called through the table of the class.
	pub fn bump(self) -> int
	{
		return self.v + 1;
	}
}

/// A class whose later file adds a function at the end of its table.
pub class Grower
{
	pub v: int = 0,

	/// The count, called through the table of the class.
	pub fn get(self) -> int
	{
		return self.v;
	}
}

/// A class whose later file lacks `gone`, which moves `get` to slot 17.
pub class Shrinker
{
	pub v: int = 0,

	/// A count that the later file lacks.
	pub fn gone(self) -> int
	{
		return self.v + 9;
	}

	/// The count, called through the table of the class.
	pub fn get(self) -> int
	{
		return self.v;
	}
}
/// A generic class whose later file adds a function before `get`, which moves
/// it to the next slot of the table of every copy.
pub class Bag<T>
{
	pub v: T,

	/// The count, called through the table of a copy.
	pub fn get(self) -> int
	{
		return 1;
	}
}

/// A generic class whose later file lacks `fin`.
pub class Tin<T>
{
	pub v: T,

	/// The count, called by its name.
	pub final fn fin(self) -> int
	{
		return 4;
	}
}

/// A generic function that the later file lacks.
pub fn pick<T>(n: int) -> int
{
	return n;
}
