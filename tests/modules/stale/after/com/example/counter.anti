//! The later version of the library of before/, without the functions that the
//! users built against the first version call.

/// A count without its functions.
pub class Counter
{
	pub v: int = 0,
}

/// The count two after n.
pub fn other(n: int) -> int
{
	return n + 2;
}

/// A count with a function before `bump`, which moves it to the next slot.
pub class Mover
{
	pub v: int = 0,

	/// The count itself.
	pub fn first(self) -> int
	{
		return self.v;
	}

	/// The next count.
	pub fn bump(self) -> int
	{
		return self.v + 1;
	}
}

/// An interface with a function before `get`, which moves it to the next slot.
pub abstract class Source
{
	/// The first count of the source.
	pub abstract fn first(self) -> int;

	/// The count of the source.
	pub abstract fn get(self) -> int;
}

/// A class that fills the table of `Source` as a sub-object.
pub class Holder
{
	implements s: Source,

	/// The first count.
	concrete fn Source::first(self) -> int
	{
		return 4;
	}

	/// The count.
	concrete fn Source::get(self) -> int
	{
		return 5;
	}
}

/// A class with a function after `get`, at the end of its table.
pub class Grower
{
	pub v: int = 0,

	/// The count.
	pub fn get(self) -> int
	{
		return self.v;
	}

	/// The count after the next.
	pub fn more(self) -> int
	{
		return self.v + 2;
	}
}

/// A class without `gone`, which moves `get` to slot 17.
pub class Shrinker
{
	pub v: int = 0,

	/// The count.
	pub fn get(self) -> int
	{
		return self.v;
	}
}
/// A generic class with a function before `get`, which moves it to the next
/// slot of the table of every copy.
pub class Bag<T>
{
	pub v: T,

	/// The first count.
	pub fn first(self) -> int
	{
		return 9;
	}

	/// The count.
	pub fn get(self) -> int
	{
		return 2;
	}
}

/// A generic class without `fin`.
pub class Tin<T>
{
	pub v: T,
}
