//! The binding of forms, which `anti bind` wrote from `forms.h`. Nothing in it
//! is written by hand. Run `anti bind` again to change it.

pub const FORMS_FIRST: c_int = 0;

pub const FORMS_SECOND: c_int = 5;

pub const FORMS_MODE: FormsMode = FormsMode.FORMS_MODE_B;

pub const FORMS_SECOND_AGAIN: c_int = 5;

pub const FORMS_PAIR: FormsPair = FormsPair { x: 1.5, y: 2.0 };

pub const FORMS_COUNT: FormsCount = FormsCount { n: 5, flag: 1 };

pub const FORMS_TRAILING: FormsCount = FormsCount { n: 4, flag: 5 };

pub const FORMS_BARE_PAIR: FormsPair = FormsPair { x: 3.5, y: 4.0 };

pub const FORMS_SPACED_PAIR: FormsPair = FormsPair { x: 5.5, y: 6.0 };

pub enum FormsMode
{
	FORMS_MODE_A = 0,
	FORMS_MODE_B = 1,
}

pub enum FormsZero
{
	FORMS_ZERO = 0,
}

pub struct FormsOuter
{
	inner: FormsInner,
	plain: FormsOuter_plain,
	either: FormsOuter_either,
}

pub struct FormsInner
{
	a: c_int,
}

pub struct FormsOuter_plain
{
	b: c_int,
}

pub union FormsOuter_either
{
	c: c_int,
	d: c_float,
}

pub struct FormsPair
{
	x: c_float,
	y: c_float,
}

pub struct FormsCount
{
	n: c_int,
	flag: c_uchar,
}

pub packed struct FormsTight
{
	c: c_char,
	i: c_int,
}

pub struct FormsLoose
{
	c: c_char,
	i: c_int,
}

pub struct FormsKept
{
	c: c_char,
	i: c_int,
}

pub union FormsEither
{
	i: c_int,
	f: c_float,
}

pub struct FormsBlank
{
	z: FormsZero,
}

pub struct FormsTwice
{
	first: FormsBlank,
	second: FormsBlank,
	n: c_int,
}

pub struct FormsHolder
{
	twice: FormsTwice,
}

pub extern fn forms_take(m: FormsMode, o: ?*FormsOuter, p: FormsPair) -> c_int;

pub extern fn forms_either(e: FormsEither) -> c_int;
