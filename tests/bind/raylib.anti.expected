//! The binding of raylib, which `anti bind` wrote from `raylib_api.json`.
//! Nothing in it is written by hand. Run `anti bind` again to change it.

link framework "Cocoa";
link framework "CoreVideo";
link framework "IOKit";
link framework "OpenGL";
link linux "GL";
link linux "m";
link linux "pthread";
link linux "dl";
link linux "rt";
link linux "X11";

pub const RAYLIB_VERSION_MAJOR: c_int = 6;

pub const RAYLIB_VERSION: str = "6.0";

pub const PI: c_float = 3.14159274;

pub const DEG2RAD: c_float = 0.0174532924;

/// Light Gray
pub const LIGHTGRAY: Color = Color { r: 200, g: 200, b: 200, a: 255 };

/// My own White (raylib logo)
pub const RAYWHITE: Color = Color { r: 245, g: 245, b: 245, a: 255 };

pub const MOUSE_LEFT_BUTTON: MouseButton = MouseButton.MOUSE_BUTTON_LEFT;

/// Mouse buttons
pub enum MouseButton
{
	/// Mouse button left
	MOUSE_BUTTON_LEFT = 0,
	/// Mouse button right
	MOUSE_BUTTON_RIGHT = 1,
	/// Mouse button middle (pressed wheel)
	MOUSE_BUTTON_MIDDLE = 2,
	/// Mouse button side (advanced mouse device)
	MOUSE_BUTTON_SIDE = 3,
}

/// System/Window config flags
pub enum ConfigFlags
{
	/// Set to try enabling V-Sync on GPU
	FLAG_VSYNC_HINT = 64,
	/// Set to run program in fullscreen
	FLAG_FULLSCREEN_MODE = 2,
	/// Set to allow resizable window
	FLAG_WINDOW_RESIZABLE = 4,
	/// Set to disable window decoration (frame and buttons)
	FLAG_WINDOW_UNDECORATED = 8,
}

/// Vector2, 2 components
pub struct Vector2
{
	x: c_float,
	y: c_float,
}

/// Vector3, 3 components
pub struct Vector3
{
	x: c_float,
	y: c_float,
	z: c_float,
}

/// Vector4, 4 components
pub struct Vector4
{
	x: c_float,
	y: c_float,
	z: c_float,
	w: c_float,
}

/// Color, 4 components, R8G8B8A8 (32bit)
pub struct Color
{
	r: c_uchar,
	g: c_uchar,
	b: c_uchar,
	a: c_uchar,
}

/// Rectangle, 4 components
pub struct Rectangle
{
	x: c_float,
	y: c_float,
	width: c_float,
	height: c_float,
}

/// Image, pixel data stored in CPU memory (RAM)
pub struct Image
{
	data: ?*byte,
	width: c_int,
	height: c_int,
	mipmaps: c_int,
	format: c_int,
}

/// Texture, tex data stored in GPU memory (VRAM)
pub struct Texture
{
	id: c_uint,
	width: c_int,
	height: c_int,
	mipmaps: c_int,
	format: c_int,
}

/// Transform, vertex transformation data
pub struct Transform
{
	translation: Vector3,
	rotation: Vector4,
	scale: Vector3,
}

/// ModelAnimation, contains a full animation sequence
pub struct ModelAnimation
{
	name: [32]c_char,
	boneCount: c_int,
	keyframeCount: c_int,
	keyframePoses: ?*?*Transform,
}

/// Initialize window and OpenGL context
pub extern fn InitWindow(width: c_int, height: c_int, title: ?*byte);

/// Show trace log messages (LOG_DEBUG, LOG_INFO, LOG_WARNING, LOG_ERROR...)
pub extern fn TraceLog(logLevel: c_int, text: ?*byte, ...);

/// Set custom trace log
pub extern fn SetTraceLogCallback(callback: ?fn(c_int, ?*byte, ?*byte));

/// Load file data as byte array (read)
pub extern fn LoadFileData(fileName: ?*byte, dataSize: ?*c_int) -> ?*c_uchar;

/// Draw a Texture2D
pub extern fn DrawTexture(texture: Texture, posX: c_int, posY: c_int, tint: Color);

/// Text formatting with variables (sprintf() style)
pub extern fn TextFormat(text: ?*byte, ...) -> ?*byte;

/// Check if a mouse button has been pressed once
pub extern fn IsMouseButtonPressed(button: c_int) -> bool;
