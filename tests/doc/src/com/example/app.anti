//! The program that draws with `com.example.shapes`.

import com.example.shapes;

/// Draw one circle of `radius` and give the area of it.
pub fn draw(radius: int) -> int
{
	let c = shapes.Circle { radius: radius, stroke: shapes.Stroke.Solid };
	return shapes.area(c);
}

/// The shelf the program keeps two radii on.
pub type Pair = shapes.Shelf<int, 2>;
