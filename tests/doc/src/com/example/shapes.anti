//! Shapes of the plane and what they measure.
//!
//! Every length is a whole number of `UNIT`, so a measurement never carries a
//! fraction. The module holds:
//!
//! - `Circle`, the one shape with a body
//! - `Figure`, the variant a drawing stores
//!
//! ```anti
//! let c = shapes.Circle { radius: 2, stroke: shapes.Stroke.Solid };
//! let a = shapes.area(c);
//! ```
//!
//! The rules of the plane stand in [the handbook](https://example.com/plane).

//#! The module is one file. `helper` and `Canvas.secret` are the two items no
//#! reader of the library sees.

import anti.lang;

/// How an outline is drawn.
pub enum Stroke: byte
{
	/// A line with no gaps.
	Solid,
	/// A line with gaps.
	Dashed,
}

/// The unit every length is written in.
pub const UNIT: int = 1;

/// A circle, named by its radius.
pub struct Circle
{
	/// The radius, in whole units of `UNIT`.
	radius: int,
	/// How the outline is drawn.
	stroke: Stroke,
}

/// Either of the two figures a drawing stores.
pub variant Figure
{
	Round { radius: int },
	Empty,
}

/// A drawing that counts the shapes put on it.
pub class Canvas
{
	/// The name of the drawing.
	pub name: str,
	/// How many shapes stand on it.
	protected count: int = 0,
	private_note: int = 0,

	/// A canvas with a name.
	pub fn new(name: str) -> *Canvas
	{
		return alloc Canvas { name: name };
	}

	/// Put `shape` on the canvas.
	pub fn add(self, shape: Circle)
	{
		self.count = self.count + shape.radius - shape.radius + 1;
	}

	/// How many shapes stand on the canvas.
	pub fn size(self) -> int
	{
		return self.count;
	}

	fn secret(self) -> int
	{
		return self.private_note;
	}
}

//# The area is four times the radius, which is close enough for the test and
//# wrong everywhere else.
/// The area of `c`, rounded down.
pub fn area(c: Circle) -> int
{
	return c.radius * 4;
}

/// The width and the height of `c`.
pub fn bounds(c: Circle) -> (int, int)
{
	return (c.radius * 2, c.radius * 2);
}

/// Give `each` every circle of `list`, add up what `weigh` says of them and
/// keep `done` for later.
pub fn visit(list: []Circle, each: fn(Circle), concurrent weigh: fn(Circle) -> int,
	keep done: fn(int)) -> int
{
	let total = 0;
	for c in list {
		each(c);
		total += weigh(c);
	}
	return total;
}

/// The radius `text` names, or a failure when it names none.
pub fn parse(text: str) -> int may fail
{
	if text.len == 0 {
		fail "no radius";
	}
	return text.len;
}

/// Measure `c` on a worker.
pub worker fn measure(c: Circle) -> int
{
	return area(c);
}

/// The count every canvas starts at, which the package alone sees.
internal const START: int = 0;

fn helper(n: int) -> int
{
	return n + 1;
}

/// Circles that threads add to under the lock of the object.
pub synchronized class Tray
{
	count: int = 0,

	/// Add one circle.
	pub fn add(self, c: Circle)
	{
		self.count += 1;
	}
}

/// Measurements that compare, which `Shelf` sorts by.
pub constraint Ordered = eq + lt;

/// The larger of two measurements.
pub fn larger<T: lt>(a: T, b: T) -> T
{
	if a < b {
		return b;
	}
	return a;
}

/// A shelf of up to `N` measurements.
pub class Shelf<T: Ordered, N: int>
{
	/// The measurements, oldest first.
	pub items: [N]T,
	/// How many stand on the shelf.
	pub count: int = 0,

	/// The first measurement.
	pub fn first(self) -> T
	{
		return self.items[0];
	}
}

/// A shelf of four radii.
pub type Radii = Shelf<int, 4>;
