//! An index past the end of an array. A build with the checks prints the
//! file, the line, the operation and the values, then aborts. A build
//! without them reads the memory and exits with 7.

fn opaque(n: int) -> int
{
	return n;
}

fn sink(n: int)
{
}

fn main() -> int
{
	let a = [1, 2, 3, 4];
	sink(a[opaque(5)]);
	return 7;
}
