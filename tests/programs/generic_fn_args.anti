//! Function types, closures and snapshots appear as type arguments. A type
//! argument of function type is one C function pointer, as at a field, so a
//! named function and an anonymous one that captures nothing fill it, and `?fn`
//! holds `none` as well. A failing function type is an argument of its own. A
//! generic class keeps a snapshot in an `own fn` field of its parameter, and a
//! generic worker takes a `concurrent` closure over its parameter from every
//! chunk.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

class Holder<T>
{
	pub item: T,
}

class Table<T>
{
	items: [4]T,
	pub count: int = 0,

	fn construct(self, fill: T)
	{
		self.items = [fill; 4];
	}

	pub fn push(self, v: T)
	{
		self.items[self.count] = v;
		self.count += 1;
	}

	pub fn get(self, i: int) -> T
	{
		return self.items[i];
	}
}

class Slot<T>
{
	own f: fn(T) -> T,

	fn construct(self, keep own f: fn(T) -> T)
	{
		self.f = f;
	}

	pub fn run(self, v: T) -> T
	{
		return self.f(v);
	}
}

worker fn scaled<T: mul>(chunk: []T, concurrent f: fn(T) -> T) -> T
{
	let last = chunk[0];
	for x in chunk {
		last = f(x);
	}
	return last;
}

fn twice(n: int) -> int
{
	return n * 2;
}

fn inc(n: int) -> int
{
	return n + 1;
}

fn checked(n: int) -> int may fail
{
	if n < 0 {
		fail "negative";
	}
	return n;
}

fn main() -> int
{
	let h = Holder<fn(int) -> int> { item: twice };
	let anon = Holder<fn(int) -> int> {
		item: fn(x: int) -> int { return x * x; }
	};
	printf("%d %d\n".ptr, h.item(21) as c_int, anon.item(5) as c_int);

	let t = alloc Table<fn(int) -> int>(inc);
	t.push(twice);
	t.push(inc);
	t.push(fn(x: int) -> int { return -x; });
	let v = 3;
	for i in 0..t.count {
		v = t.get(i)(v);
	}
	printf("%d %d\n".ptr, t.count as c_int, v as c_int);
	free(t);

	let maybe = Holder<?fn(int) -> int> { item: none };
	let set = Holder<?fn(int) -> int> { item: inc };
	printf("%d %d\n".ptr, (maybe.item == none) as c_int,
		(set.item ?? twice)(1) as c_int);

	let failing = Holder<fn(int) -> int may fail> { item: checked };
	let ok = failing.item(4) catch fatal;
	let bad = failing.item(-4) catch e {
		yield -1;
	};
	printf("%d %d\n".ptr, ok as c_int, bad as c_int);

	let k = 10;
	let slot = alloc Slot<int>(snapshot fn(x: int) -> int { return x + k; });
	k = 20;
	printf("%d\n".ptr, slot.run(5) as c_int);
	delete(slot);

	let factor = 3;
	let values: [4]int = [1, 2, 3, 4];
	let parts = parallel values[0..4] by 2 -> scaled(fn(x) { return x * factor; });
	printf("%d %d\n".ptr, parts[0] as c_int, parts[1] as c_int);
	free(parts.ptr);
	return 0;
}
