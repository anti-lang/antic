//! A function of a class may take type parameters of its own. Each class and
//! each argument of its own makes a copy, `Box<int>.map<float>`, that every
//! call names directly. No table holds such a function, so the tables of the
//! classes are those of the functions without, and a replaced function of a
//! base still dispatches through them. The program calls one on a generic class
//! and on a class that is not generic, from outside the class and from inside
//! it, with its arguments written and inferred. A function of a synchronized
//! class takes the hidden lock as any public one does.

extern fn printf(format: ?*byte, ...) -> c_int;

class Box<T>
{
	pub value: T,

	pub fn map<U>(self, f: fn(T) -> U) -> Box<U>
	{
		return Box<U> { value: f(self.value) };
	}

	pub fn pair<U>(self, other: U) -> Pair<T, U>
	{
		return Pair<T, U> { first: self.value, second: other };
	}

	/// Calls a function of its own class with type parameters of its own.
	pub fn doubled<U: add>(self, u: U) -> Pair<T, U>
	{
		return self.pair(u + u);
	}
}

struct Pair<A, B>
{
	first: A,
	second: B,
}

class Counter
{
	pub n: int,

	pub fn twice<U>(self, u: U) -> Pair<U, U>
	{
		self.n += 1;
		return Pair<U, U> { first: u, second: u };
	}

	pub fn largest<U: lt>(self, a: U, b: U) -> U
	{
		self.n += 1;
		if a < b {
			return b;
		}
		return a;
	}
}

class Shape
{
	pub fn area(self) -> int
	{
		return 0;
	}

	pub fn scaled<U: mul>(self, factor: U, at: U) -> U
	{
		return factor * at;
	}
}

class Square inherits Shape
{
	pub side: int,

	concrete fn area(self) -> int
	{
		return self.side * self.side;
	}
}

synchronized class Store
{
	total: int = 0,

	pub fn put<U>(self, value: U, weight: int) -> U
	{
		self.total += weight;
		return value;
	}

	pub fn sum(self) -> int
	{
		return self.total;
	}
}

fn area_of(s: *Shape) -> int
{
	return s.area();
}

fn main() -> int
{
	let b = Box<int> { value: 4 };
	let halves = b.map(fn(x: int) -> float { return x as float * 1.5; });
	let text = b.map<str>(fn(x: int) -> str { return "four"; });
	printf("%d %.*s\n".ptr, (halves.value * 2.0) as c_int,
		text.value.len as c_int, text.value.ptr);
	let p = b.pair(2.5);
	let d = halves.doubled(3);
	printf("%d %d %d %d\n".ptr, p.first as c_int, (p.second * 2.0) as c_int,
		(d.first * 2.0) as c_int, d.second as c_int);

	let c = Counter { n: 0 };
	let t = c.twice(7);
	let s = c.twice<str>("ab");
	printf("%d %d %.*s %d\n".ptr, t.first as c_int, t.second as c_int,
		s.first.len as c_int, s.first.ptr, c.largest(3, 9) as c_int);
	printf("%d %d\n".ptr, (c.largest(2.5, 1.5) * 2.0) as c_int, c.n as c_int);

	let sq = Square { side: 5 };
	printf("%d %d %d\n".ptr, area_of(&sq) as c_int, sq.scaled(3, 4) as c_int,
		(sq.scaled(0.5, 3.0) * 2.0) as c_int);

	let store = alloc Store { };
	let kept = store.put(11, 2);
	let named = store.put("x", 3);
	printf("%d %.*s %d\n".ptr, kept as c_int, named.len as c_int, named.ptr,
		store.sum() as c_int);
	free(store);
	return 0;
}
