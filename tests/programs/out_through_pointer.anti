//! `*into = try f();` stores the result of a failing call through a
//! pointer. The out pointer the compiler supplies for that call is the
//! pointer's target, read once before the call. The callee therefore
//! writes where the program asked. Binding the result to a local first
//! is the same program and was the only form that ran.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

fn inner(n: int) -> int may fail
{
	if n < 0 {
		fail "n is negative";
	}
	return n;
}

fn outer(into: *int) may fail
{
	*into = try inner(42);
}

fn main() -> int
{
	let n = 0;
	outer(&n) catch fatal;
	printf("n %d\n".ptr, n as c_int);
	if n != 42 {
		return 1;
	}
	return 0;
}
