//! A channel when the system refuses a call. The channel takes its ring and a
//! monitor of a mutex and two conditions, and memory that runs out for either
//! or a mutex the system refuses stops the program. A case of
//! `faults_channels.faults` refuses one call, through the variable `ANTI_FAULT`
//! of `src/rt/fault.h`.

extern fn printf(format: ?*byte, ...) -> c_int;

fn main() -> int
{
	printf("start\n".ptr);
	let c = chan int(4);
	send(c, 1);
	send(c, 2);
	close(c);
	let sum = 0;
	while true do {
		let v = recv(c) else {
			break;
		};
		sum += *v;
	}
	printf("sum %d\n".ptr, sum as c_int);
	delete(c);
	return 0;
}
