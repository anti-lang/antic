//! A struct or a tuple with a part that owns something follows the value rules
//! of a class value. It is torn down part by part at the end of its block, it
//! moves when returned or passed to an `own` parameter, and it is torn down
//! with its owner as a field of a class or of another struct, as an element of
//! an array and inside a `?T`. `dup` copies it. Each case runs under a leak
//! check, the count of the leaves alive. A struct or a tuple that owns nothing
//! stays plain data that `=` copies.

extern fn printf(format: ?*byte, ...) -> c_int;

class Leaf
{
	pub n: int = 0,

	static atomic live: int = 0;

	fn destruct(self)
	{
		Leaf.live.sub(1);
	}
}

/// A key that owns a leaf.
class Key
{
	pub n: int = 0,
	pub own leaf: ?*Leaf = none,
}

struct Pair
{
	k: Key,
	n: int,
}

struct Outer
{
	p: Pair,
	t: (Key, int),
}

struct Plain
{
	a: int,
	b: int,
}

class Holder
{
	pub p: Pair,
	pub t: (Key, int),
}

fn key(n: int) -> Key
{
	Leaf.live.add(1);
	return Key { n: n, leaf: alloc Leaf { n: n } };
}

fn make_pair(n: int) -> Pair
{
	return Pair { k: key(n), n: n };
}

fn make_tuple(n: int) -> (Key, int)
{
	return (key(n), n);
}

fn take_pair(own p: Pair) -> int
{
	return p.n;
}

fn take_tuple(own t: (Key, int)) -> int
{
	return t.1;
}

fn kept_pair(n: int) -> Pair
{
	let p = make_pair(n);
	let other = make_pair(n + 1);
	return p;
}

fn early(n: int) -> int
{
	let t = make_tuple(n);
	if n > 0 {
		return t.1;
	}
	return 0;
}

/// A copy of the value at `p`, whatever `T` is.
fn copy_of<T>(p: *T) -> T
{
	return dup(*p);
}

/// Tear down the value at `p` in place.
fn clear<T>(p: *T)
{
	destroy(p);
}

fn check(name: str)
{
	printf("%.*s %d\n".ptr, name.len as c_int, name.ptr,
		Leaf.live.load() as c_int);
}

fn main() -> int
{
	{
		let p = Pair { k: key(1), n: 1 };
	}
	check("struct let");
	{
		let t = (key(1), 1);
	}
	check("tuple let");
	{
		let p = kept_pair(2);
		printf("struct returned %d\n".ptr, p.k.n as c_int);
	}
	check("struct returned");
	{
		let t = make_tuple(2);
		printf("tuple early %d\n".ptr, early(3) as c_int);
	}
	check("tuple returned");
	{
		let p = make_pair(3);
		printf("struct own %d\n".ptr, take_pair(p) as c_int);
	}
	check("struct own");
	{
		let t = make_tuple(3);
		printf("tuple own %d\n".ptr, take_tuple(t) as c_int);
	}
	check("tuple own");
	{
		let h = Holder { p: make_pair(4), t: make_tuple(4) };
		let heap = alloc Holder { p: make_pair(4), t: make_tuple(4) };
		delete(heap);
	}
	check("class field");
	{
		let o = Outer { p: make_pair(5), t: make_tuple(5) };
		let both = (make_pair(5), make_tuple(5));
	}
	check("struct field");
	{
		let ps: [2]Pair = [make_pair(6), make_pair(7)];
		let ts: [2](Key, int) = [make_tuple(6), make_tuple(7)];
	}
	check("array");
	{
		let maybe: ?Pair = make_pair(8);
		let none_yet: ?(Key, int) = none;
	}
	check("optional");
	{
		let p = make_pair(9);
		let q = dup(p);
		let t = make_tuple(9);
		let u = dup(t);
		/* Each `dup` copies one leaf, which no constructor counts. */
		Leaf.live.add(2);
		printf("dup %d %d\n".ptr, (q.k.leaf != p.k.leaf) as c_int,
			(u.0.leaf != t.0.leaf) as c_int);
		check("dup alive");
	}
	check("dup");
	{
		let p = make_pair(10);
		p = make_pair(11);
		let t = make_tuple(10);
		t = make_tuple(11);
		printf("replaced %d %d\n".ptr, p.n as c_int, t.1 as c_int);
	}
	check("replaced");
	for i in 0..3 {
		let p = make_pair(i);
		if i == 1 {
			break;
		}
	}
	check("break");
	{
		let room = alloc(Pair, 2) else {
			return 1;
		};
		room[0] = make_pair(12);
		room[1] = make_pair(13);
		destroy(&room[0]);
		clear(&room[1]);
		free(room);
	}
	check("destroy");
	{
		let p = make_pair(14);
		let q = copy_of(&p);
		/* The leaf the copy makes, and the one `alloc` makes below. */
		Leaf.live.add(2);
		let leaf = alloc Leaf { };
		let same = copy_of(&leaf);
		printf("generic dup %d %d\n".ptr, (q.k.leaf != p.k.leaf) as c_int,
			(same == leaf) as c_int);
		delete(leaf);
	}
	check("generic dup");

	let a = Plain { a: 1, b: 2 };
	let b = Plain { a: 0, b: 0 };
	b = a;
	let x = (1, 2);
	let y = (0, 0);
	y = x;
	printf("plain %d %d\n".ptr, b.b as c_int, y.1 as c_int);
	return 0;
}
