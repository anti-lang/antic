//! Every place a failing call writes its result into, beside the `*p` of
//! out_through_pointer.anti. A local the back end keeps in a temporary, a
//! bitfield and a compound assignment have no address to give the call, so it
//! writes a slot of its own and the value moves from there into the place.
//!
//! Each place carries both forms. `try` hands the error to the caller, and a
//! `catch` handler takes it here, where `yield` puts a value of its own in the
//! place.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

struct Flags
{
	layer: u32 : 4,
	pad: u32 : 28,
}

struct Pair
{
	left: int,
	right: int,
}

fn value(n: int) -> int may fail
{
	if n < 0 {
		fail lang.Error.new(1, "n is negative");
	}
	return n;
}

fn small(layer: u32) -> u32 may fail
{
	if layer > 15 {
		fail "a layer takes four bits";
	}
	return layer;
}

fn places() -> int may fail
{
	let n = 0;
	let numbers: [4]int = [0; 4];
	let pair = Pair { left: 0, right: 0 };
	let flags = Flags { layer: 1, pad: 0 };

	n = try value(5);
	numbers[2] = try value(7);
	pair.right = try value(11);
	flags.layer = try small(9);
	n += try value(13);
	printf("places %d %d %d %d\n".ptr, n as c_int, numbers[2] as c_int,
		pair.right as c_int, flags.layer as c_int);
	return n + numbers[2] + pair.right + flags.layer as int;
}

/// The error of a call in assignment position reaches the caller.
fn fails() -> int may fail
{
	let n = 0;
	n = try value(-1);
	return n;
}

fn made(n: int) -> Pair may fail
{
	if n < 0 {
		fail lang.Error.new(1, "n is negative");
	}
	return Pair { left: n, right: n + 1 };
}

/// A value of an aggregate type through a pointer, then on to the caller
/// through the out pointer.
fn passed_on() -> Pair may fail
{
	let pair = Pair { left: 0, right: 0 };
	let into = &pair;
	*into = try made(3);
	return pair;
}

/// The same five places with a handler of their own, and `*p` as well.
fn handled() -> int
{
	let n = 0;
	let numbers: [4]int = [0; 4];
	let pair = Pair { left: 0, right: 0 };
	let flags = Flags { layer: 1, pad: 0 };
	let one = Pair { left: 0, right: 0 };
	let into = &one;

	n = value(5) catch fatal;
	numbers[2] = value(-1) catch { yield 7; };
	pair.right = value(11) catch e {
		printf("unreached %d\n".ptr, e.code as c_int);
		yield 0;
	};
	flags.layer = small(9) catch fatal;
	n += value(-1) catch { yield 13; };
	*into = made(3) catch fatal;
	printf("handled %d %d %d %d %d %d\n".ptr, n as c_int,
		numbers[2] as c_int, pair.right as c_int, flags.layer as c_int,
		one.left as c_int, one.right as c_int);
	return n + numbers[2] + pair.right + flags.layer as int;
}

fn main() -> int
{
	let total = places() catch fatal;
	let n = fails() catch e {
		printf("caught %d\n".ptr, e.code as c_int);
		yield 0;
	};
	let pair = passed_on() catch fatal;
	let sum = handled();

	printf("total %d n %d pair %d %d sum %d\n".ptr, total as c_int,
		n as c_int, pair.left as c_int, pair.right as c_int,
		sum as c_int);
	if total != 45 || sum != 45 {
		return 1;
	}
	if n != 0 {
		return 2;
	}
	if pair.left != 3 || pair.right != 4 {
		return 3;
	}
	return 0;
}
