//! The four flags of every flag operation under the LLVM back end, against a
//! table of cases in release mode: `+`, `-` and `*`, a carry and a borrow in,
//! `<<`, `>>` and unary `-`, at every width, signed and unsigned. Each operand
//! comes through a function the optimizer cannot see through. The table holds
//! the wrapped result and the four flags of two's complement arithmetic. The
//! program prints each case that differs and returns their number. It runs
//! under the LLVM back end alone, as the test `llvm_flags` of
//! `docs/work-order-llvm-back-end.md`, apart from `program_flags`.

extern fn printf(format: ?*byte, ...) -> c_int;

fn opaque(n: int) -> int
{
	return n;
}

fn uopaque(n: u64) -> u64
{
	return n;
}

fn same(f: Flags, o: bool, c: bool, z: bool, n: bool) -> bool
{
	return f.overflow == o && f.carry == c && f.zero == z && f.negative == n;
}

fn check(name: str, got: int, f: Flags, want: int, o: bool, c: bool, z: bool,
	n: bool) -> int
{
	if got == want && same(f, o, c, z, n) {
		return 0;
	}
	printf("%s: %lld o%d c%d z%d n%d\n".ptr, name.ptr, got,
		f.overflow as c_int, f.carry as c_int, f.zero as c_int,
		f.negative as c_int);
	return 1;
}

fn ucheck(name: str, got: u64, f: Flags, want: u64, o: bool, c: bool, z: bool,
	n: bool) -> int
{
	if got == want && same(f, o, c, z, n) {
		return 0;
	}
	printf("%s: %llu o%d c%d z%d n%d\n".ptr, name.ptr, got,
		f.overflow as c_int, f.carry as c_int, f.zero as c_int,
		f.negative as c_int);
	return 1;
}

fn signed8() -> int
{
	let bad = 0;
	let (r0, flags0) = (opaque(127) as i8) + (opaque(1) as i8);
	bad += check("i8 (opaque(127) as i8) + (opaque(1) as i8)", r0 as int, flags0, -128, true, false, false, true);
	let (r1, flags1) = (opaque(127) as i8) - (opaque(1) as i8);
	bad += check("i8 (opaque(127) as i8) - (opaque(1) as i8)", r1 as int, flags1, 126, false, false, false, false);
	let (r2, flags2) = (opaque(127) as i8) * (opaque(1) as i8);
	bad += check("i8 (opaque(127) as i8) * (opaque(1) as i8)", r2 as int, flags2, 127, false, false, false, false);
	let (r3, flags3) = (opaque(-128) as i8) + (opaque(-1) as i8);
	bad += check("i8 (opaque(-128) as i8) + (opaque(-1) as i8)", r3 as int, flags3, 127, true, true, false, false);
	let (r4, flags4) = (opaque(-128) as i8) - (opaque(-1) as i8);
	bad += check("i8 (opaque(-128) as i8) - (opaque(-1) as i8)", r4 as int, flags4, -127, false, true, false, true);
	let (r5, flags5) = (opaque(-128) as i8) * (opaque(-1) as i8);
	bad += check("i8 (opaque(-128) as i8) * (opaque(-1) as i8)", r5 as int, flags5, -128, true, true, false, true);
	let (r6, flags6) = (opaque(-128) as i8) + (opaque(-128) as i8);
	bad += check("i8 (opaque(-128) as i8) + (opaque(-128) as i8)", r6 as int, flags6, 0, true, true, true, false);
	let (r7, flags7) = (opaque(-128) as i8) - (opaque(-128) as i8);
	bad += check("i8 (opaque(-128) as i8) - (opaque(-128) as i8)", r7 as int, flags7, 0, false, false, true, false);
	let (r8, flags8) = (opaque(-128) as i8) * (opaque(-128) as i8);
	bad += check("i8 (opaque(-128) as i8) * (opaque(-128) as i8)", r8 as int, flags8, 0, true, true, true, false);
	let (r9, flags9) = (opaque(127) as i8) + (opaque(127) as i8);
	bad += check("i8 (opaque(127) as i8) + (opaque(127) as i8)", r9 as int, flags9, -2, true, false, false, true);
	let (r10, flags10) = (opaque(127) as i8) - (opaque(127) as i8);
	bad += check("i8 (opaque(127) as i8) - (opaque(127) as i8)", r10 as int, flags10, 0, false, false, true, false);
	let (r11, flags11) = (opaque(127) as i8) * (opaque(127) as i8);
	bad += check("i8 (opaque(127) as i8) * (opaque(127) as i8)", r11 as int, flags11, 1, true, true, false, false);
	let (r12, flags12) = (opaque(-1) as i8) + (opaque(1) as i8);
	bad += check("i8 (opaque(-1) as i8) + (opaque(1) as i8)", r12 as int, flags12, 0, false, true, true, false);
	let (r13, flags13) = (opaque(-1) as i8) - (opaque(1) as i8);
	bad += check("i8 (opaque(-1) as i8) - (opaque(1) as i8)", r13 as int, flags13, -2, false, false, false, true);
	let (r14, flags14) = (opaque(-1) as i8) * (opaque(1) as i8);
	bad += check("i8 (opaque(-1) as i8) * (opaque(1) as i8)", r14 as int, flags14, -1, false, false, false, true);
	let (r15, flags15) = (opaque(0) as i8) + (opaque(0) as i8);
	bad += check("i8 (opaque(0) as i8) + (opaque(0) as i8)", r15 as int, flags15, 0, false, false, true, false);
	let (r16, flags16) = (opaque(0) as i8) - (opaque(0) as i8);
	bad += check("i8 (opaque(0) as i8) - (opaque(0) as i8)", r16 as int, flags16, 0, false, false, true, false);
	let (r17, flags17) = (opaque(0) as i8) * (opaque(0) as i8);
	bad += check("i8 (opaque(0) as i8) * (opaque(0) as i8)", r17 as int, flags17, 0, false, false, true, false);
	let (r18, flags18) = (opaque(1) as i8) + (opaque(-1) as i8);
	bad += check("i8 (opaque(1) as i8) + (opaque(-1) as i8)", r18 as int, flags18, 0, false, true, true, false);
	let (r19, flags19) = (opaque(1) as i8) - (opaque(-1) as i8);
	bad += check("i8 (opaque(1) as i8) - (opaque(-1) as i8)", r19 as int, flags19, 2, false, true, false, false);
	let (r20, flags20) = (opaque(1) as i8) * (opaque(-1) as i8);
	bad += check("i8 (opaque(1) as i8) * (opaque(-1) as i8)", r20 as int, flags20, -1, false, false, false, true);
	let (r21, flags21) = (opaque(127) as i8) + (opaque(-128) as i8);
	bad += check("i8 (opaque(127) as i8) + (opaque(-128) as i8)", r21 as int, flags21, -1, false, false, false, true);
	let (r22, flags22) = (opaque(127) as i8) - (opaque(-128) as i8);
	bad += check("i8 (opaque(127) as i8) - (opaque(-128) as i8)", r22 as int, flags22, -1, true, true, false, true);
	let (r23, flags23) = (opaque(127) as i8) * (opaque(-128) as i8);
	bad += check("i8 (opaque(127) as i8) * (opaque(-128) as i8)", r23 as int, flags23, -128, true, true, false, true);
	let (r24, flags24) = (opaque(3) as i8) + (opaque(-5) as i8);
	bad += check("i8 (opaque(3) as i8) + (opaque(-5) as i8)", r24 as int, flags24, -2, false, false, false, true);
	let (r25, flags25) = (opaque(3) as i8) - (opaque(-5) as i8);
	bad += check("i8 (opaque(3) as i8) - (opaque(-5) as i8)", r25 as int, flags25, 8, false, true, false, false);
	let (r26, flags26) = (opaque(3) as i8) * (opaque(-5) as i8);
	bad += check("i8 (opaque(3) as i8) * (opaque(-5) as i8)", r26 as int, flags26, -15, false, true, false, true);
	let (r27, flags27) = (opaque(-128) as i8) + (opaque(1) as i8);
	bad += check("i8 (opaque(-128) as i8) + (opaque(1) as i8)", r27 as int, flags27, -127, false, false, false, true);
	let (r28, flags28) = (opaque(-128) as i8) - (opaque(1) as i8);
	bad += check("i8 (opaque(-128) as i8) - (opaque(1) as i8)", r28 as int, flags28, 127, true, false, false, false);
	let (r29, flags29) = (opaque(-128) as i8) * (opaque(1) as i8);
	bad += check("i8 (opaque(-128) as i8) * (opaque(1) as i8)", r29 as int, flags29, -128, false, false, false, true);
	let (k0, one) = (opaque(-1) as i8) + (opaque(1) as i8);
	let (k1, nil) = (opaque(0) as i8) + (opaque(0) as i8);
	let (r30, flags30) = (opaque(-128) as i8) + (opaque(-1) as i8) + one.carry;
	bad += check("i8 (opaque(-128) as i8) + (opaque(-1) as i8) + one.carry", r30 as int, flags30, -128, false, true, false, true);
	let (r31, flags31) = (opaque(-128) as i8) - (opaque(-1) as i8) - one.carry;
	bad += check("i8 (opaque(-128) as i8) - (opaque(-1) as i8) - one.carry", r31 as int, flags31, -128, false, true, false, true);
	let (r32, flags32) = (opaque(-128) as i8) + (opaque(-1) as i8) + nil.carry;
	bad += check("i8 (opaque(-128) as i8) + (opaque(-1) as i8) + nil.carry", r32 as int, flags32, 127, true, true, false, false);
	let (r33, flags33) = (opaque(-128) as i8) - (opaque(-1) as i8) - nil.carry;
	bad += check("i8 (opaque(-128) as i8) - (opaque(-1) as i8) - nil.carry", r33 as int, flags33, -127, false, true, false, true);
	let (r34, flags34) = (opaque(127) as i8) + (opaque(0) as i8) + one.carry;
	bad += check("i8 (opaque(127) as i8) + (opaque(0) as i8) + one.carry", r34 as int, flags34, -128, true, false, false, true);
	let (r35, flags35) = (opaque(127) as i8) - (opaque(0) as i8) - one.carry;
	bad += check("i8 (opaque(127) as i8) - (opaque(0) as i8) - one.carry", r35 as int, flags35, 126, false, false, false, false);
	let (r36, flags36) = (opaque(127) as i8) + (opaque(0) as i8) + nil.carry;
	bad += check("i8 (opaque(127) as i8) + (opaque(0) as i8) + nil.carry", r36 as int, flags36, 127, false, false, false, false);
	let (r37, flags37) = (opaque(127) as i8) - (opaque(0) as i8) - nil.carry;
	bad += check("i8 (opaque(127) as i8) - (opaque(0) as i8) - nil.carry", r37 as int, flags37, 127, false, false, false, false);
	let (r38, flags38) = (opaque(-1) as i8) + (opaque(0) as i8) + one.carry;
	bad += check("i8 (opaque(-1) as i8) + (opaque(0) as i8) + one.carry", r38 as int, flags38, 0, false, true, true, false);
	let (r39, flags39) = (opaque(-1) as i8) - (opaque(0) as i8) - one.carry;
	bad += check("i8 (opaque(-1) as i8) - (opaque(0) as i8) - one.carry", r39 as int, flags39, -2, false, false, false, true);
	let (r40, flags40) = (opaque(-1) as i8) + (opaque(0) as i8) + nil.carry;
	bad += check("i8 (opaque(-1) as i8) + (opaque(0) as i8) + nil.carry", r40 as int, flags40, -1, false, false, false, true);
	let (r41, flags41) = (opaque(-1) as i8) - (opaque(0) as i8) - nil.carry;
	bad += check("i8 (opaque(-1) as i8) - (opaque(0) as i8) - nil.carry", r41 as int, flags41, -1, false, false, false, true);
	let (r42, flags42) = (opaque(127) as i8) + (opaque(-1) as i8) + one.carry;
	bad += check("i8 (opaque(127) as i8) + (opaque(-1) as i8) + one.carry", r42 as int, flags42, 127, false, true, false, false);
	let (r43, flags43) = (opaque(127) as i8) - (opaque(-1) as i8) - one.carry;
	bad += check("i8 (opaque(127) as i8) - (opaque(-1) as i8) - one.carry", r43 as int, flags43, 127, false, true, false, false);
	let (r44, flags44) = (opaque(127) as i8) + (opaque(-1) as i8) + nil.carry;
	bad += check("i8 (opaque(127) as i8) + (opaque(-1) as i8) + nil.carry", r44 as int, flags44, 126, false, true, false, false);
	let (r45, flags45) = (opaque(127) as i8) - (opaque(-1) as i8) - nil.carry;
	bad += check("i8 (opaque(127) as i8) - (opaque(-1) as i8) - nil.carry", r45 as int, flags45, -128, true, true, false, true);
	let (r46, flags46) = (opaque(-128) as i8) + (opaque(0) as i8) + one.carry;
	bad += check("i8 (opaque(-128) as i8) + (opaque(0) as i8) + one.carry", r46 as int, flags46, -127, false, false, false, true);
	let (r47, flags47) = (opaque(-128) as i8) - (opaque(0) as i8) - one.carry;
	bad += check("i8 (opaque(-128) as i8) - (opaque(0) as i8) - one.carry", r47 as int, flags47, 127, true, false, false, false);
	let (r48, flags48) = (opaque(-128) as i8) + (opaque(0) as i8) + nil.carry;
	bad += check("i8 (opaque(-128) as i8) + (opaque(0) as i8) + nil.carry", r48 as int, flags48, -128, false, false, false, true);
	let (r49, flags49) = (opaque(-128) as i8) - (opaque(0) as i8) - nil.carry;
	bad += check("i8 (opaque(-128) as i8) - (opaque(0) as i8) - nil.carry", r49 as int, flags49, -128, false, false, false, true);
	let (r50, flags50) = (opaque(0) as i8) + (opaque(0) as i8) + one.carry;
	bad += check("i8 (opaque(0) as i8) + (opaque(0) as i8) + one.carry", r50 as int, flags50, 1, false, false, false, false);
	let (r51, flags51) = (opaque(0) as i8) - (opaque(0) as i8) - one.carry;
	bad += check("i8 (opaque(0) as i8) - (opaque(0) as i8) - one.carry", r51 as int, flags51, -1, false, true, false, true);
	let (r52, flags52) = (opaque(0) as i8) + (opaque(0) as i8) + nil.carry;
	bad += check("i8 (opaque(0) as i8) + (opaque(0) as i8) + nil.carry", r52 as int, flags52, 0, false, false, true, false);
	let (r53, flags53) = (opaque(0) as i8) - (opaque(0) as i8) - nil.carry;
	bad += check("i8 (opaque(0) as i8) - (opaque(0) as i8) - nil.carry", r53 as int, flags53, 0, false, false, true, false);
	let (r54, flags54) = (opaque(1) as i8) << (opaque(7) as i8);
	bad += check("i8 (opaque(1) as i8) << (opaque(7) as i8)", r54 as int, flags54, -128, true, false, false, true);
	let (r55, flags55) = (opaque(1) as i8) >> (opaque(7) as i8);
	bad += check("i8 (opaque(1) as i8) >> (opaque(7) as i8)", r55 as int, flags55, 0, false, false, true, false);
	let (r56, flags56) = (opaque(64) as i8) << (opaque(1) as i8);
	bad += check("i8 (opaque(64) as i8) << (opaque(1) as i8)", r56 as int, flags56, -128, true, false, false, true);
	let (r57, flags57) = (opaque(64) as i8) >> (opaque(1) as i8);
	bad += check("i8 (opaque(64) as i8) >> (opaque(1) as i8)", r57 as int, flags57, 32, false, false, false, false);
	let (r58, flags58) = (opaque(-1) as i8) << (opaque(1) as i8);
	bad += check("i8 (opaque(-1) as i8) << (opaque(1) as i8)", r58 as int, flags58, -2, false, true, false, true);
	let (r59, flags59) = (opaque(-1) as i8) >> (opaque(1) as i8);
	bad += check("i8 (opaque(-1) as i8) >> (opaque(1) as i8)", r59 as int, flags59, -1, false, true, false, true);
	let (r60, flags60) = (opaque(5) as i8) << (opaque(0) as i8);
	bad += check("i8 (opaque(5) as i8) << (opaque(0) as i8)", r60 as int, flags60, 5, false, false, false, false);
	let (r61, flags61) = (opaque(5) as i8) >> (opaque(0) as i8);
	bad += check("i8 (opaque(5) as i8) >> (opaque(0) as i8)", r61 as int, flags61, 5, false, false, false, false);
	let (r62, flags62) = (opaque(-3) as i8) << (opaque(2) as i8);
	bad += check("i8 (opaque(-3) as i8) << (opaque(2) as i8)", r62 as int, flags62, -12, false, true, false, true);
	let (r63, flags63) = (opaque(-3) as i8) >> (opaque(2) as i8);
	bad += check("i8 (opaque(-3) as i8) >> (opaque(2) as i8)", r63 as int, flags63, -1, false, false, false, true);
	let (r64, flags64) = (opaque(-127) as i8) << (opaque(1) as i8);
	bad += check("i8 (opaque(-127) as i8) << (opaque(1) as i8)", r64 as int, flags64, 2, true, true, false, false);
	let (r65, flags65) = (opaque(-127) as i8) >> (opaque(1) as i8);
	bad += check("i8 (opaque(-127) as i8) >> (opaque(1) as i8)", r65 as int, flags65, -64, false, true, false, true);
	let (r66, flags66) = (opaque(127) as i8) << (opaque(7) as i8);
	bad += check("i8 (opaque(127) as i8) << (opaque(7) as i8)", r66 as int, flags66, -128, true, true, false, true);
	let (r67, flags67) = (opaque(127) as i8) >> (opaque(7) as i8);
	bad += check("i8 (opaque(127) as i8) >> (opaque(7) as i8)", r67 as int, flags67, 0, false, true, true, false);
	let (r68, flags68) = -(opaque(-128) as i8);
	bad += check("i8 -(opaque(-128) as i8)", r68 as int, flags68, -128, true, true, false, true);
	let (r69, flags69) = -(opaque(0) as i8);
	bad += check("i8 -(opaque(0) as i8)", r69 as int, flags69, 0, false, false, true, false);
	let (r70, flags70) = -(opaque(5) as i8);
	bad += check("i8 -(opaque(5) as i8)", r70 as int, flags70, -5, false, true, false, true);
	let (r71, flags71) = -(opaque(-7) as i8);
	bad += check("i8 -(opaque(-7) as i8)", r71 as int, flags71, 7, false, true, false, false);
	let (r72, flags72) = -(opaque(127) as i8);
	bad += check("i8 -(opaque(127) as i8)", r72 as int, flags72, -127, false, true, false, true);
	return bad;
}

fn signed16() -> int
{
	let bad = 0;
	let (r73, flags73) = (opaque(32767) as i16) + (opaque(1) as i16);
	bad += check("i16 (opaque(32767) as i16) + (opaque(1) as i16)", r73 as int, flags73, -32768, true, false, false, true);
	let (r74, flags74) = (opaque(32767) as i16) - (opaque(1) as i16);
	bad += check("i16 (opaque(32767) as i16) - (opaque(1) as i16)", r74 as int, flags74, 32766, false, false, false, false);
	let (r75, flags75) = (opaque(32767) as i16) * (opaque(1) as i16);
	bad += check("i16 (opaque(32767) as i16) * (opaque(1) as i16)", r75 as int, flags75, 32767, false, false, false, false);
	let (r76, flags76) = (opaque(-32768) as i16) + (opaque(-1) as i16);
	bad += check("i16 (opaque(-32768) as i16) + (opaque(-1) as i16)", r76 as int, flags76, 32767, true, true, false, false);
	let (r77, flags77) = (opaque(-32768) as i16) - (opaque(-1) as i16);
	bad += check("i16 (opaque(-32768) as i16) - (opaque(-1) as i16)", r77 as int, flags77, -32767, false, true, false, true);
	let (r78, flags78) = (opaque(-32768) as i16) * (opaque(-1) as i16);
	bad += check("i16 (opaque(-32768) as i16) * (opaque(-1) as i16)", r78 as int, flags78, -32768, true, true, false, true);
	let (r79, flags79) = (opaque(-32768) as i16) + (opaque(-32768) as i16);
	bad += check("i16 (opaque(-32768) as i16) + (opaque(-32768) as i16)", r79 as int, flags79, 0, true, true, true, false);
	let (r80, flags80) = (opaque(-32768) as i16) - (opaque(-32768) as i16);
	bad += check("i16 (opaque(-32768) as i16) - (opaque(-32768) as i16)", r80 as int, flags80, 0, false, false, true, false);
	let (r81, flags81) = (opaque(-32768) as i16) * (opaque(-32768) as i16);
	bad += check("i16 (opaque(-32768) as i16) * (opaque(-32768) as i16)", r81 as int, flags81, 0, true, true, true, false);
	let (r82, flags82) = (opaque(32767) as i16) + (opaque(32767) as i16);
	bad += check("i16 (opaque(32767) as i16) + (opaque(32767) as i16)", r82 as int, flags82, -2, true, false, false, true);
	let (r83, flags83) = (opaque(32767) as i16) - (opaque(32767) as i16);
	bad += check("i16 (opaque(32767) as i16) - (opaque(32767) as i16)", r83 as int, flags83, 0, false, false, true, false);
	let (r84, flags84) = (opaque(32767) as i16) * (opaque(32767) as i16);
	bad += check("i16 (opaque(32767) as i16) * (opaque(32767) as i16)", r84 as int, flags84, 1, true, true, false, false);
	let (r85, flags85) = (opaque(-1) as i16) + (opaque(1) as i16);
	bad += check("i16 (opaque(-1) as i16) + (opaque(1) as i16)", r85 as int, flags85, 0, false, true, true, false);
	let (r86, flags86) = (opaque(-1) as i16) - (opaque(1) as i16);
	bad += check("i16 (opaque(-1) as i16) - (opaque(1) as i16)", r86 as int, flags86, -2, false, false, false, true);
	let (r87, flags87) = (opaque(-1) as i16) * (opaque(1) as i16);
