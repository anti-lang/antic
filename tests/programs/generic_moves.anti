//! In generic code a local of a type parameter moves on `let` and `=`, since
//! the checker cannot know whether the `T` of a copy owns something. The copy
//! for an owning `T` then gives each value one owner, and the copy for `int`
//! behaves as before. Each case runs under a leak check: the count of the
//! leaves alive and the count of the teardowns of the keys, which a second
//! teardown of the same key would raise.

extern fn printf(format: ?*byte, ...) -> c_int;

class Leaf
{
	pub n: int = 0,

	static atomic live: int = 0;

	fn destruct(self)
	{
		Leaf.live.sub(1);
	}
}

/// A key that owns a leaf and counts its teardowns.
class Key
{
	pub own leaf: ?*Leaf = none,

	static atomic torn: int = 0;

	pub fn number(self) -> int
	{
		let l = self.leaf else {
			return -1;
		};
		return l.n;
	}

	fn destruct(self)
	{
		Key.torn.add(1);
	}
}

fn key(n: int) -> Key
{
	Leaf.live.add(1);
	return Key { leaf: alloc Leaf { n: n } };
}

/// `let a = x; let b = a;` hands the value on twice.
fn relet<T>(own x: T)
{
	let a = x;
	let b = a;
}

/// The same, with the value given back.
fn relet_back<T>(own x: T) -> T
{
	let a = x;
	let b = a;
	return b;
}

/// `=` tears down the value it replaces and moves the local in.
fn assign<T>(own x: T, own y: T) -> T
{
	let a = x;
	let b = y;
	a = b;
	return a;
}

/// A local of a tuple that holds a `T` moves as well.
fn pair<T>(own x: T) -> (T, int)
{
	let t = (x, 1);
	let u = t;
	return u;
}

/// `dup` is the explicit copy.
fn copied<T>(own x: T) -> T
{
	let a = x;
	let b = dup(a);
	return b;
}

fn check(name: str)
{
	printf("%.*s: torn %d, leaves %d\n".ptr, name.len as c_int, name.ptr,
		Key.torn.load() as c_int, Leaf.live.load() as c_int);
}

fn main() -> int
{
	relet<Key>(key(1));
	check("relet");
	{
		let k = relet_back<Key>(key(2));
		printf("relet back %d\n".ptr, k.number() as c_int);
	}
	check("relet back");
	{
		let k = assign<Key>(key(3), key(4));
		printf("assign %d\n".ptr, k.number() as c_int);
	}
	check("assign");
	{
		let t = pair<Key>(key(5));
		printf("pair %d %d\n".ptr, t.0.number() as c_int, t.1 as c_int);
	}
	check("pair");
	{
		let k = copied<Key>(key(6));
		// The copy of the key made a leaf, which no constructor counted.
		Leaf.live.add(1);
		printf("copied %d\n".ptr, k.number() as c_int);
	}
	check("copied");
	relet<int>(7);
	printf("plain %d %d %d\n".ptr, relet_back<int>(8) as c_int,
		assign<int>(9, 10) as c_int, copied<int>(11) as c_int);
	check("plain");
	return 0;
}
