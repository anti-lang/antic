//! A `lent` slice parameter takes a slice valid for the call alone, with the
//! rules of a `lent` pointer. The function reads and changes the elements,
//! walks them in both forms, passes the slice and a part of it on to another
//! `lent` parameter and reaches it from a closure during the call. A buffer
//! lends its whole room this way, and an anonymous function takes `lent` from
//! the parameter it is passed to. Any slice goes where a lent one is expected,
//! and the pointer of the slice goes on to C. A generic takes a `lent []T`.

extern fn printf(format: ?*byte, ...) -> c_int;

class Buffer
{
	pub room: [4]int = [0; 4],

	pub fn lend_slice(self, f: fn(lent []int))
	{
		f(self.room[0..4]);
	}
}

fn sum(lent xs: []int) -> int
{
	let total = 0;
	for x in xs {
		total += x;
	}
	return total;
}

fn fill(lent xs: []int, v: int)
{
	for i in 0..xs.len {
		xs[i] = v + i;
	}
}

fn double(lent xs: []int)
{
	for x in &xs {
		*x = *x * 2;
	}
}

fn middle(lent xs: []int) -> int
{
	let part = xs[1..xs.len - 1];
	let add = fn() -> int { return sum(part); };
	return add();
}

fn first<T>(lent xs: []T) -> T
{
	return xs[0];
}

fn show(lent text: []byte)
{
	printf("%.*s\n".ptr, text.len as c_int, text.ptr);
}

fn main() -> int
{
	let buffer = Buffer { };
	buffer.lend_slice(fn(xs) { fill(xs, 1); });
	printf("sum %d\n".ptr, sum(buffer.room[0..4]) as c_int);
	buffer.lend_slice(double);
	printf("doubled %d %d %d %d\n".ptr, buffer.room[0] as c_int,
		buffer.room[1] as c_int, buffer.room[2] as c_int,
		buffer.room[3] as c_int);
	buffer.lend_slice(fn(xs) { printf("middle %d\n".ptr, middle(xs) as c_int); });

	let numbers: [3]int = [5, 6, 7];
	let whole: []int = numbers[0..3];
	printf("plain %d\n".ptr, sum(whole) as c_int);
	let word: [5]byte = [104, 101, 108, 108, 111];
	show(word[0..5]);
	printf("first %d\n".ptr, first(numbers[1..3]) as c_int);
	return 0;
}
