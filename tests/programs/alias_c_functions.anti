//! The rule "Functions of C" of "Aliasing of views": a function of C follows
//! the rules of C, and its accesses may refer to any memory its pointers reach.
//! `memcpy` into a field, `memset` over an array of floats and `qsort` over the
//! elements of an array field each reach the next read in Anti. The test runs
//! in release mode, where the loads and stores carry !tbaa.

extern fn printf(format: ?*byte, ...) -> c_int;
extern fn memcpy(to: ?*byte, from: ?*byte, count: c_size_t) -> ?*byte;
extern fn memset(to: ?*byte, value: c_int, count: c_size_t) -> ?*byte;
extern fn qsort(base: ?*byte, count: c_size_t, size: c_size_t,
	compare: fn(?*byte, ?*byte) -> c_int);

struct Pair
{
	a: int,
	b: int,
}

struct Floats
{
	fs: [3]float,
}

struct Sorted
{
	count: int,
	values: [4]i32,
}

fn compare(x: ?*byte, y: ?*byte) -> c_int
{
	let a = x as *i32;
	let b = y as *i32;
	if *a < *b {
		return -1;
	}
	if *a > *b {
		return 1;
	}
	return 0;
}

fn copied(ps: *Pair, from: *Pair) -> int
{
	ps.b = 1;
	from.b = 2;
	memcpy(&ps.b as ?*byte, &from.b as ?*byte, 8);
	return ps.b;
}

fn cleared(fs: *[3]float) -> float
{
	(*fs)[1] = 2.5;
	memset(fs as ?*byte, 0, 24);
	return (*fs)[1];
}

fn sorted(s: *Sorted) -> i32
{
	s.values[0] = 4;
	s.values[1] = 3;
	s.values[2] = 2;
	s.values[3] = 1;
	qsort(&s.values as ?*byte, 4, 4, compare);
	return s.values[0] * 1000 + s.values[1] * 100 + s.values[2] * 10 +
		s.values[3];
}

fn main() -> int
{
	let ps = alloc Pair { a: 0, b: 0 };
	let from = alloc Pair { a: 0, b: 0 };
	printf("memcpy %lld\n".ptr, copied(ps, from));
	let fs = alloc Floats { fs: [0.0, 0.0, 0.0] };
	printf("memset %g\n".ptr, cleared(&fs.fs));
	let s = alloc Sorted { count: 4, values: [0, 0, 0, 0] };
	printf("qsort %d\n".ptr, sorted(s));
	return 0;
}
