//! A `for` over an array or a slice of an aggregate copies the element
//! into a place of its own, so a body that reads the sequence again sees
//! what it held.

extern fn printf(format: ?*byte, ...) -> c_int;

struct Point
{
	x: int,
	y: int,
}

fn main() -> int
{
	let points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
	let sum = 0;
	for p in points {
		sum = sum + p.x * 10 + p.y + points[0].x;
	}
	let s = points[0..2];
	for p in s {
		sum = sum + p.x + s.len;
	}
	printf("%d\n".ptr, sum as c_int);
	return 0;
}
