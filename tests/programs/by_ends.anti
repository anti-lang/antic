//! A range walks to the ends of its type and stops. The counter never steps
//! past the last value, so it never wraps around to a value below the high
//! bound: `for i in 0 as u8..255 by 10` stops at 250, and `for i in -100 as
//! i8..100 by -50` gives 50, 0, -50 and -100, where the span of 200 does not
//! fit an `i8`. Each loop stops itself after 40 turns and prints `runaway`, so
//! a loop that wraps shows in the output instead of hanging the test. The
//! functions read their bounds at run time, once: a body that assigns the
//! variables of the bounds does not move the ends of the walk.

extern fn printf(format: ?*byte, ...) -> c_int;

fn up_u8(lo: u8, hi: u8)
{
	let n = 0;
	printf("u8 %u..%u by 10:".ptr, lo as c_uint, hi as c_uint);
	for i in lo..hi by 10 {
		printf(" %u".ptr, i as c_uint);
		n = n + 1;
		if n == 40 {
			printf(" runaway".ptr);
			break;
		}
	}
	printf("\n".ptr);
}

fn up_i8(lo: i8, hi: i8)
{
	let n = 0;
	printf("i8 %d..%d by 100:".ptr, lo as c_int, hi as c_int);
	for i in lo..hi by 100 {
		printf(" %d".ptr, i as c_int);
		n = n + 1;
		if n == 40 {
			printf(" runaway".ptr);
			break;
		}
	}
	printf("\n".ptr);
}

fn down_i8(lo: i8, hi: i8)
{
	let n = 0;
	printf("i8 %d..%d by -50:".ptr, lo as c_int, hi as c_int);
	for i in lo..hi by -50 {
		printf(" %d".ptr, i as c_int);
		n = n + 1;
		if n == 40 {
			printf(" runaway".ptr);
			break;
		}
	}
	printf("\n".ptr);
}

fn down_i16(lo: i16, hi: i16)
{
	let n = 0;
	printf("i16 %d..%d by -20000:".ptr, lo as c_int, hi as c_int);
	for i in lo..hi by -20000 {
		printf(" %d".ptr, i as c_int);
		n = n + 1;
		if n == 40 {
			printf(" runaway".ptr);
			break;
		}
	}
	printf("\n".ptr);
}

fn up_int(lo: int, hi: int)
{
	let n = 0;
	printf("int %lld..%lld by 4:".ptr, lo, hi);
	for i in lo..hi by 4 {
		printf(" %lld".ptr, i);
		n = n + 1;
		if n == 40 {
			printf(" runaway".ptr);
			break;
		}
	}
	printf("\n".ptr);
}

fn down_int(lo: int, hi: int)
{
	let n = 0;
	printf("int %lld..%lld by -4:".ptr, lo, hi);
	for i in lo..hi by -4 {
		printf(" %lld".ptr, i);
		n = n + 1;
		if n == 40 {
			printf(" runaway".ptr);
			break;
		}
	}
	printf("\n".ptr);
}

fn up_u64(lo: u64, hi: u64)
{
	let n = 0;
	printf("u64 %llu..%llu by 2^63:".ptr, lo, hi);
	for i in lo..hi by 9223372036854775808 {
		printf(" %llu".ptr, i);
		n = n + 1;
		if n == 40 {
			printf(" runaway".ptr);
			break;
		}
	}
	printf("\n".ptr);
}

fn moved(lo: int, hi: int)
{
	let a = lo;
	let b = hi;
	printf("moved up:".ptr);
	for i in a..b by 3 {
		printf(" %lld".ptr, i);
		a = 100;
		b = 0;
	}
	a = lo;
	b = hi;
	printf("\nmoved down:".ptr);
	for i in a..b by -3 {
		printf(" %lld".ptr, i);
		a = 100;
		b = 0;
	}
	printf("\n".ptr);
}

fn main() -> int
{
	let n = 0;
	printf("constant u8:".ptr);
	for i in 0 as u8..255 by 10 {
		printf(" %u".ptr, i as c_uint);
		n = n + 1;
		if n == 40 {
			printf(" runaway".ptr);
			break;
		}
	}
	printf("\n".ptr);
	n = 0;
	printf("constant i8:".ptr);
	for i in -100 as i8..100 by -50 {
		printf(" %d".ptr, i as c_int);
		n = n + 1;
		if n == 40 {
			printf(" runaway".ptr);
			break;
		}
	}
	printf("\n".ptr);
	up_u8(0, 255);
	up_u8(250, 255);
	up_u8(5, 5);
	up_i8(-128, 127);
	up_i8(28, 127);
	down_i8(-100, 100);
	down_i8(-128, 127);
	down_i8(100, -100);
	down_i16(-32768, 32767);
	up_int(9223372036854775800, 9223372036854775807);
	up_int(-9223372036854775807 - 1, -9223372036854775800);
	down_int(-9223372036854775807 - 1, -9223372036854775800);
	down_int(9223372036854775800, 9223372036854775807);
	up_u64(0, 18446744073709551615);
	up_u64(1, 18446744073709551615);
	moved(0, 10);
	return 0;
}
