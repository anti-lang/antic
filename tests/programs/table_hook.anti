//! The table pointer of an object is written once, when the object is made, so
//! a release build forwards it to every call through the table. The fields are
//! not: the `created` hook writes `n` after the literal wrote its default, and
//! every call through a table after the hook reads the value the hook wrote. A
//! call through the table of an interface sub-object and `is` read the table
//! after the hook as well.

extern fn printf(format: ?*byte, ...) -> c_int;

abstract class Sized
{
	abstract fn size(self) -> int;
}

class Shape
{
	pub n: int = 1,

	pub fn area(self) -> int
	{
		return self.n;
	}

	concrete fn created(self)
	{
		self.n = self.n + 4;
	}
}

class Circle inherits Shape
{
	implements sz: Sized,

	concrete fn area(self) -> int
	{
		return self.n * 10;
	}

	concrete fn size(self) -> int
	{
		return self.n + 1000;
	}
}

class Square inherits Shape
{
	concrete fn area(self) -> int
	{
		return self.n * 100;
	}
}

fn total(shapes: []*Shape) -> int
{
	let sum = 0;
	for s in shapes {
		sum += s.area();
	}
	return sum;
}

pub fn main() -> int
{
	let c = alloc Circle { };
	let s: *Shape = c;
	printf("%d\n".ptr, s.area() as c_int);
	let q: *Shape = alloc Square { n: 2 };
	printf("%d\n".ptr, q.area() as c_int);
	let sized: *Sized = c;
	printf("%d\n".ptr, sized.size() as c_int);
	printf("%d %d\n".ptr, (s is *Circle) as c_int, (q is *Circle) as c_int);
	let all = [s, q];
	printf("%d\n".ptr, total(all[0..2]) as c_int);
	delete(c);
	delete(q);
	return 0;
}
