//! A `construct` with arguments may fail. `alloc T(args)` runs it on the heap
//! and frees the object when it fails, and a handler may put another pointer in
//! its place. `T(args)` builds a value the same way.
import anti.io;
import anti.lang;

class Circle
{
	pub r: f32 = 0.0,

	fn construct(self, r: f32) may fail
	{
		if r <= 0.0 {
			fail lang.Error.new(1, "radius must be positive");
		}
		self.r = r;
	}
}

fn main() -> int
{
	let c = alloc Circle(2.0) catch fatal;
	io.println("made");
	delete(c);
	let value = Circle(3.0) catch fatal;
	if value.r < 2.9 {
		return 2;
	}
	io.println("value");
	let bad: ?*Circle = alloc Circle(-1.0) catch e {
		io.println(e.message);
		yield none;
	};
	if bad != none {
		return 1;
	}
	let zero = Circle(0.0) catch e {
		io.println("refused");
		yield Circle { r: 1.0 };
	};
	if zero.r != 1.0 {
		return 3;
	}
	return 0;
}
