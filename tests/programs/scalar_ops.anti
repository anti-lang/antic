//! Every scalar operation of the IR, on values that antic's optimizer cannot
//! fold, since each comes from the counter of a loop that runs once. The
//! arithmetic, the bitwise operations and the shifts of each integer width,
//! division and remainder, the comparisons, the float arithmetic, the
//! conversions and `f16`. No operand leaves the range its operation defines, so
//! every target gives one result. The program returns the number of results
//! that differ from the expected values, and exits with 0.

fn main() -> int
{
	let wrong = 0;
	for i in 0..1 {
		let n: int = i + 1000;
		let m: int = i - 7;
		if n + m != 993 { wrong += 1; }
		if n - m != 1007 { wrong += 1; }
		if n * m != -7000 { wrong += 1; }
		if n / m != -142 { wrong += 1; }
		if n % m != 6 { wrong += 1; }
		if m / 2 != -3 { wrong += 1; }
		if m % 2 != -1 { wrong += 1; }
		if (n & 255) != 232 { wrong += 1; }
		if (n | 1) != 1001 { wrong += 1; }
		if (n ^ m) != -1007 { wrong += 1; }
		if -m != 7 { wrong += 1; }
		if ~n != -1001 { wrong += 1; }
		if n << 3 != 8000 { wrong += 1; }
		if m >> 1 != -4 { wrong += 1; }
		if !(m < n) || m <= -8 || !(n > m) || n >= 1001 { wrong += 1; }
		if n == m || !(n != m) { wrong += 1; }

		let u: u64 = (i as u64) -% 16;
		if u / 3 != 6148914691236517200 { wrong += 1; }
		if u % 17 != 2 { wrong += 1; }
		if u >> 60 != 15 { wrong += 1; }
		if !(u > 5) || u < 5 || !(u >= 5) || u <= 5 { wrong += 1; }

		let b: i8 = (i + 100) as i8;
		if b +% b != -56 { wrong += 1; }
		if b *% 3 != 44 { wrong += 1; }
		if (-b) >> 2 != -25 { wrong += 1; }
		if (-b) / 7 != -14 { wrong += 1; }
		if (-b) % 7 != -2 { wrong += 1; }
		if (-b) as int != -100 { wrong += 1; }

		let c: u8 = (i + 200) as u8;
		if c / 7 != 28 { wrong += 1; }
		if c % 7 != 4 { wrong += 1; }
		if c >> 3 != 25 { wrong += 1; }
		if !(c > 100) { wrong += 1; }
		if c as int != 200 { wrong += 1; }

		let s: i16 = (i - 30000) as i16;
		if s / 7 != -4285 { wrong += 1; }
		if s % 7 != -5 { wrong += 1; }
		if s +% s != 5536 { wrong += 1; }
		if s as int != -30000 { wrong += 1; }

		let w: u16 = (i + 65535) as u16;
		if w +% 1 != 0 { wrong += 1; }
		if w / 256 != 255 { wrong += 1; }
		if w as int != 65535 { wrong += 1; }

		let k: i32 = (i - 2147483647) as i32;
		if k -% 2 != 2147483647 { wrong += 1; }
		if k / 65536 != -32767 { wrong += 1; }
		if k as int != -2147483647 { wrong += 1; }

		let q: u32 = (i + 4000000000) as u32;
		if q / 3 != 1333333333 { wrong += 1; }
		if q >> 31 != 1 { wrong += 1; }
		if !(q > 2147483648) { wrong += 1; }

		if (n - 900) as i8 != 100 { wrong += 1; }
		if (n - 800) as u8 != 200 { wrong += 1; }

		let x: f64 = (i as f64) + 1.5;
		if x * 4.0 != 6.0 { wrong += 1; }
		if x / 0.5 != 3.0 { wrong += 1; }
		if x - 2.0 != -0.5 { wrong += 1; }
		if x + 0.25 != 1.75 { wrong += 1; }
		if -x != -1.5 { wrong += 1; }
		if !(x < 2.0) || x <= 1.0 || !(x > 1.0) || x >= 2.0 { wrong += 1; }
		if x == 1.0 || !(x != 1.0) { wrong += 1; }

		let nan: f64 = (i as f64) * 0.0 / 0.0;
		if nan == nan || !(nan != nan) || nan < 1.0 || nan >= 1.0 { wrong += 1; }

		let y: f32 = (i as f32) + 0.25;
		if y * 3.0 != 0.75 { wrong += 1; }
		if y as f64 != 0.25 { wrong += 1; }
		if x as f32 != 1.5 { wrong += 1; }

		if (x * -3.0) as int != -4 { wrong += 1; }
		if x as i32 != 1 { wrong += 1; }
		if (x * 10.0) as u64 != 15 { wrong += 1; }
		if (y * 8.0) as u8 != 2 { wrong += 1; }
		if u as f64 != 18446744073709551616.0 { wrong += 1; }
		if (c as f32) != 200.0 { wrong += 1; }
		if (m as f32) != -7.0 { wrong += 1; }

		let h: f16 = (x as f32) as f16;
		if h * 2.0 != 3.0 { wrong += 1; }
		let tie: f16 = ((i as f32) + 1.00048828125) as f16;
		if tie != 1.0 { wrong += 1; }
		let up: f16 = ((i as f32) + 1.00146484375) as f16;
		if up != 1.001953125 { wrong += 1; }
		let huge: f16 = ((i as f32) + 70000.0) as f16;
		if !(huge > 65504.0) { wrong += 1; }
	}
	return wrong;
}
