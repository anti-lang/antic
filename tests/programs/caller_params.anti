//! A parameter that is not `own` belongs to the caller, and generic code takes
//! its value with one of the two fixes the refusal names: `own` on the
//! parameter takes it over, and `dup` copies it. With `T = Key`, which owns a
//! leaf, each value then has one owner. Each case runs under a leak check: the
//! count of the leaves alive and the count of the teardowns of the keys, which
//! a second teardown of the same key would raise.

extern fn printf(format: ?*byte, ...) -> c_int;

class Leaf
{
	pub n: int = 0,

	static atomic live: int = 0;

	fn destruct(self)
	{
		Leaf.live.sub(1);
	}
}

/// A key that owns a leaf and counts its teardowns.
class Key
{
	pub own leaf: ?*Leaf = none,

	static atomic torn: int = 0;

	pub fn number(self) -> int
	{
		let l = self.leaf else {
			return -1;
		};
		return l.n;
	}

	fn destruct(self)
	{
		Key.torn.add(1);
	}
}

fn key(n: int) -> Key
{
	Leaf.live.add(1);
	return Key { leaf: alloc Leaf { n: n } };
}

/// `own` takes the value over, and the function hands it on.
fn taken<T>(own p: T) -> T
{
	let a = p;
	return a;
}

/// `dup` copies the value, and the caller keeps its own.
fn copied<T>(p: T) -> (T, int)
{
	let a = dup(p);
	return (a, 1);
}

fn check(name: str)
{
	printf("%.*s: torn %d, leaves %d\n".ptr, name.len as c_int, name.ptr,
		Key.torn.load() as c_int, Leaf.live.load() as c_int);
}

fn main() -> int
{
	{
		let k = key(1);
		let r = taken<Key>(k);
		printf("taken %d\n".ptr, r.number() as c_int);
	}
	check("own");
	{
		let k = key(2);
		let r = copied<Key>(k);
		// The copy of the key made a leaf, which no constructor counted.
		Leaf.live.add(1);
		printf("copied %d %d\n".ptr, k.number() as c_int, r.0.number() as c_int);
	}
	check("dup");
	printf("plain %d %d\n".ptr, taken<int>(4) as c_int, copied<int>(5).0 as c_int);
	check("plain");
	return 0;
}
