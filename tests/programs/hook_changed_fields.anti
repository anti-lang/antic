//! The `changed` hook under `--trace writes` on the fields of a class with a
//! base: the first and the second field of the class itself, and the first and
//! the second field it inherits. The hook gets the record of the field from the
//! class that declares it. Without `--trace writes` the program prints the
//! values alone.

import anti.lang;

extern fn printf(format: ?*byte, ...) -> c_int;

trace class Base
{
	pub a: int = 0,
	pub b: int = 0,
}

trace class Leaf inherits Base
{
	pub c: int = 0,
	pub d: int = 0,
}

class Watch inherits lang.TraceHandler
{
	concrete fn created(self, o: *Object) { }

	concrete fn destroyed(self, o: *Object) { }

	concrete fn copied(self, o: *Object, from: *Object) { }

	concrete fn dispatched(self, o: *Object) { }

	concrete fn joined(self, o: *Object) { }

	concrete fn enter(self, o: *Object, name: str) { }

	concrete fn leave(self, o: *Object, name: str) { }

	concrete fn failed(self, o: *Object, name: str, e: *lang.Error) { }

	concrete fn changed(self, o: *Object, field: *FieldDescriptor)
	{
		printf("changed %.*s\n".ptr, field.name.len as c_int, field.name.ptr);
	}
}

fn main() -> int
{
	let watch = alloc Watch { };
	lang.Trace.install(watch);

	let leaf = alloc Leaf { };
	leaf.a = 1;
	leaf.b = 2;
	leaf.c = 3;
	leaf.d = 4;
	printf("fields %d %d %d %d\n".ptr, leaf.a as c_int, leaf.b as c_int, leaf.c as c_int, leaf.d as c_int);

	lang.Trace.install(none);
	delete(leaf);
	delete(watch);
	return 0;
}
