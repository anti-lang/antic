//! A write to a bitfield of one bit of a value past its width, by R048 of
//! "Rules of 2026-10-13". The message counts one bit.

struct Narrow
{
	a: u8 : 1,
}

fn opaque(n: int) -> int
{
	return n;
}

fn sink(n: u8)
{
}

fn main() -> int
{
	let x = Narrow { a: 0 };
	x.a = opaque(2) as u8;
	sink(x.a);
	return 7;
}
