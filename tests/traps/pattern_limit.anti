//! A pattern literal cannot make a method fail, and a search that reaches the
//! match limit stops the program with the pattern and the line, as an index out
//! of bounds does. The pattern lowers the limit of PCRE2 with
//! `(*LIMIT_MATCH=1000)`, and the text makes it backtrack past that.

import anti.lang;
import anti.regex;

fn main() -> int
{
	let text = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!";
	unchecked(exponential-pattern, "the test runs into the match limit")
	let m = text.matches(re"(*LIMIT_MATCH=1000)^(\w+\s?)*$");
	if m != none {
		return 0;
	}
	return 1;
}
