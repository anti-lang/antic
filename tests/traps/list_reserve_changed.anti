//! `reserve` moves the room of a `List<T>` while a `for` walks it. The move
//! counts as a change, finding M304, and the loop of a dev build stops at the
//! next turn. Before the fix the walk read the freed room.

import anti.collection.list.{List};

fn main() -> int
{
	let xs = List<int>.new();
	xs.push(1);
	xs.push(2);
	xs.push(3);
	let first = true;
	for n in xs {
		if first {
			xs.reserve(100);
			first = false;
		}
	}
	return 7;
}
