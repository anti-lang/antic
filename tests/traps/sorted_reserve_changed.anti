//! `reserve` moves the room of a `SortedMap<K, V>` while a `for` walks it. The
//! move counts as a change, finding M304, and the loop of a dev build stops at
//! the next turn. Before the fix the walk read the freed room.

import anti.collection.sorted.{SortedMap};

fn main() -> int
{
	let ages = SortedMap<int, int>.new();
	ages.set(1, 10);
	ages.set(2, 20);
	ages.set(3, 30);
	let first = true;
	for e in ages {
		if first {
			ages.reserve(1000);
			first = false;
		}
	}
	return 7;
}
