//! Two locks taken in opposite orders are reported once by a dev build, however
//! often the two orders run after that.

extern fn printf(format: ?*byte, ...) -> c_int;

struct Locks
{
	a: Mutex,
	b: Mutex,
	n: int,
}

fn forward(l: *Locks)
{
	sync l.a {
		sync l.b {
			l.n += 1;
		}
	}
}

fn backward(l: *Locks) unchecked(lock-order, "both orders on purpose, for the check of dev mode")
{
	sync l.b {
		sync l.a {
			l.n += 1;
		}
	}
}

fn main() -> int
{
	let l = Locks { n: 0 };
	forward(&l);
	backward(&l);
	forward(&l);
	backward(&l);
	forward(&l);
	printf("%d\n".ptr, l.n as c_int);
	return 0;
}
