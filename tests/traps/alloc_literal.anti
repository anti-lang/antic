//! `alloc T { }` of a class no heap holds stops the program with the failure
//! routine, as out of memory is fatal for one object. Before the fix the table
//! and the fields were written through the null `malloc` gave, and the store of
//! a field at a large offset could land in mapped memory. The object reaches
//! `printf`, since a release build may drop an allocation that nothing outside
//! `main` reaches, and with it the failure.

extern fn printf(format: ?*byte, ...) -> c_int;

class Huge
{
	pub n: int = 7,
	pub pad: ?[1 << 60]byte = none,
}

fn main() -> int
{
	let h = alloc Huge { };
	printf("%p\n".ptr, h);
	return h.n as int;
}
