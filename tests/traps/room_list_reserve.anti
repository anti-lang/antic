//! `reserve` of a `List<T>` for more elements than an `int` counts stops the
//! program as memory that runs out. Before the fix a release build wrapped the
//! sum of the count and the request and reserved nothing.

import anti.collection.list.{List};

fn main() -> int
{
	let l = List<int>.new();
	l.push(5);
	l.reserve(0x7FFFFFFFFFFFFFFF);
	return l.count;
}
