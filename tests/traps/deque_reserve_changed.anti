//! `reserve` moves the room of a `Deque<T>` while a `for` walks it. The move
//! counts as a change, finding M304, and the loop of a dev build stops at the
//! next turn. Before the fix the walk read the freed room.

import anti.collection.deque.{Deque};

fn main() -> int
{
	let xs = Deque<int>.new();
	xs.push_back(1);
	xs.push_back(2);
	xs.push_back(3);
	let first = true;
	for n in xs {
		if first {
			xs.reserve(100);
			first = false;
		}
	}
	return 7;
}
