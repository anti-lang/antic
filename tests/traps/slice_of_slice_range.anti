//! A slice of a slice whose high bound lies past its length, by decision 24 of
//! "Decisions of 2026-10-11": a dev build checks the bounds of `xs[lo..hi]`
//! against the length of the slice, as it checks an index. The array behind the
//! slice is longer, so the bound is inside its memory.

fn opaque(n: int) -> int
{
	return n;
}

fn sink(n: int)
{
}

fn main() -> int
{
	let xs = [1, 2, 3, 4, 5];
	let part = xs[1..3];
	let wide = part[0..opaque(4)];
	sink(wide.len);
	return 7;
}
