//! `SortedMap<K, V>.new` with a capacity whose nodes no `int` holds as bytes
//! stops the program as memory that runs out. Before the fix a release build
//! wrapped the bytes of the elements of the nodes.

import anti.collection.sorted.{SortedMap};

fn main() -> int
{
	let m = SortedMap<int, int>.new(1 << 60);
	m.set(1, 2);
	return m.count;
}
