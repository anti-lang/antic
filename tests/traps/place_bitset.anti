//! `take_place` of a `BitSet` given a number it does not hold stops the
//! program, finding S315. Before the fix it gave the number as an element, and
//! a remove form took it off the count.

import anti.collection.set.{BitSet};

fn main() -> int
{
	let s = BitSet.new();
	s.add(3);
	let (n, after) = s.take_place(9);
	return n;
}
