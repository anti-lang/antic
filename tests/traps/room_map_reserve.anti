//! `reserve` of a `Map<K, V>` for more elements than an `int` counts stops the
//! program as memory that runs out. Before the fix a release build wrapped the
//! sum of the count and the request and reserved nothing.

import anti.collection.map.{Map};

fn main() -> int
{
	let m = Map<int, int>.new();
	m.set(1, 2);
	m.reserve(0x7FFFFFFFFFFFFFFF);
	return m.count;
}
