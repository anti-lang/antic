type anti.rt.Field = struct { name: ptr, name_length: i64, offset: i64, type: i64, owned: i64, descriptor: ptr }
type [2]anti.rt.Field = array 2 of anti.rt.Field
global main.H.descriptor anti.rt.Descriptor { @main.1, i64 1, ptr 0, size_of main.H, i64 0, ptr 0, i64 2, @main.H.fields, ptr 0, i64 0, i64 0, ptr 0 }
global main.1 size 2 align 1 bytes 48 00
global main.2 size 4 align 1 bytes 74 61 67 00
global main.3 size 2 align 1 bytes 6e 00
global main.H.fields [2]anti.rt.Field { anti.rt.Field { @main.2, i64 3, offset_of main.H.tag, i64 8, i64 0, ptr 0 }, anti.rt.Field { @main.3, i64 1, offset_of main.H.n, i64 5, i64 0, ptr 0 } }
fn main.f() -> i64 {
b0:
    %0 = copy i64 size_of main.H
    %1 = mul i64 %0, 1
    %2 = add i64 %1, 4
    %3 = sub i64 %2, 4
