global sizes.Buffer.descriptor anti.rt.Descriptor { @sizes.7, i64 6, ptr 0, size_of sizes.Buffer, i64 0, ptr 0, i64 2, @sizes.Buffer.fields, ptr 0, i64 0, i64 0, ptr 0 }
