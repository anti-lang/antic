//! The two conversions of `f16` and nothing else of floats but `f32`. A
//! read widens the sixteen bits to an `f32`, and `as f16` narrows an `f32`
//! to them. ARM64 and x86-64-v3 have an instruction for each, and v1 and
//! v2 call the runtime.

struct Pixel
{
	r: f16,
	g: f16,
}

fn brighten(p: *Pixel, by: f32)
{
	p.r = (p.r * by) as f16;
	p.g = (p.g + by) as f16;
}

fn sum(values: []f16) -> f32
{
	let total: f32 = 0.0;
	for v in values {
		total += v;
	}
	return total;
}

fn main() -> int
{
	let p = Pixel { r: 0.5 as f16, g: 0.25 as f16 };
	brighten(&p, 2.0);
	let values = [p.r as f16, p.g as f16];
	return sum(values[0..2]) as int;
}
