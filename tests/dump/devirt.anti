//! A call on a class pointer reads the entry of a table, because the
//! object may be of a class below the static type. A `final class` and
//! a `final fn` have no class below them, so both call directly. The
//! two modes lower the same calls, because lowering never makes a call
//! direct by a scan of the classes one module can see.
//!
//! The pass over the whole program runs after lowering. In release mode
//! it calls `Dog.speak` directly, because every table a `*Speaker` may
//! point at holds it. `Base.value` stays a call through the table, since
//! `Derived` replaces it. Dev mode keeps every call through a table.

final class Only
{
	n: int = 1,

	pub fn value(self) -> int
	{
		return self.n;
	}
}

class Base
{
	n: int = 2,

	pub fn value(self) -> int
	{
		return self.n;
	}

	pub final fn same(self) -> int
	{
		return 7;
	}
}

class Derived
{
	inherits Base,
	concrete fn value(self) -> int
	{
		return 100;
	}
}

pub fn total(p: *Only, q: *Base) -> int
{
	return p.value() + q.value() + q.same();
}

abstract class Speaker
{
	abstract fn speak(self) -> int;
}

class Dog
{
	inherits Speaker,
	concrete fn speak(self) -> int
	{
		return 3;
	}
}

pub fn talk(s: *Speaker) -> int
{
	return s.speak();
}
