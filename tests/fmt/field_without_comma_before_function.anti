//! A field of a class body or a value of an enum without its comma, before a
//! function of the body. The field ends there, as antic reads it, so the header
//! of the function stands at the level of the body and carries no continuation.
//! A field whose type stands on the next line goes on with it.

class Holder
{
	pub x: int

	pub fn get(self) -> int
	{
		return self.x;
	}
}

class Counter
{
	pub step:
		fn(int) -> int,
	pub n: int

	/// The count after one step.
	pub fn next(self) -> int
	{
		return self.step(self.n);
	}
}

abstract class Shape
{
	protected sides: int = 4
	// A comment between the field and the function.
	pub abstract fn area(self) -> int;
}

class Square inherits Shape
{
	pub side: int
	concrete fn area(self) -> int
	{
		return self.side * self.side;
	}
}

class Marks
{
	pub a: int
	const LIMIT: int = 3;
	pub b: int
	pub static atomic seen: int = 0;
	pub c: int
	pub final fn first(self) -> int
	{
		return self.a;
	}
	pub d: int
	operator fn eq(self, other: *Marks) -> bool
	{
		return self.a == other.a;
	}
	pub e: int
	pub trace fn second(self) -> int
	{
		return self.b;
	}
	pub f: int
	protected fn third(self) -> int
	{
		return self.c;
	}
	pub g: int
	export fn fourth(self) -> int
	{
		return self.d;
	}
}

enum Mode
{
	Read,
	Write

	pub fn code() -> int
	{
		return 1;
	}
}

fn twice(n: int) -> int
{
	return n * 2;
}

fn main() -> int
{
	let h = Holder { x: 7 };
	let c = Counter { step: twice, n: 3 };
	let q = Square { side: 2 };
	let m = Marks { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7 };
	return h.get() + c.next() + Mode.code() + q.area() + m.first() + m.second() -
		21;
}
