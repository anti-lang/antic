class Holder
{
	inject one: *One,
	inject two: *Two,
	inject three: *Three,
	inject four: *Four,
	inject five: *Five,
	inject six: *Six,
	inject seven: *Seven,
	inject eight: *Eight,
	inject nine: *Nine,
	inject ten: *Ten,
	inject eleven: *Eleven,
	inject twelve: *Twelve,
	inject thirteen: *Thirteen,
	inject fourteen: *Fourteen,
	inject fifteen: *Fifteen,
	inject sixteen: *Sixteen,
	inject seventeen: *Seventeen,

	pub fn sum(self) -> int
	{
		return self.one.n() + self.two.n() + self.three.n() + self.four.n() + self.five.n() + self.six.n() + self.seven.n() + self.eight.n() + self.nine.n() + self.ten.n() + self.eleven.n() + self.twelve.n() + self.thirteen.n() + self.fourteen.n() + self.fifteen.n() + self.sixteen.n() + self.seventeen.n();
	}
}

fn main() -> int
{
	let h = alloc Holder { };
	printf("sum %lld\n".ptr, h.sum());
	delete(h);
	return 0;
}
