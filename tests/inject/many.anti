//! A program with seventeen injectable interfaces, each with the default
//! provider its interface declares. The configuration at start takes at most
//! sixteen of them from libraries, and a seventeenth is a startup error before
//! any library loads.

extern fn printf(fmt: ?*byte, ...) -> c_int;

abstract class One
{
	abstract fn n(self) -> int;

	pub fn default() -> *One
	{
		return OneHere.get();
	}
}

singleton class OneHere inherits One
{
	concrete fn n(self) -> int
	{
		return 1;
	}
}

