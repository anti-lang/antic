        fuzz_expr(eb ${type} 1)
        set(text "${t}let ${name} = (${ea}, ${eb});\n${t}let (${a}, ${b}) = ${name};\n")
        fuzz_declare(int ${a} TRUE)
        fuzz_declare(${type} ${b} TRUE)
        fuzz_declare(int "${name}.0" FALSE)
        fuzz_declare(${type} "${name}.1" FALSE)

    elseif(kind STREQUAL "flags")
        fuzz_pick(type ${FUZZ_SCALARS})
        fuzz_name(r v)
        fuzz_name(f g)
        fuzz_expr(a ${type} 1)
        fuzz_expr(b ${type} 1)
        math(EXPR top "${fuzz_bits_${type}} - 1")
        fuzz_weighted(form add:3 sub:2 mul:2 shl:1 shr:1 neg:1 carry:2)
        if(form STREQUAL "add")
            set(op "${a} + ${b}")
        elseif(form STREQUAL "sub")
            set(op "${a} - ${b}")
        elseif(form STREQUAL "mul")
            set(op "${a} * ${b}")
        elseif(form STREQUAL "shl")
            set(op "${a} << (${b} & ${top})")
        elseif(form STREQUAL "shr")
            set(op "${a} >> (${b} & ${top})")
        elseif(form STREQUAL "neg" AND fuzz_signed_${type} AND
               NOT a MATCHES "^[0-9]+$")
            # A `-` directly before a literal forms a constant, which the
            # flags form refuses.
            set(op "-${a}")
        else()
            set(op "${a} + ${b}")
        endif()
        set(text "${t}let (${r}, ${f}) = ${op};\n")
        if(form STREQUAL "carry")
            fuzz_name(r2 v)
            fuzz_name(f2 g)
            fuzz_expr(c ${type} 1)
            string(APPEND text "${t}let (${r2}, ${f2}) = ${r} + ${c} + ${f}.carry;\n")
            fuzz_declare(${type} ${r2} FALSE)
            list(APPEND decl "leaf#bool#${f2}.carry" "leaf#bool#${f2}.overflow")
