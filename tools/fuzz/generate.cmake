                set(callee "")
            endif()
        endif()
        if(callee STREQUAL "")
            fuzz_pick(risky risky_0 risky_1)
            fuzz_expr(e int 1)
            set(call "${risky}(${e})")
        endif()
        fuzz_weighted(form named:3 plain:2 none:2 step:2)
        if(form STREQUAL "named")
            fuzz_literal(l int)
            set(text "${t}let ${name} = ${call} catch ${err} {\n${t}\tyield ${err}.code +% ${l};\n${t}};\n")
            fuzz_declare(int ${name} FALSE)
        elseif(form STREQUAL "plain")
            fuzz_literal(l int)
            set(text "${t}let ${name} = ${call} catch {\n${t}\tyield ${l};\n${t}};\n")
            fuzz_declare(int ${name} FALSE)
        elseif(form STREQUAL "none")
            fuzz_literal(l int)
            fuzz_pick(maybe maybe_0 maybe_1)
            fuzz_expr(e int 1)
            set(text "${t}let ${name} = ${maybe}(${e}) catch none;\n")
            fuzz_declare(int "(${name} ?? ${l})" FALSE)
        else()
            fuzz_pick(step step_0 step_1)
            fuzz_expr(e int 1)
            fuzz_place(place int)
            fuzz_literal(l int)
            set(text "${t}${step}(${e}) catch {\n${t}\t${place} = ${place} ^ ${l};\n${t}};\n")
        endif()

    elseif(kind STREQUAL "try")
        fuzz_name(name r)
        fuzz_pick(risky risky_0 risky_1 step_0 step_1)
        fuzz_expr(e int 1)
        if(risky MATCHES "^step")
            set(text "${t}try ${risky}(${e});\n")
        else()
            set(text "${t}let ${name} = try ${risky}(${e});\n")
            fuzz_declare(int ${name} FALSE)
        endif()

    elseif(kind STREQUAL "fail")
        fuzz_cond(c 1)
        fuzz_rand(code 100)
        fuzz_name(label fail)
        fuzz_pick(form error text)
        if(form STREQUAL "error")
            set(text "${t}if ${c} {\n${t}\tfail lang.Error.new(${code}, \"${label}\");\n${t}}\n")
        else()
            set(text "${t}if ${c} {\n${t}\tfail \"${label}\";\n${t}}\n")
        endif()

