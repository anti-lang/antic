        set_property(GLOBAL PROPERTY fuzz_threads ${threads})
    endif()

    set(${out} "${text}" PARENT_SCOPE)
    set(${decl_out} "${decl}" PARENT_SCOPE)
endfunction()

# Set <out> to a statement that leaves the block the way the context
# allows: `break` or `continue` in a loop, and otherwise `return` of the
# accumulator of the function.
function(fuzz_leave out)
    # DESIGN: a list item holds no `;`, so the words take it after the pick.
    if(ctx_loop)
        fuzz_pick(word "break" "continue" "return ${ctx_acc}")
    else()
        set(word "return ${ctx_acc}")
    endif()
    set(${out} "${word};" PARENT_SCOPE)
endfunction()

# Write the declarations every program shares: the sink of the teardown
# and of the threads, the structs, the generic cell, the shapes, the
# resources, the task of a dispatch and the small functions the
# statements call. Set <out> to their text.
function(fuzz_declarations out)
    set(text "")
    string(APPEND text "class Sink\n{\n\tpub static atomic total: int = 0;\n}\n\n")

    # Structs of scalar fields and an array.
    fuzz_rand(count 3)
    set(structs "")
    foreach(s RANGE ${count})
        set(name "S${s}")
        list(APPEND structs ${name})
        fuzz_rand(nfields 3)
        set(fields "")
        string(APPEND text "struct ${name}\n{\n")
        foreach(f RANGE ${nfields})
            fuzz_pick(type ${FUZZ_SCALARS})
            list(APPEND fields "f${f}#${type}")
            string(APPEND text "\tf${f}: ${type},\n")
        endforeach()
        fuzz_pick(type ${FUZZ_SCALARS})
        list(APPEND fields "a#[4]${type}")
        string(APPEND text "\ta: [4]${type},\n}\n\n")
        set_property(GLOBAL PROPERTY fuzz_fields_${name} "${fields}")
        list(GET fields 0 field)
        string(REGEX MATCH "#(.*)$" found "${field}")
        fuzz_convert(k int ${CMAKE_MATCH_1} k)
        string(APPEND text "fn bump_${name}(s: *${name}, k: int)\n{\n")
        string(APPEND text "\ts.f0 = s.f0 +% ${k};\n}\n\n")
        list(GET fields -1 field)
        string(REGEX MATCH "\\](.*)$" found "${field}")
        fuzz_convert(e int ${CMAKE_MATCH_1} k)
        string(APPEND text "fn mix_${name}(s: ${name}, k: int) -> ${name}\n{\n")
        string(APPEND text "\tlet r = s;\n\tr.f0 = r.f0 ^ ${k};\n")
        string(APPEND text "\tr.a[k & 3] = r.a[(k >> 2) & 3] +% ${e};\n\treturn r;\n}\n\n")
    endforeach()
    set_property(GLOBAL PROPERTY fuzz_structs "${structs}")

    # Constants of the module, which every function reads.
    fuzz_rand(count 3)
    set(consts "")
    foreach(k RANGE ${count})
        fuzz_pick(type ${FUZZ_SCALARS})
        fuzz_literal(value ${type})
        string(APPEND text "const K${k}: ${type} = ${value};\n")
        list(APPEND consts "K${k}#${type}")
    endforeach()
    string(APPEND text "\n")
    set_property(GLOBAL PROPERTY fuzz_consts "${consts}")

    string(APPEND text "struct Cell<T>\n{\n\tv: T,\n}\n\n")

    string(APPEND text "variant Token\n{\n\tNum { value: int },\n")
    string(APPEND text "\tPair { a: int, b: u8 },\n\tEnd,\n}\n\n")
    fuzz_rand(shift 3)
    string(APPEND text "fn token_of(x: int) -> Token\n{\n\tswitch (x >> ${shift}) & 3 {\n")
    string(APPEND text "\t\t0 => {\n\t\t\treturn Token.Num { value: x };\n\t\t},\n")
    string(APPEND text "\t\t1 => {\n\t\t\treturn Token.Pair { a: x, b: (x & 255) as u8 };\n\t\t},\n")
    string(APPEND text "\t\telse => {\n\t\t\treturn Token.End;\n\t\t},\n\t}\n}\n\n")

    string(APPEND text "abstract class Scaled\n{\n\tabstract fn scale(self, x: int) -> int;\n}\n\n")

    # An abstract shape and a chain of shapes below it.
    string(APPEND text "abstract class Shape\n{\n\tpub base: int = 0,\n\n")
    string(APPEND text "\tabstract fn eval(self, x: int) -> int;\n\n")
    string(APPEND text "\tpub fn twice(self, x: int) -> int\n\t{\n")
    string(APPEND text "\t\treturn self.eval(x) +% self.eval(x ^ 1);\n\t}\n}\n\n")
    fuzz_rand(count 3)
    set(shapes "")
    set(scaled "")
    set(leaf_int "x" "self.base")
    set(ctx_mul 1)
    set_property(GLOBAL PROPERTY fuzz_cost 0)
    foreach(s RANGE ${count})
        set(name "Shape${s}")
        set(parent "Shape")
        fuzz_chance(deeper 50)
        if(shapes AND deeper)
            fuzz_pick(parent ${shapes})
        endif()
        fuzz_expr(e int 1)
        if(NOT parent STREQUAL "Shape")
            fuzz_pick(op "+%" "^" "-%")
            set(e "(self.super.eval(x) ${op} ${e})")
        endif()
        string(APPEND text "class ${name} inherits ${parent}\n{\n")
        # The first shape and some of the others that inherit no
        # interface implement Scaled.
        fuzz_chance(implements 40)
        if(parent STREQUAL "Shape" AND (s EQUAL 0 OR implements))
            string(APPEND text "\timplements sc: Scaled,\n\n")
            list(APPEND scaled ${name})
        endif()
        string(APPEND text "\tconcrete fn eval(self, x: int) -> int\n\t{\n")
        string(APPEND text "\t\treturn ${e};\n\t}\n")
        if(name IN_LIST scaled)
            fuzz_expr(e int 1)
            string(APPEND text "\n\tconcrete fn scale(self, x: int) -> int\n\t{\n")
            string(APPEND text "\t\treturn ${e};\n\t}\n")
        endif()
        string(APPEND text "}\n\n")
        list(APPEND shapes ${name})
    endforeach()
    set_property(GLOBAL PROPERTY fuzz_shapes "${shapes}")
    set_property(GLOBAL PROPERTY fuzz_scaled "${scaled}")

    # Resources whose teardown adds to the sink.
    fuzz_rand(count 2)
    set(resources "")
    foreach(r RANGE ${count})
        set(name "Res${r}")
        list(APPEND resources ${name})
        fuzz_rand(factor 50)
        math(EXPR factor "${factor} * 2 + 1")
        string(APPEND text "class ${name}\n{\n\tpub n: int = 0,\n")
        string(APPEND text "\tpub own next: ?*${name} = none,\n\n")
        string(APPEND text "\tfn destruct(self)\n\t{\n")
        string(APPEND text "\t\tSink.total.add(self.n *% ${factor});\n\t}\n}\n\n")
        string(APPEND text "fn consume_${name}(own r: ${name}) -> int\n{\n\treturn r.n;\n}\n\n")
        string(APPEND text "fn make_${name}(n: int) -> ${name}\n{\n")
        string(APPEND text "\treturn ${name} { n: n, next: alloc ${name} { n: n +% 1 } };\n}\n\n")
    endforeach()
    set_property(GLOBAL PROPERTY fuzz_resources "${resources}")

    string(APPEND text "class Task\n{\n\tpub n: int = 0,\n}\n\n")

    string(APPEND text "fn pick<T>(a: T, b: T, c: bool) -> T\n{\n")
    string(APPEND text "\tif c {\n\t\treturn dup(a);\n\t}\n\treturn dup(b);\n}\n\n")

    foreach(k 0 1)
        fuzz_rand(mask 4)
        math(EXPR mask "(2 << ${mask}) - 1")
        fuzz_rand(hit 4)
        fuzz_literal(factor int)
        fuzz_literal(offset int)
        string(APPEND text "fn opt_${k}(x: int) -> ?int\n{\n")
        string(APPEND text "\tif (x & ${mask}) == ${hit} {\n\t\treturn none;\n\t}\n")
        string(APPEND text "\treturn x *% ${factor} +% ${offset};\n}\n\n")
        fuzz_rand(hit 8)
        fuzz_literal(offset int)
        string(APPEND text "fn risky_${k}(x: int) -> int may fail\n{\n")
        string(APPEND text "\tif (x & 7) == ${hit} {\n")
        string(APPEND text "\t\tfail lang.Error.new(x & 15, \"risky_${k}\");\n\t}\n")
        string(APPEND text "\treturn x +% ${offset};\n}\n\n")
        fuzz_rand(hit 8)
        fuzz_rand(empty 4)
        fuzz_literal(offset int)
        string(APPEND text "fn maybe_${k}(x: int) -> ?int may fail\n{\n")
        string(APPEND text "\tif (x & 7) == ${hit} {\n\t\tfail \"maybe_${k}\";\n\t}\n")
        string(APPEND text "\tif (x & 3) == ${empty} {\n\t\treturn none;\n\t}\n")
        string(APPEND text "\treturn x ^ ${offset};\n}\n\n")
        fuzz_rand(hit 4)
        string(APPEND text "fn step_${k}(x: int) may fail\n{\n")
        string(APPEND text "\tif (x & 3) == ${hit} {\n\t\tfail \"step_${k}\";\n\t}\n}\n\n")
    endforeach()

    string(APPEND text "fn apply_int(x: int, f: fn(int) -> int) -> int\n{\n\treturn f(x);\n}\n\n")
    string(APPEND text "fn run_int(x: int, f: fn(int))\n{\n\tf(x);\n\tf(x +% 1);\n}\n\n")
    string(APPEND text "fn run_snap(f: fn() -> int) -> int\n{\n\treturn f();\n}\n\n")
    string(APPEND text "fn gsum<T: Number>(a: T, b: T) -> T\n{\n\treturn a + b;\n}\n\n")
    string(APPEND text "synchronized class Tally\n{\n\ttotal: int = 0,\n\n")
    string(APPEND text "\tpub fn add(self, n: int)\n\t{\n\t\tself.total = self.total +% n;\n\t}\n\n")
    string(APPEND text "\tpub fn get(self) -> int\n\t{\n\t\treturn self.total;\n\t}\n}\n\n")

    # The workers of `parallel` and of `dispatch`.
    fuzz_rand(count 2)
    math(EXPR workers "${count} + 1")
    set_property(GLOBAL PROPERTY fuzz_worker_count ${workers})
    foreach(w RANGE ${count})
        set(leaf_int "v" "k" "acc")
        fuzz_expr(e int 1)
        string(APPEND text "worker fn sum_${w}(chunk: []int, k: int) -> int\n{\n")
        string(APPEND text "\tlet acc: int = k;\n\tfor v in chunk {\n")
        string(APPEND text "\t\tacc = acc +% ${e};\n\t}\n")
        set(leaf_int "k" "acc")
        fuzz_expr(e int 1)
        string(APPEND text "\tSink.total.add(${e});\n\treturn acc;\n}\n\n")
        set(leaf_int "t.n" "k")
        fuzz_expr(e int 1)
        string(APPEND text "worker fn job_${w}(t: *Task, k: int) -> int\n{\n")
        string(APPEND text "\treturn ${e};\n}\n\n")
        set(leaf_int "v" "k")
        fuzz_expr(e int 1)
        string(APPEND text "worker fn tally_${w}(chunk: []int, t: *Tally, k: int) -> int\n{\n")
        string(APPEND text "\tfor v in chunk {\n\t\tt.add(${e});\n\t}\n\treturn chunk.len;\n}\n\n")
    endforeach()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Set <out> to the function <name>, and record its parameters, whether it
# may fail and the estimate of its work for the functions after it.
function(fuzz_function out name)
    fuzz_rand(count 4)
    set(params "")
    set(types "")
    set(leaf_int "")
    foreach(type IN LISTS FUZZ_SCALARS)
        set(leaf_${type} "")
        set(lv_${type} "")
    endforeach()
    set(arrays_all "")
    set(structs_all "")
    set(leaf_bool "")
    get_property(consts GLOBAL PROPERTY fuzz_consts)
    foreach(const IN LISTS consts)
        string(REGEX MATCH "^(.*)#(.*)$" found "${const}")
        list(APPEND leaf_${CMAKE_MATCH_2} ${CMAKE_MATCH_1})
    endforeach()
    foreach(p RANGE ${count})
        fuzz_pick(type ${FUZZ_SCALARS})
        list(APPEND params "arg${p}: ${type}")
        list(APPEND types ${type})
        list(APPEND leaf_${type} "arg${p}")
    endforeach()
    fuzz_chance(fallible 30)
    set(ctx_indent 1)
    set(ctx_depth 0)
    set(ctx_mul 1)
    set(ctx_loop 0)
    set_property(GLOBAL PROPERTY fuzz_threads 0)
    set(ctx_owned "")
    set(ctx_acc "acc")
    set(ctx_fallible 0)
    if(fallible)
        set(ctx_fallible 1)
    endif()
    set_property(GLOBAL PROPERTY fuzz_cost 0)
    set(mix "")
    foreach(p RANGE ${count})
        list(GET types ${p} type)
        fuzz_convert(e ${type} int "arg${p}")
        list(APPEND mix "${e}")
    endforeach()
    list(JOIN mix " +% " mix)
    set(first "\tlet acc: int = ${mix};\n")
    # A function that may fail fails on some input, or the checker warns
    # with never-fails.
    if(fallible)
        fuzz_rand(hit 8)
        fuzz_rand(code 100)
        string(APPEND first "\tif (acc & 7) == ${hit} {\n")
        string(APPEND first "\t\tfail lang.Error.new(${code}, \"${name}\");\n\t}\n")
    endif()
    list(APPEND leaf_int acc)
    list(APPEND lv_int acc)
    fuzz_block_size(n)
    fuzz_statements(body ${n} "${first}")
    fuzz_expr(e int 1)
    list(JOIN params ", " params)
    set(head "fn ${name}(${params}) -> int")
    if(fallible)
        string(APPEND head " may fail")
        set_property(GLOBAL APPEND PROPERTY fuzz_failing_fns ${name})
    else()
        set_property(GLOBAL APPEND PROPERTY fuzz_plain_fns ${name})
    endif()
    get_property(cost GLOBAL PROPERTY fuzz_cost)
    set_property(GLOBAL PROPERTY fuzz_cost_${name} ${cost})
    set_property(GLOBAL PROPERTY fuzz_params_${name} "${types}")
    set_property(GLOBAL PROPERTY fuzz_fallible_${name} ${ctx_fallible})
    set(${out} "${head}\n{\n${body}\treturn acc +% ${e};\n}\n\n" PARENT_SCOPE)
endfunction()

# Set <out> to the whole program of <seed>, with about <size> functions.
function(fuzz_generate out seed size)
    fuzz_seed(${seed})
    set(FUZZ_SIZE ${size})
    fuzz_rand(FUZZ_EXPR_DEPTH 3)
    math(EXPR FUZZ_EXPR_DEPTH "${FUZZ_EXPR_DEPTH} + 2")
    set(ctx_index 0)
    set_property(GLOBAL PROPERTY fuzz_plain_fns "")
    set_property(GLOBAL PROPERTY fuzz_failing_fns "")
    set(text "//! Generated by tools/fuzz/generate.cmake from seed ${seed}.\n\n")
    string(APPEND text "import anti.lang;\n\n")
    string(APPEND text "extern fn printf(format: ?*byte, ...) -> c_int;\n\n")
    fuzz_declarations(declarations)
    string(APPEND text "${declarations}")
    set(names "")
    math(EXPR last "${size} - 1")
    # The prefix is no f, since f16, f32 and f64 are keywords.
    foreach(f RANGE ${last})
        fuzz_function(fn "fun${f}")
        string(APPEND text "${fn}")
        list(APPEND names "fun${f}")
    endforeach()

    # main calls every function with literal arguments and mixes each
    # result into the checksum it prints.
    set(ctx_mul 1)
    string(APPEND text "fn main() -> int\n{\n\tlet cs: int = 0;\n")
    foreach(name IN LISTS names)
        get_property(types GLOBAL PROPERTY fuzz_params_${name})
        get_property(fallible GLOBAL PROPERTY fuzz_fallible_${name})
        set(args "")
        foreach(type IN LISTS types)
            fuzz_literal(l ${type})
            list(APPEND args "${l}")
        endforeach()
        list(JOIN args ", " args)
        if(fallible)
            string(APPEND text "\tlet r_${name} = ${name}(${args}) catch e {\n")
            string(APPEND text "\t\tyield e.code +% 1000;\n\t};\n")
            string(APPEND text "\tcs = cs *% 31 +% r_${name};\n")
        else()
            string(APPEND text "\tcs = cs *% 31 +% ${name}(${args});\n")
        endif()
        string(APPEND text "\tprintf(\"${name} %lld\\n\".ptr, cs as c_longlong);\n")
    endforeach()
    string(APPEND text "\tprintf(\"sink %lld\\n\".ptr, Sink.total.load() as c_longlong);\n")
    string(APPEND text "\treturn 0;\n}\n")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# The default count of functions of a program.
set(FUZZ_DEFAULT_SIZE 6)

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT DEFINED SEED OR NOT DEFINED OUT)
        message(FATAL_ERROR "usage: cmake -DSEED=<n> -DOUT=<file.anti> "
                            "[-DSIZE=<n>] -P tools/fuzz/generate.cmake")
    endif()
    if(NOT SIZE)
        set(SIZE ${FUZZ_DEFAULT_SIZE})
    endif()
    fuzz_generate(program ${SEED} ${SIZE})
    file(WRITE "${OUT}" "${program}")
endif()
