        list(LENGTH failing count)
        fuzz_chance(own_fn 40)
        if(count GREATER 0 AND own_fn)
            fuzz_pick(callee ${failing})
            get_property(cost GLOBAL PROPERTY fuzz_cost_${callee})
            fuzz_spend(fits ${cost})
            if(fits)
                fuzz_arguments(args ${callee} 1)
                set(call "${callee}(${args})")
