        else()
            set(leaf_int ${leaf_int} ${i})
            fuzz_block(body ${n} "${t}\t${i} += 1;\n")
            set(text "${t}let ${i}: int = 0;\n${t}do ${body} while ${i} < ${bound}\n")
        endif()

