            string(APPEND text "${t1}Num ${n} => ${body},\n")
            set(leaf_int "${saved_int}" "${p}.a")
            set(saved_u8 "${leaf_u8}")
            list(APPEND leaf_u8 "${p}.b")
            fuzz_block_size(count)
            fuzz_block(body ${count} "")
            string(APPEND text "${t1}Pair ${p} => ${body},\n")
            set(leaf_int "${saved_int}")
            set(leaf_u8 "${saved_u8}")
            fuzz_chance(through 30)
            fuzz_block_size(count)
            if(through)
                fuzz_block(body ${count} "" THROUGH)
