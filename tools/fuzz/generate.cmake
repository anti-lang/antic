# The generator of random valid Anti programs, after Csmith. From a seed it
# writes one program that the checker accepts, that ends, whose behaviour
# is defined and the same in every mode, and that prints a checksum of its
# state. Run it alone with
#   cmake -DSEED=<n> -DOUT=<file.anti> [-DSIZE=<n>] -P tools/fuzz/generate.cmake
# or include it and call fuzz_generate. docs/notes/fuzz.md gives the rules
# each construct keeps.
#
# DESIGN: the program stays defined by construction, not by a filter.
#   - Integer arithmetic is the wrapping, the saturating and the bitwise
#     operators, whose result every mode defines. A divisor is `(e & 15) +% 1`,
#     a shift count is masked below the width, and a narrowing `as` takes a
#     value masked into the range of its type.
#   - An index is masked below the length, which is a power of two.
#   - Every loop runs at most eight turns, and a `while` or `do` loop counts
#     its turn before its body, so `continue` cannot skip the count.
#   - A function calls only functions written before it, so no call
#     recurses, and each function carries an estimate of its work. A call
#     whose cost would pass FUZZ_COST_LIMIT is not written.
#   - Every local is written where it is declared.
#   - Threads join before their results are read, and their results meet
#     through `+%` and the atomic adds of `Sink`, which do not depend on
#     the order.

cmake_minimum_required(VERSION 3.21)

include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")

set(FUZZ_SCALARS int i32 u32 u8 u64)
set(fuzz_bits_int 64)
set(fuzz_bits_i32 32)
set(fuzz_bits_u32 32)
set(fuzz_bits_u8 8)
set(fuzz_bits_u64 64)
set(fuzz_signed_int 1)
set(fuzz_signed_i32 1)
set(fuzz_signed_u32 0)
set(fuzz_signed_u8 0)
set(fuzz_signed_u64 0)
set(fuzz_max_int 9223372036854775807)
set(fuzz_max_i32 2147483647)
set(fuzz_max_u32 4294967295)
set(fuzz_max_u8 255)
set(fuzz_max_u64 18446744073709551615)
# The plain `as` that keeps every value: a signed type to a wider signed
# one, and an unsigned type to a wider type of either kind.
set(fuzz_widens_u8 i32 int u32 u64)
set(fuzz_widens_i32 int)
set(fuzz_widens_u32 int u64)
set(fuzz_widens_int "")
set(fuzz_widens_u64 "")

# The estimate of the work of one function, in statements run, past which
# no call, loop or thread is added to it.
set(FUZZ_COST_LIMIT 20000)
# The deepest nesting of blocks, and of an expression. fuzz_generate draws
# the depth of the expressions of each program from 2 to 4.
set(FUZZ_BLOCK_DEPTH 3)
set(FUZZ_EXPR_DEPTH 3)

# Start the generator at <seed>, a number of at most nine digits.
function(fuzz_seed seed)
    if(NOT seed MATCHES "^[0-9]+$" OR seed GREATER 999999999)
        message(FATAL_ERROR "the seed `${seed}` is no number of at most nine digits")
    endif()
    math(EXPR state "(${seed} * 69069 + 12345) % 2147483648")
    set_property(GLOBAL PROPERTY fuzz_rng ${state})
    set_property(GLOBAL PROPERTY fuzz_counter 0)
endfunction()

# Set <out> to a number in [0, n), for n of at most 32768.
function(fuzz_rand out n)
    get_property(state GLOBAL PROPERTY fuzz_rng)
    math(EXPR state "(${state} * 1103515245 + 12345) % 2147483648")
    set_property(GLOBAL PROPERTY fuzz_rng ${state})
    math(EXPR value "(${state} >> 16) % ${n}")
    set(${out} ${value} PARENT_SCOPE)
endfunction()

# Set <out> to one of the arguments after it.
function(fuzz_pick out)
    list(LENGTH ARGN count)
    fuzz_rand(at ${count})
    list(GET ARGN ${at} value)
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Set <out> to one of the names of the arguments after it, each written
# `name:weight`, with a chance in proportion to its weight.
function(fuzz_weighted out)
    set(total 0)
    foreach(entry IN LISTS ARGN)
        string(REGEX MATCH ":([0-9]+)$" found "${entry}")
        math(EXPR total "${total} + ${CMAKE_MATCH_1}")
    endforeach()
    fuzz_rand(at ${total})
    foreach(entry IN LISTS ARGN)
        string(REGEX MATCH "^(.*):([0-9]+)$" found "${entry}")
        if(at LESS CMAKE_MATCH_2)
            set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
            return()
        endif()
        math(EXPR at "${at} - ${CMAKE_MATCH_2}")
    endforeach()
endfunction()

# Set <out> to TRUE with a chance of <percent> in a hundred.
function(fuzz_chance out percent)
    fuzz_rand(value 100)
    if(value LESS percent)
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

# Set <out> to <prefix> and a number no other name of the program has.
function(fuzz_name out prefix)
    get_property(counter GLOBAL PROPERTY fuzz_counter)
    math(EXPR counter "${counter} + 1")
    set_property(GLOBAL PROPERTY fuzz_counter ${counter})
    set(${out} "${prefix}${counter}" PARENT_SCOPE)
endfunction()

# Set <out> to the tabs of <level>.
function(fuzz_tabs out level)
    string(REPEAT "\t" ${level} tabs)
    set(${out} "${tabs}" PARENT_SCOPE)
endfunction()

# Add <amount> times the multiplier of the loops around the place to the
# work of the function. Set <out> to TRUE when the work stays within
# FUZZ_COST_LIMIT, and then count it, and to FALSE otherwise.
function(fuzz_spend out amount)
    get_property(cost GLOBAL PROPERTY fuzz_cost)
    math(EXPR more "${cost} + ${amount} * ${ctx_mul}")
    if(more GREATER FUZZ_COST_LIMIT)
        set(${out} FALSE PARENT_SCOPE)
        return()
    endif()
    set_property(GLOBAL PROPERTY fuzz_cost ${more})
    set(${out} TRUE PARENT_SCOPE)
endfunction()

# Set <out> to a literal of <type> that fits it.
function(fuzz_literal out type)
    fuzz_rand(kind 100)
    if(kind LESS 55)
        fuzz_rand(value 17)
    elseif(kind LESS 85)
        fuzz_rand(value 32768)
        if(type STREQUAL "u8")
            math(EXPR value "${value} % 256")
        endif()
    elseif(kind LESS 95 AND NOT type STREQUAL "u8")
        fuzz_rand(high 32768)
        fuzz_rand(low 32768)
        math(EXPR value "${high} * 32768 + ${low}")
        if(fuzz_bits_${type} EQUAL 64)
            fuzz_rand(top 32768)
            math(EXPR value "${top} * 1073741824 + ${value}")
        endif()
    else()
        set(value "${fuzz_max_${type}}")
    endif()
    if(fuzz_signed_${type})
        fuzz_chance(negative 20)
        if(negative AND NOT value STREQUAL "0")
            set(value "(-${value})")
        endif()
    endif()
    # DESIGN: an expression of literals alone has the type int, so a
    # literal of another type names its type. The greatest u64 is no
    # literal antic reads as an int first, so it is written `~0`.
    if(type STREQUAL "u64" AND value STREQUAL "${fuzz_max_u64}")
        set(value "(~(0 as u64))")
    elseif(NOT type STREQUAL "int")
        set(value "(${value} as ${type})")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Set <out> to <expr> of <from> converted to <to> with `as`, masked first
# when the conversion would not keep every value.
function(fuzz_convert out from to expr)
    if(from STREQUAL to)
        set(${out} "${expr}" PARENT_SCOPE)
    elseif(to IN_LIST fuzz_widens_${from})
        set(${out} "((${expr}) as ${to})" PARENT_SCOPE)
    else()
        set(mask "${fuzz_max_${from}}")
        string(LENGTH "${fuzz_max_${from}}" from_digits)
        string(LENGTH "${fuzz_max_${to}}" to_digits)
        if(to_digits LESS from_digits OR (to_digits EQUAL from_digits
           AND fuzz_max_${to} STRLESS fuzz_max_${from}))
            set(mask "${fuzz_max_${to}}")
        endif()
        set(${out} "(((${expr}) & ${mask}) as ${to})" PARENT_SCOPE)
    endif()
endfunction()

# Set <out> to an expression of <type> that reads no place, a literal or a
# name in scope, filling the index of an element with a small expression.
function(fuzz_leaf out type)
    set(places ${leaf_${type}})
    list(LENGTH places count)
    fuzz_rand(kind 100)
    if(count EQUAL 0 OR kind LESS 25)
        fuzz_literal(text ${type})
        set(${out} "${text}" PARENT_SCOPE)
        return()
    endif()
    fuzz_rand(at ${count})
    list(GET places ${at} text)
    if(text MATCHES "@I@")
        set(index "")
        if(ctx_index GREATER 0)
            fuzz_literal(index int)
        else()
            set(ctx_index 1)
            fuzz_leaf(index int)
        endif()
        string(REPLACE "@I@" "${index}" text "${text}")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Set <out> to an assignable place of <type>, or to the empty text when
# the scope holds none.
function(fuzz_place out type)
    set(places ${lv_${type}})
    list(LENGTH places count)
    if(count EQUAL 0)
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    fuzz_rand(at ${count})
    list(GET places ${at} text)
    if(text MATCHES "@I@")
        set(ctx_index 1)
        fuzz_leaf(index int)
        string(REPLACE "@I@" "${index}" text "${text}")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Set <out> to the arguments of a call of the function <callee>, one
# expression of the type of each parameter.
function(fuzz_arguments out callee depth)
    get_property(params GLOBAL PROPERTY fuzz_params_${callee})
    set(args "")
    foreach(type IN LISTS params)
        fuzz_expr(arg ${type} ${depth})
        list(APPEND args "${arg}")
    endforeach()
    list(JOIN args ", " args)
    set(${out} "${args}" PARENT_SCOPE)
endfunction()

# Set <out> to a call of a function that cannot fail and that the work of
# the current function can still pay for, or to the empty text.
function(fuzz_call out depth)
    get_property(callees GLOBAL PROPERTY fuzz_plain_fns)
    list(LENGTH callees count)
    if(count EQUAL 0)
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    fuzz_rand(at ${count})
    list(GET callees ${at} callee)
    get_property(cost GLOBAL PROPERTY fuzz_cost_${callee})
    fuzz_spend(paid ${cost})
    if(NOT paid)
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    fuzz_arguments(args ${callee} ${depth})
    set(${out} "${callee}(${args})" PARENT_SCOPE)
endfunction()

# Set <out> to a condition.
function(fuzz_cond out depth)
    math(EXPR next "${depth} + 1")
    if(depth GREATER_EQUAL FUZZ_EXPR_DEPTH)
        set(kind compare)
    else()
        set(kinds compare:60 both:12 either:12 not:6 bit:10)
        if(leaf_bool)
            list(APPEND kinds leaf:12)
        endif()
        fuzz_weighted(kind ${kinds})
    endif()
    if(kind STREQUAL "compare")
        fuzz_pick(type ${FUZZ_SCALARS})
        fuzz_expr(a ${type} ${next})
        fuzz_expr(b ${type} ${next})
        fuzz_pick(op "==" "!=" "<" "<=" ">" ">=")
        set(text "(${a} ${op} ${b})")
    elseif(kind STREQUAL "both")
        fuzz_cond(a ${next})
        fuzz_cond(b ${next})
        set(text "(${a} && ${b})")
    elseif(kind STREQUAL "either")
        fuzz_cond(a ${next})
        fuzz_cond(b ${next})
        set(text "(${a} || ${b})")
    elseif(kind STREQUAL "not")
        fuzz_cond(a ${next})
        set(text "!${a}")
    elseif(kind STREQUAL "leaf")
        fuzz_pick(text ${leaf_bool})
    else()
        fuzz_pick(type ${FUZZ_SCALARS})
        fuzz_expr(a ${type} ${next})
        fuzz_rand(bit 2)
        set(text "((${a} & 1) == ${bit})")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Set <out> to an expression of <type> at the nesting <depth>.
function(fuzz_expr out type depth)
    if(type STREQUAL "bool")
        fuzz_cond(text ${depth})
        set(${out} "${text}" PARENT_SCOPE)
        return()
    endif()
    math(EXPR next "${depth} + 1")
    fuzz_rand(stop 100)
    if(depth GREATER_EQUAL FUZZ_EXPR_DEPTH OR stop LESS 30)
        fuzz_leaf(text ${type})
        set(${out} "${text}" PARENT_SCOPE)
        return()
    endif()
    set(kinds wrap:36 bits:14 shift:8 divide:6 saturate:6 unary:6 convert:12
        pick:4 high:2)
    if(type STREQUAL "int")
        list(APPEND kinds call:8)
    endif()
    if(type STREQUAL "int" OR type STREQUAL "i32")
        list(APPEND kinds number:3)
    endif()
    fuzz_weighted(kind ${kinds})
    math(EXPR top "${fuzz_bits_${type}} - 1")
    if(kind STREQUAL "call")
        fuzz_call(text ${next})
        if(text STREQUAL "")
            set(kind wrap)
        endif()
    endif()
    if(kind STREQUAL "wrap" OR kind STREQUAL "bits" OR kind STREQUAL "saturate"
       OR kind STREQUAL "high")
        fuzz_expr(a ${type} ${next})
        fuzz_expr(b ${type} ${next})
        if(kind STREQUAL "wrap")
            fuzz_pick(op "+%" "-%" "*%")
        elseif(kind STREQUAL "bits")
            fuzz_pick(op "&" "|" "^")
        elseif(kind STREQUAL "saturate")
            fuzz_pick(op "+|" "-|" "*|")
        endif()
        if(kind STREQUAL "high")
            set(text "mul_high(${a}, ${b})")
        else()
            set(text "(${a} ${op} ${b})")
        endif()
    elseif(kind STREQUAL "shift")
        fuzz_expr(a ${type} ${next})
        fuzz_expr(b ${type} ${next})
        fuzz_pick(op "<<" ">>" "<<%")
        set(text "(${a} ${op} (${b} & ${top}))")
    elseif(kind STREQUAL "divide")
        fuzz_expr(a ${type} ${next})
        fuzz_expr(b ${type} ${next})
        fuzz_pick(op "/" "%")
        set(text "(${a} ${op} ((${b} & 15) +% 1))")
    elseif(kind STREQUAL "unary")
        fuzz_expr(a ${type} ${next})
        fuzz_pick(form "~" "0 -% ")
        set(text "(${form}${a})")
    elseif(kind STREQUAL "convert")
        set(others ${FUZZ_SCALARS})
        list(REMOVE_ITEM others ${type})
        fuzz_pick(from ${others})
        fuzz_expr(a ${from} ${next})
        fuzz_convert(text ${from} ${type} "${a}")
    elseif(kind STREQUAL "number")
        # The plain `+` of a Number takes operands of 16 bits, so it
        # cannot overflow.
        fuzz_expr(a ${type} ${next})
        fuzz_expr(b ${type} ${next})
        set(text "gsum<${type}>((${a} & 65535), (${b} & 65535))")
    elseif(kind STREQUAL "pick")
        fuzz_expr(a ${type} ${next})
        fuzz_expr(b ${type} ${next})
        fuzz_cond(c ${next})
        set(text "pick<${type}>(${a}, ${b}, ${c})")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Declare a readable name of <type> in the scope of the caller of the
# statement, and an assignable one when <assignable> is TRUE.
macro(fuzz_declare type text assignable)
    list(APPEND decl "leaf#${type}#${text}")
    if(${assignable})
        list(APPEND decl "lv#${type}#${text}")
    endif()
endmacro()

# Declare the fields of the struct value <name> of the struct <struct> in
# the scope of the caller of the statement. <whole> is TRUE when <name> is
# the value itself, which a copy and a call may then take, and FALSE for
# a pointer to it.
macro(fuzz_struct_names name struct whole)
    get_property(fuzz_fields GLOBAL PROPERTY fuzz_fields_${struct})
    foreach(fuzz_field IN LISTS fuzz_fields)
        string(REGEX MATCH "^([a-z0-9]+)#(.*)$" fuzz_found "${fuzz_field}")
        set(fuzz_fname "${CMAKE_MATCH_1}")
        set(fuzz_ftype "${CMAKE_MATCH_2}")
        if(fuzz_ftype MATCHES "^\\[4\\](.*)$")
            fuzz_declare(${CMAKE_MATCH_1} "${name}.${fuzz_fname}[(@I@) & 3]" TRUE)
        else()
            fuzz_declare(${fuzz_ftype} "${name}.${fuzz_fname}" TRUE)
        endif()
    endforeach()
    if(${whole})
        list(APPEND decl "structs#all#${name}:${struct}")
    endif()
endmacro()

# Set <out> to a block of <count> statements, the braces included, at one
# level of nesting below ctx_indent. An optional third argument holds
# lines that open the block, and a fourth argument THROUGH ends it with
# `fallthrough;`.
function(fuzz_block out count)
    set(first "")
    if(ARGC GREATER 2)
        set(first "${ARGV2}")
    endif()
    math(EXPR ctx_indent "${ctx_indent} + 1")
    math(EXPR ctx_depth "${ctx_depth} + 1")
    fuzz_statements(body ${count} "${first}")
    if(ARGC GREATER 3 AND ARGV3 STREQUAL "THROUGH")
        fuzz_tabs(inner ${ctx_indent})
        string(APPEND body "${inner}fallthrough;\n")
    endif()
    math(EXPR level "${ctx_indent} - 1")
    fuzz_tabs(close ${level})
    set(${out} "{\n${body}${close}}" PARENT_SCOPE)
endfunction()

# Set <out> to the count of statements of a block at ctx_depth.
function(fuzz_block_size out)
    if(ctx_depth EQUAL 0)
        fuzz_rand(count 6)
        math(EXPR count "${count} + 3")
    else()
        fuzz_rand(count 3)
        math(EXPR count "${count} + 1")
    endif()
    set(${out} ${count} PARENT_SCOPE)
endfunction()

# Set <out> to <count> statements at ctx_indent, after the lines of
# <first>, each line of which already stands at that level. Each
# statement may declare names that the statements after it read.
function(fuzz_statements out count first)
    fuzz_tabs(tabs ${ctx_indent})
    set(text "")
    if(NOT first STREQUAL "")
        set(text "${first}")
    endif()
    foreach(turn RANGE 1 ${count})
        fuzz_statement(stmt decl)
        string(APPEND text "${stmt}")
        foreach(item IN LISTS decl)
            string(REGEX MATCH "^([a-z]+)#([^#]+)#(.*)$" found "${item}")
            list(APPEND ${CMAKE_MATCH_1}_${CMAKE_MATCH_2} "${CMAKE_MATCH_3}")
        endforeach()
    endforeach()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Set <out> to one statement, its lines indented at ctx_indent and each
# ending with a line feed, and <decl_out> to the names it declares.
function(fuzz_statement out decl_out)
    fuzz_tabs(t ${ctx_indent})
    set(decl "")
    set(kinds let:12 assign:16 struct:4 array:3 cell:3 dispatch:4 optional:5
        failing:5 own:5 closure:4 defer:3 tuple:2 flags:3 snapshot:2
        channel:1 scaled:2 pointer:4)
    if(structs_all)
        list(APPEND kinds copy:2 bump:2 mix:2)
    endif()
    if(ctx_depth LESS FUZZ_BLOCK_DEPTH)
        list(APPEND kinds variant:3 trying:2)
    endif()
    if(ctx_depth LESS FUZZ_BLOCK_DEPTH)
        list(APPEND kinds if:8 for:6 while:2 do:2 switch:4 each:2)
    endif()
    if(ctx_loop)
        list(APPEND kinds leave:3)
    endif()
    if(ctx_fallible)
        list(APPEND kinds try:5 fail:2 undo:1)
    endif()
    list(APPEND kinds return:1)
    get_property(threads GLOBAL PROPERTY fuzz_threads)
    if(ctx_mul EQUAL 1 AND threads LESS 2)
        list(APPEND kinds thread:3)
    endif()
    fuzz_weighted(kind ${kinds})
    fuzz_spend(paid 1)
    set(text "")

    if(kind STREQUAL "let")
        fuzz_pick(type ${FUZZ_SCALARS})
        fuzz_name(name v)
        fuzz_expr(e ${type} 0)
        set(text "${t}let ${name}: ${type} = ${e};\n")
        fuzz_declare(${type} ${name} TRUE)

    elseif(kind STREQUAL "assign")
        fuzz_pick(type ${FUZZ_SCALARS})
        fuzz_place(place ${type})
        if(place STREQUAL "")
            set(type int)
            fuzz_place(place int)
        endif()
        fuzz_expr(e ${type} 0)
        fuzz_weighted(op "=:4" "+%=:4" "-%=:2" "*%=:2" "^=:3" "|=:1" "&=:1"
                      "+|=:1" "shift:1")
        if(op STREQUAL "shift")
            math(EXPR top "${fuzz_bits_${type}} - 1")
            set(text "${t}${place} <<%= (${e} & ${top});\n")
        else()
            set(text "${t}${place} ${op} ${e};\n")
        endif()

    elseif(kind STREQUAL "struct")
        get_property(structs GLOBAL PROPERTY fuzz_structs)
        fuzz_pick(struct ${structs})
        get_property(fields GLOBAL PROPERTY fuzz_fields_${struct})
        fuzz_name(name s)
        set(parts "")
        foreach(field IN LISTS fields)
            string(REGEX MATCH "^([a-z0-9]+)#(.*)$" found "${field}")
            set(fname "${CMAKE_MATCH_1}")
            set(ftype "${CMAKE_MATCH_2}")
            if(ftype MATCHES "^\\[4\\](.*)$")
                set(etype "${CMAKE_MATCH_1}")
                set(items "")
                foreach(i RANGE 3)
                    fuzz_expr(e ${etype} 1)
                    list(APPEND items "${e}")
                endforeach()
                list(JOIN items ", " items)
                list(APPEND parts "${fname}: [${items}]")
            else()
                fuzz_expr(e ${ftype} 1)
                list(APPEND parts "${fname}: ${e}")
            endif()
        endforeach()
        fuzz_struct_names(${name} ${struct} TRUE)
        list(JOIN parts ", " parts)
        set(text "${t}let ${name} = ${struct} { ${parts} };\n")

    elseif(kind STREQUAL "array")
        fuzz_pick(type ${FUZZ_SCALARS})
        fuzz_name(name a)
        set(items "")
        foreach(i RANGE 7)
            fuzz_expr(e ${type} 1)
            list(APPEND items "${e}")
        endforeach()
        list(JOIN items ", " items)
        set(text "${t}let ${name}: [8]${type} = [${items}];\n")
        fuzz_declare(${type} "${name}[(@I@) & 7]" TRUE)
        list(APPEND decl "arrays#all#${name}:${type}")

    elseif(kind STREQUAL "cell")
        fuzz_pick(type ${FUZZ_SCALARS})
        fuzz_name(name c)
        fuzz_expr(e ${type} 0)
        set(text "${t}let ${name} = Cell<${type}> { v: ${e} };\n")
        fuzz_declare(${type} "${name}.v" TRUE)

    elseif(kind STREQUAL "dispatch")
        fuzz_place(place int)
        get_property(shapes GLOBAL PROPERTY fuzz_shapes)
        fuzz_pick(first ${shapes})
        fuzz_pick(second ${shapes})
        fuzz_name(a o)
        fuzz_name(b o)
        fuzz_name(p p)
        fuzz_expr(ea int 1)
        fuzz_expr(eb int 1)
        fuzz_cond(c 1)
        fuzz_expr(x int 1)
        fuzz_pick(call "eval(${x})" "twice(${x})" bound)
        set(body "${t}{\n")
        string(APPEND body "${t}\tlet ${a} = ${first} { base: ${ea} };\n")
        string(APPEND body "${t}\tlet ${b} = ${second} { base: ${eb} };\n")
        string(APPEND body "${t}\tlet ${p}: *Shape = &${a};\n")
        string(APPEND body "${t}\tif ${c} {\n${t}\t\t${p} = &${b};\n${t}\t}\n")
        if(call STREQUAL "bound")
            fuzz_name(bound b)
            string(APPEND body "${t}\tlet ${bound} = ${p}.twice;\n")
            string(APPEND body "${t}\t${place} = ${place} +% ${bound}(${x});\n")
        else()
            string(APPEND body "${t}\t${place} = ${place} +% ${p}.${call};\n")
