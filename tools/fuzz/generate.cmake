        else()
            fuzz_pick(from ${owned})
            set(text "${t}{\n${t}\tlet ${name} = dup(&${from});\n${t}\t${place} = ${place} +% ${name}.n;\n${t}\tdelete(${name});\n${t}}\n")
        endif()

    elseif(kind STREQUAL "closure")
